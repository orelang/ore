interface Shape {
    area(): f64
}

const byId = new Map<int, string>()
JSON.stringify(byId) // error: the keys of a Map must be strings.
JSON.stringify(() => 1) // error: Type '() => i64' cannot be converted to or from JSON.
JSON.parse<Shape>("{}") // error: Type 'Shape' cannot be converted to or from JSON.
JSON.parse("1") // error: 'JSON.parse' needs the type to read
const n: int = JSON.parse<int>("1") // error: Type 'Error | i64' is not assignable to type 'i64'
