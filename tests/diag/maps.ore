const m = new Map() // error: Cannot infer the types of the Map.
const n = new Map<string, int>()
n.set(1, 2) // error: An integer constant is not assignable to type 'string'.
n.set("a", "b") // error: Type 'string' is not assignable to type 'i64'.
const v: int = n.get("a") // error: Type 'i64 | null' is not assignable to type 'i64': the value may be null.
n.put("a", 1) // error: Method 'put' does not exist on type 'Map<string, i64>'.
for (const entry of n) {} // error: Iterate a Map with 'for (const [key, value] of map)'.
const bad = new Map<f64[] | null, int>() // error: Type 'f64[] | null' cannot be a Map key.
const w = new Map<string, int>([]) // error: 'new Map' takes no arguments; add entries with 'set'.
