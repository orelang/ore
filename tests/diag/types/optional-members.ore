interface Maybe {
    label?: string
}
interface Sure {
    label: string | null
}
class Strict {
    label = "s"
}
const m: Maybe = { label: "x" }
const s: Sure = m // error: property 'label' is optional
const t: Maybe = new Strict() // error: property 'label' has type 'string' instead of 'null | string'
interface Odd {
    run?(): void // error: Optional methods are not supported.
}
