type Point = { x: int; y: int }
const p: Point = { x: 1, y: 2 }
const bad = { ...5 } // error: Only an object can be spread into an object literal, got 'i64'.
const twice = { a: 1, ...p, a: 2 } // error: Duplicate property 'a'.
const extra: Point = { ...p, z: 3 } // error: Property 'z' does not exist in type 'Point'.
const wrong: Point = { ...p, x: "s" } // error: Type 'string' is not assignable to type 'i64'.
