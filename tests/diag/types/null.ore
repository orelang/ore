class Node {
    next: Node | null = null
    constructor(public value: int) {}
}

function f(n: Node | null): int {
    return n.value // error: The value may be null: check it with '!== null' first, or use '?.'.
}

function g(n: Node | null): Node {
    return n // error: Type 'Node | null' is not assignable to type 'Node': the value may be null.
}

function h(n: Node | null): int {
    if (n === null) {
        console.log("none")
    }
    return n.value // error: The value may be null
}

function k(n: Node | null): int {
    while (n !== null) {
        n = n.next
    }
    return n.value // error: The value may be null
}

let a = null // error: Cannot infer a type from 'null'.
const b: Node = null // error: Type 'null' is not assignable to type 'Node'.
const c: int = 5
if (c === null) {
    // error: Type 'i64' cannot be null, so this comparison is always false.
}
const d = c ?? 1 // error: Type 'i64' cannot be null; '??' is not needed.
const e = c! // error: Type 'i64' cannot be null; '!' is not needed.
const u = undefined // error: 'undefined' is not supported in Ore. Use 'null'.
let v: int | string = 1.5 // error: A numeric constant is not assignable to type 'i64 | string'.
let w: i32 | i64 = 1
let x: i32 | u8 = 1 // error: Ambiguous constant for type 'i32 | u8'.
let n: Node | null
console.log(n.next) // error: The value may be null

// Narrowing by assignment holds where every branch that goes on narrows.
function make(): Node {
    return new Node(0)
}
function onlyOne(flag: bool, n: Node | null): int {
    if (flag) n = make()
    return n.value // error: The value may be null
}
function reset(n: Node | null): int {
    if (n === null) n = make()
    else n = n.next
    return n.value // error: The value may be null
}
function invalidated(n: Node | null): int {
    if (n === null) n = make()
    n = n.next
    return n.value // error: The value may be null
}
// A loop forgets what it assigns, as the assignment may run before the next iteration.
function looped(n: Node | null): int {
    if (n === null) n = make()
    for (let i = 0; i < 3; i++) {
        console.log(n.value) // error: The value may be null
        n = n.next // error: The value may be null
    }
    return 0
}
// A closure that assigns a variable does not know what is narrowed about it.
function captured(n: Node | null): int {
    if (n === null) n = make()
    const f = (): int => {
        const v = n.value // error: The value may be null
        n = null
        return v
    }
    return n.value + f()
}
