interface Shape {
    area(): f64
}

interface Point {
    x: f64
    y: f64
}

class Square implements Shape {
    // error: Class 'Square' does not implement 'Shape': method 'area' is missing.
    constructor(public side: f64) {}
}

class Bad implements Shape {
    // error: Class 'Bad' does not implement 'Shape': method 'area' has type '() => i64' instead of '() => f64'.
    area(): int {
        return 1
    }
}

class Secret {
    constructor(
        private x: f64,
        public y: f64,
    ) {}
}

class Frozen {
    constructor(
        readonly x: f64,
        readonly y: f64,
    ) {}
}

interface Loop extends Loop {} // error: Interface 'Loop' extends itself.

const p: Point = { x: 1 } // error: Type '{ x: f64 }' is not assignable to type 'Point': property 'y' is missing.
const q: Point = { x: 1, y: 2, z: 3 } // error: Object literal may only specify known properties, and 'z' does not exist in type 'Point'.
const r: Point = new Secret(1, 2) // error: Type 'Secret' is not assignable to type 'Point': property 'x' is missing.
const f: Point = new Frozen(1, 2) // error: Type 'Frozen' is not assignable to type 'Point': property 'x' is read-only.
const s: Shape = new Square(1) // error: Type 'Square' is not assignable to type 'Shape': method 'area' is missing.
const ok: Point = { x: 1, y: 2 }
ok.z = 1 // error: Property 'z' does not exist on type 'Point'.
ok.area() // error: Method 'area' does not exist on type 'Point'.
let none: Shape
console.log(none.area()) // error: Variable 'none' is used before being assigned.
