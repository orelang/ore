// `as const` values are read-only and of literal types.
const Dirs = ["n", "s"] as const
type Dir = (typeof Dirs)[number]
const d: Dir = "x" // error: Type 'string' is not assignable to type 'Dir'.
Dirs[0] = "s" // error: Cannot assign to '0' because it is a read-only property.
const config = { level: 2 } as const
config.level = 2 // error: Cannot assign to 'level' because it is a read-only property.
const spread = [...Dirs] as const // error: 'as const' takes array literals without spread elements.
