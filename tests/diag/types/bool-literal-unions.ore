type R<T, TR> = { done: false; value: T } | { done: true; value: TR }

const flag: bool = Math.random() > 2
const a: true = false // error: Type 'false' is not assignable to type 'true'.
const b: true = flag // error: Type 'bool' is not assignable to type 'true'.
const c: false | null = true // error: Type 'true' is not assignable to type 'false | null'.
const d: R<int, string> = { done: flag, value: 1 } // error: Cannot tell which member of
let e: { done: true } = { done: true }
e.done = flag // error: Type 'bool' is not assignable to type 'true'.
const big: 10n = 10n // error: Only string, number and boolean literal types are supported yet.
console.log(a, b, c, d, e, big)
