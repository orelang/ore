// A getter signature alone declares a read-only field.
interface Shape {
    get area(): f64
    get name(): string
    set name(value: string)
    get bad() // error: Getter 'bad' must have a return type annotation.
    set worse(a: int, b: int) // error: Setter 'worse' must take one parameter with a type annotation.
}
function f(s: Shape) {
    s.area = 2 // error: Cannot assign to 'area' because it is a read-only property.
    s.name = "x"
}
