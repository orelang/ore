// A public getter implements a read-only interface field; a writable one needs a setter too.
interface Counted {
    count: int
}
interface Sized {
    readonly size: int
}
class Counter implements Counted {
    // error: Class 'Counter' does not implement 'Counted': property 'count' has a getter but no setter.
    get count(): int {
        return 0
    }
}
class Hidden {
    private get count(): int {
        return 0
    }
}
const c: Counted = new Hidden() // error: Type 'Hidden' is not assignable to type 'Counted': property 'count' is missing.
class Sizer implements Sized {
    // error: Class 'Sizer' does not implement 'Sized': property 'size' has a setter but no getter.
    set size(v: int) {}
}
