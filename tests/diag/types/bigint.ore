let big = 10n
let count = 3
let ratio = 0.5

// No mixing with other numeric types, as in JavaScript.
const a = big + 1 // error: An integer constant is not assignable to type 'bigint'. Write a bigint literal: '1n'.
const b = big * count // error: Operator '*' cannot be applied to types 'bigint' and 'i64'. Convert one side explicitly, e.g. 'BigInt(x)'.
const c = count - big // error: Operator '-' cannot be applied to types 'i64' and 'bigint'. Convert one side explicitly, e.g. 'i64(x)'.
const d = big << 2 // error: An integer constant is not assignable to type 'bigint'. Write a bigint literal: '2n'.
const e = count << big // error: Operator '<<' cannot be applied to types 'i64' and 'bigint'. Convert one side explicitly, e.g. 'i64(x)'.
const f = big < 2 // error: An integer constant is not assignable to type 'bigint'. Write a bigint literal: '2n'.
const g = big === ratio // error: Cannot compare 'bigint' with 'f64'.
const h: bigint = 5 // error: An integer constant is not assignable to type 'bigint'. Write a bigint literal: '5n'.
const i: int = big // error: Type 'bigint' is not assignable to type 'i64'. Use an explicit conversion: 'i64(...)'.
const j: bigint = count // error: Type 'i64' is not assignable to type 'bigint'. Use an explicit conversion: 'BigInt(...)'.
const k: bigint = 1.5 // error: A floating-point constant is not assignable to type 'bigint'.
const l = +big // error: Operator '+' cannot be applied to type 'bigint'.
const m = big + "s" // error: Only strings can be concatenated with '+'. Use a template literal: `${a}${b}`.

// Conversions.
const n = BigInt(1.5) // error: Cannot convert 1.5 to 'bigint'.
const o = BigInt(true) // error: Cannot convert 'bool' to 'bigint'.
const p = BigInt(1, 2) // error: Conversion 'BigInt' expects exactly 1 argument, got 2.
const q = big.toString(16, 2) // error: 'toString' expects 0 to 1 argument(s), got 2.
const r = big.toFixed(2) // error: Method 'toFixed' does not exist on type 'bigint'.
const s = JSON.stringify(big) // error: Type 'bigint' cannot be converted to or from JSON.
const t = Math.abs(big) // error: 'Math.abs' needs numbers, got 'bigint'.
