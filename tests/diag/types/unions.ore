type Circle = { kind: "circle"; r: f64 }
type Square = { kind: "square"; side: f64 }
type Shape = Circle | Square

function partial(s: Shape): f64 {
    // error: must return a value of type 'f64' on every path
    switch (s.kind) {
        case "circle":
            return s.r
    }
}

function fallthrough(s: Shape): f64 {
    switch (s.kind) {
        case "circle":
            console.log("round")
        case "square":
            return s.side // error: Property 'side' does not exist on type 'Shape'.
    }
}

function radius(s: Shape): f64 {
    return s.r // error: Property 'r' does not exist on type 'Shape'.
}

class Cat {}
class Dog {}

const s: Shape = { kind: "circle", r: 1 }
const t: Shape = { kind: "triangle", r: 1 } // error: Type 'string' is not assignable to type '"circle"'.
const u: Shape = { r: 1 } // error: Missing property 'kind' of type 'Circle'.
const mode: "a" | "b" = "c" // error: Type 'string' is not assignable to type '"a" | "b"'.
const n: 1 | 2 = 1 // error: Only string literal types are supported yet.
const c = new Cat()
if (c instanceof Dog) {
    // error: A value of type 'Cat' is never an instance of 'Dog'.
}
if (c instanceof Shape) {
    // error: The right side of 'instanceof' must be a class or an interface.
}
class Read {
    readonly id: int = 0
    size: int = 0
    name: string = ""
}
class Write {
    readonly id: int = 1
    size: i32 = 0
    name: string = ""
    private secret = 0
}
function rename(op: Read | Write, maybe: Read | Write | null) {
    op.name = "r"
    op.id = 2 // error: Cannot assign to 'id' because it is a read-only property.
    op.size = 3 // error: Cannot assign to 'size': its type differs between the members of 'Read | Write'.
    op.secret = 4 // error: Property 'secret' does not exist on type 'Read | Write'.
    maybe.name = "m" // error: The value may be null
}
