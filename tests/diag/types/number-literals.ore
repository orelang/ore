type Angle = 0 | 90 | 180 | 270

function partial(d: Angle): string {
    // error: must return a value of type 'string' on every path
    switch (d) {
        case 0:
            return "up"
        case 90:
            return "right"
        case 180:
            return "down"
    }
}

const n: 1 | 2 = 3 // error: Constant 3 is not assignable to type '1 | 2'.
const z: 0 = 1 // error: Constant 1 is not assignable to type '0'.
const f: 0.5 | 1 = 0.25 // error: Constant 0.25 is not assignable to type '0.5 | 1'.
let a: Angle = 0
a = a + 90 // error: Type 'f64' is not assignable to type 'Angle'.
const i: int = a // error: Type 'Angle' is not assignable to type 'i64'.
const g: f32 = a // error: Type 'Angle' is not assignable to type 'f32'.
const s: string = a // error: Type 'Angle' is not assignable to type 'string'.
function first(pair: [never, int]) {} // error: exists only in computations on types
console.log(n, z, f, a, i, g, s, partial(0))
