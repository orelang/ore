type Result = { ok: true; value: int } | { ok: false; error: string }

function value(r: Result): int {
    if (r.ok === false) return r.value // error: Property 'value' does not exist on type '{ error: string; ok: false }'.
    return 0
}

function partial(r: Result): int {
    // error: must return a value of type 'i64' on every path
    switch (r.ok) {
        case true:
            return r.value
    }
}

function flag(b: bool): true {
    return b // error: Type 'bool' is not assignable to type 'true'.
}

const yes: true = false // error: Type 'false' is not assignable to type 'true'.
const r: Result = { ok: true, error: "x" } // error: Type 'true' is not assignable to type 'false'.
