class Point {
    private secret = 1
    readonly id: int = 0
    next: Point // error: Field 'next' of type 'Point' must be initialized

    constructor(public x: f64) {
        this.id = 5
    }

    hidden(): int {
        return this.secret
    }

    private helper(): void {}

    bad(): int {
        // error: must return a value of type 'i64' on every path
    }
}

class Weird {
    protected a = 1
    static b = 2
    get c(): int {
        return 1
    }
    d = this // error: Field initializers cannot use 'this'.
    e // error: Field 'e' needs a type annotation or an initializer.
}

function make(): int {
    return this // error: 'this' can only be used inside a class.
}

// Arrow functions in field initializers capture the instance; `this` directly there cannot be used.
class Arrows {
    x = 1
    ok = (): int => this.x
    twice = this.x * 2 // error: Field initializers cannot use 'this'.
    wrong = (): string => this.x // error: Type 'i64' is not assignable to type 'string'.
    plain = function (): int {
        return this.x // error: 'this' can only be used inside a class.
    }
}
// At the top level and in its arrow functions, `this` is null.
const top = () => this
const n: int = top() // error: Type 'null' is not assignable to type 'i64'.
console.log(this.x) // error: Property 'x' does not exist on type 'null'.

const p = new Point(1)
console.log(p.secret) // error: 'secret' is private and only accessible inside class 'Point'.
p.helper() // error: 'helper' is private and only accessible inside class 'Point'.
p.id = 3 // error: Cannot assign to 'id' because it is a read-only property.
const q = Point(1) // error: Class 'Point' must be instantiated with 'new Point(...)'.
const r = new Point() // error: Constructor of 'Point' expects 1 argument(s), got 0.
p.x() // error: Field 'x' is not a method.
const s = new Nope() // error: 'Nope' is not a class.
class Hidden {
    #secret = 1 // error: '#' private names are forbidden in Ore. Use the 'private' modifier.
}
