// The type `this` exists only in the non-static members of a class.
function f(x: this) {} // error: A 'this' type is available only in a non-static member of a class or interface.

class Counter {
    static zero: this | null = new Counter() // error: A 'this' type is available only in a non-static member of a class or interface.
    static reset(counter: this) {} // error: A 'this' type is available only in a non-static member of a class or interface.
}

// An interface's `this` would be the type of each class implementing it.
interface Chain {
    self(): this // error: A 'this' type in an interface is not supported yet.
}
