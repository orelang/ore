// A field without an annotation whose initializer uses a module variable declared further down has its type once the variable is declared.

class Counter {
    count = start * 2
    label: string = title
}

const early = new Counter()
console.log(early.count) // error: Field 'count' is used before its type is known: its initializer uses 'start', declared further down. Annotate the field.
console.log(early.label)
let start = 1
let title = "counter"
console.log(early.count)

class Broken {
    value = missing + 1 // error: Cannot find name 'missing'.
    other: int = unknownName // error: Cannot find name 'unknownName'.
}
