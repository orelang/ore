// A string constant that a string literal type cannot hold: the comparison is never true.
type U = "x" | "y"

function g(u: U): int {
    if (u === "z") return 1 // error: Type 'string' is not assignable to type 'U'.
    if (u === "x") return 2
    if (u === "x") return 3 // error: Type 'string' is not assignable to type '"y"'.
    return 4
}

console.log(g("y"))
