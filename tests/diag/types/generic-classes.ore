class Box<T> {
    static count = 0
    static items: T[] = [] // error: Static members cannot reference class type parameters.
    static readonly fixed = 1
    private static hidden = 2
    static nothing // error: Static field 'nothing' needs a type annotation or an initializer.
    static of<U>(v: U): U {
        return v
    }
}

Box.count = "many" // error: Type 'string' is not assignable to type 'i64'.
Box.fixed = 2 // error: Cannot assign to 'Box.fixed' because it is a read-only property.
console.log(Box.hidden) // error: 'hidden' is private and only accessible inside class 'Box'.
Box.missing // error: Class 'Box' has no static member 'missing'.
const s: string = Box.of(1) // error: Type 'i64' is not assignable to type 'string'.
