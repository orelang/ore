class Box<T> {
    static count = 0
    static of<U>(v: U): U {
        return v
    }
}

Box.count // error: Static fields of generic classes are not supported yet.
Box.missing // error: Class 'Box' has no static member 'missing'.
const s: string = Box.of(1) // error: Type 'i64' is not assignable to type 'string'.
