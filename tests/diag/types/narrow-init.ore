// A variable is narrowed to the value it holds; assignments take its declared type.
let mode: "a" | "b" = "a"
const b: "b" = mode // error: Type '"a"' is not assignable to type '"b"'.
mode = "b"
const a: "a" = mode // error: Type '"b"' is not assignable to type '"a"'.
mode = "c" // error: Type 'string' is not assignable to type '"a" | "b"'.

let v: int | string = 1
v = "s"
console.log(v * 2) // error: An integer constant is not assignable to type 'string'.

// A variable assigned after a function is created may change before it runs.
let s: string | null = "a"
const length = () => s.length // error: The value may be null
s = null

// In a loop, a variable assigned in the loop has its declared type.
let state: "idle" | "busy" = "idle"
for (let i = 0; i < 2; i++) {
    const idle: "idle" = state // error: Type '"busy" | "idle"' is not assignable to type '"idle"'.
    state = "busy"
}
