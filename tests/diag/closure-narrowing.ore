class Box {
    constructor(readonly value: int) {}
}

let changing: Box | null = new Box(1)
if (changing !== null) {
    const f = () => changing.value // error: The value may be null
}

const fixed: Box | null = new Box(2)
if (fixed !== null) {
    // A hoisted function may run before the check.
    function g(): int {
        return fixed.value // error: The value may be null
    }
}
