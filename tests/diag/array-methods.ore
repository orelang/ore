class Box {}

export function main() {
  const xs = [1, 2]
  xs.map((x) => {}) // error: The callback of 'map' must return a value.
  xs.filter((x) => x) // error: Type 'i64' is not assignable to type 'bool'.
  xs.map((s: string) => 1) // error: Parameter type 'string' does not match the expected 'i64'.
  xs.reduce((a, b) => a + b) // error: 'reduce' expects 2 argument(s), got 1.
  xs.sort((a, b) => "x") // error: The comparator of 'sort' must return a number.
  const boxes = [new Box()]
  boxes.sort() // error: Sorting 'Box' needs a comparator
  boxes.join() // error: Cannot join elements of type 'Box'.
  xs.forEach(5) // error: Expected a function of type '(i64, i64) => void', got 'i64'.
}
