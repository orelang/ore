export function main() {
  let s = "abc"
  let a = s + 1 // error: Only strings can be concatenated with '+'.
  s[0] = 65 // error: Strings are immutable.
  let b = s.size // error: Property 'size' does not exist on type 'string'.
  let c = s[-1] // error: Index -1 must not be negative.
  let d = s[1.5] // error: A floating-point constant is not assignable to integer type 'i64'
  let e = s.reverse() // error: Method 'reverse' does not exist on type 'string'.
  let f: u8 = s[0]
  let g: i32 = s[0] // error: Type 'u8' is not assignable to type 'i32'.
}
