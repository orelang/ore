function f(a: int, b = 2) {}
f() // error: expects 1 to 2 argument(s), got 0.
f(1, 2, 3) // error: expects 1 to 2 argument(s), got 3.
function g(a = 1, b: int) {} // error: A required parameter cannot follow an optional or rest parameter.
function h(...xs: int[]) {}
h(1, ...[2]) // error: Pass a single '...array' as all the rest arguments.
function k(...xs: int) {} // error: A rest parameter must have an array type.
function m(...xs: int[], y: int) {} // error: A rest parameter must be the last parameter.
function n(x: int = "no") {} // error: Type 'string' is not assignable to type 'i64'.
function o(x?: int = 1) {} // error: A parameter with a default value is already optional.
f(...[1]) // error: Spread arguments are only supported for a rest parameter.
const p = (x = 1) => x // error: Optional, default and rest parameters are not supported in closures
