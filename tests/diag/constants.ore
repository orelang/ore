const N = 300

export function main() {
  let a: u8 = 256 // error: Constant 256 overflows 'u8'
  let b: u8 = N // error: Constant 300 overflows 'u8'
  let c: i32 = 1.5 // error: not assignable to integer type 'i32'
  let d = i32(1e10) // error: Constant 10000000000 overflows 'i32'
  let e = 1 / 0 // error: Division by zero.
  let f = 1 << -1 // error: Shift count must not be negative.
  let g: bool = 1 // error: An integer constant is not assignable to type 'bool'
}
