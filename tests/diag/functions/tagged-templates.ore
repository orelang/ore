function numbers(strings: TemplateStringsArray, ...values: int[]): string {
    return `${strings.length}`
}

const count = 5
count`text` // error: 'count' is not a function

numbers`a${"text"}b` // error: Type 'string' is not assignable to type 'i64'.

function pair(strings: TemplateStringsArray, a: int): string {
    return ""
}
pair`no substitution` // error: expects 2 argument(s), got 1
pair`${1} and ${2}` // error: expects 2 argument(s), got 3

function plain(strings: string[]): string {
    return ""
}
plain`text` // error: Type 'TemplateStringsArray' is not assignable to type 'string[]'.

String.raw`${[1, 2]}` // error: Cannot format a value of type 'i64[]'.

// Only a tagged template makes the strings: arrays are not TemplateStringsArray.
const made: TemplateStringsArray = ["a"] // error: is not assignable to type 'TemplateStringsArray'.
function rest(...strings: TemplateStringsArray) {} // error: A rest parameter must have an array type.
