const { y = "no" } = p // error: Type 'string' is not assignable to type 'i64'.
const [a] = p // error: Type 'Point' cannot be destructured as an array.
const { z } = p // error: Property 'z' does not exist on type 'Point'.
const [b, c] = [1, 2]
const { x: d } // error: A destructuring declaration must be initialized.
const { ...r, x: e } = p // error: A rest element must be last in a destructuring pattern.
const [...f, g] = [1, 2] // error: A rest element must be last in a destructuring pattern.
const [h, ...i = []] = [1, 2] // error: A rest element cannot have a default value.
const { x: j, ...k = p } = p // error: A rest element cannot have a default value.
const { ...{ y: l } } = p // error: The rest of an object pattern must be a name, not a pattern.
let m = 0
let n: int[] = []
;[...n, m] = [1, 2] // error: A rest element must be last in a destructuring pattern.
;({ ...[m] } = p) // error: The rest of an object pattern must be a name, not a pattern.
