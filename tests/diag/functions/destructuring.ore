type Point = { x: int; y: int }

const p: Point = { x: 1, y: 2 }
const { x, ...rest } = p // error: Rest elements are not supported in object destructuring.
const { y = 5 } = p // error: Default values in destructuring are not supported.
const [a] = p // error: Type 'Point' cannot be destructured as an array.
const { z } = p // error: Property 'z' does not exist on type 'Point'.
const [b, c] = [1, 2]
const { x: d } // error: A destructuring declaration must be initialized.
