const f = (a: int, b?: int): int => a
f() // error: This function expects 1 to 2 argument(s), got 0.
f(1, 2, 3) // error: This function expects 1 to 2 argument(s), got 3.
const g = (...xs: int) => 0 // error: A rest parameter must be the last parameter, of an array type.
let h: (a: int, b?: int) => int = (a: int, b: int) => a // error: Parameter type 'i64' does not match the expected 'i64 | null'.
type Bad = (a?: int, b: int) => void // error: A required parameter cannot follow an optional parameter.
const r = (...xs: string[]) => xs.length
r(1) // error: An integer constant is not assignable to type 'string'.
