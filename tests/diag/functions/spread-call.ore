function sum(...xs: int[]): int {
    return xs.length
}
const strings = ["a"]
sum(1, ...strings) // error: An array of 'string' cannot be spread into an array of 'i64'.
sum(...7) // error: Only an array or a tuple can be spread into arguments.
const ints: int[] = []
ints.push(...strings) // error: An array of 'string' cannot be spread into an array of 'i64'.
ints.push(..."ab") // error: Only an array can be spread into an array.
const map = new Map<string, int>()
map.set(...strings, 1) // error: A spread argument must be a tuple, or be passed to a rest parameter.
const three: [string, int, int] = ["a", 1, 2]
map.set(...three) // error: 'set' expects 2 argument(s), got 3.
const floats = [2.0]
Math.pow(...floats) // error: A spread argument must be a tuple, or be passed to a rest parameter.
"x".slice(...7) // error: Only an array or a tuple can be spread into arguments.
