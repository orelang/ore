function sum(...xs: int[]): int {
    return xs.length
}
const strings = ["a"]
sum(1, ...strings) // error: An array of 'string' cannot be spread into an array of 'i64'.
sum(...7) // error: Only an array or a tuple can be spread into arguments.
const ints: int[] = []
ints.push(...strings) // error: An array of 'string' cannot be spread into an array of 'i64'.
ints.push(..."ab") // error: Only an array can be spread into an array.
