function pair(...p: [string, int]): string {
    return `${p[0]}=${p[1]}`
}
pair("a") // error: expects 2 argument(s), got 1.
pair("a", 1, 2) // error: expects 2 argument(s), got 3.
const words = ["a"]
pair(...words) // error: A spread argument must be a tuple, or be passed to a rest parameter.

function optional(...p: [int, string?]): void {}
optional() // error: expects 1 to 2 argument(s), got 0.

function call<A extends unknown[]>(f: (...args: A) => void, ...args: A): void {
    f(...args)
}
function takesInt(n: int): void {}
call(takesInt) // error: expects 2 argument(s), got 1.
call(takesInt, "x") // error: Type 'string' is not assignable to type 'i64'.
