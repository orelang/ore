function add(a: i32, b: i32): i32 {
    return a + b
}

function noReturn(a: i32): i32 {
    // error: must return a value of type 'i32' on every path
    if (a > 0) return 1
}

function untyped(a) {} // error: Parameter 'a' must have a type annotation.

function voidReturn() {
    return 1 // error: A function without a return type annotation cannot return a value.
}

add(1) // error: Function 'add' expects 2 argument(s), got 1.
let x: i64 = 5
add(x, 1) // error: Type 'i64' is not assignable to type 'i32'.
let s: string = add(1, 2) // error: Type 'i32' is not assignable to type 'string'.
