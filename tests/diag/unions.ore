type Circle = { kind: "circle"; r: f64 }
type Square = { kind: "square"; side: f64 }
type Shape = Circle | Square

function partial(s: Shape): f64 { // error: must return a value of type 'f64' on every path
  switch (s.kind) {
    case "circle":
      return s.r
  }
}

function fallthrough(s: Shape): f64 {
  switch (s.kind) {
    case "circle":
      println("round")
    case "square":
      return s.side // error: Property 'side' does not exist on type 'Circle | Square'.
  }
}

function radius(s: Shape): f64 {
  return s.r // error: Property 'r' does not exist on type 'Circle | Square'.
}

class Cat {}
class Dog {}

export function main() {
  const s: Shape = { kind: "circle", r: 1 }
  const t: Shape = { kind: "triangle", r: 1 } // error: Type 'string' is not assignable to type '"circle"'.
  const u: Shape = { r: 1 } // error: Missing property 'kind' of type 'Circle'.
  const mode: "a" | "b" = "c" // error: Type 'string' is not assignable to type '"a" | "b"'.
  const n: 1 | 2 = 1 // error: Only string literal types are supported yet.
  const c = new Cat()
  if (c instanceof Dog) {} // error: A value of type 'Cat' is never an instance of 'Dog'.
  if (c instanceof Shape) {} // error: The right side of 'instanceof' must be a class.
}
