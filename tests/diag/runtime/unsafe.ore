class Box {
    constructor(public value: int) {}
}

const p = unsafe.alloc(16)
unsafe.load(p) // error: needs a type argument
unsafe.sizeOf<i64>(p) // error: expects 0 argument(s)
unsafe.fromAddress<int>(p) // error: needs an object, array or map type
unsafe.addressOf(5) // error: needs an object, array or map
unsafe.atomicAdd(p, 1.5) // error: Atomic operations need an integer or 'ptr'
unsafe.atomicAdd(p, p) // error: needs an integer
unsafe.atomicLoad<string>(p) // error: Atomic operations need an integer or 'ptr'
unsafe.store(p, new Box(1))
unsafe.store<int>(p, "x") // error: is not assignable
const t = "nop"
unsafe.asm(t, "") // error: must be string literals
unsafe.asm("", "", "s") // error: must be a number or 'ptr'
unsafe.asm<string>("", "=r") // error: can return a number or 'ptr'
unsafe.add(p) // error: expects 2 argument(s)

