Math.sqrt("x") // error: Type 'string' is not assignable to type 'f64'.
Math.pow(2) // error: 'Math.pow' expects 2 argument(s), got 1.
const i: i32 = 1
Math.sqrt(i) // error: Type 'i32' is not assignable to type 'f64'.
Math.min("a", "b") // error: 'Math.min' needs numbers, got 'string'.
Math.nope() // error: 'Math' has no member 'nope'.
