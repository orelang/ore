const a = /(ab/ // error: Invalid regular expression: Unterminated group.
const b = /ab)/ // error: Invalid regular expression: Unmatched ')'.
const c = /a**/ // error: Invalid regular expression: Nothing to repeat.
const d = /[z-a]/ // error: Invalid regular expression: Range out of order in character class.
const e = /a{3,1}/ // error: Invalid regular expression: numbers out of order in {} quantifier.
const g = /(?<x>a)(?<x>b)/ // error: Invalid regular expression: Duplicate capture group name.
const h = /\k<y>(?<x>a)/ // error: Invalid regular expression: Invalid named capture referenced.
const i = /(?<=a)*b/ // error: Invalid regular expression: Invalid quantifier.
const j = /(?a)/ // error: Invalid regular expression: Invalid group.
const l = /a/gg // error: Invalid regular expression: Invalid flags 'gg'.
const m = /a/x // error: Invalid regular expression: Invalid flags 'x'.
const n = /a/uv // error: Invalid regular expression: Invalid flags 'uv'.
const o = /(?=a)*/u // error: Invalid regular expression: Invalid quantifier.
const p = /(?<1x>a)/ // error: Invalid regular expression: Invalid capture group name.

// The stricter syntax of the u and v flags, and what Ore leaves out of it.
const u1 = /\a/u // error: Invalid regular expression: Invalid escape.
const u2 = /\u{110000}/u // error: Invalid regular expression: Invalid Unicode escape.
const u3 = /\p{Foo=Bar}/u // error: Invalid regular expression: Invalid property name.
const u4 = /\p{Emoji}/u // error: Invalid regular expression: The property 'Emoji' is not supported.
const u5 = /[\d-z]/u // error: Invalid regular expression: Invalid character class.
const u6 = /a{/u // error: Invalid regular expression: Incomplete quantifier.
const u7 = /}/u // error: Invalid regular expression: Lone quantifier brackets.
const u8 = /\00/u // error: Invalid regular expression: Invalid decimal escape.
const u9 = /\k<a>/u // error: Invalid regular expression: Invalid named capture referenced.
const v1 = /[a-z&&b]/v // error: Invalid regular expression: Invalid set operation in character class.
const v2 = /[a&&&b]/v // error: Invalid regular expression: Invalid character in character class.
const v3 = /[(]/v // error: Invalid regular expression: Invalid character in character class.
const v4 = /[^\q{ab}]/v // error: Invalid regular expression: Negated character class may contain strings.
const v5 = /[^[\q{ab}--\q{ab}]]/v // error: Invalid regular expression: Negated character class may contain strings.
const v6 = /[\q{a(b}]/v // error: Invalid regular expression: Invalid character in character class.
const v7 = /[\q{a\db}]/v // error: Invalid regular expression: Invalid escape.
const v8 = /[\q{ab}]/u // error: Invalid regular expression: Invalid escape.
const fine = [/(?<=a)b/, /\p{L}/u, /[\w--\d]/v, /a/dgimsvy, /[^\q{a|b}]/v, /[^\q{ab}&&a]/v]

const re = /a/g
"abc".match(5) // error: An integer constant is not assignable to type 'string'.
"abc".replace(re) // error: 'replace' expects 2 argument(s), got 1.
"abc".replace(re, 5) // error: An integer constant is not assignable to type 'string'.
"abc".replace(re, (m: int) => "x") // error: Parameter type 'i64' does not match the expected 'string'.
"abc".split(re, "2") // error: Type 'string' is not assignable to type 'i64'.
"abc".search(re, 1) // error: 'search' expects 1 argument(s), got 2.
const x: string = re.exec("a") // error: Type 'RegExpMatch | null' is not assignable to type 'string'.
re.source = "b" // error: Cannot assign to 'source' because it is a read-only property.
