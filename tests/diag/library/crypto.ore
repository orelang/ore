crypto.getRandomValues([1.5, 2.5]) // error: Type 'f64' does not satisfy the constraint
crypto.getRandomValues(new Array<f32>(4)) // error: Type 'f32' does not satisfy the constraint
crypto.getRandomValues(["a"]) // error: Type 'string' does not satisfy the constraint
crypto.getRandomValues([true]) // error: Type 'bool' does not satisfy the constraint
crypto.randomUUID() // error: randomUUID
