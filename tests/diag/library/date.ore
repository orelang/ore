// Date takes numbers, strings and dates, without coercion.
const d = new Date(2024, 0, 1)
const a = new Date(true) // error: Type 'bool' is not assignable to type 'Date | f64 | null | string'.
const b = new Date(2024, "1") // error: Type 'string' is not assignable to type 'f64 | null'.
const i: int = 5
const c = new Date(2024, i) // error: Type 'i64' is not assignable to type 'f64 | null'.
d.setFullYear("2024") // error: Type 'string' is not assignable to type 'f64'.
d.setHours(1, "2") // error: Type 'string' is not assignable to type 'f64 | null'.
const e = Date.parse(0) // error: An integer constant is not assignable to type 'string'.
const f = Date.UTC("2024") // error: Type 'string' is not assignable to type 'f64'.
const g: int = d.getTime() // error: Type 'f64' is not assignable to type 'i64'. Use an explicit conversion: 'i64(...)'.
const h = d < d // error: Operator '<' cannot be applied to type 'Date'.
const k = d.toISOString(1) // error: Method 'Date.toISOString' expects 0 argument(s), got 1.
