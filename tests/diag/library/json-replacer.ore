const s = JSON.stringify([1], 2) // error: The second argument of 'JSON.stringify' is a replacer, null, an array of keys or a function '(key: string, value: unknown) => unknown': write 'JSON.stringify(value, null, 2)' to indent.
const t = JSON.stringify({ a: 1 }, [1]) // error: An integer constant is not assignable to type 'string'.
const keys = [1]
const u = JSON.stringify({ a: 1 }, keys) // error: The second argument of 'JSON.stringify' is a replacer, null, an array of keys or a function '(key: string, value: unknown) => unknown': write 'JSON.stringify(value, null, 2)' to indent.
const v = JSON.stringify([1], (key: int, value: unknown): unknown => value) // error: Parameter type 'i64' does not match the expected 'string'.
// The result is null when the replacer leaves the whole value out.
const w: string = JSON.stringify([1], (key, value) => value) // error: Type 'null | string' is not assignable to type 'string': the value may be null. Check it with '!== null' first, or use '??' or '!'.
