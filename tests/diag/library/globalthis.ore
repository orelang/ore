// globalThis holds the global names only, resolved at compile time.
const g = globalThis // error: 'globalThis' cannot be used as a value; use its members, as 'globalThis.Math'.
// A module's own top-level declarations are not on it, as in ES modules.
const limit = 10
console.log(globalThis.limit) // error: Property 'limit' does not exist on type 'typeof globalThis'.
// Nothing can be added to it.
globalThis.counter = 1 // error: Property 'counter' does not exist on type 'typeof globalThis'.
const m = globalThis.Math // error: 'Math' is a namespace; call its functions
function f(d: globalThis.Data): void {} // error: Cannot find type 'globalThis.Data'.
globalThis.Math = 1 // error: Cannot assign to 'globalThis.Math' because it is not a variable.
