function noDefault(n: int): int { // error: must return a value of type 'i64' on every path
  switch (n) {
    case 1:
      return 1
  }
}

function breaks(n: int): int { // error: must return a value of type 'i64' on every path
  switch (n) {
    case 1:
      break
    default:
      return 2
  }
}

function exhaustive(n: int): int {
  switch (n) {
    case 1:
    default:
      return 2
  }
}

switch ("a") {
  case 1: // error: An integer constant is not assignable to type 'string'.
    break
  default:
  default: // error: A switch can have only one 'default' clause.
}
sw: switch (1) {
  case 1:
    continue sw // error: Cannot continue 'sw': it labels a switch.
}
continue // error: 'continue' must be inside a loop.
