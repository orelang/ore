type Point = { x: f64; y: f64 }

export function main() {
  const a: Point = { x: 1 } // error: Missing property 'y' of type 'Point'.
  const b: Point = { x: 1, y: 2, z: 3 } // error: Property 'z' does not exist in type 'Point'.
  const c: Point = { x: 1, y: "no" } // error: Type 'string' is not assignable to type 'f64'.
  const d = { x: 1, x: 2 } // error: Duplicate property 'x'.
  const p: Point = { x: 1, y: 2 }
  p.z = 1 // error: Property 'z' does not exist on type 'Point'.
  console.log(p.w) // error: Property 'w' does not exist on type 'Point'.
  const e: { readonly id: int } = { id: 1 }
  e.id = 2 // error: Cannot assign to 'id' because it is a read-only property.
  let f: Point // error: Variable 'f' of type 'Point' must be initialized.
  const g: { x: i32 } = p // error: Type 'Point' is not assignable to type '{ x: i32 }'.
  console.log(p) // error: Cannot format a value of type 'Point'.
}
