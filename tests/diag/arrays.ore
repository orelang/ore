function take(xs: i32[]): void {}

export function main() {
  let a = [] // error: Cannot infer the type of an empty array.
  let b = [1, "x"] // error: An integer constant is not assignable to type 'string'.
  let c: u8[] = [1, 300] // error: Constant 300 overflows 'u8'
  let d = [1, 2]
  take(d) // error: Type 'i64[]' is not assignable to type 'i32[]'.
  take([1, 2])
  d.push(1.5) // error: A floating-point constant is not assignable to integer type 'i64'.
  d.pop(1) // error: 'pop' expects no arguments, got 1.
  println(d) // error: Cannot format a value of type 'i64[]'.
  let e: Array<string> = ["ok"]
  let f: string[] = e
  d.size // error: Property 'size' does not exist on type 'i64[]'.
}
