class Node {
    constructor(
        readonly left: Node | null,
        readonly right: Node | null,
    ) {}
}

function make(depth: int): Node {
    return depth === 0 ? new Node(null, null) : new Node(make(depth - 1), make(depth - 1))
}

function check(n: Node): int {
    const l = n.left
    const r = n.right
    return l === null || r === null ? 1 : 1 + check(l) + check(r)
}

const maxDepth = process.args.length > 0 ? (Number.parseInt(process.args[0]) ?? 18) : 18
console.log(`stretch tree of depth ${maxDepth + 1}\t check: ${check(make(maxDepth + 1))}`)
const longLived = make(maxDepth)
for (let depth = 4; depth <= maxDepth; depth += 2) {
    const iterations = 1 << (maxDepth - depth + 4)
    let sum = 0
    for (let i = 0; i < iterations; i++) sum += check(make(depth))
    console.log(`${iterations}\t trees of depth ${depth}\t check: ${sum}`)
}
console.log(`long lived tree of depth ${maxDepth}\t check: ${check(longLived)}`)
