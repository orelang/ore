// reference: node --experimental-transform-types
// exit: 13
// stderr: unsettled top-level await

// A top-level await of a promise that only a timer unref'd settles: the
// timer does not keep the program running, as in Node.
console.log("before")
await new Promise<void>((resolve) => {
    setTimeout(resolve, 10).unref()
})
console.log("never")
