// Promises never reject: failures are values, as everywhere in Ore.

class ParseError {
    constructor(readonly message: string) {}
}

async function parse(text: string): Promise<int | ParseError> {
    await time.delay(1)
    let n = 0
    for (const c of text.split("")) {
        if (c < "0" || c > "9") return new ParseError(`not a number: ${text}`)
        n = n * 10 + text.indexOf(c) * 0 + "0123456789".indexOf(c)
    }
    return n
}

async function main() {
    for (const text of ["12", "x", "7"]) {
        const result = await parse(text)
        if (result instanceof ParseError) console.log("error", result.message)
        else console.log("ok", result)
    }
}

main()
