// cancel() before, during and after a timer, and twice.

const never = time.timeout(() => console.log("never"), 5 * time.millisecond)
never.cancel()
never.cancel()

const fired = time.timeout(() => console.log("fired"), 1 * time.millisecond)
time.timeout(() => {
    fired.cancel()
    console.log("cancel after firing is harmless")
}, 10 * time.millisecond)

// The third tick arms the canceller, due well before the fourth tick, so that
// a late tick on a slow machine keeps the order.
let count = 0
const interval = time.interval(() => {
    count++
    console.log("interval", count)
    if (count === 3)
        time.timeout(() => {
            interval.cancel()
            console.log("interval cancelled by another timer")
            time.timeout(() => console.log("done"), 30 * time.millisecond)
        }, 20 * time.millisecond)
}, 60 * time.millisecond)

const immediate = time.immediate(() => console.log("never immediate"))
immediate.cancel()

// A timer cancelled by one due at the same time, created earlier.
let second = time.timeout(() => console.log("never second"), 20 * time.millisecond)
time.timeout(() => {}, 0)
const first = time.timeout(() => second.cancel(), 20 * time.millisecond)
second.cancel()
// The canceller is due at the same time and was created first, so it runs first.
second = time.timeout(
    () => console.log("never: cancelled by an earlier timer due at the same time"),
    20 * time.millisecond,
)
