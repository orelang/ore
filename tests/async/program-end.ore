// reference: none, Bun has no tasks

// The program ends when the event loop has nothing left: timers keep it
// running, a promise nobody settles does not, and tasks still running are
// stopped, as when main returns in Go.

new Promise<void>((resolve) => {}).then(() => console.log("never: nobody settles it"))
task.spawn(() => {
    time.sleep(200 * time.millisecond)
    console.log("never: the program ended first")
})
time.timeout(() => console.log("a timer keeps the program running"), 20 * time.millisecond)
console.log("top-level code done")
