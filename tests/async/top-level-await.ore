// The top-level code can await; queued microtasks run first.

task.microtask(() => console.log("microtask before await"))
console.log("before")
const n = await Promise.resolve(42)
console.log("after", n)
await time.delay(5 * time.millisecond)
console.log("after delay")

async function compute(): Promise<int> {
    return 7
}
console.log("computed", await compute())
