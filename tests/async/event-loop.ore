// The order of synchronous code, microtasks and timers.

console.log(1)

time.timeout(() => {
    console.log(2)

    Promise.resolve().then(() => {
        console.log(3)

        task.microtask(() => {
            console.log(4)
        })
    })

    time.timeout(() => {
        console.log(5)
    }, 0)
}, 0)

task.microtask(() => {
    console.log(6)

    time.timeout(() => {
        console.log(7)
    }, 0)

    Promise.resolve().then(() => {
        console.log(8)
    })
})

Promise.resolve().then(() => {
    console.log(9)
})

console.log(10)
