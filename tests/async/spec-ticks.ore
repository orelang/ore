// Tick counts from the ECMAScript spec, observed by interleaving with a
// counter that logs on every microtask.

let tick = 0
function ticker(n: int) {
    let left = n
    const step = () => {
        tick++
        console.log(`tick ${tick}`)
        left--
        if (left > 0) task.microtask(step)
    }
    task.microtask(step)
}

async function returnValue(): Promise<int> {
    return 1
}
async function returnPromise(): Promise<int> {
    return Promise.resolve(2)
}
async function returnAwait(): Promise<int> {
    return await Promise.resolve(3)
}
async function awaitValue(): Promise<int> {
    await 4
    return 4
}

ticker(8)
returnValue().then((v) => console.log("return value", v))
returnPromise().then((v) => console.log("return promise", v))
returnAwait().then((v) => console.log("return await", v))
awaitValue().then((v) => console.log("await value", v))

// resolve(promise) in an executor adopts it, two ticks later.
new Promise<int>((resolve) => resolve(Promise.resolve(5))).then((v) => console.log("adopted", v))
// A callback returning a promise is adopted too.
Promise.resolve(0)
    .then(() => Promise.resolve(6))
    .then((v) => console.log("then returned promise", v))
