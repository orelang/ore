// reference: none, Ore panics instead of rejecting
// exit: 2
// stderr: panic: broken in an async function

async function broken(): Promise<int> {
    await time.delay(1 * time.millisecond)
    process.panic("broken in an async function")
    return 0
}

console.log("start")
time.timeout(() => console.log("never: the panic ends the program"), 50 * time.millisecond)
await broken()
