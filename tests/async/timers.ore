// Timers fire in order of time, then of creation; immediates come before timers.

const start = "start"
console.log(start)

time.timeout(() => console.log("timeout 100"), 100 * time.millisecond)
time.timeout(() => console.log("timeout 20 a"), 20 * time.millisecond)
time.timeout(() => console.log("timeout 0"), 0)
time.timeout(() => console.log("timeout 20 b"), 20 * time.millisecond)
time.immediate(() => console.log("immediate"))
task.microtask(() => console.log("microtask"))

const cancelled = time.timeout(() => console.log("never"), 1 * time.millisecond)
cancelled.cancel()

let ticks = 0
const ticker = time.interval(() => {
    ticks++
    console.log("tick", ticks)
    if (ticks === 3) ticker.cancel()
}, 40 * time.millisecond)

time.timeout(() => {
    console.log("timeout 150")
    time.immediate(() => console.log("immediate from timer"))
    time.timeout(() => console.log("timeout 0 from timer"), 0)
    task.microtask(() => console.log("microtask from timer"))
}, 150 * time.millisecond)

async function waits() {
    await time.delay(60 * time.millisecond)
    console.log("delay 60")
}
waits()
