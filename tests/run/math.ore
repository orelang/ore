console.log(Math.PI, Math.E)
console.log(Math.sqrt(16), Math.pow(2, 10), Math.hypot(3, 4), Math.cbrt(27))
console.log(Math.floor(-1.5), Math.ceil(-1.5), Math.trunc(-1.5), Math.round(-2.5), Math.round(2.5), Math.round(0.49999999999999994))
console.log(Math.abs(-5), Math.abs(-2.5), Math.min(3, 7), Math.max(3.5, 1.0), Math.sign(-3))

// abs, min and max keep the numeric type.
const a: i32 = -7
const b: u8 = 200
const smallest: i32 = Math.min(a, 5)
console.log(Math.abs(a), Math.max(b, 100), smallest)

const angle = Math.PI / 2
console.log(Math.sin(angle), Math.round(Math.cos(angle) * 1000), Math.atan2(1, 1) * 4 === Math.PI)

// random is in [0, 1).
let ok = true
for (let i = 0; i < 1000; i++) {
  const r = Math.random()
  if (r < 0 || r >= 1) ok = false
}
console.log(ok)
