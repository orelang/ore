export function main() {
  // Numbers to strings and back.
  const n = 42
  const x = 3.14159
  console.log(n.toString() + "!", x.toFixed(2), (1.0).toFixed(3), true.toString())
  console.log(Number.parseInt("  -17px"), Number.parseInt("ff", 16), Number.parseInt("0x1A"), Number.parseInt("abc"))
  console.log(Number.parseFloat("2.5e3 meters"), Number.parseFloat("-.5"), Number.parseFloat("x"), Number.parseFloat("-Infinity"))
  const parsed = Number.parseInt("123")
  if (parsed !== null) console.log(parsed + 1)

  // Files.
  const path = `${process.getenv("TMPDIR") ?? "/tmp"}/ore-std-test.txt`
  const written = fs.writeFile(path, "line 1\nline 2\n")
  console.log(written === null, fs.exists(path))
  const text = fs.readFile(path)
  if (text instanceof Error) process.panic(text.message)
  console.log(text.split("\n").length, text.trim())
  const missing = fs.readFile("does/not/exist.txt")
  if (missing instanceof Error) console.log(missing.message.startsWith("cannot open does/not/exist.txt"))

  // Process and time.
  console.log(process.args.length, process.getenv("ORE_SURELY_UNSET") === null, process.getenv("HOME") !== null)
  console.log(Date.now() > 1700000000000)
}
