// globalThis: the global names as members of one value, resolved at compile
// time, as `globalThis.Math.max(1, 2)` is `Math.max(1, 2)`.

globalThis.console.log("hello")
console.log(globalThis.Math.max(1, 2), globalThis.Math.PI)
console.log(globalThis.Number.parseInt("42"), globalThis.JSON.stringify([1, 2]))
console.log(globalThis.globalThis.String.fromCharCode(65))

// Global classes: constructors, statics, instanceof, and as types.
const d: globalThis.Date = new globalThis.Date(0)
console.log(d.toISOString(), d instanceof globalThis.Date)
const r = new globalThis.RegExp("a+", "g")
console.log("caat".replace(r, "o"))
const p: globalThis.Promise<int> = globalThis.Promise.resolve(3)
console.log(await p)

// A local declaration does not hide the global name.
function shadowed(): void {
    const Math = { max: (a: int, b: int) => a }
    console.log(Math.max(1, 2), globalThis.Math.max(1, 2))
}
shadowed()

// Ore's own global names: conversions, namespaces and their types, utility types.
console.log(globalThis.i32(3.7), globalThis.BigInt(5), globalThis.time.millisecond)
const info: globalThis.fs.FileInfo | Error = globalThis.fs.stat("/")
console.log(info instanceof Error)
const part: globalThis.Partial<{ a: int }> = {}
console.log(part)
