// The methods of numbers, as JavaScript's Number.prototype: this program prints what Node prints.
const values = [
    0.0,
    -0.0,
    1.0,
    -1.0,
    0.5,
    -0.5,
    1.5,
    -2.5,
    0.1,
    0.3,
    1.0 / 3,
    2.0 / 3,
    123.456,
    -123.456,
    255,
    4096,
    1e21,
    1e-7,
    1.5e-7,
    123456789.123,
    9007199254740993,
    1.7976931348623157e308,
    5e-324,
    2.2250738585072014e-308,
    0.0000012345,
    1234.5678,
    99.99,
    9.995,
    1.005,
    1.45,
    3.14159,
    6.02e23,
    -6.02e23,
    1e100,
    0.1 + 0.2,
    65519.99,
    999999.9999,
    0.0005,
    1.0005,
    -0.0004,
]
for (const v of values) {
    console.log(
        v,
        v.toString(2),
        v.toString(3),
        v.toString(7),
        v.toString(16),
        v.toString(36),
        v.toFixed(),
        v.toFixed(2),
        v.toFixed(5),
    )
    console.log(
        v.toPrecision(),
        v.toPrecision(1),
        v.toPrecision(2),
        v.toPrecision(5),
        v.toPrecision(21),
        v.toExponential(),
        v.toExponential(0),
        v.toExponential(3),
        v.toExponential(20),
        v.toLocaleString(),
        v.valueOf(),
    )
}
for (const v of [Number.NaN, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY]) {
    console.log(v.toString(2), v.toFixed(2), v.toPrecision(3), v.toExponential(2), v.toLocaleString())
}

// Integers: a literal in parentheses or with two dots, or a variable.
const n = 255
console.log((255).toString(16), (255).toString(16), n.toString(2), n.toString(36), (-255).toString(16), n.toString())
console.log((1234567).toLocaleString(), (-1234567).toLocaleString(), (0).toLocaleString(), (999).toLocaleString())
console.log((25).toExponential(), (25).toPrecision(1), (25).toPrecision(2), (12).toFixed(3), (0.00001).toPrecision(1))
