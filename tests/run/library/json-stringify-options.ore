// node: a Map is written as an object, not as {}
// JSON.stringify's replacer array of keys and its space, a number or a string.

class Point {
    constructor(
        public x: f64,
        public y: f64,
        public label: string,
    ) {}
}

type Shape = { name: string; points: Point[]; note?: string }

const shape: Shape = { name: "tri", points: [new Point(1, 2, "a"), new Point(3, 4, "b")] }
// The keys kept, in the replacer's order, at every level; repeats count once.
console.log(JSON.stringify(shape, ["points", "y", "name", "x", "y"]))
console.log(JSON.stringify(shape, ["name", "note"]))
console.log(JSON.stringify(shape, []))
console.log(JSON.stringify([new Point(5, 6, "c")], ["label"], 2))
const scores = new Map<string, int>([
    ["a", 1],
    ["b", 2],
    ["c", 3],
])
console.log(JSON.stringify(scores, ["c", "a"]))
const keys = ["x"]
console.log(JSON.stringify(new Point(7, 8, "d"), keys))
// The space: spaces up to 10, or the first 10 characters of a string.
console.log(JSON.stringify([[1], [2, 3]], null, "--"))
console.log(JSON.stringify({ a: [1] }, null, 20))
console.log(JSON.stringify({ a: [1] }, null, -1))
console.log(JSON.stringify({ a: [1] }, null, "abcdefghijkl"))
console.log(JSON.stringify({ a: 1 }, null, ""))
console.log(JSON.stringify({ a: "é" }, null, "\t"))
