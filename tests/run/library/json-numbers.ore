// JSON numbers parse the same whatever memory follows their text: the heap is
// filled with small strings of digits, in the size class of the numbers' text.

let wrong = 0
for (let i = 0; i < 20000; i++) {
    let garbage = ""
    for (let k = 0; k < 8; k++) garbage = `77777${k}` + "777777777"
    if (garbage.length !== 15) wrong++
    const f = JSON.parse<f64>("1e2")
    const n = JSON.parse<int>("12")
    if (f instanceof Error || f !== 100) wrong++
    if (n instanceof Error || n !== 12) wrong++
}
console.log("wrong", wrong)
