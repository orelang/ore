// The same group name in different alternatives (ES2025): the group that took
// part gives the name's value, in groups, in \k<name> and in $<name>.
const date = /(?<year>\d{4})-(?<month>\d\d)|(?<month>\d\d)\/(?<year>\d{4})/
for (const s of ["2024-10", "10/2024"]) {
    const m = date.exec(s)
    if (m !== null) console.log(m.groups.get("year"), m.groups.get("month"), m.at(0))
}
console.log("2024-10 and 11/2025".replace(/(?<y>\d{4})-(?<m>\d\d)|(?<m>\d\d)\/(?<y>\d{4})/g, "$<m>.$<y>"))
const twice = /(?:(?<c>a)|(?<c>b))\k<c>/
console.log(twice.test("aa"), twice.test("bb"), twice.test("ab"))
