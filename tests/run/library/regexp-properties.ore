// \p{...} with each property that JavaScript has, by every name: how many
// characters of a sample (every character up to U+2FFF, then one in 17 up
// to U+1FFFF and one in 97 after) each takes, as Node counts them (Unicode
// 17.0).

let sample = ""
for (let c = 0; c <= 0x10ffff; c += c < 0x3000 ? 1 : c < 0x20000 ? 17 : 97) {
    if (c < 0xd800 || c > 0xdfff) sample += String.fromCodePoint(c)
}

