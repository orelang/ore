// A match is indexed, destructured and iterated as JavaScript's match arrays.

const re = /(\w+)=(\d+)?/
const m = "x key= y".match(re)!
console.log(m[0], m[1], m[2], m.length, m.index, m[m.length - 1] === null)
const [, k, v] = "a=1".match(re)!
console.log(k, v)
const [whole, ...rest] = re.exec("b=22")!
console.log(whole, rest)
for (const c of "c=3".match(re)!) console.log(c)
const date = /(?<year>\d{4})-(?<month>\d{2})/.exec("on 2024-05")!
console.log(date[1], date[2], date.index, date.groups.get("year"))
const i = 2
console.log(date[i]!.length)
console.log(m)
const all = "a=1 b=2".match(/\w=\d/g)!
console.log(all[0], all[1], all.length)
