// console.log prints a URL and URLSearchParams as Node does; JSON.stringify
// writes a URL as its href.
const u = new URL("https://user:pw@example.com:8080/a/b?x=1&y=2#frag")
console.log(u)
console.log(new URL("mailto:someone@example.com"))
console.log(u.searchParams)
console.log(new URLSearchParams())
console.log(new URLSearchParams("a=it's"))
console.log({ link: u, params: [new URLSearchParams("k=v")] })
console.log({ a: { b: u } })
console.log({ a: { b: { c: u, d: new URLSearchParams("k=v") } } })

// Pairs longer than a line go on several lines.
const long = new URL(`http://x/?${"a".repeat(80)}=1&b=2&c=3`)
console.log([long])
console.log(long.searchParams)

console.log(JSON.stringify(u), JSON.stringify({ list: [u, long] }))
console.log(u.toString(), u.toJSON(), u.searchParams.toString())
