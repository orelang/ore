// encodeURIComponent, encodeURI, decodeURIComponent and decodeURI, as in JavaScript.

const samples = [
    "",
    "plain",
    "a b&c=d/e?f#g",
    "-_.!~*'()",
    ";/?:@&=+$,#",
    "héllo wörld",
    "日本語",
    "😀",
    "100%",
    '<"`{}|\\^>',
]
for (const s of samples) {
    const component = encodeURIComponent(s)
    const uri = encodeURI(s)
    console.log(component, uri)
    console.log(decodeURIComponent(component) === s, decodeURI(uri) === s)
}

console.log(decodeURIComponent("%2F%3a%23%e6%97%a5"))
console.log(decodeURI("%2F%3a%23%e6%97%a5%20x"))
console.log(decodeURI("%41%2f%2F"))
console.log(encodeURI("http://example.com/a b?q=1&r=é#frag"))
console.log(decodeURIComponent("a+b%2Bc"))
console.log(decodeURIComponent("%EF%BF%BD"))
console.log(globalThis.encodeURIComponent("a b"))
