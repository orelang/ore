// structuredClone of maps with object keys, sets of objects, unions and
// classes without methods, which stay instances of their class.

type Item = { id: number; label: string | null }

// A key that is also a value: the copy keeps one object for both.
const k1: Item = { id: 1, label: "one" }
const k2: Item = { id: 2, label: null }
const byItem = new Map<Item, Item[]>([
    [k1, [k1, k2]],
    [k2, []],
])
const copy = structuredClone(byItem)
const keys = [...copy.keys()]
console.log(copy.size, keys[0] === k1, copy.get(keys[0])![0] === keys[0], copy.get(keys[0])![1] === keys[1])
console.log(copy.get(k1) === null, copy.has(keys[1]))

const set = new Set<Item>([k1, k2])
const set2 = structuredClone(set)
const items = [...set2.values()]
items[0].id = 10
console.log(k1.id, items[0].id, set2.has(items[0]), set2.has(k1))

// A union of objects, and a nullable one.
type Shape = { kind: "circle"; r: number } | { kind: "square"; side: number[] }
const shapes: Shape[] = [
    { kind: "circle", r: 1 },
    { kind: "square", side: [2] },
]
const shapes2 = structuredClone(shapes)
const sq = shapes2[1]
if (sq.kind === "square") sq.side.push(3)
console.log(shapes, shapes2)
let maybe: Item | null = null
console.log(structuredClone(maybe))
maybe = k1
const maybe2 = structuredClone(maybe)
console.log(maybe2, maybe2 === k1)

// A class with only fields is copied as the same class; a subclass as the
// subclass. JavaScript makes plain objects of them: there, instanceof is false.
class Tree {
    children: Tree[] = []
    parent: Tree | null = null
    constructor(public name: string) {}
}
class Leaf extends Tree {
    weight = 1
}
const root = new Tree("root")
const leaf = new Leaf("leaf")
leaf.parent = root
root.children.push(leaf, leaf)
const root2 = structuredClone(root)
const leaf2 = root2.children[0]
console.log(root2.name, root2 instanceof Tree, leaf2 instanceof Leaf, leaf2 === root2.children[1])
console.log(leaf2.parent === root2, leaf2 === leaf, root2.children.length)
leaf2.name = "copied"
console.log(leaf.name, leaf2.name)

// A bigger list, to cross several collections.
const list: int[][] = []
for (let i = 0; i < 20000; i++) list.push([i])
const list2 = structuredClone(list)
let sum = 0
for (const x of list2) sum += x[0]
console.log(list2.length, sum, list2[5] === list[5])
