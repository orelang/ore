// env: ORE_TEST_NAME_PATTERN=parse > (num|str)

// `ore test -t <pattern>`: only the tests whose full names match the regular
// expression run, which `ore test` gives the program in ORE_TEST_NAME_PATTERN.

import { describe, expect, fail, test } from "ore:test"

describe("parse", () => {
    test("numbers", () => expect(Number.parseInt("12")).toBe(12))
    test("strings", () => expect("ab".length).toBe(2))
    test("booleans", () => fail("runs"))
})

test("numbers", () => fail("runs"))
