// The constants and predicates of `Number`, as in JavaScript.
const nan = Number.NaN
console.log(nan, nan === nan, Number.POSITIVE_INFINITY, Number.NEGATIVE_INFINITY)
console.log(Number.MAX_SAFE_INTEGER, Number.MIN_SAFE_INTEGER, Number.EPSILON)
console.log(Number.MAX_VALUE, Number.MIN_VALUE, 1 + Number.EPSILON > 1)
console.log(f32(Number.POSITIVE_INFINITY), Math.max(1, Number.NaN), int(Number.MAX_SAFE_INTEGER))
console.log(Number.isNaN(nan), Number.isNaN(1), Number.isNaN(Number.POSITIVE_INFINITY))
console.log(Number.isFinite(Number.NEGATIVE_INFINITY), Number.isFinite(nan), Number.isFinite(2.5))
console.log(Number.isInteger(3), Number.isInteger(3.5), Number.isInteger(nan))
console.log(Number.isSafeInteger(Number.MAX_SAFE_INTEGER), Number.isSafeInteger(Number.MAX_SAFE_INTEGER + 2))
