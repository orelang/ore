// console.log prints Headers as Node does: each name in the case it was
// first given, in the order it came first, its values joined; laid out as an
// object of its own, never [Object], indented to where it is printed.
const h = new Headers({ "Content-Type": "text/html", "X-A": " 1 " })
h.append("set-cookie", "a=1")
h.append("Set-Cookie", "b=2")
h.append("x-a", "2")
console.log(h)
console.log(new Headers())
console.log(new Headers({ a: "it's", b_1: "x" }))
console.log({ h, list: [h] })
console.log({ a: { b: { c: h } } })
console.log({ a: { b: { c: { d: h } } } })
console.log([new Headers({ a: "1" }), new Headers()])

// set keeps the place of the name and takes its case; delete and append move it last.
const x = new Headers()
x.append("A", "1")
x.append("B", "1")
x.append("a", "2")
x.set("a", "3")
x.set("New", "4")
console.log(x)
x.delete("A")
x.append("a", "5")
x.append("b", "x")
console.log(x)

// Longer than a line, or many short ones: one per line.
const long = new Headers([
    ["a".repeat(80), "1"],
    ["b", "2"],
])
console.log(long)
console.log([long])
const many = new Headers()
for (let i = 0; i < 10; i++) many.append(`h${i}`, `v${i}`)
console.log(many)
