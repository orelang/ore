// With `only` tests, the other tests of the file do not run, nor do the
// hooks of groups without a test that runs.

import { beforeAll, describe, fail, only, test } from "ore:test"

test("not this one", () => fail("runs"))

describe("group", () => {
    test("nor this one", () => fail("runs"))
    only("this one", () => {})
})

describe("other group", () => {
    beforeAll(() => fail("runs"))
    test("not here", () => fail("runs"))
})

only("and this one", () => {})
