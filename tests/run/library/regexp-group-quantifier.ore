// A quantifier on a group that holds a lookaround repeats the group, which
// JavaScript allows; on the lookbehind itself it is an error (found by
// tests/fuzz/regexp).
console.log(/(?:(?<!b*)){0,}\D+/.exec("b1aa")?.at(0))
console.log(/\B(?:a){2}(?:(?<=\w\w))??\w/.exec("baab")?.at(0))
console.log(/(?:(?=a)){2}a/.test("a"))
