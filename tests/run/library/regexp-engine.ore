// The matcher on many patterns: each line is a pattern, its flags, an input
// and what exec finds there (the captures, unset as "-", and the index), as
// JavaScript finds it.

const cases = [
    // Characters, escapes and classes.
    ["abc", "", "xabcx"],
    ["a.c", "", "a\nc abc"],
    ["a.c", "s", "a\nc"],
    ["\\d+\\.\\d*", "", "pi is 3.14!"],
    ["\\w+@\\w+\\.com", "", "mail me: joe@example.com."],
    ["\\s+", "", "a \t\n b"],
    ["\\D\\W\\S", "", "12 ab_ ;x"],
    ["[a-f0-9]+", "", "xyz c0ffee"],
    ["[^a-z]+", "", "abc123def"],
    ["[\\d-z]+", "", "a-z9-"],
    ["[-a]+", "", "x-a-"],
    ["[a-]+", "", "x-a-"],
    ["[\\]\\[]+", "", "x[]]"],
    ["[]", "", "abc"],
    ["[^]", "", "\n"],
    ["\\x41\\u0042\\103", "", "zABC"],
    ["\\cJ", "", "a\nb"],
    ["[\\b]", "", "a\bb"],
    ["\\0", "", "a\u0000b"],
    ["a{2}", "", "aaa"],
    ["a{2,}", "", "aaaaa"],
    ["a{1,3}", "", "aaaaa"],
    ["a{,3}", "", "a{,3}"],
    ["x{", "", "x{"],
    ["}]", "", "a}]"],
    ["\\/", "", "a/b"],
    ["\\$\\^\\.\\*", "", "$^.*"],
    // Anchors and boundaries.
    ["^abc", "", "abcabc"],
    ["abc$", "", "abcabc"],
    ["^b", "", "a\nb"],
    ["^b", "m", "a\nb"],
    ["a$", "m", "a\nb"],
    ["\\bfoo\\b", "", "afoo foo"],
    ["\\Boo\\B", "", "foo nook"],
    ["^$", "", ""],
    ["$", "", "abc"],
    // Groups and alternation.
    ["(a)(b)?(c)", "", "ac"],
    ["(?:ab)+", "", "ababab"],
    ["(a|ab)(c|bcd)(d*)", "", "abcd"],
    ["cat|dog|bird", "", "a bird and a dog"],
    ["(?<year>\\d{4})-(?<month>\\d{2})", "", "on 2024-05-17"],
    ["((a)|b)+", "", "ab"],
    ["(z)((a+)?(b+)?(c))*", "", "zaacbbbcac"],
    ["(a*)*", "", "b"],
    ["(a*)+", "", "b"],
    ["(a|b)*?c", "", "abac"],
    ["(.*?)a(?!(a+)b\\2c)\\2(.*)", "", "baaabaac"],
    // Quantifiers, greedy and lazy.
    ["a+?", "", "aaa"],
    ["a*?b", "", "aaab"],
    ["<.*>", "", "<a><b>"],
    ["<.*?>", "", "<a><b>"],
    ["a??b", "", "ab"],
    ["(a{2,3}?)(a*)", "", "aaaaa"],
    ["x*", "", "abc"],
    // Backreferences.
    ["(\\w)\\1", "", "abccd"],
    ["(?<q>['\"]).*?\\k<q>", "", "say \"hi\" 'there'"],
    ["\\1(a)", "", "aa"],
    ["(a)|\\1b", "", "b"],
    ["\\8", "", "8"],
    ["(a)\\2", "", "a\u0002"],
    // Lookahead.
    ["\\w+(?=!)", "", "hey you!"],
    ["\\d+(?!px)", "", "12px 34em"],
    ["(?=(a+))a*b\\1", "", "baaabac"],
    ["(?=(a+))", "", "baaabac"],
    ["(?!(a))b", "", "b"],
    // Ignore case.
    ["hello", "i", "Say HeLLo"],
    ["[a-z]+", "i", "123ABCdef"],
    ["[^a-z]+", "i", "abcDEF123"],
    ["(a)\\1", "i", "aA"],
    ["ü", "i", "Ü"],
    ["Σ", "i", "σ"],
    ["\\w+", "i", "ſ"],
    // Characters beyond ASCII, matched at the start (indices are byte offsets in Ore).
    ["^\\uD83D\\uDE00", "", "😀"],
    ["^[α-ω]+", "", "αβγ1"],
    ["^\\S+", "", "été là"],
]

function show(text: string | null): string {
    return text ?? "-"
}

for (const [source, flags, input] of cases) {
    const re = new RegExp(source, flags)
    const m = re.exec(input)
    if (m === null) {
        console.log(`/${source}/${flags}: null`)
        continue
    }
    const parts: string[] = []
    for (let i = 0; i < m.length; i++) parts.push(show(m.at(i)))
    console.log(`/${source}/${flags}: [${parts.join(", ")}] at ${m.index}`)
}
