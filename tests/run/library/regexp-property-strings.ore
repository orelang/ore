// The properties of strings of the `v` flag, in classes and their
// operations, and properties ignoring case: each line is a pattern, its
// flags, an input, the text before the first match and what it matched,
// then the input with every match marked, as JavaScript finds them.

const cases = [
    // Properties of strings: emoji of several characters as one.
    ["\\p{RGI_Emoji}", "v", "a 👍🏽 b"],
    ["\\p{RGI_Emoji}", "v", "x 👨‍👩‍👧‍👦 y"],
    ["\\p{RGI_Emoji}", "v", "flag 🇫🇷!"],
    ["\\p{RGI_Emoji}", "v", "key #️⃣ 5️⃣"],
    ["\\p{RGI_Emoji}", "v", "🏴󠁧󠁢󠁳󠁣󠁴󠁿 and 🏴"],
    ["\\p{RGI_Emoji}", "v", "plain ☺ and ☺️"],
    ["^\\p{RGI_Emoji}+$", "v", "😀🇯🇵👩🏾‍🚀"],
    ["\\p{Basic_Emoji}", "v", "a ⌚ ☺️ 👍🏽"],
    ["\\p{Emoji_Keycap_Sequence}", "v", "1 2️⃣ *️⃣"],
    ["\\p{RGI_Emoji_Flag_Sequence}", "v", "🇦🇧🇨🇩 🇺🇸"],
    ["\\p{RGI_Emoji_Modifier_Sequence}", "v", "👍 👍🏿"],
    ["\\p{RGI_Emoji_Tag_Sequence}", "v", "🏴󠁧󠁢󠁷󠁬󠁳󠁿"],
    ["\\p{RGI_Emoji_ZWJ_Sequence}", "v", "🧑‍💻 👨‍❤️‍👨"],
    // In classes, with strings of their own and set operations.
    ["[\\p{RGI_Emoji_Flag_Sequence}\\q{abc}x]", "v", "abc 🇫🇷 x"],
    ["[\\p{RGI_Emoji_Flag_Sequence}--\\q{🇫🇷}]", "v", "🇫🇷 🇩🇪"],
    ["[\\p{RGI_Emoji}&&\\p{RGI_Emoji_Flag_Sequence}]", "v", "😀 🇮🇹"],
    ["[\\p{RGI_Emoji}--\\p{Basic_Emoji}]", "v", "😀 👍🏽"],
    ["[\\p{RGI_Emoji}&&[\\p{Emoji_Keycap_Sequence}\\q{😀}]]", "v", "😀 4️⃣ 😃"],
    ["[[\\p{Emoji_Keycap_Sequence}a-c]--[a\\q{1️⃣}]]", "v", "1️⃣ 2️⃣ a b"],
    ["(?<=\\p{RGI_Emoji_Flag_Sequence})x", "v", "🇫🇷x"],
    ["(\\p{RGI_Emoji_Modifier_Sequence})\\1", "v", "👋🏻👋🏻"],
    ["\\p{RGI_Emoji}", "vi", "👍🏽"],
    ["[\\p{RGI_Emoji_Tag_Sequence}\\q{AB}]", "vi", "ab 🏴󠁧󠁢󠁥󠁮󠁧󠁿"],
    // Ignoring case: the characters of one case folding as one, in every script.
    ["\\p{Lu}", "iu", "ա"],
    ["\\p{Lu}", "u", "ա"],
    ["\\P{Lu}", "iu", "Ա"],
    ["[^\\p{Lu}]", "iu", "ա"],
    ["\\p{Lowercase}", "iu", "Ꭰ"],
    ["\\p{Ll}", "iv", "ᲀ"],
    ["\\P{Ll}", "iv", "aB1"],
    ["[\\p{Lu}--[A-Z]]", "iv", "abΣσ"],
    ["[\\p{Script=Greek}&&\\p{Ll}]", "iv", "ΑΣΩ"],
    ["ǆ", "i", "Ǆǅ"],
    ["ꭰ", "i", "Ꭰ"],
    ["\u{10400}", "i", "\u{10428}"],
    ["\u{10400}", "iu", "\u{10428}"],
    ["ß", "i", "ẞ"],
    ["ß", "iu", "ẞ"],
    ["\u212a", "i", "k"],
    ["\u212a", "iu", "k"],
    ["ſ", "i", "S"],
    ["ſ", "iu", "S"],
    ["[ᲀ-ᲂ]", "i", "вОС"],
    ["[ꙋ]", "iu", "ᲈꙊ"],
    ["(ζ)\\1", "i", "ζΖ"],
    ["ა", "i", "Ა"],
    ["ა", "iu", "Ა"],
    // Scripts and their extensions, other categories, binary properties.
    ["\\p{Script=Hiragana}+", "u", "カタカナーひらがなー"],
    ["\\p{Script_Extensions=Hiragana}+", "u", "カタカナーひらがなー"],
    ["\\p{scx=Grek}+", "u", "ab͂αβ"],
    ["\\p{sc=Zyyy}+", "u", "abc 123!?"],
    ["\\p{P}+", "u", "word «quote» — end…"],
    ["\\p{Sc}", "u", "price: 12€"],
    ["\\p{Zs}+", "u", "a\u00a0\u3000b"],
    ["\\p{Emoji_Presentation}+", "u", "#1⌚🚀"],
    ["\\p{Extended_Pictographic}", "u", "x©y"],
    ["\\p{ID_Start}\\p{ID_Continue}*", "u", "1 переменная_2"],
    ["\\p{White_Space}+", "u", "a\t\u2028 b"],
    ["\\p{Assigned}", "u", "\u0378\u0379a"],
    ["\\P{Any}", "u", "abc"],
    ["[\\p{sc=Han}\\p{sc=Hira}]+", "u", "x漢字かなx"],
    ["\\p{RI}{2}", "u", "🇫🇷"],
]

for (const [source, flags, input] of cases) {
    const m = new RegExp(source, flags).exec(input)
    const marked = input.replace(new RegExp(source, flags + "g"), "[$&]")
    if (m === null) console.log(`/${source}/${flags}: null ${marked}`)
    else console.log(`/${source}/${flags}: ${JSON.stringify(input.slice(0, m.index))} ${m.at(0)} ${marked}`)
}
