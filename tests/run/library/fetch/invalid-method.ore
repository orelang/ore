// exit: 2
// stderr: TypeError: 'a b' is not a valid HTTP method.
// An invalid method panics, as JavaScript throws a TypeError; fetch gives it as a value.
const failed = await fetch("http://127.0.0.1/", { method: "a b" })
console.log(failed instanceof Error ? failed.message : "fetched")
new Request("http://127.0.0.1/", { method: "a b" })
