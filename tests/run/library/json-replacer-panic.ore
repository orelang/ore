// exit: 2
// stderr: panic: JSON.stringify: a value of type Set<i64> cannot be converted to JSON

// What a replacer returns is checked when it is written: a set has no JSON.
const s = new Set<int>([1])
console.log(JSON.stringify([1], (key) => (key === "0" ? "zero" : null)))
console.log(JSON.stringify([1], (key, value) => (key === "0" ? s : value)))
