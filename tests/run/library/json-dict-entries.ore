// JSON.parse into a dictionary with named entries: the required ones must be
// there, and each of its own type.

type Env = { home: string; [name: string]: string }
type Shape = { kind: "circle" | "square"; size?: f64; [key: string]: string | f64 }

function env(text: string) {
    const r = JSON.parse<Env>(text)
    if (r instanceof Error) console.log(r.message)
    else console.log(r.home, JSON.stringify(r))
}

function shape(text: string) {
    const r = JSON.parse<Shape>(text)
    if (r instanceof Error) console.log(r.message)
    else console.log(r.kind, r.size ?? 0, JSON.stringify(r))
}

env(`{"shell":"bash","home":"/home/ada"}`)
env(`{"shell":"bash"}`)
env(`{"home":1}`)
shape(`{"kind":"circle","size":2,"color":"red"}`)
shape(`{"kind":"square"}`)
shape(`{"kind":"triangle"}`)
shape(`{"kind":"circle","size":"big"}`)
