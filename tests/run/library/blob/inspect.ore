// console.log prints a Blob and a File as Node does; JSON.stringify writes
// them as {}, as JavaScript, which sees no properties of their own.
const b = new Blob(["abc"], { type: "text/plain" })
const f = new File(["xy"], "a.txt", { lastModified: 1700000000000 })
console.log(b)
console.log(new Blob())
console.log(f)
console.log([b, f], { blob: b, file: f })
console.log({ a: { b: { c: b, d: f } } })
const held: Blob = f
console.log(held)
// Laid out as at the top level, then indented as deep as the blob.
const long = new File([], "a much longer name than fits on one line with the rest.txt", { lastModified: 1 })
console.log(long)
console.log([long], { x: { y: long } })
console.log({ x: { y: [b] }, list: [[b, b, b]] })
console.log(JSON.stringify(b), JSON.stringify(f), JSON.stringify({ list: [b, f] }))
console.log(JSON.stringify({ b }, null, 2))
console.log(JSON.stringify({ b, n: 1 }, (key, value) => (key === "n" ? 2 : value)))
