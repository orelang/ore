// env: TZ=UTC
// Date in UTC; the output is Node's with TZ=UTC.
const d = new Date(2024, 9, 15, 12, 5, 9, 7)
console.log(d.getTime(), d.getTimezoneOffset(), d.getHours(), d.getUTCHours())
console.log(d.toString())
console.log(d.toTimeString(), "|", d.toUTCString(), "|", d.toLocaleString())
console.log(Date.parse("2024-10-15T12:05:09"), Date.parse("Oct 15 2024 12:05:09"), Date.parse("2024-10-15"))
console.log(new Date(Date.UTC(-1, 0, 1)).toString())
console.log(new Date(1e12), [new Date(-1e12)])
