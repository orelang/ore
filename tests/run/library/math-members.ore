// The members of Math that JavaScript has beyond the common ones, with its
// results at the edges: this program prints what Node prints.
const values = [
    0.0, -0.0, 1.0, -1.0, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 0.49999999999999994, 123.456, -123.456, 255, 4096, 1e21,
    1.7976931348623157e308, 5e-324, 65504, 65519.99, 65520, 6.1e-5, 5.96e-8, 2.98e-8, 2.99e-8, 4294967296.5,
    -4294967297,
]
for (const v of values) {
    console.log(v, Math.round(v), 1 / Math.round(v), Math.trunc(v), Math.sign(v), Math.fround(v), Math.f16round(v))
    console.log(Math.clz32(v), Math.imul(v, 3), Math.hypot(v, 3), Math.hypot(v), v ** 2)
}
const nan = Number.NaN
const inf = Number.POSITIVE_INFINITY
for (const v of [nan, inf, -inf]) {
    console.log(Math.round(v), Math.fround(v), Math.f16round(v), Math.clz32(v), Math.imul(v, 2), Math.hypot(v, nan))
}
console.log(Math.LN10, Math.LN2, Math.LOG10E, Math.LOG2E, Math.SQRT1_2, Math.SQRT2, Math.PI, Math.E)
console.log(Math.hypot(), Math.hypot(3, 4, 12), Math.hypot(-3), Math.hypot(1e200, 1e200), Math.hypot(nan, inf))
console.log(1 / Math.max(-0.0, 0.0), 1 / Math.min(0.0, -0.0), 1 / Math.max(0.0, -0.0), 1 / Math.min(-0.0, 0.0))
console.log(Math.pow(1, nan), Math.pow(-1, inf), Math.pow(1, -inf), 1 ** nan, (-1) ** inf, Math.pow(nan, 0))
console.log(Math.clz32(1), Math.clz32(-1), Math.clz32(4294967296), Math.clz32(0.5), Math.clz32(2147483648))
console.log(Math.imul(2147483647, 2), Math.imul(-5, 12), Math.imul(4294967295, 5), Math.imul(0xffffffff, 0xffffffff))
console.log(Math.round(-0.5), 1 / Math.round(-0.5), 1 / Math.round(-0.4), 1 / Math.round(-0.0))
console.log(
    Math.round(4503599627370495.5),
    Math.round(-4503599627370495.5),
    Number.isFinite(Math.cbrt(Number.MAX_VALUE)),
)
console.log(Math.sinh(0), Math.cosh(0), Math.tanh(inf), Math.asinh(-0.0), Math.acosh(1), Math.atanh(1), Math.atanh(2))
// The libm functions at their exact points; elsewhere libm and V8 may differ in the last bit.
console.log(Math.expm1(0), Math.expm1(-inf), Math.log1p(-1), Math.log1p(-2), Math.sinh(-inf), Math.cosh(-inf))
