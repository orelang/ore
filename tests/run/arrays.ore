function sum(xs: int[]): int {
  let total = 0
  for (let i = 0; i < xs.length; i++) total += xs[i]
  return total
}

function squares(n: int): int[] {
  const out: int[] = []
  for (let i = 0; i < n; i++) out.push(i * i)
  return out
}

function grow(xs: int[]): int {
  xs.push(100)
  return 7
}

export function main() {
  const xs = [3, 1, 4, 1, 5]
  println(xs.length, xs[0], xs[4], sum(xs))

  // Arrays are references, like in TypeScript.
  const alias = xs
  alias[0] = 9
  alias.push(2)
  println(xs[0], xs.length, alias === xs, xs.slice() === xs)

  const sq = squares(6)
  println(sq.length, sq[5], sum(sq))

  // Element compound assignment and increments evaluate the target once.
  const counts: u8[] = [250, 0]
  counts[0] += 10
  counts[1]++
  ++counts[1]
  println(counts[0], counts[1])

  // The value is evaluated before the element is written, even if it grows the array.
  const ys = [0]
  ys[0] = grow(ys)
  println(ys[0], ys[1], ys.length)

  // push returns the new length; pop returns the removed element.
  const stack: string[] = []
  println(stack.push("a", "b", "c"), stack.pop(), stack.length)

  const words = ["x", "y"]
  words[1] += "z"
  println(words[0], words[1])

  // Nested arrays and slices.
  const grid: f64[][] = [[1, 2], [3.5]]
  grid[1].push(4)
  println(grid.length, grid[1].length, grid[1][1], grid[0][1])
  const part = sq.slice(1, -2)
  println(part.length, part[0], part[2])

  let empty: bool[]
  println(empty.length)
}
