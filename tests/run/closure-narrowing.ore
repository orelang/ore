// Function literals know what was narrowed about constants where they are created.

class Box {
    constructor(readonly value: int) {}
}

function find(n: int): Box | null {
    return n > 0 ? new Box(n) : null
}

const box = find(3)
if (box === null) process.exit(1)
const read = () => box.value * 2
console.log(read(), [1, 2].map((x) => x + box.value).join(","))

function log(message: string): void {
    console.log(message)
}

// `return f()` of a void function calls it and returns.
function report(ok: bool): void {
    if (ok) return log("ok")
    log("not ok")
}
report(true)
report(false)
