const LIMIT = 50

function isPrime(n: u32): bool {
  if (n < 2) return false
  for (let d: u32 = 2; d * d <= n; d++) {
    if (n % d === 0) return false
  }
  return true
}

export function main() {
  let count = 0
  for (let n: u32 = 0; n < LIMIT; n++) {
    if (!isPrime(n)) continue
    print(n, "")
    count++
  }
  println()
  println("count:", count)
}
