const s = "  Hello, World  "
const t = s.trim()
console.log(`[${t}] [${s.trimStart()}] [${s.trimEnd()}]`)
console.log(t.indexOf("o"), t.indexOf("o", 5), t.lastIndexOf("o"), t.indexOf("xyz"), t.includes("World"))
console.log(t.startsWith("Hell"), t.endsWith("ld"), t.toUpperCase(), t.toLowerCase())
console.log("a,b,,c".split(",").length, "a,b,,c".split(",")[2] === "", "один".split("").join("|"))
console.log("x-y-z".replace("-", "+"), "x-y-z".replaceAll("-", "+"), "abc".replaceAll("", "."))
console.log("ab".repeat(3), "7".padStart(3, "0"), "7".padEnd(3), "|")
console.log("hello".substring(1, 3), "hello".substring(3, 1), "hello".substring(2), "hello".substring(-5, 2))

// Literal types have string methods too.
const mode: "fast" | "slow" = "fast"
console.log(mode.toUpperCase(), mode.length)

const csv = "name=ore;version=1"
const fields = new Map<string, string>()
for (const pair of csv.split(";")) {
  const parts = pair.split("=")
  fields.set(parts[0], parts[1])
}
console.log(fields.get("name"), fields.get("version"))
