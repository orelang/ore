// exit: 2
// stderr: panic: unexpected null
// stderr: dict-entry-missing.ore:11

// A required named entry deleted through a key known at run time only: reading it panics.
type Env = { home: string; [name: string]: string }
const env: Env = { home: "/root" }
const key: string = ["ho", "me"].join("")
console.log(env.home)
delete env[key]
console.log(env.home)
