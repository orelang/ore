// exit: 2
// stderr: panic: empty account
// stderr:   Account.withdraw at
// stderr:   Account.constructor at
// stderr:   <top level> at

class Account {
    balance: int = 0

    constructor(initial: int) {
        this.withdraw(initial)
    }

    withdraw(amount: int): void {
        if (this.balance < amount) process.panic("empty account")
        this.balance -= amount
    }
}

new Account(10)
