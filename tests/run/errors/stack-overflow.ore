// exit: 2
// stderr: panic: stack overflow
// stderr: depth at tests/run/errors/stack-overflow.ore:9 (
// stderr: <top level> at tests/run/errors/stack-overflow.ore:13
// stderr: ORE_STACK

// Recursion without end overflows the main task's stack: a panic, not a crash.
function depth(n: int): int {
    return n === 0 ? 0 : 1 + depth(n - 1)
}

console.log(depth(1000))
console.log(depth(1 << 40))
