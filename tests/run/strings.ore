function greet(name: string): string {
  return "hello, " + name + "!"
}

export function main() {
  println(greet("ore"))

  let s = "abc"
  s += "def"
  println(s, s.length, s[0], s[s.length - 1])

  const n: u8 = 200
  const ratio = 0.25
  println(`n=${n} ratio=${ratio} neg=${-5} ok=${n > 100} s=${s}`)
  println(`${1}${2}${3}`, `plain`)

  println(s.slice(1, 3), s.slice(-2), s.slice(4, 1) === "", s.slice(0, 100))

  // Length is in bytes.
  const word = "ёж"
  println(word.length, word[0], word[1])

  println("a" < "b", "ab" < "a", "abc" >= "abc", "x" === "x", "x" !== "y")
}
