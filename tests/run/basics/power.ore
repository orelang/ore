// `**`: exact on untyped constants, `pow` on floats, wrapping on integers.
console.log(2 ** 10, 2 ** -1, 2.5 ** 2, (-1) ** 100001, 10 ** 18, 0 ** 0)
let x = 3
console.log(x ** 4, x ** 0, x ** 1)
let f = 2.0
console.log(f ** 0.5, f ** -2, f ** 0)
let small: f32 = 3
console.log(small ** 2)
let b: u8 = 2
console.log(b ** 7, b ** 9)
let big: int = 3
console.log(big ** 41)
let neg = -2
console.log(neg ** 3, neg ** 4)
x **= 2
console.log(x)
const values = [2, 3]
values[1] **= 3
console.log(values[1])
