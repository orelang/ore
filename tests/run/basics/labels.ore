function findPair(target: int): int {
    let found = -1
    outer: for (let i = 0; i < 10; i++) {
        for (let j = 0; j < 10; j++) {
            if (i * j === target) {
                found = i * 10 + j
                break outer
            }
        }
    }
    return found
}

console.log(findPair(12), findPair(1000))

// continue with a label still runs the outer loop's update.
let pairs = 0
rows: for (let i = 0; i < 4; i++) {
    let j = 0
    while (true) {
        j++
        if (j > i) continue rows
        pairs++
    }
}
console.log(pairs)

let n = 0
loop: do {
    n++
    if (n < 3) continue loop
    break loop
} while (true)
console.log(n)
