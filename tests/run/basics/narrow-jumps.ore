// node: Number.parseInt gives null where JavaScript gives NaN
function parse(s: string): int | Error {
    const n = Number.parseInt(s)
    return n === null ? new Error(`bad ${s}`) : n
}

// continue and break exit the branch, so the value is narrowed after it.
let sum = 0
for (const s of ["1", "x", "2", "stop", "3"]) {
    const n = parse(s)
    if (n instanceof Error) {
        if (s === "stop") break
        continue
    }
    sum += n
}
console.log(sum)

const maybe: (string | null)[] = ["a", null, "bc"]
let length = 0
for (const m of maybe) {
    if (m === null) continue
    length += m.length
}
console.log(length)
