let i = 0
while (true) {
    i++
    if (i > 5) break
    if (i % 2 === 0) continue
    console.write(i, "")
}
console.log()

let n = 3
do {
    console.write(n, "")
    n--
} while (n > 0)
console.log()

let total = 0
for (let x = 0; x < 3; x++) {
    for (let y = 0; y < 3; y++) {
        if (y > x) break
        total += x * 10 + y
    }
}
console.log(total)
