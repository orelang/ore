function name(n: int): string {
    switch (n) {
        case 1:
            return "one"
        case 2:
        case 3:
            return "two or three"
        default:
            return "many"
    }
}

function weekday(day: string): bool {
    let result = true
    switch (day) {
        case "sat":
        case "sun":
            result = false
            break
        case "mon":
            console.write("(start) ")
    }
    return result
}

function next(): int {
    console.write("next ")
    return 2
}

console.log(name(1), name(3), name(9))
console.log(weekday("sun"), weekday("mon"), weekday("tue"))

// Fallthrough runs the following clauses until a break.
let trace = ""
switch (2) {
    case 1:
        trace += "a"
    case 2:
        trace += "b"
    case 3:
        trace += "c"
        break
    case 4:
        trace += "d"
}
console.log(trace)

// Case tests are evaluated in order and only until one matches.
switch (2) {
    case 1:
        break
    case next():
        console.log("matched")
        break
    case next():
        console.log("unreachable")
}

// break exits the switch; continue and labeled break reach the loop.
let out = ""
loop: for (let i = 0; i < 6; i++) {
    switch (i % 3) {
        case 0:
            continue
        case 1:
            out += `${i}`
            break
        default:
            if (i === 5) break loop
            out += "-"
    }
}
console.log(out)
