// Files imported as text are read when the program is compiled and embedded in it.
import greeting from "./data/greeting.txt" with { type: "text" }
import lines from "./data/lines.txt" with { type: "text" }

console.write(greeting)
console.log(greeting.length, lines.split("\n").length)
for (const line of lines.trimEnd().split("\n")) console.log(`[${line}]`)
