import { square } from "./math"

export const UNIT = 1

export type Square = { kind: "square"; side: f64 }

export class Circle {
  readonly kind = "circle"
  constructor(public r: f64) {}
}

export type Shape = Circle | Square

export function area(s: Shape): f64 {
  if (s instanceof Circle) return 3 * square(s.r)
  return square(s.side)
}
