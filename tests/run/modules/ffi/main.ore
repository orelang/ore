// Functions of the C library.
declare function strlen(s: string): u64
declare function abs(x: i32): i32
declare function atoi(s: string): i32

// Functions of native/counter.c.
declare function counter_new(): ptr
declare function counter_add(c: ptr, n: int): int
declare function counter_free(c: ptr): void
declare function greeting(name: string): string

// Functions of native/callback.c, which call back the exported functions below.
declare function sum_of_squares(n: int): int
declare function count_small(limit: i32): i32
declare function half_of(x: f64): f64
declare function negate(b: bool): bool
declare function next_byte(x: u8): u8
declare function read_counter(): i64
declare function bump_counter(): void

// A variadic C function.
declare function snprintf(buffer: ptr, size: u64, format: string, ...args: i64[]): i32

// A variable shared with C.
//ore:export ore_counter
let counter: i64

//ore:export ore_square
function square(x: int): int {
    return x * x
}

//ore:export ore_is_small
function isSmall(x: u8): bool {
    return x < 10
}

//ore:export ore_half // called from C
function half(x: f64): f64 {
    return x / 2
}

class Counter {
    private handle: ptr

    constructor() {
        this.handle = counter_new()
    }

    add(n: int): int {
        return counter_add(this.handle, n)
    }

    [Symbol.dispose](): void {
        counter_free(this.handle)
        console.log("freed")
    }
}

console.log(strlen("ore"), strlen("ёж"), abs(-5), atoi("123") + 1)
console.log(greeting("ore"))
using c = new Counter()
c.add(2)
console.log(c.add(40))
console.log(sum_of_squares(4), count_small(300), half_of(5), square(9))
console.log(negate(true), negate(false), next_byte(41), next_byte(255))
counter = 40
bump_counter()
bump_counter()
console.log(counter, read_counter())
const formatted = unsafe.allocBytes(64)
const written = snprintf(formatted, 64, "%lld|%lld|%lld", 7, -8, 9000000000)
console.log(unsafe.makeString(formatted, i64(written)))
