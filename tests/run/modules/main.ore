import { area, Circle, type Shape, UNIT } from "./geometry/shapes"
import * as text from "./text"
import { describe as label, Counter } from "./reexport"

export function main() {
  const shapes: Shape[] = [new Circle(UNIT), { kind: "square", side: 2 }]
  for (const s of shapes) console.log(text.shout(s.kind), area(s))
  const c: text.Banner = { title: "ore" }
  console.log(text.frame(c), label(shapes[0]), text.WIDTH)
  const counter = new Counter()
  counter.add(3)
  console.log(counter.total(), text.pair("a", 1).second)
}
