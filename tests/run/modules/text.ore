export const WIDTH = 10

export interface Banner {
  title: string
}

export function shout(s: string): string {
  return `${s}!`
}

export function frame(b: Banner): string {
  return `[${b.title}]`
}

export function pair<A, B>(first: A, second: B): { first: A; second: B } {
  return { first, second }
}
