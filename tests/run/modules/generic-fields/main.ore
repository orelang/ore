// The fields without annotations of an instance of a generic class, read
// in another module: their types come from the initializers, checked when
// the field is first read there.
import { Holder } from "./state"

function finish(h: Holder<string>): bool {
    h.state.done = true
    h.state.count += 2
    h.state.items.push("a")
    return h.state.done && h.state.count === 2
}

const h = new Holder<string>()
console.log(h.state.done, h.state.count)
console.log(finish(h), h.state.items)
