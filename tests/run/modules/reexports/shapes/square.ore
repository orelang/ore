import { circleArea } from "./circle"
import { square, type Shape } from "./index"
export * from "./math"
// A cycle of `export *` is harmless.
export * from "./index"

export class Square {
    readonly kind = "square"
    constructor(readonly side: f64) {}
}

export function area(s: Shape): f64 {
    if (s instanceof Square) return square(s.side)
    return circleArea(s)
}
