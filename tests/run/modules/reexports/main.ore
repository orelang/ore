// `export *`, `export * as ns`, and directory imports.
import { area, Circle, Square, type Shape, square, geometry, version } from "./shapes"
import * as shapes from "./shapes"
import { name } from "./util"
import { which } from "./both"

const all: Shape[] = [new Circle(1), new Square(2)]
for (const s of all) console.log(s.kind, area(s))
console.log(square(3), shapes.square(4), geometry.half(5))
const c: shapes.Circle = new shapes.Circle(2)
console.log(c.radius, shapes.version, version)
// "./util" is util.ore beside util/, not util/index.ore.
console.log(name)
// "./both" is the directory's index.ore.
console.log(which)
