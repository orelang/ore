// JSON files imported with `type: "json"` are parsed when the program is
// compiled and typed as the same literal written in Ore.
import config from "./data/config.json" with { type: "json" }
import list from "./data/list.json" with { type: "json" }
import again from "./data/list.json" with { type: "json" }

type Route = { path: string; methods: string[] }
type Server = { host: string; retries: int }

console.log(config.name, config.port + 1, config.ratio * 2, config.debug)
console.log(config.tags.join(","), config.tags.length)
console.log(config.limits.map((n) => n.toString()).join(" "))
const server: Server = config.server
console.log(server.host, server.retries)
const routes: Route[] = config.routes
for (const route of routes) console.log(route.path, route.methods.join("|"))
console.log(JSON.stringify(config.escaped))

// The value is one object for the program, imported twice or not.
list.sort((a, b) => a - b)
console.log(again.join(","), list.length)
