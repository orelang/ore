// Overflow wraps.
let a: i8 = 127
a++
console.log(a)
let b: u8 = 0
b -= 1
console.log(b)
let big: i64 = 9223372036854775807
console.log(big + 1)

// Division truncates toward zero; MIN / -1 wraps.
console.log(7 / 2, -7 / 2, 7 % 3, -7 % 3)
let min: i32 = -2147483648
let neg: i32 = -1
console.log(min / neg, min % neg)

// Shifts by the bit width or more.
let one: u32 = 1
console.log(one << 31, one << 32, one << 40)
let m: i16 = -16
console.log(m >> 2, m >> 100)

// Bitwise.
let x: u8 = 0b1100
console.log(x & 0b1010, x | 0b0011, x ^ 0b1111, ~x)

// Untyped constants fold with arbitrary precision.
const huge = 1 << 100
console.log(u64(huge >> 37))
let max: u64 = (1 << 64) - 1
console.log(max)
