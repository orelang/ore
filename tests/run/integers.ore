export function main() {
  // Overflow wraps.
  let a: i8 = 127
  a++
  println(a)
  let b: u8 = 0
  b -= 1
  println(b)
  let big: i64 = 9223372036854775807
  println(big + 1)

  // Division truncates toward zero; MIN / -1 wraps.
  println(7 / 2, -7 / 2, 7 % 3, -7 % 3)
  let min: i32 = -2147483648
  let neg: i32 = -1
  println(min / neg, min % neg)

  // Shifts by the bit width or more.
  let one: u32 = 1
  println(one << 31, one << 32, one << 40)
  let m: i16 = -16
  println(m >> 2, m >> 100)

  // Bitwise.
  let x: u8 = 0b1100
  println(x & 0b1010, x | 0b0011, x ^ 0b1111, ~x)

  // Untyped constants fold with arbitrary precision.
  const huge = 1 << 100
  println(u64(huge >> 37))
  let max: u64 = (1 << 64) - 1
  println(max)
}
