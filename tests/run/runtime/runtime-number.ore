// Numbers in the runtime (runtime/core/number.ore): toFixed, parseInt and parseFloat
// as JavaScript computes them, Math.round, Math.cbrt and getenv.

const zero: f64 = 0
const cases: f64[] = [
    2.5,
    1.5,
    0.125,
    1.005,
    -0.0001,
    -zero,
    0,
    123.456,
    1e21,
    1.2e21,
    -1.5,
    0.000001,
    9.995,
    1e-10,
    5e-324,
    1.7976931348623157e308,
    zero / zero,
    1 / zero,
    -1 / zero,
    255.5,
    0.5,
]
const digits = [0, 0, 2, 2, 2, 2, 0, 1, 2, 0, 0, 7, 2, 3, 2, 0, 2, 1, 0, 0, 100]
for (let i = 0; i < cases.length; i++) console.log(cases[i], digits[i], JSON.stringify(cases[i].toFixed(digits[i])))
for (const s of ["  42", "0x1F", "-0x10", "+7", "12abc", "abc", "", "  -", "9223372036854775807", "1e3"])
    console.log(JSON.stringify(s), Number.parseInt(s))
for (const s of [
    "3.5abc",
    " .5",
    "-.5e2x",
    "Infinity",
    "-Infinityx",
    "+Infinity",
    "inf",
    "nan",
    "0x10",
    "1e400",
    "",
    "  -",
    "1e-400",
])
    console.log(JSON.stringify(s), Number.parseFloat(s))
console.log(
    Math.round(2.5),
    Math.round(-2.5),
    Math.round(0.49999999999999994),
    Math.cbrt(27),
    Math.cbrt(-8),
    process.getenv("HOME") !== null,
    process.getenv("ORE_SURELY_UNSET") === null,
)
