// Formatting numbers and booleans as strings (runtime/core/format.ore).

const values: i64[] = [0, 7, -7, 10, -10, 1234567890, -9223372036854775807 - 1, 9223372036854775807]
console.log(values.map((v) => `${v}`).join(" "))
const big: u64 = 18446744073709551615
const small: u8 = 200
const tiny: i8 = -128
console.log(`${big} ${u64(0)} ${small} ${tiny} ${true} ${false} ${i32(-2147483648)}`)

// Floats: the shortest decimal that reads back, laid out as JavaScript does.
const zero: f64 = 0
const floats: f64[] = [
    0.1,
    0.1 + 0.2,
    -2.25,
    100,
    1e21,
    1e20,
    123456789012345680000,
    1e-6,
    1e-7,
    0.000001234,
    5e-324,
    1.7976931348623157e308,
    4.35,
    -zero,
    zero / zero,
    1 / zero,
    -1 / zero,
]
console.log(floats.map((x) => `${x}`).join(" "))
console.log(1e-6, 0.000001234, 123456789012345680000.0, 1e21, 2.5e-7)
console.log(`${f32(0.1)} ${f32(3.4028235e38)} ${f32(1e-45)} ${f32(16777216)}`, f32(0.1))
console.log(JSON.stringify([0.1, 1e-6, 1e21, zero / zero, 1 / zero, -0.5]))
