// Formatting numbers and booleans as strings (runtime/core/format.ore).

const values: i64[] = [0, 7, -7, 10, -10, 1234567890, -9223372036854775807 - 1, 9223372036854775807]
console.log(values.map((v) => `${v}`).join(" "))
const big: u64 = 18446744073709551615
const small: u8 = 200
const tiny: i8 = -128
console.log(`${big} ${u64(0)} ${small} ${tiny} ${true} ${false} ${i32(-2147483648)}`)
