// stderr: Warning: Label 't' already exists for console.time()
// stderr: Warning: No such label 'nope' for console.timeLog()
// stderr: Warning: No such label 'never' for console.timeEnd()
// stderr: Warning: Count for 'nope' does not exist
// console.trace writes the stack of debug frames to stderr; the timers
// write times that vary, so only their warnings are checked here.

function inner() {
    console.trace("in %s %d", "inner", 1)
}

inner()
console.time("t")
console.time("t")
console.timeLog("nope", 1)
console.timeEnd("never")
console.countReset("nope")
console.log("done")
