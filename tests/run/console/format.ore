// stderr: x to stderr 1
// stderr: warn x
// Format specifiers in a first string, as util.format reads them: the
// expected output is Node's for this program.

class P {
    x = 1
}

function f(): string {
    return "%s and %d"
}

const nested = { a: { b: 1 } }
const deep = { a: { b: { c: { d: 1 } } } }
const arrays = [[1], [2, 3]]
console.log("%s is %d years", "Bob", 42)
console.log("%s", nested, arrays)
console.log("%s", arrays)
console.log("%d %i %f", "42.5", 42.9, "3.5abc")
console.log("%d %d %d", true, false, -0.0)
console.log("%i", 1e21, "x")
console.log("%j", { a: [1, 2], s: "x" })
console.log("%O", deep)
console.log("%o", deep)
console.log("%c styled", "color: red")
console.log("100%% %s %%", "x")
console.log("%%", 1)
console.log("%%")
console.log("%s")
console.log("%s %s", "a")
console.log("%x %s", "a", "b", 3, "c")
console.log("%s", 5n, "%d", 5n)
console.log("%d", 5n, "%i", 5n)
console.log("%f", 5n)
console.log("%s", "a\nb")
console.log("%s", -0.0, 1.5)
console.log("%s %O", "s", "s")
console.log("%", 1)
console.log("a%", 1)
console.log(5, "%s", 6)
console.log("%s", null)
console.log("%d", "")
console.log("%d", " 0x10 ")
console.log("%d", "1e3", "%d", "1e")
console.log("%i", "  -12.7px")
console.log("%f", "  -1.5e3x")
console.log("%o", "str")
console.log("%s", new Map([[1, 2]]), "%s", new Set([1]))
console.log("%s", new P())
console.log("%s", [new P()])
console.log("%j", "s", "%j", 5)
console.log("%s:%s", "a", "b", { x: 1 }, "s")
console.log(f(), "x", 7, "rest", [1])
console.log(f(), "only")
const format = "no specifiers"
console.log(format, 1)
console.log("%s", true, "%d", 1.5)
console.error("%s to stderr %d", "x", 1)
console.info("info %s", "x")
console.debug("debug %i", 3.9)
console.warn("warn %s", "x")
