// console.log prints any value as Node's util.inspect does: strings at the
// top as they are and quoted inside values, arrays, objects, class
// instances, maps, sets and functions, on several lines when they are long.
// The expected output is Node's for this program.

class Point {
    x: int
    y: int
    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }
}

class Line {
    from: Point
    to: Point
    constructor(from: Point, to: Point) {
        this.from = from
        this.to = to
    }
}

class Empty {}

function twice(n: int): int {
    return n * 2
}

const empty: int[] = []
const holes: (int | null)[] = [1, null]
console.log(1, -2, 1.5, -0.0, 1e21, true, false, null, "text")
console.log([1, 2, 3], empty, ["a", "b"], holes, [true, false])
console.log({ x: 1, y: "a" }, { a: [1, 2], b: { c: true } })
console.log(new Point(1, 2), [new Point(3, 4)], new Empty())
console.log(new Line(new Point(0, 0), new Point(10, 20)))
const pair: [int, string] = [1, "one"]
console.log(pair)
const letters = new Map<string, int>()
letters.set("a", 1)
letters.set("b", 2)
const ones = new Set<int>()
ones.add(1)
console.log(letters, ones, new Map<string, int>(), new Set<string>())
const named = new Map<int, { name: string }>()
named.set(1, { name: "one" })
console.log(named)
console.log(twice, [twice])
const deepest: int[][][][] = [[[[]]]]
console.log({ a: { b: { c: { d: 1 } } }, e: [[[[1]]]], f: deepest })
console.log(["it's", 'say "hi"', "both ' \"", "tab\tnew\nline\\"])
console.log({ $y: 3, _x: 2, "a-b": 1 })
const shape: "circle" | "square" = "circle"
console.log(shape, [shape])
const maybe: int | null = null
const some: int | string = "s"
console.log(maybe, [maybe], some, [some])
console.log({
    count: 3,
    description: "and a description that goes past the width",
    name: "a fairly long name to push the line",
})
console.log(["one hundred", "two hundred", "three hundred", "four hundred", "five hundred", "six hundred"])
const numbers: int[] = []
for (let i = 0; i < 30; i++) numbers.push(i * 7)
console.log(numbers)
const words: string[] = []
for (let i = 0; i < 26; i++) words.push(String.fromCharCode(97 + i).repeat((i % 4) + 1))
console.log(words)
const many: int[] = []
for (let i = 0; i < 120; i++) many.push(i)
console.log(many)
console.log(
    [
        { a: 1, b: 2 },
        { a: 3, b: 4 },
    ],
    [[1, 2], [3]],
)
console.log({ list: [{ deep: { deeper: [1, 2] } }] })
console.log("a", 1, [2], "b")
