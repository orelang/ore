// console.log of an Error prints the first line of what Node prints, which
// has no stack trace after it: `Error: message`. An error of a class of
// its own prints as an instance of the class. console.write formats values
// the same way.

class NotFound {
    message: string
    path: string
    constructor(path: string) {
        this.message = `${path} not found`
        this.path = path
    }
}

function find(path: string): string | Error {
    if (path === "") return new Error("empty path")
    return new NotFound(path)
}

const error = new Error("failed")
console.log(error)
console.log([error], { cause: error })
console.log(new Error(""))
console.log(find(""), find("a.txt"))
const result = find("b.txt")
if (result instanceof Error) console.log(result)
console.write([1, 2], { x: 1 })
console.write("\n")
