// stderr: Assertion failed
// stderr: Assertion failed: x 5
// stderr: Assertion failed 5 y
// console's methods besides log, as Node has them: counters, groups,
// assertions, dir and table. The expected output is Node's for this program.

class Point {
    x: number
    y: number
    constructor(x: number, y: number) {
        this.x = x
        this.y = y
    }
}

class Box {
    a = 1
    b = 2
    c = 3
}

console.count()
console.count()
console.count("x")
console.countReset()
console.count()

console.group("G", 1)
console.log("a\nb")
console.log()
console.info({ a: 1, b: [1, 2] })
console.group()
console.log("deeper %d", 2)
console.groupEnd()
console.groupCollapsed("collapsed")
console.count("x")
console.groupEnd()
console.groupEnd()
console.groupEnd()
console.log("out")

console.assert(true, "no")
console.assert(1 > 2)
console.assert(false, "x %d", 5)
console.assert(false, 5, "y")

console.dir("s")
console.dir({ a: { b: { c: { d: 1 } } } })
console.dir(5)

console.table([
    { a: 1, b: "x" },
    { a: 2, b: "y" },
])
console.table([[1, 2], [3]])
console.table({ r1: { c: 1 }, r2: { c: 2 } })
console.table([1, 2])
console.table(5)
console.table("text")
console.table([{ a: 1, b: 2 }], ["b"])
console.table([new Point(1, 2), new Point(3, 4)])
console.table([{ box: new Box(), list: [1, 2, 3, 4, 5], point: new Point(1, 2) }])
console.table(
    new Map([
        ["k", { v: 1 }],
        ["l", { v: 2 }],
    ]),
)
console.table(new Set(["a", "b"]))
console.table([{ n: 1, name: "ünïcode" }])
const empty: Point[] = []
console.table(empty)
console.group("in a group")
console.table([[1]])
console.groupEnd()
