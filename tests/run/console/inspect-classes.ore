// console.log of classes, subclasses and interfaces prints the class of the
// instance; an object inside itself is `[Circular *1]`; optional properties
// that are null are left out. The expected output is Node's for this program.

interface Shape {
    area(): int
}

class Square implements Shape {
    side: int
    constructor(side: int) {
        this.side = side
    }
    area(): int {
        return this.side * this.side
    }
}

class Rect implements Shape {
    w: int
    h: int
    constructor(w: int, h: int) {
        this.w = w
        this.h = h
    }
    area(): int {
        return this.w * this.h
    }
}

class Animal {
    name: string
    constructor(name: string) {
        this.name = name
    }
}

class Dog extends Animal {
    good: bool
    constructor(name: string) {
        super(name)
        this.good = true
    }
}

class Link {
    value: int
    next: Link | null
    constructor(value: int) {
        this.value = value
        this.next = null
    }
}

type Options = { label?: string; size: int }

const shapes: Shape[] = [new Square(2), new Rect(2, 3)]
console.log(shapes)
const one: Shape = new Rect(1, 1)
console.log(one)
const pets: Animal[] = [new Animal("cat"), new Dog("rex")]
console.log(pets)
const a = new Link(1)
const b = new Link(2)
a.next = b
b.next = a
console.log(a)
console.log([a])
const solo = new Link(3)
solo.next = solo
console.log(solo)
const set: Options = { size: 1 }
const labeled: Options = { label: "big", size: 9 }
console.log(set, labeled)
function done(n: int): int {
    return n + 1
}
const callbacks = { onDone: done }
console.log(callbacks, (n: int): int => n)
function outer(): () => int {
    function inner(): int {
        return 1
    }
    return inner
}
console.log(outer())
const nested = new Map<string, int[]>()
nested.set("first", [1, 2, 3])
nested.set("second with a much longer key to break", [4, 5, 6])
console.log(nested)
console.log({ text: "line one\nline two\nline three, which makes the string longer than a line" })
console.log([[{ a: [1, 2] }]], { deep: { er: { est: 1 } } })
