// env: FORCE_COLOR=1
// stderr: Assertion failed
// With colors, as Node colors util.format's output: `%O`, `%o` and the
// values after the format are colored, `%s`, `%d` and `%j` are not. The
// expected output is Node's with FORCE_COLOR=1.

console.log("%s %d %O %o %j", { a: 1 }, 5, { n: [1], s: "x" }, "str", { j: 1 })
console.log("%s", "x", 5, "rest", { b: true })
console.error("%O", { e: null })
console.table([{ a: 1, b: "x" }])
console.table(new Map([["k", 1]]))
console.dir({ d: [1] })
console.assert(false, { a: 1 })
const f = "%s!"
console.log(f, 5, 6)
