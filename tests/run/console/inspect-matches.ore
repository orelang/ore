// A match prints as Node prints a match array: the captures (`undefined`
// for a group that took no part), then index, input, groups and, with the
// `d` flag, indices. The expected output is Node's for this program.

console.log(/(\d+)-(?<w>[a-z]+)(x)?/d.exec("x 12-ab y"))
console.log(/a/d.exec("a"))
console.log([/(a)(b)(c)(d)(e)(f)/.exec("abcdef")])
console.log({ m: { n: { o: /a/.exec("a") } } })
