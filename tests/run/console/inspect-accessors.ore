// The accessors of an object literal print as Node prints accessor
// properties: `[Getter]`, `[Setter]`, `[Getter/Setter]`. The matches of a
// regular expression print as Node prints match arrays. The expected output
// is Node's for this program.

let stored: number = 1
const o = {
    a: 1,
    get b(): number {
        return 2
    },
    get c(): number {
        return stored
    },
    set c(v: number) {
        stored = v
    },
}
console.log(o)
console.log([o])
const m = /(\d+)-(?<word>[a-z]+)/.exec("x 12-ab y")
console.log(m)
const n = "a1b2".match(/\d/g)
console.log(n)
const p = /(x)?y/.exec("y")
console.log(p)
console.log([..."a1b2".matchAll(/\d/g)])
