// The accumulator of reduce has the element's type when the initial value is
// a number that fits it, as TypeScript tries `reduce(f, initial: T)` first.
const xs: number[] = [1.5, 2, 3]
const sum = xs.reduce((a, b) => a + b, 0)
console.log(sum, xs.reduceRight((a, b) => a * b, 1))
const small: i32[] = [1, 2, 3]
const total: i32 = small.reduce((a, b) => a + b, 0)
console.log(total)
// Another type of accumulator still comes from the initial value.
const words = ["a", "bb", "ccc"]
console.log(words.reduce((n, w) => n + w.length, 0))
