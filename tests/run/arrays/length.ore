// Assigning an array's length truncates it, as in JavaScript; the
// assignment's value is the length.

const a = [1, 2, 3, 4]
a.length = 2
console.log(a, a.length)
const words = ["x", "y"]
console.log((words.length = 0), words)
a.length = 2
console.log(a)
class Stack {
    items: string[] = ["a", "b", "c"]
}
const s = new Stack()
s.items.length = 1
console.log(s.items)
