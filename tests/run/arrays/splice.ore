// shift, unshift and splice, as in JavaScript.

class Point {
    constructor(
        public x: int,
        public y: int,
    ) {}
}

const show = (a: int[]): string => `[${a.join(", ")}]`

// shift removes and returns the first element.
const q = [1, 2, 3]
console.log(q.shift(), show(q))
console.log(q.shift(), q.shift(), show(q), q.length)
q.push(4)
console.log(show(q))

// unshift inserts at the start and returns the new length.
const u: int[] = []
console.log(u.unshift(3))
console.log(u.unshift(1, 2), show(u))
console.log(u.unshift(), show(u))
const more = [-1, 0]
console.log(u.unshift(...more, 0, ...more), show(u))
console.log(u.unshift(...u), show(u))

// splice removes and returns elements, inserting the given ones in their place.
let a = [0, 1, 2, 3, 4, 5]
console.log(show(a.splice(1, 2)), show(a))
console.log(show(a.splice(1, 0, 10, 11)), show(a))
console.log(show(a.splice(-2)), show(a))
console.log(show(a.splice(-100, 1)), show(a))
console.log(show(a.splice(100, 5, 7)), show(a))
console.log(show(a.splice(1, -3, 8)), show(a))
console.log(show(a.splice(0, 100)), show(a))
a = [1, 2, 3]
console.log(show(a.splice(1, 1, ...[20, 21, 22])), show(a))
console.log(show(a.splice(1, 3, 2)), show(a))
console.log(show(a.splice(0)), show(a))

// Growing past the capacity in the middle keeps the elements after.
const big: int[] = []
for (let i = 0; i < 10; i++) big.push(i)
big.splice(5, 0, ...[100, 101, 102, 103, 104, 105, 106, 107, 108, 109])
console.log(show(big))

// Arrays share: every reference sees the change.
const alias = big
alias.splice(0, 15)
console.log(show(big), big.length)

// Objects and strings move with their references.
const points = [new Point(1, 2), new Point(3, 4)]
points.unshift(new Point(0, 0))
const out = points.splice(1, 1, new Point(5, 6), new Point(7, 8))
const first = points.shift()
console.log(first.x, out[0].x, points.map((p) => p.x + p.y).join(" "))
const words = ["b", "c"]
words.unshift("a")
console.log(words.splice(1, 1, "x", "y").join(""), words.join(""), words.shift())

// Narrow element types and a u8 start.
const bytes: u8[] = [1, 2, 3, 4]
const at: u8 = 1
console.log(bytes.splice(at, 2).join(","), bytes.join(","), bytes.shift(), bytes.length)
