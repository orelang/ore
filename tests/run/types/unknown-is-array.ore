// Array.isArray of an unknown: whether it holds an array, of any element type.

const empty: string[] = []
const values: unknown[] = [[1, 2], ["a"], empty, "text", 1, null, new Map<string, int>(), new Set<int>(), { a: 1 }]
for (const value of values) console.log(Array.isArray(value))

const list: unknown = [1.5, 2.5]
if (Array.isArray(list)) console.log((list as number[]).length)

const nested: unknown = JSON.parse<unknown>("[[1], 2]")
if (Array.isArray(nested)) {
    const items = nested as unknown[]
    console.log(items.length, Array.isArray(items[0]), Array.isArray(items[1]))
}
