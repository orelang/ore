// String literal types compare with string constants and with strings, also once narrowed to one member.
type U = "x" | "y"

function g(u: U): int {
    if (u === "x") return 1
    if (u === "y") return 2
    return 3
}

function h(u: U): int {
    if (u !== "x") {
        if ("y" === u) return 2
        return 0
    }
    return 1
}

function same(u: U, s: string): bool {
    return u === s
}

function one(u: "x", s: string): bool {
    return u === "x" && s !== u
}

console.log(g("x"), g("y"), h("x"), h("y"))
console.log(same("x", "x"), same("y", "x"), one("x", "y"), one("x", "x"))
