// Array.isArray(x) narrows a union to its arrays when true, and to its other
// members when false, as in TypeScript.
function describe(x: string | int[] | { [key: string]: int } | null): string {
    if (x === null) return "null"
    if (Array.isArray(x)) return `array of ${x.length}: ${x.join(",")}`
    if (typeof x === "string") return `string ${x}`
    return `record of ${Object.keys(x).join(",")}`
}
console.log(describe([1, 2, 3]))
console.log(describe("hi"))
console.log(describe({ a: 1, b: 2 }))
console.log(describe(null))

function first(x: string[] | string): string {
    if (!Array.isArray(x)) return x
    return x[0]
}
console.log(first(["a", "b"]), first("c"))

const both: int[] | string[] | bigint = [4, 5]
console.log(Array.isArray(both) ? both.length : 0, Array.isArray(both) && both.length > 1)
