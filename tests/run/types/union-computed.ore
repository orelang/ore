// Indexed access and Omit on a union of object types, as in TypeScript:
// `U["x"]` is the union of the members' field types, and `Omit<U, K>` is
// not distributive: one object type of the keys common to every member.
type A = { kind: "a"; x: f64; z: string; a: bool }
type B = { kind: "b"; x: string; z: f64; b: f64 }
type U = A | B

type X = U["x"]
type K = U["kind"]
type O = Omit<U, "z">

const xs: X[] = [1.5, "two"]
const ks: K[] = ["a", "b"]
const o: O = { kind: "a", x: 1 }
const o2: O = { kind: "b", x: 1 }
const o3: O = { kind: "a", x: "s" }
console.log(xs, ks)
console.log(o.kind, o.x, o2.kind, o2.x, o3.x)
