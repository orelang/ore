// An optional member `x?: T` of an interface is `T | null`; a class may lack it,
// and then it reads as null.
interface Labeled {
    readonly id: int
    label?: string
}
class A {
    constructor(readonly id: int) {}
}
class B {
    label?: string = "b"
    constructor(readonly id: int) {}
}
function show(l: Labeled): string {
    return `${l.id}:${l.label ?? "none"}`
}
console.log(show(new A(1)), show(new B(2)))
const lit: Labeled = { id: 3 }
console.log(show(lit), show({ id: 4, label: "four" }))
const b: Labeled = new B(5)
b.label = "changed"
console.log(show(b))
