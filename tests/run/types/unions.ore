type Circle = { kind: "circle"; r: f64 }
type Square = { kind: "square"; side: f64 }
type Rect = { kind: "rect"; w: f64; h: f64 }
type Shape = Circle | Square | Rect

function area(s: Shape): f64 {
    switch (s.kind) {
        case "circle":
            return 3 * s.r * s.r
        case "square":
            return s.side * s.side
        case "rect":
            return s.w * s.h
    }
}

function isRound(s: Shape): bool {
    if (s.kind === "circle") return s.r > 0
    return false
}

function perimeter(s: Shape): f64 {
    if (s.kind !== "rect") {
        if (s.kind === "square") return 4 * s.side
        return 6 * s.r
    }
    return 2 * (s.w + s.h)
}

type Mode = "fast" | "slow" | "off"

function speed(m: Mode): int {
    switch (m) {
        case "fast":
            return 10
        case "slow":
            return 1
        case "off":
            return 0
    }
}

function label(v: string | int | bool): string {
    if (typeof v === "string") return `text ${v} (${v.length})`
    if (typeof v === "number") return `number ${v + 1}`
    return `flag ${v}`
}

class Cat {
    constructor(public name: string) {}
    meow(): string {
        return `${this.name} meows`
    }
}

class Dog {
    constructor(public name: string) {}
    bark(): string {
        return `${this.name} barks`
    }
}

function speak(pet: Cat | Dog): string {
    if (pet instanceof Cat) return pet.meow()
    return pet.bark()
}

const shapes: Shape[] = [
    { kind: "circle", r: 1 },
    { kind: "square", side: 2 },
    { kind: "rect", w: 2, h: 3 },
]
for (const s of shapes) console.log(s.kind, area(s), perimeter(s), isRound(s))

const m: Mode = "slow"
console.log(speed(m), speed("fast"), m === "slow", m)

console.log(label("ore"), label(41), label(true))
console.log(speak(new Cat("Tom")), speak(new Dog("Rex")))

// Unions print and compare by value.
const values: (string | int | null)[] = ["a", 1, null]
for (const v of values) console.write(v, typeof v, "")
console.log()
const x: string | int = 5
console.log(x === 5, values[1] === "1", values[0] === "a")

// A field common to every member of a union, with the same type, can be assigned.
class Assign {
    readonly k: "assign" = "assign"
    line: int | null = null
    count = 0
}
class Jump {
    readonly k: "jump" = "jump"
    line: int | null = null
    count = 0
}
interface Counted {
    count: int
}
class Counter {
    count = 10
}
function counted(): Counted {
    return new Counter()
}
const statements: (Assign | Jump)[] = [new Assign(), new Jump()]
for (const stmt of statements) {
    stmt.line = 3
    stmt.count += 2
    stmt.count++
}
console.log(statements[0].line ?? -1, statements[1].count, statements[1].k)
const tally = new Assign()
tally.count = 3
const mixed: (Assign | Counted)[] = [tally, counted()]
for (const m of mixed) m.count *= 3
console.log(mixed[0].count, mixed[1].count)
