// Optional properties `x?: T` of object types are `T | null`, null when left out
// of a literal, and left out of JSON when null.
type Opts = { name?: string; size?: int; tag: string }
const a: Opts = { tag: "t" }
const b: Opts = { name: "n", tag: "u", size: 3 }
console.log(JSON.stringify(a), JSON.stringify(b))
console.log(JSON.stringify(a, 2))
const p = JSON.parse<Opts>('{"tag":"x"}')
if (!(p instanceof Error)) console.log(p.name ?? "none", p.tag)
let t: Opts = a
t.size = 5
console.log(t.size)
function show(o: Opts): string {
    return `${o.name ?? "-"}`
}
console.log(show({ tag: "z" }))
const e: { only?: int } = {}
console.log(JSON.stringify(e))
