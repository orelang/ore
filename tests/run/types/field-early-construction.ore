// node: a module variable read before its declaration runs is zero, where JavaScript throws a ReferenceError
// An instance constructed before the module variables its field initializers use are initialized reads their zero values, as functions do.

class Early {
    start: number = base + 1
    title: string = name
    count = base * 2
}

const early = new Early()
console.log(early.start)
let base: number = 10
let name = ["t", "itle"].join("")
const later = new Early()
console.log(later.start, later.title, later.count)
