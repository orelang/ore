// node: an Error interface value formats as 'Error: message'
// A template calls the toString() method of an object, as JavaScript does.
class Point {
    constructor(
        readonly x: int,
        readonly y: int,
    ) {}
    toString(): string {
        return `(${this.x}, ${this.y})`
    }
}
class Point3 extends Point {
    override toString(): string {
        return `3d ${super.toString()}`
    }
}
interface Shown {
    toString(): string
}

const p = new Point(1, 2)
const base: Point = new Point3(3, 4)
const shown: Shown = p
console.log(`p = ${p}, base = ${base}, shown = ${shown}`)

// Errors give "Name: message", also behind the Error interface.
class Timeout extends Error {
    constructor(ms: int) {
        super(`after ${ms} ms`)
        this.name = "Timeout"
    }
}
class Custom {
    message = "custom"
}
const errors: Error[] = [new Error("boom"), new Timeout(50), new Error(), new Custom()]
for (const e of errors) console.log(`${e}`)
console.log(`${new Timeout(10)}`)
