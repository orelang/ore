// `typeof` of a top-level constant without a type annotation, in type aliases resolved before it is checked.
const obj = { a: 1, b: "s", c: [1.5, -2], d: { e: true } }
const sizes = [1, 2, 3]

type K = keyof typeof obj
type O = typeof obj
type B = typeof obj.b
type Sizes = typeof sizes

function keys(): K[] {
    return ["a", "b", "c", "d"]
}

const copy: O = obj
const b: B = obj.b
const more: Sizes = [...sizes, 4]
console.log(keys().join(","), copy.a, b, copy.c[1], copy.d.e, more.length)

// In annotations, after the constant and before it: literals, template literals,
// `new` of a class that is not generic, and names of other such constants.
function greet(who: typeof title, times: typeof count): typeof label {
    return `${who} x${times}`
}
function origin(): typeof start {
    return new Point(0, 0)
}
function same(v: typeof alias): typeof alias {
    return v
}
class Point {
    constructor(
        public x: int,
        public y: int,
    ) {}
}
const title = "ore"
const count = 3
const ratio = 0.5
const label = `${title}!`
const start = new Point(1, 2)
const alias = title
let t: typeof title = "t"
let n: typeof count = 7
let r: typeof ratio = 1.5
let p: typeof start = origin()
console.log(t, n, r, p.x, start.y, greet(title, count), label, same("s"))
