// Boolean literal types: `true` and `false` as types, held as booleans.
// A discriminated union with a boolean discriminant, as an iterator result.
type R<T, TR> = { done: false; value: T } | { done: true; value: TR }

function f(i: int): R<int, string> {
    if (i < 3) return { done: false, value: i }
    return { done: true, value: "end" }
}

let r = f(1)
if (!r.done) console.log(r.value + 1)
else console.log(r.value.length)
if (r.done === false) console.log("=== false", r.value + 1)
if (r.done !== true) console.log("!== true", r.value * 2)
if (false === r.done) console.log("false ===", r.value)
if (r.done) console.log(r.value.length)
else console.log("not done", r.value)
console.log(r)

// A loop left through its condition ends with the condition false.
let i = 0
while (!r.done) {
    console.log("loop", r.value + 0)
    i++
    r = f(i)
}
console.log(r.value.toUpperCase(), r)

const s = f(5)
console.log(s.done ? s.value.length : s.value + 1)
console.log(!s.done ? s.value + 1 : s.value.length)
console.log(s.done && s.value.length === 3, !s.done || s.value === "end")

function g(x: R<int, string>): int {
    if (x.done) return x.value.length
    return x.value * 10
}
console.log(g(f(1)), g(f(9)))

// The literal types themselves; `true | false` is `bool`.
const t: true = true
const u: false | string = false
const b: bool = t
type Both = true | false
const v: Both = b
console.log(t, u, b, v, t === true, t !== v, typeof t)
let e: true | null = true
console.log(e, `${e}`)
const w: bool | null = e
e = null
console.log(e, w)

// A generic interface whose method returns the union, implemented by a class.
interface It<T> {
    next(): R<T, null>
}
class Counter implements It<int> {
    n = 0
    next(): R<int, null> {
        this.n++
        if (this.n > 2) return { done: true, value: null }
        return { done: false, value: this.n }
    }
}
const it: It<int> = new Counter()
let x = it.next()
while (!x.done) {
    console.log(x.value + 100)
    x = it.next()
}
console.log(x)

type Parsed = { ok: true; value: int } | { ok: false; reason: string }
function parse(text: string): Parsed {
    if (text === "") return { ok: false, reason: "empty" }
    return { ok: true, value: text.length }
}
for (const text of ["", "abc"]) {
    const p = parse(text)
    if (p.ok !== false) console.log("ok", p)
    else console.log("bad", p)
    if (!p.ok) continue
    console.log("after continue", p.value)
}
function size(p: Parsed): int {
    if (!p.ok) return -1
    return p.value
}
console.log(size(parse("")), size(parse("hello")), [parse(""), parse("ab")])
