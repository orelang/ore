// Accessor signatures in interfaces and object types: `get x(): T` alone is
// a read-only field, with `set x(value: T)` a writable one.
interface Shape {
    get area(): f64
    get name(): string
    set name(value: string)
}
class Square implements Shape {
    name = "square"
    constructor(readonly side: f64) {}
    get area(): f64 {
        return this.side * this.side
    }
}
const s: Shape = new Square(2)
console.log(s.area, s.name)
s.name = "renamed"
console.log(s.name)

type Sized = { get size(): int }
const box: Sized = { size: 3 }
console.log(box.size)
