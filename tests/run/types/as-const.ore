// `as const`: literal types, read-only tuples and read-only fields, as an
// enum replacement.
const Dirs = ["n", "s", "e", "w"] as const
type Dir = (typeof Dirs)[number]
function turn(d: Dir): Dir {
    return d === "n" ? "e" : d === "e" ? "s" : d === "s" ? "w" : "n"
}
console.log(Dirs.length, Dirs[0], turn("n"), turn(Dirs[3]))

const pair = [1, "a"] as const
const first: 1 = pair[0]
const second: "a" = pair[1]
console.log(first, second)

const config = { name: "ore", level: 2, tags: ["x", "y"] } as const
const level: 2 = config.level
console.log(config.name, level, config.tags[1])
