// The zero value of a string is "": a module variable read before its
// declaration runs, a field before it is set, an element of new Array(n).
// That of a union with null is null.

function early(): void {
    console.log(name === "", "" === name, name !== "", name.length, `[${name}]`, "a" + name + "b")
    console.log(JSON.stringify(name), JSON.stringify({ name }), name < "a", name.localeCompare(""))
    console.log(name, [name], { name })
    console.log(name.split(","), name.toUpperCase(), name.includes(""), name.startsWith(""))
    nullable(name)
    const m = new Map<string, int>()
    m.set(name, 1)
    console.log(m.get(""), m.has(name), new Set<string>(["", name]).size)
    console.log(tagged === null, tagged)
    switch (name) {
        case "":
            console.log("empty")
            break
        default:
            console.log("other")
    }
}

function nullable(s: string | null): void {
    console.log(s === null, s === "", s ?? "null")
}

class Box {
    label: string
    constructor() {
        this.label = name
    }
}

early()
const box = new Box()
console.log(box.label === "", box.label.length, box)
const parts = new Array<string>(2)
console.log(parts, parts[0] === "", parts.join("-"), parts.includes(""), parts.indexOf(""))

const name: string = ["s", "e", "t"].join("")
const tagged: int | string | null = name.length > 1 ? name : null
console.log(name, tagged)
