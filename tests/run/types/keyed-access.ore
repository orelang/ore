// Objects and class instances indexed by the names of their members:
// `p["x"]` is `p.x`, and `p[k]` with `k: keyof P` reads the field `k` names,
// of type `P[K]`. The output is node's for the same program.

type Point = { x: int; y: int; label: string }
const p: Point = { x: 1, y: 2, label: "p" }
console.log(p["x"], p["label"])
p["y"] = 5
console.log(p)

function get(o: Point, k: keyof Point): Point[keyof Point] {
    return o[k]
}
console.log(get(p, "x"), get(p, "y"), get(p, "label"))

const keys: (keyof Point)[] = ["label", "x"]
for (const k of keys) console.log(k, p[k])

function coordinate(o: Point, k: "x" | "y"): int {
    return o[k]
}
console.log(coordinate(p, "x") + coordinate(p, "y"))

class Counter {
    count = 3
    private secret = 1
    get double(): int {
        return this.count * 2
    }
    peek(): int {
        return this.secret
    }
}
const c = new Counter()
console.log(c["count"], c["double"], c.peek())
c["count"] = 10
console.log(c["double"])
