// `a ?? b` is `NonNullable<A> | B`, as in TypeScript: a fallback of another
// type, or one that may be null, widens the result.
function find(xs: string[], k: string): string | null {
    return xs.find((x) => x === k) ?? null
}
const a: string | null = null
const b: string | null = "b"
const c = a ?? b
console.log(c, find(["x"], "y"), find(["x"], "x"), a ?? b ?? "z")
const n: int | null = null
const m: int | null = null
console.log(n ?? m, n ?? 3)
const label: string | int = n ?? "none"
console.log(label)
let calls = 0
const once = (): string | null => {
    calls++
    return "once"
}
console.log(once() ?? 1, calls)
