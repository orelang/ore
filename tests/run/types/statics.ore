// Static members: fields are globals initialized where the class is declared,
// methods are functions; subclasses inherit them.
class Counter {
    static count = 0
    static readonly label: string = "counter"
    private static secret = 42
    readonly id: int
    constructor() {
        Counter.count++
        this.id = Counter.count
    }
    static make(): Counter {
        return new Counter()
    }
    static reveal(): int {
        return Counter.secret
    }
}
console.log(Counter.count, Counter.label)
const a = Counter.make()
const b = new Counter()
console.log(a.id, b.id, Counter.count, Counter.reveal())
Counter.count = 10
console.log(Counter.make().id)
class Sub extends Counter {
    static extra = Counter.count * 2
}
console.log(Sub.count, Sub.extra, Sub.make().id)
const f = Counter.make
console.log(f().id)
