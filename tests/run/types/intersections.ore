// Intersections: object types merge their fields; with an interface, the members of all.
type A = { a: int }
type B = { b: string }
type C = A & B & { c: bool }
const x: C = { a: 1, b: "s", c: true }
console.log(x.a, x.b, x.c)
interface Named {
    readonly name: string
    greet(): string
}
type Person = Named & { age: int }
class P {
    constructor(
        readonly name: string,
        public age: int,
    ) {}
    greet(): string {
        return `hi ${this.name}`
    }
}
const who: Person = new P("ann", 30)
console.log(who.greet(), who.age)
function both(v: A & B): string {
    return `${v.a}${v.b}`
}
console.log(both({ a: 7, b: "z" }))
