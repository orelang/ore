// The zero value of an array, a Map and a Set is an empty one: a module
// variable read before its declaration runs, by a function called earlier,
// holds one, which the function may change before the declaration replaces it.

function early(): void {
    console.log(items.length, items, keyed.size, keyed, seen.size, seen, grid)
    console.log(items.includes(1), keyed.get("a") ?? "none", seen.has(2), JSON.stringify(items))
    items.push(7)
    keyed.set("a", 1)
    seen.add(2)
    grid.push([1])
    console.log(items, keyed.get("a"), seen.has(2), grid)
    for (const x of items) console.log("item", x)
}

early()

const items: int[] = [1, 2, 3]
const keyed = new Map<string, int>([["b", 2]])
const seen = new Set<int>([5])
let grid: int[][] = []
console.log(items, keyed, seen, grid)
