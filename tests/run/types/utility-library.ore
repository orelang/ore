type User = { id: number; name: string; email?: string; age: number }
type Plain = { id: number; name: string; age: number }
const a: PartialExcept<User, "id"> = { id: 1 }
const b: PartialOmit<User, "email"> = { name: "n" }
const c: KeysOfType<Plain, number> = "age"
const d: PickByValueType<Plain, string> = { name: "x" }
type Config = { server: { port: number; host: string }; tags: string[] }
const e: DeepPartial<Config> = { server: { port: 80 } }
const f: Paths<Config> = "server.port"
const g: PathValue<Config, "server.host"> = "h"
const h: RequiredKeys<User> = "name"
const i: OptionalKeys<User> = "email"
const j: Assign<{ x: number; y: string }, { y: bool }> = { x: 1, y: true }
const k: Merge<{ x: number }, { z: string }> = { x: 1, z: "z" }
const l: NullableByKeys<User, "name"> = { id: 1, name: null, age: 3 }
const m: DeepReadonly<Config> = { server: { port: 1, host: "" }, tags: [] }
console.log(a.id, b.name, c, d.name, e.server!.port, f, g, h, i, j.y, k.z, l.name, m.server.port)
type Steps = [never, 0, 1, 2, 3]
type P2 = Steps[3]
type IsTwo<T> = T extends 2 ? "two" : "other"
const na: IsTwo<P2> = "two"
type Num<D extends number = 3> = `n${D}`
const nb: Num = "n3"
type Never<D> = [D] extends [never] ? "none" : "some"
const nc: Never<Steps[0]> = "none"
const nd: Never<1> = "some"
console.log(na, nb, nc, nd)
