// Default type arguments: used when left out, or when the arguments of a call
// do not bind the parameter; they can use the parameters before them.
class Box<T = int> {
    constructor(readonly value: T) {}
}
const a: Box = new Box(1)
const b = new Box<string>("s")
console.log(a.value, b.value)
function make<T, C = T[]>(x: T, wrap: (x: T) => C): C {
    return wrap(x)
}
console.log(make(1, (x) => [x, x]).length)
type Pair<A, B = A> = { a: A; b: B }
const p: Pair<int> = { a: 1, b: 2 }
console.log(p.b)
function empty<T = string>(): T[] {
    return []
}
const e = empty()
e.push("x")
console.log(e.length)
