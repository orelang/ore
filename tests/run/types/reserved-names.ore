// Property names may be any word, reserved or not, as in TypeScript: fields,
// methods, accessors, object literal keys, and parameter properties named
// with contextual keywords such as `readonly` and `type`.

class Field {
    constructor(
        readonly name: string,
        readonly readonly: bool,
        readonly type: string,
        public of: int,
    ) {}
}

class Branch {
    else: string | null = null
    private = false
    static = 1
    new = "new"
    readonly if: string

    constructor(condition: string) {
        this.if = condition
    }

    get delete(): int {
        return this.static + 1
    }

    for(n: int): int {
        return n * 2
    }
}

const field = new Field("x", true, "int", 3)
console.log(field.name, field.readonly, field.type, field.of)

const branch = new Branch("cond")
branch.else = "otherwise"
branch.private = true
console.log(branch.if, branch.else, branch.private, branch.static, branch.new, branch.delete, branch.for(21))

const keywords = { if: 1, while: "loop", return: true }
console.log(keywords.if, keywords.while, keywords.return)
