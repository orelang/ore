// Type arguments that the arguments do not bind come from the expected type of the result.
function empty<T>(): T[] {
    return []
}
const xs: string[] = empty()
xs.push("a")
function pair<A, B>(a: A): Map<A, B> {
    return new Map<A, B>()
}
const m: Map<int, string> = pair(1)
console.log(xs.length, m.size)
