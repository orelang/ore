// `x satisfies T` checks that x fits T, with T as its context, and keeps x's own type.
type Config = { name: string; port: int }
const cfg = { name: "srv", port: 80 } satisfies Config
console.log(cfg.name, cfg.port)
const n = 5 satisfies int
const m: u8 = n
console.log(m)
interface Named {
    readonly name: string
}
class U {
    constructor(readonly name: string) {}
    extra(): int {
        return 1
    }
}
const u = new U("a") satisfies Named
console.log(u.extra())
