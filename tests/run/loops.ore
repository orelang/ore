export function main() {
  let i = 0
  while (true) {
    i++
    if (i > 5) break
    if (i % 2 === 0) continue
    print(i, "")
  }
  println()

  let n = 3
  do {
    print(n, "")
    n--
  } while (n > 0)
  println()

  let total = 0
  for (let x = 0; x < 3; x++) {
    for (let y = 0; y < 3; y++) {
      if (y > x) break
      total += x * 10 + y
    }
  }
  println(total)
}
