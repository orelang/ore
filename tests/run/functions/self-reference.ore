// A variable whose value has functions that use it: declared before its value.

let left = 3
const countdown = () => {
    console.log("left", left)
    left--
    if (left > 0) countdown()
}
countdown()

// The type comes from the value, here a call that takes a callback using it.
class Ticker {
    stopped = false
    constructor(readonly tick: () => void) {}
    stop() {
        this.stopped = true
    }
}
let ticks = 0
const ticker = new Ticker(() => {
    ticks++
    if (ticks === 2) ticker.stop()
})
while (!ticker.stopped) ticker.tick()
console.log("ticks", ticks)

// With an annotation, the annotation is the type.
const fib: (n: int) => int = (n) => (n < 2 ? n : fib(n - 1) + fib(n - 2))
console.log(fib(10))
