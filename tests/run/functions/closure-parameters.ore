// Closures with optional, default and rest parameters, also through function types.
const greet = (name: string, greeting = "hi", punct?: string): string => `${greeting} ${name}${punct ?? ""}`
console.log(greet("a"), greet("b", "yo"), greet("c", "hey", "!"))
const sum = (...xs: int[]): int => {
    let t = 0
    for (const x of xs) t += x
    return t
}
console.log(sum(), sum(1, 2, 3))
let f: (a: int, b?: int) => int = (a, b) => a + (b ?? 10)
console.log(f(1), f(1, 2))
type Log = (msg: string, ...parts: string[]) => string
const log: Log = (msg, ...parts) => `${msg}:${parts.join(",")}`
console.log(log("m"), log("m", "x", "y"))
console.log(typeof f)
function apply(g: (x: int, y?: int) => int): int {
    return g(5)
}
console.log(apply((x, y = 3) => x * y))
