// `...rest` in an object pattern is a new object of the other public fields.
type Point = { x: int; y: int; z: int }
const p: Point = { x: 1, y: 2, z: 3 }
const { x, ...rest } = p
console.log(x, rest.y, rest.z, JSON.stringify(rest))
class User {
    constructor(
        readonly name: string,
        private secret: string,
        public age: int,
    ) {}
}
const { name, ...others } = new User("a", "s", 3)
console.log(name, JSON.stringify(others))
let left = 0
let remaining = { y: 0, z: 0 }
;({ x: left, ...remaining } = p)
console.log(left, remaining.y)
