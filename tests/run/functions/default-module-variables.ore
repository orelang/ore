// The default value of a parameter without an annotation may use module
// variables and constants declared further down, as in TypeScript: the
// parameter has the type of the value, computed at each call.

function twice(n: int): int {
    return n * 2
}
function greet(name = greeting): string {
    return `${name}!`
}
function scale(x: f64, by = factor * 2): f64 {
    return x * by
}
function tags(list = defaults): string {
    return list.join(",")
}
function limit(n = limits.max + extra): int {
    return n
}
function late(x = computed, label = `${prefix}-${computed}`): string {
    return `${x} ${label}`
}
class Shape {
    constructor(readonly side = factor) {}
    area(unit = units[0]): string {
        return unit
    }
}

const factor = 1.5
let greeting = "hello"
const defaults: string[] = ["a", "b"]
const limits = { max: 3 }
const extra = limits.max * 2
const units = ["cm", "m"]
const computed = twice(4)
const prefix = units[1].toUpperCase()

console.log(greet(), greet("hi"), scale(2), scale(2, 1), tags(), tags(["x"]))
console.log(limit(), limit(1), late(), late(1), new Shape().area(), new Shape().area("km"), new Shape().side)
greeting = "bye"
console.log(greet())
