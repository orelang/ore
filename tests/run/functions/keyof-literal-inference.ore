// A string constant for a parameter whose type is constrained to string literal types has the literal type.
function key<T, K extends keyof T>(o: T, k: K): K {
    return k
}

function named<T, K extends keyof T>(o: T, k: K, fallback: T[K]): T[K] {
    return fallback
}

function pick<K extends "x" | "y">(k: K, n: int): string {
    return `${k}${n}`
}

const obj = { a: 1, b: "x" }
const k: "b" = key(obj, "b")
const a: "a" = key({ a: 1, b: "x" }, "a")
const s: string = named(obj, "b", "y")
const n: int = named(obj, "a", 2)
console.log(k, a, s, n, pick("y", 2))
