// `...array` among the arguments of a rest parameter: the elements join the
// other arguments, in order.
function sum(label: string, ...xs: int[]): string {
    let total = 0
    for (const x of xs) total += x
    return `${label}: ${xs.length} = ${total}`
}
const a = [1, 2, 3]
const b = [10, 20]
console.log(sum("none"))
console.log(sum("one", ...a))
console.log(sum("mixed", 0, ...a, 4, ...b, 5))
console.log(sum("twice", ...a, ...a))

// Spread arguments are evaluated once, in order.
let calls = 0
function next(): int[] {
    calls++
    return [calls]
}
console.log(sum("calls", ...next(), 100, ...next()), calls)

// `push` appends every element of a spread array, even of itself.
const xs: int[] = [1]
xs.push(...a)
console.log(xs.join(","))
xs.push(0, ...b, 9)
console.log(xs.join(","))
xs.push(...xs)
console.log(xs.length, xs.join(","))
const words: string[] = []
words.push(...["a", "b"], "c")
console.log(words.join(""))

// A tuple spreads into any parameters: of functions, function values,
// constructors, generic functions and methods, and interface methods.
function point(x: int, y: int, label = "p"): string {
    return `${label}(${x}, ${y})`
}
const xy: [int, int] = [1, 2]
const yl: [int, string] = [5, "r"]
console.log(point(...xy), point(...xy, "q"), point(0, ...yl))
const named: [string, int] = ["s", 1]
console.log(sum(...named, 2, ...a))
const add = (p: int, q: int): int => p + q
console.log(add(...xy))
class Pair<T> {
    constructor(
        readonly first: T,
        readonly second: T,
    ) {}
    with<U>(x: U, y: U): [U, T] {
        return [y, this.first]
    }
}
const pair = new Pair(...xy)
const kl: [string, string] = ["k", "l"]
const w = pair.with(...kl)
console.log(pair.second, w[0], w[1])
interface Adder {
    add(p: int, q: int): int
}
class Times {
    add(p: int, q: int): int {
        return p * q
    }
}
const adder: Adder = new Times()
console.log(adder.add(...xy))

// Arguments are evaluated once, in order, around a spread tuple.
let order = ""
function mark(s: string): string {
    order += s
    return s
}
function letters(): [string, string] {
    order += "t"
    return ["b", "c"]
}
function three(p: string, q: string, r: string): string {
    return p + q + r
}
console.log(three(mark("a"), ...letters()), order)

// Tuples and arrays spread into array literals, `console.log`, `Math.min` and `Math.max`.
console.log([0, ...xy, 3].join(","))
const none: int[] = []
console.log(...words)
console.log("x", ...none, "y")
console.log(...xy, ...[2.5])
console.log(Math.max(...xy), Math.min(4, ...a, 9), Math.max(1, 5, 3))
const floats: f64[] = []
console.log(Math.max(...floats), Math.min(...floats), Math.max(...none))

// A tuple spreads into built-in functions and methods, and conversions;
// `push` takes tuples and arrays.
const kv: [string, i32] = ["a", 1]
const m = new Map<string, i32>()
m.set(...kv)
const two: [i32] = [2]
m.set("b", ...two)
const key: [string] = ["a"]
console.log(m.get("a"), m.get("b"), m.has(...key))
const range: [int, int] = [1, 3]
console.log("hello".slice(...range), [10, 20, 30, 40].slice(...range).join(","))
const dash: [string, string] = ["-", "+"]
console.log("a-b-c".replaceAll(...dash))
const pw: [f64, f64] = [2.0, 10.0]
const one: [f64] = [2.7]
console.log(Math.pow(...pw), i32(...one))
const small: i32[] = [1]
const t: [i32, i32] = [2, 3]
const more: i32[] = [4]
small.push(...t, 9, ...more)
small.push(...[])
console.log(small.join(","))

// The receiver and the arguments are evaluated once, in order.
order = ""
const pairs = new Map<string, string>()
function pairOf(): [string, string] {
    order += "p"
    return ["k", "v"]
}
pairs.set(...pairOf())
const out: string[] = []
function target(): string[] {
    order += "t"
    return out
}
target().push(mark("a"), ...pairOf(), mark("b"))
console.log(order, out.join(""), pairs.get("k"))
