// Variables declared without a value, assigned before they are read.

class Box {
    constructor(readonly v: int) {}
}

function pick(flag: bool): Box {
    let b: Box
    if (flag) b = new Box(1)
    else b = new Box(2)
    return b
}

function find(items: int[], wanted: int): Box {
    let found: Box
    for (;;) {
        for (const n of items) {
            if (n === wanted) {
                found = new Box(n)
                return found
            }
        }
        found = new Box(-1)
        break
    }
    return found
}

function classify(n: int): string {
    let label
    switch (n) {
        case 0:
            label = "zero"
            break
        case 1:
            label = "one"
            break
        default:
            label = "many"
    }
    return label
}

function late(): int {
    let b: Box
    do {
        b = new Box(7)
    } while (b.v < 0)
    const read = () => b.v
    return read()
}

let total
total = 0
for (let i = 0; i < 4; i++) total += i
let pair: Box
;[pair] = [new Box(5)]

console.log(pick(true).v, pick(false).v, find([3, 4], 4).v, find([3], 9).v)
console.log(classify(0), classify(1), classify(5), late(), total, pair.v)
