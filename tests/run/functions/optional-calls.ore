// Optional calls of function values, also of fields that may be null.
class P {
    start?: () => void
    done: (() => int) | null = null
}
const p = new P()
p.start?.()
p.start = () => console.log("started")
p.start?.()
console.log(p.done?.() ?? -1)
const f: ((x: int) => int) | null = (x) => x * 2
console.log(f?.(4))
