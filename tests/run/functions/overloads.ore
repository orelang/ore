// Overload signatures: a call takes the first whose parameters fit, and has its
// result type; the implementation that follows takes every signature.
function parse(s: string): int
function parse(s: string, radix: int): int
function parse(s: string[]): int[]
function parse(s: string | string[], radix = 10): int | int[] {
    if (typeof s === "string") return Number.parseInt(s, radix) ?? 0
    const out: int[] = []
    for (const x of s) out.push(Number.parseInt(x, radix) ?? 0)
    return out
}
const one: int = parse("42")
const hex: int = parse("ff", 16)
const many: int[] = parse(["1", "2"])
console.log(one + 1, hex, many.length, many[1])
export function show(x: int): string
export function show(x: bool): string
export function show(x: int | bool): string {
    return `${x}`
}
console.log(show(1), show(true))
