type Point = { x: f64; y: f64 }

function length2(p: Point): f64 {
  return p.x * p.x + p.y * p.y
}

function move(p: Point, dx: f64): void {
  p.x += dx
}

function origin(): { x: f64; y: f64 } {
  return { x: 0, y: 0 }
}

export function main() {
  const p: Point = { x: 3, y: 4 }
  println(p.x, p.y, length2(p))

  // Objects are references.
  move(p, 1)
  const q = p
  q.y = 10
  println(p.x, p.y, p === q)

  // Structurally identical object types are the same type.
  const o = origin()
  const r: Point = o
  println(length2(r), r === o)

  // Literal types are inferred; shorthand properties.
  const name = "ore"
  const age = 1
  const info = { name, age, tags: ["a", "b"] }
  info.age++
  info.tags.push("c")
  println(info.name, info.age, info.tags.length)

  // Nested objects and arrays of objects.
  const line = { from: { x: 1, y: 2 }, to: p }
  line.from.x *= 10
  const points: Point[] = [{ x: 1, y: 1 }, p]
  points[0].y -= 5
  println(line.from.x, line.to.y, points[0].y, points[1] === p)

  // Readonly fields.
  const frozen: { readonly id: int } = { id: 7 }
  println(frozen.id)
}
