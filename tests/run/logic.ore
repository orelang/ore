function loud(label: string, value: bool): bool {
  console.write(label, "")
  return value
}

console.log(loud("a", false) && loud("b", true))
console.log(loud("c", true) || loud("d", true))
let x = 5
console.log(x > 3 ? "big" : "small", !(x === 5), "s" === "s", "a" !== "b")
let flag: boolean = x >= 5
console.log(flag)
