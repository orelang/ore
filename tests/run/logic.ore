function loud(label: string, value: bool): bool {
  print(label, "")
  return value
}

export function main() {
  println(loud("a", false) && loud("b", true))
  println(loud("c", true) || loud("d", true))
  let x = 5
  println(x > 3 ? "big" : "small", !(x === 5), "s" === "s", "a" !== "b")
  let flag: boolean = x >= 5
  println(flag)
}
