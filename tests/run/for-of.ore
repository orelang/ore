export function main() {
  let total = 0
  for (const x of [1, 2, 3]) total += x
  println(total)

  // The length is re-read: elements pushed during iteration are visited.
  const queue = [1]
  for (const n of queue) {
    if (n < 4) queue.push(n + 1)
  }
  println(queue.length)

  for (const r of "aж😀") print(r, "")
  println()

  outer: for (const row of [[1, 2], [3, 4], [5, 6]]) {
    for (let v of row) {
      v *= 10
      if (v === 40) continue outer
      if (v === 50) break outer
      print(v, "")
    }
  }
  println()

  const words: string[] = []
  for (const w of ["a", "b"]) words.push(`<${w}>`)
  println(words[0], words[1])
}
