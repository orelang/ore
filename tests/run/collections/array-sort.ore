// Array.prototype.sort: stable, in place, with a comparator or in the
// default order of strings, on arrays of many lengths and element sizes.
// The expected output is Node's, with `number` for the integer types.

let seed = 12345
/** A pseudo-random integer in [0, n). */
function random(n: int): int {
    seed = (seed * 48271) % 2147483647
    return seed % n
}

class Item {
    key: int
    id: int
    constructor(key: int, id: int) {
        this.key = key
        this.id = id
    }
}

// Stability: equal keys keep their order, across the insertion runs and the merges.
for (const n of [0, 1, 2, 15, 16, 17, 31, 33, 100, 1000, 5000]) {
    const items: Item[] = []
    for (let i = 0; i < n; i++) items.push(new Item(random(7), i))
    const sorted = items.sort((a, b) => a.key - b.key)
    let ok = sorted === items
    for (let i = 1; i < n; i++) {
        const a = items[i - 1]
        const b = items[i]
        if (a.key > b.key || (a.key === b.key && a.id > b.id)) ok = false
    }
    console.log(n, ok)
}

// Integers: ascending, descending, already in order, reversed, all equal.
const numbers: int[] = []
for (let i = 0; i < 3000; i++) numbers.push(random(1000000) - 500000)
let total = 0
for (const x of numbers) total += x
numbers.sort((a, b) => a - b)
let ordered = true
let after = 0
for (let i = 0; i < numbers.length; i++) {
    after += numbers[i]
    if (i > 0 && numbers[i - 1] > numbers[i]) ordered = false
}
console.log(ordered, total === after, numbers[0], numbers[numbers.length - 1])
numbers.sort((a, b) => b - a)
console.log(numbers[0], numbers[1], numbers[numbers.length - 1])
numbers.sort((a, b) => b - a)
console.log(numbers[0], numbers[numbers.length - 1])
numbers.sort((a, b) => a - b)
console.log(numbers[0], numbers[numbers.length - 1])
const same: int[] = []
for (let i = 0; i < 100; i++) same.push(7)
console.log(same.sort((a, b) => a - b).length, same[0], same[99])

// Comparators that return fractions, and NaN, which counts as 0: equal elements stay in order.
const fractions = [0.3, 0.1, 0.2, 0.15, 0.05, 0.25]
console.log(fractions.sort((a, b) => (a - b) / 1000).join(" "))
const keyed: Item[] = []
for (let i = 0; i < 40; i++) keyed.push(new Item(random(5), i))
keyed.sort((a, b) => (a.key === b.key ? Number.NaN : f64(a.key - b.key)))
console.log(keyed.map((x) => `${x.key}:${x.id}`).join(" "))
const untouched = [5, 3, 9, 1, 7]
untouched.sort((a, b) => Number.NaN)
console.log(untouched.join(" "))

// Strings in the default order, of mixed lengths and shared prefixes.
const words: string[] = ["b", "a", "ab", "", "abc", "aa", "B", "é", "z", "ba", "a", "Z"]
for (let i = 0; i < 300; i++) {
    let w = ""
    const length = 1 + random(12)
    for (let k = 0; k < length; k++) w += random(3) === 0 ? "b" : "a"
    words.push(w)
}
const mixed = words.slice()
words.sort()
let inOrder = true
for (let i = 1; i < words.length; i++) if (words[i - 1] > words[i]) inOrder = false
console.log(inOrder, words.length, words.slice(0, 6).join("|"), words.slice(words.length - 4).join("|"))

// Strings by length: the default order of each length stays.
const byLength = mixed.slice(12, 52).sort((a, b) => a.length - b.length)
console.log(byLength.join(","))

// Elements of other sizes: one byte, four bytes.
const bytes: u8[] = []
for (let i = 0; i < 200; i++) bytes.push(u8(random(256)))
bytes.sort((a, b) => int(a) - int(b))
console.log(bytes.slice(0, 8).join(" "), bytes.slice(192).join(" "))
const ints: i32[] = []
for (let i = 0; i < 300; i++) ints.push(i32(random(100000) - 50000))
ints.sort((a, b) => b - a)
console.log(ints.slice(0, 5).join(" "), ints.slice(295).join(" "))
