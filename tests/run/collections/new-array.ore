// new Array: a length gives zero values; other arguments are the elements.
class Box {
    constructor(readonly n: int) {}
}

console.log(new Array<int>(3), new Array<int>(), new Array<int>(1, 2), new Array<f64>(2))
console.log(JSON.stringify(new Array<string>(2)), new Array<string>("a"), new Array<string | null>(2))
console.log(new Array<bool>(2), new Array<Box | null>(1), new Array<u8>(0))

// Each element has its own zero value: arrays, maps and sets are new.
const grid: int[][] = new Array(2)
grid[0].push(1)
console.log(grid)

// One integer argument is a length, another value an element.
const n: u8 = 2
console.log(new Array<string>(n), new Array<f64>(2.5), new Array<int>(-0))

const xs = [1, 2, 3]
console.log(Array.from({ length: 3 }, (_, i) => new Box(i)).map((b) => b.n))
console.log(xs.with(-3, 0))

// Unions are tested at run time.
const values: (int[] | string)[] = ["a", [1]]
console.log(values.map((v) => Array.isArray(v)))
