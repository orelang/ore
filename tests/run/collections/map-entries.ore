// `new Map(entries)` from an array literal of [key, value] pairs, set in
// order: a later pair with the same key replaces the value, keeping its place.

const precedence = new Map([
    ["||", 1],
    ["&&", 2],
    ["+", 3],
    ["||", 0],
])
console.log(precedence.size, precedence.get("||"), precedence.get("+"), Array.from(precedence.keys()).join(" "))

type Kind = "keyword" | "operator"
const kinds = new Map<string, Kind>([
    ["if", "keyword"],
    ["+", "operator"],
])
for (const [text, kind] of kinds) console.log(text, kind)

// The types may come from the context, and the pairs may use any expressions.
const base = 10
const squares: Map<int, int> = new Map([
    [1, 1],
    [base, base * base],
])
console.log(squares.get(10), squares.has(2))

const empty: Map<string, f64> = new Map([])
console.log(empty.size)

// Pairs are evaluated left to right.
let calls = ""
function note(s: string): string {
    calls += s
    return s
}
const ordered = new Map([
    [note("a"), note("1")],
    [note("b"), note("2")],
])
console.log(calls, ordered.get("b"))
