// node: s[i] is a byte, not a one-character string
function greet(name: string): string {
    return "hello, " + name + "!"
}

console.log(greet("ore"))

let s = "abc"
s += "def"
console.log(s, s.length, s[0], s[s.length - 1])

const n: u8 = 200
const ratio = 0.25
console.log(`n=${n} ratio=${ratio} neg=${-5} ok=${n > 100} s=${s}`)
console.log(`${1}${2}${3}`, `plain`)

console.log(s.slice(1, 3), s.slice(-2), s.slice(4, 1) === "", s.slice(0, 100))

// Length is in bytes.
const word = "ёж"
console.log(word.length, word[0], word[1])

console.log("a" < "b", "ab" < "a", "abc" >= "abc", "x" === "x", "x" !== "y")
