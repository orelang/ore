function sum(xs: int[]): int {
    let total = 0
    for (let i = 0; i < xs.length; i++) total += xs[i]
    return total
}

function squares(n: int): int[] {
    const out: int[] = []
    for (let i = 0; i < n; i++) out.push(i * i)
    return out
}

function grow(xs: int[]): int {
    xs.push(100)
    return 7
}

const xs = [3, 1, 4, 1, 5]
console.log(xs.length, xs[0], xs[4], sum(xs))

// Arrays are references, like in TypeScript.
const alias = xs
alias[0] = 9
alias.push(2)
console.log(xs[0], xs.length, alias === xs, xs.slice() === xs)

const sq = squares(6)
console.log(sq.length, sq[5], sum(sq))

// Element compound assignment and increments evaluate the target once.
const counts: u8[] = [250, 0]
counts[0] += 10
counts[1]++
++counts[1]
console.log(counts[0], counts[1])

// The value is evaluated before the element is written, even if it grows the array.
const ys = [0]
ys[0] = grow(ys)
console.log(ys[0], ys[1], ys.length)

// push returns the new length; pop returns the removed element.
const stack: string[] = []
console.log(stack.push("a", "b", "c"), stack.pop(), stack.length)

const words = ["x", "y"]
words[1] += "z"
console.log(words[0], words[1])

// Nested arrays and slices.
const grid: f64[][] = [[1, 2], [3.5]]
grid[1].push(4)
console.log(grid.length, grid[1].length, grid[1][1], grid[0][1])
const part = sq.slice(1, -2)
console.log(part.length, part[0], part[2])

let empty: bool[]
console.log(empty.length)

// An array literal where a union with one array type is expected takes that type.
class Shape {
    constructor(readonly name: string) {}
}
class Square {
    constructor(readonly side: int) {}
}
function count(items: (Shape | Square)[] | null): int {
    return items === null ? -1 : items.length
}
let floats: f64[] | null = [1, 2]
console.log(count([new Square(2), new Shape("dot")]), count([]), count(null), floats === null ? 0 : floats[1] / 4)
