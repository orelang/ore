// String.fromCharCode, String.fromCodePoint and codePointAt, as in
// JavaScript, with UTF-8 strings: surrogate pairs combine into one character,
// and a lone surrogate, which UTF-8 cannot encode, becomes U+FFFD.

console.log(String.fromCharCode(72, 105, 0x20ac))
console.log(String.fromCharCode(0xd83d, 0xde00), String.fromCharCode(0xd83d, 0xde00).length)
console.log(String.fromCharCode(0x10041), String.fromCharCode(-1).length)
console.log(String.fromCharCode(0xd800) === "�", String.fromCharCode(0xde00, 0x41) === "�A")
console.log(String.fromCharCode() === "", String.fromCodePoint() === "")

console.log(String.fromCodePoint(0x1f600, 0x41, 0xe9), String.fromCodePoint(0xd83d, 0xde00) === "😀")
const units = [0x4f, 0x72, 0x65]
console.log(String.fromCharCode(...units), String.fromCodePoint(...units))

const s = "aé😀"
for (let i = 0; i <= s.length; i++) console.log(i, s.codePointAt(i) ?? -1)

let points = ""
for (const c of "héllo") points += String.fromCodePoint(i64(c))
console.log(points)
