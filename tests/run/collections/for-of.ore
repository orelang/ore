let total = 0
for (const x of [1, 2, 3]) total += x
console.log(total)

// The length is re-read: elements pushed during iteration are visited.
const queue = [1]
for (const n of queue) {
    if (n < 4) queue.push(n + 1)
}
console.log(queue.length)

for (const r of "aж😀") console.write(r, "")
console.log()

outer: for (const row of [
    [1, 2],
    [3, 4],
    [5, 6],
]) {
    for (let v of row) {
        v *= 10
        if (v === 40) continue outer
        if (v === 50) break outer
        console.write(v, "")
    }
}
console.log()

const words: string[] = []
for (const w of ["a", "b"]) words.push(`<${w}>`)
console.log(words[0], words[1])
