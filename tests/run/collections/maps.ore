function wordCounts(text: string[]): Map<string, int> {
    const counts = new Map<string, int>()
    for (const w of text) counts.set(w, (counts.get(w) ?? 0) + 1)
    return counts
}

class Point {
    constructor(
        public x: int,
        public y: int,
    ) {}
}

const counts = wordCounts(["a", "b", "a", "c", "b", "a"])
console.log(counts.size, counts.get("a"), counts.get("z"), counts.has("c"))
for (const [word, n] of counts) console.write(`${word}=${n} `)
console.log()

// Insertion order survives updates and deletions.
counts.set("b", 10)
counts.delete("a")
counts.set("a", 1)
console.log(
    Array.from(counts.keys()).length,
    Array.from(counts.keys())[0],
    Array.from(counts.keys())[2],
    Array.from(counts.values())[0],
)

// Keys of other types: numbers by value, objects by identity.
const squares: Map<int, int> = new Map()
for (let i = 0; i < 1000; i++) squares.set(i, i * i)
for (let i = 0; i < 1000; i += 3) squares.delete(i)
console.log(squares.size, squares.get(999), squares.get(3), squares.get(998))

const p = new Point(1, 2)
const names = new Map<Point, string>()
names.set(p, "first").set(new Point(1, 2), "other")
console.log(names.size, names.get(p), names.has(new Point(1, 2)))

const zero: f64 = 0
const nan: Map<f64, string> = new Map()
nan.set(zero / zero, "nan").set(-0.0, "zero")
console.log(nan.get(zero / zero), nan.get(0.0), nan.size)

const nested = new Map<string, int[]>()
nested.set("xs", [1, 2])
const xs = nested.get("xs")
if (xs !== null) xs.push(3)
console.log(nested.get("xs")?.length)

counts.clear()
console.log(counts.size, counts.get("a"))

// Union keys: objects by identity, numbers and strings by value, each as its
// own member: 1 as i32 and 1 as i64 are different keys.
class Var {
    constructor(readonly name: string) {}
}
class Call {
    constructor(readonly callee: string) {}
}
const v = new Var("x")
const c = new Call("f")
const slots = new Map<Var | Call, string>()
slots.set(v, "%v").set(c, "%c").set(new Var("x"), "%other")
console.log(slots.get(v), slots.get(c), slots.get(new Var("x")), slots.size)

const mixed = new Map<i32 | i64 | f64 | string | null, int>()
const one: i32 = 1
mixed
    .set(one, 1)
    .set(1, 2)
    .set("1", 3)
    .set(null, 4)
    .set(zero / zero, 5)
mixed.set(1, 20)
console.log(
    mixed.get(one),
    mixed.get(1),
    mixed.get("1"),
    mixed.get(null),
    mixed.get(zero / zero),
    mixed.get(2.5),
    mixed.size,
)
for (const [k, n] of mixed) console.write(k, n, "")
console.log()

type Mode = "fast" | "slow"
const modes = new Map<Mode | null, int>()
modes.set("fast", 1).set(null, 0)
const optional = new Map<Var | null, int>()
optional.set(null, 7).set(v, 8)
console.log(
    modes.get("fast"),
    modes.get("slow"),
    modes.get(null),
    optional.get(null),
    optional.get(v),
    optional.has(new Var("x")),
)
