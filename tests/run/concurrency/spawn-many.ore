// threads: 4

// Many children at once, each run from its own task: their pipes and exits
// are awaited on the poller, so the tasks share four threads.

const count = 64
const results = new Chan<string>(count)
for (let i = 0; i < count; i++) {
    task.spawn(() => {
        const out = process.command.output(
            "sh",
            ["-c", "echo $N; head -c 200000 /dev/zero >&2; sleep 0.1; exit $(($N % 7))"],
            { env: new Map([["N", `${i}`]]) },
        )
        if (out instanceof Error) {
            results.send(out.message)
            return
        }
        const ok = out.stdout === `${i}\n` && out.stderr.length === 200000 && out.code === i % 7
        results.send(ok ? "ok" : `child ${i}: ${JSON.stringify(out.stdout)} ${out.stderr.length} ${out.code}`)
    })
}
let ok = 0
for (let i = 0; i < count; i++) {
    const r = results.receive()
    if (r === "ok") ok++
    else console.log(r)
}
console.log(ok, "children ok")

// Children with inherited output, waited for at once.
const codes = new Chan<int>(8)
for (let i = 0; i < 8; i++) {
    task.spawn(() => {
        const code = process.run("sh", ["-c", `sleep 0.1; exit ${i}`])
        codes.send(code instanceof Error ? -1 : code)
    })
}
let sum = 0
for (let i = 0; i < 8; i++) sum += codes.receive() ?? -100
console.log("sum of exit codes", sum)
