// exit: 2
// stderr: panic: integer divide by zero
// stderr:   div at
// stderr: divide-by-zero.ore:9
// stderr:   main at
// stderr: divide-by-zero.ore:14

function div(a: i32, b: i32): i32 {
  return a / b
}

export function main() {
  console.log("before")
  console.log(div(1, 0))
  console.log("unreachable")
}
