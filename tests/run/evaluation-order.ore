function say(label: string, value: int): int {
  print(label, "")
  return value
}

function pair(a: int, b: int): int {
  return a * 10 + b
}

class Box {
  constructor(public value: int) {}

  plus(n: int): int {
    return this.value + n
  }
}

function box(label: string): Box {
  print(label, "")
  return new Box(1)
}

export function main() {
  // Operands and arguments are evaluated left to right.
  println(say("a", 1) + say("b", 2))
  println(say("c", 3) < say("d", 4))
  println(pair(say("e", 5), say("f", 6)))
  println(box("g").plus(say("h", 7)))
  println(`${say("i", 8)}-${say("j", 9)}`)

  // A variable read before an increment sees the old value.
  let x = 1
  println(pair(x, x++), x)
  let y = 1
  println(y + ++y)

  const xs = [10, 20]
  let i = 0
  println(xs[i++] + xs[i++], i)
}
