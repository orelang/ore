function say(label: string, value: int): int {
  console.write(label, "")
  return value
}

function pair(a: int, b: int): int {
  return a * 10 + b
}

class Box {
  constructor(public value: int) {}

  plus(n: int): int {
    return this.value + n
  }
}

function box(label: string): Box {
  console.write(label, "")
  return new Box(1)
}

// Operands and arguments are evaluated left to right.
console.log(say("a", 1) + say("b", 2))
console.log(say("c", 3) < say("d", 4))
console.log(pair(say("e", 5), say("f", 6)))
console.log(box("g").plus(say("h", 7)))
console.log(`${say("i", 8)}-${say("j", 9)}`)

// A variable read before an increment sees the old value.
let x = 1
console.log(pair(x, x++), x)
let y = 1
console.log(y + ++y)

const xs = [10, 20]
let i = 0
console.log(xs[i++] + xs[i++], i)
