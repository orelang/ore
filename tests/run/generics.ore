function identity<T>(x: T): T {
    return x
}

function first<T>(xs: T[]): T | null {
    return xs.length > 0 ? xs[0] : null
}

function map<A, B>(xs: A[], f: Mapper<A, B>): B[] {
    const out: B[] = []
    for (const x of xs) out.push(f.apply(x))
    return out
}

interface Mapper<A, B> {
    apply(a: A): B
}

class Doubler {
    apply(n: int): int {
        return n * 2
    }
}

class Shout {
    apply(s: string): string {
        return `${s}!`
    }
}

class Stack<T> {
    private items: T[] = []

    push(item: T): void {
        this.items.push(item)
    }

    pop(): T | null {
        return this.items.length > 0 ? this.items.pop() : null
    }

    size(): int {
        return this.items.length
    }
}

class Node<T> {
    next: Node<T> | null = null
    constructor(public value: T) {}
}

function listLength<T>(head: Node<T> | null): int {
    let n = 0
    let cur = head
    while (cur !== null) {
        n++
        cur = cur.next
    }
    return n
}

type Pair<A, B> = { first: A; second: B }

function swap<A, B>(p: Pair<A, B>): Pair<B, A> {
    return { first: p.second, second: p.first }
}

interface Named {
    readonly name: string
}

function longest<T extends Named>(items: T[]): T {
    let best = items[0]
    for (const item of items) if (item.name.length > best.name.length) best = item
    return best
}

class City {
    constructor(
        readonly name: string,
        readonly population: int,
    ) {}
}

type Result<T> = T | Error

function safeDiv(a: int, b: int): Result<int> {
    if (b === 0) return new Error("division by zero")
    return a / b
}

console.log(identity(5), identity("ore"), identity<f64>(1))
console.log(first([3, 4]), first<string>([]))
console.log(map([1, 2, 3], new Doubler()).length, map(["a", "b"], new Shout())[1])

const s = new Stack<string>()
s.push("a")
s.push("b")
console.log(s.size(), s.pop(), s.pop(), s.pop())
const numbers = new Stack<int>()
numbers.push(7)
console.log(numbers.pop())

const head = new Node(1)
head.next = new Node(2)
console.log(listLength(head), listLength<int>(null), head.value)

const p: Pair<int, string> = { first: 1, second: "one" }
const q = swap(p)
console.log(q.first, q.second)

const cities = [new City("Rome", 3), new City("Amsterdam", 1)]
const big = longest(cities)
console.log(big.name, big.population)

const r = safeDiv(7, 2)
const e = safeDiv(1, 0)
if (!(r instanceof Error) && e instanceof Error) console.log(r, e.message)
