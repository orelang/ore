type Person = { name: string; age: int }

function double(x: int): int {
  return x * 2
}

const xs = [5, 3, 8, 1, 4]
console.log(xs.map((x) => x * 10).join(" "), xs.map(double).join("-"), xs.map((x, i) => `${i}:${x}`).join())
console.log(xs.filter((x) => x > 3).join(","), xs.reduce((sum, x) => sum + x, 0), xs.reduce((acc, x) => `${acc}${x}`, ">"))
console.log(xs.find((x) => x > 4), xs.find((x) => x > 100), xs.findIndex((x) => x === 8), xs.findIndex((x) => x === 9))
console.log(xs.some((x) => x > 7), xs.every((x) => x > 0), xs.includes(3), xs.indexOf(4), xs.indexOf(42))

let total = 0
xs.forEach((x) => {
  total += x
})
console.log(total)

// sort and reverse work in place and return the array.
const sorted = xs.slice().sort()
console.log(sorted.join(), xs.join(), xs.sort((a, b) => b - a) === xs, xs.join())
console.log(["pear", "apple", "fig"].sort().join(), [1, 2, 3].reverse().join())

// Stable sort of objects by a key.
const people: Person[] = [{ name: "Ann", age: 30 }, { name: "Bob", age: 25 }, { name: "Cid", age: 30 }, { name: "Dee", age: 25 }]
console.log(people.sort((a, b) => a.age - b.age).map((p) => p.name).join(" "))

// Floats: includes finds NaN, indexOf does not.
const zero: f64 = 0
const fs = [1.5, zero / zero]
console.log(fs.includes(zero / zero), fs.indexOf(zero / zero), [0.5, 2.25].sort((a, b) => b - a).join(";"))

// Chains.
const words = ["one", "two", "three", "four"]
console.log(words.filter((w) => w.length > 3).map((w) => w.length).reduce((a, b) => a + b, 0))
