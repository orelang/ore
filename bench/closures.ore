// Callbacks that capture and assign locals, passed straight to array methods.

const values: int[] = []
for (let i = 0; i < 100; i++) values.push(i)
let total = 0
for (let round = 0; round < 1_000_000; round++) {
    let sum = 0
    values.forEach((v) => {
        sum += v * round
    })
    const big = values.filter((v) => v > round % 100).length
    total += sum + big
}
console.log(total)
