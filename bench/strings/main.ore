// Strings: builds a long string by concatenation and by joining parts, then
// splits, scans and searches it.

const n = process.args.length > 0 ? (Number.parseInt(process.args[0]) ?? 2000000) : 2000000

// Concatenation, one small piece at a time.
let text = ""
for (let i = 0; i < n; i++) text += `${i % 1000},`

// Joining parts made by templates and methods.
const parts: string[] = []
for (let i = 0; i < n; i++) parts.push(`item-${i}`.toUpperCase())
const joined = parts.join(";")

// Counting: separators by splitting, a byte by scanning, a word by searching.
const fields = text.split(",").length
let sevens = 0
for (let i = 0; i < joined.length; i++) if ((joined.codePointAt(i) ?? 0) === 55) sevens++
let items = 0
let at = joined.indexOf("ITEM-9")
while (at >= 0) {
    items++
    at = joined.indexOf("ITEM-9", at + 1)
}
console.log(text.length, joined.length, fields, sevens, items)
