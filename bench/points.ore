// Short-lived objects that never leave the loop body.

class Vec {
    constructor(
        readonly x: f64,
        readonly y: f64,
    ) {}

    dot(other: Vec): f64 {
        return this.x * other.x + this.y * other.y
    }
}

type Box = { min: Vec; max: Vec }

function area(box: Box): f64 {
    return (box.max.x - box.min.x) * (box.max.y - box.min.y)
}

export function main() {
    let sum = 0.0
    for (let i = 0; i < 20_000_000; i++) {
        const a = new Vec(f64(i), 1)
        const b = new Vec(2, f64(i % 7))
        sum += a.dot(b)
        const box = { min: a, max: b }
        sum += area(box)
    }
    console.log(sum)
}
