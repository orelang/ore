// SHA-256: hashes a 1 MB buffer n times with a hand-written SHA-256, on 32-bit
// integer operations. Each round writes the previous digest into the start of
// the buffer, so every round hashes different data.

const k: u32[] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98,
    0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8,
    0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819,
    0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
    0xc67178f2,
]

function rotr(x: u32, n: int): u32 {
    return (x >> n) | (x << (32 - n))
}

/** Compresses the 64-byte block of `data` at `offset` into the state `h`. */
function block(h: u32[], w: u32[], data: u8[], offset: int) {
    for (let i = 0; i < 16; i++) {
        const j = offset + i * 4
        w[i] = (u32(data[j]) << 24) | (u32(data[j + 1]) << 16) | (u32(data[j + 2]) << 8) | u32(data[j + 3])
    }
    for (let i = 16; i < 64; i++) {
        const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)
        const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
    }
    let a = h[0]
    let b = h[1]
    let c = h[2]
    let d = h[3]
    let e = h[4]
    let f = h[5]
    let g = h[6]
    let hh = h[7]
    for (let i = 0; i < 64; i++) {
        const s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        const ch = (e & f) ^ (~e & g)
        const t1 = hh + s1 + ch + k[i] + w[i]
        const s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        const maj = (a & b) ^ (a & c) ^ (b & c)
        const t2 = s0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
    h[4] += e
    h[5] += f
    h[6] += g
    h[7] += hh
}

/** The SHA-256 digest of `data`, as eight words. */
function sha256(data: u8[], w: u32[]): u32[] {
    const h: u32[] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    const full = data.length - (data.length % 64)
    for (let offset = 0; offset < full; offset += 64) block(h, w, data, offset)
    // The last bytes, the 0x80 marker, zeros and the length in bits.
    const tail: u8[] = []
    for (let i = full; i < data.length; i++) tail.push(data[i])
    tail.push(0x80)
    while (tail.length % 64 !== 56) tail.push(0)
    const bits = data.length * 8
    for (let i = 7; i >= 0; i--) tail.push(u8(bits >> (i * 8)))
    for (let offset = 0; offset < tail.length; offset += 64) block(h, w, tail, offset)
    return h
}

const n = (process.args.length > 0 ? Number.parseInt(process.args[0]) : null) ?? 200
const data: u8[] = []
for (let i = 0; i < 1000000; i++) data.push(u8((i * 31 + (i >> 8)) & 255))
const w: u32[] = []
for (let i = 0; i < 64; i++) w.push(0)

let digest: u32[] = []
for (let round = 0; round < n; round++) {
    digest = sha256(data, w)
    for (let i = 0; i < 32; i++) data[i] = u8(digest[i >> 2] >> (24 - (i & 3) * 8))
}
// Numbers have no `toString(radix)` yet, so a bigint writes the hex digits.
let hex = ""
for (const word of digest) hex += BigInt(word).toString(16).padStart(8, "0")
console.log(hex)
