// A sample module for `ore doc`: an export of each kind, with JSDoc tags.
//
//   import { Shape } from "./sample"

export { area as surface, Unit } from "./part"

/** How many sides a square has. */
export const sides = 4

/** The name of the sample, and its version. */
export let name = "sample",
    version: int = 2

const hidden = 1

/**
 * Repeats a text.
 *
 * @param text - What to repeat.
 * @param times How many times; may be zero.
 * @returns The text, `times` times.
 * @example
 *   repeat("ab", 3) // "ababab"
 */
export function repeat(text: string, times: int): string {
    let out = ""
    for (let i = 0; i < times; i++) out += text
    return out
}

/** The larger of two numbers. */
export function larger(a: int, b: int): int
export function larger(a: f64, b: f64): f64
export function larger(a: int | f64, b: int | f64): int | f64 {
    return a
}

/** A shape with a name. */
export interface Shape {
    /** Its name. */
    readonly name: string
    /** Its area, in square units. */
    area(): f64
}

/**
 * A square.
 *
 * @deprecated Use a rectangle.
 */
export class Square implements Shape {
    /** The name of every square. */
    readonly name = "square"
    private secret = 0

    /** A square of a side. */
    constructor(public side: f64) {}

    /** The side times the side. */
    area(): f64 {
        return this.side * this.side
    }

    /** The length around it. */
    get perimeter(): f64 {
        return 4 * this.side
    }

    private grow() {
        this.secret++
    }
}

/** A point on the plane. */
export type Point = { x: f64; y: f64 }

function local(): int {
    return hidden
}

export { local as helper }
