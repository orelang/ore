// Import resolution (project/resolve.ore) and the loading of a program's
// modules (project/load.ore).

import { test, expect, fail } from "ore:test"
import { basename, dirname, join } from "ore:path"
import { check } from "../src/checker/checker"
import { type Diagnostic } from "../src/syntax/diagnostic"
import { checkJson } from "../src/project/json"
import { LoadOptions, loadProgram } from "../src/project/load"
import { resolveImport, runtimeModules } from "../src/project/resolve"

/** A temporary directory with these files, by path relative to it. */
function project(files: Map<string, string>): string {
    const root = fs.mkdtemp("ore-project-")
    if (root instanceof Error) fail(root.message)
    for (const [path, text] of files) {
        const made = fs.mkdir(dirname(join(root, path)), true)
        if (made instanceof Error) fail(made.message)
        const written = fs.writeFile(join(root, path), text)
        if (written instanceof Error) fail(written.message)
    }
    return root
}

/** What an import resolves to, as text: the path, "<none>" or the error. */
function resolved(specifier: string, from: string): string {
    const path = resolveImport(specifier, from)
    if (path === null) return "<none>"
    if (path instanceof Error) return `error: ${path.message}`
    return path
}

function same(got: string, want: string) {
    if (got !== want) fail(`expected:\n${want}\ngot:\n${got}`)
}

test("resolves relative paths, index files and packages", () => {
    const files = new Map<string, string>()
    files.set("src/main.ore", "")
    files.set("src/util.ore", "")
    files.set("src/lib/index.ore", "")
    files.set("node_modules/geo/package.json", '{"name":"geo","main":"src/geo.ore"}')
    files.set("node_modules/geo/src/geo.ore", "")
    files.set("node_modules/geo/src/extra.ore", "")
    files.set("node_modules/@acme/tools/index.ore", "")
    const root = project(files)
    const from = join(root, "src/main.ore")
    same(resolved("./util", from), join(root, "src/util.ore"))
    same(resolved("./util.ore", from), join(root, "src/util.ore"))
    same(resolved("./lib", from), join(root, "src/lib/index.ore"))
    same(resolved("geo", from), join(root, "node_modules/geo/src/geo.ore"))
    same(resolved("geo/src/extra", from), join(root, "node_modules/geo/src/extra.ore"))
    same(resolved("@acme/tools", from), join(root, "node_modules/@acme/tools/index.ore"))
    same(resolved("./missing", from), "<none>")
})

test("loads modules dependencies first and reports missing modules", () => {
    const files = new Map<string, string>()
    files.set("main.ore", 'import { a } from "./a"\nimport { b } from "./b"\nimport { c } from "./nope"\n')
    files.set("a.ore", 'import { b } from "./b"\n')
    files.set("b.ore", 'import { a } from "./a"\n')
    const root = project(files)
    const program = loadProgram(join(root, "main.ore"))
    if (program instanceof Error) fail(program.message)
    // The runtime comes first, each runtime module after those it imports, then the program's modules.
    const runtime = program.modules.length - 3
    expect(runtime).toBe(runtimeModules.length)
    for (let i = 0; i < program.modules.length; i++) {
        const path = program.modules[i].path
        if (i < runtime && !runtimeModules.includes(path)) fail(`module ${i} is ${path}, not a runtime module`)
    }
    const names: string[] = []
    for (const m of program.modules.slice(runtime)) names.push(basename(m.path))
    same(names.join(" "), "b.ore a.ore main.ore")
    const messages: string[] = []
    for (const d of program.diagnostics) messages.push(d.message)
    same(messages.join("\n"), "Cannot find module './nope'.")
})

test("uses overridden texts", () => {
    const files = new Map<string, string>()
    files.set("main.ore", "")
    const root = project(files)
    const options = new LoadOptions()
    options.overrides.set(join(root, "main.ore"), "export function main() {}")
    const program = loadProgram(join(root, "main.ore"), options)
    if (program instanceof Error) fail(program.message)
    expect(program.entry.ast.list("statements").length).toBe(1)
})

/** Diagnostics as `file:line:column: message`, with one-based lines and columns. */
function located(diagnostics: Diagnostic[]): string {
    const lines: string[] = []
    for (const d of diagnostics) {
        const { line, column } = d.source.position(d.start)
        lines.push(`${basename(d.source.path)}:${line + 1}:${column + 1}: ${d.message}`)
    }
    return lines.join("\n")
}

/** The syntax error of a JSON text as `offset: message`, or "valid". */
function jsonError(text: string): string {
    const error = checkJson(text)
    return error === null ? "valid" : `${error.offset}: ${error.message}`
}

test("checks the syntax of JSON", () => {
    same(jsonError(' {"a": [1, -2.5e+3, true, false, null, "\\u00e9\\n"], "b": {}} '), "valid")
    same(jsonError("[]"), "valid")
    same(jsonError(""), "0: unexpected end of the file")
    same(jsonError("{'a': 1}"), "1: expected a property name in double quotes")
    same(jsonError('{"a" 1}'), "5: expected ':'")
    same(jsonError('{"a": 1,}'), "8: expected a property name in double quotes")
    same(jsonError("[1, 2"), "5: expected ',' or ']'")
    same(jsonError("[01]"), "2: expected ',' or ']'")
    same(jsonError("[1.]"), "1: invalid number")
    same(jsonError('"a\\x"'), "2: invalid escape in a string")
    same(jsonError('"abc'), "0: unterminated string")
    same(jsonError("nul"), "0: unexpected character 'n'")
    same(jsonError("1 2"), "2: unexpected text after the value")
})

test("reports JSON syntax errors at their line and column in the file", () => {
    const files = new Map<string, string>()
    files.set("main.ore", 'import config from "./config.json" with { type: "json" }\nconsole.log(config.name)\n')
    files.set("config.json", '{\n  "name": "x",\n  "port": 80,\n}\n')
    const root = project(files)
    const program = loadProgram(join(root, "main.ore"))
    if (program instanceof Error) fail(program.message)
    expect(program.syntaxErrors).toBe(true)
    same(located(program.diagnostics), "config.json:4:1: Invalid JSON: expected a property name in double quotes.")
})

test("reports type errors of a JSON file in the file", () => {
    const files = new Map<string, string>()
    files.set("main.ore", 'import config from "./config.json" with { type: "json" }\nconsole.log(config.name)\n')
    files.set("config.json", '{\n  "name": "x",\n  "tags": []\n}\n')
    const root = project(files)
    const program = loadProgram(join(root, "main.ore"))
    if (program instanceof Error) fail(program.message)
    same(located(program.diagnostics), "")
    same(
        located(check(program).diagnostics),
        "config.json:3:11: Cannot infer the type of an empty array. Add a type annotation, e.g. 'let a: int[] = []'.",
    )
})
