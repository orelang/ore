// The language server of the compiler written in Ore, spoken to as an editor
// would: the base protocol's framing (also split across reads), the
// lifecycle, documents with full and incremental changes, syntax diagnostics
// with UTF-16 positions, cancellation and errors, and the download of a
// module from GitHub, from a cache prepared without the network.
//
// The server runs in this process, in a task, on two pipes: the client writes
// to the server's input pipe, and a task reads the server's output pipe and
// hands the message bodies over a channel. Closing the write end of the input
// pipe is the end of the input. Reading a pipe blocks an OS thread, which the
// scheduler replaces, so this also runs with ORE_THREADS=1. Every wait has a
// timeout that fails the test.

import { test, expect, fail } from "ore:test"
import { Connection, frame, Reader } from "../src/lsp/jsonrpc"
import { Server } from "../src/lsp/server"
import { docsUrl as docs } from "../src/syntax/codes"
import { commitDir } from "../src/project/remote"
import { pathToUri } from "../src/lsp/text"
import { join } from "ore:path"

declare function pipe(fds: ptr): i32
declare function close(fd: i32): i32
declare function setenv(name: string, value: string, overwrite: i32): i32

/** How long to wait for the server, in milliseconds. */
const timeout = 20000

/** A new pipe: its read end and its write end. */
function newPipe(): int[] {
    const fds = unsafe.allocBytes(8)
    if (pipe(fds) !== 0) fail("pipe() failed")
    return [int(unsafe.load<i32>(fds)), int(unsafe.load<i32>(unsafe.add(fds, 4)))]
}

function closeFd(fd: int): void {
    if (close(i32(fd)) !== 0) fail(`close(${fd}) failed`)
}

/** The value received from a channel within the timeout. */
function within<T>(ch: Chan<T>, what: string): T {
    let value: T | null = null
    task.select([ch.onReceive((v) => (value = v)), task.after(timeout, () => {})])
    if (value === null) fail(`timed out waiting for ${what}`)
    return value
}

type Position = { line: int; character: int }
type Range = { start: Position; end: Position }
type Diagnostic = {
    code: string | null
    codeDescription: { href: string } | null
    message: string
    range: Range
    severity: int
    source: string
}
type ResponseError = { code: int; message: string }

/** What the client looks at in every message from the server. */
type Received = {
    id: int | string | null
    method: string | null
    params: { uri: string | null } | null
    error: ResponseError | null
}

type Published = { params: { uri: string; diagnostics: Diagnostic[] } }

/** A message with the jsonrpc field, given the rest of its fields as JSON text. */
function message(fields: string): string {
    return `{"jsonrpc":"2.0",${fields}}`
}

/** The JSON text of a position and of a range, as the server writes them (fields in alphabetical order). */
function position(line: int, character: int): string {
    return `{"character":${character},"line":${line}}`
}

function range(line: int, character: int, endLine: int, endCharacter: int): string {
    return `{"end":${position(endLine, endCharacter)},"start":${position(line, character)}}`
}

function decode(body: string): Received {
    const m = JSON.parse<Received>(body)
    if (m instanceof Error) fail(`not a message from the server: ${body} (${m.message})`)
    return m
}

/** A minimal LSP client of a server running in a task: frames messages, and collects what the server sends. */
class Client {
    private readonly input = newPipe()
    private readonly output = newPipe()
    private readonly bodies = new Chan<string>(256)
    private readonly readerDone = new Chan<bool>(1)
    private readonly exited = new Chan<int>(1)
    /** Bodies received and not yet waited for, in order. */
    private received: string[] = []
    private inputClosed = false
    private code: int | null = null

    constructor() {
        const server = new Server(new Connection(this.input[0], this.output[1]), "test")
        const exited = this.exited
        task.spawn(() => exited.send(server.run()))
        const reader = new Reader(this.output[0], 65536)
        const bodies = this.bodies
        const done = this.readerDone
        task.spawn(() => {
            while (true) {
                const body = reader.next()
                if (body === null) break
                bodies.send(body instanceof Error ? `framing error: ${body.message}` : body)
            }
            done.send(true)
        })
    }

    /** Writes bytes to the server's input at once. */
    write(text: string): void {
        const error = fs.write(this.input[1], text)
        if (error !== null) fail(`writing to the server: ${error.message}`)
    }

    /** Writes a message, given as its JSON text. */
    send(body: string): void {
        this.write(frame(body))
    }

    /** The body of the next message that matches, already received or to come. */
    wait(what: string, matches: (m: Received) => bool): string {
        for (let i = 0; i < this.received.length; i++) {
            const body = this.received[i]
            if (matches(decode(body))) {
                this.received = this.received.filter((_, j) => j !== i)
                return body
            }
        }
        const deadline = Date.now() + timeout
        while (true) {
            let body: string | null = null
            task.select([
                this.bodies.onReceive((b) => (body = b)),
                task.after(Math.max(0, deadline - Date.now()), () => {}),
            ])
            if (body === null) fail(`no message from the server: ${what}`)
            if (matches(decode(body))) return body
            this.received.push(body)
        }
    }

    /** The response to a request; `id` is JSON text, such as `1` or `"slow"`. */
    request(id: string, method: string, params: string): string {
        this.send(message(`"id":${id},"method":${JSON.stringify(method)},"params":${params}`))
        return this.response(id)
    }

    /** The response with an id, given as JSON text. */
    response(id: string): string {
        return this.wait(`the response ${id}`, (m) => m.method === null && JSON.stringify(m.id) === id)
    }

    /** The error code of the response to a request. */
    errorCode(id: string, method: string, params: string): int {
        return codeOf(this.request(id, method, params))
    }

    notify(method: string, params: string): void {
        this.send(message(`"method":${JSON.stringify(method)},"params":${params}`))
    }

    /** The next diagnostics published for a document. */
    diagnostics(uri: string): Diagnostic[] {
        const body = this.wait(`diagnostics of ${uri}`, (m) => {
            const p = m.params
            return m.method === "textDocument/publishDiagnostics" && p !== null && p.uri === uri
        })
        const published = JSON.parse<Published>(body)
        if (published instanceof Error) fail(`${published.message} in ${body}`)
        return published.params.diagnostics
    }

    initialize(): string {
        const init = this.request("0", "initialize", `{"processId":null,"rootUri":null,"capabilities":{}}`)
        this.notify("initialized", "{}")
        return init
    }

    /** Ends the input of the server. */
    closeInput(): void {
        if (this.inputClosed) return
        this.inputClosed = true
        closeFd(this.input[1])
    }

    /** The exit code of the server, once `run` has returned. */
    exitCode(): int {
        const code = this.code ?? within<int>(this.exited, "the server to exit")
        this.code = code
        return code
    }

    /** Ends the input, and the exit code of the server. */
    close(): int {
        this.closeInput()
        const code = this.exitCode()
        this.finish()
        return code
    }

    /** Closes every file descriptor, once the server has exited. */
    finish(): void {
        this.closeInput()
        this.exitCode()
        // The server writes no more: the end of its output stops the reader task.
        closeFd(this.output[1])
        within<bool>(this.readerDone, "the end of the server's output")
        closeFd(this.output[0])
        // The server's reader task may still be about to read its input, and
        // sees its end; give it the time to, so that it never reads a
        // descriptor reused by the next test.
        task.sleep(50)
        closeFd(this.input[0])
    }
}

/** The error code of a response. */
function codeOf(body: string): int {
    const error = decode(body).error
    if (error === null) fail(`expected an error, got ${body}`)
    return error.code
}

const uri = "file:///tmp/ore%20lsp/main.ore"
// The `)` on line 1 is at byte 19 + 19 but UTF-16 character 17: 😀 is 4 bytes and 2 units.
const broken = 'const a = "😀é"\nconst b = "😀" + )\n'
const hoverParams = `{"textDocument":{"uri":${JSON.stringify(uri)}},"position":{"line":0,"character":0}}`
const initializeParams = `{"processId":null,"rootUri":null,"capabilities":{}}`

function didOpen(text: string): string {
    const document = `{"uri":${JSON.stringify(uri)},"languageId":"ore","version":1,"text":${JSON.stringify(text)}}`
    return message(`"method":"textDocument/didOpen","params":{"textDocument":${document}}`)
}

test("lifecycle: initialize, shutdown and exit", () => {
    const client = new Client()
    expect(client.errorCode("1", "textDocument/hover", hoverParams)).toBe(-32002)

    const init = client.initialize()
    const capabilities =
        `{"codeActionProvider":{"codeActionKinds":["quickfix"]},"completionProvider":{"triggerCharacters":["."]},"definitionProvider":true,` +
        `"documentFormattingProvider":true,"documentSymbolProvider":true,"hoverProvider":true,"inlayHintProvider":true,` +
        `"referencesProvider":true,"renameProvider":{"prepareProvider":true},` +
        `"semanticTokensProvider":{"full":true,"legend":{"tokenModifiers":["declaration","readonly","defaultLibrary"],"tokenTypes":["namespace","type","class","interface","typeParameter","parameter","variable","property","function","method"]}},` +
        `"signatureHelpProvider":{"triggerCharacters":["(",","]},"textDocumentSync":2}`
    expect(init).toBe(
        message(`"id":0,"result":{"capabilities":${capabilities},"serverInfo":{"name":"ore","version":"test"}}`),
    )
    expect(client.errorCode(`"again"`, "initialize", initializeParams)).toBe(-32600)

    expect(client.errorCode("2", "ore/unknown", "{}")).toBe(-32601)
    expect(client.request("3", "shutdown", "{}")).toBe(message(`"id":3,"result":null`))
    expect(client.errorCode("4", "textDocument/hover", hoverParams)).toBe(-32600)
    client.notify("exit", "{}")
    expect(client.exitCode()).toBe(0)
    client.finish()
})

test("exit without shutdown, and the end of the input, exit with 1", () => {
    const client = new Client()
    client.initialize()
    client.notify("exit", "{}")
    expect(client.exitCode()).toBe(1)
    client.finish()
    expect(new Client().close()).toBe(1)
})

test("syntax diagnostics with UTF-16 ranges, through full and incremental changes", () => {
    const client = new Client()
    client.initialize()
    const document = (version: int) => `{"uri":${JSON.stringify(uri)},"version":${version}}`
    const change = (version: int, changes: string) =>
        client.notify("textDocument/didChange", `{"textDocument":${document(version)},"contentChanges":${changes}}`)

    client.send(didOpen(broken))
    const opened = client.diagnostics(uri)
    expect(opened.length > 0).toBe(true)
    expect(JSON.stringify(opened[0])).toBe(
        `{"code":"ORE1001","codeDescription":{"href":"${docs("ORE1001")}"},"message":"Identifier expected.","range":${range(1, 17, 1, 18)},"severity":1,"source":"ore"}`,
    )

    // Replace `)` with `1`: ranges after the emoji are in UTF-16 units.
    change(2, `[{"range":${range(1, 17, 1, 18)},"text":"1"}]`)
    // It parses now, and the checker finds the string and the number added.
    const checked = client.diagnostics(uri)
    expect(checked.length).toBe(1)
    expect(checked[0].message.startsWith("Only strings can be concatenated")).toBe(true)

    // Insert after the surrogate pair of line 0, then break line 1 at its end, in one change set.
    change(3, `[{"range":${range(0, 13, 0, 13)},"text":"ü"},{"range":${range(1, 18, 1, 18)},"text":" *"}]`)
    const star = client.diagnostics(uri)
    expect(star.length > 0).toBe(true)
    expect(JSON.stringify(star[0].range.start)).toBe(position(2, 0))

    // A full change, with CRLF line ends.
    change(4, `[{"text":${JSON.stringify('const x = "ü"\r\nconst c = ]\r\n')}}]`)
    const full = client.diagnostics(uri)
    expect(full.length > 0).toBe(true)
    expect(JSON.stringify(full[0].range)).toBe(range(1, 10, 1, 11))

    // A document that does not parse has no types: nothing to tell.
    const at = `"textDocument":{"uri":${JSON.stringify(uri)}},"position":{"line":0,"character":6}`
    expect(client.request("5", "textDocument/hover", `{${at}}`)).toBe(message(`"id":5,"result":null`))
    expect(client.request("6", "textDocument/completion", `{${at}}`)).toBe(message(`"id":6,"result":[]`))
    const references = client.request("7", "textDocument/references", `{${at},"context":{"includeDeclaration":true}}`)
    expect(references).toBe(message(`"id":7,"result":[]`))
    expect(client.errorCode("8", "textDocument/rename", `{${at},"newName":"1x"}`)).toBe(0)

    client.notify("textDocument/didClose", `{"textDocument":{"uri":${JSON.stringify(uri)}}}`)
    expect(client.diagnostics(uri).length).toBe(0)
    expect(client.errorCode("9", "textDocument/hover", `{"textDocument":{"uri":"file:///x.ore"}}`)).toBe(-32602)
    expect(client.close()).toBe(1)
})

test("the checker's diagnostics, hover with JSDoc, definition, completion, references and rename", () => {
    const client = new Client()
    client.initialize()
    const text = [
        "/**",
        " * Adds two numbers.",
        " * @param a the first",
        " */",
        "function add(a: int, b: int): int {",
        "    return a + b",
        "}",
        "const total = add(1, 2)",
        'const bad: int = "x"',
        "console.log(total)",
        "",
    ].join("\n")
    client.send(didOpen(text))
    const errors = client.diagnostics(uri)
    expect(errors.length).toBe(1)
    expect(JSON.stringify(errors[0])).toBe(
        `{"code":"ORE2033","codeDescription":{"href":"${docs("ORE2033")}"},"message":"Type 'string' is not assignable to type 'i64'.","range":${range(8, 17, 8, 20)},"severity":1,"source":"ore"}`,
    )
    const at = (line: int, character: int) =>
        `{"textDocument":{"uri":${JSON.stringify(uri)}},"position":{"line":${line},"character":${character}}}`
    // `add` in `add(1, 2)`: its signature and its documentation.
    expect(client.request("2", "textDocument/hover", at(7, 15))).toBe(
        message(
            `"id":2,"result":{"contents":{"kind":"markdown","value":${JSON.stringify("```ore\nfunction add(a: int, b: int): int\n```\n\nAdds two numbers.\n\n*@param* `a` — the first")}},"range":${range(7, 14, 7, 17)}}`,
        ),
    )
    // The parameter `a` in the body: its type and its `@param`.
    expect(client.request("3", "textDocument/hover", at(5, 11))).toBe(
        message(
            `"id":3,"result":{"contents":{"kind":"markdown","value":${JSON.stringify("```ore\n(parameter) a: i64\n```\n\nthe first")}},"range":${range(5, 11, 5, 12)}}`,
        ),
    )
    expect(client.request("4", "textDocument/definition", at(9, 14))).toBe(
        message(`"id":4,"result":{"range":${range(7, 6, 7, 11)},"uri":${JSON.stringify(uri)}}`),
    )
    const references = client.request(
        "5",
        "textDocument/references",
        `${at(7, 8).slice(0, -1)},"context":{"includeDeclaration":true}}`,
    )
    expect(references).toBe(
        message(
            `"id":5,"result":[{"range":${range(7, 6, 7, 11)},"uri":${JSON.stringify(uri)}},{"range":${range(9, 12, 9, 17)},"uri":${JSON.stringify(uri)}}]`,
        ),
    )
    const renamed = client.request("6", "textDocument/rename", `${at(9, 14).slice(0, -1)},"newName":"sum"}`)
    expect(renamed.includes(`"newText":"sum"`)).toBe(true)

    // The signature of a call being written, with the parameter at the cursor.
    const help = client.request("8", "textDocument/signatureHelp", at(7, 21))
    expect(help.includes(`"label":"function add(a: int, b: int): int"`)).toBe(true)
    expect(help.includes(`"activeParameter":1`)).toBe(true)

    // The type of a variable declared without one, after its name.
    const everything = `"range":${range(0, 0, 11, 0)}`
    const hints = client.request(
        "11",
        "textDocument/inlayHint",
        `{"textDocument":{"uri":${JSON.stringify(uri)}},${everything}}`,
    )
    expect(hints.includes(`{"kind":1,"label":": i64","paddingLeft":false,"position":${position(7, 11)}}`)).toBe(true)

    // Semantic tokens: the function `add` where it is declared comes first.
    const tokens = client.request(
        "12",
        "textDocument/semanticTokens/full",
        `{"textDocument":{"uri":${JSON.stringify(uri)}}}`,
    )
    expect(tokens.startsWith(`{"jsonrpc":"2.0","id":12,"result":{"data":[4,9,3,8,1,`)).toBe(true)

    // A quick fix: the explicit conversion that the error asks for.
    const wrong = `{"range":${range(8, 17, 8, 20)},"message":"Type 'string' is not assignable to type 'i64'. Use an explicit conversion: 'i64(...)'.","code":"ORE2033"}`
    const fixes = client.request(
        "13",
        "textDocument/codeAction",
        `{"textDocument":{"uri":${JSON.stringify(uri)}},"range":${range(8, 0, 8, 20)},"context":{"diagnostics":[${wrong}]}}`,
    )
    expect(fixes.includes(`"newText":"i64(\\"x\\")"`)).toBe(true)

    // The outline, and the document formatted.
    const outline = client.request(
        "9",
        "textDocument/documentSymbol",
        `{"textDocument":{"uri":${JSON.stringify(uri)}}}`,
    )
    expect(outline.includes(`"name":"add"`)).toBe(true)
    expect(outline.includes(`"name":"total"`)).toBe(true)
    const formatted = client.request("10", "textDocument/formatting", `{"textDocument":{"uri":${JSON.stringify(uri)}}}`)
    expect(formatted).toBe(message(`"id":10,"result":[]`))

    // Members after a dot, while the line does not parse yet.
    const typing = 'const word = "abc"\nword.\n'
    client.notify(
        "textDocument/didChange",
        `{"textDocument":{"uri":${JSON.stringify(uri)},"version":2},"contentChanges":[{"text":${JSON.stringify(typing)}}]}`,
    )
    client.diagnostics(uri)
    const members = client.request("7", "textDocument/completion", at(1, 5))
    expect(members.includes(`"label":"toUpperCase"`)).toBe(true)
    expect(members.includes(`"label":"length"`)).toBe(true)

    // A namespace nested in another: `process.` lists `command`, and
    // `process.command.` its functions.
    const edit = (version: int, text: string) => {
        client.notify(
            "textDocument/didChange",
            `{"textDocument":{"uri":${JSON.stringify(uri)},"version":${version}},"contentChanges":[{"text":${JSON.stringify(text)}}]}`,
        )
        client.diagnostics(uri)
    }
    edit(3, "process.\n")
    expect(client.request("12", "textDocument/completion", at(0, 8)).includes(`"label":"command"`)).toBe(true)
    edit(4, "process.command.\n")
    const commands = client.request("13", "textDocument/completion", at(0, 16))
    expect(commands.includes(`"label":"spawn"`)).toBe(true)
    expect(commands.includes(`"label":"getenv"`)).toBe(false)
    expect(client.close()).toBe(1)
})

test("messages split across reads, and several in one read", () => {
    const client = new Client()
    client.initialize()
    const open = frame(didOpen(broken))
    // Split inside the header, then inside the 4 bytes of the first emoji.
    const emoji = open.indexOf("😀")
    let at = 0
    for (const cut of [5, 17, emoji + 1, emoji + 3, open.length]) {
        client.write(open.slice(at, cut))
        at = cut
        task.sleep(30)
    }
    expect(JSON.stringify(client.diagnostics(uri)[0].range.start)).toBe(position(1, 17))

    client.write(
        frame(message(`"id":10,"method":"shutdown","params":null`)) +
            frame(message(`"id":11,"method":"textDocument/hover","params":{}`)),
    )
    expect(client.response("10")).toBe(message(`"id":10,"result":null`))
    expect(codeOf(client.response("11"))).toBe(-32600)
    client.notify("exit", "{}")
    expect(client.exitCode()).toBe(0)
    client.finish()
})

test("cancellation, and messages that are not JSON-RPC", () => {
    const client = new Client()
    client.initialize()
    // The cancellation arrives with the request, before the server handles it.
    client.write(
        frame(message(`"id":"slow","method":"textDocument/hover","params":${hoverParams}`)) +
            frame(message(`"method":"$/cancelRequest","params":{"id":"slow"}`)),
    )
    expect(codeOf(client.response(`"slow"`))).toBe(-32800)

    client.write("Content-Length: 7\r\n\r\n{nope!}")
    expect(codeOf(client.response("null"))).toBe(-32700)
    client.write("Content-Type: x\r\n\r\n")
    expect(codeOf(client.response("null"))).toBe(-32600)
    // The server still answers.
    expect(client.request("12", "shutdown", "{}")).toBe(message(`"id":12,"result":null`))
    expect(client.close()).toBe(0)
})

type Progress = { params: { token: string; value: { kind: string; title: string | null; message: string | null } } }

test("modules from GitHub: work-done progress of the download, and its state in the hover", () => {
    const root = fs.mkdtemp("ore-lsp-github-")
    if (root instanceof Error) fail(root.message)
    // A commit in the cache, named by its hash: found without asking GitHub.
    const sha = "89abcdef0123456789abcdef0123456789abcdef"
    const dir = commitDir(root, "acme", "geo", sha)
    const made = fs.mkdir(dir, true)
    if (made !== null) fail(made.message)
    const wrote = fs.writeFile(join(dir, "index.ore"), "export const answer = 42\n")
    if (wrote !== null) fail(wrote.message)
    const previous = process.getenv("ORE_CACHE")
    setenv("ORE_CACHE", root, 1)

    const client = new Client()
    const init = client.request(
        "0",
        "initialize",
        `{"processId":null,"rootUri":null,"capabilities":{"window":{"workDoneProgress":true}}}`,
    )
    expect(decode(init).error === null).toBe(true)
    client.notify("initialized", "{}")
    const main = pathToUri(join(root, "main.ore"))
    const url = `https://github.com/acme/geo/tree/${sha}`
    const text = `import { answer } from "${url}"\nimport { y } from "https://github.com/acme"\nconst x: int = answer\n`
    const document = `{"uri":${JSON.stringify(main)},"languageId":"ore","version":1,"text":${JSON.stringify(text)}}`
    client.notify("textDocument/didOpen", `{"textDocument":${document}}`)
    // The cached commit is used at once; only the URL that is not a repository's is an error.
    const opened = client.diagnostics(main)
    expect(opened.length).toBe(1)
    expect(opened[0].message.startsWith("Invalid GitHub module URL 'https://github.com/acme'")).toBe(true)

    // The download, which finds the commit in the cache, is reported as work-done progress.
    const create = decode(client.wait("the progress token", (m) => m.method === "window/workDoneProgress/create"))
    const token = "ore/github/0"
    expect(JSON.stringify(create.id)).toBe(JSON.stringify(token))
    client.send(message(`"id":${JSON.stringify(create.id)},"result":null`))
    const progress = (kind: string): Progress => {
        const body = client.wait(`$/progress ${kind}`, (m) => m.method === "$/progress")
        const p = JSON.parse<Progress>(body)
        if (p instanceof Error) fail(`${p.message} in ${body}`)
        expect(p.params.token).toBe(token)
        return p
    }
    const begin = progress("begin")
    expect(begin.params.value.kind).toBe("begin")
    expect(begin.params.value.title ?? "").toBe("GitHub: acme/geo")
    let end = progress("report or end")
    while (end.params.value.kind === "report") end = progress("end")
    expect(end.params.value.kind).toBe("end")
    expect(end.params.value.message ?? "").toBe("at commit 89abcdef0123")
    // Then the document is analyzed again.
    expect(client.diagnostics(main).length).toBe(1)

    const at = (line: int, character: int) =>
        `{"textDocument":{"uri":${JSON.stringify(main)}},"position":{"line":${line},"character":${character}}}`
    const hover = (id: string, line: int, character: int) => {
        const body = client.request(id, "textDocument/hover", at(line, character))
        const parsed = JSON.parse<{ result: { contents: { value: string }; range: Range } | null }>(body)
        if (parsed instanceof Error) fail(`${parsed.message} in ${body}`)
        const result = parsed.result
        if (result === null) fail(`no hover in ${body}`)
        return result
    }
    const cached = hover("1", 0, 30)
    expect(cached.contents.value).toBe("GitHub: **acme/geo**: cached at commit `89abcdef0123`")
    expect(JSON.stringify(cached.range)).toBe(range(0, 23, 0, 23 + url.length + 2))
    expect(hover("2", 1, 25).contents.value.startsWith("Invalid GitHub module URL")).toBe(true)
    // Not on a specifier: the checker's hover.
    expect(hover("3", 2, 6).contents.value.includes("int")).toBe(true)

    expect(client.request("4", "shutdown", "{}")).toBe(message(`"id":4,"result":null`))
    expect(client.close()).toBe(0)
    setenv("ORE_CACHE", previous ?? "", 1)
    fs.remove(root, true)
})

/** The next body read, "<error: ...>" or "<end>". */
function next(reader: Reader): string {
    const body = reader.next()
    if (body === null) return "<end>"
    if (body instanceof Error) return `<error: ${body.message}>`
    return body
}

test("the reader of framed messages, given a few bytes at a time", () => {
    const bodies = ["{}", '{"text":"😀é"}', "ü", "", '["ж", "日本語", "😀😀"]']
    let input = ""
    for (const body of bodies) input += frame(body)
    // A header without a Content-Length is skipped, after an error.
    input += "Content-Type: x\r\n\r\n" + frame('{"last":"😀"}')
    for (let chunk = 1; chunk <= 7; chunk++) {
        const fds = newPipe()
        const error = fs.write(fds[1], input)
        if (error !== null) fail(error.message)
        closeFd(fds[1])
        const reader = new Reader(fds[0], chunk)
        for (const body of bodies) expect(next(reader)).toBe(body)
        expect(next(reader)).toBe("<error: no valid Content-Length in the header 'Content-Type: x'>")
        expect(next(reader)).toBe('{"last":"😀"}')
        expect(next(reader)).toBe("<end>")
        closeFd(fds[0])
    }
})
