// Loading a program: the entry file and every module it imports, parsed.

import { dirname, join, resolve } from "ore:path"
import { Diagnostic } from "../syntax/diagnostic"
import { importType, moduleSpecifier, stringValue } from "../syntax/imports"
import { parse, type ParseResult } from "../syntax/parse"
import { type Source } from "../syntax/source"
import { jsonModule } from "./json"
import { findPackageRoot, isFile, resolveImport, runtimeModules, stdModules } from "./resolve"

export class Program {
    constructor(
        /** Modules with each module after the modules it imports, the entry last (cycles aside). */
        readonly modules: Source[],
        readonly entry: Source,
        /** For each module, the module each import specifier resolves to. */
        readonly imports: Map<Source, Map<string, Source>>,
        /** For each module, the contents of the files it imports as text (`with { type: "text" }`), by specifier. */
        readonly texts: Map<Source, Map<string, string>>,
        /** Syntax errors and unresolved imports. */
        readonly diagnostics: Diagnostic[],
        /** Whether any module has syntax errors, so that it cannot be checked. */
        readonly syntaxErrors: bool,
    ) {}

    /** The absolute paths of the files imported as text or JSON, found or not. */
    textFiles: string[] = []
}

/**
 * The files a program is made of, as absolute paths, each once: its modules
 * but the embedded "ore:" ones, the files they import as text or JSON (also
 * those not found), and the package.json of the package of each module.
 */
export function programFiles(program: Program): string[] {
    const files: string[] = []
    const seen = new Set<string>()
    const add = (path: string) => {
        if (seen.has(path)) return
        seen.add(path)
        files.push(path)
    }
    for (const source of program.modules) {
        if (source.path.startsWith("ore:")) continue
        const path = resolve(source.path)
        add(path)
        const root = findPackageRoot(dirname(path))
        if (root !== null) add(join(root, "package.json"))
    }
    for (const file of program.textFiles) add(file)
    return files
}

export class LoadOptions {
    /** Texts of files that differ from the disk, such as documents open in an editor. */
    overrides = new Map<string, string>()
    /** Name modules by absolute paths instead of paths relative to the working directory. */
    absolutePaths = false
    /**
     * Parses of the embedded "ore:" modules, kept across loads: a module
     * found here is not parsed again, and one parsed is added. The language
     * server keeps one for its session; an overridden module is parsed anew.
     */
    parsed = new Map<string, ParseResult>()
}

/**
 * Parses an entry file and every module it imports, directly or not. An
 * Error when a file cannot be read; unresolved imports are diagnostics.
 */
export function loadProgram(entryPath: string, given?: LoadOptions): Program | Error {
    // A default value `new LoadOptions()` crashes the TypeScript checker: the
    // constructor is not declared yet when the parameters are.
    const options = given ?? new LoadOptions()
    const loader = new Loader(options)
    // The runtime comes first, so that its top-level code runs before any other.
    for (const name of runtimeModules) {
        const runtime = loader.visit(name, name)
        if (runtime instanceof Error) return runtime
    }
    const entry = loader.visit(resolve(entryPath), options.absolutePaths ? resolve(entryPath) : entryPath)
    if (entry instanceof Error) return entry
    const program = new Program(
        loader.order,
        entry,
        loader.imports,
        loader.texts,
        loader.diagnostics,
        loader.syntaxErrors,
    )
    program.textFiles = loader.textFiles
    return program
}

class Loader {
    byPath = new Map<string, Source>()
    imports = new Map<Source, Map<string, Source>>()
    texts = new Map<Source, Map<string, string>>()
    diagnostics: Diagnostic[] = []
    order: Source[] = []
    textFiles: string[] = []
    syntaxErrors = false

    constructor(readonly options: LoadOptions) {}

    private read(path: string): string | Error {
        const override = this.options.overrides.get(path)
        if (override !== null) return override
        const std = stdModules.get(path)
        if (std !== null) return std
        return fs.readFile(path)
    }

    /** Parses the file at a path, or reuses its parse when it is an "ore:" module parsed before. */
    private parse(path: string, display: string): ParseResult | Error {
        const reusable = stdModules.has(path) && !this.options.overrides.has(path)
        if (reusable) {
            const known = this.options.parsed.get(path)
            if (known !== null) return known
        }
        const text = this.read(path)
        if (text instanceof Error) return text
        const parsed = parse(display, text)
        if (reusable) this.options.parsed.set(path, parsed)
        return parsed
    }

    /** Parses the module at a path (or an "ore:" name) once, then the modules it imports. */
    visit(path: string, display: string): Source | Error {
        const existing = this.byPath.get(path)
        if (existing !== null) return existing
        const parsed = this.parse(path, display)
        if (parsed instanceof Error) return parsed
        const source = parsed.source
        this.byPath.set(path, source)
        for (const d of parsed.diagnostics) this.diagnostics.push(d)
        if (parsed.diagnostics.length > 0) this.syntaxErrors = true
        const resolved = new Map<string, Source>()
        this.imports.set(source, resolved)
        const textsOfModule = new Map<string, string>()
        this.texts.set(source, textsOfModule)
        for (const stmt of source.ast.list("statements")) {
            const specifier = moduleSpecifier(stmt)
            if (specifier === null) continue
            const name = stringValue(specifier)
            const type = stmt.kind === "ImportDeclaration" ? importType(stmt) : ""
            // A file imported as text is embedded in the program, not loaded as a module.
            if (type === "text") {
                const file = resolve(dirname(path), name)
                const contents = this.readImported(file)
                if (contents instanceof Error) return contents
                if (contents === null) this.error(source, specifier.start, specifier.end, `Cannot find file '${name}'.`)
                else textsOfModule.set(name, contents)
                continue
            }
            // A JSON file is a module that exports its value.
            if (type === "json") {
                const file = resolve(dirname(path), name)
                const contents = this.readImported(file)
                if (contents instanceof Error) return contents
                if (contents === null) {
                    this.error(source, specifier.start, specifier.end, `Cannot find file '${name}'.`)
                    continue
                }
                resolved.set(name, this.visitJson(file, contents))
                continue
            }
            // The checker reports other types.
            if (type !== "") continue
            const target = resolveImport(name, path)
            if (target instanceof Error) {
                this.error(source, specifier.start, specifier.end, target.message)
                continue
            }
            if (target === null) {
                this.error(source, specifier.start, specifier.end, `Cannot find module '${name}'.`)
                continue
            }
            const std = stdModules.has(target)
            const key = std ? target : resolve(target)
            const module = this.visit(key, std || this.options.absolutePaths ? key : displayPath(target))
            if (module instanceof Error) return module
            resolved.set(name, module)
        }
        this.order.push(source)
        return source
    }

    /** The contents of a file imported as text or JSON, null when there is none. */
    private readImported(file: string): string | null | Error {
        if (!this.textFiles.includes(file)) this.textFiles.push(file)
        const override = this.options.overrides.get(file)
        if (override !== null) return override
        if (!isFile(file)) return null
        return fs.readFile(file)
    }

    /** The module of a JSON file, made once. */
    private visitJson(file: string, contents: string): Source {
        const existing = this.byPath.get(file)
        if (existing !== null) return existing
        const json = jsonModule(this.options.absolutePaths ? file : displayPath(file), contents)
        const source = json.source
        this.byPath.set(file, source)
        for (const d of json.diagnostics) this.diagnostics.push(d)
        if (json.diagnostics.length > 0) this.syntaxErrors = true
        this.imports.set(source, new Map<string, Source>())
        this.texts.set(source, new Map<string, string>())
        this.order.push(source)
        return source
    }

    private error(source: Source, start: int, end: int, message: string) {
        this.diagnostics.push(new Diagnostic(source, start, end - start, "error", message))
    }
}

/** A path relative to the working directory when below it, for messages and stack traces. */
function displayPath(path: string): string {
    const cwd = process.cwd()
    return path.startsWith(`${cwd}/`) ? path.slice(cwd.length + 1) : path
}
