// The type model of the IR: the same
// names, kinds and helpers. Each TypeScript interface is a class whose
// discriminant (`kind`) is a constant field; see "How TypeScript maps to Ore
// in this port" in compiler/README.md.

import { type Func } from "./nodes"

export type IntName = "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64"
export type FloatName = "f32" | "f64"

export class IntType {
    readonly kind: "int" = "int"
    /** 8, 16, 32 or 64. */
    constructor(
        readonly name: IntName,
        readonly bits: int,
        readonly signed: bool,
    ) {}
}

export class FloatType {
    readonly kind: "float" = "float"
    /** 32 or 64. */
    constructor(
        readonly name: FloatName,
        readonly bits: int,
    ) {}
}

/**
 * `boolean`, or a boolean literal type `true` or `false`: those are held as a
 * `bool` too, so that only the checker tells them apart. Each is a singleton.
 */
export class BoolType {
    readonly kind: "bool" = "bool"
    /** "true" or "false" for a literal type; "" for `boolean`. */
    constructor(readonly literal: string = "") {}
}

export class StringType {
    readonly kind: "string" = "string"
}

/**
 * `bigint`: an arbitrary-precision integer, as in JavaScript. A value is a
 * pointer to an immutable block of the runtime (runtime/core/bigint.ore),
 * compared by value; 0n is the null pointer, so that zeroed memory holds it.
 */
export class BigIntType {
    readonly kind: "bigint" = "bigint"
}

export class VoidType {
    readonly kind: "void" = "void"
}

/** The type of expressions that never complete, such as `panic(...)`. */
export class NeverType {
    readonly kind: "never" = "never"
}

export class FuncType {
    readonly kind: "func" = "func"
    constructor(
        readonly params: Type[],
        readonly result: Type,
    ) {}

    /**
     * How many parameters a call must give, when fewer than all: the others
     * are optional, `T | null`, and null when left out. -1: all.
     */
    public required = -1

    /** The last parameter is a rest parameter, an array, which receives the extra arguments. */
    public rest = false

    /**
     * A constructor type, `new (...) => T`: `typeof C` of a class, which
     * exists only in computations on types (`InstanceType`, `ConstructorParameters`).
     */
    public construct = false
}

/** The parameters of a function type, as written: `i64, i64?, ...string[]`. */
export function paramsToString(t: FuncType): string {
    const params: string[] = []
    for (let i = 0; i < t.params.length; i++) {
        const p = t.params[i]
        const text = p.kind === "func" ? `(${typeToString(p)})` : typeToString(p)
        if (t.rest && i === t.params.length - 1) params.push(`...${text}`)
        else if (t.required >= 0 && i >= t.required && p.kind === "union") params.push(`${withoutNullMembers(p)}?`)
        else params.push(text)
    }
    return params.join(", ")
}

/** `T[]`: a reference to a growable array. */
export class ArrayType {
    readonly kind: "array" = "array"
    constructor(readonly elem: Type) {}

    /**
     * `TemplateStringsArray`, of elements `string | null`: the strings a
     * tagged template passes to its tag. Its header has the array of raw
     * strings after it (`templateObject` in runtime/core/string.ore), so it
     * is a type of its own, which converts to the array of its elements.
     */
    public template = false

    /** `readonly T[]`: an array that the methods which change it and index assignment cannot reach through this type. */
    public readOnly = false
}

export class Field {
    /** Accessible only inside the class that declares it; a parameter cannot be named `private`. */
    readonly private: bool
    constructor(
        readonly name: string,
        readonly type: Type,
        readonly readonly: bool,
        isPrivate: bool = false,
    ) {
        this.private = isPrivate
    }

    /** `x?: T` in an object type: of type `T | null`, and left out of literals as null. */
    public optional = false
}

export class Method {
    readonly private: bool
    constructor(
        readonly name: string,
        readonly func: Func,
        isPrivate: bool,
    ) {
        this.private = isPrivate
    }
}

/**
 * A heap-allocated record, used through references.
 *
 * A class is nominal: each declaration is its own type, with fields in
 * declaration order. Anonymous object types (`{ x: f64 }`, object literals)
 * are interned by shape, so two of them are the same type exactly when they
 * are the same object; their fields are sorted by name.
 */
export class StructType {
    readonly kind: "struct" = "struct"
    constructor(
        /** Unique per program; used for names in generated code. */
        readonly id: int,
        /** Class name, a type alias name, or null for an anonymous shape. */
        public name: string | null,
        /** Whether this is a class. */
        readonly nominal: bool,
        public fields: Field[],
        /** Methods of a class; empty for object types. */
        public methods: Method[],
        /** The constructor of a class: returns a new instance. */
        public ctor?: Func,
    ) {}

    /**
     * The base class of a class declared with `extends`: its fields come first
     * in `fields`, and its methods first in `methods`, in the same order (the
     * slots of the class table), each replaced by the override if there is one.
     */
    public base: StructType | null = null

    /** A tuple `[A, B]`: an anonymous struct whose fields are named "0", "1", ... in order. */
    public tuple = false

    /**
     * For an object type: its fields in the order of the declaration or the
     * literal that made it first, where `fields` sorts them by name for its
     * identity. Printing, JSON and `Object.keys` follow it, as JavaScript
     * follows the order properties were added. Null when it is `fields`.
     */
    public order: Field[] | null = null

    /**
     * For an object type: the other orders of its fields that the program
     * makes its values in, by declarations, literals and spreads (see
     * `addOrder`). With any, each value keeps the index of its order in
     * `fieldOrders` in a hidden word after its fields, which printing, JSON
     * and `Object.keys` read; the fields are laid out as without.
     */
    public orders: Field[][] = []

    /** The literals that spread values of this object type, whose orders follow its orders. */
    public rules: SpreadRule[] = []
}

/** The fields of a struct in the order its values show them (see `StructType.order`). */
export function displayFields(t: StructType): Field[] {
    const order = t.order
    const all = order !== null ? order : t.fields
    // The hidden field of an object literal's generic method holds its instances, and is not shown.
    if (t.nominal || !all.some(isGenericField)) return all
    return all.filter((f) => !isGenericField(f))
}

/** Whether a field is the hidden one of a generic method of an object literal, `#map 12`. */
export function isGenericField(f: Field): bool {
    return f.private && f.name.startsWith("#")
}

/** The orders of the fields of an object type that its values show, by index: `displayFields` first, then `orders`. */
export function fieldOrders(t: StructType): Field[][] {
    const all: Field[][] = [displayFields(t)]
    for (const o of t.orders) all.push(o)
    return all
}

/** Whether values of an object type keep the index of their order: the program makes them in more than one. */
export function ordered(t: StructType): bool {
    return t.orders.length > 0
}

/** The most orders of the fields of an object type; a value made in another shows the first. */
const maxOrders = 64

/** The fields of an object type in the order of `names`, then those it leaves out in the order they are shown. */
function fieldsNamed(t: StructType, names: string[]): Field[] {
    const order: Field[] = []
    const taken = new Set<string>()
    for (const name of names) {
        const f = findField(t, name)
        if (f === null || taken.has(name)) continue
        order.push(f)
        taken.add(name)
    }
    for (const f of displayFields(t)) if (!taken.has(f.name)) order.push(f)
    return order
}

/** The index in `fieldOrders` of the order of `fields`, or -1. */
function findOrder(t: StructType, fields: Field[]): int {
    const all = fieldOrders(t)
    for (let i = 0; i < all.length; i++) {
        const o = all[i]
        let same = o.length === fields.length
        for (let j = 0; j < o.length && same; j++) if (o[j].name !== fields[j].name) same = false
        if (same) return i
    }
    return -1
}

/** The index in `fieldOrders` of the order of the fields `names` of an object type; 0 when it has none so. */
export function orderIndex(t: StructType, names: string[]): int {
    if (t.nominal || t.tuple) return 0
    return Math.max(0, findOrder(t, fieldsNamed(t, names)))
}

/**
 * Adds the order of the fields `names` of an object type (those left out
 * after them), which the program makes a value of it in, and gives its index
 * in `fieldOrders`. The literals that spread values of the type add the
 * orders this one gives them.
 */
export function addOrder(t: StructType, names: string[]): int {
    if (t.nominal || t.tuple) return 0
    const order = fieldsNamed(t, names)
    const found = findOrder(t, order)
    if (found >= 0) return found
    if (t.orders.length + 1 >= maxOrders) return 0
    t.orders.push(order)
    for (const rule of t.rules) applyRule(rule)
    return t.orders.length
}

/**
 * A part of an object literal, for the order of its fields: properties
 * written, or a spread of a value of the object type `source`, which adds
 * its fields `names` in the order of that value.
 */
export class OrderPart {
    constructor(
        readonly names: string[],
        readonly source: StructType | null,
    ) {}
}

/**
 * How an object literal with spreads orders its fields, as JavaScript adds
 * properties: those of each part in turn, each where it was first added; so
 * the order depends on the orders of the values spread.
 */
export class SpreadRule {
    constructor(
        readonly target: StructType,
        readonly parts: OrderPart[],
    ) {}
}

/** The rule of an object literal of type `target` with these parts; its type gets the orders it can make. */
export function spreadRule(target: StructType, parts: OrderPart[]): SpreadRule {
    const rule = new SpreadRule(target, parts)
    for (const s of ruleSources(rule)) s.rules.push(rule)
    applyRule(rule)
    return rule
}

/** The object types whose values a rule's literal spreads, in order. */
export function ruleSources(rule: SpreadRule): StructType[] {
    const sources: StructType[] = []
    for (const p of rule.parts) {
        const source = p.source
        if (source !== null) sources.push(source)
    }
    return sources
}

/** The names of the fields of a rule's literal in order, when the value of its i-th source has order `choice[i]`. */
export function ruleOrder(rule: SpreadRule, choice: int[]): string[] {
    const names: string[] = []
    const taken = new Set<string>()
    let next = 0
    for (const p of rule.parts) {
        const source = p.source
        let order: string[] = p.names
        if (source !== null) {
            const all = fieldOrders(source)
            const k = choice[next++]
            order = []
            for (const f of all[k < all.length ? k : 0]) if (p.names.includes(f.name)) order.push(f.name)
        }
        for (const n of order) {
            if (taken.has(n)) continue
            names.push(n)
            taken.add(n)
        }
    }
    return names
}

/** The number of choices of the orders of a rule's sources: the product of their numbers of orders. */
export function ruleChoices(rule: SpreadRule): int {
    let n = 1
    for (const s of ruleSources(rule)) n *= fieldOrders(s).length
    return n
}

/** The choice numbered `code` of the orders of a rule's sources: its digits, the first source's the lowest. */
export function ruleChoice(rule: SpreadRule, code: int): int[] {
    const choice: int[] = []
    let rest = code
    for (const s of ruleSources(rule)) {
        const n = fieldOrders(s).length
        choice.push(rest % n)
        rest = rest / n
    }
    return choice
}

/** Adds to a rule's type the orders its literal can make, one per choice of the orders of its sources. */
function applyRule(rule: SpreadRule) {
    const n = ruleChoices(rule)
    for (let code = 0; code < n && code < maxOrders * maxOrders; code++)
        addOrder(rule.target, ruleOrder(rule, ruleChoice(rule, code)))
}

/** The fields of an object type in an order that `Object.keys` lists: all but the hidden ones of accessors. */
export function dataFields(order: Field[]): Field[] {
    const fields: Field[] = []
    for (const f of order) {
        const ft = f.type
        if (f.private && ft.kind === "func" && (f.name.startsWith("get ") || f.name.startsWith("set "))) continue
        fields.push(f)
    }
    return fields
}

/** A field member of an interface: `{ k: "field", ... }` in TypeScript. */
export class InterfaceField {
    readonly k: "field" = "field"
    constructor(
        readonly name: string,
        readonly type: Type,
        readonly readonly: bool,
    ) {}

    /**
     * `x?: T`: of type `T | null`, and a struct may not have it; then its
     * table holds -1 for the offset, reading gives null and writing panics.
     */
    public optional = false
    /**
     * `m?(): T`: an optional method, a read-only optional field of a function
     * type that a class may implement with a method.
     */
    public method = false
}

/** A method member of an interface: `{ k: "method", ... }` in TypeScript. */
export class InterfaceMethod {
    readonly k: "method" = "method"
    constructor(
        readonly name: string,
        /** For a generic method, `() => void`: each instance has its own type. */
        readonly type: FuncType,
    ) {}

    /** For a generic method, `map<U>(f: (x: T) => U): U[]`: the instances called through the interface. */
    public slots: GenericSlots | null = null
}

/**
 * The instances of a generic method of an interface that the program calls
 * through it, by their type arguments. Its entry in an interface table
 * points to a table of the implementing methods, one per instance in this
 * order. Generic methods of interfaces that convert to each other share one
 * layout: one is merged into the other (`parent`), whose instances are then
 * those of both.
 */
export class GenericSlots {
    public parent: GenericSlots | null = null
    /** The keys of the type arguments of the instances, in table order. */
    readonly keys: string[] = []
    /** The type arguments of the instances, in table order. */
    readonly args: Type[][] = []
    constructor(
        readonly name: string,
        /** The number of type parameters. */
        readonly count: int,
    ) {}
}

/** The slots that generic slots have been merged into, or themselves. */
export function slotsRoot(slots: GenericSlots): GenericSlots {
    let root = slots
    for (;;) {
        const parent = root.parent
        if (parent === null) return root
        root = parent
    }
}

/** The slots of a generic method of an interface; null for other members. */
export function slotsOf(m: InterfaceMember): GenericSlots | null {
    return m.k === "method" ? m.slots : null
}

export type InterfaceMember = InterfaceField | InterfaceMethod

/**
 * A structural interface. A value is a reference to any struct that has the
 * members, paired with a table that holds, for each member in `members`
 * order, the field offset or the method.
 */
export class InterfaceType {
    readonly kind: "interface" = "interface"
    constructor(
        readonly id: int,
        readonly name: string,
        /** Sorted by name; the layout of the table. */
        public members: InterfaceMember[],
    ) {}
}

/** A string literal type such as `"circle"`; its values are strings. */
export class LiteralType {
    readonly kind: "literal" = "literal"
    constructor(readonly value: string) {}
}

/**
 * A numeric literal type such as `0` or `-1.5`, by its number's canonical
 * text. Its values are numbers, held as an `f64` equal to it.
 */
export class NumberLiteralType {
    readonly kind: "number-literal" = "number-literal"
    constructor(readonly value: string) {}
}

/** `Chan<T>`: a reference to a channel between tasks. */
export class ChanType {
    readonly kind: "chan" = "chan"
    constructor(readonly elem: Type) {}
}

/** A case of `task.select`. */
export class SelectCaseType {
    readonly kind: "select-case" = "select-case"
}

/** An opaque C pointer, for handles passed to and from external C functions. */
export class PtrType {
    readonly kind: "ptr" = "ptr"
}

/**
 * `unknown`: any value, boxed with the type it has: a pointer to a
 * descriptor of that type (null for `null`) and two words that hold the
 * value as a variable of its type would. Narrowing unboxes it.
 */
export class UnknownType {
    readonly kind: "unknown" = "unknown"
}

/** The type of `null`; appears in unions such as `Node | null`. */
export class NullType {
    readonly kind: "null" = "null"
}

/**
 * A union of two or more types. Members are normalized: no nested unions, no
 * duplicates, and a canonical order, so equal unions have equal members.
 */
export class UnionType {
    readonly kind: "union" = "union"
    constructor(
        /** Unique per program; used for names in generated code. */
        readonly id: int,
        readonly members: Type[],
        /** The type alias that first named this union, for messages; not part of its identity. */
        public name?: string,
    ) {}
}

/** `Map<K, V>`: a reference to a hash map that keeps insertion order. */
export class MapType {
    readonly kind: "map" = "map"
    constructor(
        readonly key: Type,
        readonly value: Type,
    ) {}

    /**
     * A dictionary, `{ [key: string]: V }` or `Record<string, V>`: a map of
     * string keys used with the syntax of objects (`d.a`, `d[k]`, `delete
     * d[k]`, `k in d`), printed and converted to JSON as an object. It is a
     * type of its own, which a `Map` does not convert to.
     */
    public dict = false

    /** A dictionary whose entries cannot be assigned or deleted: `{ readonly [key: string]: V }`. */
    public readonly = false

    /**
     * The named entries of a dictionary, `name` in `{ name: string; [key:
     * string]: string }`, in the order written: entries that every value has
     * (an optional one aside), of types assignable to the values'.
     */
    public members: Field[] = []

    /** The type alias that names a dictionary with named entries, for messages. */
    public name: string | null = null
}

/** `{ [key: string]: V }`, readonly with `isReadonly`. */
export function dictOf(value: Type, isReadonly: bool): MapType {
    const t = new MapType(types.string, value)
    t.dict = true
    t.readonly = isReadonly
    return t
}

/** A dictionary of the same values and named entries, readonly with `isReadonly`. */
export function dictLike(type: MapType, isReadonly: bool): MapType {
    const t = dictOf(type.value, isReadonly)
    t.members = type.members
    t.name = type.readonly === isReadonly ? type.name : null
    return t
}

/** The named entry `name` of a dictionary, or null. */
export function dictMember(type: MapType, name: string): Field | null {
    for (const m of type.members) if (m.name === name) return m
    return null
}

/** `Set<T>`: a reference to a hash set that keeps insertion order: a map without values. */
export class SetType {
    readonly kind: "set" = "set"
    constructor(readonly elem: Type) {}
}

export type PrimitiveType =
    | IntType
    | FloatType
    | BoolType
    | StringType
    | BigIntType
    | VoidType
    | NeverType
    | NullType
    | LiteralType
    | NumberLiteralType
    | PtrType
    | SelectCaseType
export type Type =
    | IntType
    | FloatType
    | BoolType
    | StringType
    | BigIntType
    | VoidType
    | NeverType
    | NullType
    | LiteralType
    | NumberLiteralType
    | PtrType
    | SelectCaseType
    | UnknownType
    | FuncType
    | ArrayType
    | StructType
    | InterfaceType
    | UnionType
    | MapType
    | SetType
    | ChanType

export function findField(t: StructType, name: string): Field | null {
    for (const f of t.fields) if (f.name === name) return f
    return null
}

export function findMethod(t: StructType, name: string): Method | null {
    for (const m of t.methods) if (m.name === name) return m
    return null
}

/**
 * The name of overload signature `index` of method `name` among the methods
 * of a class: `name#index`, which no method of the source is named. Each
 * signature is a method of its own, overridden by the subclasses' signature
 * at its index; the implementation is no method of the class.
 */
export function overloadName(name: string, index: int): string {
    return `${name}#${index}`
}

/** The name in the source of a method of a class: of an overload signature, the method's name. */
export function sourceMethodName(name: string): string {
    const hash = name.lastIndexOf("#")
    return hash > 0 ? name.slice(0, hash) : name
}

/** The overload signatures of method `name` of a class, in order; empty for a method without them. */
export function findOverloads(t: StructType, name: string): Method[] {
    const found: Method[] = []
    for (;;) {
        const m = findMethod(t, overloadName(name, found.length))
        if (m === null) return found
        found.push(m)
    }
}

/**
 * The method of a class that implements method `name` of type `type` of an
 * interface: the method so named, or else its overload signature of that
 * type.
 */
export function implementingMethod(t: StructType, name: string, type: FuncType): Method | null {
    const method = findMethod(t, name)
    if (method !== null) return method
    for (const m of findOverloads(t, name)) if (sameType(m.func.type, type)) return m
    return null
}

/** Whether class `s` is `base` or a subclass of it. */
export function isSubclass(s: StructType, base: StructType): bool {
    if (s === base) return true
    const parent = s.base
    return parent !== null && isSubclass(parent, base)
}

/**
 * The classes among `structs` whose instances start with a pointer to their
 * class table: those with a base class or a subclass, by id.
 */
export function classTables(structs: StructType[]): Map<int, bool> {
    const tables = new Map<int, bool>()
    for (const s of structs) {
        const base = s.base
        if (base === null) continue
        tables.set(s.id, true)
        tables.set(base.id, true)
    }
    return tables
}

/** Whether a subclass of `s` among `structs` overrides its method `name`, so that calls of it on an `s` dispatch through the class table. */
export function overridden(structs: StructType[], s: StructType, name: string): bool {
    const own = findMethod(s, name)
    for (const t of structs) {
        if (t === s || t.base === null || !isSubclass(t, s)) continue
        const method = findMethod(t, name)
        const func = method === null ? null : method.func
        if (func !== (own === null ? null : own.func)) return true
    }
    return false
}

/** The slot of a method in the class table of the class that declares or inherits it: its index in the methods of its receiver's class. */
export function methodSlot(func: Func): int {
    const receiver = func.receiver
    if (receiver === null) return -1
    const owner = receiver.type
    if (owner.kind !== "struct") return -1
    const methods = owner.methods
    for (let i = 0; i < methods.length; i++) if (methods[i].func === func) return i
    return -1
}

export function arrayOf(elem: Type): ArrayType {
    return new ArrayType(elem)
}

/** `readonly T[]`. */
export function readonlyArrayOf(elem: Type): ArrayType {
    const array = new ArrayType(elem)
    array.readOnly = true
    return array
}

/** Whether a tuple is read-only, `readonly [A, B]`: its elements are read-only fields. */
export function readonlyTuple(t: StructType): bool {
    return t.tuple && t.fields.length > 0 && t.fields.every((f) => f.readonly)
}

/** A tuple as written: `[i64, string]`, `readonly [1, "a"]`. */
function tupleToString(t: StructType): string {
    const elems: string[] = []
    for (const f of t.fields) elems.push(tupleElementToString(f))
    return `${readonlyTuple(t) ? "readonly " : ""}[${elems.join(", ")}]`
}

/** Primitive types are singletons and can be compared by identity. */
export const types = {
    i8: new IntType("i8", 8, true),
    i16: new IntType("i16", 16, true),
    i32: new IntType("i32", 32, true),
    i64: new IntType("i64", 64, true),
    u8: new IntType("u8", 8, false),
    u16: new IntType("u16", 16, false),
    u32: new IntType("u32", 32, false),
    u64: new IntType("u64", 64, false),
    f32: new FloatType("f32", 32),
    f64: new FloatType("f64", 64),
    bool: new BoolType(),
    boolTrue: new BoolType("true"),
    boolFalse: new BoolType("false"),
    string: new StringType(),
    bigint: new BigIntType(),
    void: new VoidType(),
    never: new NeverType(),
    null: new NullType(),
    unknown: new UnknownType(),
    ptr: new PtrType(),
    SelectCase: new SelectCaseType(),
}

export function isNumeric(t: Type): bool {
    return t.kind === "int" || t.kind === "float"
}

/** Whether values of a type are numbers held as an `f64`: a numeric literal type, or a union of only those. */
export function isNumberLiterals(t: Type): bool {
    if (t.kind === "number-literal") return true
    return t.kind === "union" && t.members.every((m) => m.kind === "number-literal")
}

/**
 * Interface pairs assumed equal while comparing recursive interfaces: `a[i]`
 * with `b[i]`. One per comparison, not a global, so that threads compare
 * types at the same time.
 */
class Assumed {
    a: InterfaceType[] = []
    b: InterfaceType[] = []
}

/** Whether two interfaces have the same members; recursive interfaces are compared coinductively. */
function sameInterface(a: InterfaceType, b: InterfaceType, given: Assumed | null): bool {
    if (a.members.length !== b.members.length) return false
    const assumed = given ?? new Assumed()
    for (let i = 0; i < assumed.a.length; i++) {
        const x = assumed.a[i]
        const y = assumed.b[i]
        if ((x === a && y === b) || (x === b && y === a)) return true
    }
    assumed.a.push(a)
    assumed.b.push(b)
    let same = true
    for (let i = 0; i < a.members.length && same; i++) {
        const m = a.members[i]
        const n = b.members[i]
        same =
            m.k === n.k &&
            m.name === n.name &&
            sameIn(m.type, n.type, assumed) &&
            optionalOf(m) === optionalOf(n) &&
            slotsOf(m) === slotsOf(n)
    }
    assumed.a.pop()
    assumed.b.pop()
    return same
}

/** Whether two dictionaries have the same named entries, in the same order. */
function sameMembers(a: Field[], b: Field[], assumed: Assumed | null): bool {
    if (a.length !== b.length) return false
    for (let i = 0; i < a.length; i++) {
        const m = a[i]
        const n = b[i]
        if (m.name !== n.name || m.readonly !== n.readonly || m.optional !== n.optional) return false
        if (!sameIn(m.type, n.type, assumed)) return false
    }
    return true
}

function optionalOf(m: InterfaceMember): bool {
    return m.k === "field" && m.optional
}

function sameTypes(a: Type[], b: Type[], assumed: Assumed | null): bool {
    if (a.length !== b.length) return false
    for (let i = 0; i < a.length; i++) if (!sameIn(a[i], b[i], assumed)) return false
    return true
}

export function sameType(a: Type, b: Type): bool {
    return sameIn(a, b, null)
}

function sameIn(a: Type, b: Type, assumed: Assumed | null): bool {
    if (a === b) return true
    if (a.kind === "literal" && b.kind === "literal") return a.value === b.value
    if (a.kind === "number-literal" && b.kind === "number-literal") return a.value === b.value
    if (a.kind === "array" && b.kind === "array") return a.template === b.template && sameIn(a.elem, b.elem, assumed)
    if (a.kind === "map" && b.kind === "map")
        return (
            a.dict === b.dict &&
            a.readonly === b.readonly &&
            sameIn(a.key, b.key, assumed) &&
            sameIn(a.value, b.value, assumed) &&
            sameMembers(a.members, b.members, assumed)
        )
    if (a.kind === "set" && b.kind === "set") return sameIn(a.elem, b.elem, assumed)
    if (a.kind === "chan" && b.kind === "chan") return sameIn(a.elem, b.elem, assumed)
    if (a.kind === "interface" && b.kind === "interface") return sameInterface(a, b, assumed)
    if (a.kind === "union" && b.kind === "union") return sameTypes(a.members, b.members, assumed)
    if (a.kind !== "func" || b.kind !== "func") return false
    if (a.required !== b.required || a.rest !== b.rest || a.construct !== b.construct) return false
    return sameTypes(a.params, b.params, assumed) && sameIn(a.result, b.result, assumed)
}

/** A union without its null, for `x?: T`. */
function withoutNullMembers(u: UnionType): string {
    const members: string[] = []
    for (const m of u.members)
        if (m.kind !== "null") members.push(m.kind === "func" ? `(${typeToString(m)})` : typeToString(m))
    return members.join(" | ")
}

/** An element of a tuple type: an optional one as `T?`, without its null. */
function tupleElementToString(f: Field): string {
    const ft = f.type
    if (!f.optional || ft.kind !== "union") return typeToString(ft)
    let count = 0
    for (const m of ft.members) if (m.kind !== "null") count++
    const inner = withoutNullMembers(ft)
    return count > 1 ? `(${inner})?` : `${inner}?`
}

export function typeToString(t: Type): string {
    switch (t.kind) {
        case "int":
            return t.name
        case "float":
            return t.name
        case "func":
            return `${t.construct ? "new " : ""}(${paramsToString(t)}) => ${typeToString(t.result)}`
        case "array":
            if (t.template) return "TemplateStringsArray"
            return `${t.readOnly ? "readonly " : ""}${t.elem.kind === "func" ? `(${typeToString(t.elem)})` : typeToString(t.elem)}[]`
        case "struct": {
            if (t.name !== null) return t.name
            if (t.tuple) return tupleToString(t)
            const fields: string[] = []
            for (const f of t.fields) {
                // The hidden field of a generic method, `#map 12`.
                if (isGenericField(f)) {
                    fields.push(`${f.name.slice(1, f.name.lastIndexOf(" "))}<...>(...)`)
                    continue
                }
                // The hidden fields of an object literal's accessors: `get x(): T` and `set x(value: T)`.
                const ft = f.type
                if (f.private && ft.kind === "func" && f.name.startsWith("get ")) {
                    fields.push(`${f.name}(): ${typeToString(ft.result)}`)
                    continue
                }
                if (f.private && ft.kind === "func" && f.name.startsWith("set ") && ft.params.length === 1) {
                    fields.push(`${f.name}(value: ${typeToString(ft.params[0])})`)
                    continue
                }
                const type = f.optional && f.type.kind === "union" ? withoutNullMembers(f.type) : typeToString(f.type)
                fields.push(`${f.readonly ? "readonly " : ""}${f.name}${f.optional ? "?" : ""}: ${type}`)
            }
            return `{ ${fields.join("; ")} }`
        }
        case "interface":
            return t.name
        case "union": {
            if (t.name !== null && t.name !== "") return t.name
            const members: string[] = []
            for (const m of t.members) members.push(m.kind === "func" ? `(${typeToString(m)})` : typeToString(m))
            return members.join(" | ")
        }
        case "literal":
            return JSON.stringify(t.value)
        case "number-literal":
            return t.value
        case "bool":
            return t.literal !== "" ? t.literal : "bool"
        case "map":
            if (t.dict && t.name !== null) return t.name
            if (t.dict && t.members.length > 0) {
                const entries: string[] = []
                for (const f of t.members) {
                    const type =
                        f.optional && f.type.kind === "union" ? withoutNullMembers(f.type) : typeToString(f.type)
                    entries.push(`${f.readonly ? "readonly " : ""}${f.name}${f.optional ? "?" : ""}: ${type}`)
                }
                entries.push(`${t.readonly ? "readonly " : ""}[key: string]: ${typeToString(t.value)}`)
                return `{ ${entries.join("; ")} }`
            }
            if (t.dict) return `{ ${t.readonly ? "readonly " : ""}[key: string]: ${typeToString(t.value)} }`
            return `Map<${typeToString(t.key)}, ${typeToString(t.value)}>`
        case "set":
            return `Set<${typeToString(t.elem)}>`
        case "chan":
            return `Chan<${typeToString(t.elem)}>`
        case "select-case":
            return "SelectCase"
        default:
            return t.kind
    }
}

/**
 * Smallest and largest value of an integer type: `[bigint, bigint]` in
 * TypeScript. `max` is a `u64`, so that it holds the maximum of `u64`.
 */
export class IntRange {
    constructor(
        readonly min: i64,
        readonly max: u64,
    ) {}
}

/** Smallest and largest value of an integer type. */
export function intRange(t: IntType): IntRange {
    const bits = u64(t.bits)
    if (t.signed) {
        const half = u64(1) << (bits - u64(1))
        return new IntRange(-i64(half - u64(1)) - 1, half - u64(1))
    }
    return new IntRange(0, bits === u64(64) ? ~u64(0) : (u64(1) << bits) - u64(1))
}

/** A stable key of a type, for interning and canonical ordering. */
export function typeKey(type: Type): string {
    switch (type.kind) {
        case "array":
            return type.template ? "TemplateStringsArray" : `${typeKey(type.elem)}[]`
        case "struct":
            return `#${type.id}`
        case "interface":
            return `@${type.id}`
        case "union":
            return type.members.map(typeKey).join("|")
        case "literal":
            return JSON.stringify(type.value)
        case "number-literal":
            return `#n${type.value}`
        case "map":
            if (type.dict) return `Dict${type.readonly ? "!" : ""}<${typeKey(type.value)}${membersKey(type.members)}>`
            return `Map<${typeKey(type.key)},${typeKey(type.value)}>`
        case "set":
            return `Set<${typeKey(type.elem)}>`
        case "chan":
            return `Chan<${typeKey(type.elem)}>`
        case "func":
            return `${type.construct ? "new" : ""}(${type.params.map(typeKey).join(",")}${type.required >= 0 ? `?${type.required}` : ""}${type.rest ? "..." : ""})=>${typeKey(type.result)}`
        default:
            return typeToString(type)
    }
}

/** The named entries of a dictionary in the key of its type: `;name:string;count?:i64`. */
export function membersKey(members: Field[]): string {
    let key = ""
    for (const f of members) key += `;${f.readonly ? "!" : ""}${f.name}${f.optional ? "?" : ""}:${typeKey(f.type)}`
    return key
}

/** Whether values of a type are references that can be null without a tag. */
export function isReference(type: Type): bool {
    const k = type.kind
    return (
        k === "struct" ||
        k === "array" ||
        k === "interface" ||
        k === "string" ||
        k === "map" ||
        k === "set" ||
        k === "func" ||
        k === "chan"
    )
}

/** Whether a type is a boolean literal type, `true` or `false`. */
export function isBoolLiteral(type: Type): bool {
    return type.kind === "bool" && type.literal !== ""
}

/** Whether values of a type are strings: `string` or a string literal type. */
export function isStringLike(type: Type): bool {
    return type.kind === "string" || type.kind === "literal"
}

/**
 * Why values of a type cannot be converted to or from JSON, if they cannot.
 * An `unknown` is written as the value it holds, which panics if that cannot
 * be, and read as an untyped value.
 */
export function jsonProblem(type: Type, seen: Set<StructType> | null = null): string | null {
    const visited = seen ?? new Set<StructType>()
    switch (type.kind) {
        case "unknown":
        case "int":
        case "float":
        case "bool":
        case "string":
        case "literal":
        case "null":
            return null
        case "array":
            // Only a tagged template makes the strings with their raw strings: JSON has an array of them.
            if (type.template) return `Type '${typeToString(type)}' cannot be converted to or from JSON.`
            return jsonProblem(type.elem, visited)
        case "map":
            if (!isStringLike(type.key))
                return `Type '${typeToString(type)}' cannot be converted to or from JSON: the keys of a Map must be strings.`
            return jsonProblem(type.value, visited)
        case "struct": {
            if (visited.has(type)) return null
            visited.add(type)
            for (const f of type.fields) {
                const problem = jsonProblem(f.type, visited)
                if (problem !== null) return problem
            }
            return null
        }
        case "union": {
            for (const m of type.members) {
                const problem = jsonProblem(m, visited)
                if (problem !== null) return problem
            }
            return null
        }
        default:
            return `Type '${typeToString(type)}' cannot be converted to or from JSON.`
    }
}

/** What JavaScript's `typeof` says of a value of a type. */
export function typeofName(type: Type): string {
    if (isNumeric(type) || type.kind === "number-literal") return "number"
    if (type.kind === "bigint") return "bigint"
    if (type.kind === "bool") return "boolean"
    if (isStringLike(type)) return "string"
    if (type.kind === "func") return "function"
    return "object"
}

/** `{ k: "strings" }`: only string literal types, as a string; the value tells the member. */
export class StringsRepr {
    readonly k: "strings" = "strings"
}

/** `{ k: "numbers" }`: only numeric literal types, as an `f64`; the value tells the member. */
export class NumbersRepr {
    readonly k: "numbers" = "numbers"
}

/** `{ k: "nullable", base }`: one reference type (or only string literals) and `null`, as the reference or null. */
export class NullableRepr {
    readonly k: "nullable" = "nullable"
    constructor(readonly base: Type) {}
}

/** `{ k: "tagged", slots }`: a tag selecting one of `slots`, with the value of that slot. `null` has a slot without a value. */
export class TaggedRepr {
    readonly k: "tagged" = "tagged"
    constructor(readonly slots: Type[]) {}
}

/**
 * How a union is represented at run time:
 * - `strings`: only string literal types, as a string; the value tells the member;
 * - `numbers`: only numeric literal types, as an `f64`; the value tells the member;
 * - `nullable`: one reference type (or only string literals) and `null`, as
 *   the reference or null;
 * - `tagged`: a tag selecting one of `slots`, with the value of that slot.
 *   `null` has a slot without a value.
 */
export type UnionRepr = StringsRepr | NumbersRepr | NullableRepr | TaggedRepr

export function unionRepr(u: UnionType): UnionRepr {
    const others: Type[] = []
    for (const m of u.members) if (m.kind !== "null") others.push(m)
    const hasNull = others.length < u.members.length
    let literals = true
    for (const m of others) if (m.kind !== "literal") literals = false
    if (literals) {
        if (hasNull) return new NullableRepr(types.string)
        return new StringsRepr()
    }
    if (!hasNull && others.every((m) => m.kind === "number-literal")) return new NumbersRepr()
    if (others.length === 1 && hasNull && isReference(others[0])) return new NullableRepr(others[0])
    return new TaggedRepr(u.members)
}

/** The members of a type: those of a union, or the type itself. */
export function membersOf(type: Type): Type[] {
    if (type.kind === "union") return type.members
    return [type]
}
