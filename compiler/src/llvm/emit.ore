// Emits an LLVM IR module for an Ore module: the layers of the emitter put
// together.

import { type Module } from "../ir/nodes"
import { type Type, classTables, unionRepr } from "../ir/types"
import { inlineCalls } from "../opt/inline"
import { planStack } from "../opt/escape"
import { valueClasses } from "../opt/values"
import { Emitter } from "./base"
import { classTable, itab } from "./collections"
import { ARRAY, EmitOptions, FN, FRAME, IFACE, MAP, STR, TYPE, UNKNOWN } from "./context"
import { coverageEntry, declareExtern, emitFunction } from "./functions"
import { findGlobals } from "./helpers"
import { functionNames } from "./inspect"
import { cString, FRAME_POINTER, globalName, sizeOf } from "./ll"
import { nameClosures } from "./names"
import { DATA_MARKER, FILE_MARKER } from "./split"

export { EmitOptions } from "./context"

/**
 * Emits an LLVM IR module for an Ore module. The runtime, written in Ore
 * (runtime/core), is part of the module, so its functions inline into the
 * program's code.
 */
export function emitModule(module: Module, options: EmitOptions | null = null): string {
    const opts = options ?? new EmitOptions(false)
    nameClosures(module)
    // Inlining loses the frames of stack traces, so debug builds keep every call.
    if (!opts.debug) inlineCalls(module)
    return emit(new Emitter(module, opts))
}

/**
 * What a global holds before its declaration runs, which a function called
 * earlier may read: the zero value of its type, `""` for a string and null
 * for a tagged union, which are not all zero bits.
 */
function zeroConstant(g: Emitter, type: Type): string {
    if (type.kind === "string") return g.str("").v
    if (type.kind === "union" && unionRepr(type).k === "tagged") {
        const at = type.members.findIndex((m) => m.kind === "null")
        if (at >= 0) return `{ i32 ${at}, [${g.unionWords(type)} x i64] zeroinitializer }`
    }
    return "zeroinitializer"
}

/** `ModuleEmitter.emit` of the TypeScript. */
export function emit(g: Emitter): string {
    const m = g.module
    const opts = g.options
    g.file = m.file
    g.defs.set(STR, `${STR} = type { ptr, i64 }`)
    g.defs.set(FN, `${FN} = type { ptr, ptr }`)
    g.defs.set(IFACE, `${IFACE} = type { ptr, ptr }`)
    g.defs.set(FRAME, `${FRAME} = type { ptr, ptr, ptr, i32 }`)
    g.defs.set(UNKNOWN, `${UNKNOWN} = type { ptr, [2 x i64] }`)
    g.defs.set(TYPE, `${TYPE} = type { ${STR}, i64, ptr, ptr, ptr, ptr, ptr }`)
    g.defs.set(ARRAY, `${ARRAY} = type { ptr, i64, i64, ptr }`)
    g.defs.set(MAP, `${MAP} = type { i64, i64, i64, ptr, ptr, ptr, i64, i64, i64, ptr, i64, ptr, ptr, ptr, i64 }`)
    g.decls.set("@ore_rt_top", "@ore_rt_top = external thread_local global ptr")
    g.decls.set("@llvm.threadlocal.address.p0", "declare ptr @llvm.threadlocal.address.p0(ptr)")
    g.values = valueClasses(m)
    g.plan = planStack(m, g.values)
    g.tables = classTables(m.structs)
    // An interface value converted to another keeps its entries under the same names.
    for (const t of m.itabs) for (const a of t.accessors) g.accessorFields.add(t.iface.members[a.index].name)
    for (const func of m.functions) {
        const attrs = func.attributes
        if (attrs === null) continue
        const runtime = attrs.runtime
        if (runtime !== null && runtime !== "") g.runtime.set(runtime, func)
    }
    const roots: string[] = []
    const globals = findGlobals(m)
    g.names.nameGlobals(globals)
    for (const local of globals) {
        g.globals.add(local)
        // The collector scans the globals that may hold pointers; a thread-local one belongs to its thread.
        const kind = local.type.kind
        if (!local.threadLocal && kind !== "int" && kind !== "float" && kind !== "bool" && !g.isValue(local.type)) {
            roots.push(`{ ptr, i64 } { ptr ${g.globalOf(local)}, i64 ${sizeOf(g.mt(local.type))} }`)
        }
        // An exported global is the definition of a C name, such as the runtime's `ore_rt_top`.
        const exportName = local.exportName
        const exported = exportName !== null && exportName !== ""
        if (exported) g.decls.delete(`@${exportName ?? ""}`)
        const linkage = exported ? "" : "internal "
        g.out.push(
            `${g.globalOf(local)} = ${linkage}${local.threadLocal ? "thread_local " : ""}global ${g.mt(local.type)} ${zeroConstant(g, local.type)}`,
        )
    }
    for (const func of m.functions) {
        if (func.extern) {
            declareExtern(g, func)
            continue
        }
        // Debug builds are split by file (llvm/split.ore), which this line
        // gives; a function without one (a method) goes with its first caller.
        const file = func.file
        const marker = opts.debug && file !== null ? `${FILE_MARKER}${file}` : ""
        if (marker !== "") g.out.push(marker)
        g.out.push(emitFunction(g, func, false))
        const counted = coverageEntry(g, func)
        if (counted !== "") g.out.push(counted)
        if (g.plan.ctorsAt.has(func)) {
            if (marker !== "") g.out.push(marker)
            g.out.push(emitFunction(g, func, true))
            const countedAt = coverageEntry(g, func)
            if (countedAt !== "") g.out.push(countedAt)
        }
    }
    // The tables after the functions, so that the runtime names its types first (see llvm/names.ore).
    for (const t of m.itabs) g.out.push(itab(g, t))
    for (const s of m.structs) if (g.tables.has(s.id)) g.out.push(classTable(g, s))
    // What depends on the whole program goes to the part with the globals.
    const data = opts.debug ? `${DATA_MARKER}\n` : ""
    let entry = `${data}define void @ore_entry() #0 {`
    for (const f of m.inits) entry += `\n  call void ${globalName(f.name)}()`
    g.out.push(`${entry}\n  ret void\n}`)
    if (g.usesFunctionNames) g.out.push(functionNames(g, data))
    // The runtime declares ore_entry to take its address; the definition is here.
    g.decls.delete("@ore_entry")
    // The table of globals for the collector's roots, read through two functions the runtime declares.
    g.out.push(`@ore.globals = internal constant [${roots.length} x { ptr, i64 }] [${roots.join(", ")}]`)
    g.out.push(`${data}define ptr @ore_globals_table() #0 {\n  ret ptr @ore.globals\n}`)
    g.out.push(`${data}define i64 @ore_globals_count() #0 {\n  ret i64 ${roots.length}\n}`)
    // The coverage table, empty unless ORE_COVERAGE=1: {counters, lines, count, file} per function.
    const entries = g.covEntries
    g.out.push(`@ore.cov = internal constant [${entries.length} x { ptr, ptr, i64, ptr }] [${entries.join(", ")}]`)
    g.out.push(`${data}define ptr @ore_cov_table() #0 {\n  ret ptr @ore.cov\n}`)
    g.out.push(`${data}define i64 @ore_cov_count() #0 {\n  ret i64 ${entries.length}\n}`)
    g.decls.delete("@ore_cov_table")
    g.decls.delete("@ore_cov_count")
    if (g.usesEntryFile) {
        const bytes = `${m.file}\u0000`
        g.out.push(`@ore.file = internal unnamed_addr constant [${bytes.length} x i8] ${cString(bytes)}`)
    }
    g.out.push(FRAME_POINTER)
    g.decls.delete("@ore_globals_table")
    g.decls.delete("@ore_globals_count")
    const lines: string[] = ["; Generated by the Ore compiler. Do not edit."]
    for (const d of g.defs.values()) lines.push(d)
    for (const d of g.decls.values()) lines.push(d)
    for (const s of g.strings.values()) lines.push(s)
    lines.push("")
    for (const h of g.helpers.values()) lines.push(h)
    lines.push("")
    for (const o of g.out) lines.push(o)
    lines.push("")
    return lines.join("\n")
}
