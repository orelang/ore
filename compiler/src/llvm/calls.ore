// Calls and closures, strings and printing, built-ins (including `unsafe` and
// inline assembly).

import { type BoundMethod, type BuiltinCall, type Call, type Closure, type Func, type StringMethod } from "../ir/nodes"
import { intRange, isNumberLiterals, type FuncType, type Type, type UnionType } from "../ir/types"
import { arrayBuiltin } from "./collections"
import { counted, json } from "./json"
import { inspectAt, inspectTop, printYellow } from "./inspect"
import { ARRAY, FN, IFACE, STR } from "./context"
import { Emitter } from "./base"
import { choose, expr, inject, payload, slotTest, unionOf } from "./expressions"
import { externType, slot } from "./functions"
import { boxed } from "./helpers"
import { cString, globalName, sizeOf, voidValue, type V } from "./ll"

/** A value to format with its type: `readonly [V, Type]` in TypeScript. */
export type Part = { v: V; t: Type }

const I64_MAX = 9223372036854775807

function operandList(args: V[]): string {
    const out: string[] = []
    for (const a of args) out.push(`${a.ty} ${a.v}`)
    return out.join(", ")
}

export function callDirect(g: Emitter, name: string, ret: string, args: V[]): V {
    const operands = operandList(args)
    if (ret === "void") {
        g.b.emit(`call void ${globalName(name)}(${operands})`)
        return voidValue
    }
    return g.b.value(ret, `call ${ret} ${globalName(name)}(${operands})`)
}

export function callIndirect(g: Emitter, fn: string, ret: string, args: V[]): V {
    const operands = operandList(args)
    if (ret === "void") {
        g.b.emit(`call void ${fn}(${operands})`)
        return voidValue
    }
    return g.b.value(ret, `call ${ret} ${fn}(${operands})`)
}

export function call(g: Emitter, e: Call): V {
    const func = e.func
    if (func.extern) {
        // Strings cross into C as NUL-terminated copies, and come back copied.
        const args: string[] = []
        for (let i = 0; i < e.args.length; i++) {
            const v = expr(g, e.args[i])
            // Arguments past the fixed parameters of a variadic function, already promoted.
            if (i >= func.params.length) {
                const variadic = func.variadic
                args.push(`${variadic !== null ? g.lt(variadic) : "undefined"} ${v.v}`)
                continue
            }
            const t = func.params[i].type
            if (t.kind === "string") args.push(`ptr ${g.rt("ore_rt_cstring", [v]).v}`)
            else args.push(`${externType(g, t, true)} ${v.v}`)
        }
        const result = func.type.result
        const ret = externType(g, result, false)
        // A variadic call names the function's type, so that LLVM passes the arguments as the platform's C does.
        let callee = `@${func.name}`
        if (func.variadic !== null) {
            const types: string[] = []
            for (const p of func.params) types.push(externType(g, p.type, true))
            types.push("...")
            callee = `(${types.join(", ")}) @${func.name}`
        }
        if (ret === "void") {
            g.b.emit(`call void ${callee}(${args.join(", ")})`)
            return voidValue
        }
        const words = ret.split(" ")
        const v = g.b.value(words[words.length - 1], `call ${ret} ${callee}(${args.join(", ")})`)
        return result.kind === "string" ? g.rt("ore_rt_from_cstring", [v]) : v
    }
    const args: V[] = []
    for (const a of e.args) args.push(expr(g, a))
    if (g.slots.has(e)) {
        const s = slot(g, e) ?? ""
        const all: V[] = [{ ty: "ptr", v: s }]
        for (const a of args) all.push(a)
        return callDirect(g, `${func.name}_at`, g.lt(e.type), all)
    }
    return callDirect(g, func.name, g.lt(e.type), args)
}

/** Calls a closure value with the first arguments its type takes. */
export function callClosure(g: Emitter, f: V, type: FuncType, args: V[]): V {
    const fn = g.extract(f, 0, "ptr")
    const env = g.extract(f, 1, "ptr")
    const all: V[] = [env]
    for (let i = 0; i < args.length && i < type.params.length; i++) all.push(args[i])
    return callIndirect(g, fn.v, g.lt(type.result), all)
}

export function closure(g: Emitter, e: Closure): V {
    const captures = e.func.captures ?? []
    const fn: V = { ty: "ptr", v: globalName(e.func.name) }
    nameFunction(g, fn.v, e.func.sourceName)
    if (captures.length === 0) return g.aggregate(FN, [fn, { ty: "ptr", v: "null" }])
    const env = g.envType(e.func)
    const ptr = slot(g, e) ?? g.alloc(env).v
    for (let i = 0; i < captures.length; i++) {
        const c = captures[i]
        const field = g.field(ptr, env, i)
        if (boxed(c)) g.b.emit(`store ptr ${g.boxOf(c).v}, ptr ${field}`)
        else g.store(g.read(c), field, c.type)
    }
    return g.aggregate(FN, [fn, { ty: "ptr", v: ptr }])
}

/** Records the name of a function used as a value, the last part of `outer.inner`, for console.log; lambdas have none. */
function nameFunction(g: Emitter, fn: string, sourceName: string) {
    const name = sourceName.slice(sourceName.lastIndexOf(".") + 1)
    if (name !== "<lambda>" && name !== "") g.functionNames.set(fn, name)
}

/** A function taking an unused environment that calls a top-level function, for function values. */
export function thunk(g: Emitter, func: Func): string {
    const name = globalName(`${func.name}.thunk`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    nameFunction(g, name, func.sourceName)
    const params: string[] = ["ptr %env"]
    for (let i = 0; i < func.params.length; i++) params.push(`${g.lt(func.params[i].type)} %a${i}`)
    const ret = g.lt(func.type.result)
    helper(g, name, `define internal ${ret} ${name}(${params.join(", ")})`, (e) => {
        const args: V[] = []
        for (let i = 0; i < func.params.length; i++) args.push({ ty: e.lt(func.params[i].type), v: `%a${i}` })
        const r = callDirect(e, func.name, ret, args)
        e.b.terminate(ret === "void" ? "ret void" : `ret ${ret} ${r.v}`)
    })
    return name
}

/**
 * A function with the signature of a method that calls the method in the
 * class table of its receiver, for interface tables of a class whose
 * method a subclass overrides.
 */
export function virtualThunk(g: Emitter, func: Func): string {
    const name = globalName(`${func.name}.virtual`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const params: string[] = ["ptr %this"]
    for (let i = 0; i < func.params.length; i++) params.push(`${g.lt(func.params[i].type)} %a${i}`)
    const ret = g.lt(func.type.result)
    helper(g, name, `define internal ${ret} ${name}(${params.join(", ")})`, (e) => {
        const self: V = { ty: "ptr", v: "%this" }
        const args: V[] = [self]
        for (let i = 0; i < func.params.length; i++) args.push({ ty: e.lt(func.params[i].type), v: `%a${i}` })
        const r = callIndirect(e, e.virtualMethod(self, func).v, ret, args)
        e.b.terminate(ret === "void" ? "ret void" : `ret ${ret} ${r.v}`)
    })
    return name
}

/** A method bound to its receiver: the environment holds the receiver, a thunk calls the method. */
export function bound(g: Emitter, e: BoundMethod): V {
    const type = e.type
    const receiverType = g.lt(e.receiver.type)
    const method = e.func
    const known = e.index
    const index = known ?? 0
    const name =
        method !== null
            ? globalName(`${method.name}.${e.virtual ? "vbound" : "bound"}`)
            : globalName(`iface.bound.${g.names.key(type)}.${known !== null ? `${known}` : "undefined"}`)
    if (!g.helpers.has(name)) {
        g.helpers.set(name, "")
        const params: string[] = ["ptr %env"]
        for (let i = 0; i < type.params.length; i++) params.push(`${g.lt(type.params[i])} %a${i}`)
        const ret = g.lt(type.result)
        helper(g, name, `define internal ${ret} ${name}(${params.join(", ")})`, (x) => {
            const args: V[] = []
            for (let i = 0; i < type.params.length; i++) args.push({ ty: x.lt(type.params[i]), v: `%a${i}` })
            const self = x.b.value(receiverType, `load ${receiverType}, ptr %env`)
            let r: V
            if (method !== null && e.virtual) {
                const all: V[] = [self]
                for (const a of args) all.push(a)
                r = callIndirect(x, x.virtualMethod(self, method).v, ret, all)
            } else if (method !== null) {
                const all: V[] = [self]
                for (const a of args) all.push(a)
                r = callDirect(x, method.name, ret, all)
            } else {
                const itab = x.extract(self, 1, "ptr")
                const fn = x.b.value(
                    "ptr",
                    `load ptr, ptr ${x.b.value("ptr", `getelementptr ptr, ptr ${itab.v}, i64 ${index + 1}`).v}`,
                )
                const all: V[] = [x.extract(self, 0, "ptr")]
                for (const a of args) all.push(a)
                r = callIndirect(x, fn.v, ret, all)
            }
            x.b.terminate(ret === "void" ? "ret void" : `ret ${ret} ${r.v}`)
        })
    }
    const receiver = expr(g, e.receiver)
    const env = g.alloc(receiverType)
    g.b.emit(`store ${receiverType} ${receiver.v}, ptr ${env.v}`)
    return g.aggregate(FN, [{ ty: "ptr", v: name }, env])
}

/** Emits a helper function with its own builder, as if it were a function of the module. */
export function helper(g: Emitter, name: string, header: string, body: (e: Emitter) => void) {
    const saved = g.save()
    body(g)
    g.helpers.set(name, g.b.finish(header, "unreachable"))
    g.restore(saved)
}

/** Formats values as strings, like `print` does, and concatenates them. */
export function concat(g: Emitter, parts: Part[]): V {
    const strings: V[] = []
    for (const p of parts) strings.push(toStr(g, p.v, p.t))
    if (strings.length === 0) return g.str("")
    if (strings.length === 1) return strings[0]
    const array = g.b.alloca(`[${strings.length} x ${STR}]`)
    for (let i = 0; i < strings.length; i++)
        g.b.emit(
            `store ${STR} ${strings[i].v}, ptr ${g.b.value("ptr", `getelementptr ${STR}, ptr ${array}, i64 ${i}`).v}`,
        )
    return g.rt("ore_rt_str_concat", [g.i64(strings.length), { ty: "ptr", v: array }])
}

export function toStr(g: Emitter, v: V, t: Type): V {
    if (isNumberLiterals(t)) return g.rt("ore_rt_str_from_f64", [v])
    if (t.kind === "union") return g.b.value(STR, `call ${STR} ${unionToStr(g, t)}(${v.ty} ${v.v})`)
    switch (t.kind) {
        case "string":
            return v
        case "literal":
            return v
        case "int":
            return t.signed
                ? g.rt("ore_rt_str_from_i64", [g.toI64(v)])
                : g.rt("ore_rt_str_from_u64", [g.toI64(v, false)])
        case "float":
            return g.rt(`ore_rt_str_from_${t.name}`, [v])
        case "bool":
            return g.rt("ore_rt_str_from_bool", [v])
        case "bigint":
            return g.rt("ore_rt_big_to_string", [v, g.i64(10)])
        default:
            process.panic(`cannot format ${t.kind}`)
    }
}

/** The function formatting a value of a union, the first member that matches: `@ore.tostr.<union>`. */
export function unionToStr(g: Emitter, t: UnionType): string {
    const name = globalName(`ore.tostr.${g.names.union(t)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const uty = g.lt(t)
    helper(g, name, `define internal ${STR} ${name}(${uty} %v)`, (e) => {
        const v: V = { ty: uty, v: "%v" }
        const end = e.b.label("tostr")
        for (let i = 0; i < t.members.length; i++) {
            const m = t.members[i]
            const here = e.b.label("smember")
            const next = e.b.label("snext")
            e.b.condBr(slotTest(e, t, v, i), here, next)
            e.b.start(here)
            const s = m.kind === "null" ? e.str("null") : toStr(e, payload(e, t, v, i), m)
            e.b.terminate(`ret ${STR} ${s.v}`)
            e.b.start(next)
        }
        e.b.start(end)
        e.b.terminate(`ret ${STR} ${e.str("").v}`)
    })
    return name
}

/** Prints a value as console.log does: strings as they are, other values as Node's util.inspect formats them, numbers and booleans yellow when the output shows colors. */
export function print(g: Emitter, v: V, t: Type) {
    switch (t.kind) {
        case "int": {
            const signed = t.signed
            printYellow(g, () => {
                if (signed) g.rt("ore_rt_print_i64", [g.toI64(v)])
                else g.rt("ore_rt_print_u64", [g.toI64(v, false)])
            })
            return
        }
        case "bool":
            printYellow(g, () => {
                g.rt("ore_rt_print_bool", [v])
            })
            return
        case "bigint":
            // As Node prints a bigint: with its suffix.
            printYellow(g, () => {
                g.rt("ore_rt_print_string", [g.rt("ore_rt_big_to_string", [v, g.i64(10)])])
                g.rt("ore_rt_print_string", [g.str("n")])
            })
            return
        default:
            g.rt("ore_rt_print_string", [inspectTop(g, v, t)])
    }
}

const libm = [
    "sqrt",
    "pow",
    "exp",
    "log",
    "log2",
    "log10",
    "sin",
    "cos",
    "tan",
    "asin",
    "acos",
    "atan",
    "atan2",
    "hypot",
    "floor",
    "ceil",
    "trunc",
]

/** The start of `Math.max` (or `Math.min`) over no values: -Infinity (Infinity), or the integer type's extreme. */
function identity(max: bool, t: Type): string {
    if (t.kind === "float") return max ? "0xFFF0000000000000" : "0x7FF0000000000000"
    if (t.kind !== "int") return "0"
    const range = intRange(t)
    if (t.signed) return max ? `${range.min}` : `${range.max}`
    // All ones: the largest unsigned value.
    return max ? "0" : "-1"
}

export function builtin(g: Emitter, e: BuiltinCall): V {
    const name = e.name
    if (name === "console.log" || name === "console.error" || name === "console.write") {
        const values: V[] = []
        for (const a of e.args) values.push(expr(g, a))
        if (name === "console.error") g.rt("ore_rt_print_to", [g.i64(2)])
        const spread = e.spread
        if (spread === null) {
            for (let i = 0; i < values.length; i++) {
                if (i > 0) g.rt("ore_rt_print_space", [])
                print(g, values[i], e.args[i].type)
            }
        } else {
            // A space before every value but the first printed, which a spread empty array leaves unknown until run time.
            const first = g.b.alloca("i1")
            g.b.emit(`store i1 true, ptr ${first}`)
            const one = (v: V, type: Type) => {
                const space = g.b.label("space")
                const after = g.b.label("printed")
                g.b.condBr(g.b.value("i1", `load i1, ptr ${first}`), after, space)
                g.b.start(space)
                g.rt("ore_rt_print_space", [])
                g.b.br(after)
                g.b.start(after)
                g.b.emit(`store i1 false, ptr ${first}`)
                print(g, v, type)
            }
            for (let i = 0; i < values.length; i++) {
                const at = e.args[i].type
                if (!spread[i] || at.kind !== "array") {
                    one(values[i], at)
                    continue
                }
                const elem = at.elem
                const array = values[i]
                const n = g.b.value("i64", `load i64, ptr ${g.field(array.v, ARRAY, 1)}`)
                counted(g, n, (k) => {
                    const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
                    const place = g.b.value("ptr", `getelementptr ${g.mt(elem)}, ptr ${data.v}, i64 ${k.v}`)
                    one(g.load(place.v, elem), elem)
                })
            }
        }
        if (name !== "console.write") g.rt("ore_rt_print_newline", [])
        if (name === "console.error") g.rt("ore_rt_print_to", [g.i64(1)])
        return voidValue
    }
    if (name === "JSON.stringify" || name === "JSON.parse") return json(g, e)
    if (name === "Array.new" || name === "Array.fromLength") return arrayBuiltin(g, e)
    if (name.startsWith("unsafe.")) return unsafeCall(g, e)
    const a: V[] = []
    for (const x of e.args) a.push(expr(g, x))
    const ty = g.lt(e.type)
    if (name.startsWith("Math.") && libm.includes(name.slice(5))) {
        const f = `@${name.slice(5)}`
        const params: string[] = []
        const args: string[] = []
        for (const x of a) {
            params.push("double")
            args.push(`double ${x.v}`)
        }
        g.decls.set(f, `declare double ${f}(${params.join(", ")})`)
        return g.b.value("double", `call double ${f}(${args.join(", ")})`)
    }
    const t = e.type
    switch (name) {
        case "process.panic":
            g.rt("ore_rt_panic", [a[0]])
            g.b.terminate("unreachable")
            return voidValue
        case "process.exit":
            g.rt("ore_rt_exit", [a[0]])
            g.b.terminate("unreachable")
            return voidValue
        case "Math.abs":
            if (t.kind === "float") {
                g.decls.set("@llvm.fabs.f64", "declare double @llvm.fabs.f64(double)")
                g.decls.set("@llvm.fabs.f32", "declare float @llvm.fabs.f32(float)")
                return g.b.value(ty, `call ${ty} @llvm.fabs.${ty === "float" ? "f32" : "f64"}(${ty} ${a[0].v})`)
            }
            return g.b.value(
                ty,
                `select i1 ${g.b.value("i1", `icmp slt ${ty} ${a[0].v}, 0`).v}, ${ty} ${g.b.value(ty, `sub ${ty} 0, ${a[0].v}`).v}, ${ty} ${a[0].v}`,
            )
        case "Math.min":
        case "Math.max": {
            const isFloat = t.kind === "float"
            const signed = t.kind === "int" && t.signed
            let pick: string
            if (name === "Math.min") pick = isFloat ? "olt" : signed ? "slt" : "ult"
            else pick = isFloat ? "ogt" : signed ? "sgt" : "ugt"
            // `y < x ? y : x`, with NaN if either is NaN.
            const better = (x: V, y: V): V => {
                const yWins = g.b.value("i1", `${isFloat ? "fcmp" : "icmp"} ${pick} ${ty} ${y.v}, ${x.v}`)
                let r = g.b.value(ty, `select i1 ${yWins.v}, ${ty} ${y.v}, ${ty} ${x.v}`)
                if (isFloat) {
                    const nan = g.b.value("i1", `fcmp uno ${ty} ${x.v}, ${y.v}`)
                    r = g.b.value(ty, `select i1 ${nan.v}, ${ty} 0x7FF8000000000000, ${ty} ${r.v}`)
                }
                return r
            }
            const spread = e.spread
            if (spread === null) {
                let r = a[0]
                for (let i = 1; i < a.length; i++) r = better(r, a[i])
                return r
            }
            // From the identity (an infinity, or the extreme of the integer type), through every value and element.
            const acc = g.b.alloca(ty)
            g.b.emit(`store ${ty} ${identity(name === "Math.max", t)}, ptr ${acc}`)
            const fold = (v: V) => {
                g.b.emit(`store ${ty} ${better(g.b.value(ty, `load ${ty}, ptr ${acc}`), v).v}, ptr ${acc}`)
            }
            for (let i = 0; i < a.length; i++) {
                if (!spread[i]) {
                    fold(a[i])
                    continue
                }
                const array = a[i]
                const n = g.b.value("i64", `load i64, ptr ${g.field(array.v, ARRAY, 1)}`)
                counted(g, n, (k) => {
                    const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
                    fold(g.load(g.b.value("ptr", `getelementptr ${ty}, ptr ${data.v}, i64 ${k.v}`).v, t))
                })
            }
            return g.b.value(ty, `load ${ty}, ptr ${acc}`)
        }
        case "Math.round":
            return g.rt("ore_rt_round", [a[0]])
        case "Math.cbrt":
            return g.rt("ore_rt_cbrt", [a[0]])
        case "Math.sign": {
            const x = a[0]
            const pos = g.b.value("i1", `fcmp ogt double ${x.v}, 0.0`)
            const neg = g.b.value("i1", `fcmp olt double ${x.v}, 0.0`)
            const r = g.b.value("double", `select i1 ${neg.v}, double -1.0, double ${x.v}`)
            return g.b.value("double", `select i1 ${pos.v}, double 1.0, double ${r.v}`)
        }
        case "Math.random":
            return g.rt("ore_rt_random", [])
        case "BigInt.toString":
            return g.rt("ore_rt_big_to_string", [a[0], a[1]])
        case "BigInt.fromString":
            return g.rt("ore_rt_big_from_string", [a[0]])
        case "Number.toFixed":
            return g.rt("ore_rt_str_fixed", [a[0], a[1]])
        case "Number.parseInt":
        case "Number.parseFloat": {
            const isInt = name === "Number.parseInt"
            const out = g.b.alloca(isInt ? "i64" : "double")
            const ok = isInt
                ? g.rtBool("ore_rt_parse_int", [a[0], a.length > 1 ? a[1] : g.i64(0), { ty: "ptr", v: out }])
                : g.rtBool("ore_rt_parse_float", [a[0], { ty: "ptr", v: out }])
            const u = unionOf(e.type)
            return choose(
                g,
                ok,
                () =>
                    inject(
                        g,
                        u,
                        memberWhere(u, false),
                        g.b.value(isInt ? "i64" : "double", `load ${isInt ? "i64" : "double"}, ptr ${out}`),
                    ),
                () => inject(g, u, memberWhere(u, true), null),
                ty,
            )
        }
        case "fs.readFile":
            return fallible(g, e, (out) => g.rtBool("ore_rt_read_file", [a[0], out]), true)
        case "fs.writeFile":
            return fallible(g, e, (out) => g.rtBool("ore_rt_write_file", [a[0], a[1], out]), false)
        case "fs.read":
            return fallible(g, e, (out) => g.rtBool("ore_rt_fd_read", [a[0], a[1], out]), true)
        case "fs.write":
            return fallible(g, e, (out) => g.rtBool("ore_rt_fd_write", [a[0], a[1], out]), false)
        case "fs.exists":
            return g.rtBool("ore_rt_file_exists", [a[0]])
        case "Date.now":
            return g.rt("ore_rt_now", [])
        case "process.args":
            return g.rt("ore_rt_args", [])
        case "process.getenv":
            return g.rt("ore_rt_getenv", [a[0]])
        case "process.cwd":
            return g.rt("ore_rt_cwd", [])
        case "internal.catchPanic":
            return g.rt("ore_rt_catch_panic", [a[0]])
        case "internal.countTest":
            g.rt("ore_rt_count_test", [a[0]])
            return voidValue
        case "internal.inMainTask":
            return g.rtBool("ore_rt_in_main_task", [])
        case "internal.atMainEnd":
            g.rt("ore_rt_at_main_end", [a[0]])
            return voidValue
        case "internal.inspect":
            return inspectAt(g, a[0], e.args[0].type, g.rt("ore_rt_inspect_plain", [a[1]]), g.i64(0))
        case "internal.netListen":
            return fallibleValue(g, e, (v, m) => g.rtBool("ore_rt_net_listen", [a[0], a[1], v, m]))
        case "internal.netConnect":
            return fallibleValue(g, e, (v, m) => g.rtBool("ore_rt_net_connect", [a[0], a[1], v, m]))
        case "internal.netAccept":
            return fallibleValue(g, e, (v, m) => g.rtBool("ore_rt_net_accept", [a[0], v, m]))
        case "internal.netRead":
            return fallible(g, e, (out) => g.rtBool("ore_rt_net_read", [a[0], a[1], out]), true)
        case "internal.netWrite":
            return fallible(g, e, (out) => g.rtBool("ore_rt_net_write", [a[0], a[1], out]), false)
        case "internal.netClose":
            g.rt("ore_rt_net_close", [a[0]])
            return voidValue
        case "internal.netPort":
            return g.rt("ore_rt_net_port", [a[0]])
        case "task.spawn":
            g.rt("ore_rt_spawn", [a[0]])
            return voidValue
        case "task.sleep":
            g.rt("ore_rt_sleep", [a[0]])
            return voidValue
        case "task.yield":
            g.rt("ore_rt_yield", [])
            return voidValue
        case "task.after":
            return g.rt("ore_rt_case_after", [a[0], a[1]])
        case "task.select":
            g.rt("ore_rt_select", [a[0], a.length > 1 ? a[1] : { ty: FN, v: "zeroinitializer" }])
            return voidValue
    }
    process.panic(`no built-in ${name}`)
}

/** The member of a union that is `null` (`isNull`), or the first that is not. */
function memberWhere(u: UnionType, isNull: bool): int {
    for (let i = 0; i < u.members.length; i++) if ((u.members[i].kind === "null") === isNull) return i
    return -1
}

/** The first member of a union that is (or is not) an interface. */
function ifaceMember(u: UnionType, isIface: bool): int {
    for (let i = 0; i < u.members.length; i++) if ((u.members[i].kind === "interface") === isIface) return i
    return -1
}

/** The functions of `unsafe`: plain LLVM instructions and intrinsics. `unsafe` of the TypeScript, a namespace in Ore. */
export function unsafeCall(g: Emitter, e: BuiltinCall): V {
    const name = e.name.slice("unsafe.".length)
    if (name === "asm") return inlineAsm(g, e)
    if (name === "functionAddress") {
        const f = e.args[0]
        if (f.k !== "func-ref") process.panic("unsafe.functionAddress of a value that is not a function")
        return { ty: "ptr", v: globalName(f.func.name) }
    }
    const a: V[] = []
    for (const x of e.args) a.push(expr(g, x))
    const typeArgs = e.typeArgs
    const T = typeArgs !== null && typeArgs.length > 0 ? typeArgs[0] : null
    const mt = T !== null ? g.mt(T) : ""
    // Atomic accesses need an explicit alignment: the natural one of integers and pointers.
    const align = T !== null && T.kind === "int" ? Math.max(1, T.bits / 8) : 8
    const intrinsic = (decl: string) => {
        g.decls.set(decl.slice(decl.indexOf("@"), decl.indexOf("(")), decl)
    }
    switch (name) {
        case "sizeOf":
            return { ty: "i64", v: sizeOf(mt) }
        case "alignOf":
            return { ty: "i64", v: `ptrtoint (ptr getelementptr ({ i8, ${mt} }, ptr null, i32 0, i32 1) to i64)` }
        case "add":
            return g.b.value("ptr", `getelementptr i8, ptr ${a[0].v}, i64 ${a[1].v}`)
        case "diff": {
            const x = g.b.value("i64", `ptrtoint ptr ${a[0].v} to i64`)
            const y = g.b.value("i64", `ptrtoint ptr ${a[1].v} to i64`)
            return g.b.value("i64", `sub i64 ${x.v}, ${y.v}`)
        }
        case "toInt":
            return g.b.value("i64", `ptrtoint ptr ${a[0].v} to i64`)
        case "fromInt":
            return g.b.value("ptr", `inttoptr i64 ${a[0].v} to ptr`)
        case "bitcast":
            return a[0].ty === mt ? { ty: mt, v: a[0].v } : g.b.value(mt, `bitcast ${a[0].ty} ${a[0].v} to ${mt}`)
        case "load":
            if (T === null) process.panic("unsafe.load without a type")
            return g.load(a[0].v, T)
        case "store":
            if (T === null) process.panic("unsafe.store without a type")
            g.store(a[1], a[0].v, T)
            return voidValue
        case "alloc":
            return g.rt("ore_rt_alloc", [a[0]])
        case "allocBytes":
            return g.rt("ore_rt_alloc_bytes", [a[0]])
        case "copy":
            g.writeBarrierRange(a[0], a[2])
            intrinsic("declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
            g.b.emit(`call void @llvm.memmove.p0.p0.i64(ptr ${a[0].v}, ptr ${a[1].v}, i64 ${a[2].v}, i1 false)`)
            return voidValue
        case "fill":
            g.writeBarrierRange(a[0], a[2])
            intrinsic("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)")
            g.b.emit(`call void @llvm.memset.p0.i64(ptr ${a[0].v}, i8 ${a[1].v}, i64 ${a[2].v}, i1 false)`)
            return voidValue
        case "compare": {
            intrinsic("declare i32 @memcmp(ptr, ptr, i64)")
            const r = g.b.value("i32", `call i32 @memcmp(ptr ${a[0].v}, ptr ${a[1].v}, i64 ${a[2].v})`)
            return g.b.value("i64", `sext i32 ${r.v} to i64`)
        }
        case "addressOf":
            return { ty: "ptr", v: a[0].v }
        case "fromAddress":
            return { ty: "ptr", v: a[0].v }
        case "stringData":
            return g.extract(a[0], 0, "ptr")
        case "makeString":
            return g.aggregate(STR, [a[0], a[1]])
        case "atomicLoad":
            return g.b.value(mt, `load atomic ${mt}, ptr ${a[0].v} seq_cst, align ${align}`)
        case "atomicStore":
            g.writeBarrier(a[0].v, mt)
            g.b.emit(`store atomic ${mt} ${a[1].v}, ptr ${a[0].v} seq_cst, align ${align}`)
            return voidValue
        case "atomicAdd":
        case "atomicSub":
        case "atomicAnd":
        case "atomicOr":
        case "atomicXor":
        case "atomicExchange": {
            if (name === "atomicExchange") g.writeBarrier(a[0].v, mt)
            const op = name === "atomicExchange" ? "xchg" : name.slice("atomic".length).toLowerCase()
            return g.b.value(mt, `atomicrmw ${op} ptr ${a[0].v}, ${mt} ${a[1].v} seq_cst, align ${align}`)
        }
        case "atomicCompareExchange": {
            g.writeBarrier(a[0].v, mt)
            const pair = g.b.value(
                `{ ${mt}, i1 }`,
                `cmpxchg ptr ${a[0].v}, ${mt} ${a[1].v}, ${mt} ${a[2].v} seq_cst seq_cst, align ${align}`,
            )
            return g.extract(pair, 1, "i1")
        }
        case "signalFence":
            g.b.emit(`fence syncscope("singlethread") seq_cst`)
            return voidValue
        case "fence":
            g.b.emit("fence seq_cst")
            return voidValue
    }
    process.panic(`no built-in ${e.name}`)
}

/** The value of a string literal argument. */
function literal(e: BuiltinCall, i: int): string {
    const x = e.args[i]
    if (x.k !== "string") process.panic(`argument ${i} of ${e.name} is not a string literal`)
    return x.value
}

/** `unsafe.asm<T>(template, constraints, ...operands)`: an LLVM inline assembly call with side effects. */
export function inlineAsm(g: Emitter, e: BuiltinCall): V {
    const template = literal(e, 0)
    const constraints = literal(e, 1)
    const operands: V[] = []
    for (let i = 2; i < e.args.length; i++) operands.push(expr(g, e.args[i]))
    const ty = g.lt(e.type)
    const asm = `call ${ty} asm sideeffect ${cString(template).slice(1)}, ${cString(constraints).slice(1)}(${operandList(operands)})`
    if (ty === "void") {
        g.b.emit(asm)
        return voidValue
    }
    return g.b.value(ty, asm)
}

/** A new Error with a message, as an interface value. */
export function error(g: Emitter, e: BuiltinCall, message: V): V {
    const err = e.error
    if (err === null) process.panic(`${e.name} without an error constructor`)
    const object = callDirect(g, err.ctor.name, "ptr", [message])
    return g.aggregate(IFACE, [object, { ty: "ptr", v: g.names.itab(err.itab.id, err.itab.struct, err.itab.iface) }])
}

/**
 * A `T | Error` (or `Error | null`) from a runtime call storing the value or
 * the error message in its out parameter. `withValue` is whether there is a
 * value (`valueType` in TypeScript, always `STR`).
 */
export function fallible(g: Emitter, e: BuiltinCall, run: (out: V) => V, withValue: bool): V {
    const u = unionOf(e.type)
    const out = g.b.alloca(STR)
    const ok = run({ ty: "ptr", v: out })
    const message = g.b.value(STR, `load ${STR}, ptr ${out}`)
    const errorIndex = ifaceMember(u, true)
    return choose(
        g,
        ok,
        () => (withValue ? inject(g, u, ifaceMember(u, false), message) : inject(g, u, memberWhere(u, true), null)),
        () => inject(g, u, errorIndex, error(g, e, message)),
        g.lt(u),
    )
}

/** A `T | Error` from a runtime call storing the value or the message in two out parameters. */
export function fallibleValue(g: Emitter, e: BuiltinCall, run: (value: V, message: V) => V): V {
    const u = unionOf(e.type)
    const value = g.b.alloca("i64")
    const message = g.b.alloca(STR)
    const ok = run({ ty: "ptr", v: value }, { ty: "ptr", v: message })
    return choose(
        g,
        ok,
        () => inject(g, u, ifaceMember(u, false), g.b.value("i64", `load i64, ptr ${value}`)),
        () => inject(g, u, ifaceMember(u, true), error(g, e, g.b.value(STR, `load ${STR}, ptr ${message}`))),
        g.lt(u),
    )
}

export function stringMethod(g: Emitter, e: StringMethod): V {
    const s = expr(g, e.value)
    const a: V[] = []
    for (const x of e.args) a.push(expr(g, x))
    const space = g.str(" ")
    const yes: V = { ty: "i1", v: "true" }
    const no: V = { ty: "i1", v: "false" }
    switch (e.method) {
        case "indexOf":
            return g.rt("ore_rt_str_index_of", [s, a[0], a.length > 1 ? a[1] : g.i64(0)])
        case "lastIndexOf":
            return g.rt("ore_rt_str_last_index_of", [s, a[0]])
        case "includes":
            return g.b.value("i1", `icmp ne i64 ${g.rt("ore_rt_str_index_of", [s, a[0], g.i64(0)]).v}, -1`)
        case "startsWith":
            return g.rtBool("ore_rt_str_starts_with", [s, a[0]])
        case "endsWith":
            return g.rtBool("ore_rt_str_ends_with", [s, a[0]])
        case "split":
            return g.rt("ore_rt_str_split", [s, a[0]])
        case "trim":
            return g.rt("ore_rt_str_trim", [s, g.i64(3)])
        case "trimStart":
            return g.rt("ore_rt_str_trim", [s, g.i64(1)])
        case "trimEnd":
            return g.rt("ore_rt_str_trim", [s, g.i64(2)])
        case "toUpperCase":
            return g.rt("ore_rt_str_case", [s, yes])
        case "toLowerCase":
            return g.rt("ore_rt_str_case", [s, no])
        case "replace":
            return g.rt("ore_rt_str_replace", [s, a[0], a[1], no])
        case "replaceAll":
            return g.rt("ore_rt_str_replace", [s, a[0], a[1], yes])
        case "repeat":
            return g.rt("ore_rt_str_repeat", [s, a[0]])
        case "padStart":
            return g.rt("ore_rt_str_pad", [s, a[0], a.length > 1 ? a[1] : space, yes])
        case "padEnd":
            return g.rt("ore_rt_str_pad", [s, a[0], a.length > 1 ? a[1] : space, no])
        case "codePointAt":
            return g.rt("ore_rt_str_code_point_at", [s, a[0]])
        default:
            return g.rt("ore_rt_str_substring", [s, a[0], a.length > 1 ? a[1] : g.i64(I64_MAX)])
    }
}
