// Pure functions of the emitter.

import { type Local, type Module, type Stmt } from "../ir/nodes"
import { sameType, type StructType, type Type, type UnionType } from "../ir/types"

/** Whether a local lives in a box: captured by a closure and assigned after its declaration. */
export function boxed(local: Local): bool {
    return local.captured && local.assigned
}

/** Variables declared at the top level of modules: directly in their top-level code, or after a `using` there. */
export function findGlobals(module: Module): Local[] {
    const found: Local[] = []
    for (const init of module.inits) visitGlobals(init.body.body, found)
    return found
}

function visitGlobals(stmts: Stmt[], found: Local[]) {
    for (const s of stmts) {
        if (s.k === "let" && s.local.global) found.push(s.local)
        if (s.k === "using") {
            if (s.local.global) found.push(s.local)
            visitGlobals(s.body, found)
        }
    }
}

/** The member of a union that is the nearest base class of a class, or -1. */
function baseIndex(u: UnionType, s: StructType): int {
    const base = s.base
    if (base === null) return -1
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        if (m.kind === "struct" && m === base) return i
    }
    return baseIndex(u, base)
}

/**
 * The member of a union that holds values of a type; a string literal also
 * fits `string`, a numeric literal `number`, and an instance of a class its
 * base class.
 */
export function memberIndex(u: UnionType, type: Type): int {
    for (let i = 0; i < u.members.length; i++) if (sameType(u.members[i], type)) return i
    if (type.kind === "struct") return baseIndex(u, type)
    if (type.kind === "number-literal") {
        for (let i = 0; i < u.members.length; i++) {
            const m = u.members[i]
            if (m.kind === "float" && m.bits === 64) return i
        }
    }
    if (type.kind !== "literal") return -1
    for (let i = 0; i < u.members.length; i++) if (u.members[i].kind === "string") return i
    return -1
}
