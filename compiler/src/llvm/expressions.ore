// Expressions and unions.

import {
    type ArithOp,
    type Assign,
    type CompareOp,
    type ElementLValue,
    type Expr,
    type FieldLValue,
    type IfaceFieldLValue,
    type IncDec,
    type Logical,
    type Optional,
    type UnionField,
    type UnionFieldLValue,
} from "../ir/nodes"
import {
    findField,
    isStringLike,
    isSubclass,
    sameType,
    typeofName,
    typeToString,
    types,
    unionRepr,
    type FloatType,
    type IntType,
    type StructType,
    type Type,
    type UnionType,
} from "../ir/types"
import { arrayMethod, chanOp, mapOp, setOp } from "./collections"
import { ARRAY, DIVIDE_BY_ZERO, FN, IFACE, STR } from "./context"
import { Emitter } from "./base"
import { body } from "./functions"
import {
    bound,
    builtin,
    call,
    callClosure,
    callDirect,
    callIndirect,
    closure,
    concat,
    helper,
    stringMethod,
    thunk,
    type Part,
} from "./calls"
import { memberIndex } from "./helpers"
import { floatConstant, globalName, sizeOf, voidValue, type V } from "./ll"
import { fnvHex } from "./names"
import { slot } from "./functions"

/** A place other than a local: `Exclude<ir.LValue, { k: "local" }>` in TypeScript. */
export type Place = ElementLValue | FieldLValue | IfaceFieldLValue | UnionFieldLValue

const I64_MAX = 9223372036854775807

/** The struct type of an expression known to have one. */
export function structOf(t: Type): StructType {
    if (t.kind === "struct") return t
    process.panic(`expected a struct type, got ${t.kind}`)
}

/** The union type of an expression known to have one. */
export function unionOf(t: Type): UnionType {
    if (t.kind === "union") return t
    process.panic(`expected a union type, got ${t.kind}`)
}

function nullIndex(u: UnionType): int {
    for (let i = 0; i < u.members.length; i++) if (u.members[i].kind === "null") return i
    return -1
}

export function expr(g: Emitter, e: Expr): V {
    switch (e.k) {
        case "int":
            return g.int(e.type, e.value)
        case "float":
            return { ty: g.lt(e.type), v: floatConstant(e.value, e.type.bits) }
        case "bool":
            return { ty: "i1", v: e.value ? "true" : "false" }
        case "string":
            return g.str(e.value)
        case "local":
            return g.read(e.local)
        case "assign":
            return assign(g, e)
        case "incdec":
            return incdec(g, e)
        case "arith": {
            const l = expr(g, e.left)
            const r = expr(g, e.right)
            return arith(g, e.op, l, r, e.type, e.right.type)
        }
        case "compare": {
            const l = expr(g, e.left)
            const r = expr(g, e.right)
            return compare(g, e.op, l, r, e.left.type)
        }
        case "logical":
            return logical(g, e)
        case "unary": {
            const v = expr(g, e.operand)
            if (e.op === "~") return g.b.value(v.ty, `xor ${v.ty} ${v.v}, -1`)
            if (e.type.kind === "float") return g.b.value(v.ty, `fneg ${v.ty} ${v.v}`)
            return g.b.value(v.ty, `sub ${v.ty} 0, ${v.v}`)
        }
        case "not":
            return g.b.value("i1", `xor i1 ${expr(g, e.operand).v}, true`)
        case "convert":
            return convert(g, expr(g, e.value), e.value.type, e.type)
        case "call":
            return call(g, e)
        case "method-call": {
            const receiver = expr(g, e.receiver)
            const args: V[] = [receiver]
            for (const a of e.args) args.push(expr(g, a))
            if (e.virtual) return callIndirect(g, g.virtualMethod(receiver, e.func).v, g.lt(e.type), args)
            return callDirect(g, e.func.name, g.lt(e.type), args)
        }
        case "builtin":
            return builtin(g, e)
        case "cond": {
            // A condition known at compile time, such as one on `target.os`, compiles only the branch taken.
            const known = e.cond
            if (known.k === "bool") return expr(g, known.value ? e.then : e.else)
            const then = e.then
            const otherwise = e.else
            return choose(
                g,
                expr(g, e.cond),
                () => expr(g, then),
                () => expr(g, otherwise),
                g.lt(e.type),
            )
        }
        case "concat": {
            const parts: Part[] = []
            for (const p of e.parts) parts.push({ v: expr(g, p), t: p.type })
            return concat(g, parts)
        }
        case "index": {
            const target = expr(g, e.target)
            const index = g.intToI64(expr(g, e.index), e.index.type)
            if (e.target.type.kind === "string") return g.fromI64(g.rt("ore_rt_str_at", [target, index]), "i8")
            const ptr = g.rt("ore_rt_array_at", [target, index, { ty: "i64", v: sizeOf(g.mt(e.type)) }])
            return g.load(ptr.v, e.type)
        }
        case "len": {
            const v = expr(g, e.value)
            if (e.value.type.kind === "string") return g.extract(v, 1, "i64")
            return g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
        }
        case "slice": {
            const value = expr(g, e.value)
            const s = e.start
            const start = s !== null ? g.intToI64(expr(g, s), s.type) : g.i64(0)
            const en = e.end
            const end = en !== null ? g.intToI64(expr(g, en), en.type) : g.i64(I64_MAX)
            const t = e.type
            if (t.kind === "string") return g.rt("ore_rt_str_slice", [value, start, end])
            const elem = t.kind === "array" ? t.elem : t
            return g.rt("ore_rt_array_slice", [value, { ty: "i64", v: sizeOf(g.mt(elem)) }, start, end])
        }
        case "array": {
            const elem = g.mt(e.type.elem)
            const values: V[] = []
            for (const x of e.elems) values.push(expr(g, x))
            const spread = e.spread
            if (spread !== null) return spreadArray(g, e.type.elem, values, spread)
            const array = g.rt("ore_rt_array_new", [{ ty: "i64", v: sizeOf(elem) }, g.i64(values.length)])
            if (values.length === 0) return array
            const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
            for (let i = 0; i < values.length; i++)
                g.store(values[i], g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i}`).v, e.type.elem)
            return array
        }
        case "push": {
            // The array and all values are evaluated before appending, as in JavaScript.
            const at = e.array.type
            const type = at.kind === "array" ? at.elem : at
            const array = expr(g, e.array)
            const values: V[] = []
            for (const v of e.values) values.push(expr(g, v))
            const size: V = { ty: "i64", v: sizeOf(g.mt(type)) }
            const spread = e.spread
            for (let i = 0; i < values.length; i++) {
                if (spread !== null && spread[i]) g.rt("ore_rt_array_append", [array, values[i], size])
                else g.store(values[i], g.rt("ore_rt_array_push", [array, size]).v, type)
            }
            return g.b.value("i64", `load i64, ptr ${g.field(array.v, ARRAY, 1)}`)
        }
        case "pop":
            return g.load(
                g.rt("ore_rt_array_pop", [expr(g, e.array), { ty: "i64", v: sizeOf(g.mt(e.type)) }]).v,
                e.type,
            )
        case "object": {
            const s = g.structType(e.type)
            const object = slot(g, e) ?? g.alloc(s).v
            for (const f of e.fields) {
                const field = findField(e.type, f.name)
                if (field === null) process.panic(`no field ${f.name}`)
                g.store(expr(g, f.value), g.field(object, s, g.fieldIndex(e.type, f.name)), field.type)
            }
            return { ty: "ptr", v: object }
        }
        case "field": {
            const object = expr(g, e.object)
            return g.load(fieldPtr(g, object.v, structOf(e.object.type), e.name), e.type)
        }
        case "alloc": {
            const object: V = g.at ? { ty: "ptr", v: "%mem" } : g.alloc(g.structType(e.type))
            g.setTable(object, e.type)
            return object
        }
        case "to-iface": {
            const value = expr(g, e.value)
            const itab = e.itab
            if (itab !== null)
                return g.aggregate(IFACE, [value, { ty: "ptr", v: g.names.itab(itab.id, itab.struct, itab.iface) }])
            const indices = e.indices ?? []
            const values: string[] = []
            for (const i of indices) values.push(`${i}`)
            const table = indices.length === 0 ? "null" : constArray(g, "i32", values)
            return g.rt("ore_rt_iface_project", [value, g.i64(indices.length), { ty: "ptr", v: table }])
        }
        case "iface-field": {
            const value = expr(g, e.value)
            const it = e.value.type
            const member = it.kind === "interface" ? it.members[e.index] : null
            if (member === null || member.k !== "field" || !member.optional || e.type.kind !== "union")
                return g.load(ifaceField(g, value, e.index), e.type)
            // A missing optional field reads as null.
            const u = e.type
            const offset = ifaceOffset(g, value, e.index)
            return choose(
                g,
                g.b.value("i1", `icmp eq i64 ${offset.v}, -1`),
                () => inject(g, u, nullIndex(u), null),
                () =>
                    g.load(
                        g.b.value("ptr", `getelementptr i8, ptr ${g.extract(value, 0, "ptr").v}, i64 ${offset.v}`).v,
                        u,
                    ),
                g.lt(u),
            )
        }
        case "iface-call": {
            // The receiver is evaluated once, before the arguments.
            const value = expr(g, e.value)
            const args: V[] = []
            for (const a of e.args) args.push(expr(g, a))
            const itab = g.extract(value, 1, "ptr")
            const entry = g.b.value("ptr", `getelementptr ptr, ptr ${itab.v}, i64 ${e.index + 1}`)
            const fn = g.b.value("ptr", `load ptr, ptr ${entry.v}`)
            const all: V[] = [g.extract(value, 0, "ptr")]
            for (const a of args) all.push(a)
            return callIndirect(g, fn.v, g.lt(e.method.result), all)
        }
        case "null": {
            // `null` of the type `null` itself, which the checker in Ore may make, has no union to tag.
            const t = e.type
            if (t.kind !== "union") return g.zero(t)
            return inject(g, t, nullIndex(t), null)
        }
        case "recast":
            return recast(g, expr(g, e.value), e.value.type, e.type)
        case "is-null": {
            const v = expr(g, e.value)
            return isNullValue(g, unionOf(e.value.type), v)
        }
        case "optional":
            return optional(g, e)
        case "coalesce": {
            const from = unionOf(e.value.type)
            const v = expr(g, e.value)
            const fallback = e.fallback
            const to = e.type
            return choose(
                g,
                isNullValue(g, from, v),
                () => expr(g, fallback),
                () => recast(g, v, from, to),
                g.lt(e.type),
            )
        }
        case "union-field":
            return unionField(g, e)
        case "typeof": {
            const from = e.value.type
            const v = expr(g, e.value)
            if (from.kind !== "union") return g.str(typeofName(from))
            return g.b.value(STR, `call ${STR} ${typeofer(g, from)}(${v.ty} ${v.v})`)
        }
        case "is": {
            const v = expr(g, e.value)
            const member = e.member
            if (e.value.type.kind === "struct") return g.classIs(v, structOf(member))
            if (e.value.type.kind === "interface") return ifaceIs(g, v, structOf(member))
            const u = unionOf(e.value.type)
            const via = e.via
            if (via !== null) {
                const i = memberIndex(u, via)
                return choose(
                    g,
                    slotTest(g, u, v, i),
                    () => ifaceIs(g, payload(g, u, v, i), structOf(member)),
                    () => ({ ty: "i1", v: "false" }),
                    "i1",
                )
            }
            if (member.kind !== "struct") return slotTest(g, u, v, memberIndex(u, member))
            return unionIs(g, u, v, member)
        }
        case "downcast": {
            const v = expr(g, e.value)
            if (e.value.type.kind === "struct") {
                check(g, g.classIs(v, e.type), `value is not a ${e.type.name ?? "undefined"}`)
                return v
            }
            check(g, ifaceIs(g, v, e.type), `value is not a ${e.type.name ?? "undefined"}`)
            return g.extract(v, 0, "ptr")
        }
        case "map":
            return mapOp(g, e)
        case "set":
            return setOp(g, e)
        case "chan":
            return chanOp(g, e)
        case "func-ref":
            return g.aggregate(FN, [
                { ty: "ptr", v: thunk(g, e.func) },
                { ty: "ptr", v: "null" },
            ])
        case "closure":
            return closure(g, e)
        case "call-value": {
            // The callee is evaluated before the arguments.
            const f = expr(g, e.callee)
            const args: V[] = []
            for (const a of e.args) args.push(expr(g, a))
            const ct = e.callee.type
            if (ct.kind !== "func") process.panic("call of a value that is not a function")
            return callClosure(g, f, ct, args)
        }
        case "bound-method":
            return bound(g, e)
        case "array-method":
            return arrayMethod(g, e)
        case "string-method":
            return stringMethod(g, e)
        case "seq": {
            let last = voidValue
            for (const x of e.exprs) last = expr(g, x)
            return last
        }
        case "bind":
            for (const b of e.locals) g.declare(b.local, expr(g, b.init))
            return expr(g, e.body)
    }
}

export function fieldPtr(g: Emitter, object: string, s: StructType, name: string): string {
    return g.field(object, g.structType(s), g.fieldIndex(s, name))
}

/** A pointer to a constant array of `ty` elements. */
export function constArray(g: Emitter, ty: string, values: string[]): string {
    const items: string[] = []
    for (const v of values) items.push(`${ty} ${v}`)
    const value = `[${values.length} x ${ty}] [${items.join(", ")}]`
    // Named after its value, as strings are: the same array is one constant.
    const base = `@const.${fnvHex(value)}`
    let name = base
    let n = 2
    let known = g.helpers.get(name)
    while (known !== null && known !== `${name} = private unnamed_addr constant ${value}`) {
        name = `${base}.${n}`
        n++
        known = g.helpers.get(name)
    }
    if (known === null) g.helpers.set(name, `${name} = private unnamed_addr constant ${value}`)
    return name
}

/** Branches on a condition and joins the two values. */
export function choose(g: Emitter, cond: V, then: () => V, otherwise: () => V, ty: string): V {
    const a = g.b.label("cthen")
    const b = g.b.label("celse")
    const end = g.b.label("cend")
    g.b.condBr(cond, a, b)
    g.b.start(a)
    const x = then()
    const fromA = g.b.block
    const aOpen = g.b.isOpen()
    g.b.br(end)
    g.b.start(b)
    const y = otherwise()
    const fromB = g.b.block
    const bOpen = g.b.isOpen()
    g.b.br(end)
    g.b.start(end)
    if (ty === "void") return voidValue
    const incoming: string[] = []
    if (aOpen) incoming.push(`[ ${x.v}, %${fromA} ]`)
    if (bOpen) incoming.push(`[ ${y.v}, %${fromB} ]`)
    if (incoming.length === 0) {
        g.b.terminate("unreachable")
        return { ty, v: "undef" }
    }
    return g.b.value(ty, `phi ${ty} ${incoming.join(", ")}`)
}

/** Panics with a message unless a condition holds. */
export function check(g: Emitter, ok: V, message: string) {
    const fine = g.b.label("ok")
    const bad = g.b.label("fail")
    g.b.condBr(ok, fine, bad)
    g.b.start(bad)
    g.panic(message)
    g.b.start(fine)
}

export function logical(g: Emitter, e: Logical): V {
    const left = expr(g, e.left)
    const right = e.right
    if (e.op === "&&")
        return choose(
            g,
            left,
            () => expr(g, right),
            () => ({ ty: "i1", v: "false" }),
            "i1",
        )
    return choose(
        g,
        left,
        () => ({ ty: "i1", v: "true" }),
        () => expr(g, right),
        "i1",
    )
}

export function assign(g: Emitter, e: Assign): V {
    const target = e.target
    if (target.k === "local") {
        const value = expr(g, e.value)
        g.store(value, g.place(target.local), target.local.type)
        return value
    }
    // The parts of the place and the value are evaluated before the place's
    // address is taken, since evaluating the value may grow an array.
    const parts = placeParts(g, target)
    const value = expr(g, e.value)
    const ptr = placePointer(g, target, parts, e.type)
    const op = e.op
    if (op === null) {
        g.store(value, ptr, e.type)
        return value
    }
    const current = g.load(ptr, e.type)
    const t = e.type
    let combined: V
    if (t.kind === "string")
        combined = concat(g, [
            { v: current, t: types.string },
            { v: value, t: types.string },
        ])
    else if (t.kind === "int") combined = arith(g, op, current, value, t, e.value.type)
    else if (t.kind === "float") combined = arith(g, op, current, value, t, e.value.type)
    else process.panic(`compound assignment of ${t.kind}`)
    g.store(combined, ptr, e.type)
    return combined
}

export function placeParts(g: Emitter, target: Place): V[] {
    switch (target.k) {
        case "field":
            return [expr(g, target.object)]
        case "iface-field":
            return [expr(g, target.value)]
        case "union-field":
            return [expr(g, target.value)]
        case "element": {
            const array = expr(g, target.array)
            return [array, g.intToI64(expr(g, target.index), target.index.type)]
        }
    }
}

export function placePointer(g: Emitter, target: Place, parts: V[], type: Type): string {
    switch (target.k) {
        case "field":
            return fieldPtr(g, parts[0].v, structOf(target.object.type), target.name)
        case "iface-field": {
            const it = target.value.type
            const member = it.kind === "interface" ? it.members[target.index] : null
            const optional = member !== null && member.k === "field" && member.optional ? member.name : null
            return ifaceField(g, parts[0], target.index, optional)
        }
        case "union-field":
            return unionFieldPtr(g, parts[0], unionOf(target.value.type), target.name)
        case "element":
            return g.rt("ore_rt_array_at", [parts[0], parts[1], { ty: "i64", v: sizeOf(g.mt(type)) }]).v
    }
}

export function incdec(g: Emitter, e: IncDec): V {
    const target = e.target
    let ptr: string
    if (target.k === "local") ptr = g.place(target.local)
    else if (target.k === "element") ptr = placePointer(g, target, placeParts(g, target), e.type)
    else if (target.k === "field") ptr = placePointer(g, target, placeParts(g, target), e.type)
    else ptr = placePointer(g, target, placeParts(g, target), e.type)
    const old = g.load(ptr, e.type)
    const t = e.type
    let next: V
    if (t.kind === "float")
        next = g.b.value(old.ty, `${e.op === "++" ? "fadd" : "fsub"} ${old.ty} ${old.v}, ${floatConstant(1, t.bits)}`)
    else next = g.b.value(old.ty, `${e.op === "++" ? "add" : "sub"} ${old.ty} ${old.v}, 1`)
    g.store(next, ptr, e.type)
    return e.prefix ? next : old
}

export function arith(g: Emitter, op: ArithOp, l: V, r: V, type: IntType | FloatType, rightType: Type): V {
    const ty = l.ty
    if (type.kind === "float") {
        let ins = "undefined"
        if (op === "+") ins = "fadd"
        else if (op === "-") ins = "fsub"
        else if (op === "*") ins = "fmul"
        else if (op === "/") ins = "fdiv"
        else if (op === "%") ins = "frem"
        else if (op === "**") {
            const f = `@llvm.pow.${ty === "float" ? "f32" : "f64"}`
            g.decls.set(f, `declare ${ty} ${f}(${ty}, ${ty})`)
            return g.b.value(ty, `call ${ty} ${f}(${ty} ${l.v}, ${ty} ${r.v})`)
        }
        return g.b.value(ty, `${ins} ${ty} ${l.v}, ${r.v}`)
    }
    switch (op) {
        case "+":
            return g.b.value(ty, `add ${ty} ${l.v}, ${r.v}`)
        case "-":
            return g.b.value(ty, `sub ${ty} ${l.v}, ${r.v}`)
        case "*":
            return g.b.value(ty, `mul ${ty} ${l.v}, ${r.v}`)
        case "&":
            return g.b.value(ty, `and ${ty} ${l.v}, ${r.v}`)
        case "|":
            return g.b.value(ty, `or ${ty} ${l.v}, ${r.v}`)
        case "^":
            return g.b.value(ty, `xor ${ty} ${l.v}, ${r.v}`)
        case "/":
            return divide(g, "/", l, r, type)
        case "%":
            return divide(g, "%", l, r, type)
        case "**":
            return power(g, l, r, type)
        case "<<":
            return shift(g, "<<", l, r, type, rightType.kind === "int" ? rightType : type)
        case ">>":
            return shift(g, ">>", l, r, type, rightType.kind === "int" ? rightType : type)
    }
}

/** An integer power, which wraps like `*`; a negative exponent panics. */
export function power(g: Emitter, l: V, r: V, type: IntType): V {
    const ty = l.ty
    if (type.signed) check(g, g.b.value("i1", `icmp sge ${ty} ${r.v}, 0`), "negative exponent of an integer")
    const widen = (v: V): V =>
        ty === "i64" ? v : g.b.value("i64", `${type.signed ? "sext" : "zext"} ${ty} ${v.v} to i64`)
    const result = g.rt("ore_rt_pow", [widen(l), widen(r)])
    return ty === "i64" ? result : g.b.value(ty, `trunc i64 ${result.v} to ${ty}`)
}

/** Integer division and remainder: by zero panics; MIN / -1 wraps (MIN % -1 is 0). */
export function divide(g: Emitter, op: "/" | "%", l: V, r: V, type: IntType): V {
    const ty = l.ty
    check(g, g.b.value("i1", `icmp ne ${ty} ${r.v}, 0`), DIVIDE_BY_ZERO)
    if (!type.signed) return g.b.value(ty, `${op === "/" ? "udiv" : "urem"} ${ty} ${l.v}, ${r.v}`)
    const minusOne = g.b.value("i1", `icmp eq ${ty} ${r.v}, -1`)
    return choose(
        g,
        minusOne,
        () => (op === "/" ? g.b.value(ty, `sub ${ty} 0, ${l.v}`) : { ty, v: "0" }),
        () => g.b.value(ty, `${op === "/" ? "sdiv" : "srem"} ${ty} ${l.v}, ${r.v}`),
        ty,
    )
}

/** Shifts by a count of any integer type: a negative count panics; counts >= the width give 0 (or -1 for `>>` of a negative value). */
export function shift(g: Emitter, op: "<<" | ">>", l: V, r: V, type: IntType, countType: IntType): V {
    const ty = l.ty
    let count = g.toI64(r, countType.signed)
    if (countType.signed) check(g, g.b.value("i1", `icmp sge i64 ${count.v}, 0`), "negative shift amount")
    const inRange = g.b.value("i1", `icmp ult i64 ${count.v}, ${type.bits}`)
    // Clamp the count so the shift itself is always defined.
    count = g.b.value("i64", `select i1 ${inRange.v}, i64 ${count.v}, i64 0`)
    const n = g.fromI64(count, ty)
    if (op === "<<") {
        const shifted = g.b.value(ty, `shl ${ty} ${l.v}, ${n.v}`)
        return g.b.value(ty, `select i1 ${inRange.v}, ${ty} ${shifted.v}, ${ty} 0`)
    }
    const shifted = g.b.value(ty, `${type.signed ? "ashr" : "lshr"} ${ty} ${l.v}, ${n.v}`)
    let overflow: V = { ty, v: "0" }
    if (type.signed) {
        const negative = g.b.value("i1", `icmp slt ${ty} ${l.v}, 0`)
        overflow = g.b.value(ty, `select i1 ${negative.v}, ${ty} -1, ${ty} 0`)
    }
    return g.b.value(ty, `select i1 ${inRange.v}, ${ty} ${shifted.v}, ${ty} ${overflow.v}`)
}

export function convert(g: Emitter, v: V, from: Type, to: Type): V {
    const target = g.lt(to)
    if (to.kind === "int" && from.kind === "float") {
        // Truncates toward zero, saturates out of range, NaN gives 0.
        const name = `@llvm.fpto${to.signed ? "s" : "u"}i.sat.${target}.${v.ty === "float" ? "f32" : "f64"}`
        g.decls.set(name, `declare ${target} ${name}(${v.ty})`)
        return g.b.value(target, `call ${target} ${name}(${v.ty} ${v.v})`)
    }
    if (to.kind === "float" && from.kind === "int")
        return g.b.value(target, `${from.signed ? "sitofp" : "uitofp"} ${v.ty} ${v.v} to ${target}`)
    if (to.kind === "float" && from.kind === "float") {
        if (v.ty === target) return v
        return g.b.value(target, `${to.bits > from.bits ? "fpext" : "fptrunc"} ${v.ty} ${v.v} to ${target}`)
    }
    if (from.kind !== "int" || to.kind !== "int") process.panic(`conversion from ${from.kind} to ${to.kind}`)
    const a = from.bits
    const b = to.bits
    if (a === b) return v
    if (b < a) return g.b.value(target, `trunc ${v.ty} ${v.v} to ${target}`)
    return g.b.value(target, `${from.signed ? "sext" : "zext"} ${v.ty} ${v.v} to ${target}`)
}

export function compare(g: Emitter, op: CompareOp, l: V, r: V, type: Type): V {
    if (type.kind === "string" && op !== "===" && op !== "!==") {
        const c = g.fromI64(g.rt("ore_rt_str_cmp", [l, r]), "i32")
        let pred = "sge"
        if (op === "<") pred = "slt"
        else if (op === "<=") pred = "sle"
        else if (op === ">") pred = "sgt"
        return g.b.value("i1", `icmp ${pred} i32 ${c.v}, 0`)
    }
    if (type.kind === "int" || type.kind === "bool" || g.lt(type) === "ptr") {
        const signed = type.kind === "int" && type.signed
        let pred = "eq"
        if (op === "!==") pred = "ne"
        else if (op === "<") pred = signed ? "slt" : "ult"
        else if (op === "<=") pred = signed ? "sle" : "ule"
        else if (op === ">") pred = signed ? "sgt" : "ugt"
        else if (op === ">=") pred = signed ? "sge" : "uge"
        return g.b.value("i1", `icmp ${pred} ${l.ty} ${l.v}, ${r.v}`)
    }
    if (type.kind === "float") {
        let pred = "oeq"
        if (op === "!==") pred = "une"
        else if (op === "<") pred = "olt"
        else if (op === "<=") pred = "ole"
        else if (op === ">") pred = "ogt"
        else if (op === ">=") pred = "oge"
        return g.b.value("i1", `fcmp ${pred} ${l.ty} ${l.v}, ${r.v}`)
    }
    const v = equals(g, l, r, type)
    return op === "!==" ? g.b.value("i1", `xor i1 ${v.v}, true`) : v
}

/** `===` of two values of a type. */
export function equals(g: Emitter, a: V, b: V, type: Type): V {
    if (type.kind === "union") {
        const repr = unionRepr(type)
        if (repr.k === "tagged")
            return g.b.value("i1", `call i1 ${unionEquals(g, type)}(${a.ty} ${a.v}, ${b.ty} ${b.v})`)
        return equals(g, a, b, repr.k === "nullable" ? repr.base : types.string)
    }
    if (isStringLike(type)) return g.rtBool("ore_rt_str_eq", [a, b])
    if (type.kind === "func") {
        const fn = g.b.value("i1", `icmp eq ptr ${g.extract(a, 0, "ptr").v}, ${g.extract(b, 0, "ptr").v}`)
        const env = g.b.value("i1", `icmp eq ptr ${g.extract(a, 1, "ptr").v}, ${g.extract(b, 1, "ptr").v}`)
        return g.b.value("i1", `and i1 ${fn.v}, ${env.v}`)
    }
    if (type.kind === "interface")
        return g.b.value("i1", `icmp eq ptr ${g.extract(a, 0, "ptr").v}, ${g.extract(b, 0, "ptr").v}`)
    if (type.kind === "float") return g.b.value("i1", `fcmp oeq ${a.ty} ${a.v}, ${b.v}`)
    return g.b.value("i1", `icmp eq ${a.ty} ${a.v}, ${b.v}`)
}

export function unionEquals(g: Emitter, u: UnionType): string {
    const name = `@U.${g.names.union(u)}.eq`
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.unionType(u)
    helper(g, name, `define internal i1 ${name}(${ty} %a, ${ty} %b)`, (e) => {
        const a: V = { ty, v: "%a" }
        const b: V = { ty, v: "%b" }
        const sameTag = e.b.value("i1", `icmp eq i32 ${e.extract(a, 0, "i32").v}, ${e.extract(b, 0, "i32").v}`)
        const yes = e.b.label("same")
        const no = e.b.label("differ")
        e.b.condBr(sameTag, yes, no)
        e.b.start(no)
        e.b.terminate("ret i1 false")
        e.b.start(yes)
        for (let i = 0; i < u.members.length; i++) {
            const m = u.members[i]
            if (m.kind === "null") continue
            const here = e.b.label("member")
            const next = e.b.label("nextmember")
            e.b.condBr(e.b.value("i1", `icmp eq i32 ${e.extract(a, 0, "i32").v}, ${i}`), here, next)
            e.b.start(here)
            const pa = payload(e, u, a, i)
            const pb = payload(e, u, b, i)
            e.b.terminate(`ret i1 ${equals(e, pa, pb, m).v}`)
            e.b.start(next)
        }
        e.b.terminate("ret i1 true")
    })
    return name
}

/** Whether a union value holds member `i`. */
export function slotTest(g: Emitter, u: UnionType, v: V, i: int): V {
    const repr = unionRepr(u)
    if (repr.k === "tagged") return g.b.value("i1", `icmp eq i32 ${g.extract(v, 0, "i32").v}, ${i}`)
    const member = u.members[i]
    // Members that are string literals are told apart by the value.
    const literal = (): V => g.rtBool("ore_rt_str_eq", [v, g.str(member.kind === "literal" ? member.value : "")])
    if (repr.k === "strings") return literal()
    if (member.kind === "null") return isNullRef(g, v, repr.base)
    const present = g.b.value("i1", `xor i1 ${isNullRef(g, v, repr.base).v}, true`)
    if (member.kind !== "literal") return present
    return choose(g, present, literal, () => ({ ty: "i1", v: "false" }), "i1")
}

export function isNullRef(g: Emitter, v: V, base: Type): V {
    const ptr = base.kind === "interface" || base.kind === "func" || base.kind === "string" ? g.extract(v, 0, "ptr") : v
    return g.b.value("i1", `icmp eq ptr ${ptr.v}, null`)
}

export function isNullValue(g: Emitter, u: UnionType, v: V): V {
    return slotTest(g, u, v, nullIndex(u))
}

/** The value of member `i` of a union value. */
export function payload(g: Emitter, u: UnionType, v: V, i: int): V {
    if (unionRepr(u).k !== "tagged") return v
    const s = g.spill(v)
    const ptr = g.field(s, g.unionType(u), 1)
    return g.load(ptr, u.members[i])
}

/** A union value holding member `i` with value `p` (none for `null`). */
export function inject(g: Emitter, u: UnionType, i: int, p: V | null): V {
    const repr = unionRepr(u)
    const isNull = u.members[i].kind === "null"
    if (repr.k === "strings") return p ?? voidValue
    if (repr.k === "nullable") return isNull ? g.zero(repr.base) : (p ?? voidValue)
    const ty = g.unionType(u)
    const s = g.b.alloca(ty)
    g.b.emit(`store ${ty} zeroinitializer, ptr ${s}`)
    g.b.emit(`store i32 ${i}, ptr ${g.field(s, ty, 0)}`)
    if (!isNull && p !== null) g.store(p, g.field(s, ty, 1), u.members[i])
    return g.b.value(ty, `load ${ty}, ptr ${s}`)
}

/**
 * The address of member `index` of an interface value that is a field:
 * entry `index + 1` of its table holds the field's offset in the object.
 */
/** The offset of the field at `index` of an interface's members in the value's struct; -1 for a missing optional field. */
function ifaceOffset(g: Emitter, value: V, index: int): V {
    const table = g.extract(value, 1, "ptr")
    const entry = g.b.value("ptr", `getelementptr ptr, ptr ${table.v}, i64 ${index + 1}`)
    return g.b.value("i64", `load i64, ptr ${entry.v}`)
}

/** The address of a field of an interface value's struct; panics for a missing optional field. */
export function ifaceField(g: Emitter, value: V, index: int, optional: string | null = null): string {
    const data = g.extract(value, 0, "ptr")
    const offset = ifaceOffset(g, value, index)
    if (optional !== null)
        check(
            g,
            g.b.value("i1", `icmp ne i64 ${offset.v}, -1`),
            `assignment to the missing optional field '${optional}'`,
        )
    return g.b.value("ptr", `getelementptr i8, ptr ${data.v}, i64 ${offset.v}`).v
}

/**
 * Whether an interface value refers to an instance of class `s`: entry 0
 * of its table is the id of the class it was converted from, which for a
 * class with a class table may be a base class of the instance's.
 */
export function ifaceIs(g: Emitter, value: V, s: StructType): V {
    const table = g.extract(value, 1, "ptr")
    const present = g.b.value("i1", `icmp ne ptr ${table.v}, null`)
    if (!g.tables.has(s.id)) {
        return choose(
            g,
            present,
            () =>
                g.b.value("i1", `icmp eq i64 ${g.b.value("i64", `load i64, ptr ${table.v}`).v}, ${g.names.typeId(s)}`),
            () => ({ ty: "i1", v: "false" }),
            "i1",
        )
    }
    const related: StructType[] = []
    for (const t of g.module.structs) if (g.tables.has(t.id) && (isSubclass(t, s) || isSubclass(s, t))) related.push(t)
    return choose(
        g,
        present,
        () => {
            const id = g.b.value("i64", `load i64, ptr ${table.v}`)
            let known: V = { ty: "i1", v: "false" }
            for (let i = 0; i < related.length; i++) {
                const test = g.b.value("i1", `icmp eq i64 ${id.v}, ${g.names.typeId(related[i])}`)
                known = i === 0 ? test : g.b.value("i1", `or i1 ${known.v}, ${test.v}`)
            }
            return choose(
                g,
                known,
                () => g.classIs(g.extract(value, 0, "ptr"), s),
                () => ({ ty: "i1", v: "false" }),
                "i1",
            )
        },
        () => ({ ty: "i1", v: "false" }),
        "i1",
    )
}

/**
 * Whether a union value holds an instance of class `s`: in the slot of `s`
 * or of a subclass, or in the slot of a base class with the class table of
 * `s` or of a subclass.
 */
export function unionIs(g: Emitter, u: UnionType, v: V, s: StructType): V {
    let result: V = { ty: "i1", v: "false" }
    let first = true
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        if (m.kind !== "struct") continue
        let test: V
        if (isSubclass(m, s)) test = slotTest(g, u, v, i)
        else if (isSubclass(s, m))
            test = choose(
                g,
                slotTest(g, u, v, i),
                () => g.classIs(payload(g, u, v, i), s),
                () => ({ ty: "i1", v: "false" }),
                "i1",
            )
        else continue
        result = first ? test : g.b.value("i1", `or i1 ${result.v}, ${test.v}`)
        first = false
    }
    return result
}

/** A union value holding an instance of a subclass of class `to`, as a `to`; other members panic. */
export function recastToBase(g: Emitter, v: V, from: UnionType, to: StructType): V {
    const result = g.b.alloca("ptr")
    const end = g.b.label("recast")
    for (let i = 0; i < from.members.length; i++) {
        const m = from.members[i]
        if (m.kind !== "struct" || !isSubclass(m, to)) continue
        const here = g.b.label("rmember")
        const next = g.b.label("rnext")
        g.b.condBr(slotTest(g, from, v, i), here, next)
        g.b.start(here)
        g.b.emit(`store ptr ${payload(g, from, v, i).v}, ptr ${result}`)
        g.b.br(end)
        g.b.start(next)
    }
    g.panic(`value is not of type ${typeToString(to)}`)
    g.b.start(end)
    return g.b.value("ptr", `load ptr, ptr ${result}`)
}

/** Converts between a union and its members; narrowing panics on a member the target lacks. */
export function recast(g: Emitter, v: V, from: Type, to: Type): V {
    // Unions of string literals widen to `string` without a change.
    if (from.kind === "union" && unionRepr(from).k === "strings" && to.kind === "string") return v
    if (from.kind !== "union") {
        if (to.kind !== "union") return v
        return inject(g, to, memberIndex(to, from), v)
    }
    // Narrowing a nullable union or one of strings is a test of the value, kept in place.
    if (to.kind !== "union" && unionRepr(from).k !== "tagged") return recastInline(g, v, from, to)
    // Between unions held the same way without a tag (strings, or one reference
    // and null), with every member of the source in the target, the value stays.
    if (
        to.kind === "union" &&
        unionRepr(from).k !== "tagged" &&
        unionRepr(to).k !== "tagged" &&
        g.lt(from) === g.lt(to) &&
        allMapped(from, to)
    )
        return v
    // Otherwise the conversion tests the tag, or every member of the source: a
    // function per pair of types, so that each use is a call.
    const ty = g.lt(to)
    return g.b.value(ty, `call ${ty} ${recaster(g, from, to)}(${v.ty} ${v.v})`)
}

/** The function converting a union to another type, as `recast` does: `@ore.recast.<from>.<to>`. */
export function recaster(g: Emitter, from: UnionType, to: Type): string {
    const name = globalName(`ore.recast.${g.names.union(from)}.${g.names.key(to)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const fromTy = g.lt(from)
    const ty = g.lt(to)
    helper(g, name, `define internal ${ty} ${name}(${fromTy} %v)`, (e) => {
        const r = recastInline(e, { ty: fromTy, v: "%v" }, from, to)
        e.b.terminate(`ret ${ty} ${r.v}`)
    })
    return name
}

/** Converts a union to a member or to another union, in place; narrowing panics on a member the target lacks. */
export function recastInline(g: Emitter, v: V, from: UnionType, to: Type): V {
    // A union of subclasses of a class, as that class.
    if (to.kind === "struct" && memberIndex(from, to) === -1) return recastToBase(g, v, from, to)
    if (to.kind !== "union") {
        const i = memberIndex(from, to)
        const message =
            nullIndex(from) !== -1 && from.members.length === 2
                ? "unexpected null"
                : `value is not of type ${typeToString(to)}`
        check(g, slotTest(g, from, v, i), message)
        return payload(g, from, v, i)
    }
    if (unionRepr(from).k === "tagged" && unionRepr(to).k === "tagged") return retag(g, v, from, to)
    if (unionRepr(from).k === "strings" && g.lt(to) === STR) return narrowStrings(g, v, from, to)
    // Union to union: each member of the source maps to the target.
    const ty = g.lt(to)
    const result = g.b.alloca(ty)
    const end = g.b.label("recast")
    for (let i = 0; i < from.members.length; i++) {
        const m = from.members[i]
        const here = g.b.label("rmember")
        const next = g.b.label("rnext")
        g.b.condBr(slotTest(g, from, v, i), here, next)
        g.b.start(here)
        const j = memberIndex(to, m)
        if (j === -1) g.panic(`value is not of type ${typeToString(to)}`)
        else {
            const converted = inject(g, to, j, m.kind === "null" ? null : payload(g, from, v, i))
            g.b.emit(`store ${ty} ${converted.v}, ptr ${result}`)
            g.b.br(end)
        }
        g.b.start(next)
    }
    g.panic(`value is not of type ${typeToString(to)}`)
    g.b.start(end)
    return g.b.value(ty, `load ${ty}, ptr ${result}`)
}

/** Whether every member of a union is a member of another. */
function allMapped(from: UnionType, to: UnionType): bool {
    for (const m of from.members) if (memberIndex(to, m) === -1) return false
    return true
}

/**
 * A tagged union as another: members keep their representation, so the tag
 * is mapped through a table and the payload words are copied.
 */
export function retag(g: Emitter, v: V, from: UnionType, to: UnionType): V {
    const ty = g.lt(to)
    const tags: string[] = []
    let missing = false
    for (const m of from.members) {
        const j = memberIndex(to, m)
        if (j === -1) missing = true
        tags.push(`${j}`)
    }
    const tag = g.extract(v, 0, "i32")
    const table = constArray(g, "i32", tags)
    const entry = g.b.value("ptr", `getelementptr i32, ptr ${table}, i32 ${tag.v}`)
    const j = g.b.value("i32", `load i32, ptr ${entry.v}`)
    if (missing) check(g, g.b.value("i1", `icmp ne i32 ${j.v}, -1`), `value is not of type ${typeToString(to)}`)
    const n = g.unionWords(from)
    const m = g.unionWords(to)
    let words = g.extract(v, 1, `[${n} x i64]`)
    if (m !== n) {
        let resized: V = { ty: `[${m} x i64]`, v: "zeroinitializer" }
        for (let k = 0; k < Math.min(m, n); k++) {
            const word = g.extract(words, k, "i64")
            resized = g.b.value(resized.ty, `insertvalue ${resized.ty} ${resized.v}, i64 ${word.v}, ${k}`)
        }
        words = resized
    }
    return g.aggregate(ty, [j, words])
}

/**
 * A union of string literals as a union held as a string too: the value
 * stays, after checking that it is a member of the target, against the
 * fewer of the members the target has and those it lacks.
 */
export function narrowStrings(g: Emitter, v: V, from: UnionType, to: UnionType): V {
    const present: Type[] = []
    const missing: Type[] = []
    for (const m of from.members) {
        if (memberIndex(to, m) !== -1) present.push(m)
        else missing.push(m)
    }
    const testMissing = missing.length <= present.length
    const tested = testMissing ? missing : present
    let any: V = { ty: "i1", v: "false" }
    for (const m of tested) {
        const eq = g.rtBool("ore_rt_str_eq", [v, g.str(m.kind === "literal" ? m.value : "")])
        any = g.b.value("i1", `or i1 ${any.v}, ${eq.v}`)
    }
    const ok = testMissing ? g.b.value("i1", `xor i1 ${any.v}, true`) : any
    check(g, ok, `value is not of type ${typeToString(to)}`)
    return v
}

/** The function telling what `typeof` says of a value of a union: `@ore.typeof.<union>`. */
export function typeofer(g: Emitter, u: UnionType): string {
    const name = globalName(`ore.typeof.${g.names.union(u)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const uty = g.lt(u)
    helper(g, name, `define internal ${STR} ${name}(${uty} %v)`, (e) => {
        const v: V = { ty: uty, v: "%v" }
        let result = e.str("object")
        for (let i = u.members.length - 1; i >= 0; i--) {
            const test = slotTest(e, u, v, i)
            result = e.b.value(
                STR,
                `select i1 ${test.v}, ${STR} ${e.str(typeofName(u.members[i])).v}, ${STR} ${result.v}`,
            )
        }
        e.b.terminate(`ret ${STR} ${result.v}`)
    })
    return name
}

export function optional(g: Emitter, e: Optional): V {
    // `value?.body`: null when value is null, else body with the value bound.
    const from = unionOf(e.value.type)
    const v = expr(g, e.value)
    const isNull = isNullValue(g, from, v)
    const u = e.type
    if (u.kind !== "union") {
        choose(
            g,
            isNull,
            () => voidValue,
            () => {
                g.declare(e.binding, recast(g, v, from, e.binding.type))
                expr(g, e.body)
                return voidValue
            },
            "void",
        )
        return voidValue
    }
    return choose(
        g,
        isNull,
        () => inject(g, u, nullIndex(u), null),
        () => {
            g.declare(e.binding, recast(g, v, from, e.binding.type))
            return expr(g, e.body)
        },
        g.lt(u),
    )
}

/** The address of a field that every member of a union has, with the same type. */
export function unionFieldPtr(g: Emitter, v: V, u: UnionType, name: string): string {
    const end = g.b.label("ufield")
    const incoming: string[] = []
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        const here = g.b.label("umember")
        const next = g.b.label("unext")
        g.b.condBr(slotTest(g, u, v, i), here, next)
        g.b.start(here)
        const object = payload(g, u, v, i)
        let ptr = ""
        if (m.kind === "struct") ptr = fieldPtr(g, object.v, m, name)
        else if (m.kind === "interface") {
            let index = -1
            for (let k = 0; k < m.members.length && index === -1; k++) if (m.members[k].name === name) index = k
            ptr = ifaceField(g, object, index)
        }
        incoming.push(`[ ${ptr}, %${g.b.block} ]`)
        g.b.br(end)
        g.b.start(next)
    }
    g.b.terminate("unreachable")
    g.b.start(end)
    return g.b.value("ptr", `phi ptr ${incoming.join(", ")}`).v
}

export function unionField(g: Emitter, e: UnionField): V {
    const u = unionOf(e.value.type)
    const v = expr(g, e.value)
    const ty = g.lt(e.type)
    // Every member a class with the field at the same place, read as the result as it is: one load.
    const index = sharedField(g, u, e.name, e.type)
    if (index !== -1) {
        const object = payload(g, u, v, 0)
        return g.load(g.field(object.v, g.structType(structOf(u.members[0])), index), e.type)
    }
    return g.b.value(ty, `call ${ty} ${unionFielder(g, u, e.name, e.type)}(${v.ty} ${v.v})`)
}

/**
 * The index of a field that every member of a union, all classes, has at the
 * same place after fields of the same layout, with a value that is the
 * result's as it is; -1 when there is none.
 */
export function sharedField(g: Emitter, u: UnionType, name: string, type: Type): int {
    if (u.members.length === 0) return -1
    const first = u.members[0]
    if (first.kind !== "struct") return -1
    let index = -1
    for (let i = 0; i < first.fields.length && index === -1; i++) if (first.fields[i].name === name) index = i
    if (index === -1) return -1
    // After the pointer to the class table, when the members have one.
    const offset = g.tables.has(first.id) ? 1 : 0
    for (const m of u.members) {
        if (m.kind !== "struct" || m.fields.length <= index || m.fields[index].name !== name) return -1
        if ((g.tables.has(m.id) ? 1 : 0) !== offset) return -1
        for (let i = 0; i <= index; i++) if (g.mt(m.fields[i].type) !== g.mt(first.fields[i].type)) return -1
        const t = m.fields[index].type
        const same =
            sameType(t, type) ||
            (t.kind !== "union" &&
                type.kind === "union" &&
                unionRepr(type).k !== "tagged" &&
                memberIndex(type, t) !== -1)
        if (!same || g.mt(t) !== g.mt(type)) return -1
    }
    return index + offset
}

/** The function reading a field common to the members of a union: `@ore.ufield.<union>.<field>.<type>`. */
export function unionFielder(g: Emitter, u: UnionType, name: string, type: Type): string {
    const helperName = globalName(`ore.ufield.${g.names.union(u)}.${name}.${g.names.key(type)}`)
    if (g.helpers.has(helperName)) return helperName
    g.helpers.set(helperName, "")
    const uty = g.lt(u)
    const ty = g.lt(type)
    helper(g, helperName, `define internal ${ty} ${helperName}(${uty} %v)`, (e) => {
        const r = unionFieldInline(e, u, { ty: uty, v: "%v" }, name, type)
        e.b.terminate(`ret ${ty} ${r.v}`)
    })
    return helperName
}

/** Reads a field common to the members of a union, testing each member in turn. */
export function unionFieldInline(g: Emitter, u: UnionType, v: V, name: string, resultType: Type): V {
    const ty = g.lt(resultType)
    const result = g.b.alloca(ty)
    const end = g.b.label("ufield")
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        const here = g.b.label("umember")
        const next = g.b.label("unext")
        g.b.condBr(slotTest(g, u, v, i), here, next)
        g.b.start(here)
        const object = payload(g, u, v, i)
        let read: V = voidValue
        let type: Type = types.void
        if (m.kind === "struct") {
            const f = findField(m, name)
            if (f !== null) type = f.type
            read = g.load(fieldPtr(g, object.v, m, name), type)
        } else if (m.kind === "interface") {
            let index = -1
            for (let k = 0; k < m.members.length && index === -1; k++) if (m.members[k].name === name) index = k
            type = m.members[index].type
            read = g.load(ifaceField(g, object, index), type)
        }
        g.b.emit(`store ${ty} ${recast(g, read, type, resultType).v}, ptr ${result}`)
        g.b.br(end)
        g.b.start(next)
    }
    g.b.terminate("unreachable")
    g.b.start(end)
    return g.b.value(ty, `load ${ty}, ptr ${result}`)
}

/**
 * `[a, ...b, c]`: an array as long as its single elements and the spread
 * arrays together, the single elements stored and the spread arrays' elements
 * copied in, in order.
 */
function spreadArray(g: Emitter, elemType: Type, values: V[], spread: bool[]): V {
    const elem = g.mt(elemType)
    const size = sizeOf(elem)
    // The length: the single elements, plus the length of each spread array.
    let length = g.i64(0)
    let singles = 0
    for (let i = 0; i < values.length; i++) {
        if (!spread[i]) {
            singles++
            continue
        }
        const n = g.b.value("i64", `load i64, ptr ${g.field(values[i].v, ARRAY, 1)}`)
        length = g.b.value("i64", `add i64 ${length.v}, ${n.v}`)
    }
    length = g.b.value("i64", `add i64 ${length.v}, ${singles}`)
    const array = g.rt("ore_rt_array_new", [{ ty: "i64", v: size }, length])
    const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
    let at = g.i64(0)
    for (let i = 0; i < values.length; i++) {
        const place = g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${at.v}`)
        if (!spread[i]) {
            g.store(values[i], place.v, elemType)
            at = g.b.value("i64", `add i64 ${at.v}, 1`)
            continue
        }
        const n = g.b.value("i64", `load i64, ptr ${g.field(values[i].v, ARRAY, 1)}`)
        const from = g.b.value("ptr", `load ptr, ptr ${g.field(values[i].v, ARRAY, 0)}`)
        const bytes = g.b.value("i64", `mul i64 ${n.v}, ${size}`)
        g.b.emit(`call void @llvm.memmove.p0.p0.i64(ptr ${place.v}, ptr ${from.v}, i64 ${bytes.v}, i1 false)`)
        at = g.b.value("i64", `add i64 ${at.v}, ${n.v}`)
    }
    g.decls.set("@llvm.memmove.p0.p0.i64", "declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)")
    return array
}
