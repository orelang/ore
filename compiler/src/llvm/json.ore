// JSON: an encoder and a decoder generated per type.

import { elementData, entryData } from "./gcdata"
import { type BuiltinCall } from "../ir/nodes"
import {
    arrayOf,
    dictOf,
    fieldOrders,
    intRange,
    jsonProblem,
    ordered,
    sameType,
    typeToString,
    types,
    unionRepr,
    type Field,
    type StructType,
    type Type,
    type UnionType,
} from "../ir/types"
import { error, helper } from "./calls"
import { keyFunctions, keyKind } from "./collections"
import {
    ARRAY,
    JSON_ARRAY,
    JSON_BOOL,
    JSON_CTX,
    JSON_NULL,
    JSON_NUMBER,
    JSON_OBJECT,
    JSON_STRING,
    JSON_VALUE,
    MAP,
    SB,
    STR,
    UNKNOWN,
} from "./context"
import { Emitter } from "./base"
import { choose, constArray, equals, expr, fieldPtr, inject, payload, recast, slotTest, unionOf } from "./expressions"
import { globalName, sizeOf, type V } from "./ll"
import { box, descriptor, descriptorOf, encodeHeld, held, replacingJson, unknownIsNull } from "./unknown"

/**
 * The runtime's class `Date` if a class is it or extends it, or null:
 * console.log and JSON.stringify write a date as its ISO string, through
 * functions of runtime/core/date.ore that take one.
 */
export function dateClass(g: Emitter, t: StructType): StructType | null {
    const hook = g.runtime.get("ore_rt_date_inspect")
    if (hook === null) return null
    const date = hook.params[0].type
    if (date.kind !== "struct") return null
    let c: StructType | null = t
    while (c !== null) {
        if (c.id === date.id) return date
        c = c.base
    }
    return null
}

/**
 * Whether a class is, or extends, the class of the parameter `at` of the
 * runtime function `hook`, as `URL` for console.log and JSON.stringify,
 * which write it through functions of runtime/core/url.ore.
 */
export function hookedClass(g: Emitter, t: StructType, hook: string, at: int): bool {
    const f = g.runtime.get(hook)
    if (f === null) return false
    const target = f.params[at].type
    if (target.kind !== "struct") return false
    let c: StructType | null = t
    while (c !== null) {
        if (c.id === target.id) return true
        c = c.base
    }
    return false
}

/** The runtime's Error class, if `t` is it or a subclass of it. */
export function errorClass(g: Emitter, t: StructType): StructType | null {
    const hook = g.runtime.get("ore_rt_error_inspect")
    if (hook === null) return null
    const error = hook.params[0].type
    if (error.kind !== "struct") return null
    let c: StructType | null = t
    while (c !== null) {
        if (c.id === error.id) return error
        c = c.base
    }
    return null
}

export function json(g: Emitter, e: BuiltinCall): V {
    g.defs.set(SB, `${SB} = type { ptr, i64, i64 }`)
    g.defs.set(JSON_VALUE, `${JSON_VALUE} = type { i32, i8, double, ${STR}, i64, ptr, ptr, ${STR} }`)
    g.defs.set(JSON_CTX, `${JSON_CTX} = type { i8, ${STR}, ${STR} }`)
    if (e.name === "JSON.stringify") {
        // The arguments: the value, the replacer (null, an array of keys or a function), then the space if given.
        const value = expr(g, e.args[0])
        const replacer = e.args.length > 1 && e.args[1].type.kind !== "null" ? expr(g, e.args[1]) : null
        let o: V
        if (e.args.length > 2) {
            const space = expr(g, e.args[2])
            o = g.rt(e.args[2].type.kind === "string" ? "ore_rt_json_gap" : "ore_rt_json_spaces", [space])
        } else o = g.rt("ore_rt_json_spaces", [g.i64(0)])
        const b: V = { ty: "ptr", v: g.b.alloca(SB) }
        g.b.emit(`store ${SB} zeroinitializer, ptr ${b.v}`)
        if (replacer !== null && e.args[1].type.kind === "func") {
            // A function: what it gives for the whole is written, unless it leaves it out (null, JavaScript's undefined).
            g.rt("ore_rt_json_replacer", [o, replacer])
            replacingJson(g)
            const u = unionOf(e.type)
            let text = -1
            let none = -1
            for (let i = 0; i < u.members.length; i++) {
                if (u.members[i].kind === "null") none = i
                else text = i
            }
            const top = replaced(g, o, e.args[0].type, value, g.str(""))
            return choose(
                g,
                omitted(g, top),
                () => inject(g, u, none, null),
                () => {
                    writeReplaced(g, b, top, o, g.i64(0))
                    return inject(g, u, text, g.rt("ore_sb_string", [b]))
                },
                g.lt(u),
            )
        }
        if (replacer !== null) g.rt("ore_rt_json_keep", [o, replacer])
        g.b.emit(`call void ${jsonEncoder(g, e.args[0].type)}(ptr ${b.v}, ${value.ty} ${value.v}, ptr ${o.v}, i64 0)`)
        return g.rt("ore_sb_string", [b])
    }
    // JSON.parse<T>(text, reviver?): parses, then reads a T, or makes an Error from the first problem.
    const typeArgs = e.typeArgs
    if (typeArgs === null || typeArgs.length === 0) process.panic("JSON.parse without a type")
    const target = typeArgs[0]
    const text = expr(g, e.args[0])
    const reviver = e.args.length > 1 ? expr(g, e.args[1]) : null
    // The result is a `T | Error`, or an `unknown` holding either for `JSON.parse<unknown>`.
    const result = e.type
    const rt = g.lt(result)
    const fail = (m: V): V => {
        if (result.kind !== "union") return box(g, error(g, e, m), e.error!.itab.iface)
        const u = unionOf(result)
        let errorIndex = -1
        for (let i = 0; i < u.members.length && errorIndex === -1; i++)
            if (u.members[i].kind === "interface") errorIndex = i
        return inject(g, u, errorIndex, error(g, e, m))
    }
    const ty = g.lt(target)
    // Reads a T from parsed values, or fails with the first problem and where it is.
    const decoded = (parsed: V): V => {
        const c = g.b.alloca(JSON_CTX)
        g.b.emit(`store ${JSON_CTX} zeroinitializer, ptr ${c}`)
        const r = g.b.value(ty, `call ${ty} ${jsonDecoder(g, target)}(ptr ${parsed.v}, ptr ${c})`)
        return choose(
            g,
            jsonFailed(g, c),
            () => fail(g.rt("ore_rt_json_error", [{ ty: "ptr", v: c }])),
            () => recast(g, r, target, result),
            rt,
        )
    }
    // Parses the text into values, then makes the result of them.
    const parsing = (then: (parsed: V) => V): V => {
        const message = g.b.alloca(STR)
        const parsed = g.rt("ore_rt_json_parse", [text, { ty: "ptr", v: message }])
        return choose(
            g,
            g.b.value("i1", `icmp eq ptr ${parsed.v}, null`),
            () => fail(g.b.value(STR, `load ${STR}, ptr ${message}`)),
            () => then(parsed),
            rt,
        )
    }
    if (reviver !== null) {
        // The values pass through the reviver as `unknown`s; what it gives is read as a T.
        return parsing((parsed) => {
            const revived = g.rt("ore_rt_json_revive", [parsed, reviver])
            if (target.kind === "unknown") return revived
            return decoded(g.b.value("ptr", `call ptr ${jsonTree(g)}(${UNKNOWN} ${revived.v})`))
        })
    }
    // The text is read straight into a T first. Should that fail, it is parsed
    // again into values and decoded from them, which finds the error to report.
    const reader = g.rt("ore_rt_json_reader", [text])
    const fc = g.b.alloca(JSON_CTX)
    g.b.emit(`store ${JSON_CTX} zeroinitializer, ptr ${fc}`)
    const fast = g.b.value(ty, `call ${ty} ${jsonReader(g, target)}(ptr ${reader.v}, ptr ${fc})`)
    const read = g.b.value("i1", `xor i1 ${jsonFailed(g, fc).v}, true`)
    const done = g.b.value("i1", `and i1 ${read.v}, ${g.rtBool("ore_rt_json_read_done", [reader]).v}`)
    return choose(
        g,
        done,
        () => recast(g, fast, target, result),
        () => parsing(decoded),
        rt,
    )
}

/**
 * A helper making parsed values of what an `unknown` holds, for the decoder
 * of `JSON.parse` with a reviver: `ptr (unknown u)`. What the parser makes
 * an `unknown` of (an `f64`, a string, a `bool`, null, an `unknown[]` or a
 * dictionary of `unknown`s) converts directly; any other value is written as
 * `JSON.stringify` writes it and parsed again, which keeps an integer exact.
 */
function jsonTree(g: Emitter): string {
    const name = globalName("json.tree")
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    replacingJson(g)
    helper(g, name, `define internal ptr ${name}(${UNKNOWN} %u)`, (e) => {
        const u: V = { ty: UNKNOWN, v: "%u" }
        // Returns what `make` gives when `test` holds.
        const when = (test: V, make: () => V) => {
            const here = e.b.label("tkind")
            const next = e.b.label("tnext")
            e.b.condBr(test, here, next)
            e.b.start(here)
            e.b.terminate(`ret ptr ${make().v}`)
            e.b.start(next)
        }
        const exactly = (t: Type): V => e.b.value("i1", `icmp eq ptr ${descriptorOf(e, u).v}, ${descriptor(e, t)}`)
        const tree = (x: V): V => e.b.value("ptr", `call ptr ${name}(${UNKNOWN} ${x.v})`)
        when(unknownIsNull(e, u), () => e.rt("ore_rt_json_null", []))
        when(exactly(types.f64), () => e.rt("ore_rt_json_number", [held(e, u, types.f64)]))
        when(exactly(types.string), () => e.rt("ore_rt_json_string", [held(e, u, types.string)]))
        when(exactly(types.bool), () => e.rt("ore_rt_json_bool", [held(e, u, types.bool)]))
        const list = arrayOf(types.unknown)
        when(exactly(list), () => {
            const a = held(e, u, list)
            const len = e.b.value("i64", `load i64, ptr ${e.field(a.v, ARRAY, 1)}`)
            const v = e.rt("ore_rt_json_list", [len, { ty: "i1", v: "false" }])
            const elem = e.mt(types.unknown)
            counted(e, len, (i) => {
                const data = e.b.value("ptr", `load ptr, ptr ${e.field(a.v, ARRAY, 0)}`)
                const at = e.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i.v}`)
                e.rt("ore_rt_json_push", [v, e.str(""), tree(e.load(at.v, types.unknown))])
            })
            return v
        })
        const dict = dictOf(types.unknown, false)
        when(exactly(dict), () => {
            const m = held(e, u, dict)
            const count = e.b.value("i64", `load i64, ptr ${e.field(m.v, MAP, 6)}`)
            const v = e.rt("ore_rt_json_list", [count, { ty: "i1", v: "true" }])
            counted(e, count, (i) => {
                const live = e.b.label("live")
                const dead = e.b.label("dead")
                e.b.condBr(e.rtBool("ore_rt_map_live", [m, i]), live, dead)
                e.b.start(live)
                const key = e.load(e.rt("ore_rt_map_key", [m, i]).v, types.string)
                const x = e.load(e.rt("ore_rt_map_value", [m, i]).v, types.unknown)
                e.rt("ore_rt_json_push", [v, key, tree(x)])
                e.b.br(dead)
                e.b.start(dead)
            })
            return v
        })
        // Any other value, written and read again.
        const b: V = { ty: "ptr", v: e.b.alloca(SB) }
        e.b.emit(`store ${SB} zeroinitializer, ptr ${b.v}`)
        encodeHeld(e, u, b, e.rt("ore_rt_json_spaces", [e.i64(0)]), e.i64(0))
        const message = e.b.alloca(STR)
        const parsed = e.rt("ore_rt_json_parse", [e.rt("ore_sb_string", [b]), { ty: "ptr", v: message }])
        e.b.terminate(`ret ptr ${parsed.v}`)
    })
    return name
}

export function jsonFailed(g: Emitter, c: string): V {
    return g.b.value("i1", `trunc i8 ${g.b.value("i8", `load i8, ptr ${g.field(c, JSON_CTX, 0)}`).v} to i1`)
}

/** Puts literal bytes into the string builder `b`. */
export function put(g: Emitter, b: V, text: string) {
    g.rt("ore_sb_put", [b, g.cstr(text), g.i64(text.length)])
}

export function putc(g: Emitter, b: V, c: string) {
    g.rt("ore_sb_putc", [b, g.i64(i64(c[0]))])
}

/** A helper writing a value of a type as JSON: `(ptr b, T v, ptr options, i64 depth)`, the options a runtime `JsonOptions`. */
export function jsonEncoder(g: Emitter, type: Type): string {
    const name = globalName(`json.enc.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(type)
    helper(g, name, `define internal void ${name}(ptr %b, ${ty} %v, ptr %o, i64 %depth)`, (e) => {
        encodeJson(e, type, { ty: "ptr", v: "%b" }, { ty, v: "%v" })
        e.b.terminate("ret void")
    })
    return name
}

export function encodeJson(g: Emitter, type: Type, b: V, v: V) {
    const o: V = { ty: "ptr", v: "%o" }
    const depth: V = { ty: "i64", v: "%depth" }
    const deeper = g.b.value("i64", `add i64 %depth, 1`)
    const encode = (t: Type, x: V) => {
        g.b.emit(`call void ${jsonEncoder(g, t)}(ptr ${b.v}, ${x.ty} ${x.v}, ptr %o, i64 ${deeper.v})`)
    }
    const newline = (d: V) => {
        g.rt("ore_rt_json_newline", [b, o, d])
    }
    const spaceIfIndented = () => {
        const yes = g.b.label("space")
        const no = g.b.label("nospace")
        g.b.condBr(g.rtBool("ore_rt_json_spaced", [o]), yes, no)
        g.b.start(yes)
        putc(g, b, " ")
        g.b.start(no)
    }
    switch (type.kind) {
        case "int":
            if (type.signed) g.rt("ore_rt_json_i64", [b, g.toI64(v)])
            else g.rt("ore_rt_json_u64", [b, g.toI64(v, false)])
            return
        case "float": {
            // JSON has no NaN or infinities: they are written as null, as in JavaScript.
            const ty = g.lt(type)
            const finite = g.b.value("i1", `fcmp oeq ${ty} ${g.b.value(ty, `fsub ${ty} ${v.v}, ${v.v}`).v}, 0.0`)
            const number = g.b.label("number")
            const nonFinite = g.b.label("nonfinite")
            const end = g.b.label("written")
            g.b.condBr(finite, number, nonFinite)
            g.b.start(number)
            const text = g.rt(`ore_rt_str_from_${type.name}`, [v])
            const data = g.extract(text, 0, "ptr")
            const len = g.extract(text, 1, "i64")
            g.rt("ore_sb_put", [b, data, len])
            g.b.br(end)
            g.b.start(nonFinite)
            put(g, b, "null")
            g.b.br(end)
            g.b.start(end)
            return
        }
        case "bool": {
            const t = g.b.label("true")
            const f = g.b.label("false")
            const end = g.b.label("bool")
            g.b.condBr(v, t, f)
            g.b.start(t)
            put(g, b, "true")
            g.b.br(end)
            g.b.start(f)
            put(g, b, "false")
            g.b.start(end)
            return
        }
        case "string":
            g.rt("ore_rt_json_str", [b, v])
            return
        case "unknown":
            // The value it holds, written by the JSON function of its type's descriptor, `null` for none.
            replacingJson(g)
            writeReplaced(g, b, v, o, depth)
            return
        case "literal":
            g.rt("ore_rt_json_str", [b, v])
            return
        case "union": {
            if (unionRepr(type).k === "strings") {
                g.rt("ore_rt_json_str", [b, v])
                return
            }
            const end = g.b.label("encoded")
            for (let i = 0; i < type.members.length; i++) {
                const m = type.members[i]
                const here = g.b.label("jmember")
                const next = g.b.label("jnext")
                g.b.condBr(slotTest(g, type, v, i), here, next)
                g.b.start(here)
                if (m.kind === "null") put(g, b, "null")
                else {
                    const encoder = jsonEncoder(g, m)
                    const mt = g.lt(m)
                    const p = payload(g, type, v, i)
                    g.b.emit(`call void ${encoder}(ptr ${b.v}, ${mt} ${p.v}, ptr %o, i64 %depth)`)
                }
                g.b.br(end)
                g.b.start(next)
            }
            g.b.start(end)
            return
        }
        case "array": {
            const elemType = type.elem
            const elem = g.mt(elemType)
            putc(g, b, "[")
            const len = g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
            counted(g, len, (i) => {
                commaAfterFirst(g, b, i)
                newline(deeper)
                const data = g.b.value("ptr", `load ptr, ptr ${g.field(v.v, ARRAY, 0)}`)
                encode(
                    elemType,
                    g.load(g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i.v}`).v, elemType),
                )
            })
            ifNonZero(g, len, () => newline(depth))
            putc(g, b, "]")
            return
        }
        case "map": {
            const keyType = type.key
            const valueType = type.value
            putc(g, b, "{")
            const n = g.b.alloca("i64")
            g.b.emit(`store i64 0, ptr ${n}`)
            const count = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 6)}`)
            // With a replacer array, a pass over the entries for each of its keys, in its order.
            counted(g, g.rt("ore_rt_json_rounds", [o]), (round) => {
                counted(g, count, (i) => {
                    const live = g.b.label("live")
                    const dead = g.b.label("dead")
                    g.b.condBr(g.rtBool("ore_rt_map_live", [v, i]), live, dead)
                    g.b.start(live)
                    const key = g.load(g.rt("ore_rt_map_key", [v, i]).v, keyType)
                    const kept = g.b.label("kept")
                    g.b.condBr(g.rtBool("ore_rt_json_kept", [o, round, key]), kept, dead)
                    g.b.start(kept)
                    const written = g.b.value("i64", `load i64, ptr ${n}`)
                    commaAfterFirst(g, b, written)
                    g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${written.v}, 1`).v}, ptr ${n}`)
                    newline(deeper)
                    g.rt("ore_rt_json_str", [b, key])
                    putc(g, b, ":")
                    spaceIfIndented()
                    encode(valueType, g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType))
                    g.b.start(dead)
                })
            })
            ifNonZero(g, g.b.value("i64", `load i64, ptr ${n}`), () => newline(depth))
            putc(g, b, "}")
            return
        }
        case "struct": {
            if (dateClass(g, type) !== null) {
                // A date is its toJSON(): its ISO string, or null.
                const text = g.rt("ore_rt_date_json", [v])
                g.rt("ore_sb_put", [b, g.extract(text, 0, "ptr"), g.extract(text, 1, "i64")])
                return
            }
            if (hookedClass(g, type, "ore_rt_url_json", 0)) {
                // A URL is its toJSON(): its href.
                const text = g.rt("ore_rt_url_json", [v])
                g.rt("ore_sb_put", [b, g.extract(text, 0, "ptr"), g.extract(text, 1, "i64")])
                return
            }
            if (hookedClass(g, type, "ore_rt_blob_json", 0)) {
                // A blob has no properties of its own: `{}`.
                const text = g.rt("ore_rt_blob_json", [v])
                g.rt("ore_sb_put", [b, g.extract(text, 0, "ptr"), g.extract(text, 1, "i64")])
                return
            }
            if (hookedClass(g, type, "ore_rt_formdata_json", 0)) {
                // A FormData has no properties of its own: `{}`.
                const text = g.rt("ore_rt_formdata_json", [v])
                g.rt("ore_sb_put", [b, g.extract(text, 0, "ptr"), g.extract(text, 1, "i64")])
                return
            }
            if (type.tuple) {
                // A tuple is an array.
                putc(g, b, "[")
                for (let i = 0; i < type.fields.length; i++) {
                    const f = type.fields[i]
                    if (i > 0) putc(g, b, ",")
                    newline(deeper)
                    encode(f.type, g.load(fieldPtr(g, v.v, type, f.name), f.type))
                }
                if (type.fields.length > 0) newline(depth)
                putc(g, b, "]")
                return
            }
            putc(g, b, "{")
            // With a replacer array, the fields named by its keys, in its order.
            const count = g.rt("ore_rt_json_key_count", [o])
            const keyed = g.b.label("keyed")
            const plain = g.b.label("plain")
            g.b.condBr(g.b.value("i1", `icmp sge i64 ${count.v}, 0`), keyed, plain)
            g.b.start(keyed)
            const kept = g.b.alloca("i64")
            g.b.emit(`store i64 0, ptr ${kept}`)
            const struct: StructType = type
            counted(g, count, (i) => {
                const key = g.rt("ore_rt_json_key_at", [o, i])
                for (const f of struct.fields) {
                    const here = g.b.label("field")
                    const next = g.b.label("nextfield")
                    g.b.condBr(equals(g, key, g.str(f.name), types.string), here, next)
                    g.b.start(here)
                    const x = g.load(fieldPtr(g, v.v, struct, f.name), f.type)
                    const ft = f.type
                    if (f.optional && ft.kind === "union") {
                        let at = -1
                        for (let j = 0; j < ft.members.length; j++) if (ft.members[j].kind === "null") at = j
                        const present = g.b.label("present")
                        g.b.condBr(slotTest(g, ft, x, at), next, present)
                        g.b.start(present)
                    }
                    const written = g.b.value("i64", `load i64, ptr ${kept}`)
                    commaAfterFirst(g, b, written)
                    g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${written.v}, 1`).v}, ptr ${kept}`)
                    newline(deeper)
                    put(g, b, `${JSON.stringify(f.name)}:`)
                    spaceIfIndented()
                    encode(f.type, x)
                    g.b.br(next)
                    g.b.start(next)
                }
            })
            ifNonZero(g, g.b.value("i64", `load i64, ptr ${kept}`), () => newline(depth))
            putc(g, b, "}")
            g.b.terminate("ret void")
            g.b.start(plain)
            // In the order of the object, of a type that may be made in several.
            g.inOrder(v, type, (shown) => {
                if (struct.fields.some((f) => f.optional)) {
                    // Optional fields that are null are left out, as JavaScript leaves out undefined.
                    const written = g.b.alloca("i64")
                    g.b.emit(`store i64 0, ptr ${written}`)
                    for (const f of shown) {
                        const x = g.load(fieldPtr(g, v.v, struct, f.name), f.type)
                        const ft = f.type
                        const skip = g.b.label("absent")
                        if (f.optional && ft.kind === "union") {
                            let at = -1
                            for (let i = 0; i < ft.members.length; i++) if (ft.members[i].kind === "null") at = i
                            const present = g.b.label("present")
                            g.b.condBr(slotTest(g, ft, x, at), skip, present)
                            g.b.start(present)
                        }
                        const count = g.b.value("i64", `load i64, ptr ${written}`)
                        commaAfterFirst(g, b, count)
                        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${count.v}, 1`).v}, ptr ${written}`)
                        newline(deeper)
                        put(g, b, `${JSON.stringify(f.name)}:`)
                        spaceIfIndented()
                        encode(f.type, x)
                        g.b.br(skip)
                        g.b.start(skip)
                    }
                    ifNonZero(g, g.b.value("i64", `load i64, ptr ${written}`), () => newline(depth))
                    putc(g, b, "}")
                    return
                }
                for (let i = 0; i < shown.length; i++) {
                    const f = shown[i]
                    if (i > 0) putc(g, b, ",")
                    newline(deeper)
                    put(g, b, `${JSON.stringify(f.name)}:`)
                    spaceIfIndented()
                    encode(f.type, g.load(fieldPtr(g, v.v, struct, f.name), f.type))
                }
                if (struct.fields.length > 0) newline(depth)
                putc(g, b, "}")
            })
            return
        }
        default:
            put(g, b, "null")
    }
}

/**
 * The value at `key` passed through the replacer function of the options
 * `o`: boxed, and a date or a URL as its `toJSON()`, which JavaScript calls
 * first.
 */
function replaced(g: Emitter, o: V, t: Type, v: V, key: V): V {
    let boxed = box(g, v, t)
    for (const hook of ["ore_rt_date_json_value", "ore_rt_url_json_value"])
        if (g.runtime.get(hook) !== null) boxed = g.rt(hook, [boxed])
    return g.rt("ore_rt_json_replace", [o, key, boxed])
}

/** Whether a replacer left a value out: it returned `JSON.omit` or a function. */
function omitted(g: Emitter, u: V): V {
    return g.rtBool("ore_rt_json_omits", [u])
}

/** Writes a value a replacer returned, not left out: `@json.any`. */
function writeReplaced(g: Emitter, b: V, u: V, o: V, depth: V) {
    const name = globalName("json.any")
    if (!g.helpers.has(name)) {
        g.helpers.set(name, "")
        helper(g, name, `define internal void ${name}(ptr %b, ${UNKNOWN} %u, ptr %o, i64 %depth)`, (e) => {
            const held: V = { ty: UNKNOWN, v: "%u" }
            const isNull = e.b.label("anynull")
            const present = e.b.label("anyheld")
            e.b.condBr(unknownIsNull(e, held), isNull, present)
            e.b.start(isNull)
            put(e, { ty: "ptr", v: "%b" }, "null")
            e.b.terminate("ret void")
            e.b.start(present)
            encodeHeld(e, held, { ty: "ptr", v: "%b" }, { ty: "ptr", v: "%o" }, { ty: "i64", v: "%depth" })
            e.b.terminate("ret void")
        })
    }
    g.b.emit(`call void ${name}(ptr ${b.v}, ${UNKNOWN} ${u.v}, ptr ${o.v}, i64 ${depth.v})`)
}

/** Whether a type has values whose parts go through a replacer: arrays, maps, objects and classes but dates, URLs, blobs and FormData. */
function hasParts(g: Emitter, t: Type): bool {
    if (t.kind === "array" || t.kind === "map") return true
    return (
        t.kind === "struct" &&
        dateClass(g, t) === null &&
        !hookedClass(g, t, "ore_rt_url_json", 0) &&
        !hookedClass(g, t, "ore_rt_blob_json", 0) &&
        !hookedClass(g, t, "ore_rt_formdata_json", 0)
    )
}

/**
 * The JSON function of a descriptor (llvm/unknown.ore), which writes the
 * value held at `%p` through the replacer function of the options:
 * `(ptr p, ptr b, ptr options, i64 depth)`. It panics for a type that JSON
 * cannot convert.
 */
export function jsonHeld(g: Emitter, t: Type): string {
    const name = globalName(`json.held.${g.names.key(t)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    helper(g, name, `define internal void ${name}(ptr %p, ptr %b, ptr %o, i64 %depth)`, (e) => {
        if (jsonProblem(t) !== null) {
            e.panic(`JSON.stringify: a value of type ${typeToString(t)} cannot be converted to JSON`)
            return
        }
        const v = e.load("%p", t)
        const args = `(ptr %b, ${v.ty} ${v.v}, ptr %o, i64 %depth)`
        if (!hasParts(e, t)) {
            e.b.emit(`call void ${jsonEncoder(e, t)}${args}`)
            e.b.terminate("ret void")
            return
        }
        // The parts go through the replacer function if there is one; an `unknown` written
        // without one is written as its value would be, a replacer array applied.
        const replacing = e.b.label("replacing")
        const plain = e.b.label("plain")
        e.b.condBr(e.rtBool("ore_rt_json_replacing", [{ ty: "ptr", v: "%o" }]), replacing, plain)
        e.b.start(replacing)
        e.b.emit(`call void ${jsonReplacer(e, t)}${args}`)
        e.b.terminate("ret void")
        e.b.start(plain)
        e.b.emit(`call void ${jsonEncoder(e, t)}${args}`)
        e.b.terminate("ret void")
    })
    return name
}

/** A helper writing an array, map, object or class through the replacer function of the options: `(ptr b, T v, ptr options, i64 depth)`. */
function jsonReplacer(g: Emitter, type: Type): string {
    const name = globalName(`json.rep.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(type)
    helper(g, name, `define internal void ${name}(ptr %b, ${ty} %v, ptr %o, i64 %depth)`, (e) => {
        encodeReplaced(e, type, { ty: "ptr", v: "%b" }, { ty, v: "%v" })
        e.b.terminate("ret void")
    })
    return name
}

/**
 * Writes the parts of a value, each the value the replacer function gives
 * for it with its key (the index of an element as a string): a part it
 * leaves out is not written, or written as `null` in an array, as in
 * JavaScript.
 */
function encodeReplaced(g: Emitter, type: Type, b: V, v: V) {
    const o: V = { ty: "ptr", v: "%o" }
    const depth: V = { ty: "i64", v: "%depth" }
    const deeper = g.b.value("i64", `add i64 %depth, 1`)
    const newline = (d: V) => {
        g.rt("ore_rt_json_newline", [b, o, d])
    }
    // An element of an array or a tuple.
    const element = (i: V, t: Type, x: V) => {
        commaAfterFirst(g, b, i)
        newline(deeper)
        const u = replaced(g, o, t, x, g.rt("ore_rt_str_from_i64", [i]))
        const left = g.b.label("left")
        const kept = g.b.label("kept")
        const end = g.b.label("element")
        g.b.condBr(omitted(g, u), left, kept)
        g.b.start(left)
        put(g, b, "null")
        g.b.br(end)
        g.b.start(kept)
        writeReplaced(g, b, u, o, deeper)
        g.b.br(end)
        g.b.start(end)
    }
    // A property of an object, counted in `written` when it is not left out.
    const written = g.b.alloca("i64")
    g.b.emit(`store i64 0, ptr ${written}`)
    const property = (key: V, t: Type, x: V) => {
        const u = replaced(g, o, t, x, key)
        const kept = g.b.label("kept")
        const end = g.b.label("property")
        g.b.condBr(omitted(g, u), end, kept)
        g.b.start(kept)
        const count = g.b.value("i64", `load i64, ptr ${written}`)
        commaAfterFirst(g, b, count)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${count.v}, 1`).v}, ptr ${written}`)
        newline(deeper)
        g.rt("ore_rt_json_str", [b, key])
        putc(g, b, ":")
        const space = g.b.label("space")
        const value = g.b.label("value")
        g.b.condBr(g.rtBool("ore_rt_json_spaced", [o]), space, value)
        g.b.start(space)
        putc(g, b, " ")
        g.b.br(value)
        g.b.start(value)
        writeReplaced(g, b, u, o, deeper)
        g.b.br(end)
        g.b.start(end)
    }
    const closeObject = () => {
        ifNonZero(g, g.b.value("i64", `load i64, ptr ${written}`), () => newline(depth))
        putc(g, b, "}")
    }
    switch (type.kind) {
        case "array": {
            const elemType = type.elem
            const elem = g.mt(elemType)
            putc(g, b, "[")
            const len = g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
            counted(g, len, (i) => {
                const data = g.b.value("ptr", `load ptr, ptr ${g.field(v.v, ARRAY, 0)}`)
                const at = g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i.v}`)
                element(i, elemType, g.load(at.v, elemType))
            })
            ifNonZero(g, len, () => newline(depth))
            putc(g, b, "]")
            return
        }
        case "map": {
            const keyType = type.key
            const valueType = type.value
            putc(g, b, "{")
            const count = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 6)}`)
            counted(g, count, (i) => {
                const live = g.b.label("live")
                const dead = g.b.label("dead")
                g.b.condBr(g.rtBool("ore_rt_map_live", [v, i]), live, dead)
                g.b.start(live)
                const key = g.load(g.rt("ore_rt_map_key", [v, i]).v, keyType)
                property(key, valueType, g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType))
                g.b.br(dead)
                g.b.start(dead)
            })
            closeObject()
            return
        }
        case "struct": {
            if (type.tuple) {
                putc(g, b, "[")
                for (let i = 0; i < type.fields.length; i++) {
                    const f = type.fields[i]
                    element(g.i64(i), f.type, g.load(fieldPtr(g, v.v, type, f.name), f.type))
                }
                if (type.fields.length > 0) newline(depth)
                putc(g, b, "]")
                return
            }
            putc(g, b, "{")
            const struct: StructType = type
            g.inOrder(v, struct, (shown) => {
                for (const f of shown) {
                    const x = g.load(fieldPtr(g, v.v, struct, f.name), f.type)
                    const ft = f.type
                    // An optional field that is null is no property, as JavaScript's undefined one: the replacer does not see it.
                    const end = g.b.label("absent")
                    if (f.optional && ft.kind === "union") {
                        let at = -1
                        for (let i = 0; i < ft.members.length; i++) if (ft.members[i].kind === "null") at = i
                        const present = g.b.label("present")
                        g.b.condBr(slotTest(g, ft, x, at), end, present)
                        g.b.start(present)
                    }
                    property(g.str(f.name), ft, x)
                    g.b.br(end)
                    g.b.start(end)
                }
            })
            closeObject()
            return
        }
        default:
            process.panic(`no parts in ${typeToString(type)}`)
    }
}

/** Runs `body` for i from 0 to n - 1. */
export function counted(g: Emitter, n: V, body: (i: V) => void) {
    const i = g.b.alloca("i64")
    g.b.emit(`store i64 0, ptr ${i}`)
    const head = g.b.label("chead")
    const loop = g.b.label("cbody")
    const end = g.b.label("cend")
    g.b.start(head)
    const at = g.b.value("i64", `load i64, ptr ${i}`)
    g.b.condBr(g.b.value("i1", `icmp slt i64 ${at.v}, ${n.v}`), loop, end)
    g.b.start(loop)
    body(at)
    g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${at.v}, 1`).v}, ptr ${i}`)
    g.b.br(head)
    g.b.start(end)
}

export function ifNonZero(g: Emitter, n: V, body: () => void) {
    const yes = g.b.label("nonzero")
    const end = g.b.label("zero")
    g.b.condBr(g.b.value("i1", `icmp ne i64 ${n.v}, 0`), yes, end)
    g.b.start(yes)
    body()
    g.b.start(end)
}

export function commaAfterFirst(g: Emitter, b: V, i: V) {
    ifNonZero(g, i, () => putc(g, b, ","))
}

/** A helper reading a value of a type from a parsed JSON value: `T (ptr v, ptr c)`. */
export function jsonDecoder(g: Emitter, type: Type): string {
    const name = globalName(`json.dec.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(type)
    helper(g, name, `define internal ${ty} ${name}(ptr %v, ptr %c)`, (e) => decodeJson(e, type))
    return name
}

/** The state of `decodeJson`: the closures of the TypeScript, as methods. */
class Decoder {
    ty: string
    v: V = { ty: "ptr", v: "%v" }
    c: V = { ty: "ptr", v: "%c" }

    constructor(
        public g: Emitter,
        public type: Type,
    ) {
        this.ty = g.lt(type)
    }

    fail() {
        const g = this.g
        g.b.terminate(this.ty === "void" ? "ret void" : `ret ${this.ty} ${g.zero(this.type).v}`)
    }

    kind(): V {
        const g = this.g
        return g.b.value("i32", `load i32, ptr ${g.field("%v", JSON_VALUE, 0)}`)
    }

    /** Fails unless the JSON value has a kind, with "expected <what>". */
    expect(k: int, what: string) {
        const g = this.g
        const ok = g.b.label("kind")
        const bad = g.b.label("badkind")
        g.b.condBr(g.b.value("i1", `icmp eq i32 ${this.kind().v}, ${k}`), ok, bad)
        g.b.start(bad)
        g.rt("ore_rt_json_expected", [this.c, g.cstr(what), this.v])
        this.fail()
        g.b.start(ok)
    }

    failedHere(onFail: () => void) {
        const g = this.g
        const bad = g.b.label("failed")
        const ok = g.b.label("fine")
        g.b.condBr(jsonFailed(g, "%c"), bad, ok)
        g.b.start(bad)
        onFail()
        this.fail()
        g.b.start(ok)
    }

    ret(x: V) {
        this.g.b.terminate(`ret ${this.ty} ${x.v}`)
    }
}

export function decodeJson(g: Emitter, type: Type) {
    const d = new Decoder(g, type)
    const ty = d.ty
    const v = d.v
    const c = d.c
    switch (type.kind) {
        case "int": {
            const out = g.b.alloca("i64")
            const range = intRange(type)
            const max = g.i64(i64(range.max))
            const ok = type.signed
                ? g.rtBool("ore_rt_json_int", [c, v, g.i64(range.min), max, { ty: "ptr", v: out }])
                : g.rtBool("ore_rt_json_uint", [c, v, max, { ty: "ptr", v: out }])
            const good = g.b.label("int")
            const bad = g.b.label("badint")
            g.b.condBr(ok, good, bad)
            g.b.start(bad)
            d.fail()
            g.b.start(good)
            d.ret(g.fromI64(g.b.value("i64", `load i64, ptr ${out}`), ty))
            return
        }
        case "float": {
            d.expect(JSON_NUMBER, "a number")
            const num = g.b.value("double", `load double, ptr ${g.field("%v", JSON_VALUE, 2)}`)
            d.ret(type.bits === 32 ? g.b.value("float", `fptrunc double ${num.v} to float`) : num)
            return
        }
        case "bool":
            d.expect(JSON_BOOL, "a boolean")
            d.ret(
                g.b.value("i1", `trunc i8 ${g.b.value("i8", `load i8, ptr ${g.field("%v", JSON_VALUE, 1)}`).v} to i1`),
            )
            return
        case "string":
            d.expect(JSON_STRING, "a string")
            d.ret(g.b.value(STR, `load ${STR}, ptr ${g.field("%v", JSON_VALUE, 3)}`))
            return
        case "literal": {
            const what = JSON.stringify(type.value)
            d.expect(JSON_STRING, what)
            const s = g.b.value(STR, `load ${STR}, ptr ${g.field("%v", JSON_VALUE, 3)}`)
            checkOr(
                g,
                g.rtBool("ore_rt_str_eq", [s, g.str(type.value)]),
                () => {
                    g.rt("ore_rt_json_expected", [c, g.cstr(what), v])
                },
                () => d.fail(),
            )
            d.ret(s)
            return
        }
        case "union": {
            if (unionRepr(type).k === "strings") {
                let hasString = false
                for (const m of type.members) if (m.kind === "string") hasString = true
                if (hasString) {
                    d.expect(JSON_STRING, "a string")
                    d.ret(g.b.value(STR, `load ${STR}, ptr ${g.field("%v", JSON_VALUE, 3)}`))
                    return
                }
                const literals: string[] = []
                const quoted: string[] = []
                for (const m of type.members) {
                    const l = m.kind === "literal" ? m.value : ""
                    literals.push(l)
                    quoted.push(JSON.stringify(l))
                }
                const what = quoted.join(" or ")
                const isString = g.b.value("i1", `icmp eq i32 ${d.kind().v}, ${JSON_STRING}`)
                checkOr(
                    g,
                    isString,
                    () => {
                        g.rt("ore_rt_json_expected", [c, g.cstr(what), v])
                    },
                    () => d.fail(),
                )
                const s = g.b.value(STR, `load ${STR}, ptr ${g.field("%v", JSON_VALUE, 3)}`)
                let any: V = { ty: "i1", v: "false" }
                for (const l of literals) {
                    const eq = g.rtBool("ore_rt_str_eq", [s, g.str(l)])
                    any = g.b.value("i1", `or i1 ${any.v}, ${eq.v}`)
                }
                checkOr(
                    g,
                    any,
                    () => {
                        g.rt("ore_rt_json_expected", [c, g.cstr(what), v])
                    },
                    () => d.fail(),
                )
                d.ret(s)
                return
            }
            let nullIndex = -1
            const others: int[] = []
            for (let i = 0; i < type.members.length; i++) {
                if (type.members[i].kind === "null") {
                    if (nullIndex === -1) nullIndex = i
                } else others.push(i)
            }
            if (nullIndex >= 0) {
                const isNull = g.b.label("jnull")
                const notNull = g.b.label("jnotnull")
                g.b.condBr(g.b.value("i1", `icmp eq i32 ${d.kind().v}, ${JSON_NULL}`), isNull, notNull)
                g.b.start(isNull)
                d.ret(inject(g, type, nullIndex, null))
                g.b.start(notNull)
            }
            // One possibility reports its own error; several are tried in order.
            if (others.length === 1) {
                const i = others[0]
                const mt = g.lt(type.members[i])
                const x = g.b.value(mt, `call ${mt} ${jsonDecoder(g, type.members[i])}(ptr %v, ptr %c)`)
                d.failedHere(() => {})
                d.ret(inject(g, type, i, x))
                return
            }
            for (const i of others) {
                const t = g.b.alloca(JSON_CTX)
                g.b.emit(`store ${JSON_CTX} zeroinitializer, ptr ${t}`)
                const mt = g.lt(type.members[i])
                const x = g.b.value(mt, `call ${mt} ${jsonDecoder(g, type.members[i])}(ptr %v, ptr ${t})`)
                const ok = g.b.label("tried")
                const next = g.b.label("trynext")
                g.b.condBr(jsonFailed(g, t), next, ok)
                g.b.start(ok)
                d.ret(inject(g, type, i, x))
                g.b.start(next)
            }
            g.rt("ore_rt_json_expected", [c, g.cstr(typeToString(type)), v])
            d.fail()
            return
        }
        case "array": {
            d.expect(JSON_ARRAY, "an array")
            const elemType = type.elem
            const elem = g.mt(elemType)
            const len = g.b.value("i64", `load i64, ptr ${g.field("%v", JSON_VALUE, 4)}`)
            const a = g.rt("ore_rt_array_new", [{ ty: "i64", v: sizeOf(elem) }, len, elementData(g, elem)])
            const items = g.b.value("ptr", `load ptr, ptr ${g.field("%v", JSON_VALUE, 5)}`)
            counted(g, len, (i) => {
                const item = g.b.value(
                    "ptr",
                    `load ptr, ptr ${g.b.value("ptr", `getelementptr ptr, ptr ${items.v}, i64 ${i.v}`).v}`,
                )
                const et = g.lt(elemType)
                const x = g.b.value(et, `call ${et} ${jsonDecoder(g, elemType)}(ptr ${item.v}, ptr %c)`)
                d.failedHere(() => {
                    g.rt("ore_rt_json_at_index", [c, i])
                })
                const data = g.b.value("ptr", `load ptr, ptr ${g.field(a.v, ARRAY, 0)}`)
                g.store(x, g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i.v}`).v, elemType)
            })
            d.ret(a)
            return
        }
        case "map": {
            d.expect(JSON_OBJECT, "an object")
            const keyType = type.key
            const valueType = type.value
            const keys = keyFunctions(g, keyType)
            const kt = g.mt(keyType)
            const vt = g.mt(valueType)
            const m = g.rt("ore_rt_map_new", [
                { ty: "i64", v: sizeOf(kt) },
                { ty: "i64", v: sizeOf(vt) },
                { ty: "ptr", v: keys.hash },
                { ty: "ptr", v: keys.eq },
                elementData(g, kt),
                elementData(g, vt),
                entryData(g, kt, vt),
                { ty: "i64", v: keyKind(g, keyType) },
            ])
            const len = g.b.value("i64", `load i64, ptr ${g.field("%v", JSON_VALUE, 4)}`)
            const items = g.b.value("ptr", `load ptr, ptr ${g.field("%v", JSON_VALUE, 5)}`)
            const names = g.b.value("ptr", `load ptr, ptr ${g.field("%v", JSON_VALUE, 6)}`)
            counted(g, len, (i) => {
                // Keys are read as JSON strings, so that literal key types are checked.
                const keyText = g.b.value(
                    STR,
                    `load ${STR}, ptr ${g.b.value("ptr", `getelementptr ${STR}, ptr ${names.v}, i64 ${i.v}`).v}`,
                )
                const keyJson = g.b.alloca(JSON_VALUE)
                g.b.emit(`store ${JSON_VALUE} zeroinitializer, ptr ${keyJson}`)
                g.b.emit(`store i32 ${JSON_STRING}, ptr ${g.field(keyJson, JSON_VALUE, 0)}`)
                g.b.emit(`store ${STR} ${keyText.v}, ptr ${g.field(keyJson, JSON_VALUE, 3)}`)
                const kl = g.lt(keyType)
                const k = g.b.value(kl, `call ${kl} ${jsonDecoder(g, keyType)}(ptr ${keyJson}, ptr %c)`)
                d.failedHere(() => {
                    g.rt("ore_rt_json_at_field", [c, g.rt("ore_rt_cstring", [keyText])])
                })
                const item = g.b.value(
                    "ptr",
                    `load ptr, ptr ${g.b.value("ptr", `getelementptr ptr, ptr ${items.v}, i64 ${i.v}`).v}`,
                )
                const vl = g.lt(valueType)
                const x = g.b.value(vl, `call ${vl} ${jsonDecoder(g, valueType)}(ptr ${item.v}, ptr %c)`)
                d.failedHere(() => {
                    g.rt("ore_rt_json_at_field", [c, g.rt("ore_rt_cstring", [keyText])])
                })
                const kp = g.b.alloca(kt)
                g.store(k, kp, keyType)
                const xp = g.b.alloca(vt)
                g.store(x, xp, valueType)
                g.rt("ore_rt_map_set", [m, { ty: "ptr", v: kp }, { ty: "ptr", v: xp }])
            })
            // The named entries of a dictionary: there unless optional, and of their own types.
            for (const f of type.members) {
                const name = g.cstr(f.name)
                const found = g.rt("ore_rt_json_field", [v, name, g.i64(f.name.length)])
                const present = g.b.label("present")
                const next = g.b.label("nextentry")
                if (f.optional) g.b.condBr(g.b.value("i1", `icmp ne ptr ${found.v}, null`), present, next)
                else {
                    const missing = g.b.label("missing")
                    g.b.condBr(g.b.value("i1", `icmp ne ptr ${found.v}, null`), present, missing)
                    g.b.start(missing)
                    g.rt("ore_rt_json_missing", [c, name])
                    d.fail()
                }
                g.b.start(present)
                if (!sameType(f.type, valueType)) {
                    const fl = g.lt(f.type)
                    g.b.value(fl, `call ${fl} ${jsonDecoder(g, f.type)}(ptr ${found.v}, ptr %c)`)
                    d.failedHere(() => {
                        g.rt("ore_rt_json_at_field", [c, name])
                    })
                }
                g.b.br(next)
                g.b.start(next)
            }
            d.ret(m)
            return
        }
        case "struct": {
            if (type.tuple) {
                d.expect(JSON_ARRAY, "an array")
                const n = type.fields.length
                // Optional elements, `T?`, can be left out of the array: they are null.
                let required = 0
                while (required < n && !type.fields[required].optional) required++
                const len = g.b.value("i64", `load i64, ptr ${g.field("%v", JSON_VALUE, 4)}`)
                const right = g.b.label("length")
                const wrong = g.b.label("badlength")
                const fits =
                    required === n
                        ? g.b.value("i1", `icmp eq i64 ${len.v}, ${n}`)
                        : g.b.value(
                              "i1",
                              `and i1 ${g.b.value("i1", `icmp sge i64 ${len.v}, ${required}`).v}, ${g.b.value("i1", `icmp sle i64 ${len.v}, ${n}`).v}`,
                          )
                g.b.condBr(fits, right, wrong)
                g.b.start(wrong)
                g.rt("ore_rt_json_length", [d.c, g.i64(n), len])
                d.fail()
                g.b.start(right)
                const t = g.alloc(g.structType(type))
                const items = g.b.value("ptr", `load ptr, ptr ${g.field("%v", JSON_VALUE, 5)}`)
                for (let i = 0; i < n; i++) {
                    const f = type.fields[i]
                    const ft_ = f.type
                    let next = ""
                    if (i >= required && ft_.kind === "union") {
                        let nullIndex = -1
                        for (let j = 0; j < ft_.members.length; j++) if (ft_.members[j].kind === "null") nullIndex = j
                        const present = g.b.label("present")
                        const missing = g.b.label("missing")
                        next = g.b.label("nextelem")
                        g.b.condBr(g.b.value("i1", `icmp slt i64 ${i}, ${len.v}`), present, missing)
                        g.b.start(missing)
                        g.store(inject(g, ft_, nullIndex, null), fieldPtr(g, t.v, type, f.name), f.type)
                        g.b.br(next)
                        g.b.start(present)
                    }
                    const item = g.b.value(
                        "ptr",
                        `load ptr, ptr ${g.b.value("ptr", `getelementptr ptr, ptr ${items.v}, i64 ${i}`).v}`,
                    )
                    const ft = g.lt(f.type)
                    const x = g.b.value(ft, `call ${ft} ${jsonDecoder(g, f.type)}(ptr ${item.v}, ptr %c)`)
                    d.failedHere(() => {
                        g.rt("ore_rt_json_at_index", [d.c, g.i64(i)])
                    })
                    g.store(x, fieldPtr(g, t.v, type, f.name), f.type)
                    if (next !== "") {
                        g.b.br(next)
                        g.b.start(next)
                    }
                }
                d.ret(t)
                return
            }
            d.expect(JSON_OBJECT, "an object")
            const s = g.structType(type)
            const o = g.alloc(s)
            g.setTable(o, type)
            for (const f of type.fields) {
                const name = g.cstr(f.name)
                const found = g.rt("ore_rt_json_field", [v, name, g.i64(f.name.length)])
                const target = fieldPtr(g, o.v, type, f.name)
                const present = g.b.label("present")
                const missing = g.b.label("missing")
                const next = g.b.label("nextfield")
                g.b.condBr(g.b.value("i1", `icmp ne ptr ${found.v}, null`), present, missing)
                g.b.start(missing)
                const ft = f.type
                let nullIndex = -1
                if (ft.kind === "union") {
                    for (let i = 0; i < ft.members.length && nullIndex === -1; i++)
                        if (ft.members[i].kind === "null") nullIndex = i
                }
                if (ft.kind === "union" && nullIndex >= 0) {
                    g.store(inject(g, ft, nullIndex, null), target, f.type)
                    g.b.br(next)
                } else {
                    g.rt("ore_rt_json_missing", [c, name])
                    d.fail()
                }
                g.b.start(present)
                const fl = g.lt(f.type)
                const x = g.b.value(fl, `call ${fl} ${jsonDecoder(g, f.type)}(ptr ${found.v}, ptr %c)`)
                d.failedHere(() => {
                    g.rt("ore_rt_json_at_field", [c, name])
                })
                g.store(x, target, f.type)
                g.b.start(next)
            }
            if (ordered(type)) {
                // The order of the keys in the text, which the fields were looked up by.
                const struct: StructType = type
                const order = new TextOrder(g, struct)
                const seen: string[] = []
                for (const _ of struct.fields) {
                    const flag = g.b.alloca("i1")
                    g.b.emit(`store i1 false, ptr ${flag}`)
                    seen.push(flag)
                }
                const len = g.b.value("i64", `load i64, ptr ${g.field("%v", JSON_VALUE, 4)}`)
                const names = g.b.value("ptr", `load ptr, ptr ${g.field("%v", JSON_VALUE, 6)}`)
                counted(g, len, (i) => {
                    const at = g.b.value("ptr", `getelementptr ${STR}, ptr ${names.v}, i64 ${i.v}`)
                    const key = g.b.value(STR, `load ${STR}, ptr ${at.v}`)
                    for (let k = 0; k < struct.fields.length; k++) {
                        const f = struct.fields[k]
                        const here = g.b.label("okey")
                        const other = g.b.label("onext")
                        g.b.condBr(g.rtBool("ore_rt_str_eq", [key, g.str(f.name)]), here, other)
                        g.b.start(here)
                        order.seen(f, seen[k])
                        g.b.emit(`store i1 true, ptr ${seen[k]}`)
                        g.b.br(other)
                        g.b.start(other)
                    }
                })
                order.set(o)
            }
            d.ret(o)
            return
        }
        case "unknown":
            // Any value, untyped: numbers as `f64`s, arrays as `unknown[]`s, objects as dictionaries.
            d.ret(g.rt("ore_rt_json_untyped", [v]))
            return
        default:
            g.rt("ore_rt_json_expected", [c, g.cstr("a value"), v])
            d.fail()
    }
}

/**
 * The order of an object that JSON.parse makes, of a type made in several:
 * as JavaScript adds the properties in the order of the text, the first of
 * the type's orders that starts with the fields in the order the text gives
 * them, or the first order when none does. `mask` has a bit for each order
 * that still can be, `rank` the number of fields seen.
 */
class TextOrder {
    rank: string
    mask: string

    constructor(
        readonly g: Emitter,
        readonly type: StructType,
    ) {
        this.rank = g.b.alloca("i64")
        g.b.emit(`store i64 0, ptr ${this.rank}`)
        this.mask = g.b.alloca("i64")
        g.b.emit(`store i64 -1, ptr ${this.mask}`)
    }

    /** The field `f` comes next in the text, unless its `flag` says it came before. */
    seen(f: Field, flag: string) {
        const g = this.g
        const first = g.b.label("ofirst")
        const after = g.b.label("oseen")
        g.b.condBr(g.b.value("i1", `load i1, ptr ${flag}`), after, first)
        g.b.start(first)
        // The orders with the field at each place.
        const orders = fieldOrders(this.type)
        const masks: string[] = []
        for (let j = 0; j < this.type.fields.length; j++) {
            let m = 0
            for (let k = 0; k < orders.length; k++) if (orders[k][j].name === f.name) m = m | (1 << k)
            masks.push(`${m}`)
        }
        const rank = g.b.value("i64", `load i64, ptr ${this.rank}`)
        const at = g.b.value("ptr", `getelementptr i64, ptr ${constArray(g, "i64", masks)}, i64 ${rank.v}`)
        const left = g.b.value("i64", `load i64, ptr ${this.mask}`)
        const mask = g.b.value("i64", `and i64 ${left.v}, ${g.b.value("i64", `load i64, ptr ${at.v}`).v}`)
        g.b.emit(`store i64 ${mask.v}, ptr ${this.mask}`)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${rank.v}, 1`).v}, ptr ${this.rank}`)
        g.b.br(after)
        g.b.start(after)
    }

    /** Sets the order of the object `o`: the first that can be, else the first. */
    set(o: V) {
        const g = this.g
        const mask = g.b.value("i64", `load i64, ptr ${this.mask}`)
        let index: V = g.i64(0)
        for (let k = fieldOrders(this.type).length - 1; k >= 0; k--) {
            const bit = g.b.value("i64", `and i64 ${mask.v}, ${1 << k}`)
            const can = g.b.value("i1", `icmp ne i64 ${bit.v}, 0`)
            index = g.b.value("i64", `select i1 ${can.v}, i64 ${k}, i64 ${index.v}`)
        }
        g.setOrder(o, this.type, index)
    }
}

/** Continues when `ok` holds; otherwise runs `report` and `fail`. */
export function checkOr(g: Emitter, ok: V, report: () => void, fail: () => void) {
    const good = g.b.label("good")
    const bad = g.b.label("bad")
    g.b.condBr(ok, good, bad)
    g.b.start(bad)
    report()
    fail()
    g.b.start(good)
}

/**
 * A helper reading a value of a type straight from the text of a parser:
 * `T (ptr parser, ptr c)`. It only marks `c` failed, with no message: the
 * caller then decodes the text the slow way to find the error.
 */
export function jsonReader(g: Emitter, type: Type): string {
    const name = globalName(`json.read.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(type)
    helper(g, name, `define internal ${ty} ${name}(ptr %p, ptr %c)`, (e) => readJson(e, type))
    return name
}

/** The state of `readJson`. */
class Reader {
    ty: string
    p: V = { ty: "ptr", v: "%p" }

    constructor(
        public g: Emitter,
        public type: Type,
    ) {
        this.ty = g.lt(type)
    }

    /** Returns a zero value. */
    leave() {
        const g = this.g
        g.b.terminate(this.ty === "void" ? "ret void" : `ret ${this.ty} ${g.zero(this.type).v}`)
    }

    /** Marks the reading failed and returns. */
    fail() {
        this.g.b.emit(`store i8 1, ptr ${this.g.field("%c", JSON_CTX, 0)}`)
        this.leave()
    }

    /** Continues when `ok` holds, and fails otherwise. */
    check(ok: V) {
        const g = this.g
        const good = g.b.label("read")
        const bad = g.b.label("unread")
        g.b.unlikelyBr(g.b.value("i1", `xor i1 ${ok.v}, true`), bad, good)
        g.b.start(bad)
        this.fail()
        g.b.start(good)
    }

    /** Reads a value of a type with its own reader, returning if that failed. */
    read(t: Type): V {
        const g = this.g
        const lt = g.lt(t)
        const x = g.b.value(lt, `call ${lt} ${jsonReader(g, t)}(ptr %p, ptr %c)`)
        const bad = g.b.label("failed")
        const ok = g.b.label("fine")
        g.b.unlikelyBr(jsonFailed(g, "%c"), bad, ok)
        g.b.start(bad)
        this.leave()
        g.b.start(ok)
        return x
    }

    /** Branches on the separator after an item: to `more` after a comma, to `end` after `close`. */
    next(close: int, more: string, end: string) {
        const g = this.g
        const r = g.rt("ore_rt_json_read_next", [this.p, g.i64(close)])
        const bad = g.b.label("badnext")
        g.b.terminate(`switch i64 ${r.v}, label %${bad} [ i64 1, label %${more} i64 0, label %${end} ]`)
        g.b.start(bad)
        this.fail()
    }

    ret(x: V) {
        this.g.b.terminate(`ret ${this.ty} ${x.v}`)
    }
}

/** The body of a reader of a type; see `jsonReader`. */
export function readJson(g: Emitter, type: Type) {
    const r = new Reader(g, type)
    const ty = r.ty
    const p = r.p
    switch (type.kind) {
        case "int": {
            const out = g.b.alloca("i64")
            const range = intRange(type)
            const max = g.i64(i64(range.max))
            r.check(
                type.signed
                    ? g.rtBool("ore_rt_json_read_int", [p, g.i64(range.min), max, { ty: "ptr", v: out }])
                    : g.rtBool("ore_rt_json_read_uint", [p, max, { ty: "ptr", v: out }]),
            )
            r.ret(g.fromI64(g.b.value("i64", `load i64, ptr ${out}`), ty))
            return
        }
        case "float": {
            const out = g.b.alloca("double")
            r.check(g.rtBool("ore_rt_json_read_float", [p, { ty: "ptr", v: out }]))
            const num = g.b.value("double", `load double, ptr ${out}`)
            r.ret(type.bits === 32 ? g.b.value("float", `fptrunc double ${num.v} to float`) : num)
            return
        }
        case "bool": {
            const out = g.b.alloca("i8")
            r.check(g.rtBool("ore_rt_json_read_bool", [p, { ty: "ptr", v: out }]))
            r.ret(g.b.value("i1", `trunc i8 ${g.b.value("i8", `load i8, ptr ${out}`).v} to i1`))
            return
        }
        case "string": {
            const out = g.b.alloca(STR)
            r.check(g.rtBool("ore_rt_json_read_string", [p, { ty: "ptr", v: out }]))
            r.ret(g.b.value(STR, `load ${STR}, ptr ${out}`))
            return
        }
        case "union": {
            // A nullable type of one other member; other unions are read as values.
            let nullIndex = -1
            const others: int[] = []
            for (let i = 0; i < type.members.length; i++) {
                if (type.members[i].kind === "null") {
                    if (nullIndex === -1) nullIndex = i
                } else others.push(i)
            }
            if (unionRepr(type).k !== "strings" && nullIndex >= 0 && others.length === 1) {
                const isNull = g.b.label("rnull")
                const notNull = g.b.label("rnotnull")
                g.b.condBr(g.rtBool("ore_rt_json_read_null", [p]), isNull, notNull)
                g.b.start(isNull)
                r.ret(inject(g, type, nullIndex, null))
                g.b.start(notNull)
                r.ret(inject(g, type, others[0], r.read(type.members[others[0]])))
                return
            }
            readValue(g, r, type)
            return
        }
        case "array": {
            const elemType = type.elem
            const elem = g.mt(elemType)
            r.check(g.rtBool("ore_rt_json_read_open", [p, g.i64(0x5b)]))
            const a = g.rt("ore_rt_array_new", [{ ty: "i64", v: sizeOf(elem) }, g.i64(0), elementData(g, elem)])
            const loop = g.b.label("ritem")
            const end = g.b.label("rend")
            g.b.condBr(g.rtBool("ore_rt_json_read_empty", [p, g.i64(0x5d)]), end, loop)
            g.b.start(loop)
            const x = r.read(elemType)
            g.store(x, g.rt("ore_rt_array_push", [a, { ty: "i64", v: sizeOf(elem) }]).v, elemType)
            r.next(0x5d, loop, end)
            g.b.start(end)
            r.ret(a)
            return
        }
        case "struct": {
            if (type.tuple) {
                readValue(g, r, type)
                return
            }
            r.check(g.rtBool("ore_rt_json_read_open", [p, g.i64(0x7b)]))
            const o = g.alloc(g.structType(type))
            g.setTable(o, type)
            const order = ordered(type) ? new TextOrder(g, type) : null
            const seen: string[] = []
            for (const _ of type.fields) {
                const flag = g.b.alloca("i1")
                g.b.emit(`store i1 false, ptr ${flag}`)
                seen.push(flag)
            }
            const loop = g.b.label("rkey")
            const sep = g.b.label("rsep")
            const end = g.b.label("rend")
            g.b.condBr(g.rtBool("ore_rt_json_read_empty", [p, g.i64(0x7d)]), end, loop)
            g.b.start(loop)
            r.check(g.rtBool("ore_rt_json_read_key", [p]))
            // Keys are compared in place with the names of the fields; others are skipped.
            for (let i = 0; i < type.fields.length; i++) {
                const f = type.fields[i]
                const here = g.b.label("rfield")
                const other = g.b.label("rother")
                g.b.condBr(g.rtBool("ore_rt_json_key_is", [p, g.cstr(f.name), g.i64(f.name.length)]), here, other)
                g.b.start(here)
                g.store(r.read(f.type), fieldPtr(g, o.v, type, f.name), f.type)
                if (order !== null) order.seen(f, seen[i])
                g.b.emit(`store i1 true, ptr ${seen[i]}`)
                g.b.br(sep)
                g.b.start(other)
            }
            r.check(g.b.value("i1", `icmp ne ptr ${g.rt("ore_rt_json_read_value", [p]).v}, null`))
            g.b.start(sep)
            r.next(0x7d, loop, end)
            g.b.start(end)
            if (order !== null) order.set(o)
            // A field left out is null if it can be, as in decoding.
            for (let i = 0; i < type.fields.length; i++) {
                const f = type.fields[i]
                const ft = f.type
                const present = g.b.label("rpresent")
                const missing = g.b.label("rmissing")
                g.b.condBr(g.b.value("i1", `load i1, ptr ${seen[i]}`), present, missing)
                g.b.start(missing)
                let nullIndex = -1
                if (ft.kind === "union") {
                    for (let j = 0; j < ft.members.length && nullIndex === -1; j++)
                        if (ft.members[j].kind === "null") nullIndex = j
                }
                if (ft.kind === "union" && nullIndex >= 0)
                    g.store(inject(g, ft, nullIndex, null), fieldPtr(g, o.v, type, f.name), f.type)
                else r.fail()
                g.b.start(present)
            }
            r.ret(o)
            return
        }
        default:
            readValue(g, r, type)
    }
}

/** Reads any other type as a value, and decodes it from that. */
function readValue(g: Emitter, r: Reader, type: Type) {
    const v = g.rt("ore_rt_json_read_value", [r.p])
    r.check(g.b.value("i1", `icmp ne ptr ${v.v}, null`))
    r.ret(g.b.value(r.ty, `call ${r.ty} ${jsonDecoder(g, type)}(ptr ${v.v}, ptr %c)`))
}
