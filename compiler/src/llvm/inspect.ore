// What console.log prints: a value formatted as Node's util.inspect does,
// by a function generated per type. Arrays, maps, sets and objects give
// their entries to runtime/core/inspect.ore, which lays them out. Values are
// colored as Node colors them when the output shows colors.

import {
    type Field,
    type InterfaceType,
    type StructType,
    type Type,
    type UnionType,
    isNumberLiterals,
    isNumeric,
    types,
    unionRepr,
} from "../ir/types"
import { counted, dateClass, hookedClass } from "./json"
import { ARRAY, MAP, STR } from "./context"
import { Emitter } from "./base"
import { fieldPtr, payload, slotTest } from "./expressions"
import { globalName, type V } from "./ll"
import { concat, helper } from "./calls"
import { heldString, holdsString, inspectHeld, unknownIsNull } from "./unknown"

/** The value as console.log prints it: strings as they are, other values as they are inside an array. */
export function inspectTop(g: Emitter, v: V, t: Type): V {
    if (t.kind === "string" || t.kind === "literal") return v
    if (t.kind === "unknown") return g.b.value(STR, `call ${STR} ${unknownTop(g)}(${v.ty} ${v.v})`)
    if (t.kind === "union") {
        if (unionRepr(t).k === "strings") return v
        return g.b.value(STR, `call ${STR} ${topInspector(g, t)}(${v.ty} ${v.v})`)
    }
    return inspectAt(g, v, t, g.rt("ore_rt_inspect_new", []), g.i64(0))
}

/** The function formatting a union at the top: a string member as it is, others by their inspectors. */
function topInspector(g: Emitter, t: UnionType): string {
    const name = globalName(`inspect.top.${g.names.key(t)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const uty = g.lt(t)
    helper(g, name, `define internal ${STR} ${name}(${uty} %v)`, (e) => {
        const v: V = { ty: uty, v: "%v" }
        for (let i = 0; i < t.members.length; i++) {
            const m = t.members[i]
            const here = e.b.label("tmember")
            const next = e.b.label("tnext")
            e.b.condBr(slotTest(e, t, v, i), here, next)
            e.b.start(here)
            const s =
                m.kind === "null"
                    ? inspectNull(e, e.rt("ore_rt_inspect_new", []))
                    : inspectTop(e, payload(e, t, v, i), m)
            e.b.terminate(`ret ${STR} ${s.v}`)
            e.b.start(next)
        }
        e.b.terminate(`ret ${STR} ${e.str("").v}`)
    })
    return name
}

/** The function formatting an `unknown` at the top: a string as it is, other values by their inspectors. */
function unknownTop(g: Emitter): string {
    const name = "@inspect.top.unknown"
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(types.unknown)
    helper(g, name, `define internal ${STR} ${name}(${ty} %v)`, (e) => {
        const v: V = { ty, v: "%v" }
        const text = e.b.label("text")
        const other = e.b.label("other")
        e.b.condBr(holdsString(e, v), text, other)
        e.b.start(text)
        e.b.terminate(`ret ${STR} ${heldString(e, v).v}`)
        e.b.start(other)
        e.b.terminate(`ret ${STR} ${inspectAt(e, v, types.unknown, e.rt("ore_rt_inspect_new", []), e.i64(0)).v}`)
    })
    return name
}

// Node's styles (util.inspect.styles) as the SGR codes that start and end them.
const yellow = 33
const green = 32
const cyan = 36
const magenta = 35
const defaultColor = 39
const bold = 1
const normal = 22

/** `text` in a color when the output shows colors. */
function paint(g: Emitter, s: V, text: V, open: int, close: int): V {
    return g.rt("ore_rt_inspect_paint", [s, text, g.i64(open), g.i64(close)])
}

/** A number, a bigint or a boolean: yellow. */
function yellowText(g: Emitter, s: V, text: V): V {
    return paint(g, s, text, yellow, defaultColor)
}

/** `null`, bold. */
function inspectNull(g: Emitter, s: V): V {
    return paint(g, s, g.str("null"), bold, normal)
}

/** Prints a number, a bigint or a boolean at the top by `printIt`, yellow when the output shows colors. */
export function printYellow(g: Emitter, printIt: () => void) {
    g.rt("ore_rt_print_color", [g.i64(yellow)])
    printIt()
    g.rt("ore_rt_print_color", [g.i64(defaultColor)])
}

/** Calls the inspector of type `t` on `v`, `depth` levels deep, with the state `s`. */
export function inspectAt(g: Emitter, v: V, t: Type, s: V, depth: V): V {
    return g.b.value(STR, `call ${STR} ${inspector(g, t)}(${v.ty} ${v.v}, ptr ${s.v}, i64 ${depth.v})`)
}

/** The function formatting a value of a type: `string (T v, ptr s, i64 depth)`. */
function inspector(g: Emitter, t: Type): string {
    return inspectorNamed(g, t, `inspect.${g.names.key(t)}`, false)
}

function inspectorNamed(g: Emitter, t: Type, key: string, exact: bool): string {
    const name = globalName(key)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    const ty = g.lt(t)
    helper(g, name, `define internal ${STR} ${name}(${ty} %v, ptr %s, i64 %depth)`, (e) => {
        const r = inspectValue(e, t, { ty, v: "%v" }, exact)
        e.b.terminate(`ret ${STR} ${r.v}`)
    })
    return name
}

/** Whether Node aligns the entries of an array of this type to the right: numbers. */
function numeric(t: Type): bool {
    if (t.kind === "union") return t.members.every((m) => isNumeric(m) || m.kind === "number-literal")
    return isNumeric(t) || t.kind === "number-literal"
}

/** A property name as Node writes it: bare when an identifier, else quoted. */
function propertyName(name: string): string {
    let plain = name.length > 0
    for (let i = 0; i < name.length; i++) {
        const c = name[i]
        const letter = (c >= 0x61 && c <= 0x7a) || (c >= 0x41 && c <= 0x5a) || c === 0x5f
        if (!letter && !(i > 0 && c >= 0x30 && c <= 0x39)) plain = false
    }
    if (plain) return name
    let quoted = "'"
    for (let i = 0; i < name.length; i++) {
        const c = name[i]
        if (c === 0x27) quoted += "\\'"
        else if (c === 0x5c) quoted += "\\\\"
        else if (c === 0x0a) quoted += "\\n"
        else quoted += name.slice(i, i + 1)
    }
    return `${quoted}'`
}

/** A property name as Node writes it, green when quoted, as Node colors a quoted name as a string. */
function fieldName(g: Emitter, s: V, name: string): V {
    const written = propertyName(name)
    if (written === name) return g.str(name)
    return paint(g, s, g.str(written), green, defaultColor)
}

/** Returns `r` from the inspector unless it is empty, which means to go on. */
function returnUnlessEmpty(g: Emitter, r: V) {
    const done = g.b.label("done")
    const go = g.b.label("entries")
    const n = g.extract(r, 1, "i64")
    g.b.condBr(g.b.value("i1", `icmp ne i64 ${n.v}, 0`), done, go)
    g.b.start(done)
    g.b.terminate(`ret ${STR} ${r.v}`)
    g.b.start(go)
}

/** The state of the inspection, and the depth of the entries of the value being formatted. */
function state(): V {
    return { ty: "ptr", v: "%s" }
}

function inspectValue(g: Emitter, t: Type, v: V, exact: bool): V {
    const s = state()
    const depth: V = { ty: "i64", v: "%depth" }
    switch (t.kind) {
        case "int":
            return yellowText(
                g,
                s,
                t.signed ? g.rt("ore_rt_str_from_i64", [g.toI64(v)]) : g.rt("ore_rt_str_from_u64", [g.toI64(v, false)]),
            )
        case "float":
            return yellowText(g, s, g.rt(t.bits === 32 ? "ore_rt_inspect_f32" : "ore_rt_inspect_f64", [v]))
        case "number-literal":
            return yellowText(g, s, g.rt("ore_rt_inspect_f64", [v]))
        case "bool":
            return yellowText(g, s, g.rt("ore_rt_str_from_bool", [v]))
        case "bigint":
            // With its suffix, as Node prints it: `10n`.
            return yellowText(
                g,
                s,
                concat(g, [
                    { v: v, t: t },
                    { v: g.str("n"), t: types.string },
                ]),
            )
        case "string":
            return paint(g, s, g.rt("ore_rt_inspect_string", [v]), green, defaultColor)
        case "literal":
            return paint(g, s, g.rt("ore_rt_inspect_string", [v]), green, defaultColor)
        case "null":
            return inspectNull(g, s)
        case "func":
            return paint(
                g,
                s,
                g.rt("ore_rt_inspect_function", [functionName(g, g.extract(v, 0, "ptr"))]),
                cyan,
                defaultColor,
            )
        case "union":
            return inspectUnion(g, t, v, s, depth)
        case "interface":
            return inspectInterface(g, t, v, s, depth)
        case "unknown": {
            const isNull = g.b.label("unull")
            const present = g.b.label("upresent")
            g.b.condBr(unknownIsNull(g, v), isNull, present)
            g.b.start(isNull)
            g.b.terminate(`ret ${STR} ${inspectNull(g, s).v}`)
            g.b.start(present)
            return inspectHeld(g, v, s, depth)
        }
        case "array": {
            const n = g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
            returnUnlessEmpty(
                g,
                g.rt("ore_rt_inspect_begin", [s, v, n, depth, g.str("["), g.str("]"), g.str("[Array]")]),
            )
            const deeper = g.b.value("i64", `add i64 %depth, 1`)
            const elem = t.elem
            counted(g, g.rt("ore_rt_inspect_shown", [s, n]), (i) => {
                const data = g.b.value("ptr", `load ptr, ptr ${g.field(v.v, ARRAY, 0)}`)
                const place = g.b.value("ptr", `getelementptr ${g.mt(elem)}, ptr ${data.v}, i64 ${i.v}`)
                g.rt("ore_rt_inspect_entry", [s, inspectAt(g, g.load(place.v, elem), elem, s, deeper)])
            })
            g.rt("ore_rt_inspect_more", [s, n])
            return g.rt("ore_rt_inspect_end", [
                s,
                g.str("["),
                g.str("]"),
                depth,
                g.i64(1),
                g.i64(numeric(elem) ? 1 : 0),
            ])
        }
        case "map":
            if (t.dict) return inspectDict(g, v, t.value, s, depth)
            return inspectEntries(g, v, t.key, t.value, s, depth)
        case "set":
            return inspectEntries(g, v, t.elem, null, s, depth)
        case "struct":
            return inspectStruct(g, t, v, s, depth, exact)
        default:
            return g.str(`[${t.kind}]`)
    }
}

/** A dictionary, as Node prints an object: `{ a: 1, 'b-c': 2 }`, every entry. */
function inspectDict(g: Emitter, v: V, valueType: Type, s: V, depth: V): V {
    const n = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 8)}`)
    returnUnlessEmpty(g, g.rt("ore_rt_inspect_begin", [s, v, n, depth, g.str("{"), g.str("}"), g.str("[Object]")]))
    const deeper = g.b.value("i64", `add i64 %depth, 1`)
    liveEntries(g, v, (i) => {
        const key = g.rt("ore_rt_inspect_key", [s, g.load(g.rt("ore_rt_map_key", [v, i]).v, types.string)])
        const value = g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType)
        g.rt("ore_rt_inspect_field", [s, key, inspectAt(g, value, valueType, s, deeper)])
    })
    return g.rt("ore_rt_inspect_end", [s, g.str("{"), g.str("}"), depth, g.i64(0), g.i64(0)])
}

/** Runs `body` for the index of each live entry of a map, in insertion order. */
function liveEntries(g: Emitter, v: V, body: (i: V) => void) {
    const slots = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 6)}`)
    counted(g, slots, (i) => {
        const live = g.b.label("live")
        const skip = g.b.label("skip")
        g.b.condBr(g.rtBool("ore_rt_map_live", [v, i]), live, skip)
        g.b.start(live)
        body(i)
        g.b.br(skip)
        g.b.start(skip)
    })
}

/** A map, `Map(1) { 'a' => 1 }`, or a set without values, `Set(1) { 'a' }`. */
function inspectEntries(g: Emitter, v: V, keyType: Type, valueType: Type | null, s: V, depth: V): V {
    const kind = valueType !== null ? "Map" : "Set"
    const n = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 8)}`)
    const open = g.rt("ore_rt_inspect_sized", [g.str(kind), n])
    returnUnlessEmpty(g, g.rt("ore_rt_inspect_begin", [s, v, n, depth, open, g.str("}"), g.str(`[${kind}]`)]))
    const deeper = g.b.value("i64", `add i64 %depth, 1`)
    const shown = g.rt("ore_rt_inspect_shown", [s, n])
    const written = g.b.alloca("i64")
    g.b.emit(`store i64 0, ptr ${written}`)
    const slots = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 6)}`)
    counted(g, slots, (i) => {
        // The live entries, in insertion order, up to the number shown.
        const live = g.b.label("live")
        const skip = g.b.label("skip")
        const count = g.b.value("i64", `load i64, ptr ${written}`)
        const room = g.b.value("i1", `icmp slt i64 ${count.v}, ${shown.v}`)
        const isLive = g.rtBool("ore_rt_map_live", [v, i])
        g.b.condBr(g.b.value("i1", `and i1 ${room.v}, ${isLive.v}`), live, skip)
        g.b.start(live)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${count.v}, 1`).v}, ptr ${written}`)
        const key = inspectAt(g, g.load(g.rt("ore_rt_map_key", [v, i]).v, keyType), keyType, s, deeper)
        if (valueType !== null) {
            const value = g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType)
            g.rt("ore_rt_inspect_pair", [s, key, inspectAt(g, value, valueType, s, deeper)])
        } else {
            g.rt("ore_rt_inspect_entry", [s, key])
        }
        g.b.br(skip)
        g.b.start(skip)
    })
    g.rt("ore_rt_inspect_more", [s, n])
    return g.rt("ore_rt_inspect_end", [s, open, g.str("}"), depth, g.i64(0), g.i64(0)])
}

/** A union value: by the inspector of the member it holds. */
function inspectUnion(g: Emitter, t: UnionType, v: V, s: V, depth: V): V {
    if (isNumberLiterals(t)) return yellowText(g, s, g.rt("ore_rt_inspect_f64", [v]))
    if (unionRepr(t).k === "strings") return paint(g, s, g.rt("ore_rt_inspect_string", [v]), green, defaultColor)
    for (let i = 0; i < t.members.length; i++) {
        const m = t.members[i]
        const here = g.b.label("imember")
        const next = g.b.label("inext")
        g.b.condBr(slotTest(g, t, v, i), here, next)
        g.b.start(here)
        const r = m.kind === "null" ? inspectNull(g, s) : inspectAt(g, payload(g, t, v, i), m, s, depth)
        g.b.terminate(`ret ${STR} ${r.v}`)
        g.b.start(next)
    }
    return g.str("")
}

/** An interface value: by the inspector of the class it holds, told by the type id in its table. */
function inspectInterface(g: Emitter, t: InterfaceType, v: V, s: V, depth: V): V {
    const table = g.extract(v, 1, "ptr")
    const object = g.extract(v, 0, "ptr")
    const isNull = g.b.label("inull")
    const present = g.b.label("ipresent")
    g.b.condBr(g.b.value("i1", `icmp eq ptr ${table.v}, null`), isNull, present)
    g.b.start(isNull)
    g.b.terminate(`ret ${STR} ${inspectNull(g, s).v}`)
    g.b.start(present)
    const id = g.b.value("i64", `load i64, ptr ${table.v}`)
    const done = new Set<int>()
    for (const itab of g.module.itabs) {
        const struct = itab.struct
        if (itab.iface.id !== t.id || done.has(struct.id)) continue
        done.add(struct.id)
        const here = g.b.label("iclass")
        const next = g.b.label("inext")
        g.b.condBr(g.b.value("i1", `icmp eq i64 ${id.v}, ${g.names.typeId(struct)}`), here, next)
        g.b.start(here)
        g.b.terminate(`ret ${STR} ${inspectAt(g, object, struct, s, depth).v}`)
        g.b.start(next)
    }
    return g.str("{}")
}

/**
 * Whether a field holds an accessor of an object literal, `get x()` or
 * `set x(value)`, which are hidden fields named so: "get" or "set" for one
 * alone, "get+" for a getter with a setter, "set+" for a setter with a
 * getter; "" for other fields.
 */
function accessorOf(t: StructType, f: Field): string {
    if (!f.private || f.type.kind !== "func" || t.nominal) return ""
    const getter = f.name.startsWith("get ")
    if (!getter && !f.name.startsWith("set ")) return ""
    const other = `${getter ? "set" : "get"} ${f.name.slice(4)}`
    const paired = t.fields.some((x) => x.name === other && x.private)
    return `${getter ? "get" : "set"}${paired ? "+" : ""}`
}

/** An object: `{ x: 1 }`, `Point { x: 1 }` for a class, `[ 1, 2 ]` for a tuple, `Error: message` for an Error. */
function inspectStruct(g: Emitter, t: StructType, v: V, s: V, depth: V, exact: bool): V {
    if (!exact && g.tables.has(t.id)) {
        // An instance of a subclass is formatted as one.
        const table = g.b.value("ptr", `load ptr, ptr ${v.v}`)
        for (const sub of g.subclasses(t)) {
            if (sub === t) continue
            const here = g.b.label("subclass")
            const next = g.b.label("snext")
            g.b.condBr(g.b.value("i1", `icmp eq ptr ${table.v}, ${g.classTable(sub)}`), here, next)
            g.b.start(here)
            const f = inspectorNamed(g, sub, `inspect.exact.${g.names.key(sub)}`, true)
            g.b.terminate(`ret ${STR} ${g.b.value(STR, `call ${STR} ${f}(ptr ${v.v}, ptr %s, i64 %depth)`).v}`)
            g.b.start(next)
        }
    }
    // A match of a regular expression, as Node prints a match array.
    if (t.nominal && t.name === "RegExpMatch" && t.fields.some((f) => f.name === "captures"))
        return g.rt("ore_rt_inspect_match", [s, v, depth])
    // A URL and its search parameters, as Node prints them.
    if (hookedClass(g, t, "ore_rt_inspect_url", 1)) return g.rt("ore_rt_inspect_url", [s, v, depth])
    if (hookedClass(g, t, "ore_rt_inspect_urlsearchparams", 1))
        return g.rt("ore_rt_inspect_urlsearchparams", [s, v, depth])
    const date = dateClass(g, t)
    if (date !== null) {
        // A date as Node prints it, its ISO string; a subclass with its name before.
        let text = g.rt("ore_rt_date_inspect", [v])
        if (date.id !== t.id && t.name !== null) {
            text = concat(g, [
                { v: g.str(`${t.name} `), t: types.string },
                { v: text, t: types.string },
            ])
        }
        return paint(g, s, text, magenta, defaultColor)
    }
    const ctor = t.ctor
    if (ctor !== null && ctor.name === "ore_new_BasicError") {
        const message = g.load(fieldPtr(g, v.v, t, "message"), t.fields[0].type)
        return g.rt("ore_rt_inspect_error", [g.str("Error"), message])
    }
    const name = t.name
    const isClass = t.nominal && name !== null
    const open = t.tuple ? "[" : isClass ? `${name} {` : "{"
    const close = t.tuple ? "]" : "}"
    const short = t.tuple ? "[Array]" : isClass ? `[${name}]` : "[Object]"
    // Optional fields that are null are left out, as JavaScript leaves out undefined properties.
    const count = g.b.alloca("i64")
    g.b.emit(`store i64 0, ptr ${count}`)
    const values: V[] = []
    const present: (V | null)[] = []
    for (const f of t.fields) {
        const x = g.load(fieldPtr(g, v.v, t, f.name), f.type)
        values.push(x)
        const ft = f.type
        if (accessorOf(t, f) === "set+") {
            // Shown with its getter.
            present.push(null)
            continue
        }
        let isPresent: V | null = null
        if (f.optional && ft.kind === "union") {
            let at = -1
            for (let i = 0; i < ft.members.length; i++) if (ft.members[i].kind === "null") at = i
            if (at >= 0) isPresent = g.b.value("i1", `xor i1 ${slotTest(g, ft, x, at).v}, true`)
        }
        present.push(isPresent)
        const one = isPresent !== null ? g.b.value("i64", `zext i1 ${isPresent.v} to i64`) : g.i64(1)
        const before = g.b.value("i64", `load i64, ptr ${count}`)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${before.v}, ${one.v}`).v}, ptr ${count}`)
    }
    const n = g.b.value("i64", `load i64, ptr ${count}`)
    returnUnlessEmpty(g, g.rt("ore_rt_inspect_begin", [s, v, n, depth, g.str(open), g.str(close), g.str(short)]))
    const deeper = g.b.value("i64", `add i64 %depth, 1`)
    let numbers = true
    for (let i = 0; i < t.fields.length; i++) {
        const f = t.fields[i]
        if (!numeric(f.type)) numbers = false
        const accessor = accessorOf(t, f)
        if (accessor === "set+") continue
        if (accessor !== "") {
            // As Node shows an accessor property: `x: [Getter/Setter]`.
            const label = accessor === "get" ? "[Getter]" : accessor === "get+" ? "[Getter/Setter]" : "[Setter]"
            const text = paint(g, s, g.str(label), cyan, defaultColor)
            g.rt("ore_rt_inspect_field", [s, fieldName(g, s, f.name.slice(4)), text])
            continue
        }
        const skip = g.b.label("absent")
        const isPresent = present[i]
        if (isPresent !== null) {
            const yes = g.b.label("present")
            g.b.condBr(isPresent, yes, skip)
            g.b.start(yes)
        }
        const text = inspectAt(g, values[i], f.type, s, deeper)
        if (t.tuple) g.rt("ore_rt_inspect_entry", [s, text])
        else g.rt("ore_rt_inspect_field", [s, fieldName(g, s, f.name), text])
        g.b.br(skip)
        g.b.start(skip)
    }
    return g.rt("ore_rt_inspect_end", [
        s,
        g.str(open),
        g.str(close),
        depth,
        g.i64(t.tuple ? 1 : 0),
        g.i64(numbers ? 1 : 0),
    ])
}

/** The name of the function at `fn`, or "" if it has none: through a table made when the module is done. */
function functionName(g: Emitter, fn: V): V {
    g.usesFunctionNames = true
    return g.b.value(STR, `call ${STR} @ore.fnname(ptr ${fn.v})`)
}

/** The function `@ore.fnname` that `functionName` calls, after all functions are emitted. */
export function functionNames(g: Emitter, data: string): string {
    const lines: string[] = [`${data}define internal ${STR} @ore.fnname(ptr %f) #0 {`]
    let i = 0
    for (const fn of g.functionNames.keys()) {
        lines.push(`  %c${i} = icmp eq ptr %f, ${fn}`)
        lines.push(`  br i1 %c${i}, label %yes${i}, label %no${i}`)
        lines.push(`yes${i}:`)
        lines.push(`  ret ${STR} ${g.str(g.functionNames.get(fn)!).v}`)
        lines.push(`no${i}:`)
        i++
    }
    lines.push(`  ret ${STR} ${g.str("").v}`)
    lines.push("}")
    return lines.join("\n")
}

/**
 * A value as util.inspect formats it with options, for the console: colored
 * as the output `fd` is (none for 0), objects `depth` levels deep.
 */
export function inspectWith(g: Emitter, v: V, t: Type, fd: int, depth: int): V {
    const s = g.rt("ore_rt_inspect_with", [g.i64(fd), g.i64(depth), g.i64(100), g.i64(80)])
    return inspectAt(g, v, t, s, g.i64(0))
}

/** `inspectWith` at the top of what console.log prints: a string as it is, also the one a union holds. */
export function inspectTopWith(g: Emitter, v: V, t: Type, fd: int, depth: int): V {
    if (t.kind === "string" || t.kind === "literal") return v
    if (t.kind === "unknown") return inspectTop(g, v, t)
    if (t.kind !== "union") return inspectWith(g, v, t, fd, depth)
    if (unionRepr(t).k === "strings") return v
    if (!t.members.some((m) => m.kind === "string" || m.kind === "literal")) return inspectWith(g, v, t, fd, depth)
    // By the member the union holds.
    const s = g.rt("ore_rt_inspect_with", [g.i64(fd), g.i64(depth), g.i64(100), g.i64(80)])
    const out = g.b.alloca(STR)
    const done = g.b.label("ttop")
    for (let i = 0; i < t.members.length; i++) {
        const m = t.members[i]
        const here = g.b.label("tmember")
        const next = g.b.label("tnext")
        g.b.condBr(slotTest(g, t, v, i), here, next)
        g.b.start(here)
        const held = m.kind === "null" ? null : payload(g, t, v, i)
        const r =
            held === null
                ? inspectNull(g, s)
                : m.kind === "string" || m.kind === "literal"
                  ? held
                  : inspectAt(g, held, m, s, g.i64(0))
        g.b.emit(`store ${STR} ${r.v}, ptr ${out}`)
        g.b.br(done)
        g.b.start(next)
    }
    g.b.emit(`store ${STR} ${g.str("").v}, ptr ${out}`)
    g.b.br(done)
    g.b.start(done)
    return g.b.value(STR, `load ${STR}, ptr ${out}`)
}

/**
 * A cell of console.table, as Node formats one: an object with more than 2
 * properties as `[Object]`, others 1 level deep, 3 entries of an array or a
 * map, on one line, colored as standard output is.
 */
function cell(g: Emitter, v: V, t: Type): V {
    const depth = t.kind === "struct" && !t.tuple && t.fields.length > 2 ? -1 : 0
    const s = g.rt("ore_rt_inspect_with", [g.i64(1), g.i64(depth), g.i64(3), g.i64(1 << 40)])
    return inspectAt(g, v, t, s, g.i64(0))
}

/** Whether console.table makes a table of a type: an array, a map, a set or an object; it logs other values. */
function tabular(t: Type): bool {
    return t.kind === "array" || t.kind === "map" || t.kind === "set" || t.kind === "struct"
}

/** Prints a drawn table and a newline. */
function printTable(g: Emitter, tb: V) {
    g.rt("ore_rt_print_string", [g.rt("ore_rt_table_render", [tb])])
    g.rt("ore_rt_print_newline", [])
}

/**
 * Prints `console.table(data, properties)`: a row for each element of an
 * array, entry of a map or a set, or property of an object; in each row a
 * cell for each property of an object, element of an array, or the value
 * of a primitive in the column "Values". `only`, the properties, limits
 * the columns of an array or an object.
 */
export function table(g: Emitter, v: V, t: Type, only: V | null) {
    if (!tabular(t)) {
        // As console.log prints the value.
        if (t.kind === "string" || t.kind === "literal") g.rt("ore_rt_print_string", [v])
        else g.rt("ore_rt_print_string", [inspectTop(g, v, t)])
        g.rt("ore_rt_print_newline", [])
        return
    }
    const tb = g.rt("ore_rt_table_new", [])
    // A dictionary as an object: a row for each entry, by its key.
    if (t.kind === "map" && t.dict) {
        const valueType = t.value
        liveEntries(g, v, (i) => {
            g.rt("ore_rt_table_row", [tb, g.load(g.rt("ore_rt_map_key", [v, i]).v, types.string)])
            tableItem(g, tb, g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType), valueType)
        })
        if (only !== null) g.rt("ore_rt_table_only", [tb, only])
        printTable(g, tb)
        return
    }
    // Node shows all the columns of a map or a set: their properties do not apply.
    if (t.kind === "map") {
        entriesTable(g, tb, v, t.key, t.value)
        return
    }
    if (t.kind === "set") {
        entriesTable(g, tb, v, t.elem, null)
        return
    }
    if (t.kind === "array") {
        const elem = t.elem
        const n = g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
        counted(g, n, (k) => {
            g.rt("ore_rt_table_row", [tb, g.rt("ore_rt_str_from_i64", [k])])
            const data = g.b.value("ptr", `load ptr, ptr ${g.field(v.v, ARRAY, 0)}`)
            const place = g.b.value("ptr", `getelementptr ${g.mt(elem)}, ptr ${data.v}, i64 ${k.v}`)
            tableItem(g, tb, g.load(place.v, elem), elem)
        })
    } else if (t.kind === "struct") {
        for (let i = 0; i < t.fields.length; i++) {
            const f = t.fields[i]
            g.rt("ore_rt_table_row", [tb, g.str(t.tuple ? `${i}` : f.name)])
            tableItem(g, tb, g.load(fieldPtr(g, v.v, t, f.name), f.type), f.type)
        }
    }
    if (only !== null) g.rt("ore_rt_table_only", [tb, only])
    printTable(g, tb)
}

/** The table of a map (with `valueType`) or a set: a row for each entry, numbered, with its key and its value. */
function entriesTable(g: Emitter, tb: V, v: V, keyType: Type, valueType: Type | null) {
    g.rt("ore_rt_table_iteration", [tb])
    const written = g.b.alloca("i64")
    g.b.emit(`store i64 0, ptr ${written}`)
    const slots = g.b.value("i64", `load i64, ptr ${g.field(v.v, MAP, 6)}`)
    counted(g, slots, (i) => {
        const live = g.b.label("live")
        const skip = g.b.label("skip")
        g.b.condBr(g.rtBool("ore_rt_map_live", [v, i]), live, skip)
        g.b.start(live)
        const count = g.b.value("i64", `load i64, ptr ${written}`)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${count.v}, 1`).v}, ptr ${written}`)
        g.rt("ore_rt_table_row", [tb, cell(g, count, types.i64)])
        const key = cell(g, g.load(g.rt("ore_rt_map_key", [v, i]).v, keyType), keyType)
        if (valueType !== null) {
            g.rt("ore_rt_table_cell", [tb, g.str("Key"), key])
            const value = g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType)
            g.rt("ore_rt_table_value", [tb, cell(g, value, valueType)])
        } else {
            g.rt("ore_rt_table_value", [tb, key])
        }
        g.b.br(skip)
        g.b.start(skip)
    })
    printTable(g, tb)
}

/** The cells of a row of console.table for an entry: its properties or elements, or a primitive's value. */
function tableItem(g: Emitter, tb: V, v: V, t: Type) {
    if (t.kind === "struct") {
        for (let i = 0; i < t.fields.length; i++) {
            const f = t.fields[i]
            const x = g.load(fieldPtr(g, v.v, t, f.name), f.type)
            const ft = f.type
            // An optional property that is null is not there, as an undefined one in JavaScript.
            let absent: V | null = null
            if (f.optional && ft.kind === "union") {
                for (let m = 0; m < ft.members.length; m++)
                    if (ft.members[m].kind === "null") absent = slotTest(g, ft, x, m)
            }
            const skip = g.b.label("absent")
            if (absent !== null) {
                const yes = g.b.label("present")
                g.b.condBr(absent, skip, yes)
                g.b.start(yes)
            }
            g.rt("ore_rt_table_cell", [tb, g.str(t.tuple ? `${i}` : f.name), cell(g, x, ft)])
            g.b.br(skip)
            g.b.start(skip)
        }
        return
    }
    if (t.kind === "array") {
        const elem = t.elem
        const n = g.b.value("i64", `load i64, ptr ${g.field(v.v, ARRAY, 1)}`)
        counted(g, n, (k) => {
            const data = g.b.value("ptr", `load ptr, ptr ${g.field(v.v, ARRAY, 0)}`)
            const place = g.b.value("ptr", `getelementptr ${g.mt(elem)}, ptr ${data.v}, i64 ${k.v}`)
            const text = cell(g, g.load(place.v, elem), elem)
            g.rt("ore_rt_table_cell", [tb, g.rt("ore_rt_str_from_i64", [k]), text])
        })
        return
    }
    // A dictionary has a cell for each entry, by its key.
    if (t.kind === "map" && t.dict) {
        const valueType = t.value
        liveEntries(g, v, (i) => {
            const key = g.load(g.rt("ore_rt_map_key", [v, i]).v, types.string)
            const value = g.load(g.rt("ore_rt_map_value", [v, i]).v, valueType)
            g.rt("ore_rt_table_cell", [tb, key, cell(g, value, valueType)])
        })
        return
    }
    // A map or a set is an object without properties of its own: no cells.
    if (t.kind === "map" || t.kind === "set") return
    if (t.kind === "union" && !isNumberLiterals(t) && unionRepr(t).k !== "strings") {
        // By the member the value holds.
        const done = g.b.label("item")
        for (let i = 0; i < t.members.length; i++) {
            const m = t.members[i]
            const here = g.b.label("imember")
            const next = g.b.label("inext")
            g.b.condBr(slotTest(g, t, v, i), here, next)
            g.b.start(here)
            if (m.kind === "null") g.rt("ore_rt_table_value", [tb, inspectNull(g, cellState(g))])
            else tableItem(g, tb, payload(g, t, v, i), m)
            g.b.br(done)
            g.b.start(next)
        }
        g.b.br(done)
        g.b.start(done)
        return
    }
    g.rt("ore_rt_table_value", [tb, cell(g, v, t)])
}

/** The state of formatting a cell of console.table, for `null`. */
function cellState(g: Emitter): V {
    return g.rt("ore_rt_inspect_with", [g.i64(1), g.i64(0), g.i64(3), g.i64(1 << 40)])
}
