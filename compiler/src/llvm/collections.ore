// Arrays, maps, channels and interface tables.

import { elementData, entryData } from "./gcdata"
import {
    type ArrayMethod,
    type BuiltinCall,
    type ChanOp,
    type Expr,
    type Itab,
    type ItabAccessor,
    type ItabGeneric,
    type Local,
    type MapOp,
    type SetOp,
} from "../ir/nodes"
import {
    findField,
    implementingMethod,
    FuncType,
    isStringLike,
    overridden,
    types,
    unionRepr,
    type StructType,
    type Type,
    type UnionType,
} from "../ir/types"
import { callClosure, helper, toStr, virtualThunk } from "./calls"
import { ARRAY, FN, MAP, STR } from "./context"
import { Emitter, FusedGet } from "./base"
import {
    choose,
    compare,
    convert,
    equals,
    expr,
    fieldPtr,
    inject,
    payload,
    recast,
    slotTest,
    unionOf,
} from "./expressions"
import { counted } from "./json"
import { floatConstant, globalName, sizeOf, voidValue, type V } from "./ll"

function nullIndex(u: UnionType): int {
    for (let i = 0; i < u.members.length; i++) if (u.members[i].kind === "null") return i
    return -1
}

/** The element type of an array type. */
function elemOf(t: Type): Type {
    if (t.kind === "array") return t.elem
    process.panic(`expected an array type, got ${t.kind}`)
}

/** The function type of a callback, or `() => void` when there is none (`callback?.type as FuncType`). */
function funcTypeOf(t: Type | null): FuncType {
    if (t !== null && t.kind === "func") return t
    const params: Type[] = []
    return new FuncType(params, types.void)
}

/** The state of the loop over the elements of an array, shared by the methods. */
class ArrayLoop {
    constructor(
        public g: Emitter,
        public array: V,
        public elem: string,
        public type: Type,
    ) {}

    /**
     * Elements present when the call starts, as in JavaScript, while they
     * still exist, from index `from` (0 when null) up.
     */
    run(body: (at: V, i: V, exit: string) => void, exitLabel: string | null = null, from: V | null = null) {
        const g = this.g
        const n = g.b.value("i64", `load i64, ptr ${g.field(this.array.v, ARRAY, 1)}`)
        const i = g.b.alloca("i64")
        g.b.emit(`store i64 ${from !== null ? from.v : "0"}, ptr ${i}`)
        const head = g.b.label("ahead")
        const bodyLabel = g.b.label("abody")
        const end = exitLabel ?? g.b.label("aend")
        g.b.start(head)
        const at = g.b.value("i64", `load i64, ptr ${i}`)
        const len = g.b.value("i64", `load i64, ptr ${g.field(this.array.v, ARRAY, 1)}`)
        const inN = g.b.value("i1", `icmp slt i64 ${at.v}, ${n.v}`)
        const inLen = g.b.value("i1", `icmp slt i64 ${at.v}, ${len.v}`)
        g.b.condBr(g.b.value("i1", `and i1 ${inN.v}, ${inLen.v}`), bodyLabel, end)
        g.b.start(bodyLabel)
        body(this.element(at), at, end)
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${at.v}, 1`).v}, ptr ${i}`)
        g.b.br(head)
        if (exitLabel === null) g.b.start(end)
    }

    /**
     * The elements from index `from` down to the first, skipping those past
     * the end of an array that shrinks meanwhile.
     */
    back(body: (at: V, i: V, exit: string) => void, exitLabel: string | null, from: V) {
        const g = this.g
        const i = g.b.alloca("i64")
        g.b.emit(`store i64 ${from.v}, ptr ${i}`)
        const head = g.b.label("bhead")
        const check = g.b.label("bcheck")
        const bodyLabel = g.b.label("bbody")
        const next = g.b.label("bnext")
        const end = exitLabel ?? g.b.label("bend")
        g.b.start(head)
        const at = g.b.value("i64", `load i64, ptr ${i}`)
        g.b.condBr(g.b.value("i1", `icmp sge i64 ${at.v}, 0`), check, end)
        g.b.start(check)
        const len = g.b.value("i64", `load i64, ptr ${g.field(this.array.v, ARRAY, 1)}`)
        g.b.condBr(g.b.value("i1", `icmp slt i64 ${at.v}, ${len.v}`), bodyLabel, next)
        g.b.start(bodyLabel)
        body(this.element(at), at, end)
        g.b.br(next)
        g.b.start(next)
        g.b.emit(`store i64 ${g.b.value("i64", `sub i64 ${at.v}, 1`).v}, ptr ${i}`)
        g.b.br(head)
        if (exitLabel === null) g.b.start(end)
    }

    /** The element at index `at`, which is in range. */
    element(at: V): V {
        return this.g.load(elementPtr(this.g, this.array, this.elem, at), this.type)
    }
}

/** The address of element `i` of an array of LLVM element type `elem`, unchecked. */
function elementPtr(g: Emitter, array: V, elem: string, i: V): string {
    const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
    return g.b.value("ptr", `getelementptr ${elem}, ptr ${data.v}, i64 ${i.v}`).v
}

/** The length of an array. */
function lengthOf(g: Emitter, array: V): V {
    return g.b.value("i64", `load i64, ptr ${g.field(array.v, ARRAY, 1)}`)
}

/** A new array of `len` zeroed elements of LLVM type `elem`. */
function newArray(g: Emitter, elem: string, len: V): V {
    return g.rt("ore_rt_array_new", [{ ty: "i64", v: sizeOf(elem) }, len, elementData(g, elem)])
}

/** A copy of an array, for the methods that change a copy. */
function copyArray(g: Emitter, array: V, size: V): V {
    return g.rt("ore_rt_array_slice", [array, size, g.i64(0), g.i64(9007199254740991)])
}

/** How many arrays a type is nested in: 2 for `int[][]`. */
function nesting(t: Type): int {
    let n = 0
    let at = t
    while (true) {
        const a = at
        if (a.kind !== "array") return n
        n++
        at = a.elem
    }
}

/** Runs `body` for each index in [from, to). */
function range(g: Emitter, from: V, to: V, body: (i: V) => void) {
    const i = g.b.alloca("i64")
    g.b.emit(`store i64 ${from.v}, ptr ${i}`)
    const head = g.b.label("rhead")
    const loop = g.b.label("rbody")
    const end = g.b.label("rend")
    g.b.start(head)
    const at = g.b.value("i64", `load i64, ptr ${i}`)
    g.b.condBr(g.b.value("i1", `icmp slt i64 ${at.v}, ${to.v}`), loop, end)
    g.b.start(loop)
    body(at)
    g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${at.v}, 1`).v}, ptr ${i}`)
    g.b.br(head)
    g.b.start(end)
}

/** The methods whose first argument is a callback. */
const callbackMethods = [
    "forEach",
    "map",
    "flatMap",
    "filter",
    "find",
    "findIndex",
    "findLast",
    "findLastIndex",
    "some",
    "every",
    "reduce",
    "reduceRight",
    "sort",
    "toSorted",
]

export function arrayMethod(g: Emitter, e: ArrayMethod): V {
    const T = elemOf(e.array.type)
    const elem = g.mt(T)
    const size: V = { ty: "i64", v: sizeOf(elem) }
    const array = expr(g, e.array)
    const m = e.method
    const callback = callbackMethods.includes(m) && e.args.length > 0 ? e.args[0] : null
    const ft = funcTypeOf(callback !== null ? callback.type : null)
    let f: V | null = null
    if (callback !== null) f = expr(g, callback)
    const fn = f
    // Callbacks are given (element, index, array), or the accumulator first; extra arguments are dropped.
    const call = (args: V[]): V => callClosure(g, fn ?? voidValue, ft, args)
    const loop = new ArrayLoop(g, array, elem, T)
    const intArg = (i: int): V => g.intToI64(expr(g, e.args[i]), e.args[i].type)
    switch (m) {
        case "forEach":
            loop.run((x, i) => {
                call([x, i, array])
            })
            return voidValue
        case "map": {
            const U = elemOf(e.type)
            const out = newArray(g, g.mt(U), lengthOf(g, array))
            loop.run((x, i) => {
                const r = call([x, i, array])
                g.store(r, elementPtr(g, out, g.mt(U), i), U)
            })
            return out
        }
        case "flatMap": {
            // An array result adds its elements, anything else itself.
            const U = elemOf(e.type)
            const ut = g.mt(U)
            const out = newArray(g, ut, g.i64(0))
            loop.run((x, i) => {
                const r = call([x, i, array])
                if (ft.result.kind === "array") g.rt("ore_rt_array_append", [out, r, { ty: "i64", v: sizeOf(ut) }])
                else g.store(r, g.rt("ore_rt_array_push", [out, { ty: "i64", v: sizeOf(ut) }]).v, U)
            })
            return out
        }
        case "filter": {
            const out = newArray(g, elem, g.i64(0))
            loop.run((x, i) => {
                const keep = g.b.label("keep")
                const skip = g.b.label("skip")
                g.b.condBr(call([x, i, array]), keep, skip)
                g.b.start(keep)
                g.store(x, g.rt("ore_rt_array_push", [out, size]).v, T)
                g.b.start(skip)
            })
            return out
        }
        case "find":
        case "findIndex":
        case "findLast":
        case "findLastIndex":
        case "some":
        case "every": {
            const ty = g.lt(e.type)
            const result = g.b.alloca(ty)
            const value = m === "find" || m === "findLast"
            const index = m === "findIndex" || m === "findLastIndex"
            let initial: V
            if (value) {
                const u = unionOf(e.type)
                initial = inject(g, u, nullIndex(u), null)
            } else if (index) initial = g.i64(-1)
            else initial = { ty: "i1", v: m === "every" ? "true" : "false" }
            g.b.emit(`store ${ty} ${initial.v}, ptr ${result}`)
            const done = g.b.label("found")
            const visit = (x: V, i: V, exit: string) => {
                const hit = g.b.label("hit")
                const miss = g.b.label("miss")
                const test = call([x, i, array])
                g.b.condBr(test, m === "every" ? miss : hit, m === "every" ? hit : miss)
                g.b.start(hit)
                let found: V
                if (value) found = recast(g, x, T, e.type)
                else if (index) found = i
                else found = { ty: "i1", v: m === "every" ? "false" : "true" }
                g.b.emit(`store ${ty} ${found.v}, ptr ${result}`)
                g.b.br(exit)
                g.b.start(miss)
            }
            if (m === "findLast" || m === "findLastIndex")
                loop.back(visit, done, g.b.value("i64", `sub i64 ${lengthOf(g, array).v}, 1`))
            else loop.run(visit, done)
            g.b.start(done)
            return g.b.value(ty, `load ${ty}, ptr ${result}`)
        }
        case "reduce":
        case "reduceRight": {
            const ty = g.lt(e.type)
            const acc = g.b.alloca(ty)
            const right = m === "reduceRight"
            const visit = (x: V, i: V, exit: string) => {
                const current = g.b.value(ty, `load ${ty}, ptr ${acc}`)
                g.b.emit(`store ${ty} ${call([current, x, i, array]).v}, ptr ${acc}`)
            }
            if (e.args.length > 1) {
                g.b.emit(`store ${ty} ${expr(g, e.args[1]).v}, ptr ${acc}`)
                if (right) loop.back(visit, null, g.b.value("i64", `sub i64 ${lengthOf(g, array).v}, 1`))
                else loop.run(visit)
                return g.b.value(ty, `load ${ty}, ptr ${acc}`)
            }
            // Without an initial value: the first element (the last for reduceRight), which an empty array lacks.
            const n = lengthOf(g, array)
            const empty = g.b.label("rempty")
            const start = g.b.label("rstart")
            g.b.condBr(g.b.value("i1", `icmp eq i64 ${n.v}, 0`), empty, start)
            g.b.start(empty)
            g.rt("ore_rt_array_reduce_empty", [])
            g.b.terminate("unreachable")
            g.b.start(start)
            const first = right ? g.b.value("i64", `sub i64 ${n.v}, 1`) : g.i64(0)
            g.b.emit(`store ${ty} ${loop.element(first).v}, ptr ${acc}`)
            if (right) loop.back(visit, null, g.b.value("i64", `sub i64 ${n.v}, 2`))
            else loop.run(visit, null, g.i64(1))
            return g.b.value(ty, `load ${ty}, ptr ${acc}`)
        }
        case "includes":
        case "indexOf":
        case "lastIndexOf": {
            // includes finds NaN (SameValueZero); indexOf and lastIndexOf do not (===).
            const target = expr(g, e.args[0])
            const offset = e.args.length > 1 ? intArg(1) : null
            const isIncludes = m === "includes"
            const ty = isIncludes ? "i1" : "i64"
            const result = g.b.alloca(ty)
            g.b.emit(`store ${ty} ${isIncludes ? "false" : "-1"}, ptr ${result}`)
            const done = g.b.label("found")
            const visit = (x: V, i: V, exit: string) => {
                let same: V
                if (isIncludes && T.kind === "float") {
                    const a = convert(g, x, T, types.f64)
                    const b = convert(g, target, T, types.f64)
                    same = g.rtBool("ore_rt_same_f64", [a, b])
                } else same = equals(g, x, target, T)
                const hit = g.b.label("hit")
                const miss = g.b.label("miss")
                g.b.condBr(same, hit, miss)
                g.b.start(hit)
                g.b.emit(`store ${ty} ${isIncludes ? "true" : i.v}, ptr ${result}`)
                g.b.br(exit)
                g.b.start(miss)
            }
            const n = lengthOf(g, array)
            if (m === "lastIndexOf") {
                const from = offset !== null ? g.rt("ore_rt_last_offset", [offset, n]) : null
                loop.back(visit, done, from ?? g.b.value("i64", `sub i64 ${n.v}, 1`))
            } else loop.run(visit, done, offset !== null ? g.rt("ore_rt_slice_offset", [offset, n]) : null)
            g.b.start(done)
            return g.b.value(ty, `load ${ty}, ptr ${result}`)
        }
        case "at": {
            const ty = g.lt(e.type)
            const result = g.b.alloca(ty)
            const u = unionOf(e.type)
            g.b.emit(`store ${ty} ${inject(g, u, nullIndex(u), null).v}, ptr ${result}`)
            const at = g.rt("ore_rt_array_relative", [array, intArg(0)])
            const hit = g.b.label("athit")
            const end = g.b.label("atend")
            g.b.condBr(g.b.value("i1", `icmp sge i64 ${at.v}, 0`), hit, end)
            g.b.start(hit)
            g.b.emit(`store ${ty} ${recast(g, loop.element(at), T, e.type).v}, ptr ${result}`)
            g.b.br(end)
            g.b.start(end)
            return g.b.value(ty, `load ${ty}, ptr ${result}`)
        }
        case "with": {
            const index = intArg(0)
            const value = expr(g, e.args[1])
            const at = g.rt("ore_rt_array_with_index", [array, index])
            const out = copyArray(g, array, size)
            g.store(value, elementPtr(g, out, elem, at), T)
            return out
        }
        case "fill": {
            const value = expr(g, e.args[0])
            const start = intArg(1)
            const end = intArg(2)
            const n = lengthOf(g, array)
            const from = g.rt("ore_rt_slice_offset", [start, n])
            const to = g.rt("ore_rt_slice_offset", [end, n])
            range(g, from, to, (i) => {
                g.store(value, elementPtr(g, array, elem, i), T)
            })
            return array
        }
        case "copyWithin":
            g.rt("ore_rt_array_copy_within", [array, size, intArg(0), intArg(1), intArg(2)])
            return array
        case "entries": {
            const pair = elemOf(e.type)
            if (pair.kind !== "struct") process.panic("entries: not tuples")
            const out = newArray(g, "ptr", lengthOf(g, array))
            const s = g.structType(pair)
            loop.run((x, i) => {
                const entry = g.alloc(s)
                g.store(i, fieldPtr(g, entry.v, pair, "0"), types.i64)
                g.store(x, fieldPtr(g, entry.v, pair, "1"), T)
                g.store(entry, elementPtr(g, out, "ptr", i), pair)
            })
            return out
        }
        case "keys": {
            const n = lengthOf(g, array)
            const out = newArray(g, "i64", n)
            counted(g, n, (i) => {
                g.b.emit(`store i64 ${i.v}, ptr ${elementPtr(g, out, "i64", i)}`)
            })
            return out
        }
        case "flat": {
            // One level at a time, each a new array of the elements of the arrays in the last.
            const levels = nesting(T) - nesting(elemOf(e.type))
            if (levels === 0) return copyArray(g, array, size)
            let current = array
            let type = e.array.type
            for (let level = 0; level < levels; level++) {
                const outer = elemOf(type)
                const inner = g.mt(elemOf(outer))
                const out = newArray(g, inner, g.i64(0))
                new ArrayLoop(g, current, g.mt(outer), outer).run((x) => {
                    g.rt("ore_rt_array_append", [out, x, { ty: "i64", v: sizeOf(inner) }])
                })
                current = out
                type = outer
            }
            return current
        }
        case "join": {
            const sep = e.args.length > 0 ? expr(g, e.args[0]) : g.str(",")
            const strings = newArray(g, STR, lengthOf(g, array))
            loop.run((x, i) => {
                const text = toStr(g, x, T)
                g.b.emit(`store ${STR} ${text.v}, ptr ${elementPtr(g, strings, STR, i)}`)
            })
            return g.rt("ore_rt_str_join", [strings, sep])
        }
        case "reverse":
            g.rt("ore_rt_array_reverse", [array, size])
            return array
        case "toReversed": {
            const out = copyArray(g, array, size)
            g.rt("ore_rt_array_reverse", [out, size])
            return out
        }
        case "shift":
            return g.load(g.rt("ore_rt_array_shift", [array, size]).v, T)
        case "length=":
            // `array.length = n`.
            g.rt("ore_rt_array_set_length", [array, size, expr(g, e.args[0])])
            return voidValue
        case "unshift":
            return g.rt("ore_rt_array_unshift", [array, size, expr(g, e.args[0])])
        case "splice":
        case "toSpliced": {
            // The arguments are evaluated in order, before any change to the array.
            const start = intArg(0)
            const count = intArg(1)
            const items = expr(g, e.args[2])
            if (m === "splice") return g.rt("ore_rt_array_splice", [array, size, start, count, items])
            const out = copyArray(g, array, size)
            g.rt("ore_rt_array_splice", [out, size, start, count, items])
            return out
        }
        default: {
            // sort, in place, and toSorted, of a copy.
            const target = m === "toSorted" ? copyArray(g, array, size) : array
            if (fn === null) {
                g.rt("ore_rt_array_sort", [
                    target,
                    size,
                    { ty: "ptr", v: naturalOrder(g, T) },
                    { ty: "ptr", v: "null" },
                ])
                return target
            }
            const ctx = g.spill(fn)
            g.rt("ore_rt_array_sort", [target, size, { ty: "ptr", v: comparator(g, ft) }, { ty: "ptr", v: ctx }])
            return target
        }
    }
}

/**
 * `new Array<T>(n)`, with the zero value to give each element when it is
 * not all zero bits, and `Array.from({ length: n }, f)`.
 */
export function arrayBuiltin(g: Emitter, e: BuiltinCall): V {
    const T = elemOf(e.type)
    const elem = g.mt(T)
    const n = g.intToI64(expr(g, e.args[0]), e.args[0].type)
    if (e.name === "Array.new") {
        const out = g.rt("ore_rt_array_make", [{ ty: "i64", v: sizeOf(elem) }, n, elementData(g, elem)])
        if (e.args.length > 1)
            counted(g, n, (i) => {
                g.store(expr(g, e.args[1]), elementPtr(g, out, elem, i), T)
            })
        return out
    }
    const f = expr(g, e.args[1])
    const ft = funcTypeOf(e.args[1].type)
    const out = g.rt("ore_rt_array_make", [{ ty: "i64", v: sizeOf(elem) }, n, elementData(g, elem)])
    counted(g, n, (i) => {
        const r = callClosure(g, f, ft, [g.zero(types.null), i])
        g.store(r, elementPtr(g, out, elem, i), T)
    })
    return out
}

/** A C sort comparison calling a comparator closure, whose number result gives the order. */
export function comparator(g: Emitter, type: FuncType): string {
    const name = globalName(`cmp.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    helper(g, name, `define internal i32 ${name}(ptr %ctx, ptr %a, ptr %b)`, (e) => {
        const T = type.params[0]
        const f = e.b.value(FN, `load ${FN}, ptr %ctx`)
        const a = e.load("%a", T)
        const b = e.load("%b", T)
        const r = callClosure(e, f, type, [a, b])
        const result = type.result
        const zero = result.kind === "float" ? floatConstant(0, result.bits) : ""
        const lt =
            result.kind === "float"
                ? e.b.value("i1", `fcmp olt ${r.ty} ${r.v}, ${zero}`)
                : e.b.value("i1", `icmp slt ${r.ty} ${r.v}, 0`)
        const gt =
            result.kind === "float"
                ? e.b.value("i1", `fcmp ogt ${r.ty} ${r.v}, ${zero}`)
                : e.b.value("i1", `icmp sgt ${r.ty} ${r.v}, 0`)
        const one = e.b.value("i32", `select i1 ${gt.v}, i32 1, i32 0`)
        e.b.terminate(`ret i32 ${e.b.value("i32", `select i1 ${lt.v}, i32 -1, i32 ${one.v}`).v}`)
    })
    return name
}

/** A C sort comparison in ascending order of numbers or strings. */
export function naturalOrder(g: Emitter, type: Type): string {
    const name = globalName(`natural.${g.names.key(type)}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    helper(g, name, `define internal i32 ${name}(ptr %ctx, ptr %a, ptr %b)`, (e) => {
        const x = e.load("%a", type)
        const y = e.load("%b", type)
        if (isStringLike(type)) {
            e.b.terminate(`ret i32 ${e.fromI64(e.rt("ore_rt_str_cmp", [x, y]), "i32").v}`)
            return
        }
        const lt = compare(e, "<", x, y, type)
        const gt = compare(e, ">", x, y, type)
        const one = e.b.value("i32", `select i1 ${gt.v}, i32 1, i32 0`)
        e.b.terminate(`ret i32 ${e.b.value("i32", `select i1 ${lt.v}, i32 -1, i32 ${one.v}`).v}`)
    })
    return name
}

/**
 * How the runtime hashes and compares the keys of a map (see map.ore): 1 for
 * strings by their bytes, 2 for 8-byte keys by their bits (64-bit integers and
 * references compared by identity), 0 for the others, through the functions
 * of `keyFunctions`.
 */
export function keyKind(g: Emitter, key: Type): string {
    if (isStringLike(key) || (key.kind === "union" && unionRepr(key).k === "strings")) return "1"
    if (key.kind === "int" && key.bits === 64) return "2"
    const k = key.kind
    if (k === "struct" || k === "array" || k === "map" || k === "set" || k === "chan" || k === "ptr")
        return g.mt(key) === "ptr" ? "2" : "0"
    return "0"
}

/** The hash and equality functions of a map key type: `{ hash, eq }` in TypeScript. */
export type KeyFunctions = { hash: string; eq: string }

/**
 * The hash and equality functions of a map key type, as SameValueZero:
 * strings by contents, references by identity, NaN equal to NaN.
 */
export function keyFunctions(g: Emitter, key: Type): KeyFunctions {
    const id = g.names.key(key)
    const hash = globalName(`hash.${id}`)
    const eq = globalName(`eq.${id}`)
    if (g.helpers.has(hash)) return { hash, eq }
    g.helpers.set(hash, "")
    g.helpers.set(eq, "")
    // Both take an unused environment first, so that the runtime calls them as closures.
    helper(g, hash, `define internal i64 ${hash}(ptr %env, ptr %k)`, (e) => {
        const k = e.load("%k", key)
        e.b.terminate(`ret i64 ${keyHash(e, k, key).v}`)
    })
    helper(g, eq, `define internal i1 ${eq}(ptr %env, ptr %a, ptr %b)`, (e) => {
        const a = e.load("%a", key)
        const b = e.load("%b", key)
        e.b.terminate(`ret i1 ${keyEquals(e, a, b, key).v}`)
    })
    return { hash, eq }
}

/** The hash of a map key. */
function keyHash(g: Emitter, k: V, key: Type): V {
    if (key.kind === "union") return unionKeyHash(g, k, key)
    if (key.kind === "float") return g.rt("ore_rt_hash_f64", [convert(g, k, key, types.f64)])
    if (key.kind === "bigint") return g.rt("ore_rt_big_hash", [k])
    if (isStringLike(key)) {
        const data = g.extract(k, 0, "ptr")
        const len = g.extract(k, 1, "i64")
        return g.rt("ore_rt_hash_bytes", [data, len])
    }
    if (key.kind === "interface")
        return g.rt("ore_rt_hash_u64", [g.b.value("i64", `ptrtoint ptr ${g.extract(k, 0, "ptr").v} to i64`)])
    if (k.ty === "ptr") return g.rt("ore_rt_hash_u64", [g.b.value("i64", `ptrtoint ptr ${k.v} to i64`)])
    return g.rt("ore_rt_hash_u64", [g.intToI64(k, key)])
}

/** The hash of a union key: the hash of its member's value plus the member's index. */
function unionKeyHash(g: Emitter, k: V, u: UnionType): V {
    if (unionRepr(u).k === "strings") return keyHash(g, k, types.string)
    const result = g.b.alloca("i64")
    const end = g.b.label("khash")
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        const here = g.b.label("kmember")
        const next = g.b.label("knext")
        g.b.condBr(slotTest(g, u, k, i), here, next)
        g.b.start(here)
        const h = m.kind === "null" ? "0" : keyHash(g, payload(g, u, k, i), m).v
        g.b.emit(`store i64 ${g.b.value("i64", `add i64 ${h}, ${i}`).v}, ptr ${result}`)
        g.b.br(end)
        g.b.start(next)
    }
    g.b.terminate("unreachable")
    g.b.start(end)
    return g.b.value("i64", `load i64, ptr ${result}`)
}

/** Whether two map keys are the same key. */
function keyEquals(g: Emitter, a: V, b: V, key: Type): V {
    if (key.kind === "float") {
        const x = convert(g, a, key, types.f64)
        const y = convert(g, b, key, types.f64)
        return g.rtBool("ore_rt_same_f64", [x, y])
    }
    if (key.kind !== "union" || unionRepr(key).k !== "tagged") return equals(g, a, b, key)
    // The same member, with the same value as that member's keys.
    const u = key
    const result = g.b.alloca("i1")
    g.b.emit(`store i1 false, ptr ${result}`)
    const end = g.b.label("keq")
    const sameTag = g.b.value("i1", `icmp eq i32 ${g.extract(a, 0, "i32").v}, ${g.extract(b, 0, "i32").v}`)
    const check = g.b.label("ktag")
    g.b.condBr(sameTag, check, end)
    g.b.start(check)
    for (let i = 0; i < u.members.length; i++) {
        const m = u.members[i]
        const here = g.b.label("kmember")
        const next = g.b.label("knext")
        g.b.condBr(slotTest(g, u, a, i), here, next)
        g.b.start(here)
        const same = m.kind === "null" ? "true" : keyEquals(g, payload(g, u, a, i), payload(g, u, b, i), m).v
        g.b.emit(`store i1 ${same}, ptr ${result}`)
        g.b.br(end)
        g.b.start(next)
    }
    g.b.terminate("unreachable")
    g.b.start(end)
    return g.b.value("i1", `load i1, ptr ${result}`)
}

export function mapOp(g: Emitter, e: MapOp): V {
    const K = e.mapType.key
    const valueType = e.mapType.value
    const kt = g.mt(K)
    const vt = g.mt(valueType)
    const map = e.map
    switch (e.op) {
        case "new": {
            const keys = keyFunctions(g, K)
            const m = g.rt("ore_rt_map_new", [
                { ty: "i64", v: sizeOf(kt) },
                { ty: "i64", v: sizeOf(vt) },
                { ty: "ptr", v: keys.hash },
                { ty: "ptr", v: keys.eq },
                elementData(g, kt),
                elementData(g, vt),
                entryData(g, kt, vt),
                { ty: "i64", v: keyKind(g, K) },
            ])
            // With entries: an array of [key, value] tuples, set in order.
            const entries = e.value
            if (entries === null) return m
            const at = entries.type
            const pair = at.kind === "array" ? at.elem : at
            if (pair.kind !== "struct") process.panic("new Map: entries are not tuples")
            const array = expr(g, entries)
            const n = g.b.value("i64", `load i64, ptr ${g.field(array.v, ARRAY, 1)}`)
            const k = g.b.alloca(kt)
            const v = g.b.alloca(vt)
            counted(g, n, (i) => {
                const data = g.b.value("ptr", `load ptr, ptr ${g.field(array.v, ARRAY, 0)}`)
                const place = g.b.value("ptr", `getelementptr ptr, ptr ${data.v}, i64 ${i.v}`)
                const entry = g.b.value("ptr", `load ptr, ptr ${place.v}`)
                g.store(g.load(fieldPtr(g, entry.v, pair, "0"), K), k, K)
                g.store(g.load(fieldPtr(g, entry.v, pair, "1"), valueType), v, valueType)
                g.rt("ore_rt_map_set", [m, { ty: "ptr", v: k }, { ty: "ptr", v }])
            })
            return m
        }
        case "size":
            if (map === null) process.panic("map.size without a map")
            return g.b.value("i64", `load i64, ptr ${g.field(expr(g, map).v, MAP, 8)}`)
        case "clear":
            if (map === null) process.panic("map.clear without a map")
            g.rt("ore_rt_map_clear", [expr(g, map)])
            return voidValue
        case "keys":
            if (map === null) process.panic("map.keys without a map")
            return g.rt("ore_rt_map_keys", [expr(g, map)])
        case "values":
            if (map === null) process.panic("map.values without a map")
            return g.rt("ore_rt_map_values", [expr(g, map)])
        case "entries": {
            if (map === null) process.panic("map.entries without a map")
            const at = e.type
            const pair = at.kind === "array" ? at.elem : at
            if (pair.kind !== "struct") process.panic("map.entries: not tuples")
            const m = expr(g, map)
            const out = g.rt("ore_rt_array_new", [g.i64(8), g.i64(0), elementData(g, "ptr")])
            const count = g.b.value("i64", `load i64, ptr ${g.field(m.v, MAP, 6)}`)
            counted(g, count, (i) => {
                const live = g.b.label("live")
                const dead = g.b.label("dead")
                g.b.condBr(g.rtBool("ore_rt_map_live", [m, i]), live, dead)
                g.b.start(live)
                const s = g.structType(pair)
                const entry = g.alloc(s)
                g.store(g.load(g.rt("ore_rt_map_key", [m, i]).v, K), fieldPtr(g, entry.v, pair, "0"), K)
                const value = g.load(g.rt("ore_rt_map_value", [m, i]).v, valueType)
                g.store(value, fieldPtr(g, entry.v, pair, "1"), valueType)
                g.store(entry, g.rt("ore_rt_array_push", [out, g.i64(8)]).v, pair)
                g.b.br(dead)
                g.b.start(dead)
            })
            return out
        }
        default:
            break
    }
    // The map and key (and value) are evaluated in order; the key needs an address.
    const keyExpr = e.key
    if (map === null || keyExpr === null) process.panic(`map.${e.op} without a map or key`)
    const m = expr(g, map)
    const k = g.b.alloca(kt)
    g.store(expr(g, keyExpr), k, K)
    const key: V = { ty: "ptr", v: k }
    switch (e.op) {
        case "get": {
            const result = unionOf(e.type)
            const fused = g.fused
            const p =
                fused !== null && isLocal(map, fused.map) && isLocal(keyExpr, fused.key)
                    ? fused.at
                    : g.rt("ore_rt_map_get", [m, key])
            const found = g.b.value("i1", `icmp ne ptr ${p.v}, null`)
            return choose(
                g,
                found,
                () => recast(g, g.load(p.v, valueType), valueType, result),
                () => inject(g, result, nullIndex(result), null),
                g.lt(result),
            )
        }
        case "set": {
            const v = g.b.alloca(vt)
            const value = e.value
            if (value === null) process.panic("map.set without a value")
            if (map.k === "local" && keyExpr.k === "local" && keyReads(value, map.local, keyExpr.local) > 0) {
                // The key is hashed and looked up once, for the reads and the update.
                const hash = g.b.alloca("i64")
                const at = g.rt("ore_rt_map_find", [m, key, { ty: "ptr", v: hash }])
                const outer = g.fused
                g.fused = new FusedGet(map.local, keyExpr.local, at)
                g.store(expr(g, value), v, valueType)
                g.fused = outer
                const h: V = g.b.value("i64", `load i64, ptr ${hash}`)
                g.rt("ore_rt_map_put", [m, key, h, at, { ty: "ptr", v }])
                return m
            }
            g.store(expr(g, value), v, valueType)
            g.rt("ore_rt_map_set", [m, key, { ty: "ptr", v }])
            return m
        }
        case "has":
            return g.b.value("i1", `icmp ne ptr ${g.rt("ore_rt_map_get", [m, key]).v}, null`)
        default:
            return g.rtBool("ore_rt_map_delete", [m, key])
    }
}

/** Whether `e` reads the local `local`. */
function isLocal(e: Expr, local: Local): bool {
    return e.k === "local" && e.local === local
}

/**
 * How many times `e` reads `map.get(key)`, or -1 when it does anything but
 * that, reading locals and constants, and computing with them: then `map`
 * cannot change while `e` is evaluated, and `map.set(key, e)` may look the
 * key up once, before `e`.
 */
function keyReads(e: Expr, map: Local, key: Local): int {
    switch (e.k) {
        case "int":
            return 0
        case "float":
            return 0
        case "bool":
            return 0
        case "string":
            return 0
        case "null":
            return 0
        case "local":
            return 0
        case "arith":
            return both(keyReads(e.left, map, key), keyReads(e.right, map, key))
        case "compare":
            return both(keyReads(e.left, map, key), keyReads(e.right, map, key))
        case "logical":
            return both(keyReads(e.left, map, key), keyReads(e.right, map, key))
        case "coalesce":
            return both(keyReads(e.value, map, key), keyReads(e.fallback, map, key))
        case "cond":
            return both(keyReads(e.cond, map, key), both(keyReads(e.then, map, key), keyReads(e.else, map, key)))
        case "unary":
            return keyReads(e.operand, map, key)
        case "not":
            return keyReads(e.operand, map, key)
        case "convert":
            return keyReads(e.value, map, key)
        case "recast":
            return keyReads(e.value, map, key)
        case "is-null":
            return keyReads(e.value, map, key)
        case "map": {
            const m = e.map
            const k = e.key
            if (e.op === "get" && m !== null && k !== null && isLocal(m, map) && isLocal(k, key)) return 1
            return -1
        }
        default:
            return -1
    }
}

/** The reads of two parts of an expression, or -1 when either has other effects. */
function both(a: int, b: int): int {
    return a < 0 || b < 0 ? -1 : a + b
}

/** A set is a map whose values take no bytes. */
export function setOp(g: Emitter, e: SetOp): V {
    const T = e.setType.elem
    const t = g.mt(T)
    const set = e.set
    switch (e.op) {
        case "new": {
            const keys = keyFunctions(g, T)
            const s = g.rt("ore_rt_map_new", [
                { ty: "i64", v: sizeOf(t) },
                g.i64(0),
                { ty: "ptr", v: keys.hash },
                { ty: "ptr", v: keys.eq },
                elementData(g, t),
                { ty: "ptr", v: "null" },
                entryData(g, t, ""),
                { ty: "i64", v: keyKind(g, T) },
            ])
            const values = e.value
            if (values !== null) g.rt("ore_rt_map_add_keys", [s, expr(g, values)])
            return s
        }
        case "size":
            if (set === null) process.panic("set.size without a set")
            return g.b.value("i64", `load i64, ptr ${g.field(expr(g, set).v, MAP, 8)}`)
        case "clear":
            if (set === null) process.panic("set.clear without a set")
            g.rt("ore_rt_map_clear", [expr(g, set)])
            return voidValue
        case "values":
            if (set === null) process.panic("set.values without a set")
            return g.rt("ore_rt_map_keys", [expr(g, set)])
        default:
            break
    }
    // The set, then the value, which needs an address.
    const valueExpr = e.value
    if (set === null || valueExpr === null) process.panic(`set.${e.op} without a set or value`)
    const s = expr(g, set)
    const v = g.b.alloca(t)
    g.store(expr(g, valueExpr), v, T)
    const value: V = { ty: "ptr", v }
    switch (e.op) {
        case "add":
            // No bytes of value are copied: the value's address serves.
            g.rt("ore_rt_map_set", [s, value, value])
            return s
        case "has":
            return g.b.value("i1", `icmp ne ptr ${g.rt("ore_rt_map_get", [s, value]).v}, null`)
        default:
            return g.rtBool("ore_rt_map_delete", [s, value])
    }
}

export function chanOp(g: Emitter, e: ChanOp): V {
    const T = e.chanType.elem
    const t = g.mt(T)
    const chan = e.chan
    const value = e.value
    const handler = e.handler
    switch (e.op) {
        case "new":
            if (value === null) process.panic("new Chan without a capacity")
            return g.rt("ore_rt_chan_new", [{ ty: "i64", v: sizeOf(t) }, expr(g, value), elementData(g, t)])
        case "close":
            if (chan === null) process.panic("close without a channel")
            g.rt("ore_rt_chan_close", [expr(g, chan)])
            return voidValue
        case "send": {
            if (chan === null || value === null) process.panic("send without a channel or value")
            // The channel is evaluated before the value, and the value needs an address.
            const c = expr(g, chan)
            const v = g.b.alloca(t)
            g.store(expr(g, value), v, T)
            g.rt("ore_rt_chan_send", [c, { ty: "ptr", v }])
            return voidValue
        }
        case "receive": {
            if (chan === null) process.panic("receive without a channel")
            const u = unionOf(e.type)
            const v = g.b.alloca(t)
            const ok = g.rtBool("ore_rt_chan_recv", [expr(g, chan), { ty: "ptr", v }])
            return choose(
                g,
                ok,
                () => recast(g, g.load(v, T), T, u),
                () => inject(g, u, nullIndex(u), null),
                g.lt(u),
            )
        }
        case "on-receive": {
            if (chan === null || handler === null) process.panic("onReceive without a channel or handler")
            const c = expr(g, chan)
            const h = expr(g, handler)
            const ht = handler.type
            if (ht.kind !== "func") process.panic("onReceive with a handler that is not a function")
            return g.rt("ore_rt_case_recv", [c, h, { ty: "ptr", v: receiveDispatch(g, T, ht) }])
        }
        default: {
            if (chan === null || value === null || handler === null)
                process.panic("onSend without a channel, value or handler")
            const c = expr(g, chan)
            const v = g.b.alloca(t)
            g.store(expr(g, value), v, T)
            return g.rt("ore_rt_case_send", [c, { ty: "ptr", v }, expr(g, handler)])
        }
    }
}

/** A function calling the handler of a receive case with the value, as its `T | null` parameter. */
export function receiveDispatch(g: Emitter, elem: Type, handler: FuncType): string {
    const param = handler.params.length > 0 ? handler.params[0] : null
    const name = globalName(`dispatch.${g.names.key(param ?? elem)}.${handler.params.length}`)
    if (g.helpers.has(name)) return name
    g.helpers.set(name, "")
    helper(g, name, `define internal void ${name}(ptr %c)`, (e) => {
        const ok = e.b.alloca("i8")
        const p = e.rt("ore_rt_case_value", [
            { ty: "ptr", v: "%c" },
            { ty: "ptr", v: ok },
        ])
        const h = e.rt("ore_rt_case_handler", [{ ty: "ptr", v: "%c" }])
        if (param === null) {
            callClosure(e, h, handler, [])
        } else {
            const u = unionOf(param)
            const got = e.b.value("i1", `trunc i8 ${e.b.value("i8", `load i8, ptr ${ok}`).v} to i1`)
            const value = choose(
                e,
                got,
                () => recast(e, e.load(p.v, elem), elem, u),
                () => inject(e, u, nullIndex(u), null),
                e.lt(u),
            )
            callClosure(e, h, handler, [value])
        }
        e.b.terminate("ret void")
    })
    return name
}

/** A method of an interface table that calls the closure in a field of the receiver. */
function fieldThunk(g: Emitter, struct: StructType, name: string, type: FuncType): string {
    const thunk = globalName(`field.${g.names.key(struct)}.${name}`)
    if (g.helpers.has(thunk)) return thunk
    g.helpers.set(thunk, "")
    const params: string[] = ["ptr %this"]
    for (let i = 0; i < type.params.length; i++) params.push(`${g.lt(type.params[i])} %a${i}`)
    const ret = g.lt(type.result)
    helper(g, thunk, `define internal ${ret} ${thunk}(${params.join(", ")})`, (e) => {
        const f = e.load(fieldPtr(e, "%this", struct, name), type)
        const args: V[] = []
        for (let i = 0; i < type.params.length; i++) args.push({ ty: e.lt(type.params[i]), v: `%a${i}` })
        const r = callClosure(e, f, type, args)
        e.b.terminate(ret === "void" ? "ret void" : `ret ${ret} ${r.v}`)
    })
    return thunk
}

/**
 * The entry of an interface table for a field that a struct implements with
 * accessors: the address of a pair of functions, the getter `T (ptr this)`
 * and the setter `void (ptr this, T)` (null for a read-only field), plus
 * 2^63, which makes the entry negative and tells it from a field's offset.
 */
function accessorEntry(g: Emitter, t: Itab, index: int, a: ItabAccessor): string {
    const m = t.iface.members[index]
    const writable = m.k === "field" && !m.readonly
    const pair = globalName(`iacc.${g.names.key(t.struct)}.${m.name}.${writable ? "w" : "r"}`)
    if (!g.helpers.has(pair)) {
        let get = "null"
        let set = "null"
        const getter = a.get
        const setter = a.set
        if (getter !== null) get = globalName(getter.name)
        else get = fieldThunk(g, t.struct, `get ${m.name}`, new FuncType([], m.type))
        if (writable && setter !== null) set = globalName(setter.name)
        else if (writable) set = fieldThunk(g, t.struct, `set ${m.name}`, new FuncType([m.type], types.void))
        g.helpers.set(pair, `${pair} = internal constant [2 x ptr] [ptr ${get}, ptr ${set}]`)
    }
    return `ptr getelementptr (i8, ptr ${pair}, i64 -9223372036854775808)`
}

/**
 * The entry of an interface table for a generic method: the address of the
 * table of the struct's instances of it, in the order of its `GenericSlots`.
 */
function genericEntry(g: Emitter, t: Itab, generic: ItabGeneric): string {
    if (generic.funcs.length === 0) return "ptr null"
    const m = t.iface.members[generic.index]
    const table = globalName(`gtab.${g.names.key(t.struct)}.${g.names.iface(t.iface)}.${m.name}`)
    if (!g.helpers.has(table)) {
        const funcs: string[] = []
        for (const f of generic.funcs) funcs.push(`ptr ${globalName(f.name)}`)
        g.helpers.set(table, `${table} = internal constant [${funcs.length} x ptr] [${funcs.join(", ")}]`)
    }
    return `ptr ${table}`
}

export function itab(g: Emitter, t: Itab): string {
    const s = g.structType(t.struct)
    const all: string[] = [`ptr getelementptr (i8, ptr null, i64 ${g.names.typeId(t.struct)})`]
    for (let i = 0; i < t.iface.members.length; i++) {
        const m = t.iface.members[i]
        let accessor: ItabAccessor | null = null
        for (const a of t.accessors) if (a.index === i) accessor = a
        if (accessor !== null) {
            all.push(accessorEntry(g, t, i, accessor))
            continue
        }
        let generic: ItabGeneric | null = null
        for (const x of t.generics) if (x.index === i) generic = x
        if (generic !== null) {
            all.push(genericEntry(g, t, generic))
            continue
        }
        if (m.k === "field") {
            const field = findField(t.struct, m.name)
            // A missing optional field: -1.
            if (field === null || field.private) all.push("ptr inttoptr (i64 -1 to ptr)")
            else all.push(`ptr getelementptr (${s}, ptr null, i32 0, i32 ${g.fieldIndex(t.struct, m.name)})`)
        } else {
            const method = implementingMethod(t.struct, m.name, m.type)
            if (method === null) {
                // A field holding a closure of the method's type: a thunk calls it.
                all.push(`ptr ${fieldThunk(g, t.struct, m.name, m.type)}`)
                continue
            }
            // A method that a subclass overrides is called through the class table of the instance.
            if (g.tables.has(t.struct.id) && overridden(g.module.structs, t.struct, method.name))
                all.push(`ptr ${virtualThunk(g, method.func)}`)
            else all.push(`ptr ${globalName(method.func.name)}`)
        }
    }
    return `${g.names.itab(t.id, t.struct, t.iface)} = internal constant [${all.length} x ptr] [${all.join(", ")}]`
}

/** The class table of a class with a base class or subclasses: its type id, then its methods by slot. */
export function classTable(g: Emitter, s: StructType): string {
    const all: string[] = [`ptr getelementptr (i8, ptr null, i64 ${g.names.typeId(s)})`]
    for (const m of s.methods) all.push(`ptr ${globalName(m.func.name)}`)
    return `${g.classTable(s)} = internal constant [${all.length} x ptr] [${all.join(", ")}]`
}
