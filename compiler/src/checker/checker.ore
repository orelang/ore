// The checker of a program: runs the layers over every module, in passes,
// into one IR module.

import { Block, Func } from "../ir/nodes"
import { type Type, FuncType, types } from "../ir/types"
import { type Node } from "../syntax/ast"
import { hasModifier, members, nameNode } from "../syntax/nodes"
import { type Program } from "../project/load"
import { Checker } from "./base"
import { builtinScope, globalClasses, globalClassModule, namespaceModule, namespaceNames } from "./builtins"
import {
    checkClassBodies,
    checkFieldInitializers,
    checkImplements,
    declareClass,
    declareClassMembers,
    declareInterface,
    fillInterface,
    finishClasses,
    resolveBase,
} from "./classes"
import { CheckResult, ExportEntry, FuncContext, ModuleInfo } from "./context"
import {
    checkDirectives,
    checkStrictNames,
    checkExports,
    checkExportsDeclared,
    checkFunctionBody,
    checkTopLevelConstants,
    checkUnassigned,
    declareExports,
    declareFunction,
    declareImport,
    declareTypeAlias,
    exportOf,
    isConstantStatement,
    localizeGlobals,
    unsupportedTopLevel,
} from "./declarations"
import { isDeclaration } from "./helpers"
import { checkStatements } from "./statements"
import { Scope } from "./symbols"

/** A function declaration and its function, whose body is checked in the last pass. */
class Body {
    constructor(
        readonly decl: Node,
        readonly func: Func,
        readonly scope: Scope,
    ) {}
}

/** Checks a program of modules into one IR module. */
export function check(program: Program): CheckResult {
    const c = new Checker(program)
    const builtins = builtinScope()
    c.builtins = builtins.scope
    c.addSource(builtins.source)
    for (const stmt of c.statementsOf(builtins.source))
        if (stmt.kind === "InterfaceDeclaration") declareInterface(c, stmt, builtins.scope)
    const error = builtins.scope.lookupType("Error")
    c.errorType = error !== null && error.type.kind === "interface" ? error.type : null

    const modules: ModuleInfo[] = []
    for (let i = 0; i < program.modules.length; i++) {
        const source = program.modules[i]
        const info = new ModuleInfo(
            source,
            new Scope(builtins.scope),
            source === program.entry ? "" : `m${i}_`,
            new Map<string, ExportEntry>(),
        )
        c.modules.set(source, info)
        modules.push(info)
    }
    // Built-in namespaces implemented in Ore take the exports of their module.
    for (const ns of namespaceNames) {
        const symbol = builtins.scope.lookupValue(ns)
        const path = namespaceModule(ns)
        let module: ModuleInfo | null = null
        for (const m of modules) if (module === null && m.source.path === path) module = m
        if (symbol !== null && symbol.k === "namespace" && module !== null) {
            const target = module
            symbol.module = (name) => exportOf(c, target, name)
        }
    }
    const bodies: Body[] = []
    const each = (pass: (stmt: Node, module: ModuleInfo) => void) => {
        for (const module of modules) {
            c.prefix = module.prefix
            for (const stmt of c.statementsOf(module.source)) pass(stmt, module)
        }
        c.prefix = ""
    }

    // Pass 1: exports, imports, and names of classes and interfaces, so that
    // types can refer to them in any order and across modules.
    each((stmt, m) => checkStrictNames(c, stmt, false))
    each((stmt, m) => declareExports(c, stmt, m))
    each((stmt, m) => checkDirectives(c, stmt))
    each((stmt, m) => {
        if (stmt.kind === "ClassDeclaration") declareClass(c, stmt, m.scope)
        else if (stmt.kind === "InterfaceDeclaration") declareInterface(c, stmt, m.scope)
        else if (stmt.kind === "ImportDeclaration") declareImport(c, stmt, m)
    })
    // Classes of the runtime that are global names: `RegExp`, `RegExpMatch`.
    for (const m of modules) {
        if (m.source.path !== globalClassModule) continue
        for (const name of globalClasses) {
            const type = m.scope.ownType(name)
            const value = m.scope.ownValue(name)
            if (type !== null) builtins.scope.declareType(name, type)
            if (value !== null) builtins.scope.declareValue(name, value)
        }
    }

    // Pass 2: type aliases, then signatures of functions and class members,
    // so that they can be used before their declaration and recursively.
    each((stmt, m) => {
        if (stmt.kind === "TypeAliasDeclaration") declareTypeAlias(c, stmt, m.scope)
    })
    for (const [_, info] of c.interfaces) fillInterface(c, info, info.scope)
    for (const info of c.classes) resolveBase(c, info)
    each((stmt, m) => {
        if (stmt.kind !== "FunctionDeclaration") return
        const func = declareFunction(c, stmt, m.scope)
        if (func !== null) bodies.push(new Body(stmt, func, m.scope))
    })
    // Overload signatures without an implementation after them.
    for (const [_, decls] of c.overloadDecls)
        for (const d of decls) c.error(nameNode(d), "This overload signature has no implementation after it.")
    for (const info of c.classes) declareClassMembers(c, info, info.scope)
    checkExports(c, modules)

    // Pass 3: constants in module and source order, field initializers, the
    // top-level code of each module, which declares its global variables, then
    // bodies, which can use the globals.
    const constants = new Set<Node>()
    each((stmt, m) => {
        if (stmt.kind === "EnumDeclaration" || stmt.kind === "ModuleDeclaration")
            c.error(stmt, unsupportedTopLevel(stmt))
        else if (
            stmt.kind === "VariableStatement" &&
            isConstantStatement(c, stmt, m.scope) &&
            checkTopLevelConstants(c, stmt, m.scope)
        )
            constants.add(stmt)
    })
    for (const info of c.classes) checkFieldInitializers(c, info, info.scope)
    for (const info of c.classes) checkImplements(c, info, info.scope)
    for (const m of modules) {
        checkTopLevel(
            c,
            m,
            (stmt) =>
                (!isDeclaration(stmt) || hasStaticFields(stmt)) &&
                !constants.has(stmt) &&
                stmt.kind !== "EnumDeclaration" &&
                stmt.kind !== "ModuleDeclaration",
        )
    }
    checkExportsDeclared(c, modules)
    for (const b of bodies) checkFunctionBody(c, b.decl, b.func, b.scope)
    for (const info of c.classes) checkClassBodies(c, info, info.scope)
    // In order, including the checks that these add.
    for (let i = 0; i < c.pending.length; i++) c.pending[i]()
    finishClasses(c)
    localizeGlobals(c)
    checkUnassigned(c)

    let hasErrors = false
    for (const d of c.diagnostics) if (d.severity === "error") hasErrors = true
    c.info.sources = c.sources
    return new CheckResult(hasErrors ? null : c.module, c.diagnostics, c.info)
}

/** Whether a class declaration has static fields, which its top-level code initializes. */
function hasStaticFields(stmt: Node): bool {
    if (stmt.kind !== "ClassDeclaration") return false
    for (const m of members(stmt)) if (m.kind === "PropertyDeclaration" && hasModifier(m, "StaticKeyword")) return true
    return false
}

/**
 * The top-level code of a module, run when the program starts: its
 * variables are globals, visible to the functions of the module.
 */
function checkTopLevel(c: Checker, module: ModuleInfo, isCode: (stmt: Node) => bool) {
    const func = new Func(
        `ore_init_${module.prefix}`,
        "<top level>",
        1,
        new FuncType([], types.void),
        [],
        new Block([]),
        false,
        module.source.path,
    )
    c.prefix = module.prefix
    c.globals = module.scope
    c.facts = [new Map<string, Type>()]
    c.fn = new FuncContext(types.void, [], 0, null, null, null, null, false, false, true)
    c.pushFacts([])
    checkStatements(c, c.statementsOf(module.source).filter(isCode), module.scope, func.body.body)
    c.popFacts()
    c.fn = null
    c.globals = null
    c.prefix = ""
    c.module.functions.push(func)
    c.module.inits.push(func)
}
