// The checker of a program: runs the layers over every module, in passes,
// into one IR module.

import { Block, Func } from "../ir/nodes"
import { type Type, FuncType, types } from "../ir/types"
import { type Node } from "../syntax/ast"
import { hasModifier, members, nameNode, typeParameters } from "../syntax/nodes"
import { type Source } from "../syntax/source"
import { type Program } from "../project/load"
import { Checker } from "./base"
import {
    builtinScope,
    errorModule,
    globalClasses,
    globalClassModules,
    globalTypeModule,
    namespaceAtPath,
    namespaceModule,
    namespaceNames,
} from "./builtins"
import {
    checkAllInitializers,
    checkClassBodies,
    checkFieldInitializers,
    checkImplements,
    checkWaitingInitializers,
    declareClass,
    declareClassMembers,
    declareInterface,
    extendsClass,
    isDictInterface,
    fillInterface,
    finishClasses,
    resolveBase,
} from "./classes"
import { CheckResult, ExportEntry, FuncContext, type InterfaceInfo, ModuleInfo } from "./context"
import {
    addEmptyGlobals,
    checkDirectives,
    checkStrictNames,
    checkExports,
    checkExportsDeclared,
    checkFunctionBody,
    checkTopLevelConstants,
    checkUnassigned,
    declareExports,
    declareFunction,
    declareImport,
    declareTypeAliases,
    exportOf,
    isConstantStatement,
    localizeGlobals,
    typeJsonImports,
    unsupportedTopLevel,
} from "./declarations"
import { globalObject, resolveGlobalThis } from "./globals"
import { isDeclaration } from "./helpers"
import { instantiateSlots } from "./slots"
import { checkStatements } from "./statements"
import { addTemplateSites } from "./templates"
import { Generic, type Instance, Scope, TypeSymbol } from "./symbols"

/** A function declaration and its function, whose body is checked in the last pass. */
class Body {
    constructor(
        readonly decl: Node,
        readonly func: Func,
        readonly scope: Scope,
    ) {}
}

/**
 * Checks a program of modules into one IR module. The bodies of the
 * functions and classes of the modules in `signaturesOnly` are not checked:
 * the language server leaves out those of the runtime and the standard
 * library, which the user's modules use only through their declarations.
 * The IR module is then incomplete.
 */
export function check(program: Program, signaturesOnly?: Set<Source>): CheckResult {
    const c = new Checker(program)
    const skipped = signaturesOnly ?? new Set<Source>()
    const builtins = builtinScope()
    c.builtins = builtins.scope
    c.addSource(builtins.source)
    for (const stmt of c.statementsOf(builtins.source))
        if (stmt.kind === "InterfaceDeclaration") declareInterface(c, stmt, builtins.scope)
    const error = builtins.scope.lookupType("Error")
    c.errorType = error !== null && error.type.kind === "interface" ? error.type : null

    const modules: ModuleInfo[] = []
    for (let i = 0; i < program.modules.length; i++) {
        const source = program.modules[i]
        const info = new ModuleInfo(
            source,
            new Scope(builtins.scope),
            source === program.entry ? "" : `m${i}_`,
            new Map<string, ExportEntry>(),
        )
        c.modules.set(source, info)
        modules.push(info)
    }
    // Built-in namespaces implemented in Ore take the exports of their module.
    for (const ns of namespaceNames) {
        const symbol = namespaceAtPath(builtins.scope, ns)
        const path = namespaceModule(ns)
        let module: ModuleInfo | null = null
        for (const m of modules) if (module === null && m.source.path === path) module = m
        if (symbol !== null && module !== null) {
            const target = module
            symbol.module = (name) => exportOf(c, target, name)
        }
    }
    const bodies: Body[] = []
    const each = (pass: (stmt: Node, module: ModuleInfo) => void) => {
        for (const module of modules) {
            c.prefix = module.prefix
            for (const stmt of c.statementsOf(module.source)) pass(stmt, module)
        }
        c.prefix = ""
    }

    // Pass 1: exports, imports, and names of classes and interfaces, so that
    // types can refer to them in any order and across modules.
    each((stmt, m) => checkStrictNames(c, stmt, false))
    each((stmt, m) => declareExports(c, stmt, m))
    each((stmt, m) => checkDirectives(c, stmt))
    each((stmt, m) => {
        if (stmt.kind === "ClassDeclaration") declareClass(c, stmt, m.scope)
        else if (stmt.kind === "InterfaceDeclaration") declareInterface(c, stmt, m.scope)
        else if (stmt.kind === "ImportDeclaration") declareImport(c, stmt, m)
    })
    // Classes of the runtime that are global names: `RegExp`, `RegExpMatch`, `Promise`, `Date`;
    // and the utility types, `Partial` and the others.
    for (const m of modules) {
        if (m.source.path === globalTypeModule) {
            for (const stmt of c.statementsOf(m.source)) {
                if (stmt.kind !== "TypeAliasDeclaration") continue
                const generic = new Generic(
                    nameNode(stmt).text,
                    stmt,
                    typeParameters(stmt),
                    m.scope,
                    new Map<string, Instance>(),
                )
                builtins.scope.declareType(generic.name, new TypeSymbol(types.never, stmt, generic))
            }
        }
        // The class of `new Error(...)`, which classes extend with `extends Error`; as a value, for `Error.isError`.
        if (m.source.path === errorModule) {
            const errorClass = m.scope.ownType("Error")
            if (errorClass !== null) {
                const t = errorClass.type
                if (t.kind === "struct") c.basicError = t
            }
            const errorValue = m.scope.ownValue("Error")
            if (errorValue !== null) builtins.scope.declareValue("Error", errorValue)
        }
        for (let i = 0; i < globalClasses.length; i++) {
            if (m.source.path !== globalClassModules[i]) continue
            const name = globalClasses[i]
            const type = m.scope.ownType(name)
            const value = m.scope.ownValue(name)
            if (type !== null) builtins.scope.declareType(name, type)
            if (value !== null) builtins.scope.declareValue(name, value)
        }
    }
    // `globalThis.name`, now that every global name is declared.
    const sources: Source[] = []
    for (const m of modules) sources.push(m.source)
    resolveGlobalThis(c, sources, builtins.scope)

    // Pass 2: type aliases, then signatures of functions and class members,
    // so that they can be used before their declaration and recursively.
    for (const module of modules) {
        c.prefix = module.prefix
        const aliases: Node[] = []
        // And interfaces that are dictionaries, `interface D { name: string; [key: string]: string }`.
        for (const stmt of c.statementsOf(module.source))
            if (stmt.kind === "TypeAliasDeclaration" || isDictInterface(stmt)) aliases.push(stmt)
        declareTypeAliases(c, aliases, module.scope)
    }
    c.prefix = ""
    // Interfaces that extend a class wait for the members of classes.
    const late: InterfaceInfo[] = []
    for (const [_, info] of c.interfaces)
        if (extendsClass(c, info)) late.push(info)
        else fillInterface(c, info, info.scope)
    for (const info of c.classes) resolveBase(c, info)
    each((stmt, m) => {
        if (stmt.kind !== "FunctionDeclaration") return
        const func = declareFunction(c, stmt, m.scope)
        if (func !== null) bodies.push(new Body(stmt, func, m.scope))
    })
    // The functions of the runtime that are global names, `atob` and `btoa`, now declared.
    for (const m of modules) {
        for (let i = 0; i < globalClasses.length; i++) {
            if (m.source.path !== globalClassModules[i] || m.scope.ownType(globalClasses[i]) !== null) continue
            const value = m.scope.ownValue(globalClasses[i])
            if (value === null) continue
            builtins.scope.declareValue(globalClasses[i], value)
            builtins.scope.declareValue(`${globalObject}.${globalClasses[i]}`, value)
        }
    }
    // Overload signatures without an implementation after them.
    for (const [_, decls] of c.overloadDecls)
        for (const d of decls) c.error(nameNode(d), "This overload signature has no implementation after it.")
    for (const info of c.classes) declareClassMembers(c, info, info.scope)
    for (const info of late) fillInterface(c, info, info.scope)
    checkExports(c, modules)
    typeJsonImports(c)

    // Pass 3: constants in module and source order, the initializers of fields
    // without annotations, the top-level code of each module, which declares its
    // global variables, then the other field initializers and bodies, which can
    // use the globals.
    const constants = new Set<Node>()
    each((stmt, m) => {
        if (stmt.kind === "EnumDeclaration" || stmt.kind === "ModuleDeclaration")
            c.error(stmt, unsupportedTopLevel(stmt))
        else if (
            stmt.kind === "VariableStatement" &&
            isConstantStatement(c, stmt, m.scope) &&
            checkTopLevelConstants(c, stmt, m.scope)
        )
            constants.add(stmt)
    })
    for (const info of c.classes) checkFieldInitializers(c, info, info.scope)
    // Classes with fields that wait for module variables implement their interfaces once those have types.
    const waited = c.waitingClasses.slice()
    for (const info of c.classes) if (!waited.some((x) => x === info)) checkImplements(c, info, info.scope)
    c.variablesDeclared = () => checkWaitingInitializers(c)
    for (const m of modules) {
        checkTopLevel(
            c,
            m,
            (stmt) =>
                (!isDeclaration(stmt) || hasStaticFields(stmt)) &&
                !constants.has(stmt) &&
                stmt.kind !== "EnumDeclaration" &&
                stmt.kind !== "ModuleDeclaration",
        )
    }
    c.variablesDeclared = null
    // The other field initializers, which run when an instance is constructed, see every module variable.
    for (const info of c.classes) checkAllInitializers(c, info)
    for (const info of c.classes) if (waited.some((x) => x === info)) checkImplements(c, info, info.scope)
    checkExportsDeclared(c, modules)
    for (const b of bodies) if (!skipped.has(c.sourceOf(b.decl))) checkFunctionBody(c, b.decl, b.func, b.scope)
    for (const info of c.classes) if (!skipped.has(c.sourceOf(info.decl))) checkClassBodies(c, info, info.scope)
    // In order, including the checks that these add.
    for (let i = 0; i < c.pending.length; i++) c.pending[i]()
    // The instances of generic methods called through interfaces, and what their bodies add.
    instantiateSlots(c)
    finishClasses(c)
    addTemplateSites(c)
    localizeGlobals(c)
    checkUnassigned(c)
    addEmptyGlobals(c)

    let hasErrors = false
    for (const d of c.diagnostics) if (d.severity === "error") hasErrors = true
    c.info.sources = c.sources
    c.info.members = c.memberDecls
    return new CheckResult(hasErrors ? null : c.module, c.diagnostics, c.info)
}

/** Whether a class declaration has static fields or blocks, which its top-level code initializes and runs. */
function hasStaticFields(stmt: Node): bool {
    if (stmt.kind !== "ClassDeclaration") return false
    for (const m of members(stmt)) {
        if (m.kind === "PropertyDeclaration" && hasModifier(m, "StaticKeyword")) return true
        if (m.kind === "ClassStaticBlockDeclaration") return true
    }
    return false
}

/**
 * The top-level code of a module, run when the program starts: its
 * variables are globals, visible to the functions of the module.
 */
function checkTopLevel(c: Checker, module: ModuleInfo, isCode: (stmt: Node) => bool) {
    const func = new Func(
        `ore_init_${module.prefix}`,
        "<top level>",
        1,
        new FuncType([], types.void),
        [],
        new Block([]),
        false,
        module.source.path,
    )
    c.prefix = module.prefix
    c.globals = module.scope
    c.facts = [new Map<string, Type>()]
    const fn = new FuncContext(types.void, [], 0, null, null, null, null, false, false, true)
    fn.nullThis = true
    c.fn = fn
    c.pushFacts([])
    checkStatements(c, c.statementsOf(module.source).filter(isCode), module.scope, func.body.body)
    c.popFacts()
    c.fn = null
    c.globals = null
    c.prefix = ""
    c.module.functions.push(func)
    c.module.inits.push(func)
}
