// Tables and pure functions of the checker.

import {
    type ArithOp,
    type CompareOp,
    type Expr,
    type Local,
    type LValue,
    type Stmt,
    ArrayLit,
    BigIntLit,
    BoolLit,
    BuiltinCall,
    FloatLit,
    IntLit,
    MapOp,
    SetOp,
    NullLit,
    Recast,
    StringLit,
} from "../ir/nodes"
import {
    type BigIntType,
    type FloatType,
    type IntType,
    type FuncType,
    type Type,
    Field,
    arrayOf,
    findField,
    findMethod,
    isNumeric,
    isSubclass,
    membersOf,
    sameType,
    types,
    typeToString,
    unionRepr,
} from "../ir/types"
import { type Node } from "../syntax/ast"
import { args, expression, isIdentifier, nameNode, typeName } from "../syntax/nodes"
import { bigFromF64, bigParse, bigText } from "./bigint"
import { type Operand, Typed, UntypedFloat, UntypedInt } from "./operand"

export const arithOps = new Map<string, ArithOp>([
    ["PlusToken", "+"],
    ["MinusToken", "-"],
    ["AsteriskToken", "*"],
    ["SlashToken", "/"],
    ["PercentToken", "%"],
    ["AsteriskAsteriskToken", "**"],
    ["AmpersandToken", "&"],
    ["BarToken", "|"],
    ["CaretToken", "^"],
    ["LessThanLessThanToken", "<<"],
    ["GreaterThanGreaterThanToken", ">>"],
])

export const compoundOps = new Map<string, ArithOp>([
    ["PlusEqualsToken", "+"],
    ["MinusEqualsToken", "-"],
    ["AsteriskEqualsToken", "*"],
    ["SlashEqualsToken", "/"],
    ["PercentEqualsToken", "%"],
    ["AsteriskAsteriskEqualsToken", "**"],
    ["AmpersandEqualsToken", "&"],
    ["BarEqualsToken", "|"],
    ["CaretEqualsToken", "^"],
    ["LessThanLessThanEqualsToken", "<<"],
    ["GreaterThanGreaterThanEqualsToken", ">>"],
])

export const compareOps = new Map<string, CompareOp>([
    ["EqualsEqualsEqualsToken", "==="],
    ["ExclamationEqualsEqualsToken", "!=="],
    ["LessThanToken", "<"],
    ["LessThanEqualsToken", "<="],
    ["GreaterThanToken", ">"],
    ["GreaterThanEqualsToken", ">="],
])

/** A string method: parameter types, how many trailing ones are optional, and the result. */
export class StringMethodSig {
    constructor(
        readonly params: Type[],
        readonly optional: int,
        readonly result: Type,
        /** Whether the result is `result | null`, which the checker makes. */
        readonly nullable: bool,
    ) {}
}

function sig(params: Type[], optional: int, result: Type): StringMethodSig {
    return new StringMethodSig(params, optional, result, false)
}

/**
 * String methods: parameter types, how many trailing ones are optional, and
 * the result. `replace` and `replaceAll` also take a function, and `concat`
 * any number of strings: the checker handles those.
 */
export const stringMethods = new Map<string, StringMethodSig>([
    ["at", new StringMethodSig([types.i64], 1, types.string, true)],
    ["charAt", sig([types.i64], 1, types.string)],
    ["charCodeAt", new StringMethodSig([types.i64], 1, types.i64, true)],
    ["codePointAt", new StringMethodSig([types.i64], 1, types.i64, true)],
    ["indexOf", sig([types.string, types.i64], 1, types.i64)],
    ["lastIndexOf", sig([types.string, types.i64], 1, types.i64)],
    ["includes", sig([types.string, types.i64], 1, types.bool)],
    ["startsWith", sig([types.string, types.i64], 1, types.bool)],
    ["endsWith", sig([types.string, types.i64], 1, types.bool)],
    ["split", sig([types.string, types.i64], 1, arrayOf(types.string))],
    ["trim", sig([], 0, types.string)],
    ["trimStart", sig([], 0, types.string)],
    ["trimEnd", sig([], 0, types.string)],
    ["trimLeft", sig([], 0, types.string)],
    ["trimRight", sig([], 0, types.string)],
    ["toUpperCase", sig([], 0, types.string)],
    ["toLowerCase", sig([], 0, types.string)],
    ["toLocaleUpperCase", sig([], 0, types.string)],
    ["toLocaleLowerCase", sig([], 0, types.string)],
    ["normalize", sig([types.string], 1, types.string)],
    ["isWellFormed", sig([], 0, types.bool)],
    ["toWellFormed", sig([], 0, types.string)],
    ["localeCompare", sig([types.string], 0, types.i64)],
    ["replace", sig([types.string, types.string], 0, types.string)],
    ["replaceAll", sig([types.string, types.string], 0, types.string)],
    ["repeat", sig([types.i64], 0, types.string)],
    ["padStart", sig([types.i64, types.string], 1, types.string)],
    ["padEnd", sig([types.i64, types.string], 1, types.string)],
    ["substring", sig([types.i64, types.i64], 1, types.string)],
    ["substr", sig([types.i64, types.i64], 1, types.string)],
    ["toString", sig([], 0, types.string)],
    ["valueOf", sig([], 0, types.string)],
])

/** The minimum and maximum argument counts of an array method; a maximum of -1 is no limit. */
export class Arity {
    constructor(
        readonly min: int,
        readonly max: int,
    ) {}
}

/** Array methods handled by `arrayMethod`, with their minimum and maximum argument counts. */
export const arrayMethods = new Map<string, Arity>([
    ["at", new Arity(1, 1)],
    ["concat", new Arity(0, -1)],
    ["copyWithin", new Arity(1, 3)],
    ["entries", new Arity(0, 0)],
    ["every", new Arity(1, 1)],
    ["fill", new Arity(1, 3)],
    ["filter", new Arity(1, 1)],
    ["find", new Arity(1, 1)],
    ["findIndex", new Arity(1, 1)],
    ["findLast", new Arity(1, 1)],
    ["findLastIndex", new Arity(1, 1)],
    ["flat", new Arity(0, 1)],
    ["flatMap", new Arity(1, 1)],
    ["forEach", new Arity(1, 1)],
    ["includes", new Arity(1, 2)],
    ["indexOf", new Arity(1, 2)],
    ["join", new Arity(0, 1)],
    ["keys", new Arity(0, 0)],
    ["lastIndexOf", new Arity(1, 2)],
    ["map", new Arity(1, 1)],
    ["reduce", new Arity(1, 2)],
    ["reduceRight", new Arity(1, 2)],
    ["reverse", new Arity(0, 0)],
    ["shift", new Arity(0, 0)],
    ["some", new Arity(1, 1)],
    ["sort", new Arity(0, 1)],
    ["splice", new Arity(0, -1)],
    ["toReversed", new Arity(0, 0)],
    ["toSorted", new Arity(0, 1)],
    ["toSpliced", new Arity(0, -1)],
    ["unshift", new Arity(0, -1)],
    ["values", new Arity(0, 0)],
    ["with", new Arity(2, 2)],
])

/** `null` before it gets a union type from the context. */
export const nullOperand: Expr = new NullLit(types.null)

/** The member name of `[Symbol.dispose]`. */
export const disposeName = "[Symbol.dispose]"

/** The member name of `[Symbol.iterator]`. */
export const iteratorName = "[Symbol.iterator]"

/** The words that strict mode reserves, which cannot name bindings in Ore. */
export const strictReserved = [
    "implements",
    "interface",
    "let",
    "package",
    "private",
    "protected",
    "public",
    "static",
    "yield",
]

/** The error of an index signature (`[key: string]: T`) in an interface, an object type or a class. */
export const indexSignatureMessage =
    "An index signature makes a dictionary, '{ name: string; [key: string]: T }': it is not a member of a class, of a generic interface or of an interface that extends another."

export function isSymbolDispose(node: Node): bool {
    return wellKnownSymbol(node) === disposeName
}

/** The member name of a well-known symbol, `Symbol.dispose` or `Symbol.iterator`, or null for any other expression. */
export function wellKnownSymbol(node: Node): string | null {
    if (node.kind !== "PropertyAccessExpression") return null
    const object = node.child("expression")
    if (object === null || !isIdentifier(object) || object.text !== "Symbol") return null
    const name = nameNode(node).text
    if (name === "dispose") return disposeName
    if (name === "iterator") return iteratorName
    return null
}

/** Built-in functions that moved into namespaces. */
function renamed(name: string): string | null {
    if (name === "println") return "console.log"
    if (name === "print") return "console.write"
    if (name === "panic") return "process.panic"
    return null
}

export function unknownName(name: string): string {
    const hint = renamed(name)
    return hint !== null ? `Cannot find name '${name}'. Use '${hint}'.` : `Cannot find name '${name}'.`
}

const hexDigits = "0123456789abcdef"

function hex(n: i32): string {
    if (n === 0) return "0"
    let s = ""
    let v = n
    while (v > 0) {
        s = hexDigits.slice(v & 15, (v & 15) + 1) + s
        v = v >> 4
    }
    return s
}

function isCNameByte(c: u8, first: bool): bool {
    if ((c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a) || c === 0x5f) return true
    return !first && c >= 0x30 && c <= 0x39
}

/** `/^[A-Za-z_][A-Za-z0-9_]*$/`. */
export function isCName(name: string): bool {
    if (name.length === 0) return false
    for (let i = 0; i < name.length; i++) if (!isCNameByte(name[i], i === 0)) return false
    return true
}

/** A C identifier for a source name: other characters become `_x<hex>_` of their code point. */
export function cIdent(name: string): string {
    let out = ""
    let i = 0
    for (const r of name) {
        const width = r < 0x80 ? 1 : r < 0x800 ? 2 : r < 0x10000 ? 3 : 4
        if (isCNameByte(name[i], false)) out += name.slice(i, i + 1)
        else out += `_x${hex(r)}_`
        i += width
    }
    return out
}

/** Whether a type annotation refers to any of the type parameter names. */
export function mentions(node: Node, names: string[]): bool {
    if (node.kind === "TypeReference") {
        const name = typeName(node)
        if (isIdentifier(name) && names.includes(name.text)) return true
    }
    for (const child of node.children) if (mentions(child, names)) return true
    return false
}

/** Whether a value of type `from` can be a member `m` of a union: the same type, a string literal for `string`, or a subclass for a class. */
export function memberOf(from: Type, m: Type): bool {
    return (
        sameType(from, m) ||
        (from.kind === "literal" && m.kind === "string") ||
        (from.kind === "bool" && m.kind === "bool" && m.literal === "") ||
        (from.kind === "number-literal" && (m.kind === "float" || m.kind === "int")) ||
        (from.kind === "struct" && m.kind === "struct" && isSubclass(from, m))
    )
}

/** The first `this` or `super` in a subtree, other than the callee of a `super(...)` call. */
export function findThis(node: Node): Node | null {
    if (node.kind === "ThisKeyword" || node.kind === "SuperKeyword") return node
    if (node.kind === "CallExpression" && expression(node).kind === "SuperKeyword") {
        for (const arg of args(node)) {
            const found = findThis(arg)
            if (found !== null) return found
        }
        return null
    }
    for (const child of node.children) {
        const found = findThis(child)
        if (found !== null) return found
    }
    return null
}

/** The type of a public field of a struct or interface, if it has one. */
export function fieldType(type: Type, name: string): Type | null {
    if (type.kind === "struct") {
        const field = findField(type, name)
        return field !== null && !field.private ? field.type : null
    }
    if (type.kind === "interface") {
        for (const m of type.members) if (m.name === name) return m.k === "field" ? m.type : null
        return null
    }
    return null
}

/** Whether a type other than a union can be a `Map` key: numbers, strings and references. */
export function isKeyType(type: Type): bool {
    const k = type.kind
    return (
        isNumeric(type) ||
        k === "bool" ||
        k === "string" ||
        k === "bigint" ||
        k === "literal" ||
        k === "struct" ||
        k === "array" ||
        k === "interface" ||
        k === "map" ||
        k === "set"
    )
}

/** A public field of a class or a field of an interface, with its type and whether it is read-only. */
export function memberField(type: Type, name: string): Field | null {
    if (type.kind === "struct") {
        const field = findField(type, name)
        return field !== null && !field.private ? field : null
    }
    if (type.kind === "interface") {
        for (const m of type.members)
            if (m.name === name) return m.k === "field" ? new Field(name, m.type, m.readonly) : null
        return null
    }
    return null
}

/** The type of a public method of a class or interface, if it has one. */
export function methodType(type: Type, name: string): FuncType | null {
    if (type.kind === "struct") {
        const method = findMethod(type, name)
        return method !== null && !method.private ? method.func.type : null
    }
    if (type.kind === "interface") {
        for (const m of type.members) if (m.name === name) return m.k === "method" ? m.type : null
        return null
    }
    return null
}

/** Statements handled by the declaration passes. */
export function isDeclaration(stmt: Node): bool {
    const k = stmt.kind
    return (
        k === "TypeAliasDeclaration" ||
        k === "FunctionDeclaration" ||
        k === "ClassDeclaration" ||
        k === "InterfaceDeclaration" ||
        k === "ImportDeclaration" ||
        k === "ExportDeclaration" ||
        k === "ExportAssignment" ||
        k === "EmptyStatement"
    )
}

/** The known directives in order, and what each applies to. */
export const directiveNames = ["internal", "noinline", "inline", "cold", "naked", "export", "runtime", "threadlocal"]

/** What a directive applies to: "function", "variable" or "module"; null for an unknown one. */
export function directiveKind(name: string): string | null {
    switch (name) {
        case "internal":
            return "module"
        case "noinline":
        case "inline":
        case "cold":
        case "naked":
        case "export":
        case "runtime":
            return "function"
        case "threadlocal":
            return "variable"
    }
    return null
}

export function canBeNull(type: Type): bool {
    if (type.kind === "unknown") return true
    for (const m of membersOf(type)) if (m.kind === "null") return true
    return false
}

export function isNull(value: Operand): bool {
    return value.k === "typed" && value.expr.type.kind === "null"
}

/** The typed operand of a string, or null. */
export function isString(value: Operand): bool {
    return value.k === "typed" && value.expr.type.kind === "string"
}

export function typed(expr: Expr): Operand {
    return new Typed(expr)
}

export function typeOf(expr: Expr): Type {
    return expr.type
}

function hasRadixPrefix(text: string): bool {
    if (text.length < 2 || text[0] !== 0x30) return false
    const p = text[1]
    return p === 0x78 || p === 0x58 || p === 0x6f || p === 0x4f || p === 0x62 || p === 0x42
}

export function numericLiteral(text: string): Operand {
    const clean = text.replaceAll("_", "")
    if (hasRadixPrefix(clean) || !(clean.includes(".") || clean.includes("e") || clean.includes("E"))) {
        return new UntypedInt(bigParse(clean))
    }
    return new UntypedFloat(Number.parseFloat(clean) ?? 0.0)
}

/** The name of the conversion to a type: `BigInt` for `bigint`, else the type's name, as `i64`. */
export function conversionName(t: Type): string {
    return t.kind === "bigint" ? "BigInt" : typeToString(t)
}

/** A bigint literal such as `0x1f_ffn`: its value in decimal. */
export function bigintLiteral(text: string): BigIntLit {
    const clean = text.replaceAll("_", "")
    return new BigIntLit(types.bigint, bigText(bigParse(clean.slice(0, clean.length - 1))))
}

/** The type of an arithmetic operation: an integer or float type, or `bigint`; else null. */
export function arithType(t: Type): IntType | FloatType | BigIntType | null {
    if (t.kind === "int") return t
    if (t.kind === "float") return t
    if (t.kind === "bigint") return t
    return null
}

/** An integer or float type, or null: `isNumeric` as a narrowing. */
export function numericType(t: Type): IntType | FloatType | null {
    if (t.kind === "int") return t
    if (t.kind === "float") return t
    return null
}

export function floatLit(type: FloatType, value: f64): FloatLit {
    return new FloatLit(type, type.bits === 32 ? f64(f32(value)) : value)
}

/** Whether a type has a zero value for variables without an initializer; references do not. */
export function hasZeroValue(type: Type): bool {
    if (type.kind === "union") {
        for (const m of type.members) if (m.kind === "null") return true
        return false
    }
    // Only a tagged template makes a `TemplateStringsArray`.
    if (type.kind === "array" && type.template) return false
    return (
        type.kind !== "struct" &&
        type.kind !== "interface" &&
        type.kind !== "chan" &&
        type.kind !== "func" &&
        type.kind !== "number-literal"
    )
}

/** Whether values of a type can be Map keys and Set elements: numbers and strings by value, references by identity, and unions of those and null. */
export function hashable(type: Type): bool {
    return type.kind === "union" ? type.members.every((m) => m.kind === "null" || isKeyType(m)) : isKeyType(type)
}

/**
 * Whether the zero value of a type is not all zero bits, so that a field
 * without an initializer is set to it by the constructor: `""`, `[]`, a new
 * map, or the null of a tagged union.
 */
export function zeroNeedsInit(type: Type): bool {
    if (type.kind === "union") return hasZeroValue(type) && unionRepr(type).k === "tagged"
    return (
        type.kind === "string" ||
        (type.kind === "array" && !type.template) ||
        type.kind === "map" ||
        type.kind === "set"
    )
}

export function zeroValue(type: Type): Expr {
    switch (type.kind) {
        case "int":
            return new IntLit(type, 0)
        case "float":
            return new FloatLit(type, 0.0)
        case "bool":
            return new BoolLit(type, false)
        case "string":
            return new StringLit(type, "")
        case "bigint":
            return new BigIntLit(type, "0")
        case "array":
            return new ArrayLit(type, [])
        case "map":
            return new MapOp("new", type, type)
        case "set":
            return new SetOp("new", type, type)
        case "union":
            return new NullLit(type)
        case "unknown":
            return new Recast(type, new NullLit(types.null))
        case "ptr":
            // The null pointer.
            return new BuiltinCall(type, "unsafe.fromInt", [new IntLit(types.u64, 0)])
        default:
            return poison(type)
    }
}

/**
 * Placeholder for an expression with a reported error. It has the expected
 * type to avoid cascading errors and never reaches codegen. (An `int` node of
 * that type in TypeScript; here a recast of one, since an `IntLit` has an
 * integer type.)
 */
export function poison(type: Type): Expr {
    if (type.kind === "int") return new IntLit(type, 0)
    return new Recast(type, new IntLit(types.i64, 0))
}

export function isLiteral(expr: Expr): bool {
    return expr.k === "int" || expr.k === "float" || expr.k === "bool" || expr.k === "string" || expr.k === "bigint"
}

export function isTrue(expr: Expr): bool {
    return expr.k === "bool" && expr.value
}

function someTerminates(stmts: Stmt[]): bool {
    for (const s of stmts) if (terminates(s)) return true
    return false
}

/** Whether control can never fall through the end of a statement. */
export function terminates(stmt: Stmt): bool {
    switch (stmt.k) {
        case "return":
            return true
        case "block":
            return someTerminates(stmt.body)
        case "if": {
            const otherwise = stmt.else
            return otherwise !== null && terminates(stmt.then) && terminates(otherwise)
        }
        case "loop":
            return stmt.cond === null && !breaks(stmt.body, stmt.id, false)
        case "expr":
            return stmt.expr.type.kind === "never"
        case "using":
            return someTerminates(stmt.body)
        case "switch": {
            // Without a default, no clause may run. Otherwise execution ends at the
            // end of the last clause, unless a break exits the switch.
            if (stmt.clauses.length === 0) return false
            const last = stmt.clauses[stmt.clauses.length - 1]
            let hasDefault = false
            for (const c of stmt.clauses) if (c.test === null) hasDefault = true
            let anyBreaks = false
            for (const c of stmt.clauses) for (const s of c.body) if (breaks(s, stmt.id, false)) anyBreaks = true
            return (stmt.exhaustive || hasDefault) && someTerminates(last.body) && !anyBreaks
        }
        default:
            return false
    }
}

/** Whether control never reaches the statement after this one: it returns, panics, breaks or continues. */
export function exits(stmt: Stmt): bool {
    switch (stmt.k) {
        case "break":
        case "continue":
            return true
        case "block":
            for (const s of stmt.body) if (exits(s)) return true
            return false
        case "if": {
            const otherwise = stmt.else
            return otherwise !== null && exits(stmt.then) && exits(otherwise)
        }
        default:
            return terminates(stmt)
    }
}

/** Whether a statement contains a `break` that exits the loop `loopId`. */
export function breaks(stmt: Stmt, loopId: int, nested: bool): bool {
    switch (stmt.k) {
        case "break":
            return stmt.target === null ? !nested : stmt.target === loopId
        case "block":
            for (const s of stmt.body) if (breaks(s, loopId, nested)) return true
            return false
        case "if": {
            if (breaks(stmt.then, loopId, nested)) return true
            const otherwise = stmt.else
            return otherwise !== null && breaks(otherwise, loopId, nested)
        }
        case "loop":
        case "for-of":
            return breaks(stmt.body, loopId, true)
        case "switch":
            for (const c of stmt.clauses) for (const s of c.body) if (breaks(s, loopId, true)) return true
            return false
        case "using":
            for (const s of stmt.body) if (breaks(s, loopId, nested)) return true
            return false
        default:
            return false
    }
}

/** Calls `visit` for every local used or declared in a subtree of IR, without entering other functions. */
export function visitLocals(stmt: Stmt, visit: (local: Local) => void) {
    switch (stmt.k) {
        case "block":
            for (const s of stmt.body) visitLocals(s, visit)
            return
        case "let": {
            visit(stmt.local)
            const init = stmt.init
            if (init !== null) visitLocalsExpr(init, visit)
            return
        }
        case "expr":
            visitLocalsExpr(stmt.expr, visit)
            return
        case "if": {
            visitLocalsExpr(stmt.cond, visit)
            visitLocals(stmt.then, visit)
            const otherwise = stmt.else
            if (otherwise !== null) visitLocals(otherwise, visit)
            return
        }
        case "loop": {
            const cond = stmt.cond
            if (cond !== null) visitLocalsExpr(cond, visit)
            const update = stmt.update
            if (update !== null) visitLocalsExpr(update, visit)
            visitLocals(stmt.body, visit)
            return
        }
        case "for-of":
            visit(stmt.local)
            visitLocalsExpr(stmt.iterable, visit)
            visitLocals(stmt.body, visit)
            return
        case "switch":
            visit(stmt.local)
            visitLocalsExpr(stmt.value, visit)
            for (const c of stmt.clauses) {
                const test = c.test
                if (test !== null) visitLocalsExpr(test, visit)
                for (const s of c.body) visitLocals(s, visit)
            }
            return
        case "using":
            visit(stmt.local)
            visitLocalsExpr(stmt.init, visit)
            visitLocals(stmt.dispose, visit)
            for (const s of stmt.body) visitLocals(s, visit)
            return
        case "return": {
            const value = stmt.value
            if (value !== null) visitLocalsExpr(value, visit)
            return
        }
        default:
            return
    }
}

function visitLocalsLValue(target: LValue, visit: (local: Local) => void) {
    switch (target.k) {
        case "local":
            visit(target.local)
            return
        case "element":
            visitLocalsExpr(target.array, visit)
            visitLocalsExpr(target.index, visit)
            return
        case "field":
            visitLocalsExpr(target.object, visit)
            return
        case "iface-field":
        case "union-field":
            visitLocalsExpr(target.value, visit)
            return
    }
}

function visitLocalsAll(exprs: Expr[], visit: (local: Local) => void) {
    for (const e of exprs) visitLocalsExpr(e, visit)
}

export function visitLocalsExpr(e: Expr, visit: (local: Local) => void) {
    switch (e.k) {
        case "local":
            visit(e.local)
            return
        case "assign":
            visitLocalsLValue(e.target, visit)
            visitLocalsExpr(e.value, visit)
            return
        case "incdec":
            visitLocalsLValue(e.target, visit)
            return
        case "arith":
        case "compare":
        case "logical":
            visitLocalsExpr(e.left, visit)
            visitLocalsExpr(e.right, visit)
            return
        case "unary":
        case "not":
            visitLocalsExpr(e.operand, visit)
            return
        case "convert":
        case "len":
        case "recast":
        case "is-null":
        case "union-field":
        case "typeof":
        case "is":
        case "downcast":
        case "to-iface":
        case "iface-field":
            visitLocalsExpr(e.value, visit)
            return
        case "call":
        case "builtin":
            visitLocalsAll(e.args, visit)
            return
        case "cond":
            visitLocalsExpr(e.cond, visit)
            visitLocalsExpr(e.then, visit)
            visitLocalsExpr(e.else, visit)
            return
        case "concat":
            visitLocalsAll(e.parts, visit)
            return
        case "index":
            visitLocalsExpr(e.target, visit)
            visitLocalsExpr(e.index, visit)
            return
        case "slice": {
            visitLocalsExpr(e.value, visit)
            const start = e.start
            if (start !== null) visitLocalsExpr(start, visit)
            const end = e.end
            if (end !== null) visitLocalsExpr(end, visit)
            return
        }
        case "array":
            visitLocalsAll(e.elems, visit)
            return
        case "push":
            visitLocalsExpr(e.array, visit)
            visitLocalsAll(e.values, visit)
            return
        case "pop":
            visitLocalsExpr(e.array, visit)
            return
        case "object":
            for (const f of e.fields) visitLocalsExpr(f.value, visit)
            return
        case "field":
            visitLocalsExpr(e.object, visit)
            return
        case "method-call":
            visitLocalsExpr(e.receiver, visit)
            visitLocalsAll(e.args, visit)
            return
        case "iface-call":
            visitLocalsExpr(e.value, visit)
            visitLocalsAll(e.args, visit)
            return
        case "optional":
            visitLocalsExpr(e.value, visit)
            visit(e.binding)
            visitLocalsExpr(e.body, visit)
            return
        case "coalesce":
            visitLocalsExpr(e.value, visit)
            visitLocalsExpr(e.fallback, visit)
            return
        case "map": {
            const map = e.map
            if (map !== null) visitLocalsExpr(map, visit)
            const key = e.key
            if (key !== null) visitLocalsExpr(key, visit)
            const value = e.value
            if (value !== null) visitLocalsExpr(value, visit)
            return
        }
        case "set": {
            const set = e.set
            if (set !== null) visitLocalsExpr(set, visit)
            const value = e.value
            if (value !== null) visitLocalsExpr(value, visit)
            return
        }
        case "call-value":
            visitLocalsExpr(e.callee, visit)
            visitLocalsAll(e.args, visit)
            return
        case "bound-method":
            visitLocalsExpr(e.receiver, visit)
            return
        case "array-method":
            visitLocalsExpr(e.array, visit)
            visitLocalsAll(e.args, visit)
            return
        case "string-method":
            visitLocalsExpr(e.value, visit)
            visitLocalsAll(e.args, visit)
            return
        case "chan": {
            const chan = e.chan
            if (chan !== null) visitLocalsExpr(chan, visit)
            const value = e.value
            if (value !== null) visitLocalsExpr(value, visit)
            const handler = e.handler
            if (handler !== null) visitLocalsExpr(handler, visit)
            return
        }
        case "bind":
            for (const b of e.locals) {
                visit(b.local)
                visitLocalsExpr(b.init, visit)
            }
            visitLocalsExpr(e.body, visit)
            return
        case "seq":
            visitLocalsAll(e.exprs, visit)
            return
        default:
            return
    }
}

/** The name of a parameter's local: its own, or a made-up one for a destructured parameter. */
export function paramName(p: Node, index: int): string {
    const name = nameNode(p)
    return isIdentifier(name) ? name.text : `param${index}`
}
