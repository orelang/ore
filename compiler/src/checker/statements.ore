// Statements, destructuring, closures and narrowing.

import {
    type Expr,
    type LoopStmt,
    type Stmt,
    Assign,
    Bind,
    BindLocal,
    Block,
    BreakStmt,
    Closure,
    Coalesce,
    Compare,
    Conditional,
    ContinueStmt,
    Downcast,
    ExprStmt,
    FieldGet,
