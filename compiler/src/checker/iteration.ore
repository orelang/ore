// The iteration protocol: `for...of`, spread, `Array.from`, `new Map`,
// `new Set` and `yield*` over values with a `[Symbol.iterator]()` method,
// whose iterator's `next()` returns an `IteratorResult` until it is done.
// Arrays, strings, maps, sets and channels keep their own loops (their
// `[Symbol.iterator]()` makes an iterator of the runtime, see
// `builtinIteratorOf`); a generator is advanced by its `advance()` and
// `current()`, without the result objects of `next()`.
//
// `for await` over values with a `[Symbol.asyncIterator]()` method, whose
// iterator's `next()` returns a promise of an `IteratorResult`, or over any
// other iterable, whose values it awaits with the ticks of JavaScript's
// async-from-sync iterator (see "ore:runtime/iterator-async").

import {
    type Expr,
    type Stmt,
    Assign,
    Bind,
    BindLocal,
    Block,
    BoolLit,
    BoundMethod,
    BreakStmt,
    Call,
    ExprStmt,
    FieldGet,
    IfStmt,
    LetStmt,
    type Local,
    Func,
    LocalLValue,
    LocalRef,
    LoopStmt,
    MapOp,
    MethodCall,
    Not,
    NullLit,
    Recast,
    SetOp,
    UnionField,
    UsingStmt,
} from "../ir/nodes"
import { type Type, arrayOf, findField, findMethod, isStringLike, sameType, types, typeToString } from "../ir/types"
import { type Node } from "../syntax/ast"
import { awaitExpr, promiseValue } from "./async"
import { type Checker } from "./base"
import { dispatch } from "./classes"
import { asyncIteratorFunc, isIteratorObject, iteratorFunc, iteratorInstance } from "./generators"
import { asyncIteratorName, iteratorName, typed } from "./helpers"
import { symbolMethodCall } from "./statements"

/** A `next()` call on an iterator, of a struct or an interface type. */
function nextCall(c: Checker, iterator: Expr): Expr | null {
    return symbolMethodCall(c, iterator, "next")
}

/**
 * For the result type of an iterator's `next()`, `IteratorResult<T, TReturn>`
 * (`{ done: false; value: T } | { done: true; value: TReturn }`): the member
 * that is not done, whose `value` has type T.
 */
export function notDone(type: Type): Type | null {
    if (type.kind !== "union") return null
    for (const m of type.members) {
        if (m.kind !== "struct") continue
        const done = findField(m, "done")
        if (done !== null && typeToString(done.type) === "false" && findField(m, "value") !== null) return m
    }
    return null
}

/** The type of the values of an iterator, or null when it has no `next()` that returns an `IteratorResult`. */
export function iteratorValue(c: Checker, iterator: Type): Type | null {
    const generator = iteratorInstance(c, iterator, "Generator")
    if (generator !== null) return generator[0]
    let result: Type | null = null
    if (iterator.kind === "struct") {
        const m = findMethod(iterator, "next")
        if (m !== null && m.func.params.length === 0) result = m.func.type.result
    } else if (iterator.kind === "interface") {
        for (const m of iterator.members) if (m.name === "next" && m.k === "method") result = m.type.result
    }
    if (result === null) return null
    const member = notDone(result)
    if (member === null || member.kind !== "struct") return null
    return findField(member, "value")!.type
}

/**
 * The iterator of an iterable value of a class or interface type: the value
 * itself for a generator or another `IteratorObject`, else its
 * `[Symbol.iterator]()`. Reports a type that is not iterable.
 */
export function iteratorOf(c: Checker, value: Expr, node: Node): Expr | null {
    const type = value.type
    if (iteratorInstance(c, type, "Generator") !== null || isIteratorObject(c, type)) return value
    const builtin = builtinIteratorOf(c, value, node)
    if (builtin !== null) return builtin
    if (type.kind === "struct" || type.kind === "interface") {
        const call = symbolMethodCall(c, value, iteratorName)
        if (call !== null && iteratorValue(c, call.type) !== null) return call
    }
    c.error(node, `Type '${typeToString(type)}' is not iterable: it needs a '[Symbol.iterator]()' method.`)
    return null
}

/**
 * The `[Symbol.iterator]()` of an array, a string, a set or a map (not a
 * dictionary), an `IteratorObject` of the runtime: `ArrayIterator`,
 * `StringIterator` (the characters as strings), `SetIterator` or
 * `MapIterator` (the entries). Null for any other value.
 */
export function builtinIteratorOf(c: Checker, value: Expr, node: Node): Expr | null {
    const type = value.type
    let builtin: Func | null = null
    let arg = value
    if (type.kind === "array") builtin = iteratorFunc(c, "arrayValues", [type.elem], node)
    else if (type.kind === "set") builtin = iteratorFunc(c, "setValues", [type.elem], node)
    else if (type.kind === "map" && !type.dict) builtin = iteratorFunc(c, "mapEntries", [type.key, type.value], node)
    else if (isStringLike(type) || (type.kind === "union" && type.members.every(isStringLike))) {
        builtin = iteratorFunc(c, "stringValues", [], node)
        if (!sameType(type, types.string)) arg = new Recast(types.string, value)
    }
    return builtin !== null ? new Call(builtin.type.result, builtin, [arg]) : null
}

/**
 * `Iterator.from(value)`, as JavaScript's: the iterator of a string, an
 * array, a set or a map; an `IteratorObject` itself (a generator, an
 * iterator of the runtime or of a class that extends it); else the
 * iterator of its `[Symbol.iterator]()`, or the value itself when it has
 * only `next()`, which when it is not an `IteratorObject` is wrapped in one
 * whose `close()` calls its `return()`. Reports a value that is neither.
 */
export function iteratorFrom(c: Checker, value: Expr, node: Node): Expr | null {
    const builtin = builtinIteratorOf(c, value, node)
    if (builtin !== null) return builtin
    if (!isProtocolIterable(value.type)) {
        c.error(node, `Type '${typeToString(value.type)}' is not iterable: it needs a '[Symbol.iterator]()' method.`)
        return null
    }
    let iterator: Expr = value
    if (iteratorInstance(c, value.type, "Generator") === null && !isIteratorObject(c, value.type)) {
        const call = symbolMethodCall(c, value, iteratorName)
        if (call !== null) iterator = call
    }
    const type = iterator.type
    if (iteratorInstance(c, type, "Generator") !== null || isIteratorObject(c, type)) return iterator
    const elem = iteratorValue(c, type)
    if (elem === null) {
        c.error(node, `Type '${typeToString(value.type)}' is not iterable: it needs a '[Symbol.iterator]()' method.`)
        return null
    }
    // The iterator is wrapped, and its `return()`, when it has one, called by the wrapper's.
    const local = c.newLocal("iterator", type, false)
    const ref: Expr = new LocalRef(type, local)
    const returning = boundReturn(c, ref)
    const f =
        returning !== null
            ? iteratorFunc(c, "wrapReturning", [elem, returning.type.result], node)
            : iteratorFunc(c, "wrapIterator", [elem], node)
    if (f === null) return null
    const args: Expr[] = [c.coerce(typed(ref), f.type.params[0], node)]
    if (returning !== null) args.push(returning)
    return new Bind(f.type.result, [new BindLocal(local, iterator)], new Call(f.type.result, f, args))
}

/** An iterator's `return()` without parameters, as a function value, or null when it has none. */
function boundReturn(c: Checker, iterator: Expr): BoundMethod | null {
    const type = iterator.type
    if (type.kind === "struct") {
        const method = findMethod(type, "return")
        if (method === null || method.func.params.length !== 0) return null
        const bound = new BoundMethod(method.func.type, iterator, method.func)
        dispatch(c, bound, "return")
        return bound
    }
    if (type.kind === "interface") {
        for (let index = 0; index < type.members.length; index++) {
            const m = type.members[index]
            if (m.name !== "return") continue
            if (m.k === "method" && m.type.params.length === 0) return new BoundMethod(m.type, iterator, null, index)
            return null
        }
    }
    return null
}

/** Whether values of `type` are iterated through the iteration protocol: classes and interfaces. */
export function isProtocolIterable(type: Type): bool {
    return type.kind === "struct" || type.kind === "interface"
}

/**
 * The elements of an iterable value as an array: an array itself, the
 * values of a set, the entries of a map, or what an iterator yields.
 * Reports a value that is not iterable.
 */
export function toArray(c: Checker, value: Expr, node: Node): Expr | null {
    const type = value.type
    if (type.kind === "array") return value
    if (type.kind === "set") return new SetOp("values", arrayOf(type.elem), type, value)
    if (type.kind === "map") return new MapOp("entries", arrayOf(c.tupleOf([type.key, type.value])), type, value)
    if (!isProtocolIterable(type)) {
        c.error(node, `Type '${typeToString(type)}' is not iterable: it needs a '[Symbol.iterator]()' method.`)
        return null
    }
    const iterator = iteratorOf(c, value, node)
    if (iterator === null) return null
    const elem = iteratorValue(c, iterator.type)!
    const generator = iteratorInstance(c, iterator.type, "Generator")
    if (generator !== null) {
        const f = iteratorFunc(c, "generatorToArray", generator, node)
        return f !== null ? new Call(arrayOf(elem), f, [iterator]) : null
    }
    const f = iteratorFunc(c, "iteratorToArray", [elem], node)
    if (f === null) return null
    const it = c.coerce(typed(iterator), f.type.params[0], node)
    return new Call(arrayOf(elem), f, [it])
}

/**
 * `for (const x of iterable)` over an iterable of a class or interface type,
 * with the loop variable `local` (or the hidden one of a pattern) and the
 * statements that unpack it, `prologue`, before the body: a loop over its
 * iterator that ends when `next()` is done. When the loop is left early,
 * `return()` ends the iterator: for a generator always, for another
 * iterator when it has a `return()` without arguments, else for an
 * `IteratorObject` by its `close()`.
 */
export function protocolLoop(
    c: Checker,
    iterator: Expr,
    local: Local,
    id: int,
    labeled: bool,
    prologue: Stmt[],
    body: Stmt,
    node: Node,
): Stmt {
    const itLocal = c.newLocal("iterator", iterator.type, false)
    const it: Expr = new LocalRef(iterator.type, itLocal)
    const generator = iteratorInstance(c, iterator.type, "Generator")
    const first: Stmt[] = []
    let dispose: Stmt | null = null
    if (generator !== null && iterator.type.kind === "struct") {
        const advance = findMethod(iterator.type, "advance")!.func
        const current = findMethod(iterator.type, "current")!.func
        const close = findMethod(iterator.type, "close")!.func
        const none = c.coerce(typed(new NullLit(types.null)), advance.params[0].type, node)
        first.push(new IfStmt(new Not(types.bool, new MethodCall(types.bool, advance, it, [none])), new BreakStmt()))
        first.push(new LetStmt(local, new MethodCall(local.type, current, it, [])))
        dispose = new ExprStmt(new MethodCall(types.void, close, it, []))
    } else {
        const next = nextCall(c, it)!
        const member = notDone(next.type)!
        const resultLocal = c.newLocal("result", next.type, false)
        const result: Expr = new LocalRef(next.type, resultLocal)
        const doneLocal = c.newLocal("done", types.bool, true)
        first.push(new LetStmt(resultLocal, next))
        const finished: Stmt[] = []
        let returning = symbolMethodCall(c, it, "return")
        // Else an `IteratorObject` is ended by its `close()`, which subclasses override.
        if (returning === null && isIteratorObject(c, iterator.type)) returning = symbolMethodCall(c, it, "close")
        if (returning !== null) {
            finished.push(
                new ExprStmt(new Assign(types.bool, new LocalLValue(doneLocal), new BoolLit(types.bool, true))),
            )
            dispose = new IfStmt(new Not(types.bool, new LocalRef(types.bool, doneLocal)), new ExprStmt(returning))
        }
        finished.push(new BreakStmt())
        first.push(new IfStmt(new UnionField(types.bool, result, "done"), new Block(finished)))
        first.push(new LetStmt(local, new FieldGet(local.type, new Recast(member, result), "value")))
        if (returning !== null) {
            const loop = loopOf(id, labeled, first, prologue, body)
            const doneInit: Stmt = new LetStmt(doneLocal, new BoolLit(types.bool, false))
            return new Block([doneInit, new UsingStmt(itLocal, iterator, dispose!, [loop])])
        }
    }
    const loop = loopOf(id, labeled, first, prologue, body)
    if (dispose !== null) return new UsingStmt(itLocal, iterator, dispose, [loop])
    return new Block([new LetStmt(itLocal, iterator), loop])
}

function loopOf(id: int, labeled: bool, first: Stmt[], prologue: Stmt[], body: Stmt): Stmt {
    const all: Stmt[] = []
    for (const s of first) all.push(s)
    for (const s of prologue) all.push(s)
    all.push(body)
    return new LoopStmt(id, labeled, false, new Block(all))
}

/** How `for await` iterates a value: what `asyncSource` tells. */
export class AsyncSource {
    constructor(
        /**
         * The iterator: an async generator, another async iterator, or the
         * iterator of an iterable that is not async.
         */
        readonly iterator: Expr,
        /** The type of the values, awaited. */
        readonly elem: Type,
        /** Whether the iterator is not async: its values, or the values of its promises, are awaited one by one. */
        readonly sync: bool,
        /** Of an iterator that is not async: whether its values are promises. */
        readonly promises: bool,
    ) {}
}

/** Whether a class or interface type has a method `name` without parameters. */
function hasMethod(type: Type, name: string): bool {
    if (type.kind === "struct") {
        const m = findMethod(type, name)
        return m !== null && m.func.params.length === 0
    }
    if (type.kind === "interface") for (const m of type.members) if (m.name === name && m.k === "method") return true
    return false
}

/**
 * The type of the values of an async iterator, whose `next()` returns a
 * promise of an `IteratorResult`; null for any other type.
 */
function asyncIteratorValue(c: Checker, iterator: Type): Type | null {
    const generator = iteratorInstance(c, iterator, "AsyncGenerator")
    if (generator !== null) return generator[0]
    let result: Type | null = null
    if (iterator.kind === "struct") {
        const m = findMethod(iterator, "next")
        if (m !== null && m.func.params.length === 0) result = m.func.type.result
    } else if (iterator.kind === "interface") {
        for (const m of iterator.members) if (m.name === "next" && m.k === "method") result = m.type.result
    }
    const resolved = result !== null ? promiseValue(c, result) : null
    if (resolved === null) return null
    const member = notDone(resolved)
    if (member === null || member.kind !== "struct") return null
    return findField(member, "value")!.type
}

/**
 * How `for await`, `yield*` in an async generator and `Array.fromAsync`
 * iterate `value`: by its `[Symbol.asyncIterator]()` (an async generator is
 * its own iterator), whose `next()` returns a promise of an
 * `IteratorResult`; else as `for...of` does, each value awaited, the value of
 * a promise for a promise. Reports a value that is neither.
 */
export function asyncSource(c: Checker, value: Expr, node: Node): AsyncSource | null {
    const type = value.type
    const generator = iteratorInstance(c, type, "AsyncGenerator")
    if (generator !== null) return new AsyncSource(value, generator[0], false, false)
    if (hasMethod(type, asyncIteratorName)) {
        const call = symbolMethodCall(c, value, asyncIteratorName)
        if (call === null) return null
        const elem = asyncIteratorValue(c, call.type)
        if (elem !== null) return new AsyncSource(call, elem, false, false)
    } else if (
        isStringLike(type) ||
        (type.kind === "union" && type.members.every(isStringLike)) ||
        type.kind === "array" ||
        type.kind === "set" ||
        (type.kind === "map" && !type.dict) ||
        iteratorInstance(c, type, "Generator") !== null ||
        isIteratorObject(c, type) ||
        hasMethod(type, iteratorName)
    ) {
        const iterator = iteratorOf(c, value, node)
        if (iterator === null) return null
        const elem = iteratorValue(c, iterator.type)!
        const awaited = promiseValue(c, elem)
        if (awaited !== null) return new AsyncSource(iterator, awaited, true, true)
        if (elem.kind === "union" && elem.members.some((m) => promiseValue(c, m) !== null)) {
            c.error(node, "A union of promises and other values cannot be awaited yet.")
            return null
        }
        return new AsyncSource(iterator, elem, true, false)
    }
    c.error(
        node,
        `Type '${typeToString(type)}' is not async iterable: it needs a '[Symbol.asyncIterator]()' method whose iterator's 'next()' returns a promise of an 'IteratorResult', or a '[Symbol.iterator]()' method.`,
    )
    return null
}

/**
 * `for await (const x of iterable)` over the iterator of `source`, with the
 * loop variable `local` (or the hidden one of a pattern) and the statements
 * that unpack it, `prologue`, before the body: each step awaits the promise
 * of `next()`, or, of an iterator that is not async, awaits its value as
 * JavaScript's async-from-sync iterator does, until it is done. When the
 * loop is left early, it awaits the iterator's `return()` if it has one
 * without arguments (an async generator's `close()`); of an iterator that is
 * not async, it calls its `return()` (a generator's `close()`) and waits as
 * the async-from-sync iterator does.
 */
export function asyncLoop(
    c: Checker,
    source: AsyncSource,
    local: Local,
    id: int,
    labeled: bool,
    prologue: Stmt[],
    body: Stmt,
    node: Node,
): Stmt | null {
    const iterator = source.iterator
    const itLocal = c.newLocal("iterator", iterator.type, false)
    const it: Expr = new LocalRef(iterator.type, itLocal)
    const call = nextCall(c, it)
    if (call === null) return null
    const next = source.sync ? call : awaitExpr(c, call, node)
    if (next === null) return null
    const member = notDone(next.type)
    if (member === null || member.kind !== "struct") return null
    const resultLocal = c.newLocal("result", next.type, false)
    const result: Expr = new LocalRef(next.type, resultLocal)
    const doneLocal = c.newLocal("done", types.bool, true)
    const first: Stmt[] = [new LetStmt(resultLocal, next)]
    const finished: Stmt[] = []
    if (source.sync) {
        const f = asyncIteratorFunc(c, "awaitStepDone", [], node)
        if (f === null) return null
        finished.push(new ExprStmt(new Call(types.void, f, [])))
    }
    finished.push(new ExprStmt(new Assign(types.bool, new LocalLValue(doneLocal), new BoolLit(types.bool, true))))
    finished.push(new BreakStmt())
    first.push(new IfStmt(new UnionField(types.bool, result, "done"), new Block(finished)))
    const memberValue = findField(member, "value")!.type
    let value: Expr = new FieldGet(memberValue, new Recast(member, result), "value")
    if (source.sync) {
        const step = source.promises ? "awaitPromiseStep" : "awaitStep"
        const f = asyncIteratorFunc(c, step, [local.type], node)
        if (f === null) return null
        value = new Call(local.type, f, [value])
    }
    first.push(new LetStmt(local, value))
    // What ends the iterator when the loop is left early.
    const generator =
        iteratorInstance(c, iterator.type, "AsyncGenerator") !== null ||
        iteratorInstance(c, iterator.type, "Generator") !== null
    let closing = symbolMethodCall(c, it, generator ? "close" : "return")
    const returns = closing !== null
    if (closing === null && source.sync && isIteratorObject(c, iterator.type))
        closing = symbolMethodCall(c, it, "close")
    const ending: Stmt[] = []
    if (closing !== null) {
        if (source.sync || closing.type.kind === "void") ending.push(new ExprStmt(closing))
        else {
            const awaited = awaitExpr(c, closing, node)
            if (awaited === null) return null
            ending.push(new ExprStmt(awaited))
        }
    }
    if (source.sync) {
        const f = asyncIteratorFunc(c, "awaitStepClose", [], node)
        if (f === null) return null
        ending.push(new ExprStmt(new Call(types.void, f, [new BoolLit(types.bool, returns)])))
    }
    const loop = loopOf(id, labeled, first, prologue, body)
    const doneInit: Stmt = new LetStmt(doneLocal, new BoolLit(types.bool, false))
    if (ending.length === 0) return new Block([doneInit, new LetStmt(itLocal, iterator), loop])
    const dispose: Stmt = new IfStmt(new Not(types.bool, new LocalRef(types.bool, doneLocal)), new Block(ending))
    return new Block([doneInit, new UsingStmt(itLocal, iterator, dispose, [loop])])
}
