// Async functions and `await`, compiled to calls of the runtime's
// "ore:runtime/promise": the body of an async function is a closure that
// `asyncCall` runs as a fiber of the event loop, resolving the promise the
// function returns with what the body returns; `await` is `awaitPromise`
// for a promise and `awaitValue` for any other value.

import { type Expr, type Stmt, Block, Call, Closure, ExprStmt, Func, NullLit, ReturnStmt, Seq } from "../ir/nodes"
import { type Type, FuncType, types } from "../ir/types"
import { type Node } from "../syntax/ast"
import { body, expression, hasModifier } from "../syntax/nodes"
import { type Checker } from "./base"
import { FuncContext, InferredReturns } from "./context"
import { checkReturns, instantiate } from "./declarations"
import { checkExpr } from "./expressions"
import { terminates, typed } from "./helpers"
import { type Operand, errorOperand } from "./operand"
import { checkBlock } from "./statements"
import { GenericFuncSymbol, Scope } from "./symbols"

const promiseModule = "ore:runtime/promise"

/** Whether a function, method or arrow function is `async`. */
export function isAsync(node: Node): bool {
    return hasModifier(node, "AsyncKeyword")
}

/** The type `Promise<T>`. */
export function promiseOf(c: Checker, value: Type, node: Node): Type | null {
    const symbol = c.builtins!.lookupType("Promise")
    const generic = symbol !== null ? symbol.generic : null
    if (generic === null) return null
    const instance = instantiate(c, generic, [value], node)
    return instance !== null && !(instance instanceof Func) ? instance : null
}

/** For an instance of `Promise<T>`: T; null for any other type. */
export function promiseValue(c: Checker, type: Type): Type | null {
    const info = type.kind === "struct" ? c.instanceOf.get(type) : null
    if (info === null || info.generic.name !== "Promise" || info.args.length !== 1) return null
    // Only the runtime's class, not one of the program named the same.
    if (!c.sourceOf(info.generic.decl).path.startsWith(promiseModule)) return null
    // `Promise<void>` holds null, the value of a void type argument.
    return info.args[0].kind === "void" ? types.null : info.args[0]
}

/**
 * For `Promise<T> | null`, which `void | Promise<T>` is (the result of a
 * callback that may be async): the promise type; null for any other type.
 */
export function promiseOrNull(c: Checker, type: Type): Type | null {
    if (type.kind !== "union" || type.members.length !== 2) return null
    let promise: Type | null = null
    let hasNull = false
    for (const m of type.members) {
        if (m.kind === "null") hasNull = true
        else if (promiseValue(c, m) !== null) promise = m
    }
    return hasNull ? promise : null
}

/**
 * The value type T of an async function's result type, which must be
 * `Promise<T>`, as in TypeScript; reports any other.
 */
export function asyncValue(c: Checker, result: Type, node: Node): Type | null {
    const value = promiseValue(c, result)
    if (value === null) c.error(node, "The return type of an async function must be 'Promise<T>'.")
    return value
}

/** A function of the runtime's promise module, instantiated for `typeArgs`. */
function runtimeFunc(c: Checker, name: string, typeArgs: Type[], node: Node): Func | null {
    for (const [source, info] of c.modules) {
        if (source.path !== promiseModule) continue
        const symbol = info.scope.ownValue(name)
        if (!(symbol instanceof GenericFuncSymbol)) process.panic(`async: no function ${name}`)
        const found = instantiate(c, symbol.generic, typeArgs, node)
        if (found instanceof Func) return found
    }
    return null
}

/** The statements of an async function's body, and its result type `Promise<T>`. */
export class AsyncBody {
    constructor(
        readonly stmts: Stmt[],
        readonly type: Type,
    ) {}
}

/**
 * The body of an async function `decl`, whose promise has the value type
 * `declared`: a closure of the body, which returns a value or a promise of
 * it, called by `asyncCall`. Returns the statements of the function's body,
 * which returns the promise as a `wrapped` when that is not null (a `void |
 * Promise<T>`). Without a value type (`declared` null), the body gives it,
 * as in TypeScript: the union of the types of the values returned (of a
 * promise's value for a promise), with null when the body also returns
 * without a value or can end without a return; `Promise<void>` when it
 * returns no value.
 */
export function checkAsyncBody(
    c: Checker,
    decl: Node,
    scope: Scope,
    declared: Type | null,
    name: string,
    wrapped: Type | null = null,
): AsyncBody | null {
    const outer = c.fn!
    let value: Type = types.null
    let promise: Type | null = null
    let result: Type = types.null
    if (declared !== null) {
        value = declared
        promise = promiseOf(c, value, decl)
        if (promise === null) return null
        result = value.kind === "null" ? types.null : c.unionOf([value, promise])
    }
    const func = new Func(
        `ore_lambda_${c.nextLambda++}`,
        `${name}.<async>`,
        c.line(decl),
        new FuncType([], result),
        [],
        new Block([]),
        false,
        c.sourceOf(decl).path,
        false,
        null,
        null,
        [],
    )
    c.module.functions.push(func)
    const inner = new Scope(scope, func)
    // The body sees `this` of the enclosing method, as an arrow function does.
    const captures: Func[] = [func]
    if (outer.thisCaptures !== null) for (const f of outer.thisCaptures) captures.push(f)
    const savedFacts = c.facts
    c.facts = [new Map<string, Type>()]
    c.fn = new FuncContext(result, [], 0, func, captures, outer.thisLocal, outer.cls)
    c.fn.inAsync = true
    const returns = declared === null ? new InferredReturns() : null
    c.fn.returns = returns
    const fnBody = body(decl)!
    if (fnBody.kind === "Block") {
        func.body = checkBlock(c, fnBody, inner)
    } else {
        const v = checkExpr(c, fnBody, inner, returns !== null ? null : result)
        if (v.k !== "error") {
            if (result.kind === "null" && v.k === "typed" && v.expr.type.kind === "void")
                func.body = new Block([new ExprStmt(v.expr)])
            else if (returns !== null) func.body = new Block([inferredReturn(c, v, returns, fnBody)])
            else func.body = new Block([new ReturnStmt(c.coerce(v, result, fnBody))])
        }
    }
    c.fn = outer
    c.facts = savedFacts
    let type: Type | null = promise
    if (returns !== null) {
        // Untyped constants take their default type, as the elements of an array literal do.
        const found = returns.types.slice()
        if (returns.floats) found.push(types.f64)
        else if (returns.ints) found.push(types.i64)
        // Beside values, a return without one or the end of the body gives null: TypeScript's undefined.
        const ends = !terminates(func.body)
        if (found.length > 0 && (returns.empty || ends)) found.push(types.null)
        if (found.length > 0) value = c.unionOf(found)
        promise = promiseOf(c, value, decl)
        if (promise === null) return null
        // Without a value returned, `Promise<void>`, whose value is null.
        type = found.length > 0 ? promise : promiseOf(c, types.void, decl)
        if (found.length > 0) result = c.unionOf([value, promise])
        if (found.length > 0 && ends)
            func.body.body.push(new ReturnStmt(c.coerce(typed(new NullLit(types.null)), result, decl)))
        func.type = new FuncType([], result)
        returns.result = result
        for (const fix of returns.fixups) fix()
    }
    checkReturns(c, func, decl)
    const call = runtimeFunc(c, "asyncCall", [value], decl)
    if (call === null || promise === null || type === null) return null
    const closure: Expr = new Closure(func.type, func)
    const started: Expr = new Call(promise, call, [closure])
    const stmts: Stmt[] = [new ReturnStmt(wrapped !== null ? c.coerce(typed(started), wrapped, decl) : started)]
    return new AsyncBody(stmts, type)
}

/**
 * A `return` of `v` in an async function whose type its body gives, at
 * `node`: the type of the value is recorded, and the return completed once
 * the type is known. A void call is made before returning null.
 */
export function inferredReturn(c: Checker, v: Operand, returns: InferredReturns, node: Node): ReturnStmt {
    const stmt = new ReturnStmt()
    if (v.k === "error") return stmt
    if (v.k === "untyped-float") returns.floats = true
    else if (v.k === "untyped-int") returns.ints = true
    else if (v.expr.type.kind === "void") returns.empty = true
    else returns.types.push(promiseValue(c, v.expr.type) ?? v.expr.type)
    returns.fixups.push(() => {
        const result = returns.result!
        if (v.k === "typed" && v.expr.type.kind === "void") {
            const none = c.coerce(typed(new NullLit(types.null)), result, node)
            stmt.value = new Seq(none.type, [v.expr, none])
        } else stmt.value = c.coerce(v, result, node)
    })
    return stmt
}

/** A `return` without a value, at `node`, in an async function whose type its body gives. */
export function inferredEmptyReturn(c: Checker, returns: InferredReturns, node: Node): ReturnStmt {
    const stmt = new ReturnStmt()
    returns.empty = true
    returns.fixups.push(() => {
        stmt.value = c.coerce(typed(new NullLit(types.null)), returns.result!, node)
    })
    return stmt
}

/** `await value`: the value of a promise, or the value itself after a tick. */
export function checkAwait(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    const fn = c.fn
    if (fn === null || !(fn.topLevel || fn.inAsync)) {
        return c.fail(node, "'await' is only allowed in async functions and in the top-level code of a module.")
    }
    const operandNode = expression(node)
    return awaitOperand(c, checkExpr(c, operandNode, scope, null), expected, operandNode)
}

/**
 * `await` of an operand checked already, at `node`: the value of a promise,
 * or the value itself after a tick. An untyped constant takes the type
 * `expected`, or its default type.
 */
export function awaitOperand(c: Checker, v: Operand, expected: Type | null, node: Node): Operand {
    if (v.k === "error") return errorOperand
    const expr = v.k === "typed" ? v.expr : c.coerce(v, expected ?? c.defaultType(v), node)
    const value = promiseValue(c, expr.type)
    if (value !== null) {
        const f = runtimeFunc(c, "awaitPromise", [value], node)
        return f !== null ? typed(new Call(value, f, [expr])) : errorOperand
    }
    if (expr.type.kind === "void") return c.fail(node, "An expression of type 'void' cannot be awaited.")
    if (expr.type.kind === "union" && expr.type.members.some((m) => promiseValue(c, m) !== null))
        return c.fail(node, "A union of promises and other values cannot be awaited yet.")
    const f = runtimeFunc(c, "awaitValue", [expr.type], node)
    return f !== null ? typed(new Call(expr.type, f, [expr])) : errorOperand
}

/** `await` of an expression, at `node`; null after an error. */
export function awaitExpr(c: Checker, expr: Expr, node: Node): Expr | null {
    const v = awaitOperand(c, typed(expr), null, node)
    return v.k === "typed" ? v.expr : null
}
