// The state of the checker, diagnostics, types and conversions of operands:
// what every layer uses. The layers of the
// TypeScript checker (abstract classes extending each other) are modules of
// functions taking the `Checker` as their first parameter.

import {
    type Expr,
    type Closure,
    type LocalRef,
    Func,
    Itab,
    IntLit,
    Local,
    Module,
    NullLit,
    Recast,
    StringLit,
    ToIface,
} from "../ir/nodes"
import {
    type InterfaceType,
    type Type,
    ArrayType,
    ChanType,
    Field,
    FuncType,
    LiteralType,
    MapType,
    SetType,
    StructType,
    UnionType,
    arrayOf,
    intRange,
    isNumeric,
    isStringLike,
    isSubclass,
    membersOf,
    sameType,
    typeKey,
    types,
    typeToString,
} from "../ir/types"
import { type Node } from "../syntax/ast"
import { Diagnostic, diagnosticAt } from "../syntax/diagnostic"
import {
    defaultType as defaultTypeNode,
    args,
    elementType,
    hasModifier,
    isIdentifier,
    isStringLiteralNode,
    literal,
    members,
    nameNode,
    parameters,
    questionToken,
    dotDotDotToken,
    stringText,
    typeArguments,
    typeName,
    typeNode,
    typeParameters,
    types as typeNodes,
} from "../syntax/nodes"
import { type Source } from "../syntax/source"
import { type Program } from "../project/load"
import { bigGt, bigLt, bigOf, bigOfU64, bigText, bigToF64, bigToI64 } from "./bigint"
import { conformance, itab, objectInterface, resolveBase } from "./classes"
import {
    type Accessor,
    type ClassInfo,
    type Dispatch,
    type Fact,
    type FuncContext,
    type GenericMethod,
    type InstanceInfo,
    type InterfaceInfo,
    type ModuleInfo,
    type Signature,
    CheckInfo,
} from "./context"
import { instantiate } from "./declarations"
import {
    disposeName,
    floatLit,
    hashable,
    indexSignatureMessage,
    isSymbolDispose,
    memberOf,
    poison,
    typeOf,
} from "./helpers"
import { type Operand, errorOperand, Typed } from "./operand"
import { type Generic, type TypeSymbol, Scope } from "./symbols"

/** Two operands brought to a common type, or nulls when that failed: `[ir.Expr | undefined, ir.Expr | undefined]`. */
export class Unified {
    constructor(
        readonly left: Expr | null,
        readonly right: Expr | null,
    ) {}
}

/** A program being checked; see `run` in checker.ore. */
export class Checker {
    readonly diagnostics: Diagnostic[] = []

    readonly info = new CheckInfo()

    readonly module: Module

    nextLocalId = 0

    readonly localsById = new Map<int, Local>()

    fn: FuncContext | null = null

    /** The scope of the module whose top-level code is being checked: its variables are globals. */
    globals: Scope | null = null

    /** Overload signatures waiting for their implementation, by module prefix and name. */
    readonly overloadDecls = new Map<string, Node[]>()
    /** Anonymous struct types by shape key. */
    readonly shapes = new Map<string, StructType>()

    nextStructId = 0

    readonly classes: ClassInfo[] = []

    readonly interfaces = new Map<InterfaceType, InterfaceInfo>()

    readonly unions = new Map<string, UnionType>()

    readonly literals = new Map<string, LiteralType>()

    /** The built-in `Error` interface, and the class behind `new Error(...)` once used. */
    errorType: InterfaceType | null = null

    basicError: StructType | null = null

    /** Checks of generic instances, run after the other bodies. */
    readonly pending: (() => void)[] = []
    /**
     * Set when a class is constructed before its constructor is declared, in
     * the default value of a parameter without a type: the value gives its type,
     * and is checked once every declaration is known.
     */
    constructedEarly = false

    /** The generic and type arguments of each instance type. */
    readonly instanceOf = new Map<Type, InstanceInfo>()

    instanceCount = 0

    nextLambda = 0

    /** The generic instance being checked, named in its diagnostics. */
    context: string | null = null

    /** Narrowing facts by flow scope, innermost last. */
    facts: Map<string, Type>[] = [new Map<string, Type>()]

    readonly itabs = new Map<string, Itab>()

    /** Declarations of fields and methods of structs and interfaces, for tooling. */
    readonly memberDecls = new Map<StructType | InterfaceType, Map<string, Node>>()

    /** Variables declared without a value that must be assigned before they are read. */
    readonly unassigned = new Set<Local>()

    /** Variables declared without a type or a value, typed by their first assignment. */
    readonly untyped = new Set<Local>()

    /** Where variables and closures were written, for messages about reads of unassigned variables. */
    readonly refNodes = new Map<LocalRef, Node>()

    readonly closureNodes = new Map<Closure, Node>()

    readonly declNodes = new Map<Local, Node>()

    /** Variables whose initializer has an error, so that their type is unknown. */
    readonly poisoned = new Set<Local>()
    /** The class whose static method is being checked, for messages about `this`. */
    staticClass: string | null = null

    /** Variables already reported as read before assigned. */
    readonly readEarly = new Set<Local>()

    /** Records the declarations that import specifiers refer to, once all are declared. */
    readonly specifiers: (() => void)[] = []

    /** Getters and setters of classes by property name. */
    readonly accessors = new Map<StructType, Map<string, Accessor>>()

    /** Every class and generic class instance, in order of declaration, by the id of its type. */
    readonly classInfos = new Map<int, ClassInfo>()

    /** Abstract methods, by the class that declares them. */
    readonly abstractMethods = new Map<Func, StructType>()

    /** Calls and bound values of class methods, marked `virtual` once every class is known if a subclass overrides the method. */
    readonly dispatches: Dispatch[] = []

    /** Generic methods of classes by name, instantiated per call like generic functions. */
    readonly genericMethods = new Map<StructType, Map<string, GenericMethod>>()

    /** Optional and rest parameters of functions, by their parameter list. */
    readonly signatures = new Map<Local[], Signature>()

    /** C names of exported variables. */
    readonly exportedVariables = new Set<string>()

    /** Functions by their `//ore:export` name. */
    readonly exportNames = new Map<string, Func>()

    /** The source of every node of every module, as nodes have no parent. */
    readonly sources = new Map<Node, Source>()

    /** The scope of built-in declarations, for resolving their signatures. */
    builtins: Scope | null = null

    readonly modules = new Map<Source, ModuleInfo>()

    /** The C name prefix of the module whose declarations are being declared. */
    prefix = ""

    constructor(readonly program: Program) {
        this.module = new Module(program.entry.path, [], [], [], [], [])
        for (const source of program.modules) this.addSource(source)
    }

    /** Records the source of every node of a module. */
    addSource(source: Source) {
        this.addNodes(source.ast, source)
    }

    private addNodes(node: Node, source: Source) {
        this.sources.set(node, source)
        for (const child of node.children) this.addNodes(child, source)
    }

    resolveType(node: Node, scope: Scope): Type | null {
        switch (node.kind) {
            case "NumberKeyword":
                return types.f64
            case "BooleanKeyword":
                return types.bool
            case "StringKeyword":
                return types.string
            case "VoidKeyword":
                return types.void
            case "NeverKeyword":
                return types.never
            case "AnyKeyword":
                this.error(node, "'any' is not supported in Ore.")
                return null
            case "UnknownKeyword":
                this.error(node, "'unknown' is not supported yet.")
                return null
            case "UndefinedKeyword":
                this.error(node, "'undefined' is not supported in Ore. Use 'null'.")
                return null
        }
        if (node.kind === "LiteralType") {
            const lit = literal(node)
            if (lit.kind === "NullKeyword") return types.null
            if (lit.kind === "StringLiteral") return this.literal(stringText(lit))
            this.error(node, "Only string literal types are supported yet.")
            return null
        }
        if (node.kind === "UnionType") {
            const found: Type[] = []
            for (const m of typeNodes(node)) {
                const type = this.resolveType(m, scope)
                if (type === null) return null
                if (type.kind === "void" || type.kind === "never") {
                    this.error(m, `A union cannot contain '${type.kind}'.`)
                    return null
                }
                found.push(type)
            }
            return this.unionOf(found)
        }
        if (node.kind === "ArrayType") {
            const elem = this.resolveValueType(elementType(node), scope)
            return elem === null ? null : arrayOf(elem)
        }
        if (node.kind === "TupleType") {
            const elems: Type[] = []
            for (const e of node.list("elements")) {
                const type = this.resolveValueType(e, scope)
                if (type === null) return null
                elems.push(type)
            }
            return this.tupleOf(elems)
        }
        if (node.kind === "TypeReference") {
            const name = typeName(node)
            const typeArgs = typeArguments(node)
            if (isIdentifier(name) && name.text === "Map" && scope.lookupType("Map") === null) {
                if (typeArgs.length !== 2) {
                    this.error(node, "'Map' expects exactly 2 type arguments.")
                    return null
                }
                const key = this.resolveValueType(typeArgs[0], scope)
                const value = this.resolveValueType(typeArgs[1], scope)
                return key !== null && value !== null ? this.mapOf(key, value, typeArgs[0]) : null
            }
            if (isIdentifier(name) && name.text === "Set" && scope.lookupType("Set") === null) {
                if (typeArgs.length !== 1) {
                    this.error(node, "'Set' expects exactly 1 type argument.")
                    return null
                }
                const elem = this.resolveValueType(typeArgs[0], scope)
                return elem !== null ? this.setOf(elem, typeArgs[0]) : null
            }
            if (isIdentifier(name) && name.text === "Chan" && scope.lookupType("Chan") === null) {
                if (typeArgs.length !== 1) {
                    this.error(node, "'Chan' expects exactly 1 type argument.")
                    return null
                }
                const elem = this.resolveValueType(typeArgs[0], scope)
                return elem === null ? null : new ChanType(elem)
            }
            if (isIdentifier(name) && name.text === "Array" && scope.lookupType("Array") === null) {
                if (typeArgs.length !== 1) {
                    this.error(node, "'Array' expects exactly 1 type argument.")
                    return null
                }
                const elem = this.resolveValueType(typeArgs[0], scope)
                return elem === null ? null : arrayOf(elem)
            }
            const symbol = this.typeSymbol(name, scope)
            if (symbol === null) return null
            const generic = symbol.generic
            if (generic !== null) {
                if (typeArgs.length === 0 && defaultTypeNode(generic.params[0]) === null) {
                    this.error(node, `Generic type '${generic.name}' requires type arguments.`)
                    return null
                }
                const resolved: Type[] = []
                for (const a of typeArgs) {
                    const type = this.resolveValueType(a, scope)
                    if (type === null) return null
                    resolved.push(type)
                }
                const instance = instantiate(this, generic, resolved, node)
                if (instance === null || instance instanceof Func) return null
                return instance
            }
            if (typeArgs.length > 0) {
                this.error(node, `Type '${this.text(name)}' is not generic.`)
                return null
            }
            return symbol.type
        }
        if (node.kind === "ParenthesizedType") return this.resolveType(typeNode(node)!, scope)
        if (node.kind === "TypeLiteral") return this.resolveTypeLiteral(node, scope)
        if (node.kind === "FunctionType") {
            const typeParams = typeParameters(node)
            if (typeParams.length > 0) {
                this.error(typeParams[0], "Generic function types are not supported.")
                return null
            }
            // Optional parameters (`b?: T`, which is `T | null`) after the required ones, and a last rest parameter.
            const params: Type[] = []
            const list = parameters(node)
            let required = -1
            let rest = false
            for (let i = 0; i < list.length; i++) {
                const p = list[i]
                const annotation = typeNode(p)
                if (annotation === null) {
                    this.error(p, "Parameters of function types need a type.")
                    return null
                }
                const t = this.resolveValueType(annotation, scope)
                if (t === null) return null
                if (dotDotDotToken(p) !== null) {
                    if (i !== list.length - 1 || t.kind !== "array") {
                        this.error(p, "A rest parameter must be the last parameter, of an array type.")
                        return null
                    }
                    rest = true
                    params.push(t)
                } else if (questionToken(p) !== null) {
                    if (required === -1) required = i
                    params.push(this.unionOf([t, types.null]))
                } else {
                    if (required !== -1) {
                        this.error(p, "A required parameter cannot follow an optional parameter.")
                        return null
                    }
                    params.push(t)
                }
            }
            const result = this.resolveType(typeNode(node)!, scope)
            if (result === null) return null
            const type = new FuncType(params, result)
            if (required !== -1) type.required = required
            type.rest = rest
            return type
        }
        this.error(node, "This kind of type is not supported yet.")
        return null
    }

    /** The type named by `T` or `m.T` (an export of a module imported as `* as m`); reports missing names. */
    typeSymbol(name: Node, scope: Scope): TypeSymbol | null {
        if (isIdentifier(name)) {
            const symbol = scope.lookupType(name.text)
            if (symbol === null) {
                this.error(name, `Cannot find type '${name.text}'.`)
                return null
            }
            this.info.definitions.set(name, symbol.decl)
            return symbol
        }
        const left =
            name.kind === "QualifiedName"
                ? name.child("left")
                : name.kind === "PropertyAccessExpression"
                  ? name.child("expression")
                  : null
        const right =
            name.kind === "QualifiedName"
                ? name.child("right")
                : name.kind === "PropertyAccessExpression"
                  ? name.child("name")
                  : null
        const module = left !== null && isIdentifier(left) ? scope.lookupValue(left.text) : null
        // A type of a built-in namespace implemented in Ore, such as `fs.FileInfo`.
        const exports =
            module === null
                ? null
                : module.k === "module"
                  ? module.exports
                  : module.k === "namespace"
                    ? module.module
                    : null
        if (module === null || exports === null || right === null || !isIdentifier(right)) {
            this.error(name, "Only types of modules imported with '* as' can be qualified.")
            return null
        }
        this.info.definitions.set(left!, module.decl)
        const exported = exports(right.text)
        const symbol = exported === null ? null : exported.type
        if (symbol === null) {
            const moduleName = module.k === "namespace" ? module.name : module.k === "module" ? module.name : ""
            this.error(
                right,
                module.k === "namespace"
                    ? `'${moduleName}' has no type '${right.text}'.`
                    : `Module '${moduleName}' has no exported type '${right.text}'.`,
            )
            return null
        }
        this.info.definitions.set(right, symbol.decl)
        return symbol
    }

    resolveTypeLiteral(node: Node, scope: Scope): Type | null {
        // An object type with methods is a structural interface, as `interface` declares one.
        if (members(node).some((m) => m.kind === "MethodSignature")) return objectInterface(this, node, scope)
        const shape = this.shape(this.literalFields(node, scope))
        // The first declaration of a shape is where its fields are defined.
        if (!this.memberDecls.has(shape)) this.memberDecls.set(shape, this.memberNodes(node))
        return shape
    }

    /** The members of an object type by name, for go to definition. */
    memberNodes(node: Node): Map<string, Node> {
        const decls = new Map<string, Node>()
        for (const m of members(node)) {
            const n = m.child("name")
            if (n !== null && isIdentifier(n)) decls.set(n.text, m)
        }
        return decls
    }

    /** The fields of an object type `{ ... }`, in the order written. */
    literalFields(node: Node, scope: Scope): Field[] {
        const fields: Field[] = []
        for (const member of members(node)) {
            if (member.kind !== "PropertySignature") {
                this.error(
                    member,
                    member.kind === "IndexSignature"
                        ? indexSignatureMessage
                        : "Only properties are supported in object types.",
                )
                continue
            }
            const name = this.memberName(nameNode(member))
            if (name === null) continue
            const optional = questionToken(member) !== null
            const annotation = typeNode(member)
            if (annotation === null) {
                this.error(nameNode(member), `Property '${name}' must have a type annotation.`)
                continue
            }
            let duplicate = false
            for (const f of fields) if (f.name === name) duplicate = true
            if (duplicate) this.error(nameNode(member), `Duplicate property '${name}'.`)
            const resolved = this.resolveValueType(annotation, scope)
            const isReadonly = hasModifier(member, "ReadonlyKeyword")
            if (resolved !== null) {
                const type = optional ? this.unionOf([resolved, types.null]) : resolved
                const field = new Field(name, type, isReadonly)
                field.optional = optional
                fields.push(field)
                this.info.types.set(nameNode(member), type)
            }
        }
        return fields
    }

    mapOf(key: Type, value: Type, node: Node): MapType | null {
        if (!hashable(key)) {
            this.error(node, `Type '${typeToString(key)}' cannot be a Map key.`)
            return null
        }
        return new MapType(key, value)
    }

    setOf(elem: Type, node: Node): SetType | null {
        if (!hashable(elem)) {
            this.error(node, `Type '${typeToString(elem)}' cannot be an element of a Set.`)
            return null
        }
        return new SetType(elem)
    }

    literal(value: string): LiteralType {
        let type = this.literals.get(value)
        if (type === null) {
            type = new LiteralType(value)
            this.literals.set(value, type)
        }
        return type
    }

    /** The normalized union of types: flattened, deduplicated and in canonical order. */
    unionOf(found: Type[]): Type {
        let members_: Type[] = []
        for (const t of found) {
            for (const m of membersOf(t)) {
                if (m.kind === "never") continue
                let present = false
                for (const x of members_) if (sameType(x, m)) present = true
                if (!present) members_.push(m)
            }
        }
        // `string` includes every string literal type.
        let hasString = false
        for (const m of members_) if (m.kind === "string") hasString = true
        if (hasString) members_ = members_.filter((m) => m.kind !== "literal")
        // A class includes its subclasses: `A | B` is `A` when `B extends A`.
        if (members_.filter((m) => m.kind === "struct").length > 1) {
            for (const m of members_) {
                const info = m.kind === "struct" ? this.classInfos.get(m.id) : null
                if (info !== null) resolveBase(this, info)
            }
            const all = members_
            const isSub = (m: Type): bool => {
                if (m.kind !== "struct") return false
                const s = m
                return all.some((n) => n !== s && n.kind === "struct" && isSubclass(s, n))
            }
            if (all.some(isSub)) members_ = all.filter((m) => !isSub(m))
        }
        if (members_.length === 0) return types.never
        if (members_.length === 1) return members_[0]
        members_.sort((a, b) => (typeKey(a) < typeKey(b) ? -1 : typeKey(a) > typeKey(b) ? 1 : 0))
        const key = members_.map(typeKey).join("|")
        let union = this.unions.get(key)
        if (union === null) {
            union = new UnionType(this.unions.size, members_)
            this.unions.set(key, union)
            this.module.unions.push(union)
        }
        return union
    }

    /** A type without some of its members, such as `null`. */
    without(type: Type, drop: (t: Type) => bool): Type {
        return this.unionOf(membersOf(type).filter((m) => !drop(m)))
    }

    /** A type without `null`. */
    withoutNull(type: Type): Type {
        return this.without(type, (m) => m.kind === "null")
    }

    /** The interned anonymous struct type with these fields. */
    shape(fields: Field[]): StructType {
        const sorted = fields.slice().sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
        const key = sorted
            .map((f) => `${f.readonly ? "readonly " : ""}${f.name}${f.optional ? "?" : ""}:${typeKey(f.type)}`)
            .join(";")
        let struct = this.shapes.get(key)
        if (struct === null) {
            struct = new StructType(this.nextStructId++, null, false, sorted, [])
            this.shapes.set(key, struct)
            this.module.structs.push(struct)
        }
        return struct
    }

    /** The interned tuple type of these element types. */
    tupleOf(elems: Type[]): StructType {
        const key = `[${elems.map(typeKey).join(",")}]`
        let struct = this.shapes.get(key)
        if (struct === null) {
            const fields: Field[] = []
            for (let i = 0; i < elems.length; i++) fields.push(new Field(`${i}`, elems[i], false))
            struct = new StructType(this.nextStructId++, null, false, fields, [])
            struct.tuple = true
            this.shapes.set(key, struct)
            this.module.structs.push(struct)
        }
        return struct
    }

    /** The name of a property; computed and private names are rejected. */
    memberName(name: Node): string | null {
        if (isIdentifier(name)) return name.text
        if (name.kind === "StringLiteral") return stringText(name)
        if (name.kind === "ComputedPropertyName" && isSymbolDispose(name.child("expression")!)) return disposeName
        if (name.kind === "PrivateIdentifier")
            this.error(name, "'#' private names are not supported. Use the 'private' modifier.")
        else this.error(name, "Computed property names are not supported.")
        return null
    }

    /** Resolves the type of a variable or parameter, which cannot be `void` or `never`. */
    resolveValueType(node: Node, scope: Scope): Type | null {
        const type = this.resolveType(node, scope)
        if (type !== null && (type.kind === "void" || type.kind === "never")) {
            this.error(node, `A value cannot have type '${type.kind}'.`)
            return null
        }
        return type
    }

    /** Converts an operand to `target`, reporting an error if it is not assignable. */
    coerce(value: Operand, target: Type, node: Node): Expr {
        switch (value.k) {
            case "error":
                return poison(target)
            case "typed": {
                const expr = value.expr
                const from = typeOf(expr)
                if (sameType(from, target) || from.kind === "never") return expr
                // An instance of a subclass is an instance of its base classes, as it is.
                if (from.kind === "struct" && target.kind === "struct" && isSubclass(from, target)) return expr
                const targetMembers = membersOf(target)
                // A string literal expression has the literal type its context asks for.
                if (expr.k === "string") {
                    for (const m of targetMembers) {
                        if (m.kind === "literal" && m.value === expr.value) {
                            const retyped: Expr = new StringLit(m, expr.value)
                            return target.kind === "union" ? new Recast(target, retyped) : retyped
                        }
                    }
                }
                // String literal types widen to `string`.
                if (target.kind === "string" && membersOf(from).every(isStringLike)) return new Recast(target, expr)
                if (from.kind === "null") {
                    if (target.kind === "union") {
                        for (const m of targetMembers) if (m.kind === "null") return new NullLit(target)
                    }
                    this.error(node, `Type 'null' is not assignable to type '${typeToString(target)}'.`)
                    return poison(target)
                }
                // A member, or a union of members, converts to a union containing them.
                if (
                    target.kind === "union" &&
                    membersOf(from).every((f) => targetMembers.some((m) => memberOf(f, m)))
                ) {
                    return new Recast(target, expr)
                }
                // A union of subclasses converts to their base class.
                const base = target.kind === "struct" ? target : null
                if (
                    base !== null &&
                    from.kind === "union" &&
                    from.members.every((m) => m.kind === "struct" && isSubclass(m, base))
                ) {
                    return new Recast(target, expr)
                }
                if (target.kind === "union") {
                    // A struct converts to an interface member it implements, if there is exactly one.
                    const ifaces: InterfaceType[] = []
                    const source = structOrInterface(from)
                    if (source !== null) {
                        for (const m of targetMembers) {
                            if (m.kind === "interface" && conformance(this, source, m).reason === null) ifaces.push(m)
                        }
                    }
                    if (ifaces.length === 1) return new Recast(target, this.coerce(value, ifaces[0], node))
                }
                if (
                    from.kind === "union" &&
                    from.members.some((m) => m.kind === "null") &&
                    sameType(this.withoutNull(from), target)
                ) {
                    this.error(
                        node,
                        `Type '${typeToString(from)}' is not assignable to type '${typeToString(target)}': the value may be null. Check it with '!== null' first, or use '??' or '!'.`,
                    )
                    return poison(target)
                }
                if (target.kind === "interface") {
                    const source = structOrInterface(from)
                    if (source !== null) {
                        const result = conformance(this, source, target)
                        if (result.reason === null) {
                            if (source.kind === "interface") return new ToIface(target, expr, null, result.indices)
                            return new ToIface(target, expr, itab(this, source, target))
                        }
                        this.error(
                            node,
                            `Type '${typeToString(from)}' is not assignable to type '${target.name}': ${result.reason}.`,
                        )
                        return poison(target)
                    }
                }
                let message = `Type '${typeToString(from)}' is not assignable to type '${typeToString(target)}'.`
                if (isNumeric(from) && isNumeric(target))
                    message += ` Use an explicit conversion: '${typeToString(target)}(...)'.`
                this.error(node, message)
                return poison(target)
            }
            case "untyped-int": {
                if (target.kind === "union") return this.coerceToUnion(value, target, node)
                if (target.kind === "int") {
                    const range = intRange(target)
                    if (bigLt(value.value, bigOf(range.min)) || bigGt(value.value, bigOfU64(range.max))) {
                        this.error(
                            node,
                            `Constant ${bigText(value.value)} overflows '${target.name}' (range ${range.min}..${range.max}).`,
                        )
                        return poison(target)
                    }
                    return new IntLit(target, bigToI64(value.value))
                }
                if (target.kind === "float") return floatLit(target, bigToF64(value.value))
                this.error(node, `An integer constant is not assignable to type '${typeToString(target)}'.`)
                return poison(target)
            }
            case "untyped-float": {
                if (target.kind === "union") return this.coerceToUnion(value, target, node)
                if (target.kind === "float") return floatLit(target, value.value)
                if (target.kind === "int")
                    this.error(
                        node,
                        `A floating-point constant is not assignable to integer type '${target.name}'. Use '${target.name}(...)' to truncate.`,
                    )
                else this.error(node, `A floating-point constant is not assignable to type '${typeToString(target)}'.`)
                return poison(target)
            }
        }
    }

    /** Converts an untyped constant to the numeric member of a union: its default type if present, else the only one. */
    coerceToUnion(value: Operand, target: UnionType, node: Node): Expr {
        // A float constant fits only float members; an integer constant fits any numeric member.
        const numeric = target.members.filter((m) => (value.k === "untyped-float" ? m.kind === "float" : isNumeric(m)))
        const fallback = this.defaultType(value)
        let preferred: Type | null = null
        for (const m of numeric) if (preferred === null && sameType(m, fallback)) preferred = m
        if (preferred === null && numeric.length === 1) preferred = numeric[0]
        if (preferred === null) {
            this.error(
                node,
                numeric.length === 0
                    ? `A numeric constant is not assignable to type '${typeToString(target)}'.`
                    : `Ambiguous constant for type '${typeToString(target)}'. Convert it explicitly, e.g. '${typeToString(numeric[0])}(...)'.`,
            )
            return poison(target)
        }
        return new Recast(target, this.coerce(value, preferred, node))
    }

    /** Gives an untyped constant its default type: `int` for integers, `f64` for floats. */
    toDefault(value: Operand, node: Node): Expr {
        if (value.k === "typed") return value.expr
        if (value.k === "error") return poison(types.i64)
        return this.coerce(value, this.defaultType(value), node)
    }

    defaultType(value: Operand): Type {
        return value.k === "untyped-float" ? types.f64 : types.i64
    }

    /**
     * Brings two operands to a common type: an untyped side takes the type of
     * the typed side. Returns null operands if that fails, so that the
     * enclosing expression reports nothing more.
     */
    unify(a: Operand, b: Operand, aNode: Node, bNode: Node): Unified {
        if (a.k === "error" || b.k === "error") return new Unified(null, null)
        if (a.k === "typed" && b.k === "typed") return new Unified(a.expr, b.expr)
        const before = this.diagnostics.length
        let result: Unified
        if (a.k === "typed") result = new Unified(a.expr, this.coerce(b, typeOf(a.expr), bNode))
        else if (b.k === "typed") result = new Unified(this.coerce(a, typeOf(b.expr), aNode), b.expr)
        else {
            const type = a.k === "untyped-float" || b.k === "untyped-float" ? types.f64 : types.i64
            result = new Unified(this.coerce(a, type, aNode), this.coerce(b, type, bNode))
        }
        return this.diagnostics.length === before ? result : new Unified(null, null)
    }

    /** The module a node belongs to. */
    sourceOf(node: Node): Source {
        const source = this.sources.get(node)
        if (source === null) process.panic(`no source for ${node.kind} at ${node.start}`)
        return source
    }

    /** The text of a node, as written: `node.getText()`. */
    text(node: Node): string {
        return this.sourceOf(node).text.slice(node.start, node.end)
    }

    line(node: Node): int {
        const source = this.sourceOf(node)
        return source.position(node.start).line + 1
    }

    newLocal(name: string, type: Type, mutable: bool): Local {
        const local = new Local(this.nextLocalId++, name, type, mutable)
        this.localsById.set(local.id, local)
        return local
    }

    error(node: Node, message: string) {
        const context = this.context
        const d = diagnosticAt(this.sourceOf(node), node, context !== null ? `${message} (in '${context}')` : message)
        // Generic instances can repeat the same error.
        let seen = false
        for (const e of this.diagnostics) if (e.start === d.start && e.message === d.message) seen = true
        if (!seen) this.diagnostics.push(d)
    }

    fail(node: Node, message: string): Operand {
        this.error(node, message)
        return errorOperand
    }

    /** Drops the diagnostics reported since there were `count`. */
    truncateDiagnostics(count: int) {
        while (this.diagnostics.length > count) this.diagnostics.pop()
    }

    /** The statements of a module's source file. */
    statementsOf(source: Source): Node[] {
        return source.ast.list("statements")
    }

    /** The full start of a top-level statement: the end of the statement before it, or 0 (`stmt.pos`). */
    fullStart(stmt: Node): int {
        const stmts = this.statementsOf(this.sourceOf(stmt))
        for (let i = 0; i < stmts.length; i++) if (stmts[i] === stmt) return i === 0 ? 0 : stmts[i - 1].end
        return stmt.start
    }

    pushFacts(facts: Fact[]) {
        const frame = new Map<string, Type>()
        for (const f of facts) frame.set(f.key, f.type)
        this.facts.push(frame)
    }

    /** Ends a block, or a statement checked as one: the facts at its end hold after it (`inBlock`). */
    popBlockFacts() {
        const frame = this.facts.pop()
        const parent = this.facts[this.facts.length - 1]
        for (const [key, type] of frame) parent.set(key, type)
    }

    popFacts() {
        this.facts.pop()
    }
}

/** A struct or interface type, or null: `from.kind === "struct" || from.kind === "interface"`. */
export function structOrInterface(type: Type): StructType | InterfaceType | null {
    if (type.kind === "struct") return type
    if (type.kind === "interface") return type
    return null
}
