/** The `//ore:name argument` comments before a top-level statement. */
export function directives(c: Checker, stmt: Node): Directive[] {
    const text = c.sourceOf(stmt).text
    const found: Directive[] = []
    for (const range of leadingCommentRanges(text, c.fullStart(stmt))) {
        const comment = text.slice(range.pos, range.end)
        // A comment may follow the directive: `//ore:noinline // keeps the frame`.
        const d = parseDirective(comment, range.pos, range.end)
        if (d !== null) found.push(d)
    }
    return found
}

function isSpace(c: u8): bool {
    return c === 0x20 || c === 0x09 || c === 0x0b || c === 0x0c || c === 0x0d || c === 0x0a
}

/** `/^\/\/ore:(\S*)\s*(.*?)\s*(\/\/.*)?$/` applied to a comment. */
function parseDirective(comment: string, pos: int, end: int): Directive | null {
    if (!comment.startsWith("//ore:")) return null
    let i = 6
    while (i < comment.length && !isSpace(comment[i])) i++
    const name = comment.slice(6, i)
    while (i < comment.length && isSpace(comment[i])) i++
    const start = i
    // The argument ends before trailing whitespace and a `//` comment.
    let p = start
    for (;;) {
        let q = p
        while (q < comment.length && isSpace(comment[q])) q++
        if (q >= comment.length || comment.slice(q, q + 2) === "//") break
        p++
    }
    return new Directive(name, comment.slice(start, p), pos, end)
}

/**
 * Whether a module may use `internal` and `//ore:runtime`: a module of the
 * standard library, or one that starts with `//ore:internal`.
 */
export function isInternal(c: Checker, source: Source): bool {
    if (source.path.startsWith("ore:")) return true
    const stmts = c.statementsOf(source)
    if (stmts.length === 0) return false
    for (const d of directives(c, stmts[0])) if (d.name === "internal") return true
    return false
}

export function directiveError(c: Checker, stmt: Node, d: Directive, message: string) {
    c.diagnostics.push(new Diagnostic(c.sourceOf(stmt), d.pos, d.end - d.pos, "error", message))
}

function knownDirectives(): string {
    return directiveNames.map((k) => `//ore:${k}`).join(", ")
}

/** Reports unknown directives and directives on statements they do not apply to. */
export function checkDirectives(c: Checker, stmt: Node) {
    for (const d of directives(c, stmt)) {
        const kind = directiveKind(d.name)
        if (kind === null) {
            directiveError(c, stmt, d, `Unknown directive '//ore:${d.name}'. Known: ${knownDirectives()}.`)
            continue
        }
        const named = d.name === "export" || d.name === "runtime"
        if (named ? d.arg === "" : d.arg !== "") {
            directiveError(
                c,
                stmt,
                d,
                named
                    ? `'//ore:${d.name}' needs a C name, e.g. '//ore:${d.name} my_function'.`
                    : `'//ore:${d.name}' takes no argument.`,
            )
            continue
        }
        if (d.name === "runtime" && !isInternal(c, c.sourceOf(stmt))) {
            directiveError(
                c,
                stmt,
                d,
                "'//ore:runtime' is only for the standard library. Add '//ore:internal' at the top of the file to use it here.",
            )
            continue
        }
        if (kind === "module") {
            if (c.statementsOf(c.sourceOf(stmt))[0] !== stmt)
                directiveError(c, stmt, d, `'//ore:${d.name}' goes at the top of the file, before the first statement.`)
            continue
        }
        // `//ore:export` also names a top-level variable for C.
        if (d.name === "export" && stmt.kind === "VariableStatement") {
            const list = declarationList(stmt)
            const decls = declarations(list)
            const ok =
                declarationKind(list, c.sourceOf(stmt).text) === "let" &&
                decls.length === 1 &&
                isIdentifier(nameNode(decls[0]))
            if (!ok)
                directiveError(c, stmt, d, "'//ore:export' applies to a function, or to a top-level 'let' of one name.")
            continue
        }
        if (kind === "function") {
            const ok = stmt.kind === "FunctionDeclaration" && body(stmt) !== null && typeParameters(stmt).length === 0
            if (!ok)
                directiveError(
                    c,
                    stmt,
                    d,
                    `'//ore:${d.name}' applies to a function declaration with a body, not generic.`,
                )
        } else {
            let ok =
                stmt.kind === "VariableStatement" &&
                declarationKind(declarationList(stmt), c.sourceOf(stmt).text) === "let"
            if (ok) for (const v of declarations(declarationList(stmt))) if (!isIdentifier(nameNode(v))) ok = false
            if (!ok) directiveError(c, stmt, d, "'//ore:threadlocal' applies to a top-level 'let' of plain names.")
        }
    }
}

/** Whether a statement of a naked function holds nothing but `unsafe.asm(template, constraints)`, chosen by `if`. */
function asmOnly(c: Checker, s: Node): bool {
    if (s.kind === "Block") {
        for (const inner of statements(s)) if (!asmOnly(c, inner)) return false
        return true
    }
    if (s.kind === "IfStatement") {
        const otherwise = elseStatement(s)
        return asmOnly(c, thenStatement(s)) && (otherwise === null || asmOnly(c, otherwise))
    }
    if (s.kind !== "ExpressionStatement") return false
    const call = expression(s)
    return call.kind === "CallExpression" && c.text(expression(call)) === "unsafe.asm" && argsOf(call).length === 2
}

/** Sets the attributes of a function from its directives. */
export function applyFuncDirectives(c: Checker, decl: Node, func: Func) {
    const found = directives(c, decl).filter((d) => directiveKind(d.name) === "function")
    if (found.length === 0) return
    const attributes = new FuncAttributes()
    for (const d of found) {
        if (d.name === "noinline") attributes.noinline = true
        else if (d.name === "inline") attributes.inline = true
        else if (d.name === "cold") attributes.cold = true
        else if (d.name === "naked") {
            // The body runs without a frame, so it may hold nothing but assembly, chosen by `if` on the target.
            let ok = true
            for (const s of statements(body(decl)!)) if (!asmOnly(c, s)) ok = false
            if (!ok)
                directiveError(
                    c,
                    decl,
                    d,
                    "A '//ore:naked' function holds only 'unsafe.asm(template, constraints)' statements.",
                )
            else {
                attributes.naked = true
                attributes.noinline = true
            }
        } else if (d.name === "runtime" && d.arg !== "" && isInternal(c, c.sourceOf(decl))) attributes.runtime = d.arg
        else if (d.name === "export" && d.arg !== "") {
            if (!isCName(d.arg)) {
                directiveError(c, decl, d, `'${d.arg}' is not a C name.`)
                continue
            }
            // C passes numbers, booleans and pointers; strings and objects have no C form.
            let bad: Type | null = null
            for (const t of func.type.params) if (bad === null && !cType(t)) bad = t
            if (bad === null && func.type.result.kind !== "void" && !cType(func.type.result)) bad = func.type.result
            if (bad !== null) {
                directiveError(
                    c,
                    decl,
                    d,
                    `An exported function takes and returns numbers, 'bool' and 'ptr' only, not '${typeToString(bad)}'.`,
                )
                continue
            }
            if (c.signatures.has(func.params)) {
                directiveError(c, decl, d, "An exported function cannot have optional or rest parameters.")
                continue
            }
            const other = c.exportNames.get(d.arg)
            if (other !== null) {
                directiveError(c, decl, d, `'${d.arg}' is already exported by '${other.sourceName}'.`)
                continue
            }
            c.exportNames.set(d.arg, func)
            attributes.exportName = d.arg
            func.name = d.arg
        }
    }
    if (attributes.noinline && attributes.inline)
        c.error(nameNode(decl), "A function cannot be both '//ore:noinline' and '//ore:inline'.")
    func.attributes = attributes
}

/** Whether C can pass a value of a type: numbers, booleans and pointers. */
function cType(t: Type): bool {
    return isNumeric(t) || t.kind === "bool" || t.kind === "ptr"
}

/** Gives a top-level variable a C name, if its type allows it. */
export function exportVariable(c: Checker, decl: Node, local: Local, name: string) {
    const type = local.type
    if (!isNumeric(type) && type.kind !== "bool" && type.kind !== "ptr") {
        c.error(nameNode(decl), `An exported variable holds a number, 'bool' or 'ptr', not '${typeToString(type)}'.`)
        return
    }
    if (!isCName(name)) {
        c.error(nameNode(decl), `'${name}' is not a C name.`)
        return
    }
    if (c.exportedVariables.has(name)) {
        c.error(nameNode(decl), `'${name}' is already exported.`)
        return
    }
    c.exportedVariables.add(name)
    local.exportName = name
}

/** Makes a top-level variable thread-local, if its type and declaration allow it. */
export function threadLocal(c: Checker, decl: Node, local: Local) {
    const type = local.type
    // The collector does not scan thread-local storage, so it may not hold references.
    if (!isNumeric(type) && type.kind !== "bool" && type.kind !== "ptr") {
        c.error(nameNode(decl), `A thread-local variable holds a number, 'bool' or 'ptr', not '${typeToString(type)}'.`)
        return
    }
    if (initializer(decl) !== null || typeNode(decl) === null) {
        c.error(
            nameNode(decl),
            "A thread-local variable starts at zero in each thread: write 'let name: T' with a type and no value.",
        )
        return
    }
    local.threadLocal = true
}

/** Reports variables that may be read before they are assigned; see `checkAssigned`. */
export function checkUnassigned(c: Checker) {
    for (const local of c.untyped) {
        if (!c.readEarly.has(local))
            c.error(c.declNodes.get(local)!, `Variable '${local.name}' needs a type annotation or an initializer.`)
    }
    for (const local of c.unassigned) {
        // Functions may run at any time, so a global they use needs its value at once.
        if (local.global)
            c.error(
                c.declNodes.get(local)!,
                `Variable '${local.name}' is used by functions, so it must have a value where it is declared.`,
            )
    }
    if (c.unassigned.size === 0) return
    for (const func of c.module.functions) {
        if (func.extern) continue
        checkAssigned(func.body, c.unassigned, (local, at) => {
            if (c.readEarly.has(local) || c.untyped.has(local)) return
            const written = at.k === "local" ? c.refNodes.get(at) : at.k === "closure" ? c.closureNodes.get(at) : null
            c.readBeforeAssigned(written ?? c.declNodes.get(local)!, local)
        })
    }
}

/**
 * Top-level variables used only by the top-level code of their module stay
 * locals of it, which are faster than globals and may live on the stack.
 */
export function localizeGlobals(c: Checker) {
    const owners = new Map<Local, Func>()
    for (const init of c.module.inits) {
        visitLocals(init.body, (local) => {
            if (local.global) owners.set(local, init)
        })
    }
    const shared = new Set<Local>()
    for (const func of c.module.functions) {
        visitLocals(func.body, (local) => {
            if (local.global && owners.get(local) !== func) shared.add(local)
        })
    }
    for (const [local, _] of owners)
        if (!shared.has(local) && !local.threadLocal && local.exportName === null) local.global = false
}

/** Whether an expression is made of literals and constants. */
function isConstantExpr(c: Checker, e: Node, scope: Scope): bool {
    if (e.kind === "NumericLiteral" || isStringLiteralNode(e) || e.kind === "TrueKeyword" || e.kind === "FalseKeyword")
        return true
    if (e.kind === "ParenthesizedExpression") return isConstantExpr(c, expression(e), scope)
    if (e.kind === "PrefixUnaryExpression") return isConstantExpr(c, e.child("operand")!, scope)
    if (e.kind === "BinaryExpression") {
        const op = operatorToken(e).kind
        return (
            !isAssignmentOperator(op) &&
            isConstantExpr(c, e.child("left")!, scope) &&
            isConstantExpr(c, e.child("right")!, scope)
        )
    }
    if (e.kind === "ConditionalExpression")
        return (
            isConstantExpr(c, e.child("condition")!, scope) &&
            isConstantExpr(c, whenTrue(e), scope) &&
            isConstantExpr(c, whenFalse(e), scope)
        )
    if (isIdentifier(e)) {
        const symbol = scope.lookupValue(e.text)
        return symbol !== null && symbol.k === "const"
    }
    return false
}

/** Whether a top-level `const` statement declares only constants, known before any code runs. */
export function isConstantStatement(c: Checker, stmt: Node, scope: Scope): bool {
    const list = declarationList(stmt)
    if (declarationKind(list, c.sourceOf(stmt).text) !== "const") return false
    for (const d of declarations(list)) {
        const init = initializer(d)
        if (!isIdentifier(nameNode(d)) || init === null || !isConstantExpr(c, init, scope)) return false
    }
    return true
}

/** An export of a statement. */
function addExport(c: Checker, module: ModuleInfo, name: string, local: string, node: Node, from: ModuleInfo | null) {
    if (module.exports.has(name)) c.error(node, `Duplicate export '${name}'.`)
    else module.exports.set(name, new ExportEntry(local, from))
}

/** Records the names a top-level statement exports. */
/** A function declaration without a body, not `declare`d: an overload signature, exported with its implementation. */
function isOverloadSignature(stmt: Node): bool {
    return stmt.kind === "FunctionDeclaration" && body(stmt) === null && !hasModifier(stmt, "DeclareKeyword")
}

export function declareExports(c: Checker, stmt: Node, module: ModuleInfo) {
    const exported = hasModifier(stmt, "ExportKeyword")
    if (exported && hasModifier(stmt, "DefaultKeyword")) {
        c.error(stmt, "Default exports are not supported in Ore. Use named exports.")
        return
    }
    if (exported && stmt.kind === "VariableStatement") {
        for (const d of declarations(declarationList(stmt))) {
            const name = nameNode(d)
            if (isIdentifier(name)) addExport(c, module, name.text, name.text, name, null)
        }
    } else if (
        exported &&
        (stmt.kind === "FunctionDeclaration" ||
            stmt.kind === "ClassDeclaration" ||
            stmt.kind === "InterfaceDeclaration" ||
            stmt.kind === "TypeAliasDeclaration") &&
        optionalName(stmt) !== null &&
        !isOverloadSignature(stmt)
    ) {
        const name = nameNode(stmt)
        addExport(c, module, name.text, name.text, name, null)
    } else if (stmt.kind === "ExportDeclaration") {
        // `export { a, b as c }`, or `export { x } from "./m"`.
        const specifier = moduleSpecifierNode(stmt)
        const from = specifier !== null ? importedModule(c, specifier, module) : null
        if (specifier !== null && from === null) return
        const clause = exportClause(stmt)
        if (clause === null || clause.kind !== "NamedExports") {
            c.error(stmt, "Use 'export { name }' to re-export; 'export *' is not supported.")
            return
        }
        for (const e of elements(clause)) {
            const local = propertyName(e) ?? nameNode(e)
            addExport(c, module, nameNode(e).text, c.text(local), e, from)
        }
    } else if (stmt.kind === "ExportAssignment") {
        c.error(stmt, "Default exports are not supported in Ore. Use named exports.")
    }
}

/** The module an import specifier resolves to; the loader already reported unresolved ones. */
export function importedModule(c: Checker, specifier: Node, module: ModuleInfo): ModuleInfo | null {
    if (specifier.kind !== "StringLiteral") return null
    const imports = c.program.imports.get(module.source)
    if (imports === null) return null
    const target = imports.get(stringText(specifier))
    return target === null ? null : c.modules.get(target)
}

/** What a module exports under a name, following re-exports. */
export function exportOf(
    c: Checker,
    module: ModuleInfo,
    name: string,
    seen: Set<ModuleInfo> | null = null,
): Exported | null {
    const visited = seen ?? new Set<ModuleInfo>()
    const entry = module.exports.get(name)
    if (entry === null || visited.has(module)) return null
    visited.add(module)
    const from = entry.from
    if (from !== null) return exportOf(c, from, entry.local, visited)
    const value = module.scope.ownValue(entry.local)
    const type = module.scope.ownType(entry.local)
    return value !== null || type !== null ? new ExportedClass(value, type) : null
}

export function declareImport(c: Checker, stmt: Node, module: ModuleInfo) {
    const type = checkImportAttributes(c, stmt)
    if (type === "text") {
        declareTextImport(c, stmt, module)
        return
    }
    if (type === "json") {
        declareJsonImport(c, stmt, module)
        return
    }
    // An unknown type was reported.
    if (type !== "") return
    const specifier = moduleSpecifierNode(stmt)
    const target = specifier !== null ? importedModule(c, specifier, module) : null
    const clause = importClause(stmt)
    if (target === null || clause === null) return
    const defaultName = clause.child("name")
    if (defaultName !== null)
        c.error(defaultName, "Default imports are not supported in Ore. Use 'import { name } from ...'.")
    const bindings = namedBindings(clause)
    if (bindings === null) return
    if (bindings.kind === "NamespaceImport") {
        const name = nameNode(bindings).text
        const symbol: ValueSymbol = new ModuleSymbol(name, (n) => exportOf(c, target, n), bindings)
        if (!module.scope.declareValue(name, symbol))
            c.duplicate(module.scope, name, nameNode(bindings), `Duplicate declaration '${name}'.`)
        return
    }
    for (const element of elements(bindings)) {
        const original = propertyName(element)
        const imported = (original ?? nameNode(element)).text
        if (!target.exports.has(imported)) {
            c.error(
                original ?? nameNode(element),
                `Module '${stringText(specifier!)}' has no exported member '${imported}'.`,
            )
            continue
        }
        if (!module.scope.declareAlias(nameNode(element).text, () => exportOf(c, target, imported))) {
            const local = nameNode(element)
            c.duplicate(module.scope, local.text, local, `Duplicate declaration '${local.text}'.`)
        }
        c.specifiers.push(() => {
            const exported = exportOf(c, target, imported)
            const value = exported === null ? null : exported.value
            const type = exported === null ? null : exported.type
            const decl = value !== null ? value.decl : type !== null ? type.decl : null
            if (decl !== null)
                c.info.definitions.set(original !== null && isIdentifier(original) ? original : nameNode(element), decl)
        })
    }
}

/**
 * `import name from "./file" with { type: "text" }`: the file's contents,
 * read when the program is compiled, as a string constant.
 */
export function declareTextImport(c: Checker, stmt: Node, module: ModuleInfo) {
    const clause = importClause(stmt)
    const specifier = moduleSpecifierNode(stmt)!
    const name = clause === null ? null : clause.child("name")
    if (clause === null || name === null || namedBindings(clause) !== null) {
        c.error(
            stmt,
            `A text import has one name: 'import text from "${stringText(specifier)}" with { type: "text" }'.`,
        )
        return
    }
    // The loader reported a missing file.
    const texts = c.program.texts.get(module.source)
    const contents = texts === null ? null : texts.get(stringText(specifier))
    if (contents === null) return
    const value: Operand = new Typed(new StringLit(types.string, contents))
    if (!module.scope.declareValue(name.text, new ConstSymbol(value, types.string, clause)))
        c.duplicate(module.scope, name.text, name, `Duplicate declaration '${name.text}'.`)
}

/**
 * Reports the attributes of an import other than `type: "text"` and
 * `type: "json"`, and gives the type: "" for none.
 */
function checkImportAttributes(c: Checker, stmt: Node): string {
    const attributes = stmt.child("attributes")
    if (attributes === null) return ""
    for (const element of attributes.list("elements")) {
        const name = element.child("name")
        const value = element.child("value")
        if (name === null || value === null) continue
        const key = attributeName(name)
        if (key !== "type") c.error(name, `Unknown import attribute '${key}'. Only 'type' is supported.`)
        else if (value.kind !== "StringLiteral" || (stringText(value) !== "text" && stringText(value) !== "json"))
            c.error(value, `Unknown import type '${importType(stmt)}'. Use 'text' or 'json'.`)
    }
    return importType(stmt)
}

/**
 * `import name from "./file.json" with { type: "json" }`: the value of the
 * JSON file, parsed when the program is compiled, typed as the same literal
 * written in Ore. The loader made the file a module that exports it.
 */
export function declareJsonImport(c: Checker, stmt: Node, module: ModuleInfo) {
    const clause = importClause(stmt)
    const specifier = moduleSpecifierNode(stmt)!
    const name = clause === null ? null : clause.child("name")
    if (clause === null || name === null || namedBindings(clause) !== null) {
        c.error(
            stmt,
            `A JSON import has one name: 'import data from "${stringText(specifier)}" with { type: "json" }'.`,
        )
        return
    }
    // The loader reported a missing file.
    const target = importedModule(c, specifier, module)
    if (target === null) return
    if (!module.scope.declareAlias(name.text, () => exportOf(c, target, jsonExport)))
        c.error(name, `Duplicate declaration '${name.text}'.`)
    else c.jsonImports.push(new JsonImport(name.text, module, target))
    c.specifiers.push(() => {
        const exported = exportOf(c, target, jsonExport)
        const value = exported === null ? null : exported.value
        if (value === null) return
        // The value in the JSON file rather than the declaration the loader added.
        const initializer = value.decl.child("initializer")
        c.info.definitions.set(name, initializer ?? value.decl)
    })
}

/**
 * Gives the value of each JSON file a declared type: that of the first
 * top-level declaration of an importing module, in module and source order,
 * whose initializer is the imported name alone, as `const c: Config = config`.
 * The value is then checked against that type, as an annotated literal would
 * be, so that `null` fits `string | null` and `[]` fits `string[]`. A file
 * without such a declaration is typed as its literal.
 */
export function typeJsonImports(c: Checker) {
    for (const i of c.jsonImports) {
        const statements = c.statementsOf(i.target.source)
        if (statements.length !== 1 || statements[0].kind !== "VariableStatement") continue
        const target = declarations(declarationList(statements[0]))[0]
        if (c.jsonTypes.has(target)) continue
        let found = false
        for (const stmt of c.statementsOf(i.module.source)) {
            if (found || stmt.kind !== "VariableStatement") continue
            for (const decl of declarations(declarationList(stmt))) {
                const annotation = typeNode(decl)
                const init = initializer(decl)
                if (found || annotation === null || init === null || !isIdentifier(init) || init.text !== i.name)
                    continue
                found = true
                // The declaration reports the errors of its type when it is checked.
                const errors = c.diagnostics.length
                c.prefix = i.module.prefix
                const type = c.resolveValueType(annotation, i.module.scope)
                c.prefix = ""
                while (c.diagnostics.length > errors) c.diagnostics.pop()
                if (type !== null) c.jsonTypes.set(target, type)
            }
        }
    }
}

/** Reports exports of names that a module does not declare. */
export function checkExports(c: Checker, modules: ModuleInfo[]) {
    for (const resolve of c.specifiers) resolve()
    for (const module of modules) {
        // `export { a, b as c }` refers to declarations of the module.
        for (const stmt of c.statementsOf(module.source)) {
            const clause = stmt.kind === "ExportDeclaration" ? exportClause(stmt) : null
            if (
                stmt.kind !== "ExportDeclaration" ||
                moduleSpecifierNode(stmt) !== null ||
                clause === null ||
                clause.kind !== "NamedExports"
            )
                continue
            for (const e of elements(clause)) {
                const local = propertyName(e) ?? nameNode(e)
                if (!isIdentifier(local)) continue
                const value = module.scope.lookupValue(local.text)
                if (value !== null) {
                    c.info.definitions.set(local, value.decl)
                    continue
                }
                const type = module.scope.lookupType(local.text)
                if (type !== null) c.info.definitions.set(local, type.decl)
            }
        }
    }
}

/**
 * Reports the names of `export { a }` that the module does not declare; after
 * its top-level code, which declares its variables.
 */
export function checkExportsDeclared(c: Checker, modules: ModuleInfo[]) {
    for (const module of modules) {
        for (const stmt of c.statementsOf(module.source)) {
            const clause = stmt.kind === "ExportDeclaration" ? exportClause(stmt) : null
            if (moduleSpecifierNode(stmt) !== null || clause === null || clause.kind !== "NamedExports") continue
            for (const e of elements(clause)) {
                const name = nameNode(e).text
                const entry = module.exports.get(name)
                if (entry === null || entry.from !== null || exportOf(c, module, name) !== null) continue
                c.error(e, `Cannot export '${entry.local}': it is not declared in this module.`)
            }
        }
    }
}

/**
 * The type aliases of a module, in the order they depend on each other, so
 * that one can name another declared after it. Object types that refer to
 * themselves, directly or through other aliases (`type List = { next: List |
 * null }`), are structs of their own, declared before their fields are
 * resolved; other object types are shapes, the same for the same fields.
 */
export function declareTypeAliases(c: Checker, decls: Node[], scope: Scope) {
    const plain: Node[] = []
    for (const d of decls) {
        if (typeParameters(d).length > 0) declareGeneric(c, d, scope)
        else plain.push(d)
    }
    const index = new Map<string, int>()
    for (let i = 0; i < plain.length; i++) index.set(nameNode(plain[i]).text, i)
    // The aliases each one names in its type.
    const edges: int[][] = []
    for (const d of plain) {
        const names: string[] = []
        typeNames(typeNode(d)!, names)
        const out: int[] = []
        for (const n of names) {
            const at = index.get(n)
            if (at !== null && !out.includes(at)) out.push(at)
        }
        edges.push(out)
    }
    for (const component of stronglyConnected(edges)) {
        const first = component[0]
        const cyclic = component.length > 1 || edges[first].includes(first)
        if (!cyclic) {
            declareTypeAlias(c, plain[first], scope)
            continue
        }
        // Object types of the cycle first, as structs without fields yet; then the other aliases; then the fields.
        const structs: StructType[] = []
        const literals: Node[] = []
        for (const i of component) {
            const d = plain[i]
            const node = typeNode(d)!
            if (node.kind !== "TypeLiteral") continue
            const name = nameNode(d).text
            const struct = new StructType(c.nextStructId++, name, false, [], [])
            if (!scope.declareType(name, new TypeSymbol(struct, d))) c.error(nameNode(d), `Duplicate type '${name}'.`)
            structs.push(struct)
            literals.push(node)
        }
        if (structs.length === 0) {
            for (const i of component)
                c.error(
                    nameNode(plain[i]),
                    "A recursive type alias needs an object type in its cycle: '{ next: T | null }'.",
                )
            continue
        }
        for (const i of component) if (typeNode(plain[i])!.kind !== "TypeLiteral") declareTypeAlias(c, plain[i], scope)
        for (let k = 0; k < structs.length; k++) {
            const fields = c.literalFields(literals[k], scope)
            fields.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
            structs[k].fields = fields
            c.memberDecls.set(structs[k], c.memberNodes(literals[k]))
            c.module.structs.push(structs[k])
        }
    }
}

/** The names of the type references in a type, such as `B` in `{ b: B[] }`. */
function typeNames(node: Node, out: string[]) {
    if (node.kind === "TypeReference") {
        const name = node.child("typeName")
        if (name !== null && isIdentifier(name)) out.push(name.text)
    }
    for (const child of node.children) typeNames(child, out)
}

/**
 * The strongly connected components of a graph, by Tarjan's algorithm: each
 * component comes after the components it has edges to.
 */
function stronglyConnected(edges: int[][]): int[][] {
    const order: int[] = []
    const low: int[] = []
    const onStack: bool[] = []
    for (let i = 0; i < edges.length; i++) {
        order.push(-1)
        low.push(0)
        onStack.push(false)
    }
    const stack: int[] = []
    const components: int[][] = []
    let counter = 0
    function visit(v: int): void {
        order[v] = counter
        low[v] = counter
        counter++
        stack.push(v)
        onStack[v] = true
        for (const w of edges[v]) {
            if (order[w] < 0) {
                visit(w)
                low[v] = Math.min(low[v], low[w])
            } else if (onStack[w]) low[v] = Math.min(low[v], order[w])
        }
        if (low[v] !== order[v]) return
        const component: int[] = []
        let done = false
        while (!done) {
            const w = stack.pop()
            onStack[w] = false
            component.push(w)
            done = w === v
        }
        component.reverse()
        components.push(component)
    }
    for (let i = 0; i < edges.length; i++) if (order[i] < 0) visit(i)
    return components
}

export function declareTypeAlias(c: Checker, decl: Node, scope: Scope) {
    if (typeParameters(decl).length > 0) {
        declareGeneric(c, decl, scope)
        return
    }
    const type = c.resolveType(typeNode(decl)!, scope)
    if (type === null) return
    // An anonymous object type or a union is displayed by the first alias that names it.
    if (type.kind === "struct" && type.name === null) type.name = nameNode(decl).text
    if (type.kind === "union" && type.name === null) type.name = nameNode(decl).text
    if (!scope.declareType(nameNode(decl).text, new TypeSymbol(type, decl)))
        c.error(nameNode(decl), `Duplicate type '${nameNode(decl).text}'.`)
}

export function declareFunction(c: Checker, decl: Node, scope: Scope): Func | null {
    const name = optionalName(decl)
    if (name === null) {
        c.error(decl, "A function declaration must have a name.")
        return null
    }
    if (hasModifier(decl, "DeclareKeyword")) {
        declareExtern(c, decl, scope)
        return null
    }
    const key = `${c.prefix}${name.text}`
    if (body(decl) === null) {
        // An overload signature, for the implementation that follows.
        if (typeParameters(decl).length > 0) {
            c.error(name, "Generic overload signatures are not supported yet.")
            return null
        }
        const list = c.overloadDecls.get(key)
        if (list !== null) list.push(decl)
        else c.overloadDecls.set(key, [decl])
        return null
    }
    const signatures = c.overloadDecls.get(key)
    if (signatures !== null) {
        c.overloadDecls.delete(key)
        return declareOverloaded(c, decl, scope, signatures)
    }
    if (typeParameters(decl).length > 0) {
        declareGeneric(c, decl, scope)
        return null
    }
    const asterisk = asteriskToken(decl)
    if (asterisk !== null) c.error(asterisk, "Generators are not supported in Ore.")
    for (const mod of modifiers(decl)) {
        if (mod.kind === "AsyncKeyword") c.error(mod, "'async' is not supported in Ore. Use spawn() and channels.")
        else if (mod.kind === "DefaultKeyword") c.error(mod, "Default exports are not supported in Ore.")
        else if (mod.kind !== "ExportKeyword") c.error(mod, `Modifier '${c.text(mod)}' is not allowed here.`)
    }

    const exported = hasModifier(decl, "ExportKeyword")
    const func = makeFunc(c, decl, scope, name.text, c.prefix + cIdent(name.text), exported)
    applyFuncDirectives(c, decl, func)
    if (!scope.declareValue(name.text, new FuncSymbol(func, decl))) {
        c.duplicate(scope, name.text, name, `Duplicate declaration '${name.text}'.`)
        return null
    }
    return func
}

/**
 * A function with overload signatures: the implementation, hidden, and for
 * each signature a function that calls it with its arguments and returns
 * its result converted to the signature's result type (checked at run time
 * when narrower). Its name calls the signatures.
 */
function declareOverloaded(c: Checker, decl: Node, scope: Scope, signatures: Node[]): Func | null {
    const name = nameNode(decl)
    if (typeParameters(decl).length > 0) {
        c.error(name, "A generic function cannot have overload signatures yet.")
        return null
    }
    const exported = hasModifier(decl, "ExportKeyword")
    const impl = makeFunc(c, decl, scope, name.text, c.prefix + cIdent(name.text) + "_impl", false)
    applyFuncDirectives(c, decl, impl)
    const overloads: Func[] = []
    for (let i = 0; i < signatures.length; i++) {
        const sig = signatures[i]
        if (hasModifier(sig, "ExportKeyword") !== exported)
            c.error(nameNode(sig), "Overload signatures must all be exported or not, as the implementation.")
        const func = makeFunc(c, sig, scope, name.text, `${c.prefix}${cIdent(name.text)}_${i}`, exported)
        // The body: `return impl(params)`, its defaults filled in as for any call.
        const args: Node[] = []
        const operands: Operand[] = []
        const sigParams = parameters(sig)
        for (let k = 0; k < func.params.length; k++) {
            const p = func.params[k]
            args.push(k < sigParams.length ? nameNode(sigParams[k]) : nameNode(sig))
            operands.push(typed(new LocalRef(p.type, p)))
        }
        const before = c.diagnostics.length
        const call = callFunc(c, impl, args, sig, scope, `The implementation of '${name.text}'`, null, operands)
        if (call.k !== "typed") continue
        if (c.diagnostics.length > before) continue
        const result = func.type.result
        let value: Expr = call.expr
        if (result.kind !== "void" && !sameType(value.type, result)) {
            if (narrows(value.type, result)) value = new Recast(result, value)
            else value = c.coerce(call, result, typeNode(sig) ?? nameNode(sig))
        }
        func.body = new Block([result.kind === "void" ? new ExprStmt(value) : new ReturnStmt(value)])
        overloads.push(func)
    }
    const symbol = new FuncSymbol(impl, decl)
    symbol.overloads = overloads
    if (!scope.declareValue(name.text, symbol)) {
        c.duplicate(scope, name.text, name, `Duplicate declaration '${name.text}'.`)
        return null
    }
    return impl
}

/** Whether `to` is a narrower union than `from`, or one of its members: a value of `from` converts to it by a check at run time. */
function narrows(from: Type, to: Type): bool {
    if (from.kind !== "union") return false
    const members = from.members
    return membersOf(to).every((m) => members.some((f) => sameType(f, m)))
}

/** C can exchange numbers, booleans, strings and pointers. */
function cCompatible(t: Type): bool {
    return isNumeric(t) || t.kind === "bool" || t.kind === "string" || t.kind === "ptr"
}

/** `declare function f(...)`: an external C function named `f`. */
export function declareExtern(c: Checker, decl: Node, scope: Scope) {
    const nameId = nameNode(decl)
    const name = nameId.text
    if (body(decl) !== null) {
        c.error(nameId, "A declared function cannot have a body.")
        return
    }
    const typeParams = typeParameters(decl)
    if (typeParams.length > 0) {
        c.error(typeParams[0], "External functions cannot be generic.")
        return
    }
    if (!isCName(name)) {
        c.error(nameId, "An external function needs a C name.")
        return
    }
    const params_ = parameters(decl)
    let params = resolveParams(c, params_, scope)
    // `...args: T[]` declares a variadic C function, such as fcntl or printf. C
    // promotes the arguments after the fixed ones, to an int64, a double or a pointer.
    let variadic: Type | null = null
    const last = params_.length > 0 ? params_[params_.length - 1] : null
    if (last !== null && dotDotDotToken(last) !== null) {
        const rest = params.length > 0 ? params[params.length - 1].type : null
        const elem = rest !== null && rest.kind === "array" ? rest.elem : null
        if (
            elem === null ||
            !(
                (elem.kind === "int" && elem.bits === 64) ||
                (elem.kind === "float" && elem.bits === 64) ||
                elem.kind === "ptr"
            )
        ) {
            c.error(
                last,
                "The variadic arguments of a C function are i64, f64 or ptr, as C promotes them: write '...args: i64[]'.",
            )
        }
        variadic = elem
        params = params.slice(0, params.length - 1)
    } else if (c.signatures.has(params)) {
        c.error(nameId, "An external function cannot have optional parameters.")
    }
    const annotation = typeNode(decl)
    const result = annotation !== null ? (c.resolveType(annotation, scope) ?? types.void) : types.void
    for (let i = 0; i < params_.length; i++) {
        if (i < params.length && !cCompatible(params[i].type))
            c.error(params_[i], `Type '${typeToString(params[i].type)}' cannot be passed to C.`)
    }
    if (!cCompatible(result) && result.kind !== "void")
        c.error(annotation!, `Type '${typeToString(result)}' cannot be returned from C.`)
    const func = new Func(
        name,
        name,
        c.line(nameId),
        new FuncType(
            params.map((p) => p.type),
            result,
        ),
        params,
        new Block([]),
        false,
        c.sourceOf(decl).path,
        true,
        variadic,
    )
    c.module.functions.push(func)
    if (!scope.declareValue(name, new FuncSymbol(func, decl)))
        c.duplicate(scope, name, nameId, `Duplicate declaration '${name}'.`)
}

/** A function with the signature of a declaration, resolved in `scope`; the body is checked later. */
export function makeFunc(
    c: Checker,
    decl: Node,
    scope: Scope,
    sourceName: string,
    cname: string,
    exported: bool,
): Func {
    const params = resolveParams(c, parameters(decl), scope)
    const annotation = typeNode(decl)
    const result = annotation !== null ? (c.resolveType(annotation, scope) ?? types.void) : types.void
    const func = new Func(
        `ore_fn_${cname}`,
        sourceName,
        c.line(nameNode(decl)),
        new FuncType(
            params.map((p) => p.type),
            result,
        ),
        params,
        new Block([]),
        exported,
        c.sourceOf(decl).path,
    )
    c.module.functions.push(func)
    c.funcDecls.set(func, decl)
    return func
}

/** Reports a type parameter without a default after one with a default. */
function checkDefaults(c: Checker, params: Node[]) {
    let defaults = false
    for (const p of params) {
        const d = defaultTypeNode(p)
        if (d !== null) defaults = true
        else if (defaults) c.error(nameNode(p), "A type parameter without a default cannot follow one with a default.")
    }
}

/**
 * Declares a generic function of a function body, or a generic function
 * literal of a `const` (`decl`, named by `name`, declared by `declNode`),
 * instantiated as closures (see `ClosureSite`).
 */
export function declareGenericClosure(c: Checker, decl: Node, name: Node, declNode: Node, scope: Scope) {
    const params = typeParameters(decl)
    checkDefaults(c, params)
    const generic = new Generic(name.text, decl, params, scope, new Map<string, Instance>())
    generic.closure = new ClosureSite(c.fn)
    c.closureGenerics.push(generic)
    if (!scope.declareValue(name.text, new GenericFuncSymbol(generic, declNode)))
        c.error(name, `Cannot redeclare '${name.text}' in the same scope.`)
}

export function declareGeneric(c: Checker, decl: Node, scope: Scope) {
    const name = nameNode(decl).text
    const params = typeParameters(decl)
    checkDefaults(c, params)
    const generic = new Generic(name, decl, params, scope, new Map<string, Instance>())
    c.genericsByDecl.set(decl, generic)
    let declared: bool
    if (decl.kind === "FunctionDeclaration") declared = scope.declareValue(name, new GenericFuncSymbol(generic, decl))
    else {
        declared = scope.declareType(name, new TypeSymbol(types.never, decl, generic))
        if (declared && decl.kind === "ClassDeclaration")
            declared = scope.declareValue(name, new ClassSymbol(null, decl))
    }
    if (!declared) c.duplicate(scope, name, nameNode(decl), `Duplicate declaration '${name}'.`)
}

/**
 * Type arguments with the defaults of the parameters left out (`<T, U = T[]>`),
 * which can use the parameters before them; as given when a parameter left
 * out has no default.
 */
export function withDefaults(c: Checker, generic: Generic, given: Type[]): Type[] {
    if (given.length >= generic.params.length) return given
    const scope = new Scope(generic.scope)
    const args: Type[] = []
    for (let i = 0; i < generic.params.length; i++) {
        const p = generic.params[i]
        if (i < given.length) args.push(given[i])
        else {
            const d = defaultTypeNode(p)
            const resolved = d !== null ? c.resolveTypeArgument(d, scope) : null
            if (resolved === null) return given
            args.push(resolved)
        }
        scope.declareType(nameNode(p).text, new TypeSymbol(args[i], p))
    }
    return args
}

/** A pending check of a generic instance, run with the instance named in its diagnostics. */
export function inContext(c: Checker, label: string, check: () => void): () => void {
    return () => {
        const saved = c.context
        c.context = label
        check()
        c.context = saved
    }
}

/**
 * The instance of a generic for type arguments, created once: a function
 * (whose body is checked later), a class, an interface or a type.
 */
export function instantiate(c: Checker, generic: Generic, given: Type[], node: Node): Instance | null {
    const args = withDefaults(c, generic, given)
    if (args.length !== generic.params.length) {
        c.error(node, `'${generic.name}' expects ${generic.params.length} type argument(s), got ${args.length}.`)
        return null
    }
    const key = args.map(typeKey).join(",")
    const existing = generic.instances.get(key)
    if (existing !== null) return existing
    if (++c.instanceCount > 1000) {
        c.error(node, `Too many instances of generics; '${generic.name}' may instantiate itself endlessly.`)
        return null
    }

    const scope = new Scope(generic.scope)
    for (let i = 0; i < generic.params.length; i++) {
        // A type parameter given `void` is `null` in the instance, as `undefined` is in TypeScript.
        const symbol = new TypeSymbol(args[i].kind === "void" ? types.null : args[i], generic.params[i])
        if (args[i].kind === "void") c.voidParameters.add(symbol)
        scope.declareType(nameNode(generic.params[i]).text, symbol)
    }
    for (let i = 0; i < generic.params.length; i++) {
        const p = generic.params[i]
        const bound = constraint(p)
        const resolved = bound !== null ? c.resolveType(bound, scope) : null
        if (resolved !== null && !satisfiesConstraint(c, args[i], resolved)) {
            c.error(
                node,
                `Type '${typeToString(args[i])}' does not satisfy the constraint '${typeToString(resolved)}' of '${nameNode(p).text}'.`,
            )
            return null
        }
    }
    const label = generic.params.length === 0 ? generic.name : `${generic.name}<${args.map(typeToString).join(", ")}>`
    const site = generic.closure
    if (site !== null) return instantiateClosure(c, generic, site, key, scope, label)
    const cname = `${cIdent(generic.name)}_${c.instanceCount}`
    const decl = generic.decl

    if (decl.kind === "TypeAliasDeclaration") {
        // `type Uppercase<S extends string> = intrinsic`: computed by the checker.
        const outer = c.typeSite
        if (outer === null) c.typeSite = node
        const literal = typeNode(decl)!
        if (literal.kind === "TypeLiteral" && refersTo(generic, decl, generic.scope, [])) {
            // `type List<T> = { v: T; next: List<T> | null }`: a struct of its own, registered before
            // its fields are resolved, so that the fields find it, as a recursive alias without parameters.
            const struct = new StructType(c.nextStructId++, label, false, [], [])
            generic.instances.set(key, struct)
            c.instanceOf.set(struct, new InstanceInfo(generic, args))
            const fields = c.literalFields(literal, scope)
            fields.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
            struct.fields = fields
            c.memberDecls.set(struct, c.memberNodes(literal))
            c.module.structs.push(struct)
            c.typeSite = outer
            return struct
        }
        if (generic.resolving.includes(key)) {
            c.typeSite = outer
            c.error(node, "A recursive type alias needs an object type in its cycle: '{ next: T | null }'.")
            return null
        }
        generic.resolving.push(key)
        const type =
            c.text(typeNode(decl)!) === "intrinsic"
                ? intrinsicType(c, generic.name, args, node)
                : c.resolveType(typeNode(decl)!, scope)
        generic.resolving.pop()
        c.typeSite = outer
        if (type !== null && type.kind === "struct" && type.name === null) type.name = label
        if (type !== null) generic.instances.set(key, type)
        return type
    }
    if (decl.kind === "FunctionDeclaration") {
        const func = makeFunc(c, decl, scope, label, cname, false)
        generic.instances.set(key, func)
        c.pending.push(inContext(c, label, () => checkFunctionBody(c, decl, func, scope)))
        return func
    }
    if (decl.kind === "MethodDeclaration" && hasModifier(decl, "StaticKeyword")) {
        // A generic static method: a function, without `this`.
        const func = makeFunc(c, decl, scope, label, cname, false)
        generic.instances.set(key, func)
        c.pending.push(inContext(c, label, () => checkFunctionBody(c, decl, func, scope)))
        return func
    }
    if (decl.kind === "MethodDeclaration") {
        const owner = genericMethodOwner(c, generic)!
        const func = makeMethod(c, decl, owner, scope, `${owner.type.name}.${label}`, `ore_m_${owner.cname}_${cname}`)
        generic.instances.set(key, func)
        c.pending.push(inContext(c, label, () => checkMethodBody(c, decl, func, owner.type, scope)))
        return func
    }
    if (decl.kind === "InterfaceDeclaration") {
        const type = new InterfaceTypeClass(c.nextStructId++, label, [])
        generic.instances.set(key, type)
        c.instanceOf.set(type, new InstanceInfo(generic, args))
        c.memberDecls.set(type, new Map<string, Node>())
        fillInterface(c, new InterfaceInfo(decl, type, scope, "declared"), scope)
        return type
    }
    const type = new StructType(c.nextStructId++, label, true, [], [])
    generic.instances.set(key, type)
    c.instanceOf.set(type, new InstanceInfo(generic, args))
    c.module.structs.push(type)
    c.memberDecls.set(type, new Map<string, Node>())
    const info = classInfo(c, decl, type, scope, cname)
    resolveBase(c, info)
    declareClassMembers(c, info, scope)
    c.pending.push(
        inContext(c, label, () => {
            checkFieldInitializers(c, info, scope)
            checkImplements(c, info, scope)
            checkClassBodies(c, info, scope)
        }),
    )
    return type
}

/**
 * Whether a type names a generic type alias, directly or through the generic
 * type aliases it names (`seen`, the ones followed already).
 */
function refersTo(generic: Generic, decl: Node, scope: Scope, seen: Generic[]): bool {
    const names: string[] = []
    typeNames(typeNode(decl)!, names)
    const params = typeParameters(decl).map((p) => nameNode(p).text)
    for (const n of names) {
        if (params.includes(n)) continue
        const symbol = scope.lookupType(n)
        if (symbol === null) continue
        const other = symbol.generic
        if (other === null || other.decl.kind !== "TypeAliasDeclaration") continue
        if (other === generic) return true
        if (seen.includes(other)) continue
        seen.push(other)
        if (refersTo(generic, other.decl, other.scope, seen)) return true
    }
    return false
}

/**
 * Checks the instance of a generic closure for a key of type arguments, in
 * the function that declares it: its own closure, which the calls create.
 */
function instantiateClosure(
    c: Checker,
    generic: Generic,
    site: ClosureSite,
    key: string,
    scope: Scope,
    label: string,
): Instance | null {
    if (site.failed.has(key)) return null
    const savedFn = c.fn
    const savedFacts = c.facts
    const savedContext = c.context
    // What is known where it is called is not known in the instance, which every call shares.
    c.fn = site.fn
    c.facts = [new Map<string, Type>()]
    c.context = label
    site.checking.add(key)
    site.scopes.set(key, scope)
    const closure = checkClosure(c, generic.decl, scope, null, false, null, label, (func) => {
        generic.instances.set(key, func)
    })
    site.checking.delete(key)
    c.fn = savedFn
    c.facts = savedFacts
    c.context = savedContext
    if (closure.k !== "typed") {
        site.failed.add(key)
        return null
    }
    shareCaptures(c)
    return generic.instances.get(key)
}

/**
 * The closure that a call of an instance of a generic closure creates and
 * calls. The closures between the call and the declaration capture what the
 * instance captures.
 */
export function closureCallee(c: Checker, generic: Generic, func: Func, node: Node, scope: Scope): Closure | null {
    const site = generic.closure!
    let key = ""
    for (const [k, instance] of generic.instances) if (instance === func) key = k
    let type = func.type
    const instanceScope = site.scopes.get(key)
    if (site.checking.has(key) && instanceScope !== null) {
        // A call of the instance in its own body: its result type is not inferred yet.
        const annotation = typeNode(generic.decl)
        if (annotation === null) {
            c.error(node, `'${generic.name}' calls itself, so it needs a return type annotation.`)
            return null
        }
        const result = c.resolveType(annotation, instanceScope)
        if (result === null) return null
        type = new FuncType(func.type.params, result)
        type.required = func.type.required
        type.rest = func.type.rest
    }
    const closures: Func[] = []
    let s: Scope | null = scope
    while (s !== null && s !== generic.scope) {
        const closure = s.closure
        if (closure !== null) closures.push(closure)
        s = s.parent
    }
    const calls = site.calls.get(key)
    if (calls !== null) calls.push(closures)
    else site.calls.set(key, [closures])
    shareCaptures(c)
    return new Closure(type, func)
}

/**
 * Makes the closures around each call of a generic closure capture what the
 * instance captures, until nothing changes: an instance captures more while
 * its body is checked, after its calls in that body.
 */
function shareCaptures(c: Checker) {
    let changed = true
    while (changed) {
        changed = false
        for (const generic of c.closureGenerics) {
            for (const [key, calls] of generic.closure!.calls) {
                const func = generic.instances.get(key)
                if (!(func instanceof Func)) continue
                const captures = func.captures
                if (captures === null) continue
                for (const local of captures) {
                    for (const closures of calls) {
                        for (const f of closures) {
                            if (f.captures!.includes(local)) continue
                            capture(local, [f])
                            changed = true
                        }
                    }
                }
            }
        }
    }
}

/** The class declaring a generic method. */
export function genericMethodOwner(c: Checker, generic: Generic): ClassInfoType | null {
    for (const [_, methods] of c.genericMethods) for (const [__, m] of methods) if (m.generic === generic) return m.info
    return null
}

/** Whether a type argument satisfies a constraint. */
export function satisfiesConstraint(c: Checker, arg: Type, bound: Type): bool {
    if (sameType(arg, bound) || arg.kind === "never") return true
    const source = structOrInterface(arg)
    if (bound.kind === "interface" && source !== null) return conformance(c, source, bound).reason === null
    return membersOf(arg).every((a) => membersOf(bound).some((b) => memberOf(a, b)))
}

/**
 * Infers type arguments of a generic from the types of arguments, by
 * matching parameter type annotations against them.
 */
export function inferTypeArgs(
    c: Checker,
    generic: Generic,
    params: Node[],
    argTypes: (Type | null)[],
    node: Node,
    expected: Type | null = null,
): Type[] | null {
    const names = generic.params.map((p) => nameNode(p).text)
    const bindings = new Map<string, Type>()
    for (let i = 0; i < params.length; i++) {
        const annotation = typeNode(params[i])
        const argType = i < argTypes.length ? argTypes[i] : null
        if (annotation !== null && argType !== null) inferFrom(c, annotation, argType, names, bindings, generic.scope)
    }
    // Parameters the arguments do not bind take the expected type of the result: `const xs: string[] = empty()`.
    const result = typeNode(generic.decl)
    if (expected !== null && result !== null && names.some((n) => !bindings.has(n)))
        inferFrom(c, result, expected, names, bindings, generic.scope)
    // Parameters that the arguments do not bind take their defaults.
    const bound: Type[] = []
    let complete = true
    for (const n of names) {
        const t = bindings.get(n)
        if (t === null) complete = false
        else if (complete) bound.push(t)
    }
    if (!complete && names.every((n, i) => bindings.has(n) || defaultTypeNode(generic.params[i]) !== null)) {
        const all = withDefaults(c, generic, bound)
        if (all.length === names.length) {
            for (let i = 0; i < names.length; i++) {
                const t = bindings.get(names[i])
                if (t !== null) all[i] = t
            }
            return all
        }
    }
    const missing = names.filter((n) => !bindings.has(n))
    if (missing.length > 0) {
        c.error(
            node,
            `Cannot infer type argument${missing.length > 1 ? "s" : ""} ${missing.map((m) => `'${m}'`).join(", ")} of '${generic.name}'. Specify them, e.g. '${generic.name}<...>(...)'.`,
        )
        return null
    }
    return names.map((n) => bindings.get(n)!)
}

/** Binds type parameters `names` in annotation `n` by matching it against `type`. */
export function inferFrom(
    c: Checker,
    n: Node,
    type: Type,
    names: string[],
    bindings: Map<string, Type>,
    scope: Scope,
): void {
    if (n.kind === "ParenthesizedType") {
        inferFrom(c, typeNode(n)!, type, names, bindings, scope)
        return
    }
    if (n.kind === "FunctionType") {
        if (type.kind !== "func") return
        const params = parameters(n)
        for (let i = 0; i < params.length; i++) {
            const annotation = typeNode(params[i])
            if (annotation !== null && i < type.params.length)
                inferFrom(c, annotation, type.params[i], names, bindings, scope)
        }
        const result = typeNode(n)!
        // A void callback re-checked to return null binds its result's type parameter to void.
        if (
            c.voidCallbacks.has(type) &&
            result.kind === "TypeReference" &&
            isIdentifier(typeName(result)) &&
            names.includes(typeName(result).text)
        ) {
            bindings.set(typeName(result).text, types.void)
            return
        }
        inferFrom(c, result, type.result, names, bindings, scope)
        return
    }
    if (n.kind === "ArrayType") {
        if (type.kind === "array") inferFrom(c, elementType(n), type.elem, names, bindings, scope)
        return
    }
    if (n.kind === "TupleType") {
        const elems = n.list("elements")
        if (type.kind === "struct" && type.tuple && type.fields.length === elems.length)
            for (let i = 0; i < elems.length; i++) inferFrom(c, elems[i], type.fields[i].type, names, bindings, scope)
        return
    }
    if (n.kind === "TypeReference" && isIdentifier(n.child("typeName")!)) {
        const name = n.child("typeName")!.text
        const typeArgs = typeArguments(n)
        if (names.includes(name) && typeArgs.length === 0) {
            if (!bindings.has(name)) bindings.set(name, type)
            return
        }
        if (name === "Array" && typeArgs.length === 1) {
            if (type.kind === "array") inferFrom(c, typeArgs[0], type.elem, names, bindings, scope)
            return
        }
        if (name === "Map" && typeArgs.length === 2 && type.kind === "map") {
            inferFrom(c, typeArgs[0], type.key, names, bindings, scope)
            inferFrom(c, typeArgs[1], type.value, names, bindings, scope)
            return
        }
        if (name === "Set" && typeArgs.length === 1 && type.kind === "set") {
            inferFrom(c, typeArgs[0], type.elem, names, bindings, scope)
            return
        }
        const symbol = scope.lookupType(name)
        const generic = symbol === null ? null : symbol.generic
        if (typeArgs.length === 0 || generic === null) return
        const instance = c.instanceOf.get(type)
        if (instance !== null && instance.generic === generic) {
            for (let i = 0; i < typeArgs.length; i++)
                if (i < instance.args.length) inferFrom(c, typeArgs[i], instance.args[i], names, bindings, scope)
        } else if (generic.decl.kind === "TypeAliasDeclaration") {
            // A generic alias: infer its parameters from its definition, then match its type arguments.
            const inner = generic.params.map((p) => nameNode(p).text)
            const found = new Map<string, Type>()
            inferFrom(c, typeNode(generic.decl)!, type, inner, found, generic.scope)
            for (let i = 0; i < typeArgs.length; i++) {
                const t = i < inner.length ? found.get(inner[i]) : null
                if (t !== null) inferFrom(c, typeArgs[i], t, names, bindings, scope)
            }
        } else if (
            generic.decl.kind === "InterfaceDeclaration" &&
            (type.kind === "struct" || type.kind === "interface")
        ) {
            // A class or object for a generic interface: infer the interface's
            // parameters from the members it has, then match its type arguments.
            const inner = generic.params.map((p) => nameNode(p).text)
            const found = new Map<string, Type>()
            for (const member of members(generic.decl)) {
                const memberName = member.child("name")
                if (memberName === null || !isIdentifier(memberName)) continue
                const mname = memberName.text
                const annotation = typeNode(member)
                if (member.kind === "PropertySignature" && annotation !== null) {
                    const field = fieldType(type, mname)
                    if (field !== null) inferFrom(c, annotation, field, inner, found, generic.scope)
                } else if (member.kind === "MethodSignature") {
                    const method = methodType(type, mname)
                    if (method === null) continue
                    const params = parameters(member)
                    for (let i = 0; i < params.length; i++) {
                        const pt = typeNode(params[i])
                        if (pt !== null && i < method.params.length)
                            inferFrom(c, pt, method.params[i], inner, found, generic.scope)
                    }
                    if (annotation !== null) inferFrom(c, annotation, method.result, inner, found, generic.scope)
                }
            }
            for (let i = 0; i < typeArgs.length; i++) {
                const t = i < inner.length ? found.get(inner[i]) : null
                if (t !== null) inferFrom(c, typeArgs[i], t, names, bindings, scope)
            }
        }
        return
    }
    if (n.kind === "UnionType") {
        // Members without type parameters are matched exactly; the rest of the type goes to the one generic member.
        const all = typeNodes(n)
        const open = all.filter((t) => mentions(t, names))
        if (open.length !== 1) return
        const closed: (Type | null)[] = []
        for (const t of all) if (!mentions(t, names)) closed.push(c.resolveType(t, scope))
        const rest = membersOf(type).filter((m) => !closed.some((x) => x !== null && sameType(x, m)))
        if (rest.length > 0) inferFrom(c, open[0], c.unionOf(rest), names, bindings, scope)
        return
    }
    if (n.kind === "TypeLiteral") {
        for (const member of members(n)) {
            const annotation = typeNode(member)
            const memberName = member.child("name")
            if (
                member.kind === "PropertySignature" &&
                annotation !== null &&
                memberName !== null &&
                isIdentifier(memberName)
            ) {
                const field = fieldType(type, memberName.text)
                if (field !== null) inferFrom(c, annotation, field, names, bindings, scope)
            }
        }
    }
}

/** The result of a generic call: the instance and the operands already checked. */
export class GenericCall {
    constructor(
        readonly instance: Instance,
        readonly operands: Operand[],
        /** With spread tuples: the arguments per position, and the locals that hold them (see `Expanded`). */
        readonly expanded: Expanded | null = null,
    ) {}

    /** The arguments, one per position. */
    args(given: Node[]): Node[] {
        const expanded = this.expanded
        return expanded !== null ? expanded.nodes : given
    }

    /** The call, after the locals that hold its arguments. */
    bind(call: Operand): Operand {
        const expanded = this.expanded
        return expanded !== null ? bindAround(expanded.locals, call) : call
    }

    /** The receiver of a method call, held before the arguments. */
    self(given: Expr): Expr {
        const expanded = this.expanded
        const receiver = expanded !== null ? expanded.receiver : null
        return receiver !== null ? receiver : given
    }
}

/** Whether an argument is a function literal for a parameter such as `f: (x: T) => U`, checked after the others. */
function deferred(arg: Node, p: Node | null, names: string[]): bool {
    return (
        (arg.kind === "ArrowFunction" || arg.kind === "FunctionExpression") &&
        p !== null &&
        p.kind === "FunctionType" &&
        mentions(p, names)
    )
}

/**
 * Checks a call of a generic function or constructor: arguments are checked
 * first (with their parameter type when it has no type parameters), then the
 * type arguments are taken from `typeArgs` or inferred.
 */
export function genericCall(
    c: Checker,
    generic: Generic,
    params: Node[],
    typeArgs: Node[],
    given: Node[],
    node: Node,
    scope: Scope,
    receiver: Expr | null = null,
    expected: Type | null = null,
): GenericCall | null {
    const names = generic.params.map((p) => nameNode(p).text)
    // Spread tuples are taken apart first, unless the type arguments are given: then the call checks them.
    let args = given
    let expanded: Expanded | null = null
    const held: (Operand | null)[] = []
    if (typeArgs.length === 0 && given.some((arg) => arg.kind === "SpreadElement")) {
        const typeAt = (i: int): Type | null => {
            const p = i < params.length ? typeNode(params[i]) : null
            return p !== null && !mentions(p, names) ? c.resolveType(p, generic.scope) : null
        }
        const found = expandArgs(c, given, scope, typeAt, receiver)
        if (found === null) return null
        expanded = found
        args = found.nodes
        for (const o of found.operands) held.push(o)
    }
    if (typeArgs.length > 0) {
        // With explicit type arguments, the arguments are checked against the instance.
        const explicit: Type[] = []
        for (const t of typeArgs) {
            const type = c.resolveTypeArgument(t, scope)
            if (type === null) return null
            explicit.push(type)
        }
        const instance = instantiate(c, generic, explicit, node)
        return instance !== null ? new GenericCall(instance, []) : null
    }
    // Function literals for parameters such as `f: (x: T) => U` come last: the
    // other arguments bind the types of their parameters (`T`), and their
    // results bind the rest (`U`).
    const found: (Operand | null)[] = []
    for (let i = 0; i < args.length; i++) {
        const p = i < params.length ? typeNode(params[i]) : null
        const o = i < held.length ? held[i] : null
        if (o !== null) {
            found.push(o)
            continue
        }
        if (deferred(args[i], p, names)) {
            found.push(null)
            continue
        }
        const expected = p !== null && !mentions(p, names) ? c.resolveType(p, generic.scope) : null
        // An array literal for a tuple parameter such as `[A, B]` is a tuple of its elements' types.
        const tuple =
            expected === null &&
            p !== null &&
            p.kind === "TupleType" &&
            args[i].kind === "ArrayLiteralExpression" &&
            elements(args[i]).length === p.list("elements").length &&
            elements(args[i]).every((e) => e.kind !== "SpreadElement")
        found.push(tuple ? checkTupleOf(c, args[i], scope) : checkExpr(c, args[i], scope, expected))
    }
    const bindings = new Map<string, Type>()
    for (let i = 0; i < args.length; i++) bindArg(c, generic, params, found, i, names, bindings)
    for (let i = 0; i < args.length; i++) {
        const arg = args[i]
        const p = i < params.length ? typeNode(params[i]) : null
        if (found[i] !== null || !deferred(arg, p, names)) continue
        const fn = p!
        const unbound = names.filter((n) => !bindings.has(n))
        const known = new Scope(generic.scope)
        for (const [n, t] of bindings) known.declareType(n, new TypeSymbol(t, fn))
        const paramTypes: (Type | null)[] = []
        for (const q of parameters(fn)) {
            const qt = typeNode(q)
            paramTypes.push(qt !== null && !mentions(qt, unbound) ? c.resolveType(qt, known) : null)
        }
        if (paramTypes.some((t) => t === null)) {
            found[i] = checkExpr(c, arg, scope)
        } else {
            const resultKnown = !mentions(typeNode(fn)!, unbound)
            const result = resultKnown ? (c.resolveType(typeNode(fn)!, known) ?? types.void) : types.void
            const resolvedParams: Type[] = []
            for (const t of paramTypes) resolvedParams.push(t!)
            found[i] = checkClosure(c, arg, scope, new FuncType(resolvedParams, result), !resultKnown)
            // A void callback for a result that is a type parameter binds it to void: the
            // callback is checked again to return null, the value of a void type argument.
            const first = found[i]!
            const resultName = typeNode(fn)!
            if (
                !resultKnown &&
                first.k === "typed" &&
                first.expr.k === "closure" &&
                first.expr.type.result.kind === "void" &&
                resultName.kind === "TypeReference" &&
                isIdentifier(typeName(resultName)) &&
                names.includes(typeName(resultName).text)
            ) {
                const dropped = first.expr.func
                c.module.functions = c.module.functions.filter((f) => f !== dropped)
                const again = checkClosure(c, arg, scope, new FuncType(resolvedParams, types.null), false)
                if (again.k === "typed") c.voidCallbacks.add(again.expr.type)
                found[i] = again
            }
        }
        bindArg(c, generic, params, found, i, names, bindings)
    }
    const operands: Operand[] = []
    for (const o of found) operands.push(o!)
    if (operands.some((o) => o.k === "error")) return null
    const argTypes: (Type | null)[] = []
    for (const o of operands) argTypes.push(o.k === "typed" ? o.expr.type : o.k === "error" ? null : c.defaultType(o))
    for (let i = 0; i < operands.length && i < params.length; i++) {
        const literal = literalArgument(c, generic, typeNode(params[i]), operands[i], bindings)
        if (literal !== null) argTypes[i] = literal
    }
    const typeArgsResolved = inferTypeArgs(c, generic, params, argTypes, node, expected)
    if (typeArgsResolved === null) return null
    const instance = instantiate(c, generic, typeArgsResolved, node)
    return instance !== null ? new GenericCall(instance, operands, expanded) : null
}

/**
 * The string literal type that a string constant argument has for a
 * parameter typed by a type parameter constrained to string literal types,
 * as `"b"` for `k: K` with `K extends keyof T`; null for other arguments.
 */
function literalArgument(
    c: Checker,
    generic: Generic,
    p: Node | null,
    arg: Operand,
    bindings: Map<string, Type>,
): Type | null {
    if (p === null || p.kind !== "TypeReference" || typeArguments(p).length > 0) return null
    if (arg.k !== "typed" || arg.expr.k !== "string") return null
    const value = arg.expr.value
    const name = c.text(p.child("typeName")!)
    let param: Node | null = null
    for (const q of generic.params) if (nameNode(q).text === name) param = q
    const bound = param !== null ? constraint(param) : null
    if (bound === null) return null
    // The constraint can name the other parameters: `keyof T`.
    const known = new Scope(generic.scope)
    for (const [n, t] of bindings) if (n !== name) known.declareType(n, new TypeSymbol(t, p))
    const errors = c.diagnostics.length
    const resolved = c.resolveType(bound, known)
    while (c.diagnostics.length > errors) c.diagnostics.pop()
    if (resolved === null) return null
    for (const m of membersOf(resolved)) if (m.kind === "literal" && m.value === value) return m
    return null
}

/** Binds the type parameters mentioned by the parameter of argument `i` from the argument's type. */
function bindArg(
    c: Checker,
    generic: Generic,
    params: Node[],
    found: (Operand | null)[],
    i: int,
    names: string[],
    bindings: Map<string, Type>,
) {
    const o = found[i]
    const p = i < params.length ? typeNode(params[i]) : null
    if (o !== null && o.k !== "error" && p !== null)
        inferFrom(c, p, o.k === "typed" ? o.expr.type : c.defaultType(o), names, bindings, generic.scope)
}

/**
 * Resolves parameters into locals; parameter properties are allowed only by
 * the caller. Optional (`x?: T`, `x = value`) and rest (`...xs: T[]`)
 * parameters are recorded in `signatures`.
 */
export function resolveParams(c: Checker, params_: Node[], scope: Scope, properties: bool = false): Local[] {
    const params: Local[] = []
    // `public x`, `readonly x`: only a constructor's parameters declare fields.
    if (!properties)
        for (const p of params_) {
            const mods = modifiers(p)
            if (mods.length > 0) c.error(mods[0], "A parameter property is only allowed in a constructor.")
        }
    // Default values may use the parameters before them: each parameter is
    // declared in a scope of its own, so a value checked later sees only those.
    let defaults = new Scope(scope)
    let required = -1
    let rest = false
    for (let i = 0; i < params_.length; i++) {
        const p = params_[i]
        let type: Type | null = null
        let early = false
        const annotation = typeNode(p)
        const init = initializer(p)
        if (annotation !== null) type = c.resolveValueType(annotation, scope)
        else if (init !== null) {
            const saved = c.constructedEarly
            const before = c.diagnostics.length
            c.constructedEarly = false
            const value = checkDefault(c, init, defaults, null)
            if (value !== null) type = value.type
            // A value that constructs a class declared further down has the class's
            // type; its diagnostics come from checking it again with that type.
            early = c.constructedEarly && value !== null
            if (early) while (c.diagnostics.length > before) c.diagnostics.pop()
            c.constructedEarly = saved
        } else c.error(nameNode(p), `Parameter '${c.text(nameNode(p))}' must have a type annotation.`)
        // A value with a declared type is checked once every declaration is known,
        // since it may construct a class or use a constant declared further down.
        if (type !== null && (annotation !== null || early) && init !== null) {
            const before = defaults
            const declared = type
            c.pending.push(() => {
                checkDefault(c, init, before, declared)
            })
        }
        const question = questionToken(p)
        if (type !== null && question !== null) type = c.unionOf([type, types.null])
        if (dotDotDotToken(p) !== null) {
            if (i !== params_.length - 1) c.error(p, "A rest parameter must be the last parameter.")
            else if (type !== null && type.kind !== "array")
                c.error(annotation ?? p, "A rest parameter must have an array type.")
            else rest = true
        }
        if (init !== null && question !== null)
            c.error(question, "A parameter with a default value is already optional.")
        const optional = init !== null || question !== null || (dotDotDotToken(p) !== null && i === params_.length - 1)
        if (optional && required === -1) required = i
        if (!optional && required !== -1)
            c.error(p, "A required parameter cannot follow an optional or rest parameter.")
        if (type !== null) c.info.types.set(nameNode(p), type)
        const local = c.newLocal(paramName(p, i), type ?? types.i64, true)
        params.push(local)
        if (isIdentifier(nameNode(p))) {
            defaults = new Scope(defaults)
            defaults.declareValue(local.name, new LocalSymbol(local, p))
        }
    }
    if (required !== -1) c.signatures.set(params, new Signature(params_, scope, required, rest))
    return params
}

/** Checks a default parameter value, for its type and errors; the value is created again at each call. */
export function checkDefault(c: Checker, node: Node, scope: Scope, type: Type | null): Expr | null {
    const savedFn = c.fn
    const savedFacts = c.facts
    if (c.fn === null) c.fn = new FuncContext(types.void, [], 0)
    c.facts = [new Map<string, Type>()]
    const value = checkExpr(c, node, scope, type)
    let result: Expr | null = null
    if (value.k !== "error") result = type !== null ? c.coerce(value, type, node) : c.toDefault(value, node)
    c.fn = savedFn
    c.facts = savedFacts
    return result
}

/**
 * A scope with the parameters of a function declared. The names of
 * destructured parameters are declared by statements added to `prologue`,
 * which go before the body.
 */
export function paramScope(c: Checker, params_: Node[], locals: Local[], outer: Scope, prologue: Stmt[]): Scope {
    const scope = new Scope(outer)
    for (let i = 0; i < params_.length; i++) {
        const p = params_[i]
        if (i >= locals.length) continue
        const local = locals[i]
        const name = nameNode(p)
        if (isIdentifier(name)) {
            if (!scope.declareValue(local.name, new LocalSymbol(local, p)))
                c.error(name, `Duplicate parameter '${local.name}'.`)
        } else {
            bindPattern(c, name, new LocalRef(local.type, local), true, scope, prologue)
        }
    }
    return scope
}

/** `prologue` followed by `body`: `body.unshift(...prologue)`. */
export function prepend(prologue: Stmt[], body_: Stmt[]): Stmt[] {
    if (prologue.length === 0) return body_
    const out: Stmt[] = []
    for (const s of prologue) out.push(s)
    for (const s of body_) out.push(s)
    return out
}

/** Whether the statements of a naked function branch only on conditions known at compile time. */
function constantBranches(st: Stmt): bool {
    if (st.k === "block") return st.body.every(constantBranches)
    if (st.k === "if") {
        const otherwise = st.else
        return st.cond.k === "bool" && constantBranches(st.then) && (otherwise === null || constantBranches(otherwise))
    }
    return true
}

export function checkFunctionBody(c: Checker, decl: Node, func: Func, outer: Scope) {
    const prologue: Stmt[] = []
    const scope = paramScope(c, parameters(decl), func.params, outer, prologue)
    c.facts = [new Map<string, Type>()]
    c.fn = new FuncContext(func.type.result, [], 0)
    func.body = checkBlock(c, body(decl)!, scope)
    func.body.body = prepend(prologue, func.body.body)
    c.fn = null
    checkReturns(c, func, typeNode(decl) ?? nameNode(decl))
    // Without a frame, a naked function can branch only on what is known at compile time.
    const attributes = func.attributes
    if (attributes !== null && attributes.naked) {
        if (!func.body.body.every(constantBranches))
            c.error(
                nameNode(decl),
                "A '//ore:naked' function can branch only on conditions known at compile time, such as 'target.arch'.",
            )
    }
}

export function checkReturns(c: Checker, func: Func, node: Node) {
    const result = func.type.result
    // A naked function returns from its assembly.
    const attributes = func.attributes
    const naked = attributes !== null && attributes.naked
    // A function returning null may end without a return, as TypeScript's undefined-returning ones.
    if (result.kind === "null" && !naked && !terminates(func.body)) {
        func.body.body.push(new ReturnStmt(new NullLit(types.null)))
        return
    }
    if (result.kind !== "void" && !naked && !terminates(func.body)) {
        c.error(
            node,
            `Function '${func.sourceName}' must return a value of type '${typeToString(result)}' on every path.`,
        )
    }
}

/** A constant of a top-level `const` statement, before it is declared. */
class ConstantDecl {
    constructor(
        readonly name: Node,
        readonly value: Operand,
        readonly type: Type | null,
        readonly decl: Node,
    ) {}
}

/**
 * Declares the constants of a top-level `const` statement whose initializers
 * are made of literals and constants. Returns false, declaring nothing, when
 * a value is not a constant after all, such as a literal converted to a
 * union: the statement then declares global variables.
 */
export function checkTopLevelConstants(c: Checker, stmt: Node, scope: Scope): bool {
    const errors = c.diagnostics.length
    const constants: ConstantDecl[] = []
    for (const decl of declarations(declarationList(stmt))) {
        const annotation = typeNode(decl)
        const declared = annotation !== null ? c.resolveValueType(annotation, scope) : c.jsonTypes.get(decl)
        const init = initializer(decl)!
        let value = checkExpr(c, init, scope)
        if (declared !== null) value = new Typed(c.coerce(value, declared, init))
        constants.push(new ConstantDecl(nameNode(decl), value, declared, decl))
    }
    let nonLiteral = false
    for (const k of constants) if (k.value.k === "typed" && !isLiteral(k.value.expr)) nonLiteral = true
    if (c.diagnostics.length === errors && nonLiteral) return false
    for (const k of constants) {
        if (!scope.declareValue(k.name.text, new ConstSymbol(k.value, k.type, k.decl)))
            c.duplicate(scope, k.name.text, k.name, `Duplicate declaration '${k.name.text}'.`)
    }
    return true
}

/**
 * Reports the names that strict mode reserves (`private`, `static`, `let`...)
 * where they declare a binding, as TypeScript does: Ore modules are always
 * in strict mode. Property names may be any word, reserved or not.
 */
export function checkStrictNames(c: Checker, node: Node, inClass: bool) {
    const k = node.kind
    const named =
        k === "Parameter" ||
        k === "VariableDeclaration" ||
        k === "BindingElement" ||
        k === "FunctionDeclaration" ||
        k === "FunctionExpression" ||
        k === "ClassDeclaration"
    const nested = inClass || k === "ClassDeclaration"
    const name = named ? node.child("name") : null
    if (name !== null && name.kind === "Identifier" && strictReserved.includes(name.text)) {
        const reason = nested
            ? "Class definitions are automatically in strict mode."
            : "Modules are automatically in strict mode."
        c.error(name, `Identifier expected. '${name.text}' is a reserved word in strict mode. ${reason}`)
    }
    for (const child of node.children) checkStrictNames(c, child, nested)
}

export function unsupportedTopLevel(stmt: Node): string {
    if (stmt.kind === "EnumDeclaration") return "Enums are not supported in Ore. Use a union of literal types."
    if (stmt.kind === "ModuleDeclaration") return "Namespaces are not supported in Ore. Use modules."
    return "This declaration is not supported at the top level."
}

import { ExportEntry, FuncContext, InstanceInfo } from "./context"
import { StringLit } from "../ir/nodes"
