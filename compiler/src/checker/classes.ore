    StringLit,
} from "../ir/nodes"
import {
    type InterfaceMember,
    type InterfaceType,
    type StructType,
    type Type,
    Field,
    FuncType,
    InterfaceField,
    InterfaceMethod,
    InterfaceType as InterfaceTypeClass,
    Method,
    StructType as StructTypeClass,
    findField,
    findMethod,
    isSubclass,
    overridden,
    sameType,
    types,
    typeToString,
    membersOf,
} from "../ir/types"
import { type Node } from "../syntax/ast"
import {
    defaultType as defaultTypeNode,
    asteriskToken,
    body,
    exclamationToken,
    expression,
    hasModifier,
    heritageClauses,
    heritageToken,
    initializer,
    isIdentifier,
    left,
    members,
    modifiers,
    nameNode,
    operatorToken,
    parameters,
    questionToken,
    statements,
    typeNode,
    typeArguments,
    typeParameters,
    whenFalse,
    whenTrue,
    types as typeNodes,
} from "../syntax/nodes"
import { checkAsyncBody, isAsync, promiseValue } from "./async"
import { checkGeneratorBody, isGenerator } from "./generators"
import { type Checker } from "./base"
import {
    type InterfaceInfo,
    Accessor,
    ClassInfo,
    Dispatch,
    FieldInitInfo,
    GenericMethod,
    InterfaceInfo as InterfaceInfoClass,
    MemberFlags,
    MethodInfo,
    FuncContext,
    StaticMember,
} from "./context"
import {
    applyFuncDirectives,
    checkFunctionBody,
    declareGeneric,
    instantiate,
    makeFunc,
    resultType,
    paramScope,
    prepend,
    resolveParams,
    checkReturns,
    typeNames,
} from "./declarations"
import { checkExpr, settle } from "./expressions"
import { cIdent, findThis, hasZeroValue, indexSignatureMessage, terminates, zeroNeedsInit, zeroValue } from "./helpers"
import { assertionReturn, declarePredicate, enterPredicate } from "./predicates"
import { checkBlock } from "./statements"
import { type Generic, type Instance, ClassSymbol, Generic as GenericClass, Scope, TypeSymbol } from "./symbols"

export function declareClass(c: Checker, decl: Node, scope: Scope) {
    const nameId = decl.child("name")
    if (nameId === null) {
        c.error(decl, "A class declaration must have a name.")
        return
    }
    const name = nameId.text
    if (typeParameters(decl).length > 0) {
        declareGeneric(c, decl, scope)
        return
    }
    for (const mod of modifiers(decl)) {
        if (mod.kind !== "ExportKeyword" && mod.kind !== "AbstractKeyword")
            c.error(mod, `Modifier '${c.text(mod)}' is not allowed on classes.`)
    }
    const type = new StructTypeClass(c.nextStructId++, name, true, [], [])
    if (
        !scope.declareType(name, new TypeSymbol(type, decl)) ||
        !scope.declareValue(name, new ClassSymbol(type, decl))
    ) {
        c.duplicate(scope, name, nameId, `Duplicate declaration '${name}'.`)
        return
    }
    c.module.structs.push(type)
    c.memberDecls.set(type, new Map<string, Node>())
    c.classes.push(classInfo(c, decl, type, scope, c.prefix + cIdent(name)))
}

/** The state of a class or generic class instance between the passes, registered by its type. */
export function classInfo(c: Checker, decl: Node, type: StructType, scope: Scope, cname: string): ClassInfo {
    const info = new ClassInfo(decl, type, scope, cname, [], [], c.newLocal("this", type, false), [])
    info.abstract = hasModifier(decl, "AbstractKeyword")
    c.classInfos.set(type.id, info)
    return info
}

/** Resolves the `extends` clause of a class into `type.base`, once; a class cannot extend itself. */
export function resolveBase(c: Checker, info: ClassInfo) {
    if (info.baseState !== "none") return
    info.baseState = "resolving"
    for (const clause of heritageClauses(info.decl)) {
        if (heritageToken(clause, c.sourceOf(info.decl).text) !== "extends") continue
        const refs = typeNodes(clause)
        if (refs.length !== 1) {
            c.error(clause, "Classes can only extend a single class.")
            continue
        }
        const ref = refs[0]
        const base = baseClass(c, ref, info.scope)
        if (base === null) continue
        resolveBase(c, c.classInfos.get(base.id)!)
        if (isSubclass(base, info.type)) {
            c.error(ref, `Class '${info.type.name}' extends itself.`)
            continue
        }
        info.type.base = base
    }
    info.baseState = "done"
}

/** The class named by an `extends` clause: a class, or an instance of a generic class. */
function baseClass(c: Checker, ref: Node, scope: Scope): StructType | null {
    const target = expression(ref)
    const symbol = c.typeSymbol(target, scope)
    if (symbol === null) return null
    let type: Type | null = symbol.type
    const generic = symbol.generic
    const typeArgs = typeArguments(ref)
    if (generic !== null) {
        if (typeArgs.length === 0 && defaultTypeNode(generic.params[0]) === null) {
            c.error(ref, `Generic type '${generic.name}' requires type arguments.`)
            return null
        }
        const resolved: Type[] = []
        for (const a of typeArgs) {
            const arg = c.resolveTypeArgument(a, scope)
            if (arg === null) return null
            resolved.push(arg)
        }
        const instance = instantiate(c, generic, resolved, ref)
        type = instance === null || instance instanceof Func ? null : instance
    } else if (typeArgs.length > 0) {
        c.error(ref, `Type '${c.text(target)}' is not generic.`)
        return null
    }
    if (type !== null && type.kind === "struct" && c.classInfos.has(type.id)) return type
    if (type !== null) c.error(target, "A class can only extend a class.")
    return null
}

export function declareClassMembers(c: Checker, info: ClassInfo, scope: Scope) {
    if (info.members !== "pending") return
    info.members = "declaring"
    const decl = info.decl
    const type = info.type
    resolveBase(c, info)
    const base = type.base
    const baseInfo = base === null ? null : c.classInfos.get(base.id)
    if (baseInfo !== null) {
        declareClassMembers(c, baseInfo, baseInfo.scope)
        if (baseInfo.members !== "done") {
            // The base class is a generic instance whose members are being
            // declared and refer to this class: declare these after them.
            info.members = "pending"
            baseInfo.waiting.push(info)
            return
        }
    }
    const className = type.name!
    const decls = c.memberDecls.get(type)!
    // The non-static members see the type `this` as the class.
    const instanceScope = thisScope(scope, type, decl)
    // The members of the base class come first, in its order.
    const inherited = new Map<string, bool>()
    if (base !== null) {
        for (const f of base.fields) type.fields.push(f)
        for (const m of base.methods) type.methods.push(m)
        for (const [name, node] of c.memberDecls.get(base)!) {
            decls.set(name, node)
            inherited.set(name, true)
        }
    }
    const own = new Map<string, bool>()
    const declare = (name: string, node: Node, nameAt: Node): bool => {
        if (own.has(name) || (decls.has(name) && !inherited.has(name))) {
            c.error(nameAt, `Duplicate member '${name}'.`)
            return false
        }
        own.set(name, true)
        decls.set(name, node)
        return true
    }

    for (const member of members(decl)) {
        if (member.kind === "SemicolonClassElement") continue
        const flags = memberModifiers(c, member)
        if (flags.isStatic) {
            declareStatic(c, info, member, flags, scope)
            continue
        }
        if (flags.isAbstract && member.kind !== "MethodDeclaration") c.error(member, "Only methods can be abstract.")
        if (member.kind === "PropertyDeclaration") {
            const name = c.memberName(nameNode(member))
            if (
                name === null ||
                !checkInherited(c, info, name, "field", nameNode(member), flags) ||
                !declare(name, member, nameNode(member))
            )
                continue
            const question = questionToken(member)
            const exclamation = exclamationToken(member)
            if (exclamation !== null) c.error(exclamation, "Definitely-assigned fields are not supported.")
            let fieldType: Type | null = null
            const annotation = typeNode(member)
            const init = initializer(member)
            if (annotation !== null) fieldType = c.resolveValueType(annotation, instanceScope)
            else if (question !== null) c.error(nameNode(member), `Optional field '${name}' needs a type annotation.`)
            else if (init === null)
                c.error(nameNode(member), `Field '${name}' needs a type annotation or an initializer.`)
            // `x?: T` is `T | null`, null unless initialized.
            if (fieldType !== null && question !== null) fieldType = c.unionOf([fieldType, types.null])
            if (init !== null) info.inits.push(new FieldInitInfo(name, init))
            // A field without an annotation gets its type from the initializer later.
            type.fields.push(
                new Field(name, fieldType ?? types.void, flags.isReadonly, flags.isPrivate || flags.isProtected),
            )
            if (flags.isProtected) info.protected.set(name, true)
            if (fieldType !== null) c.info.types.set(nameNode(member), fieldType)
        } else if (member.kind === "MethodDeclaration") {
            const name = c.memberName(nameNode(member))
            if (name === null) continue
            const typeParams = typeParameters(member)
            if (
                !checkInherited(
                    c,
                    info,
                    name,
                    typeParams.length > 0 ? "generic method" : "method",
                    nameNode(member),
                    flags,
                ) ||
                !declare(name, member, nameNode(member))
            )
                continue
            if (flags.isReadonly) c.error(member, "Methods cannot be 'readonly'.")
            const asterisk = asteriskToken(member)
            if (asterisk !== null && isAsync(member)) c.error(asterisk, "Async generators are not supported in Ore.")
            const question = questionToken(member)
            if (question !== null) c.error(question, "Optional methods are not supported.")
            if (flags.isAbstract) {
                if (!info.abstract)
                    c.error(nameNode(member), "Abstract methods can only appear within an abstract class.")
                if (body(member) !== null)
                    c.error(
                        nameNode(member),
                        `Method '${name}' cannot have an implementation because it is marked abstract.`,
                    )
                if (typeParams.length > 0) {
                    c.error(nameNode(member), "Generic methods cannot be abstract.")
                    continue
                }
            } else if (body(member) === null) {
                c.error(nameNode(member), "A method must have a body.")
                continue
            }
            // An override's `this` is the type of the class that first declared the method, so that its type
            // stays that of the method it overrides.
            const memberScope = inherited.has(name) ? thisScope(scope, rootClass(base!, name), decl) : instanceScope
            if (typeParams.length > 0) {
                const generic = new GenericClass(name, member, typeParams, memberScope, new Map())
                if (!c.genericMethods.has(type)) c.genericMethods.set(type, new Map<string, GenericMethod>())
                c.genericMethods
                    .get(type)!
                    .set(name, new GenericMethod(generic, info, flags.isPrivate || flags.isProtected))
                if (flags.isProtected) info.protected.set(name, true)
                continue
            }
            const func = makeMethod(
                c,
                member,
                info,
                memberScope,
                `${className}.${name}`,
                `ore_m_${info.cname}_${cIdent(name)}`,
            )
            if (flags.isAbstract) {
                // Never called: the classes that can be instantiated override it.
                const message: Expr = new StringLit(types.string, `abstract method ${className}.${name} called`)
                func.body = new Block([new ExprStmt(new BuiltinCall(types.never, "process.panic", [message]))])
                c.abstractMethods.set(func, type)
            } else {
                info.methods.push(new MethodInfo(member, func))
            }
            if (flags.isProtected) info.protected.set(name, true)
            const method = new Method(name, func, flags.isPrivate || flags.isProtected)
            let index = -1
            for (let i = 0; i < type.methods.length; i++) if (index === -1 && type.methods[i].name === name) index = i
            if (index === -1) type.methods.push(method)
            else {
                checkOverride(c, type.methods[index], method, base!, nameNode(member), flags)
                type.methods[index] = method
            }
        } else if (member.kind === "Constructor") {
            if (info.ctorDecl !== null) {
                c.error(member, "A class can have only one constructor.")
                continue
            }
            if (body(member) === null) {
                c.error(member, "A constructor must have a body.")
                continue
            }
            info.ctorDecl = member
            // Parameters with modifiers declare fields: `constructor(private x: f64)`.
            const params_ = parameters(member)
            const params = resolveParams(c, params_, scope, true)
            for (let i = 0; i < params_.length; i++) {
                const p = params_[i]
                const pflags = memberModifiers(c, p)
                const pname = nameNode(p)
                if (!pflags.any || !isIdentifier(pname) || i >= params.length) continue
                if (!checkInherited(c, info, pname.text, "field", pname, pflags) || !declare(pname.text, p, pname))
                    continue
                type.fields.push(
                    new Field(pname.text, params[i].type, pflags.isReadonly, pflags.isPrivate || pflags.isProtected),
                )
                if (pflags.isProtected) info.protected.set(pname.text, true)
                info.paramProps.push(params[i])
            }
            info.ctorParams = params
            const ctor = ctorFunc(c, info, params, member)
            c.funcDecls.set(ctor, member)
            type.ctor = ctor
        } else if (member.kind === "GetAccessor" || member.kind === "SetAccessor") {
            declareAccessor(c, member, info, instanceScope, flags)
        } else {
            c.error(
                member,
                member.kind === "IndexSignature" ? indexSignatureMessage : "This class member is not supported.",
            )
        }
    }
    if (type.ctor === null && baseInfo !== null) {
        // Without a constructor, a subclass takes the parameters of its base class's and passes them on.
        const params = baseInfo.ctorParams.map((p) => c.newLocal(p.name, p.type, false))
        const signature = c.signatures.get(baseInfo.ctorParams)
        if (signature !== null) c.signatures.set(params, signature)
        info.ctorParams = params
        type.ctor = ctorFunc(c, info, params, nameNode(decl))
    }
    if (type.ctor === null) type.ctor = ctorFunc(c, info, [], nameNode(decl))
    if (!info.abstract) {
        for (const m of type.methods) {
            const owner = c.abstractMethods.get(m.func)
            if (owner !== null && owner !== type)
                c.error(
                    nameNode(decl),
                    `Non-abstract class '${className}' does not implement inherited abstract member '${m.name}' from class '${owner.name}'.`,
                )
        }
    }
    info.members = "done"
    const waiting = info.waiting
    info.waiting = []
    for (const w of waiting) declareClassMembers(c, w, w.scope)
}

/** What a member of a class is, for messages about inherited members. */
type MemberKind = "field" | "method" | "generic method" | "accessor"

/** A member of a class, inherited ones included: its kind, and whether it is private or protected. */
export class ClassMember {
    readonly private: bool
    constructor(
        readonly kind: MemberKind,
        isPrivate: bool,
    ) {
        this.private = isPrivate
    }
}

/**
 * Checks a member of a class against its base class: a method may override
 * a method, other members cannot redeclare inherited ones, and private
 * members of the base class cannot be redeclared at all. Reports `override`
 * on a member that overrides nothing. False if the member is not declared.
 */
function checkInherited(
    c: Checker,
    info: ClassInfo,
    name: string,
    kind: MemberKind,
    nameAt: Node,
    flags: MemberFlags,
): bool {
    const base = info.type.base
    const inherited = base === null ? null : classMember(c, base, name)
    if (flags.isOverride && (kind !== "method" || inherited === null || inherited.kind !== "method")) {
        c.error(
            nameAt,
            base !== null
                ? `This member cannot have an 'override' modifier because it is not declared in the base class '${base.name}'.`
                : `This member cannot have an 'override' modifier because its containing class '${info.type.name}' does not extend another class.`,
        )
    }
    if (base === null || inherited === null) return true
    const owner = declaringClass(c, base, name)
    const ownerInfo = c.classInfos.get(owner.id)
    if (inherited.private && !(ownerInfo !== null && ownerInfo.protected.has(name))) {
        c.error(nameAt, `'${name}' is private in base class '${owner.name}' and cannot be redeclared.`)
        return false
    }
    if (kind === "method" && inherited.kind === "method") return true
    c.error(
        nameAt,
        kind === "accessor" && inherited.kind === "accessor"
            ? `Accessors cannot be overridden yet: '${name}' is an accessor of base class '${base.name}'.`
            : `'${name}' is already declared in base class '${base.name}' as a ${inherited.kind}; only methods can be overridden.`,
    )
    return false
}

/** Checks that a method overrides an inherited one with the same type, and is as visible. */
function checkOverride(c: Checker, old: Method, method: Method, base: StructType, nameAt: Node, flags: MemberFlags) {
    if (!sameType(old.func.type, method.func.type)) {
        c.error(
            nameAt,
            `Method '${method.name}' must have the type of the method it overrides in '${base.name}': '${typeToString(old.func.type)}', not '${typeToString(method.func.type)}'.`,
        )
    } else if (flags.isPrivate) {
        c.error(nameAt, `Method '${method.name}' overrides a method of '${base.name}' and cannot be private.`)
    } else if (flags.isProtected && !old.private) {
        c.error(nameAt, `Method '${method.name}' is public in '${base.name}' and must stay public.`)
    }
}

/** A member of a class, inherited ones included: its kind, and whether it is private or protected. */
export function classMember(c: Checker, s: StructType, name: string): ClassMember | null {
    const field = findField(s, name)
    if (field !== null) return new ClassMember("field", field.private)
    const method = findMethod(s, name)
    if (method !== null) return new ClassMember("method", method.private)
    const generic = genericMethod(c, s, name)
    if (generic !== null) return new ClassMember("generic method", generic.private)
    const found = accessor(c, s, name)
    if (found !== null) return new ClassMember("accessor", found.private)
    return null
}

/** The class that declares member `name` of class `s` first: `s`, or the base class it inherits it from. */
export function declaringClass(c: Checker, s: StructType, name: string): StructType {
    let owner = s
    for (;;) {
        const base = owner.base
        if (base === null || classMember(c, base, name) === null) return owner
        owner = base
    }
}

/** The generic method `name` of a class, inherited ones included. */
export function genericMethod(c: Checker, s: StructType, name: string): GenericMethod | null {
    let t: StructType | null = s
    while (t !== null) {
        const methods = c.genericMethods.get(t)
        const found = methods === null ? null : methods.get(name)
        if (found !== null) return found
        t = t.base
    }
    return null
}

export function ctorFunc(c: Checker, info: ClassInfo, params: Local[], node: Node): Func {
    const func = new Func(
        `ore_new_${info.cname}`,
        `${info.type.name}.constructor`,
        c.line(node),
        new FuncType(
            params.map((p) => p.type),
            info.type,
        ),
        params,
        new Block([]),
        false,
        c.sourceOf(node).path,
    )
    c.module.functions.push(func)
    return func
}

/**
 * The initialization of a class with subclasses, which they call from
 * `super(...)`: it takes the parameters of the constructor, which then
 * gets copies of them, and its body is moved there by `finishClasses`.
 */
export function initOf(c: Checker, info: ClassInfo): Func {
    const existing = info.init
    if (existing !== null) return existing
    const ctor = info.type.ctor!
    const init = new Func(
        `ore_ctor_${info.cname}`,
        `${info.type.name}.constructor`,
        ctor.line,
        new FuncType(ctor.type.params, info.type),
        info.ctorParams,
        new Block([]),
        false,
        c.sourceOf(info.decl).path,
        false,
        null,
        info.ctorThis,
    )
    c.module.functions.push(init)
    const params = info.ctorParams.map((p) => c.newLocal(p.name, p.type, false))
    const signature = c.signatures.get(info.ctorParams)
    if (signature !== null) c.signatures.set(params, signature)
    ctor.params = params
    info.init = init
    return init
}

/**
 * Once every body is checked: the constructor of a class with subclasses
 * allocates the instance and calls its initialization, and the calls of
 * methods that a subclass of the receiver's class overrides dispatch
 * through the class table.
 */
export function finishClasses(c: Checker) {
    for (const [_, info] of c.classInfos) {
        const init = info.init
        const ctor = info.type.ctor
        if (init === null || ctor === null || ctor.body.body.length === 0) continue
        init.body = new Block(ctor.body.body.slice(1))
        const self = c.newLocal("this", info.type, false)
        const ref: Expr = new LocalRef(info.type, self)
        const args: Expr[] = ctor.params.map((p): Expr => new LocalRef(p.type, p))
        ctor.body = new Block([
            new LetStmt(self, new Alloc(info.type)),
            new ReturnStmt(new MethodCall(info.type, init, ref, args)),
        ])
    }
    const bases = new Map<int, bool>()
    for (const s of c.module.structs) {
        const base = s.base
        if (base !== null) bases.set(base.id, true)
    }
    if (bases.size === 0) return
    for (const d of c.dispatches) {
        const s = d.node.receiver.type
        if (s.kind !== "struct" || !bases.has(s.id) || !overridden(c.module.structs, s, d.name)) continue
        const node = d.node
        if (node.k === "method-call") node.virtual = true
        else node.virtual = true
    }
}

/** Records a call or bound value of method `name`, which may need to dispatch. */
export function dispatch(c: Checker, expr: Expr, name: string) {
    const node = expr.k === "bind" ? expr.body : expr
    if (node.k === "method-call") c.dispatches.push(new Dispatch(node, name))
    else if (node.k === "bound-method") c.dispatches.push(new Dispatch(node, name))
}

/**
 * A static member: a field becomes a global, typed by its annotation or else
 * by its initializer where the class is declared (see `initStatics`), and a
 * method a function.
 */
function declareStatic(c: Checker, info: ClassInfo, member: Node, flags: MemberFlags, scope: Scope) {
    const nameAt = member.child("name")
    const name = nameAt !== null ? c.memberName(nameAt) : null
    if (nameAt === null || name === null) {
        c.error(member, "This static member is not supported.")
        return
    }
    if (info.statics.has(name)) {
        c.error(nameAt, `Duplicate static member '${name}'.`)
        return
    }
    if (flags.isAbstract) c.error(member, "Static members cannot be abstract.")
    const hidden = flags.isPrivate || flags.isProtected
    if (flags.isProtected) c.error(member, "Static members cannot be protected; make it private or public.")
    const className = info.type.name ?? ""
    const generic = c.genericsByDecl.get(info.decl)
    if (member.kind === "PropertyDeclaration" && generic !== null) {
        // A static field of a generic class is one global, shared by its instances.
        const shared = genericStaticField(c, member, generic)
        info.statics.set(name, new StaticMember(name, member, info, shared, null, hidden))
        return
    }
    if (member.kind === "PropertyDeclaration") {
        const annotation = typeNode(member)
        const type = annotation !== null ? c.resolveValueType(annotation, scope) : null
        if (annotation === null && initializer(member) === null)
            c.error(nameAt, `Static field '${name}' needs a type annotation or an initializer.`)
        const local = c.newLocal(`${className}.${name}`, type ?? types.void, !flags.isReadonly)
        local.global = true
        c.declNodes.set(local, nameAt)
        if (type !== null) c.info.types.set(nameAt, type)
        else if (initializer(member) !== null) c.untyped.add(local)
        else c.poisoned.add(local)
        info.statics.set(name, new StaticMember(name, member, info, local, null, hidden))
        return
    }
    if (member.kind !== "MethodDeclaration") {
        c.error(member, "Only fields and methods can be static.")
        return
    }
    if (body(member) === null) {
        c.error(nameAt, "A method must have a body.")
        return
    }
    if (typeParameters(member).length > 0) {
        // A generic static method is a generic function in the class's scope (see `instantiate`).
        const generic = new GenericClass(
            `${className}.${name}`,
            member,
            typeParameters(member),
            scope,
            new Map<string, Instance>(),
        )
        const entry = new StaticMember(name, member, info, null, null, hidden)
        entry.generic = generic
        info.statics.set(name, entry)
        return
    }
    const func = makeFunc(c, member, scope, `${className}.${name}`, `${info.cname}_s_${cIdent(name)}`, false)
    applyFuncDirectives(c, member, func)
    info.statics.set(name, new StaticMember(name, member, info, null, func, hidden))
}

/** The static member `name` of a class or of its base classes. */
export function staticMember(c: Checker, info: ClassInfo, name: string): StaticMember | null {
    const own = info.statics.get(name)
    if (own !== null) return own
    const base = info.type.base
    const baseInfo = base === null ? null : c.classInfos.get(base.id)
    return baseInfo === null ? null : staticMember(c, baseInfo, name)
}

/**
 * The global of static field `member` of generic class `generic`, made on
 * first use: one for all instances, as in TypeScript, so its type cannot
 * name the class's type parameters.
 */
export function genericStaticField(c: Checker, member: Node, generic: Generic): Local {
    const known = c.genericStaticFields.get(member)
    if (known !== null) return known
    const nameAt = member.child("name")!
    const name = nameAt.text
    const annotation = typeNode(member)
    let type: Type | null = null
    let poisoned = false
    if (annotation !== null) {
        const names: string[] = []
        typeNames(annotation, names)
        for (const p of generic.params) {
            if (!poisoned && names.includes(nameNode(p).text)) {
                c.error(annotation, "Static members cannot reference class type parameters.")
                poisoned = true
            }
        }
        if (!poisoned) type = c.resolveValueType(annotation, generic.scope)
        if (type === null) poisoned = true
    }
    const local = c.newLocal(`${generic.name}.${name}`, type ?? types.void, !hasModifier(member, "ReadonlyKeyword"))
    local.global = true
    c.declNodes.set(local, nameAt)
    if (type !== null) c.info.types.set(nameAt, type)
    else if (!poisoned && initializer(member) !== null) c.untyped.add(local)
    else {
        if (!poisoned) c.error(nameAt, `Static field '${name}' needs a type annotation or an initializer.`)
        c.poisoned.add(local)
    }
    c.genericStaticFields.set(member, local)
    return local
}

/** The top-level code of a class declaration: its static fields, initialized in order. */
export function initStatics(c: Checker, decl: Node, scope: Scope, out: Stmt[]) {
    const generic = c.genericsByDecl.get(decl)
    if (generic !== null) {
        for (const member of members(decl)) {
            if (member.kind !== "PropertyDeclaration" || !hasModifier(member, "StaticKeyword")) continue
            const nameAt = member.child("name")
            if (nameAt === null || !isIdentifier(nameAt)) continue
            initStatic(c, genericStaticField(c, member, generic), member, nameAt.text, scope, out)
        }
        return
    }
    let info: ClassInfo | null = null
    for (const i of c.classes) if (i.decl === decl) info = i
    if (info === null) return
    for (const [_, member] of info.statics) {
        const local = member.local
        if (local !== null) initStatic(c, local, member.decl, member.name, scope, out)
    }
}

/** Initializes the global of static field `decl`: by its initializer, else by its type's zero value. */
function initStatic(c: Checker, local: Local, decl: Node, name: string, scope: Scope, out: Stmt[]) {
    if (c.poisoned.has(local)) return
    const init = initializer(decl)
    let value: Expr | null = null
    if (init !== null) {
        const typed_ = !c.untyped.has(local)
        const operand = checkExpr(c, init, scope, typed_ ? local.type : null)
        if (!typed_ && !settle(c, local, operand, init)) return
        if (operand.k !== "error") value = c.coerce(operand, local.type, init)
    } else if (hasZeroValue(local.type)) {
        value = zeroValue(local.type)
    } else {
        c.error(
            decl.child("name")!,
            `Static field '${name}' of type '${typeToString(local.type)}' needs an initializer.`,
        )
    }
    if (value !== null) out.push(new LetStmt(local, value))
}

export function memberModifiers(c: Checker, node: Node): MemberFlags {
    const flags = new MemberFlags()
    for (const mod of modifiers(node)) {
        flags.any = true
        switch (mod.kind) {
            case "PrivateKeyword":
                flags.isPrivate = true
                break
            case "ProtectedKeyword":
                flags.isProtected = true
                break
            case "ReadonlyKeyword":
                flags.isReadonly = true
                break
            case "AbstractKeyword":
                flags.isAbstract = true
                break
            case "OverrideKeyword":
                flags.isOverride = true
                break
            case "PublicKeyword":
                break
            case "StaticKeyword":
                flags.isStatic = true
                break
            case "AsyncKeyword":
                break
            default:
                c.error(mod, `Modifier '${c.text(mod)}' is not allowed here.`)
        }
    }
    return flags
}

/** Checks field initializers and infers the types of fields without annotations. */
export function checkFieldInitializers(c: Checker, info: ClassInfo, scope: Scope) {
    if (info.initsChecked) return
    info.initsChecked = true
    const base = info.type.base
    const baseInfo = base === null ? null : c.classInfos.get(base.id)
    if (base !== null && baseInfo !== null) {
        // The inherited fields whose types come from their initializers.
        checkFieldInitializers(c, baseInfo, baseInfo.scope)
        for (let i = 0; i < base.fields.length; i++) info.type.fields[i] = base.fields[i]
    }
    // Initializers run before the constructor body but cannot use `this`.
    c.facts = [new Map<string, Type>()]
    c.fn = new FuncContext(types.void, [], 0, null, null, null, null, false, true)
    for (const init of info.inits) {
        let index = -1
        for (let i = 0; i < info.type.fields.length; i++)
            if (index === -1 && info.type.fields[i].name === init.name) index = i
        const field = info.type.fields[index]
        const declared = field.type.kind === "void" ? null : field.type
        const value = checkExpr(c, init.node, scope, declared)
        if (declared !== null) init.value = c.coerce(value, declared, init.node)
        else if (value.k !== "error") {
            const expr = c.toDefault(value, init.node)
            init.value = expr
            info.type.fields[index] = new Field(field.name, expr.type, field.readonly, field.private)
            const decl = c.memberDecls.get(info.type)!.get(init.name)!
            c.info.types.set(nameNode(decl), expr.type)
        }
    }
    c.fn = null
}

export function checkClassBodies(c: Checker, info: ClassInfo, outer: Scope) {
    for (const [_, member] of info.statics) {
        const func = member.func
        if (func === null) continue
        c.staticClass = info.type.name
        checkFunctionBody(c, member.decl, func, outer)
        c.staticClass = null
    }
    const type = info.type
    const ctor = type.ctor!
    const self = info.ctorThis
    const thisRef: Expr = new LocalRef(type, self)
    const base = type.base
    const baseInfo = base === null ? null : c.classInfos.get(base.id)

    // Constructor: allocate, assign parameter properties, run field initializers, then the body.
    // With a base class, `super(...)` initializes the base class, then assigns and runs those.
    const inits: Expr[] = []
    for (const p of info.paramProps) inits.push(setField(thisRef, p.name, new LocalRef(p.type, p)))
    for (const init of info.inits) {
        const value = init.value
        if (value !== null) inits.push(setField(thisRef, init.name, value))
    }
    const body_: Stmt[] = [new LetStmt(self, new Alloc(type))]
    // Other fields start at their zero value: the allocation is zeroed, which is not `""`, `[]` or `null` of every type.
    // Inherited fields are the base class's initialization's.
    const initialized = new Set<string>()
    for (const p of info.paramProps) initialized.add(p.name)
    for (const init of info.inits) initialized.add(init.name)
    for (const field of type.fields.slice(base === null ? 0 : base.fields.length)) {
        if (!initialized.has(field.name) && zeroNeedsInit(field.type))
            body_.push(new ExprStmt(setField(thisRef, field.name, zeroValue(field.type))))
    }
    const ctorDecl = info.ctorDecl
    if (base !== null && baseInfo !== null && ctorDecl === null) {
        const args = info.ctorParams.map((p): Expr => new LocalRef(p.type, p))
        body_.push(new ExprStmt(new MethodCall(base, initOf(c, baseInfo), thisRef, args)))
    }
    if (baseInfo === null || ctorDecl === null) for (const e of inits) body_.push(new ExprStmt(e))
    if (ctorDecl !== null) {
        const prologue: Stmt[] = []
        const scope = paramScope(c, parameters(ctorDecl), info.ctorParams, outer, prologue)
        c.facts = [new Map<string, Type>()]
        const fn = new FuncContext(types.void, [], 0, null, null, self, type, true)
        c.fn = fn
        if (baseInfo !== null) {
            fn.superCall = superStatement(c, ctorDecl)
            fn.superInits = inits
        }
        for (const s of prologue) body_.push(s)
        for (const s of checkBlock(c, body(ctorDecl)!, scope).body) body_.push(s)
        c.fn = null
    }
    body_.push(new ReturnStmt(thisRef))
    ctor.body = new Block(body_)

    // Fields of reference types have no zero value and must be set in the constructor.
    const assigned = new Set<string>()
    for (const p of info.paramProps) assigned.add(p.name)
    for (const i of info.inits) assigned.add(i.name)
    const ctorBody = ctorDecl !== null ? body(ctorDecl) : null
    if (ctorBody !== null) {
        for (const stmt of statements(ctorBody)) {
            if (stmt.kind !== "ExpressionStatement") continue
            const e = expression(stmt)
            if (e.kind !== "BinaryExpression") continue
            const target = left(e)
            if (
                operatorToken(e).kind === "EqualsToken" &&
                target.kind === "PropertyAccessExpression" &&
                expression(target).kind === "ThisKeyword"
            ) {
                assigned.add(nameNode(target).text)
            }
        }
    }
    // Inherited fields are the base class's to initialize.
    for (const field of type.fields.slice(base === null ? 0 : base.fields.length)) {
        if (!hasZeroValue(field.type) && !assigned.has(field.name)) {
            const decl = c.memberDecls.get(type)!.get(field.name)!
            c.error(
                nameNode(decl),
                `Field '${field.name}' of type '${typeToString(field.type)}' must be initialized in its declaration or at the top level of the constructor.`,
            )
        }
    }

    const instanceScope = thisScope(outer, type, info.decl)
    for (const m of info.methods) checkMethodBody(c, m.decl, m.func, type, instanceScope)
}

/** A scope in which the type `this` names `type`, for the non-static members of a class or interface. */
export function thisScope(outer: Scope, type: Type, decl: Node): Scope {
    const scope = new Scope(outer)
    scope.declareType("this", new TypeSymbol(type, decl))
    return scope
}

/** The class that first declared method `name`, the topmost one up from `s` that has it. */
function rootClass(s: StructType, name: string): StructType {
    let root = s
    let base = s.base
    while (base !== null && findMethod(base, name) !== null) {
        root = base
        base = base.base
    }
    return root
}

/** `this.name = value`, run by a constructor. */
function setField(thisRef: Expr, name: string, value: Expr): Expr {
    return new Assign(value.type, new FieldLValue(thisRef, name), value)
}

/**
 * The `super(...)` call that the constructor of a class with a base class
 * must make: a statement at the top level of its body, after statements
 * that do not use `this`.
 */
function superStatement(c: Checker, decl: Node): Node | null {
    const stmts = statements(body(decl)!)
    let index = -1
    for (let i = 0; i < stmts.length; i++) {
        const s = stmts[i]
        if (
            index === -1 &&
            s.kind === "ExpressionStatement" &&
            expression(s).kind === "CallExpression" &&
            expression(expression(s)).kind === "SuperKeyword"
        )
            index = i
    }
    if (index === -1) {
        c.error(decl, "Constructors for derived classes must contain a 'super' call.")
        return null
    }
    for (const stmt of stmts.slice(0, index)) {
        const use = findThis(stmt)
        if (use !== null) {
            c.error(use, "'super' must be called before accessing 'this' in the constructor of a derived class.")
            break
        }
    }
    return expression(stmts[index])
}

/** A getter or setter: a method named `get_x` or `set_x`, called by reads and writes of property `x`. */
export function declareAccessor(c: Checker, member: Node, info: ClassInfo, scope: Scope, flags: MemberFlags) {
    const name = c.memberName(nameNode(member))
    if (name === null) return
    if (!checkInherited(c, info, name, "accessor", nameNode(member), flags)) return
    const type = info.type
    const decls = c.memberDecls.get(type)!
    const known = c.accessors.get(type)
    const accessors = known ?? new Map<string, Accessor>()
    if (known === null) c.accessors.set(type, accessors)
    const existing = accessors.get(name)
    const getter = member.kind === "GetAccessor"
    if (
        (decls.has(name) && existing === null) ||
        (existing !== null && (getter ? existing.get !== null : existing.set !== null))
    ) {
        c.error(nameNode(member), `Duplicate member '${name}'.`)
        return
    }
    decls.set(name, member)
    if (body(member) === null) {
        c.error(nameNode(member), "A getter or setter must have a body.")
        return
    }
    if (getter && typeNode(member) === null) {
        c.error(nameNode(member), `Getter '${name}' must have a return type annotation.`)
        return
    }
    const params_ = parameters(member)
    if (!getter && (params_.length !== 1 || typeNode(params_[0]) === null)) {
        c.error(nameNode(member), `Setter '${name}' must take one parameter with a type annotation.`)
        return
    }
    const kind = getter ? "get" : "set"
    const func = makeMethod(
        c,
        member,
        info,
        scope,
        `${type.name}.${kind} ${name}`,
        `ore_m_${info.cname}_${kind}_${cIdent(name)}`,
    )
    info.methods.push(new MethodInfo(member, func))
    const propertyType = getter ? func.type.result : func.type.params[0]
    if (existing !== null && !sameType(existing.type, propertyType)) {
        c.error(
            nameNode(member),
            `The getter and setter of '${name}' must have the same type, got '${typeToString(existing.type)}' and '${typeToString(propertyType)}'.`,
        )
        return
    }
    if (flags.isProtected) info.protected.set(name, true)
    const property = existing ?? new Accessor(propertyType, flags.isPrivate || flags.isProtected)
    if (getter) {
        property.get = func
        property.hasGet = true
    } else {
        property.set = func
        property.hasSet = true
    }
    accessors.set(name, property)
}

/**
 * The accessor property `name` of a class, inherited ones included, or of an
 * object literal, if any.
 */
export function accessor(c: Checker, type: Type, name: string): Accessor | null {
    if (type.kind === "struct" && !type.nominal) return literalAccessor(type, name)
    let s: StructType | null = type.kind === "struct" ? type : null
    while (s !== null) {
        const accessors = c.accessors.get(s)
        const found = accessors === null ? null : accessors.get(name)
        if (found !== null) return found
        s = s.base
    }
    return null
}

/** The hidden field of an object literal that holds the getter (`get`) or setter (`set`) of property `name`. */
export function accessorField(kind: "get" | "set", name: string): string {
    return `${kind} ${name}`
}

/** The accessor property `name` of an object literal: its getter and setter are in hidden fields. */
function literalAccessor(s: StructType, name: string): Accessor | null {
    const get = findField(s, accessorField("get", name))
    const set = findField(s, accessorField("set", name))
    const getType = get !== null && get.private && get.type.kind === "func" ? get.type : null
    const setType = set !== null && set.private && set.type.kind === "func" ? set.type : null
    let type: Type | null = null
    if (getType !== null) type = getType.result
    else if (setType !== null && setType.params.length === 1) type = setType.params[0]
    if (type === null) return null
    const property = new Accessor(type, false)
    property.inFields = true
    property.hasGet = getType !== null
    property.hasSet = setType !== null
    return property
}

/** Calls the getter of an accessor property on an object. */
export function callGetter(property: Accessor, name: string, self: Expr): Expr {
    if (!property.inFields) return new MethodCall(property.type, property.get!, self, [])
    return new CallValue(property.type, hiddenField(self, accessorField("get", name)), [])
}

/** Calls the setter of an accessor property on an object. */
export function callSetter(property: Accessor, name: string, self: Expr, value: Expr): Expr {
    if (!property.inFields) return new MethodCall(types.void, property.set!, self, [value])
    return new CallValue(types.void, hiddenField(self, accessorField("set", name)), [value])
}

/** Reads a hidden field of an object literal. */
function hiddenField(self: Expr, name: string): Expr {
    const s = self.type
    const field = s.kind === "struct" ? findField(s, name) : null
    return new FieldGet(field !== null ? field.type : types.void, self, name)
}

/** A method with the signature of a declaration, resolved in `scope`; the body is checked later. */
export function makeMethod(
    c: Checker,
    decl: Node,
    info: ClassInfo,
    scope: Scope,
    sourceName: string,
    cname: string,
): Func {
    const params = resolveParams(c, parameters(decl), scope)
    const result = resultType(c, decl, scope)
    const func = new Func(
        cname,
        sourceName,
        c.line(nameNode(decl)),
        new FuncType(
            params.map((p) => p.type),
            result,
        ),
        params,
        new Block([]),
        false,
        c.sourceOf(decl).path,
        false,
        null,
        c.newLocal("this", info.type, false),
    )
    c.module.functions.push(func)
    c.funcDecls.set(func, decl)
    declarePredicate(c, decl, func, scope, true)
    return func
}

export function checkMethodBody(c: Checker, decl: Node, func: Func, type: StructType, outer: Scope) {
    const prologue: Stmt[] = []
    const scope = paramScope(c, parameters(decl), func.params, outer, prologue)
    c.facts = [new Map<string, Type>()]
    c.fn = new FuncContext(func.type.result, [], 0, null, null, func.receiver, type)
    enterPredicate(c, func, scope)
    const value = isAsync(decl) ? promiseValue(c, func.type.result) : null
    if (value !== null) func.body = new Block(checkAsyncBody(c, decl, scope, value, func.sourceName))
    else if (isGenerator(decl))
        func.body = new Block(checkGeneratorBody(c, decl, scope, func.type.result, func.sourceName))
    else func.body = checkBlock(c, body(decl)!, scope)
    if (!terminates(func.body)) assertionReturn(c, typeNode(decl) ?? nameNode(decl))
    func.body.body = prepend(prologue, func.body.body)
    c.fn = null
    // A generator's body is a closure, checked on its own; the function returns the generator.
    if (!isGenerator(decl)) checkReturns(c, func, typeNode(decl) ?? nameNode(decl))
    if (isThisType(typeNode(decl))) checkThisReturns(c, body(decl)!, type)
}

/** Whether a type annotation is the type `this`, maybe in parentheses. */
export function isThisType(node: Node | null): bool {
    if (node === null) return false
    if (node.kind === "ParenthesizedType") return isThisType(typeNode(node))
    return node.kind === "ThisType"
}

/**
 * Checks that the returns of a method of the type `this` return the receiver:
 * callers through a subclass take the result as of the subclass. The type
 * `this` is the class inside the method, so its type alone does not tell.
 */
function checkThisReturns(c: Checker, node: Node, type: StructType) {
    const k = node.kind
    if (
        k === "ArrowFunction" ||
        k === "FunctionExpression" ||
        k === "FunctionDeclaration" ||
        k === "ClassDeclaration" ||
        k === "MethodDeclaration" ||
        k === "GetAccessor" ||
        k === "SetAccessor"
    )
        return
    if (k === "ReturnStatement") {
        const value = node.child("expression")
        if (value !== null && !isReceiver(c, value, type))
            c.error(
                value,
                "A method returning 'this' must return 'this' or what a method returning 'this' returns on it.",
            )
        return
    }
    for (const child of node.children) checkThisReturns(c, child, type)
}

/** Whether an expression in a method of `type` is the receiver: `this`, or a call on it of a method returning `this`. */
function isReceiver(c: Checker, node: Node, type: StructType): bool {
    const k = node.kind
    if (k === "ThisKeyword") return true
    if (k === "ParenthesizedExpression" || k === "NonNullExpression") return isReceiver(c, expression(node), type)
    if (k === "ConditionalExpression")
        return isReceiver(c, whenTrue(node), type) && isReceiver(c, whenFalse(node), type)
    if (k !== "CallExpression") return false
    const callee = expression(node)
    if (callee.kind !== "PropertyAccessExpression") return false
    const target = expression(callee)
    const base = type.base
    const owner = target.kind === "SuperKeyword" ? base : isReceiver(c, target, type) ? type : null
    if (owner === null) return false
    const decls = c.memberDecls.get(owner)
    const decl = decls !== null ? decls.get(nameNode(callee).text) : null
    return decl !== null && decl.kind === "MethodDeclaration" && isThisType(typeNode(decl))
}

/** Checks that a class has the members of the interfaces it `implements`. */
export function checkImplements(c: Checker, info: ClassInfo, scope: Scope) {
    for (const clause of heritageClauses(info.decl)) {
        if (heritageToken(clause, c.sourceOf(info.decl).text) !== "implements") continue
        for (const ref of typeNodes(clause)) {
            const target = expression(ref)
            const type = isIdentifier(target) ? scope.lookupType(target.text) : null
            if (isIdentifier(target) && type !== null) c.info.definitions.set(target, type.decl)
            let found: Type | null = type === null ? null : type.type
            // A generic interface with type arguments: `implements Iterator<T>`.
            const generic = type === null ? null : type.generic
            if (generic !== null) {
                const resolved: Type[] = []
                for (const a of typeArguments(ref)) {
                    const arg = c.resolveTypeArgument(a, scope)
                    if (arg !== null) resolved.push(arg)
                }
                if (resolved.length < typeArguments(ref).length) continue
                const instance = instantiate(c, generic, resolved, ref)
                if (instance === null) continue
                found = instance instanceof Func ? null : instance
            }
            if (found === null || found.kind !== "interface") {
                c.error(ref, `'${c.text(target)}' is not an interface.`)
                continue
            }
            const iface = found
            const result = conformance(c, info.type, iface)
            if (result.reason !== null) {
                c.error(ref, `Class '${info.type.name}' does not implement '${iface.name}': ${result.reason}.`)
                c.noteMember(iface, result.member)
            }
        }
    }
}

/** The interface of an object type with methods, `{ area(): f64; label: string }`, named by its text. */
export function objectInterface(c: Checker, node: Node, scope: Scope): InterfaceType {
    const name = collapseSpaces(c.text(node))
    const type = new InterfaceTypeClass(c.nextStructId++, name, [])
    const info = new InterfaceInfoClass(node, type, scope, "declared")
    c.interfaces.set(type, info)
    c.memberDecls.set(type, new Map<string, Node>())
    fillInterface(c, info, scope)
    return type
}

/**
 * `A & B`: object types merge into one with the fields of all; with an
 * interface among them, an interface with the members of all. A member in
 * two parts must have the same type in both.
 */
export function intersection(c: Checker, node: Node, scope: Scope): Type | null {
    const parts: Type[] = []
    for (const t of typeNodes(node)) {
        const type = c.resolveValueType(t, scope)
        if (type === null) return null
        if (type.kind === "struct" && (type.nominal || type.tuple)) {
            c.error(t, "A class or a tuple cannot be part of an intersection; use an interface, or extend the class.")
            return null
        }
        if (type.kind !== "struct" && type.kind !== "interface") {
            c.error(t, `Only object types and interfaces can be intersected, not '${typeToString(type)}'.`)
            return null
        }
        parts.push(type)
    }
    // The members of all the parts, by name: a field's type and whether it is read-only, or a method's type.
    const names: string[] = []
    const memberTypes: Type[] = []
    const readonly: bool[] = []
    const methods: bool[] = []
    const optional: bool[] = []
    const add = (name: string, type: Type, isReadonly: bool, method: bool, isOptional: bool, at: Node): bool => {
        const i = names.indexOf(name)
        if (i < 0) {
            names.push(name)
            memberTypes.push(type)
            readonly.push(isReadonly)
            methods.push(method)
            optional.push(isOptional)
            return true
        }
        // A member in two parts has the types common to both: `{ a?: int } & { a: int }` has `a: int`.
        const common = sameType(memberTypes[i], type)
            ? type
            : c.unionOf(membersOf(memberTypes[i]).filter((m) => membersOf(type).some((n) => sameType(m, n))))
        if (common.kind === "never" || methods[i] !== method) {
            c.error(
                at,
                `Member '${name}' has the type '${typeToString(memberTypes[i])}' in one part of the intersection and '${typeToString(type)}' in another.`,
            )
            return false
        }
        memberTypes[i] = common
        // Writable in one part is writable in the intersection, and required in one part is required.
        readonly[i] = readonly[i] && isReadonly
        optional[i] = optional[i] && isOptional
        return true
    }
    let anyInterface = false
    for (const part of parts) {
        if (part.kind === "struct") {
            for (const f of part.fields) if (!add(f.name, f.type, f.readonly, false, f.optional, node)) return null
        } else if (part.kind === "interface") {
            anyInterface = true
            // Type aliases are resolved before interfaces are filled: this one is needed now.
            const info = c.interfaces.get(part)
            if (info !== null) fillInterface(c, info, info.scope)
            for (const m of part.members)
                if (!add(m.name, m.type, m.k === "field" && m.readonly, m.k === "method", false, node)) return null
        }
    }
    if (!anyInterface) {
        const fields: Field[] = []
        for (let i = 0; i < names.length; i++) {
            const field = new Field(names[i], memberTypes[i], readonly[i])
            field.optional = optional[i]
            fields.push(field)
        }
        return c.shape(fields)
    }
    const members: InterfaceMember[] = []
    for (let i = 0; i < names.length; i++) {
        const t = memberTypes[i]
        if (methods[i] && t.kind === "func") members.push(new InterfaceMethod(names[i], t))
        else members.push(new InterfaceField(names[i], t, readonly[i]))
    }
    members.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
    const type = new InterfaceTypeClass(c.nextStructId++, collapseSpaces(c.text(node)), members)
    c.interfaces.set(type, new InterfaceInfoClass(node, type, scope, "filled"))
    c.memberDecls.set(type, new Map<string, Node>())
    return type
}

/** Text on one line, runs of white space as one space. */
function collapseSpaces(text: string): string {
    let out = ""
    let space = false
    for (let i = 0; i < text.length; i++) {
        const ch = text[i]
        if (ch === 32 || ch === 9 || ch === 10 || ch === 13) {
            space = true
            continue
        }
        if (space && out.length > 0) out += " "
        space = false
        out += text.slice(i, i + 1)
    }
    return out
}

export function declareInterface(c: Checker, decl: Node, scope: Scope) {
    const name = nameNode(decl).text
    if (typeParameters(decl).length > 0) {
        declareGeneric(c, decl, scope)
        return
    }
    const type = new InterfaceTypeClass(c.nextStructId++, name, [])
    if (!scope.declareType(name, new TypeSymbol(type, decl))) {
        c.error(nameNode(decl), `Duplicate type '${name}'.`)
        return
    }
    c.interfaces.set(type, new InterfaceInfoClass(decl, type, scope, "declared"))
    c.memberDecls.set(type, new Map<string, Node>())
}

/** Adds a member to an interface being filled, unless it conflicts with an inherited one. */
function addMember(
    c: Checker,
    found: InterfaceMember[],
    decls: Map<string, Node>,
    member: InterfaceMember,
    node: Node,
    decl: Node,
) {
    let existing: InterfaceMember | null = null
    for (const m of found) if (existing === null && m.name === member.name) existing = m
    if (existing === null) {
        found.push(member)
        decls.set(member.name, decl)
    } else if (existing.k !== member.k || !sameType(existing.type, member.type)) {
        c.error(node, `Member '${member.name}' conflicts with an inherited member of a different type.`)
    }
}

export function fillInterface(c: Checker, info: InterfaceInfo, scope: Scope) {
    if (info.state === "filled") return
    if (info.state === "filling") {
        c.error(nameNode(info.decl), `Interface '${info.type.name}' extends itself.`)
        return
    }
    info.state = "filling"
    const found: InterfaceMember[] = []
    const decls = c.memberDecls.get(info.type)!

    for (const clause of heritageClauses(info.decl)) {
        for (const ref of typeNodes(clause)) {
            const target = expression(ref)
            const base = isIdentifier(target) ? scope.lookupType(target.text) : null
            if (base === null || base.type.kind !== "interface") {
                c.error(ref, "An interface can only extend interfaces.")
                continue
            }
            const baseType = base.type
            if (isIdentifier(target)) c.info.definitions.set(target, base.decl)
            const baseInfo = c.interfaces.get(baseType)!
            fillInterface(c, baseInfo, scope)
            for (const m of baseType.members)
                addMember(c, found, decls, m, ref, c.memberDecls.get(baseType)!.get(m.name)!)
        }
    }
    // The members see the type `this` as the interface.
    const memberScope = thisScope(scope, info.type, info.decl)
    for (const member of members(info.decl)) {
        if (member.kind === "GetAccessor" || member.kind === "SetAccessor") {
            const field = c.accessorSignature(member, members(info.decl), scope)
            if (field !== null)
                addMember(c, found, decls, new InterfaceField(field.name, field.type, field.readonly), nameNode(member), member)
            continue
        }
        const memberName = member.child("name")
        if (memberName === null) {
            c.error(
                member,
                member.kind === "IndexSignature"
                    ? indexSignatureMessage
                    : "Call and construct signatures are not supported.",
            )
            continue
        }
        const name = c.memberName(memberName)
        if (name === null) continue
        const question = questionToken(member)
        if (question !== null && member.kind !== "PropertySignature")
            c.error(question, "Optional methods are not supported.")
        if (member.kind === "PropertySignature") {
            const annotation = typeNode(member)
            if (annotation === null) {
                c.error(memberName, `Property '${name}' must have a type annotation.`)
                continue
            }
            const resolved = c.resolveValueType(annotation, memberScope)
            const isReadonly = hasModifier(member, "ReadonlyKeyword")
            if (resolved !== null) {
                const type = question !== null ? c.unionOf([resolved, types.null]) : resolved
                c.info.types.set(memberName, type)
                const field = new InterfaceField(name, type, isReadonly)
                field.optional = question !== null
                addMember(c, found, decls, field, memberName, member)
            }
        } else if (member.kind === "MethodSignature") {
            const typeParams = typeParameters(member)
            if (typeParams.length > 0)
                c.error(
                    typeParams[0],
                    "Generic methods are not supported in interfaces: calls through an interface cannot pick an instance.",
                )
            const params = resolveParams(c, parameters(member), memberScope)
            const annotation = typeNode(member)
            const result = annotation !== null ? (c.resolveType(annotation, memberScope) ?? types.void) : types.void
            addMember(
                c,
                found,
                decls,
                new InterfaceMethod(
                    name,
                    new FuncType(
                        params.map((p) => p.type),
                        result,
                    ),
                ),
                memberName,
                member,
            )
        } else {
            c.error(member, "This interface member is not supported.")
        }
    }
    found.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
    info.type.members = found
    info.state = "filled"
}

/** Whether a struct or interface has the members of an interface: a reason it does not, or the member indices. */
export class Conformance {
    constructor(
        readonly reason: string | null,
        readonly indices: int[] | null,
        /** The name of the interface member the reason is about. */
        readonly member: string = "",
    ) {}
}

/**
 * Whether a struct or interface has the members of an interface. For an
 * interface source, `indices` maps each target member to a source member.
 */
export function conformance(c: Checker, from: StructType | InterfaceType, iface: InterfaceType): Conformance {
    const indices: int[] = []
    for (const member of iface.members) {
        const what = `${member.k === "field" ? "property" : "method"} '${member.name}'`
        if (from.kind === "interface") {
            let index = -1
            for (let i = 0; i < from.members.length; i++)
                if (index === -1 && from.members[i].name === member.name) index = i
            const source = index === -1 ? null : from.members[index]
            if (source === null || source.k !== member.k)
                return new Conformance(`${what} is missing`, null, member.name)
            if (!sameType(source.type, member.type))
                return new Conformance(
                    `${what} has type '${typeToString(source.type)}' instead of '${typeToString(member.type)}'`,
                    null,
                    member.name,
                )
            if (source.k === "field" && member.k === "field" && source.readonly && !member.readonly)
                return new Conformance(`${what} is read-only`, null, member.name)
            if (source.k === "field" && member.k === "field" && source.optional && !member.optional)
                return new Conformance(`${what} is optional`, null, member.name)
            indices.push(index)
        } else if (member.k === "field") {
            const field = findField(from, member.name)
            const property = field === null ? accessor(c, from, member.name) : null
            if (property !== null && !property.private) {
                // A getter implements the field; a setter too for a writable one.
                if (!sameType(property.type, member.type))
                    return new Conformance(
                        `${what} has type '${typeToString(property.type)}' instead of '${typeToString(member.type)}'`,
                        null,
                    )
                if (!property.hasGet) return new Conformance(`${what} has a setter but no getter`, null)
                if (!property.hasSet && !member.readonly)
                    return new Conformance(`${what} has a getter but no setter`, null)
                continue
            }
            // An optional member may be missing.
            if ((field === null || field.private) && member.optional) continue
            if (field === null || field.private) return new Conformance(`${what} is missing`, null, member.name)
            if (!sameType(field.type, member.type))
                return new Conformance(
                    `${what} has type '${typeToString(field.type)}' instead of '${typeToString(member.type)}'`,
                    null,
                    member.name,
                )
            if (field.readonly && !member.readonly) return new Conformance(`${what} is read-only`, null, member.name)
        } else {
            const method = findMethod(from, member.name)
            // A field holding a function of the method's type serves as the method (object literals' methods).
            const field = method === null ? findField(from, member.name) : null
            if (field !== null && !field.private && sameType(field.type, member.type)) continue
            if (method === null || method.private) return new Conformance(`${what} is missing`, null, member.name)
            if (!sameType(method.func.type, member.type))
                return new Conformance(
                    `${what} has type '${typeToString(method.func.type)}' instead of '${typeToString(member.type)}'`,
                    null,
                    member.name,
                )
        }
    }
    return new Conformance(null, indices)
}

/** The interface table of a struct, created once per struct and interface. */
export function itab(c: Checker, struct: StructType, iface: InterfaceType): Itab {
    const key = `${struct.id}:${iface.id}`
    let table = c.itabs.get(key)
    if (table === null) {
        table = new Itab(c.itabs.size, struct, iface)
        for (let i = 0; i < iface.members.length; i++) {
            const member = iface.members[i]
            if (member.k !== "field" || findField(struct, member.name) !== null) continue
            const property = accessor(c, struct, member.name)
            if (property === null || property.private || !property.hasGet) continue
            table.accessors.push(new ItabAccessor(i, property.get, member.readonly ? null : property.set))
        }
        c.itabs.set(key, table)
        c.module.itabs.push(table)
    }
    return table
}

/** Reports access to a private member from outside its class, or to a protected one from outside its class and subclasses. */
export function checkAccess(c: Checker, struct: StructType, isPrivate: bool, name: string, node: Node): bool {
    if (!isPrivate) return true
    const owner = declaringClass(c, struct, name)
    const fn = c.fn
    const cls = fn === null ? null : fn.cls
    if (cls === owner) return true
    const ownerInfo = c.classInfos.get(owner.id)
    const isProtected = ownerInfo !== null && ownerInfo.protected.has(name)
    if (isProtected && cls !== null && isSubclass(cls, owner)) return true
    c.error(
        node,
        isProtected
            ? `'${name}' is protected and only accessible inside class '${owner.name}' and its subclasses.`
            : `'${name}' is private and only accessible inside class '${owner.name}'.`,
    )
    return false
}
