// Classes and interfaces: members, inheritance, constructors, accessors,
// conformance and interface tables.

import {
    type Expr,
    type Stmt,
    Alloc,
    Assign,
    Block,
    BuiltinCall,
    CallValue,
    ExprStmt,
    FieldGet,
    FieldLValue,
