// Types computed from other types and values: `keyof T`, `T["k"]`,
// `typeof x`, conditional types `T extends U ? X : Y`, mapped types
// `{ [K in keyof T]?: T[K] }` and template literal types, resolved when the
// type that names them is. A generic type alias is resolved for each list of
// type arguments, so their type parameters are known types here.

import { Field, FuncType, type StructType, type Type, arrayOf, membersOf, readonlyArrayOf, typeToString, types } from "../ir/types"
import { type Node } from "../syntax/ast"
import {
    constraint,
    declarationKind,
    declarationList,
    declarations,
    dotDotDotToken,
    elements,
    expression,
    initializer,
    isIdentifier,
    nameNode,
    operand,
    parameters,
    properties,
    questionToken,
    typeArguments,
    typeNode,
    typeParameters,
} from "../syntax/nodes"
import { type Checker } from "./base"
import { resolveBase } from "./classes"
import { satisfiesConstraint } from "./declarations"
import { checkExpr } from "./expressions"
import { typeOf } from "./helpers"
import { type ValueSymbol, Scope, TypeSymbol } from "./symbols"

/** The names of the members of a type that `keyof` lists: public fields and methods, or interface members. */
function memberNames(type: Type): string[] | null {
    const names: string[] = []
    if (type.kind === "struct") {
        if (type.tuple) return null
        for (const f of type.fields) if (!f.private) names.push(f.name)
        for (const m of type.methods) if (!m.private && !names.includes(m.name)) names.push(m.name)
        return names
    }
    if (type.kind === "interface") {
        for (const m of type.members) names.push(m.name)
        return names
    }
    return null
}

/** `keyof T`: the union of the names of T's members, as string literal types. */
export function keyofType(c: Checker, node: Node, scope: Scope): Type | null {
    const inner = typeNode(node)
    if (inner === null) return null
    const type = c.resolveTypeArgument(inner, scope)
    if (type === null) return null
    const names = memberNames(type)
    if (names === null || names.length === 0) {
        c.error(
            node,
            `'keyof' needs an object type, a class or an interface with members, not '${typeToString(type)}'.`,
        )
        return null
    }
    const literals: Type[] = []
    for (const n of names) literals.push(c.literal(n))
    return literals.length === 1 ? literals[0] : c.unionOf(literals)
}

/** The type of a member of a struct or interface by name, or null. */
function memberType(type: Type, name: string): Type | null {
    if (type.kind === "struct") {
        for (const f of type.fields) if (f.name === name && !f.private) return f.type
        for (const m of type.methods) if (m.name === name && !m.private) return m.func.type
        return null
    }
    if (type.kind === "interface") {
        for (const m of type.members) if (m.name === name) return m.type
    }
    return null
}

/** `T["k"]`, `T["a" | "b"]`, `T[number]` of an array or tuple, `T[0]` of a tuple. */
export function indexedType(c: Checker, node: Node, scope: Scope): Type | null {
    const objectNode = node.child("objectType")
    const indexNode = node.child("indexType")
    if (objectNode === null || indexNode === null) return null
    const object = c.resolveTypeArgument(objectNode, scope)
    if (object === null) return null
    // A number: the elements of an array or a tuple.
    if (indexNode.kind === "NumberKeyword") {
        if (object.kind === "array") return object.elem
        if (object.kind === "struct" && object.tuple) {
            const elems: Type[] = []
            for (const f of object.fields) elems.push(f.type)
            return elems.length === 1 ? elems[0] : c.unionOf(elems)
        }
        c.error(indexNode, `Type '${typeToString(object)}' has no elements indexed by number.`)
        return null
    }
    // A numeric literal: an element of a tuple.
    const literal = indexNode.kind === "LiteralType" ? indexNode.child("literal") : null
    if (literal !== null && literal.kind === "NumericLiteral" && object.kind === "struct" && object.tuple) {
        const found = memberType(object, literal.text)
        if (found === null)
            c.error(
                indexNode,
                `Tuple type '${typeToString(object)}' of length ${object.fields.length} has no element at index ${literal.text}.`,
            )
        return found
    }
    const index = c.resolveType(indexNode, scope)
    if (index === null) return null
    if (index.kind === "never") return types.never
    // A numeric literal type or `number` from a type parameter: `Prev[D]`, `T[K]` with K bound to number.
    if (index.kind === "number-literal" && object.kind === "struct" && object.tuple) {
        const element = memberType(object, index.value)
        if (element === null)
            c.error(
                indexNode,
                `Tuple type '${typeToString(object)}' of length ${object.fields.length} has no element at index ${index.value}.`,
            )
        return element
    }
    if (index.kind === "float" && object.kind === "array") return object.elem
    const keys: string[] = []
    if (index.kind === "literal") keys.push(index.value)
    else if (index.kind === "union") {
        for (const m of index.members) {
            if (m.kind !== "literal") {
                c.error(
                    indexNode,
                    `An index type is a string literal or a union of them, not '${typeToString(index)}'.`,
                )
                return null
            }
            keys.push(m.value)
        }
    } else {
        c.error(indexNode, `An index type is a string literal or a union of them, not '${typeToString(index)}'.`)
        return null
    }
    const found: Type[] = []
    for (const k of keys) {
        const t = memberType(object, k)
        if (t === null) {
            c.error(indexNode, `Property '${k}' does not exist on type '${typeToString(object)}'.`)
            return null
        }
        found.push(t)
    }
    return found.length === 1 ? found[0] : c.unionOf(found)
}

/** The type of a function declaration from its annotations; null when one is missing or it is generic. */
function annotatedFunction(c: Checker, decl: Node, scope: Scope): Type | null {
    const resultNode = typeNode(decl)
    if (resultNode === null || typeParameters(decl).length > 0) return null
    const params: Type[] = []
    let required = -1
    for (const p of parameters(decl)) {
        const annotation = typeNode(p)
        if (annotation === null || dotDotDotToken(p) !== null) return null
        let type = c.resolveValueType(annotation, scope)
        if (type === null) return null
        const optional = p.child("questionToken") !== null || p.child("initializer") !== null
        if (optional && required === -1) required = params.length
        if (p.child("questionToken") !== null) type = c.unionOf([type, types.null])
        params.push(type)
    }
    const result = c.resolveType(resultNode, scope)
    if (result === null) return null
    const type = new FuncType(params, result)
    if (required !== -1) type.required = required
    return type
}

/**
 * The declared type of a top-level variable or function named `name` of a
 * module, from its annotations, or of a constant from an initializer whose
 * type is known before it is checked (see `knownType`); null otherwise.
 */
function annotatedTopLevel(c: Checker, scope: Scope, name: string, at: Node, depth: int = 0): Type | null {
    // `const a = b` follows `b`, a few steps, which also ends a cycle.
    if (depth > 8) return null
    const source = c.sourceOf(at)
    for (const stmt of source.ast.list("statements")) {
        if (stmt.kind === "FunctionDeclaration") {
            const fn = stmt.child("name")
            if (fn !== null && fn.text === name) return annotatedFunction(c, stmt, scope)
        }
        if (stmt.kind !== "VariableStatement") continue
        for (const d of declarations(declarationList(stmt))) {
            const n = nameNode(d)
            if (!isIdentifier(n) || n.text !== name) continue
            const annotation = typeNode(d)
            if (annotation !== null) return c.resolveValueType(annotation, scope)
            const init = initializer(d)
            const isConst = declarationKind(declarationList(stmt), source.text) === "const"
            return isConst && init !== null ? knownType(c, init, scope, depth) : null
        }
    }
    return null
}

/**
 * The type of the initializer of a top-level constant, when it is known
 * before the code around it is checked: literals (see `isData`), a template
 * literal, `new C(...)` of a class that is not generic, and
 * another such top-level name.
 */
function knownType(c: Checker, init: Node, scope: Scope, depth: int): Type | null {
    const k = init.kind
    if (isData(init)) return dataType(c, init, scope)
    if (k === "ParenthesizedExpression") return knownType(c, expression(init), scope, depth)
    if (k === "TemplateExpression") return types.string
    if (k === "NewExpression") {
        const target = expression(init)
        if (!isIdentifier(target) || typeArguments(init).length > 0) return null
        const symbol = scope.lookupType(target.text)
        return symbol !== null && symbol.generic === null && symbol.decl.kind === "ClassDeclaration"
            ? symbol.type
            : null
    }
    if (k === "Identifier") {
        const symbol = scope.lookupValue(init.text)
        if (symbol !== null) return valueType(c, symbol, init)
        return annotatedTopLevel(c, scope, init.text, init, depth + 1)
    }
    return null
}

/** The type of a variable, a constant or a function already declared; null when it is not known yet. */
function valueType(c: Checker, symbol: ValueSymbol, at: Node): Type | null {
    if (symbol.k === "local") return c.untyped.has(symbol.local) ? null : symbol.local.type
    if (symbol.k === "func") return symbol.func.type
    // `typeof C` of a class: its constructor, `new (params) => C`.
    if (symbol.k === "class") {
        const cls = symbol.type
        return cls === null ? null : constructorType(c, cls)
    }
    if (symbol.k !== "const") return null
    const declared = symbol.type
    if (declared !== null) return declared
    const value = symbol.value
    return value.k === "error" ? null : typeOf(c.toDefault(value, at))
}

/**
 * The constructor type of a class, `new (params) => C`. Type aliases are
 * resolved before the members of classes are declared, so the parameters
 * come from the constructor's declaration, or the base class's without one.
 */
function constructorType(c: Checker, cls: StructType): FuncType | null {
    const info = c.classInfos.get(cls.id)
    if (info === null) return null
    let decl: Node | null = null
    for (const m of info.decl.list("members")) if (m.kind === "Constructor") decl = m
    if (decl === null) {
        resolveBase(c, info)
        const base = cls.base
        const inherited = base === null ? null : constructorType(c, base)
        const params: Type[] = inherited === null ? [] : inherited.params
        const type = new FuncType(params, cls)
        if (inherited !== null) {
            type.required = inherited.required
            type.rest = inherited.rest
        }
        type.construct = true
        return type
    }
    const params: Type[] = []
    let required = -1
    let rest = false
    const list = parameters(decl)
    for (let i = 0; i < list.length; i++) {
        const p = list[i]
        const annotation = typeNode(p)
        if (annotation === null) return null
        const t = c.resolveValueType(annotation, info.scope)
        if (t === null) return null
        const optional = questionToken(p) !== null || initializer(p) !== null
        if (optional || dotDotDotToken(p) !== null) {
            if (required === -1) required = i
        }
        if (dotDotDotToken(p) !== null) rest = true
        params.push(questionToken(p) !== null ? c.unionOf([t, types.null]) : t)
    }
    const type = new FuncType(params, cls)
    type.required = required
    type.rest = rest
    type.construct = true
    return type
}

/**
 * Whether an expression is made of literals only, such as `{ a: 1, b: ["s"] }`:
 * its type is known before the code around it is checked.
 */
function isData(node: Node): bool {
    const k = node.kind
    if (k === "ParenthesizedExpression") return isData(expression(node))
    // `[...] as const`.
    if (k === "AsExpression") {
        const type = node.child("type")
        return type !== null && type.kind === "TypeReference" && type.end - type.start === 5 && isData(expression(node))
    }
    if (k === "ArrayLiteralExpression") return elements(node).every(isData)
    if (k === "ObjectLiteralExpression") {
        return properties(node).every((p) => {
            const value = p.kind === "PropertyAssignment" ? initializer(p) : null
            return value !== null && isData(value)
        })
    }
    if (k === "PrefixUnaryExpression") return isData(operand(node))
    return (
        k === "NumericLiteral" ||
        k === "BigIntLiteral" ||
        k === "StringLiteral" ||
        k === "NoSubstitutionTemplateLiteral" ||
        k === "TrueKeyword" ||
        k === "FalseKeyword"
    )
}

/**
 * The type of a literal initializer of a top-level constant (see `isData`),
 * as its declaration gives it when it is checked later; null when it has
 * errors, which that check reports.
 */
function dataType(c: Checker, init: Node, scope: Scope): Type | null {
    const errors = c.diagnostics.length
    const value = checkExpr(c, init, scope)
    const type = value.k === "error" ? null : typeOf(c.toDefault(value, init))
    const failed = c.diagnostics.length > errors
    while (c.diagnostics.length > errors) c.diagnostics.pop()
    return failed ? null : type
}

/** `typeof x` or `typeof x.y`: the type of a variable, a function, or a field of one. */
export function typeQuery(c: Checker, node: Node, scope: Scope): Type | null {
    const name = node.child("exprName")
    if (name === null) return null
    // The path: `a.b.c` from the left.
    const parts: Node[] = []
    let n: Node = name
    while (n.kind === "QualifiedName") {
        parts.push(n.child("right")!)
        n = n.child("left")!
    }
    parts.reverse()
    if (!isIdentifier(n)) return null
    let type: Type | null = null
    const symbol = scope.lookupValue(n.text)
    if (symbol !== null) type = valueType(c, symbol, n)
    else type = annotatedTopLevel(c, scope, n.text, node)
    if (type === null) {
        c.error(
            n,
            symbol === null
                ? `'${n.text}' is not known yet here: give it a type annotation to use 'typeof ${n.text}' before it.`
                : `'typeof ${n.text}' needs a variable or a function with a known type.`,
        )
        return null
    }
    let current: Type = type
    for (const part of parts) {
        const next = memberType(current, part.text)
        if (next === null) {
            c.error(part, `Property '${part.text}' does not exist on type '${typeToString(current)}'.`)
            return null
        }
        current = next
    }
    return current
}

/** `keyof T` and the other type operators. */
export function typeOperator(c: Checker, node: Node, scope: Scope): Type | null {
    const text = c.text(node)
    if (text.startsWith("keyof")) return keyofType(c, node, scope)
    // `readonly T[]` and `readonly [A, B]`: arrays and tuples that cannot be changed through this type.
    if (text.startsWith("readonly")) {
        const inner = typeNode(node)
        const type = inner !== null ? c.resolveType(inner, scope) : null
        if (type !== null && type.kind === "array" && !type.template) return readonlyArrayOf(type.elem)
        if (type !== null && type.kind === "struct" && type.tuple)
            return c.tupleOf(
                type.fields.map((f) => f.type),
                true,
            )
        return type
    }
    c.error(node, "This type operator is not supported.")
    return null
}

/** Whether a type node names a type parameter of the generic being resolved: `T`. */
function isTypeParameter(node: Node, scope: Scope): bool {
    if (node.kind !== "TypeReference" || node.list("typeArguments").length > 0) return false
    const name = node.child("typeName")
    if (name === null || !isIdentifier(name)) return false
    const symbol = scope.lookupType(name.text)
    return symbol !== null && symbol.decl.kind === "TypeParameter"
}

/** Whether a type node has an `infer X` in it. */
function hasInfer(node: Node): bool {
    if (node.kind === "InferType") return true
    for (const child of node.children) if (hasInfer(child)) return true
    return false
}

/**
 * Whether a type matches the `extends` clause of a conditional type, binding
 * the names its `infer X` declare. A clause without `infer` matches the types
 * assignable to it; in a function type, only the parts with `infer` count.
 */
function matches(c: Checker, pattern: Node, type: Type, scope: Scope, bindings: Map<string, Type>): bool {
    if (pattern.kind === "ParenthesizedType") return matches(c, typeNode(pattern)!, type, scope, bindings)
    if (pattern.kind === "InferType") {
        const name = nameNode(pattern.child("typeParameter")!).text
        const bound = bindings.get(name)
        if (bound !== null) return c.unionOf([bound, type]) === bound
        bindings.set(name, type)
        return true
    }
    const wildcard = matchesKind(c, pattern, type, scope)
    if (wildcard !== null) return wildcard
    if (pattern.kind === "TemplateLiteralType" && hasInfer(pattern)) return matchesTemplate(c, pattern, type, bindings)
    if (!hasInfer(pattern)) {
        const target = c.resolveType(pattern, scope)
        return target !== null && (satisfiesConstraint(c, type, target) || fitsShape(c, type, target))
    }
    if (pattern.kind === "ArrayType") {
        const elem = pattern.child("elementType")!
        return type.kind === "array" && matches(c, elem, type.elem, scope, bindings)
    }
    if (pattern.kind === "TupleType") {
        const elems = pattern.list("elements")
        if (type.kind !== "struct" || !type.tuple || type.fields.length !== elems.length) return false
        for (let i = 0; i < elems.length; i++)
            if (!matches(c, elems[i], type.fields[i].type, scope, bindings)) return false
        return true
    }
    if (pattern.kind === "TypeLiteral") {
        // `{ a: infer X }`: the fields named, of an object type or a class.
        if (type.kind !== "struct" || type.tuple) return false
        for (const m of pattern.list("members")) {
            const annotation = typeNode(m)
            if (m.kind !== "PropertySignature" || annotation === null) return false
            const field = memberType(type, c.text(nameNode(m)))
            if (field === null || !matches(c, annotation, field, scope, bindings)) return false
        }
        return true
    }
    if (pattern.kind === "FunctionType" || pattern.kind === "ConstructorType") {
        if (type.kind !== "func" || type.construct !== (pattern.kind === "ConstructorType")) return false
        const params = parameters(pattern)
        // `(...args: infer P) => R`: the parameters as a tuple.
        if (params.length === 1 && dotDotDotToken(params[0]) !== null) {
            const rest = typeNode(params[0])
            if (rest !== null && hasInfer(rest) && !matches(c, rest, c.tupleOf(type.params), scope, bindings))
                return false
        } else {
            for (let i = 0; i < params.length; i++) {
                const p = typeNode(params[i])
                if (p === null || !hasInfer(p)) continue
                if (i >= type.params.length || !matches(c, p, type.params[i], scope, bindings)) return false
            }
        }
        const result = typeNode(pattern)
        return result === null || !hasInfer(result) || matches(c, result, type.result, scope, bindings)
    }
    if (pattern.kind === "TypeReference") {
        const name = pattern.child("typeName")!
        const args = pattern.list("typeArguments")
        const text = c.text(name)
        if ((text === "Array" || text === "Set") && args.length === 1) {
            if (text === "Array" && type.kind === "array") return matches(c, args[0], type.elem, scope, bindings)
            if (text === "Set" && type.kind === "set") return matches(c, args[0], type.elem, scope, bindings)
            return false
        }
        if (text === "Map" && args.length === 2) {
            return (
                type.kind === "map" &&
                matches(c, args[0], type.key, scope, bindings) &&
                matches(c, args[1], type.value, scope, bindings)
            )
        }
        // An instance of a generic class or interface: `Box<infer T>`.
        const instance = type.kind === "struct" || type.kind === "interface" ? c.instanceOf.get(type) : null
        if (instance === null || instance.generic.name !== text || instance.args.length !== args.length) return false
        for (let i = 0; i < args.length; i++) if (!matches(c, args[i], instance.args[i], scope, bindings)) return false
        return true
    }
    c.error(pattern, "'infer' is supported in array, tuple, object, function, Map, Set and generic class types.")
    return false
}

/**
 * Whether a type matches a pattern that names a kind of types rather than a
 * type: `unknown` (any type), `object` (any value that is not a primitive),
 * `Function` (any function), `unknown[]` and `readonly unknown[]` (any array
 * or tuple); null for other patterns.
 */
function matchesKind(c: Checker, pattern: Node, type: Type, scope: Scope): bool | null {
    if (pattern.kind === "UnknownKeyword") return true
    if (pattern.kind === "ObjectKeyword") {
        const k = type.kind
        return k === "struct" || k === "interface" || k === "array" || k === "map" || k === "set" || k === "func"
    }
    if (pattern.kind === "TypeReference" && c.text(pattern) === "Function" && scope.lookupType("Function") === null)
        return type.kind === "func"
    if (pattern.kind === "TypeOperator" && c.text(pattern).startsWith("readonly"))
        return matchesKind(c, typeNode(pattern)!, type, scope)
    if (pattern.kind === "ArrayType" && pattern.child("elementType")!.kind === "UnknownKeyword")
        return type.kind === "array" || (type.kind === "struct" && type.tuple)
    return null
}

/**
 * Whether an object type has the fields of an object type `target`, each of
 * the same type, or left out where `target`'s field is optional:
 * `{} extends Pick<T, K>` when K is an optional field of T.
 */
function fitsShape(c: Checker, type: Type, target: Type): bool {
    if (type.kind !== "struct" || target.kind !== "struct" || type.tuple || target.tuple || target.nominal) return false
    for (const f of target.fields) {
        let found = false
        for (const g of type.fields)
            if (g.name === f.name && !g.private && satisfiesConstraint(c, g.type, f.type)) found = true
        if (!found && !f.optional) return false
    }
    return true
}

/**
 * Whether a string literal type matches a template literal type with
 * `infer`, binding them as TypeScript does: each placeholder takes the
 * shortest text up to the next fixed text (one character when the next
 * placeholder follows at once), the last one the rest. A placeholder of
 * another type, such as `${string}`, takes text the same way and binds
 * nothing.
 */
function matchesTemplate(c: Checker, pattern: Node, type: Type, bindings: Map<string, Type>): bool {
    if (type.kind !== "literal") return false
    const text = type.value
    const head = templateText(c, pattern.child("head")!)
    if (!text.startsWith(head)) return false
    let at = head.length
    const spans = pattern.list("templateSpans")
    for (let i = 0; i < spans.length; i++) {
        const after = templateText(c, spans[i].child("literal")!)
        const last = i === spans.length - 1
        let end = -1
        if (last) {
            if (!text.endsWith(after) || text.length - after.length < at) return false
            end = text.length - after.length
        } else if (after === "") {
            if (at >= text.length) return false
            end = at + 1
        } else {
            end = text.indexOf(after, at)
            if (end < 0) return false
        }
        const placeholder = spans[i].child("type")!
        if (placeholder.kind === "InferType") {
            const name = nameNode(placeholder.child("typeParameter")!).text
            const value = c.literal(text.slice(at, end))
            const bound = bindings.get(name)
            if (bound !== null && bound !== value) return false
            bindings.set(name, value)
        }
        at = end + after.length
    }
    return true
}

/** One branch of a conditional type for a checked type that is not a union to distribute. */
function conditionalBranch(c: Checker, node: Node, check: Type, param: Node | null, scope: Scope): Type | null {
    const inner = new Scope(scope)
    // Distributed over a union, the type parameter is each member in the branches.
    if (param !== null) {
        const symbol = scope.lookupType(c.text(param))!
        inner.declareType(c.text(param), new TypeSymbol(check, symbol.decl))
    }
    const bindings = new Map<string, Type>()
    if (matches(c, node.child("extendsType")!, check, inner, bindings)) {
        for (const [name, type] of bindings) inner.declareType(name, new TypeSymbol(type, node))
        return c.resolveType(node.child("trueType")!, inner)
    }
    return c.resolveType(node.child("falseType")!, inner)
}

/** `T extends U ? X : Y`, distributed over a union when T is a type parameter, as in TypeScript. */
export function conditionalType(c: Checker, node: Node, scope: Scope): Type | null {
    const checkNode = node.child("checkType")!
    const check = c.resolveType(checkNode, scope)
    if (check === null) return null
    if (!isTypeParameter(checkNode, scope)) return conditionalBranch(c, node, check, null, scope)
    const name = checkNode.child("typeName")!
    const results: Type[] = []
    for (const m of membersOf(check).filter((t) => t.kind !== "never")) {
        const result = conditionalBranch(c, node, m, name, scope)
        if (result === null) return null
        results.push(result)
    }
    return results.length === 0 ? types.never : c.unionOf(results)
}

/**
 * The fields whose `?` and `readonly` a mapped type keeps, as TypeScript's
 * homomorphic mapped types: those of T for keys `keyof T`, or for fields of
 * type `T[K]` (as `Pick<T, K>` has).
 */
function homomorphicSource(c: Checker, keysNode: Node, valueNode: Node | null, parameter: Node, scope: Scope): Field[] {
    let sourceNode: Node | null = null
    if (keysNode.kind === "TypeOperator" && c.text(keysNode).startsWith("keyof")) sourceNode = typeNode(keysNode)
    else if (valueNode !== null && valueNode.kind === "IndexedAccessType") {
        const index = valueNode.child("indexType")!
        if (index.kind === "TypeReference" && c.text(index) === nameNode(parameter).text)
            sourceNode = valueNode.child("objectType")
    }
    if (sourceNode === null) return []
    const source = c.resolveType(sourceNode, scope)
    return source !== null && source.kind === "struct" ? source.fields : []
}

/** `{ readonly [K in Keys as Name]?: X }`: an object type with a field for each key. */
export function mappedType(c: Checker, node: Node, scope: Scope): Type | null {
    const parameter = node.child("typeParameter")!
    const keysNode = constraint(parameter)!
    // Over `keyof T` of an array, the elements are mapped; of a type without fields, it is that type, as in TypeScript.
    if (keysNode.kind === "TypeOperator" && c.text(keysNode).startsWith("keyof")) {
        const source = c.resolveTypeArgument(typeNode(keysNode)!, scope)
        if (source === null) return null
        if (source.kind === "array") {
            const valueNode = typeNode(node)
            if (valueNode === null) return source
            const inner = new Scope(scope)
            inner.declareType(nameNode(parameter).text, new TypeSymbol(types.f64, parameter))
            const elem = c.resolveValueType(valueNode, inner)
            return elem === null ? null : arrayOf(elem)
        }
        if (source.kind !== "struct" && source.kind !== "interface") return source
    }
    const keys = c.resolveType(keysNode, scope)
    if (keys === null) return null
    const valueNode = typeNode(node)
    if (valueNode === null) {
        c.error(node, "A mapped type needs the type of its fields: '{ [K in Keys]: T }'.")
        return null
    }
    const source = homomorphicSource(c, keysNode, valueNode, parameter, scope)
    const readonlyToken = node.child("readonlyToken")
    const questionToken = node.child("questionToken")
    const fields: Field[] = []
    for (const key of membersOf(keys).filter((t) => t.kind !== "never")) {
        if (key.kind !== "literal") {
            c.error(
                keysNode,
                `The keys of a mapped type are string literal types, not '${typeToString(key)}'; for any string, use a Map.`,
            )
            return null
        }
        const inner = new Scope(scope)
        inner.declareType(nameNode(parameter).text, new TypeSymbol(key, parameter))
        let name = key.value
        const nameType = node.child("nameType")
        if (nameType !== null) {
            const renamed = c.resolveType(nameType, inner)
            if (renamed === null) return null
            if (renamed.kind === "never") continue
            if (renamed.kind !== "literal") {
                c.error(nameType, `A key of a mapped type is a string literal type, not '${typeToString(renamed)}'.`)
                return null
            }
            name = renamed.value
        }
        // A field can be `never` here: `{ [K in keyof T]: ... ? K : never }[keyof T]`.
        let type = c.resolveType(valueNode, inner)
        if (type === null) return null
        let optional = false
        let isReadonly = false
        for (const f of source) {
            if (f.name !== key.value) continue
            optional = f.optional
            isReadonly = f.readonly
        }
        const wasOptional = optional
        if (questionToken !== null) optional = questionToken.kind !== "MinusToken"
        if (readonlyToken !== null) isReadonly = readonlyToken.kind !== "MinusToken"
        if (optional) type = c.unionOf([type, types.null])
        else if (wasOptional) type = c.withoutNull(type)
        const field = new Field(name, type, isReadonly)
        field.optional = optional
        fields.push(field)
    }
    return c.shape(fields)
}

/** The text of a part of a template literal type, without its `` ` ``, `${` and `}`. */
function templateText(c: Checker, token: Node): string {
    let text = c.text(token)
    if (text.startsWith("`") || text.startsWith("}")) text = text.slice(1)
    if (text.endsWith("${")) text = text.slice(0, text.length - 2)
    else if (text.endsWith("`")) text = text.slice(0, text.length - 1)
    return text
}

/** `` `on${K}` ``: the union of the strings it makes of string literal types; `string` with any other type in it. */
export function templateLiteralType(c: Checker, node: Node, scope: Scope): Type | null {
    let strings = [templateText(c, node.child("head")!)]
    for (const span of node.list("templateSpans")) {
        const type = c.resolveType(span.child("type")!, scope)
        if (type === null) return null
        const tail = templateText(c, span.child("literal")!)
        const next: string[] = []
        for (const m of membersOf(type)) {
            let text = ""
            if (m.kind === "literal") text = m.value
            else if (m.kind === "number-literal") text = m.value
            else return types.string
            for (const s of strings) next.push(s + text + tail)
        }
        strings = next
    }
    const literals: Type[] = []
    for (const s of strings) literals.push(c.literal(s))
    return c.unionOf(literals)
}

/** `Uppercase<S>` and the other intrinsic string types, of a string literal type or a union of them. */
export function intrinsicType(c: Checker, name: string, args: Type[], node: Node): Type | null {
    if (name !== "Uppercase" && name !== "Lowercase" && name !== "Capitalize" && name !== "Uncapitalize") {
        c.error(node, "'intrinsic' is only the type of Uppercase, Lowercase, Capitalize and Uncapitalize.")
        return null
    }
    const literals: Type[] = []
    for (const m of membersOf(args[0])) {
        // The constraint `S extends string` leaves string types only.
        if (m.kind !== "literal") return types.string
        const v = m.value
        if (name === "Uppercase") literals.push(c.literal(v.toUpperCase()))
        else if (name === "Lowercase") literals.push(c.literal(v.toLowerCase()))
        else if (name === "Capitalize") literals.push(c.literal(v.slice(0, 1).toUpperCase() + v.slice(1)))
        else literals.push(c.literal(v.slice(0, 1).toLowerCase() + v.slice(1)))
    }
    return c.unionOf(literals)
}
