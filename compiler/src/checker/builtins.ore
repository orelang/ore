// The root scope: the declarations of runtime/std/builtin.d.ore.

import builtinText from "../../../runtime/std/builtin.d.ore" with { type: "text" }
import { type Expr, BuiltinCall, FloatLit, StringLit } from "../ir/nodes"
import { type Type, arrayOf, types } from "../ir/types"
import { type Node } from "../syntax/ast"
import {
    body,
    declarationList,
    declarations,
    isIdentifier,
    nameNode,
    optionalName,
    statements,
    typeNode,
} from "../syntax/nodes"
import { parse } from "../syntax/parse"
import { type Source } from "../syntax/source"
import { Typed } from "./operand"
import {
    type ValueSymbol,
    BuiltinSymbol,
    ConstSymbol,
    ConversionSymbol,
    NamespaceSymbol,
    Scope,
    TypeSymbol,
} from "./symbols"

const constantZero = ""

/** Values of built-in constants, declared without values in builtin.d.ore. */
function constant(name: string): f64 | null {
    if (name === "Math.PI") return Math.PI
    if (name === "Math.E") return Math.E
    // Computed, since the compiler that builds this one may not know these constants.
    const zero = f64(constantZero.length)
    if (name === "Number.NaN") return zero / zero
    if (name === "Number.POSITIVE_INFINITY") return 1.0 / zero
    if (name === "Number.NEGATIVE_INFINITY") return -1.0 / zero
    if (name === "Number.MAX_VALUE") return 1.7976931348623157e308
    if (name === "Number.MIN_VALUE") return 5e-324
    if (name === "Number.EPSILON") return 2.220446049250313e-16
    if (name === "Number.MAX_SAFE_INTEGER") return 9007199254740991.0
    if (name === "Number.MIN_SAFE_INTEGER") return -9007199254740991.0
    return null
}

/** The platform the compiler builds for: the one it runs on. */
function targetConstant(name: string): string | null {
    if (name === "target.os") return target.os
    if (name === "target.arch") return target.arch
    return null
}

/**
 * The runtime module that implements a built-in namespace in Ore, or null:
 * its exports are members of the namespace, as `fs.stat` or `fs.FileInfo`.
 * A nested namespace, named by its path, has a module of its own:
 * `process.command.run` is the export `run` of "ore:runtime/process-command".
 */
export function namespaceModule(ns: string): string | null {
    if (ns === "String") return "ore:runtime/string"
    if (ns === "fs") return "ore:runtime/fs"
    if (ns === "process") return "ore:runtime/process"
    if (ns === "process.command") return "ore:runtime/process-command"
    if (ns === "Number") return "ore:runtime/number"
    return null
}

/** The namespaces that `namespaceModule` maps, in order. */
export const namespaceNames = ["String", "fs", "process", "process.command", "Number"]

/** The runtime module whose classes `globalClasses` are global names, as `RegExp`. */
export const globalClassModule = "ore:runtime/regexp"

/** The runtime module whose generic type aliases are global names, as `Partial`. */
export const globalTypeModule = "ore:runtime/types"

/** Classes of the runtime written in Ore that every module sees, as JavaScript's globals. */
export const globalClasses = ["RegExp", "RegExpMatch"]

export class Builtins {
    constructor(
        readonly scope: Scope,
        readonly source: Source,
    ) {}
}

/**
 * Builds the root scope from the type aliases and functions of
 * `runtime/std/builtin.d.ore`. Its interfaces are declared by the checker.
 */
export function builtinScope(): Builtins {
    const parsed = parse("runtime/std/builtin.d.ore", builtinText)
    if (parsed.diagnostics.length > 0) process.panic(`invalid builtin.d.ore: ${parsed.diagnostics[0].message}`)
    const source = parsed.source
    const scope = new Scope()

    for (const stmt of statements(source.ast)) {
        if (stmt.kind === "TypeAliasDeclaration") {
            const name = nameNode(stmt).text
            const type = resolveBuiltinType(typeNode(stmt)!, scope, name)
            if (type !== null) scope.declareType(name, new TypeSymbol(type, stmt))
        } else if (stmt.kind === "FunctionDeclaration" && optionalName(stmt) !== null) {
            const name = nameNode(stmt).text
            const found = scope.lookupType(name)
            if (found === null) process.panic(`unknown builtin function ${name}`)
            scope.declareValue(name, new ConversionSymbol(found.type, stmt))
        } else if (isNamespace(stmt)) {
            const ns = nameNode(stmt).text
            scope.declareValue(ns, builtinNamespace(ns, stmt))
        }
    }
    return new Builtins(scope, source)
}

/** Whether a statement of builtin.d.ore declares a namespace: `declare namespace name { ... }`. */
function isNamespace(stmt: Node): bool {
    return (
        stmt.kind === "ModuleDeclaration" &&
        isIdentifier(nameNode(stmt)) &&
        body(stmt) !== null &&
        body(stmt)!.kind === "ModuleBlock"
    )
}

/**
 * The namespace `ns` (a dotted path when nested) declared by `decl`: its
 * functions, constants and nested namespaces, as `process.command`.
 */
function builtinNamespace(ns: string, decl: Node): NamespaceSymbol {
    const members = new Map<string, ValueSymbol>()
    for (const member of statements(body(decl)!)) {
        if (member.kind === "FunctionDeclaration" && optionalName(member) !== null) {
            members.set(nameNode(member).text, new BuiltinSymbol(`${ns}.${nameNode(member).text}`, member))
        } else if (isNamespace(member)) {
            const short = nameNode(member).text
            members.set(short, builtinNamespace(`${ns}.${short}`, member))
        } else if (member.kind === "VariableStatement") {
            for (const d of declarations(declarationList(member))) {
                const short = nameNode(d).text
                const name = `${ns}.${short}`
                const value = constant(name)
                const text = targetConstant(name)
                // A value known only at run time, such as `process.args`, is a call of a built-in.
                let expr: Expr
                if (value !== null) expr = new FloatLit(types.f64, value)
                else if (text !== null) expr = new StringLit(types.string, text)
                else expr = new BuiltinCall(arrayOf(types.string), name, [])
                if (value === null && text === null && name !== "process.args")
                    process.panic(`unknown builtin constant ${name}`)
                members.set(short, new ConstSymbol(new Typed(expr), expr.type, d))
            }
        }
    }
    return new NamespaceSymbol(ns, members, decl)
}

/** The built-in namespace at a dotted path, as `process.command`, or null. */
export function namespaceAtPath(scope: Scope, path: string): NamespaceSymbol | null {
    let found: NamespaceSymbol | null = null
    for (const name of path.split(".")) {
        const symbol = found === null ? scope.lookupValue(name) : found.members.get(name)
        if (symbol === null || symbol.k !== "namespace") return null
        found = symbol
    }
    return found
}

function intrinsic(name: string): Type | null {
    switch (name) {
        case "i8":
            return types.i8
        case "i16":
            return types.i16
        case "i32":
            return types.i32
        case "i64":
            return types.i64
        case "u8":
            return types.u8
        case "u16":
            return types.u16
        case "u32":
            return types.u32
        case "u64":
            return types.u64
        case "f32":
            return types.f32
        case "f64":
            return types.f64
        case "bool":
            return types.bool
        case "SelectCase":
            return types.SelectCase
        case "ptr":
            return types.ptr
    }
    return null
}

function resolveBuiltinType(node: Node, scope: Scope, name: string): Type | null {
    // `type X = intrinsic` is parsed into a dedicated keyword node.
    if (node.kind === "IntrinsicKeyword") {
        const type = intrinsic(name)
        if (type === null) process.panic(`unknown intrinsic type ${name}`)
        return type
    }
    if (node.kind === "TypeReference") {
        const ref = node.child("typeName")
        if (ref !== null && isIdentifier(ref)) {
            const symbol = scope.lookupType(ref.text)
            return symbol === null ? null : symbol.type
        }
    }
    // Pseudo types such as `numeric` exist only to document built-in signatures.
    return null
}
