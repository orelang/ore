    templateSpans,
    templateText,
    whenFalse,
    whenTrue,
} from "../syntax/nodes"
import { bigIsNeg, bigLt, bigOf, bigText, bigToI64 } from "./bigint"
import { type Checker, structOrInterface } from "./base"
import { checkCall, checkNew } from "./calls"
import { accessor, checkAccess, conformance, declaringClass, dispatch, genericMethod } from "./classes"
import { type AssignTarget, AccessorTarget, AssignTarget as AssignTargetClass, Fact } from "./context"
import { foldBinary, foldUnary } from "./fold"
import {
    arithOps,
    numericType,
    poison,
    canBeNull,
    compareOps,
    compoundOps,
    fieldType,
    isNull,
    memberField,
    isString,
