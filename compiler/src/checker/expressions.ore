// Expressions: names, operators, assignments, literals, members and
// conversions between them.

import {
    type Expr,
    type LValue,
    ArrayLit,
    Assign,
    Arith,
    Bind,
    BindLocal,
    BoolLit,
    BoundMethod,
    Coalesce,
    Compare,
    Concat,
    Conditional,
    ElementLValue,
    FieldGet,
    FieldInit,
    FieldLValue,
    FloatLit,
    FuncRef,
    IfaceField,
    IfaceFieldLValue,
    UnionFieldLValue,
    IncDec,
    Index,
    IntLit,
    Is,
    IsNull,
    Len,
    Local,
    LocalLValue,
    LocalRef,
    Logical,
    MapOp,
    SetOp,
    MethodCall,
    Not,
    ObjectLit,
    Optional,
    Recast,
    Seq,
    StringLit,
    TypeOf,
    Unary,
    UnionField,
    type ArithOp,
    type CompareOp,
} from "../ir/nodes"
import {
    type ArrayType,
    type InterfaceType,
    type StructType,
    type Type,
    type UnionType,
    Field,
    arrayOf,
    findField,
    findMethod,
    isNumeric,
    isSubclass,
    isStringLike,
