/**
 * Checks an expression. `expected` is the type required by the context; it
 * only guides literals whose type cannot be inferred alone, like `[]`.
 */
export function checkExpr(c: Checker, node: Node, scope: Scope, expected: Type | null = null): Operand {
    const result = checkExprInner(c, node, scope, expected)
    if (result.k === "typed") c.info.types.set(node, typeOf(result.expr))
    else if (result.k !== "error") c.info.types.set(node, c.defaultType(result))
    return result
}

/** The text of a string literal or template literal without substitutions: `node.text`. */
export function literalText(node: Node): string {
    return node.kind === "NoSubstitutionTemplateLiteral" ? templateText(node) : stringText(node)
}

function checkExprInner(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    const k = node.kind
    if (k === "SpreadPart") return c.presets.get(node) ?? errorOperand
    if (k === "ParenthesizedExpression") return checkExpr(c, expression(node), scope, expected)
    if (k === "ArrayLiteralExpression") return checkArrayLiteral(c, node, scope, expected)
    if (k === "ObjectLiteralExpression") return checkObjectLiteral(c, node, scope, expected)
    // The source spelling decides int vs float.
    if (k === "NumericLiteral") return numericLiteral(c.text(node))
    if (k === "BigIntLiteral") return typed(bigintLiteral(c.text(node)))
    if (k === "StringLiteral" || k === "NoSubstitutionTemplateLiteral")
        return typed(new StringLit(types.string, literalText(node)))
    if (k === "TrueKeyword" || k === "FalseKeyword") return typed(new BoolLit(types.bool, k === "TrueKeyword"))
    if (k === "RegularExpressionLiteral") return checkRegExpLiteral(c, node)
    if (isIdentifier(node)) return checkIdentifier(c, node, scope)
    if (k === "ThisKeyword") {
        const fn = c.fn
        const self = fn !== null ? fn.thisLocal : null
        const inStatic = c.staticClass
        // `this` directly in a field initializer; arrow functions there capture it.
        if (fn !== null && fn.fieldInit && fn.closure === null)
            return c.fail(node, "Field initializers cannot use 'this'.")
        // At the top level of a module and in its arrow functions, `this` is null (`undefined` in JavaScript).
        if (self === null && fn !== null && fn.nullThis && inStatic === null) return typed(new NullLit(types.null))
        if (self === null)
            return c.fail(
                node,
                fn !== null && fn.fieldInit
                    ? "Field initializers cannot use 'this'."
                    : inStatic !== null
                      ? `A static method or block has no 'this'; name the class: '${inStatic}.name'.`
                      : "'this' can only be used inside a class.",
            )
        capture(self, fn!.thisCaptures ?? [])
        return typed(new LocalRef(self.type, self))
    }
    if (k === "SuperKeyword")
        return c.fail(
            node,
            "'super' can only call the constructor or a method of the base class: 'super(...)' or 'super.m(...)'.",
        )
    if (k === "NewExpression") return checkNew(c, node, scope, expected)
    if (k === "BinaryExpression") {
        const op = operatorToken(node).kind
        if (op === "AmpersandAmpersandToken" || op === "BarBarToken") return typed(condition(c, node, scope).expr)
        return checkBinary(c, node, scope)
    }
    if (k === "PrefixUnaryExpression") return checkPrefixUnary(c, node, scope)
    if (k === "PostfixUnaryExpression")
        return checkIncDec(c, operand(node), postfixOperator(node, c.sourceOf(node).text), false, scope)
    if (k === "CallExpression") return checkCall(c, node, scope, expected)
    if (k === "ConditionalExpression") return checkConditional(c, node, scope, expected)
    if (k === "SatisfiesExpression") {
        // The value is checked against the type, as its context, and keeps its own type.
        const type = c.resolveValueType(node.child("type")!, scope)
        const value = checkExpr(c, expression(node), scope, type)
        if (type !== null && value.k !== "error") c.coerce(value, type, expression(node))
        return value
    }
    if (k === "AsExpression") {
        const asType = node.child("type")!
        if (asType.kind === "TypeReference" && c.text(asType) === "const") {
            const type = constType(c, expression(node), scope)
            if (type === null) return errorOperand
            const value = checkExpr(c, expression(node), scope, type)
            if (value.k === "error") return value
            return typed(c.coerce(value, type, expression(node)))
        }
        return c.fail(node, "Type assertions are not supported in Ore. Use a conversion such as 'i32(x)'.")
    }
    if (k === "TemplateExpression") return checkTemplate(c, node, scope)
    if (k === "TaggedTemplateExpression") return checkTaggedTemplate(c, node, scope, expected)
    if (k === "PropertyAccessExpression") return checkProperty(c, node, scope)
    if (k === "ElementAccessExpression") return checkElement(c, node, scope)
    if (k === "NullKeyword") return typed(nullOperand)
    if (k === "NonNullExpression") return checkNonNull(c, node, scope)
    if (k === "ArrowFunction" || k === "FunctionExpression") return checkClosure(c, node, scope, expected)
    if (k === "TypeOfExpression") {
        const value = checkExpr(c, expression(node), scope)
        if (value.k === "error") return value
        return typed(new TypeOf(types.string, c.toDefault(value, expression(node))))
    }
    if (k === "AwaitExpression") return checkAwait(c, node, scope, expected)
    if (k === "YieldExpression") return checkYield(c, node, scope)
    if (k === "DeleteExpression") return checkDelete(c, node, scope)
    return c.fail(node, "This expression is not supported yet.")
}

export function checkIdentifier(c: Checker, node: Node, scope: Scope): Operand {
    const found = scope.lookupCapturing(node.text)
    if (found === null) {
        if (node.text === "undefined") return c.fail(node, "'undefined' is not supported in Ore. Use 'null'.")
        return c.fail(node, unknownName(node.text))
    }
    const symbol = found.symbol
    if (symbol.k === "local") capture(symbol.local, found.closures)
    c.info.definitions.set(node, symbol.decl)
    return symbolValue(c, symbol, node)
}

/** The value of a symbol named by `node`, or an error for names that are not values. */
export function symbolValue(c: Checker, symbol: ValueSymbol, node: Node): Operand {
    switch (symbol.k) {
        case "local": {
            const local = symbol.local
            if (c.poisoned.has(local)) return errorOperand
            if (c.untyped.has(local)) {
                // Its type comes from its first assignment, which has not been seen yet.
                c.readEarly.add(local)
                return c.readBeforeAssigned(node, local)
            }
            const ref = new LocalRef(local.type, local)
            if (c.unassigned.has(local)) c.refNodes.set(ref, node)
            return typed(narrowed(c, `L${local.id}`, ref))
        }
        case "const":
            return symbol.value
        case "class":
            return c.fail(node, `'${node.text}' is a class. Create an instance with 'new ${node.text}(...)'.`)
        case "generic-func":
            if (symbol.generic.closure !== null)
                return c.fail(
                    node,
                    "A generic function value must be instantiated: give its type arguments or call it.",
                )
            return c.fail(node, `'${node.text}' is a generic function and cannot be used as a value.`)
        case "namespace": {
            if (symbol.name === "globalThis")
                return c.fail(node, "'globalThis' cannot be used as a value; use its members, as 'globalThis.Math'.")
            let first = ""
            for (const [name, _] of symbol.members) {
                first = name
                break
            }
            // Named by its path when nested: 'process.command'.
            return c.fail(
                node,
                `'${symbol.name}' is a namespace; call its functions, e.g. '${symbol.name}.${first}(...)'.`,
            )
        }
        case "module":
            return c.fail(node, `'${node.text}' is a module; use its exports, e.g. '${node.text}.name'.`)
        case "func":
            if (symbol.func.extern)
                return c.fail(node, `External function '${symbol.func.name}' cannot be used as a value.`)
            if (symbol.overloads !== null)
                return c.fail(
                    node,
                    `Function '${symbol.func.sourceName}' has overload signatures and cannot be used as a value.`,
                )
            if (!inferGenerator(c, symbol.func, node)) return errorOperand
            return typed(new FuncRef(symbol.func.type, symbol.func))
        default:
            return c.fail(node, `'${node.text}' is a function and cannot be used as a value yet.`)
    }
}

export function checkBinary(c: Checker, node: Node, scope: Scope): Operand {
    const opNode = operatorToken(node)
    const op = opNode.kind
    if (op === "EqualsToken") return checkAssign(c, node, null, scope)
    if (op === "QuestionQuestionEqualsToken") return checkLogicalAssign(c, node, "??", scope)
    if (op === "BarBarEqualsToken") return checkLogicalAssign(c, node, "||", scope)
    if (op === "AmpersandAmpersandEqualsToken") return checkLogicalAssign(c, node, "&&", scope)
    const compound = compoundOps.get(op)
    if (compound !== null) return checkAssign(c, node, compound, scope)

    if (op === "EqualsEqualsToken" || op === "ExclamationEqualsToken") {
        const strict = op === "EqualsEqualsToken" ? "===" : "!=="
        return c.fail(opNode, `'${c.text(opNode)}' is not supported in Ore. Use '${strict}'.`)
    }
    if (op === "GreaterThanGreaterThanGreaterThanToken")
        return c.fail(opNode, "'>>>' is not supported in Ore. Use '>>' on an unsigned type.")
    if (op === "AmpersandAmpersandToken" || op === "BarBarToken") {
        const l = checkCondition(c, left(node), scope)
        const r = checkCondition(c, right(node), scope)
        return typed(new Logical(types.bool, op === "AmpersandAmpersandToken" ? "&&" : "||", l, r))
    }
    const arithOp = arithOps.get(op)
    if (arithOp !== null)
        return arith(c, arithOp, checkExpr(c, left(node), scope), checkExpr(c, right(node), scope), node)
    const compareOp = compareOps.get(op)
    if (compareOp !== null)
        return compare(
            c,
            compareOp,
            checkExpr(c, left(node), scope),
            checkExpr(c, right(node), scope),
            opNode,
            left(node),
            right(node),
        )
    if (op === "CommaToken") return c.fail(opNode, "The comma operator is not supported in Ore.")
    if (op === "QuestionQuestionToken") return checkCoalesce(c, node, scope)
    if (op === "InstanceOfKeyword") return checkInstanceOf(c, node, scope)
    if (op === "InKeyword") return checkIn(c, left(node), right(node), scope)
    return c.fail(opNode, `Operator '${c.text(opNode)}' is not supported.`)
}

export function arith(c: Checker, op: ArithOp, l_: Operand, r_: Operand, node: Node): Operand {
    if (l_.k === "error" || r_.k === "error") return errorOperand
    const l = widened(l_)
    const r = widened(r_)
    const opNode = operatorToken(node)
    const shift = op === "<<" || op === ">>"

    const ul = untypedOf(l)
    const ur = untypedOf(r)
    if (ul !== null && ur !== null) {
        const folded = foldBinary(op, ul, ur)
        if (typeof folded === "string") return c.fail(opNode, folded)
        return folded
    }

    // Shifts of bigints take a bigint count, as the other operators.
    if (shift && !isBigInt(l) && !isBigInt(r)) {
        const le = l.k === "typed" ? l.expr : c.toDefault(l, left(node))
        const re = r.k === "typed" ? r.expr : c.coerce(r, types.u64, right(node))
        const lt = typeOf(le)
        const rt = typeOf(re)
        if (lt.kind !== "int" || rt.kind !== "int") {
            return c.fail(
                opNode,
                `Operator '${op}' requires integer operands, got '${typeToString(lt)}' and '${typeToString(rt)}'.`,
            )
        }
        return typed(new Arith(lt, op, le, re))
    }

    if (op === "+" && (isString(l) || isString(r))) {
        if (!isString(l) || !isString(r))
            return c.fail(opNode, "Only strings can be concatenated with '+'. Use a template literal: `${a}${b}`.")
        return typed(new Concat(types.string, [typedExpr(l), typedExpr(r)]))
    }
    const unified = c.unify(l, r, left(node), right(node))
    const le = unified.left
    const re = unified.right
    if (le === null || re === null) return errorOperand
    const type = typeOf(le)
    if (!sameType(type, typeOf(re))) {
        return c.fail(
            opNode,
            `Operator '${op}' cannot be applied to types '${typeToString(type)}' and '${typeToString(typeOf(re))}'. Convert one side explicitly, e.g. '${conversionName(type)}(x)'.`,
        )
    }
    if (type.kind === "string" && op === "+") return typed(new Concat(types.string, [le, re]))
    if (type.kind === "int") return typed(new Arith(type, op, le, re))
    if (type.kind === "bigint") return typed(new Arith(type, op, le, re))
    if (type.kind === "float") {
        if (op === "&" || op === "|" || op === "^")
            return c.fail(opNode, `Operator '${op}' requires integer operands, got '${type.name}'.`)
        return typed(new Arith(type, op, le, re))
    }
    return c.fail(opNode, `Operator '${op}' cannot be applied to type '${typeToString(type)}'.`)
}

/** An operand of a numeric literal type, or a union of them, as a `number`: arithmetic and comparisons see numbers. */
export function widened(value: Operand): Operand {
    if (value.k === "typed" && isNumberLiterals(value.expr.type)) return typed(new Recast(types.f64, value.expr))
    return value
}

/** Whether an operand is a `bigint` value. */
function isBigInt(value: Operand): bool {
    return value.k === "typed" && value.expr.type.kind === "bigint"
}

/** The expression of a typed operand. */
function typedExpr(value: Operand): Expr {
    if (value.k !== "typed") process.panic("typedExpr: not typed")
    return value.expr
}

function isEquatable(type: Type): bool {
    if (isNumeric(type)) return true
    const k = type.kind
    return (
        k === "bool" ||
        k === "string" ||
        k === "bigint" ||
        k === "unknown" ||
        k === "array" ||
        k === "struct" ||
        k === "interface" ||
        k === "union" ||
        k === "map" ||
        k === "set" ||
        k === "literal" ||
        k === "func" ||
        k === "ptr" ||
        k === "chan"
    )
}

/** Whether a type is a string literal type or a union of them: `"x" | "y"`. */
function isStringLiterals(type: Type): bool {
    if (type.kind === "literal") return true
    return type.kind === "union" && type.members.every((m) => m.kind === "literal")
}

export function compare(
    c: Checker,
    op: CompareOp,
    l_: Operand,
    r_: Operand,
    opNode: Node,
    leftNode: Node,
    rightNode: Node,
): Operand {
    if (l_.k === "error" || r_.k === "error") return errorOperand
    const l = widened(l_)
    const r = widened(r_)
    const ul = untypedOf(l)
    const ur = untypedOf(r)
    if (ul !== null && ur !== null) {
        const folded = foldBinary(op, ul, ur)
        if (typeof folded === "string") return c.fail(opNode, folded)
        return folded
    }
    // Comparing with null tests a nullable value.
    if ((op === "===" || op === "!==") && (isNull(l) || isNull(r))) {
        // Not widened: a narrowed reference is tested through its declared type.
        const other = isNull(l) ? r_ : l_
        if (other.k !== "typed") return c.fail(opNode, "A constant cannot be null.")
        const oe = other.expr
        const value = oe.k === "recast" && canBeNull(oe.value.type) ? oe.value : oe
        if (!canBeNull(value.type)) {
            return c.fail(
                opNode,
                `Type '${typeToString(value.type)}' cannot be null, so this comparison is always ${op === "!=="}.`,
            )
        }
        const test: Expr = new IsNull(types.bool, value)
        return typed(op === "===" ? test : new Not(types.bool, test))
    }
    const unified = c.unify(l, r, leftNode, rightNode)
    const ul2 = unified.left
    const ur2 = unified.right
    if (ul2 === null || ur2 === null) return errorOperand
    let le: Expr = ul2
    let re: Expr = ur2
    // Two string constants, such as `target.os === "darwin"`, compare at compile time.
    if ((op === "===" || op === "!==") && le.k === "string" && re.k === "string") {
        return typed(new BoolLit(types.bool, (le.value === re.value) === (op === "===")))
    }
    // String literal types compare with a string: a constant takes their type, which reports one
    // that cannot be equal (`u === "z"` for `"x" | "y"`); any other string compares as a string.
    if (re.type.kind === "string" && isStringLiterals(le.type)) {
        if (re.k === "string") re = c.coerce(typed(re), le.type, rightNode)
        else le = new Recast(types.string, le)
    } else if (le.type.kind === "string" && isStringLiterals(re.type)) {
        if (le.k === "string") le = c.coerce(typed(le), re.type, leftNode)
        else re = new Recast(types.string, re)
    }
    // Any value compares with an `unknown`, boxed: equal when it has the same type and value.
    else if (!sameType(le.type, re.type) && re.type.kind === "unknown") le = c.coerce(typed(le), re.type, leftNode)
    else if (!sameType(le.type, re.type) && le.type.kind === "unknown") re = c.coerce(typed(re), le.type, rightNode)
    // A member compares with a union containing it.
    else if (!sameType(le.type, re.type) && re.type.kind === "union") le = c.coerce(typed(le), re.type, leftNode)
    else if (!sameType(le.type, re.type) && le.type.kind === "union") re = c.coerce(typed(re), le.type, rightNode)
    // `true` and `false` compare with any boolean, as `bool`.
    if (le.type.kind === "bool" && re.type.kind === "bool" && le.type !== re.type) {
        if (le.type !== types.bool) le = new Recast(types.bool, le)
        if (re.type !== types.bool) re = new Recast(types.bool, re)
    }
    const type = typeOf(le)
    // Instances of a class and of a subclass compare by identity.
    const lt = le.type
    const rt = re.type
    const related = lt.kind === "struct" && rt.kind === "struct" && (isSubclass(lt, rt) || isSubclass(rt, lt))
    if (!sameType(type, typeOf(re)) && !related)
        return c.fail(opNode, `Cannot compare '${typeToString(type)}' with '${typeToString(typeOf(re))}'.`)
    const ordered = op !== "===" && op !== "!=="
    if (ordered ? !(isNumeric(type) || type.kind === "string" || type.kind === "bigint") : !isEquatable(type)) {
        return c.fail(opNode, `Operator '${op}' cannot be applied to type '${typeToString(type)}'.`)
    }
    return typed(new Compare(types.bool, op, le, re))
}

export function checkAssign(c: Checker, node: Node, op: ArithOp | null, scope: Scope): Operand {
    const result = checkAssignInner(c, node, op, scope)
    const key = refKey(c, left(node), scope)
    if (key !== null) {
        invalidate(c, key)
        // After `x = value`, x has the type of the value until it changes again.
        const assigned = c.info.types.get(right(node))
        if (op === null && result.k === "typed" && assigned !== null)
            narrowTo(c, key, result.expr.type, assigned, right(node))
    }
    return result
}

/**
 * `x ??= v` assigns `v` only when `x` is null, `x ||= v` only when the
 * boolean `x` is false, `x &&= v` only when it is true; the target is
 * evaluated once, and the expression is the value `x` ends with.
 */
function checkLogicalAssign(c: Checker, node: Node, op: string, scope: Scope): Operand {
    const target = assignTarget(c, left(node), scope, op === "??")
    if (target === null) return errorOperand
    const entry = target.entry
    if (entry !== null) {
        // `||=` and `&&=` of a required named entry, which is there to read.
        if (op !== "??") {
            if (target.type.kind !== "bool")
                return c.fail(left(node), `Operator '${op}=' needs a boolean, got '${typeToString(target.type)}'.`)
            const condition = checkCondition(c, right(node), scope)
            const logical: "&&" | "||" = op === "||" ? "||" : "&&"
            return entryUpdate(c, entry, node, (old) => new Logical(types.bool, logical, old, condition), false)
        }
        const member = entry.member
        if (member !== null && !member.optional && !canBeNull(member.type))
            return c.fail(left(node), `Type '${typeToString(member.type)}' cannot be null; '??=' is not needed.`)
        const value = checkExpr(c, right(node), scope, target.type)
        if (value.k === "error") return value
        return typed(dictCoalesceAssign(c, entry, value, right(node)))
    }
    if (target.accessor !== null)
        return c.fail(left(node), `'${op}=' cannot assign to an accessor; write 'x = x ${op} v'.`)
    // The parts of the target, held so that they are evaluated once.
    const locals: BindLocal[] = []
    const hold = (value: Expr): Expr => {
        const local = c.newLocal("tmp", value.type, false)
        locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
    const notField = `'${op}=' cannot assign to a field of an interface or a union; write 'x = x ${op} v'.`
    let type = target.type
    let read: Expr
    let write: (value: Expr) => Expr | null
    const keyed = target.keyed
    if (keyed !== null) {
        // By a `keyof` key: the member the key names, read and written through the held object.
        const common = keyedType(keyed)
        if (common === null)
            return c.fail(left(node), `Operator '${op}=' cannot be applied to type '${typeToString(target.type)}'.`)
        type = common
        for (const t of keyed.targets) {
            if (t.accessor !== null)
                return c.fail(left(node), `'${op}=' cannot assign to an accessor; write 'x = x ${op} v'.`)
            if (t.lvalue!.k !== "field") return c.fail(left(node), notField)
        }
        const field = (t: AssignTarget, make: (place: FieldLValue) => Expr): Operand => {
            const place = t.lvalue!
            return place.k === "field" ? typed(make(place)) : errorOperand
        }
        for (const l of keyed.locals) locals.push(l)
        read = chooseKeyed(c, keyed, common, node, (t) => field(t, (p) => new FieldGet(common, p.object, p.name)))!
        write = (value) => chooseKeyed(c, keyed, common, node, (t) => field(t, (p) => new Assign(common, p, value)))
    } else {
        const place = target.lvalue!
        if (place.k === "local" && c.untyped.has(place.local)) {
            c.readEarly.add(place.local)
            return c.readBeforeAssigned(left(node), place.local)
        }
        let lvalue: LValue
        if (place.k === "local") {
            lvalue = place
            read = new LocalRef(type, place.local)
        } else if (place.k === "element") {
            const array = hold(place.array)
            const index = hold(place.index)
            lvalue = new ElementLValue(array, index)
            read = new Index(type, array, index)
        } else if (place.k === "field") {
            const object = hold(place.object)
            lvalue = new FieldLValue(object, place.name)
            read = new FieldGet(type, object, place.name)
        } else {
            return c.fail(left(node), notField)
        }
        write = (value) => new Assign(type, lvalue, value)
    }
    let result: Expr
    if (op === "??") {
        if (!canBeNull(type))
            return c.fail(left(node), `Type '${typeToString(type)}' cannot be null; '??=' is not needed.`)
        const nonNull = c.withoutNull(type)
        const value = checkExpr(c, right(node), scope, nonNull)
        if (value.k === "error") return errorOperand
        const fresh = c.newLocal("value", nonNull, false)
        const ref: Expr = new LocalRef(nonNull, fresh)
        const assign = write(c.coerce(typed(ref), type, right(node)))
        if (assign === null) return errorOperand
        const fallback: Expr = new Bind(
            nonNull,
            [new BindLocal(fresh, c.coerce(value, nonNull, right(node)))],
            new Seq(nonNull, [assign, ref]),
        )
        result = new Coalesce(nonNull, read, fallback)
    } else {
        if (type.kind !== "bool")
            return c.fail(left(node), `Operator '${op}=' needs a boolean, got '${typeToString(type)}'.`)
        const value = checkCondition(c, right(node), scope)
        let assign: Expr | null
        if (keyed !== null) {
            // The value is evaluated once, after the member is read.
            const fresh = c.newLocal("value", types.bool, false)
            const stored = write(new LocalRef(types.bool, fresh))
            assign = stored === null ? null : new Bind(types.bool, [new BindLocal(fresh, value)], stored)
        } else {
            assign = write(value)
        }
        if (assign === null) return errorOperand
        result = new Logical(types.bool, op === "||" ? "||" : "&&", read, assign)
    }
    const key = refKey(c, left(node), scope)
    if (key !== null) {
        invalidate(c, key)
        if (op === "??") narrowTo(c, key, type, c.withoutNull(type))
    }
    return typed(locals.length > 0 ? new Bind(result.type, locals, result) : result)
}

/** Whether an expression is a name or a chain of property names, which can be checked twice without effects. */
function isNamePath(node: Node): bool {
    if (isIdentifier(node) || node.kind === "ThisKeyword") return true
    return node.kind === "PropertyAccessExpression" && questionDotToken(node) === null && isNamePath(expression(node))
}

/**
 * `array.length = n`, as JavaScript truncates an array to `n` elements; the
 * value is `n`. A negative length panics as JavaScript throws, and so does
 * a longer one: an Ore array has no holes to grow by. Null when the target
 * is not an array, which the assignment then reports.
 */
function assignLength(c: Checker, node: Node, target: Node, scope: Scope): Operand | null {
    const object = expression(target)
    if (!isNamePath(object)) return null
    const checked = checkExpr(c, object, scope)
    if (checked.k !== "typed" || checked.expr.type.kind !== "array") return null
    const array = checked.expr
    const n = c.coerce(checkExpr(c, right(node), scope, types.i64), types.i64, right(node))
    const local = c.newLocal("length", types.i64, false)
    const ref: Expr = new LocalRef(types.i64, local)
    const truncate: Expr = new ArrayMethod("length=", types.void, array, [ref])
    return typed(new Bind(types.i64, [new BindLocal(local, n)], new Seq(types.i64, [truncate, ref])))
}

/** The locals of a `Bind` built while writing an accessor. */
class Holder {
    readonly locals: BindLocal[] = []

    hold(c: Checker, value: Expr): Expr {
        const local = c.newLocal("tmp", value.type, false)
        this.locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
}

/**
 * Writes an accessor property: evaluates the object once, computes the new
 * value from the old one (read by the getter, when `usesOld`), calls the
 * setter, and evaluates to the new value, or the old one for `x++`.
 */
export function writeAccessor(
    c: Checker,
    target: AssignTarget,
    node: Node,
    next: (old: () => Expr) => Expr | null,
    yieldOld: bool,
    usesOld: bool,
): Operand {
    const access = target.accessor!
    const property = access.property
    const type = property.type
    const holder = new Holder()
    const self = holder.hold(c, access.object)
    let old: Expr | null = null
    const getOld = (): Expr => {
        if (old === null) old = holder.hold(c, callGetter(property, access.name, self))
        return old
    }
    if ((yieldOld || usesOld) && !property.hasGet)
        return c.fail(node, `Property '${access.name}' has a setter but no getter.`)
    if (yieldOld) getOld()
    const value = next(getOld)
    if (value === null) return errorOperand
    const result = holder.hold(c, value)
    const set = callSetter(property, access.name, self, result)
    return typed(new Bind(type, holder.locals, new Seq(type, [set, yieldOld ? old! : result])))
}

/** Gives a variable declared without a type the type of its first assigned value. */
export function settle(c: Checker, local: Local, value: Operand, node: Node): bool {
    if (value.k === "error") return false
    const type = typeOf(c.toDefault(value, node))
    if (type.kind === "void" || type.kind === "never" || type.kind === "null") {
        c.error(
            node,
            `Cannot infer the type of '${local.name}' from this value. Add a type annotation, e.g. 'let ${local.name}: T'.`,
        )
        c.readEarly.add(local)
        return false
    }
    local.type = type
    c.untyped.delete(local)
    c.info.types.set(c.declNodes.get(local)!, type)
    return true
}

/**
 * Adds a fact that a reference of a union type holds a value of a narrower
 * type. A literal `value` stored into a union with its literal type narrows
 * to that literal: after `const k: "id" | "label" = "label"`, k is "label".
 */
export function narrowTo(c: Checker, key: string, declared: Type, actual_: Type, value: Node | null = null) {
    if (declared.kind !== "union") return
    const literal = value !== null ? literalMember(c, declared, value) : null
    const actual = literal ?? actual_
    if (sameType(declared, actual) || actual.kind === "null") return
    const members_ = declared.members
    if (membersOf(actual).every((a) => members_.some((m) => sameType(m, a)))) addFacts(c, [new Fact(key, actual)])
}

/** The literal type of a literal value that is a member of a union: `"label"`, `-1` or `true`, or null. */
function literalMember(c: Checker, union: UnionType, node: Node): Type | null {
    if (node.kind === "ParenthesizedExpression") return literalMember(c, union, expression(node))
    const k = node.kind
    let literal: Type | null = null
    if (k === "StringLiteral" || k === "NoSubstitutionTemplateLiteral") literal = c.literal(literalText(node))
    else if (k === "NumericLiteral") literal = c.numberLiteral(c.text(node))
    else if (k === "TrueKeyword") literal = types.boolTrue
    else if (k === "FalseKeyword") literal = types.boolFalse
    else if (
        k === "PrefixUnaryExpression" &&
        prefixOperator(node, c.sourceOf(node).text) === "-" &&
        operand(node).kind === "NumericLiteral"
    )
        literal = c.numberLiteral(`-${c.text(operand(node))}`)
    const found = literal
    return found !== null && union.members.some((m) => sameType(m, found)) ? found : null
}

function checkAssignInner(c: Checker, node: Node, op: ArithOp | null, scope: Scope): Operand {
    const target_ = left(node)
    if (op === null && (target_.kind === "ArrayLiteralExpression" || target_.kind === "ObjectLiteralExpression"))
        return checkDestructuringAssign(c, node, scope)
    if (op === null && target_.kind === "PropertyAccessExpression" && nameNode(target_).text === "length") {
        const truncated = assignLength(c, node, target_, scope)
        if (truncated !== null) return truncated
    }
    const target = assignTarget(c, target_, scope, op === null)
    // The first assignment of a variable declared without a type gives its type.
    const place = target !== null ? target.lvalue : null
    const untyped = place !== null && place.k === "local" && c.untyped.has(place.local) ? place.local : null
    if (untyped !== null && op !== null) {
        c.readEarly.add(untyped)
        return c.readBeforeAssigned(target_, untyped)
    }
    if (target !== null && target.keyed !== null) return assignKeyed(c, node, target, target.keyed, op, scope)
    const value = checkExpr(
        c,
        right(node),
        scope,
        op !== null || untyped !== null || target === null ? null : target.type,
    )
    if (target === null) return errorOperand
    if (untyped !== null) {
        if (!settle(c, untyped, value, right(node))) return errorOperand
        target.type = untyped.type
    }
    return store(c, node, target, value, right(node), op, c.declarationOf(target_))
}

/** Stores a value into the target of an assignment, or combines the old value with it by `op`. */
function store(
    c: Checker,
    node: Node,
    target: AssignTarget,
    value: Operand,
    valueNode: Node,
    op: ArithOp | null,
    decl: Node | null,
): Operand {
    const entry = target.entry
    if (entry !== null) {
        if (value.k === "error") return value
        if (op === null) return typed(dictAssign(c, entry, c.coerce(value, target.type, valueNode), valueNode))
        // A required named entry, read and changed.
        const compoundOp = op
        return entryUpdate(
            c,
            entry,
            node,
            (old) => {
                const combined = arith(c, compoundOp, typed(old), value, node)
                return combined.k === "typed" ? c.coerce(combined, target.type, node) : null
            },
            false,
        )
    }
    if (target.accessor !== null) {
        if (value.k === "error") return value
        if (op === null)
            return writeAccessor(c, target, node, (old) => c.coerce(value, target.type, valueNode), false, false)
        const compoundOp = op
        return writeAccessor(
            c,
            target,
            node,
            (old) => {
                const combined = arith(c, compoundOp, typed(old()), value, node)
                return combined.k === "typed" ? c.coerce(combined, target.type, node) : null
            },
            false,
            true,
        )
    }
    const lvalue = target.lvalue!
    const type = target.type
    if (op === null) return typed(new Assign(type, lvalue, c.coerceTo(value, type, valueNode, decl)))

    if (lvalue.k === "local") {
        // Reading a local has no side effects: expand `x op= v` to `x = x op v`.
        const combined = arith(c, op, typed(new LocalRef(type, lvalue.local)), value, node)
        if (combined.k !== "typed") return errorOperand
        return typed(new Assign(type, lvalue, combined.expr))
    }
    // Type-check `element op v` with a placeholder for the element, which must be evaluated once.
    const placeholder: Expr = new LocalRef(type, new Local(-1, "element", type, true))
    const combined = arith(c, op, typed(placeholder), value, node)
    if (combined.k !== "typed") return errorOperand
    const ce = combined.expr
    let rightExpr: Expr | null = null
    if (ce.k === "arith") rightExpr = ce.right
    else if (ce.k === "concat") rightExpr = ce.parts[1]
    if (rightExpr === null) return errorOperand
    return typed(new Assign(type, lvalue, rightExpr, op))
}

/**
 * `object[key] = value` by a key of a `keyof` type: the value is evaluated
 * once and stored into the member the key names, so it must convert to the
 * type of each member the key can name, as TypeScript writes `T[K]`;
 * `object[key] op= value` needs members of one type.
 */
function assignKeyed(
    c: Checker,
    node: Node,
    target: AssignTarget,
    keyed: KeyedTarget,
    op: ArithOp | null,
    scope: Scope,
): Operand {
    const common = keyedType(keyed)
    if (op !== null && common === null)
        return c.fail(left(node), `Operator '${op}=' cannot be applied to type '${typeToString(target.type)}'.`)
    return storeKeyed(c, node, target, keyed, checkExpr(c, right(node), scope, common), right(node), op)
}

/** Stores a value into the member a `keyof` key names, or combines it with the member by `op`. */
export function storeKeyed(
    c: Checker,
    node: Node,
    target: AssignTarget,
    keyed: KeyedTarget,
    value: Operand,
    valueNode: Node,
    op: ArithOp | null,
): Operand {
    if (value.k === "error") return value
    const locals = keyed.locals.slice()
    let each: Operand = value
    if (value.k === "typed") {
        const type = value.expr.type
        const local = c.newLocal("value", type, false)
        locals.push(new BindLocal(local, value.expr))
        each = typed(new LocalRef(type, local))
    }
    const chosen = chooseKeyed(c, keyed, target.type, node, (t) => store(c, node, t, each, valueNode, op, null))
    if (chosen === null) return errorOperand
    return typed(new Bind(target.type, locals, chosen))
}

/** The type of the members a `keyof` key can name, when it is the same for all. */
function keyedType(keyed: KeyedTarget): Type | null {
    const first = keyed.targets[0].type
    return keyed.targets.every((t) => sameType(t.type, first)) ? first : null
}

/** What `each` makes of the member each name of a `keyof` key stands for, chosen by the key at run time. */
function chooseKeyed(
    c: Checker,
    keyed: KeyedTarget,
    type: Type,
    node: Node,
    each: (target: AssignTarget) => Operand,
): Expr | null {
    const exprs: Expr[] = []
    for (const t of keyed.targets) {
        const e = each(t)
        if (e.k !== "typed") return null
        exprs.push(c.coerce(e, type, node))
    }
    let chosen = exprs[exprs.length - 1]
    for (let i = exprs.length - 2; i >= 0; i--) {
        const test: Expr = new Compare(types.bool, "===", keyed.key, new StringLit(types.string, keyed.names[i]))
        chosen = new Conditional(type, test, exprs[i], chosen)
    }
    return chosen
}

/**
 * `object[key]` by a key of a `keyof` type as the target of an assignment:
 * the object and the key, evaluated once, and the member of each name the
 * key can be. A key of other types is not a member's name.
 */
function keyedTarget(c: Checker, node: Node, object: Expr, indexNode: Node, scope: Scope): AssignTarget | null {
    const index = checkExpr(c, indexNode, scope)
    if (index.k === "error") return null
    const key = index.k === "typed" ? index.expr : null
    const names: string[] = []
    if (key !== null) for (const m of membersOf(key.type)) if (m.kind === "literal") names.push(m.value)
    if (key === null || names.length === 0 || names.length !== membersOf(key.type).length) {
        c.error(
            indexNode,
            "Only a member named by a string literal or a 'keyof' type can be assigned to: 'object[\"name\"] = value'.",
        )
        return null
    }
    const type = object.type
    const o = c.newLocal("object", type, false)
    const k = c.newLocal("key", types.string, false)
    const oRef: Expr = new LocalRef(type, o)
    const targets: AssignTarget[] = []
    // The member is reported at the whole access: the key names no member of its own.
    for (const name of names) {
        const t = memberTarget(c, node, oRef, node, name)
        if (t === null) return null
        targets.push(t)
    }
    const locals = [new BindLocal(o, object), new BindLocal(k, c.coerce(index, types.string, indexNode))]
    const keyed = new KeyedTarget(locals, new LocalRef(types.string, k), names, targets)
    const result = keyedType(keyed) ?? c.unionOf(targets.map((t) => t.type))
    c.info.types.set(node, result)
    return new AssignTargetClass(result, null, null, null, keyed)
}

export function checkIncDec(c: Checker, node: Node, operator: string, prefix: bool, scope: Scope): Operand {
    const target = assignTarget(c, node, scope)
    if (target === null) return errorOperand
    const place = target.lvalue
    if (place !== null && place.k === "local" && c.untyped.has(place.local)) {
        c.readEarly.add(place.local)
        return c.readBeforeAssigned(node, place.local)
    }
    const op: "++" | "--" = operator === "++" ? "++" : "--"
    const type = arithType(target.type)
    if (type === null) return c.fail(node, `Operator '${op}' cannot be applied to type '${typeToString(target.type)}'.`)
    const keyed = target.keyed
    if (keyed !== null) {
        const chosen = chooseKeyed(c, keyed, target.type, node, (t) => incDec(c, node, t, type, op, prefix))
        return chosen === null ? errorOperand : typed(new Bind(target.type, keyed.locals, chosen))
    }
    return incDec(c, node, target, type, op, prefix)
}

/** `x++` and the like of a target of a numeric type. */
function incDec(
    c: Checker,
    node: Node,
    target: AssignTarget,
    type: IntType | FloatType | BigIntType,
    op: "++" | "--",
    prefix: bool,
): Operand {
    if (target.entry !== null || target.accessor !== null) {
        let one: Expr
        if (type.kind === "int") one = new IntLit(type, 1)
        else if (type.kind === "float") one = new FloatLit(type, 1.0)
        else one = new BigIntLit(type, "1")
        if (target.entry !== null)
            return entryUpdate(
                c,
                target.entry,
                node,
                (old) => new Arith(type, op === "++" ? "+" : "-", old, one),
                !prefix,
            )
        return writeAccessor(
            c,
            target,
            node,
            (old) => new Arith(type, op === "++" ? "+" : "-", old(), one),
            !prefix,
            true,
        )
    }
    return typed(new IncDec(type, target.lvalue!, op, prefix))
}

export function assignTarget(c: Checker, node: Node, scope: Scope, entries: bool = false): AssignTarget | null {
    if (node.kind === "ParenthesizedExpression") return assignTarget(c, expression(node), scope, entries)
    if (node.kind === "ElementAccessExpression") {
        const target = checkExpr(c, expression(node), scope)
        if (target.k !== "typed") return null
        const array = target.expr
        const at = array.type
        if (at.kind === "map" && at.dict) {
            const key = dictKey(c, argumentExpression(node), scope)
            if (key === null) return null
            return entryTarget(c, node, array, at, key, entries)
        }
        // A match is read-only, though a class: its captures are what the expression matched.
        if (matchCaptures(array) !== null) {
            c.error(node, `Index signature in type '${typeToString(at)}' only permits reading.`)
            return null
        }
        const indexNode = argumentExpression(node)
        if ((at.kind === "struct" && !at.tuple) || at.kind === "interface" || at.kind === "union") {
            if (indexNode.kind !== "StringLiteral" && indexNode.kind !== "NoSubstitutionTemplateLiteral") {
                if (at.kind !== "union") return keyedTarget(c, node, array, indexNode, scope)
                c.error(
                    indexNode,
                    "Only a member named by a string literal or a 'keyof' type can be assigned to: 'object[\"name\"] = value'.",
                )
                return null
            }
            return memberTarget(c, node, array, indexNode, stringText(indexNode))
        }
        if (at.kind === "string") {
            c.error(node, "Strings are immutable.")
            return null
        }
        if (at.kind === "unknown") {
            c.error(expression(node), unknownObject)
            return null
        }
        if (at.kind === "struct" && at.tuple) {
            const field = tupleField(c, at, argumentExpression(node), scope)
            if (field === null) return null
            if (field.readonly) {
                c.error(node, `Cannot assign to '${field.name}' because it is a read-only property.`)
                return null
            }
            c.info.types.set(node, field.type)
            return new AssignTargetClass(field.type, new FieldLValue(array, field.name))
        }
        if (at.kind !== "array") {
            c.error(expression(node), `Type '${typeToString(at)}' cannot be indexed.`)
            return null
        }
        if (at.readOnly) {
            c.error(node, `Index signature in type '${typeToString(at)}' only permits reading.`)
            return null
        }
        const index = checkIndex(c, argumentExpression(node), scope)
        if (index === null) return null
        c.info.types.set(node, at.elem)
        return new AssignTargetClass(at.elem, new ElementLValue(array, index))
    }
    if (node.kind === "PropertyAccessExpression") {
        // A static field of a class.
        const found = moduleMember(c, node, scope)
        if (found !== null && found.k === "local") {
            const local = found.local
            if (!local.mutable) {
                c.error(nameNode(node), `Cannot assign to '${local.name}' because it is a read-only property.`)
                return null
            }
            local.assigned = true
            c.info.types.set(node, local.type)
            return new AssignTargetClass(local.type, new LocalLValue(local))
        }
        if (found !== null) {
            c.error(nameNode(node), `Cannot assign to '${c.text(node)}' because it is not a variable.`)
            return null
        }
        const target = checkExpr(c, expression(node), scope)
        if (target.k !== "typed") return null
        const object = target.expr
        const nameId = nameNode(node)
        const name = nameId.text
        const ot = object.type
        if (ot.kind === "map" && ot.dict)
            return entryTarget(c, node, object, ot, new StringLit(types.string, name), entries)
        return memberTarget(c, node, object, nameId, name)
    }
    if (!isIdentifier(node)) {
        c.error(node, "Only variables, fields and array elements can be assigned to.")
        return null
    }
    const found = scope.lookupCapturing(node.text)
    if (found === null) {
        c.error(node, `Cannot find name '${node.text}'.`)
        return null
    }
    const symbol = found.symbol
    c.info.definitions.set(node, symbol.decl)
    if (symbol.k === "const") {
        // Reported already, as `globalThis.name` that is no global.
        if (symbol.value.k !== "error") c.error(node, `Cannot assign to '${node.text}' because it is a constant.`)
        return null
    }
    if (symbol.k !== "local") {
        c.error(node, `Cannot assign to '${node.text}' because it is not a variable.`)
        return null
    }
    if (!symbol.local.mutable) {
        c.error(node, `Cannot assign to '${node.text}' because it is a constant.`)
        return null
    }
    capture(symbol.local, found.closures)
    symbol.local.assigned = true
    c.info.types.set(node, symbol.local.type)
    return new AssignTargetClass(symbol.local.type, new LocalLValue(symbol.local))
}

/**
 * An entry of a dictionary as the target of an assignment: only `=` and
 * `??=` (with `entries`) assign to one, as it may be missing when read.
 */
function entryTarget(c: Checker, node: Node, dict: Expr, type: MapType, key: Expr, entries: bool): AssignTarget | null {
    // A required named entry is always there: any assignment changes it.
    const member = entryNamed(type, key)
    if (!entries && (member === null || member.optional)) {
        c.error(
            node,
            `An entry of a dictionary is assigned with '=' or '??=': it is '${typeToString(c.unionOf([type.value, types.null]))}' when read.`,
        )
        return null
    }
    const entry = dictTarget(c, node, dict, type, key)
    if (entry === null) return null
    const written = entryType(c, entry)
    c.info.types.set(node, written)
    return new AssignTargetClass(written, null, null, entry)
}

/** The member `name` of an object as the target of an assignment: `object.name`, `object["name"]`. */
function memberTarget(c: Checker, node: Node, object: Expr, nameId: Node, name: string): AssignTarget | null {
    {
        const ot = object.type
        if (ot.kind === "unknown") {
            c.error(nameId, unknownObject)
            return null
        }
        if (ot.kind === "interface") {
            let index = -1
            for (let i = 0; i < ot.members.length; i++) if (index === -1 && ot.members[i].name === name) index = i
            const m = index === -1 ? null : ot.members[index]
            if (m === null || m.k !== "field") {
                c.error(nameId, `Property '${name}' does not exist on type '${ot.name}'.`)
                return null
            }
            defineMember(c, nameId, ot, name)
            if (m.readonly) {
                c.error(nameId, `Cannot assign to '${name}' because it is a read-only property.`)
                return null
            }
            c.info.types.set(node, m.type)
            return new AssignTargetClass(m.type, new IfaceFieldLValue(object, index))
        }
        const property = accessor(c, ot, name)
        if (property !== null && ot.kind === "struct") {
            defineMember(c, nameId, ot, name)
            if (!checkAccess(c, ot, property.private, name, nameId)) return null
            if (!property.hasSet) {
                c.error(nameId, `Cannot assign to '${name}' because it has a getter but no setter.`)
                return null
            }
            c.info.types.set(node, property.type)
            return new AssignTargetClass(property.type, null, new AccessorTarget(object, property, name))
        }
        if (ot.kind === "union") return unionFieldTarget(c, nameId, node, object, ot, name)
        const struct = ot.kind === "struct" ? ot : null
        const field = struct !== null ? findField(struct, name) : null
        if (struct === null || field === null) {
            c.error(nameId, `Property '${name}' does not exist on type '${typeToString(ot)}'.`)
            return null
        }
        defineMember(c, nameId, struct, name)
        if (!checkAccess(c, struct, field.private, name, nameId)) return null
        // A constructor may initialize the read-only fields of its own instance.
        const fn = c.fn
        const initializing =
            fn !== null &&
            fn.ctor &&
            fn.cls === struct &&
            declaringClass(c, struct, name) === struct &&
            object.k === "local" &&
            object.local === fn.thisLocal
        if (field.readonly && !initializing) {
            c.error(nameId, `Cannot assign to '${name}' because it is a read-only property.`)
            return null
        }
        c.info.types.set(node, field.type)
        return new AssignTargetClass(field.type, new FieldLValue(object, name))
    }
}

/** A field that every member of a union has, writable and of the same type in each: `stmt.line = 3`. */
function unionFieldTarget(
    c: Checker,
    nameId: Node,
    node: Node,
    object: Expr,
    union: UnionType,
    name: string,
): AssignTarget | null {
    const fields: (Field | null)[] = []
    if (!canBeNull(union)) for (const m of union.members) fields.push(memberField(m, name))
    if (fields.length === 0 || fields.some((f) => f === null)) {
        c.error(nameId, noProperty(union, name))
        return null
    }
    if (fields.some((f) => f!.readonly)) {
        c.error(nameId, `Cannot assign to '${name}' because it is a read-only property.`)
        return null
    }
    const type = fields[0]!.type
    if (fields.some((f) => !sameType(f!.type, type))) {
        c.error(nameId, `Cannot assign to '${name}': its type differs between the members of '${typeToString(union)}'.`)
        return null
    }
    c.info.types.set(node, type)
    return new AssignTargetClass(type, new UnionFieldLValue(object, name))
}

export function checkPrefixUnary(c: Checker, node: Node, scope: Scope): Operand {
    const operator = prefixOperator(node, c.sourceOf(node).text)
    if (operator === "++" || operator === "--") return checkIncDec(c, operand(node), operator, true, scope)
    if (operator === "!") return typed(new Not(types.bool, checkCondition(c, operand(node), scope)))
    const value = widened(checkExpr(c, operand(node), scope))
    if (value.k === "error") return value
    const op = operator === "-" ? "-" : operator === "~" ? "~" : "+"
    const untyped = untypedOf(value)
    if (untyped !== null) {
        const folded = foldUnary(op, untyped)
        if (typeof folded === "string") return c.fail(node, folded)
        return folded
    }
    const expr = typedExpr(value)
    const type = typeOf(expr)
    if (type.kind === "bigint" && op !== "+") {
        // The negation of a literal is a literal.
        if (op === "-" && expr.k === "bigint")
            return typed(
                new BigIntLit(
                    type,
                    expr.value === "0" ? "0" : expr.value.startsWith("-") ? expr.value.slice(1) : `-${expr.value}`,
                ),
            )
        return typed(new Unary(type, op === "-" ? "-" : "~", expr))
    }
    const numeric = numericType(type)
    if (numeric !== null && (numeric.kind === "int" || op !== "~")) {
        if (op === "+") return value
        return typed(new Unary(numeric, op === "-" ? "-" : "~", expr))
    }
    return c.fail(node, `Operator '${op}' cannot be applied to type '${typeToString(type)}'.`)
}

/** Whether an expression needs a context for its type: an empty array literal. */
function needsContext(node: Node): bool {
    if (node.kind === "ParenthesizedExpression") return needsContext(expression(node))
    return node.kind === "ArrayLiteralExpression" && elements(node).length === 0
}

export function checkConditional(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    const cond = condition(c, node.child("condition")!, scope)
    // Both branches are checked against the expected type, so that `c ? "a" : "b"` can be a literal type.
    // Without one, a branch that needs a context, such as `[]`, takes the other branch's type.
    const yesNode = whenTrue(node)
    const noNode = whenFalse(node)
    const noFirst = expected === null && needsContext(yesNode) && !needsContext(noNode)
    let yes: Operand = errorOperand
    let no: Operand = errorOperand
    if (noFirst) {
        c.pushFacts(cond.whenFalse)
        no = checkExpr(c, noNode, scope, expected)
        c.popFacts()
    }
    const yesContext = noFirst && no.k === "typed" ? no.expr.type : expected
    c.pushFacts(cond.whenTrue)
    yes = checkExpr(c, yesNode, scope, yesContext)
    c.popFacts()
    if (!noFirst) {
        const noContext = expected === null && needsContext(noNode) && yes.k === "typed" ? yes.expr.type : expected
        c.pushFacts(cond.whenFalse)
        no = checkExpr(c, noNode, scope, noContext)
        c.popFacts()
    }
    // Typed branches whose types are members of an expected union keep their
    // own types, which are narrower: after `u = t !== null ? t : "d"`, u is a string.
    if (expected !== null && expected.kind === "union" && yes.k === "typed" && no.k === "typed") {
        const yt = yes.expr.type
        const nt = no.expr.type
        if (yt.kind !== "void" && nt.kind !== "void") {
            const natural = sameType(yt, nt) ? yt : c.unionOf([yt, nt])
            const members_ = expected.members
            if (!sameType(natural, expected) && membersOf(natural).every((m) => members_.some((e) => sameType(e, m)))) {
                const then = c.coerce(yes, natural, whenTrue(node))
                const otherwise = c.coerce(no, natural, whenFalse(node))
                return typed(new Conditional(natural, cond.expr, then, otherwise))
            }
        }
    }
    // Branches that both fit the expected type take it, such as literals of a literal union.
    if (expected !== null && yes.k !== "error" && no.k !== "error") {
        const before = c.diagnostics.length
        const then = c.coerce(yes, expected, whenTrue(node))
        const otherwise = c.coerce(no, expected, whenFalse(node))
        if (c.diagnostics.length === before) return typed(new Conditional(expected, cond.expr, then, otherwise))
        c.truncateDiagnostics(before)
    }
    const unified = c.unify(yes, no, whenTrue(node), whenFalse(node))
    const then = unified.left
    const otherwise = unified.right
    if (then === null || otherwise === null) return errorOperand
    const type = typeOf(then)
    if (sameType(type, typeOf(otherwise))) return typed(new Conditional(type, cond.expr, then, otherwise))
    // Branches of different types give their union, as in TypeScript.
    if (type.kind === "void" || otherwise.type.kind === "void")
        return c.fail(node, "Branches of '?:' cannot be 'void'.")
    const union = c.unionOf([type, otherwise.type])
    return typed(
        new Conditional(
            union,
            cond.expr,
            c.coerce(typed(then), union, whenTrue(node)),
            c.coerce(typed(otherwise), union, whenFalse(node)),
        ),
    )
}

/**
 * An array literal with `...array` elements: the element type comes from the
 * context, else from the first element (an array's element type for a
 * spread); each spread must be an array of exactly that element type.
 */
/** The characters of a string, as `Array.from(s)` and `[...s]` take them. */
export function stringCharacters(value: Expr): Expr {
    const str: Expr = sameType(value.type, types.string) ? value : new Recast(types.string, value)
    return new StringMethod("split", arrayOf(types.string), str, [new StringLit(types.string, "")])
}

export function checkSpreadArray(c: Checker, node: Node, elems: Node[], scope: Scope, expected: Type | null): Operand {
    // The element type, once known: a flag rather than null, so that no
    // narrowing is involved, which stage 0 of the bootstrap does differently.
    let elem: Type = types.i64
    let known = false
    if (expected !== null) {
        for (const m of membersOf(expected)) {
            if (m.kind === "array" && !known) {
                elem = m.elem
                known = true
            }
        }
    }
    // Each value is held in a local in order, so that a spread tuple is
    // evaluated once and taken apart, in the order of the elements.
    const locals: BindLocal[] = []
    const hold = (value: Expr): Expr => {
        const local = c.newLocal("elem", value.type, false)
        locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
    const exprs: Expr[] = []
    const spread: bool[] = []
    for (const e of elems) {
        if (e.kind === "SpreadElement") {
            const inner = expression(e)
            const value = checkExpr(c, inner, scope, known ? arrayOf(elem) : null)
            if (value.k === "error") return errorOperand
            const vt = value.k === "typed" ? value.expr.type : types.void
            if (value.k === "typed" && vt.kind === "struct" && vt.tuple) {
                const tuple = hold(value.expr)
                for (const f of vt.fields) {
                    if (!known) {
                        elem = f.type
                        known = true
                    }
                    exprs.push(c.coerce(typed(new FieldGet(f.type, tuple, f.name)), elem, inner))
                    spread.push(false)
                }
                continue
            }
            if (value.k !== "typed")
                return c.fail(inner, "Only an array, a tuple or an iterable can be spread into an array.")
            // Any other iterable: its elements as an array, the characters of a string as `Array.from` takes them.
            const items = isStringLike(vt) ? stringCharacters(value.expr) : toArray(c, value.expr, inner)
            if (items === null) return errorOperand
            const at = items.type
            if (at.kind !== "array") return errorOperand
            if (!known) {
                elem = at.elem
                known = true
            }
            if (!sameType(at.elem, elem))
                return c.fail(
                    inner,
                    `An array of '${typeToString(at.elem)}' cannot be spread into an array of '${typeToString(elem)}'.`,
                )
            exprs.push(hold(items))
            spread.push(true)
        } else {
            const value = checkExpr(c, e, scope, known ? elem : null)
            if (value.k === "error") return errorOperand
            if (!known) {
                elem = value.k === "typed" ? value.expr.type : value.k === "untyped-float" ? types.f64 : types.i64
                known = true
            }
            exprs.push(hold(c.coerce(value, elem, e)))
            spread.push(false)
        }
    }
    if (elem.kind === "void" || elem.kind === "never")
        return c.fail(node, `An array cannot contain values of type '${elem.kind}'.`)
    const array: Expr = new ArrayLit(arrayOf(elem), exprs, spread.some((x) => x) ? spread : null)
    return typed(new Bind(array.type, locals, array))
}

/**
 * An array literal in the context of tuple types: the one with as many
 * elements, or the only one; null when the context has no tuple type.
 */
function tupleContext(expected: Type | null, length: int): StructType | null {
    if (expected === null) return null
    const tuples: StructType[] = []
    for (const m of membersOf(expected)) if (m.kind === "struct" && m.tuple) tuples.push(m)
    for (const t of tuples) if (t.fields.length === length) return t
    // Or one that leaves out optional elements.
    for (const t of tuples) if (length < t.fields.length && t.fields[length].optional) return t
    let arrays = false
    for (const m of membersOf(expected)) if (m.kind === "array") arrays = true
    return tuples.length === 1 && !arrays ? tuples[0] : null
}

function checkTupleLiteral(c: Checker, node: Node, elems: Node[], scope: Scope, tuple: StructType): Operand {
    // Spread tuples give elements of their own: the values are held in order, so each is evaluated once.
    const spreading = elems.some((e) => e.kind === "SpreadElement")
    const locals: BindLocal[] = []
    const hold = (value: Expr): Expr => {
        if (!spreading) return value
        const local = c.newLocal("elem", value.type, false)
        locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
    const n = tuple.fields.length
    const fields: FieldInit[] = []
    let count = 0
    for (const e of elems) {
        if (e.kind !== "SpreadElement") {
            if (count < n) {
                const type = tuple.fields[count].type
                const value = checkExpr(c, e, scope, type)
                if (value.k === "error") return errorOperand
                fields.push(new FieldInit(`${count}`, hold(c.coerce(value, type, e))))
            }
            count++
            continue
        }
        const inner = expression(e)
        const value = checkExpr(c, inner, scope)
        if (value.k === "error") return errorOperand
        const from = c.toDefault(value, inner)
        const ft = from.type
        if (ft.kind !== "struct" || !ft.tuple) return c.fail(inner, "Only a tuple can be spread into a tuple.")
        const held = hold(from)
        for (const f of ft.fields) {
            if (count < n) {
                const type = tuple.fields[count].type
                fields.push(new FieldInit(`${count}`, c.coerce(typed(new FieldGet(f.type, held, f.name)), type, inner)))
            }
            count++
        }
    }
    // Optional elements left out are null.
    while (count < n && tuple.fields[count].optional) {
        const ft = tuple.fields[count].type
        if (ft.kind !== "union") break
        fields.push(new FieldInit(`${count}`, new NullLit(ft)))
        count++
    }
    if (count !== n)
        return c.fail(node, `Expected ${n} element(s) for tuple type '${typeToString(tuple)}', got ${count}.`)
    const literal: Expr = new ObjectLit(tuple, fields)
    return typed(locals.length > 0 ? new Bind(tuple, locals, literal) : literal)
}

export function checkArrayLiteral(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    const elems = elements(node)
    const tuple = tupleContext(expected, elems.length)
    if (tuple !== null) return checkTupleLiteral(c, node, elems, scope, tuple)
    return checkArrayElements(c, node, elems, scope, expected)
}

/** An array of the elements `elems` of an array literal, or of the arguments of `Array.of`. */
export function checkArrayElements(
    c: Checker,
    node: Node,
    elems: Node[],
    scope: Scope,
    expected: Type | null,
): Operand {
    let spreads = false
    for (const e of elems) {
        if (e.kind === "SpreadElement") spreads = true
        if (e.kind === "OmittedExpression") return c.fail(node, "Array holes are not supported.")
    }
    if (spreads) return checkSpreadArray(c, node, elems, scope, expected)
    // The context gives the element type: an array type, or a union with exactly one array type (`T[] | null`).
    const arrays: ArrayType[] = []
    if (expected !== null) for (const m of membersOf(expected)) if (m.kind === "array") arrays.push(m)
    if (arrays.length === 1) {
        // Only a tagged template makes a `TemplateStringsArray`: a literal is an array of its elements.
        const type = arrays[0].template ? arrayOf(arrays[0].elem) : arrays[0]
        const values: Expr[] = []
        for (const e of elems) values.push(c.coerce(checkExpr(c, e, scope, type.elem), type.elem, e))
        return typed(new ArrayLit(type, values))
    }
    const values: Operand[] = []
    for (const e of elems) values.push(checkExpr(c, e, scope))
    if (values.some((v) => v.k === "error")) return errorOperand
    // The element type is the type of the first typed element, else the default type of the constants;
    // a flag rather than null, as stage 0 of the bootstrap narrows differently.
    let elemType: Type = types.i64
    let found = false
    for (const v of values) {
        if (!found && v.k === "typed") {
            elemType = v.expr.type
            found = true
        }
    }
    if (!found) {
        if (values.length === 0)
            return c.fail(
                node,
                "Cannot infer the type of an empty array. Add a type annotation, e.g. 'let a: int[] = []'.",
            )
        if (values.some((v) => v.k === "untyped-float")) elemType = types.f64
    }
    if (elemType.kind === "void" || elemType.kind === "never")
        return c.fail(node, `An array cannot contain values of type '${elemType.kind}'.`)
    const exprs: Expr[] = []
    for (let i = 0; i < values.length; i++) exprs.push(c.coerce(values[i], elemType, elems[i]))
    return typed(new ArrayLit(arrayOf(elemType), exprs))
}

/**
 * A property of an object literal: its name, the node to report at, and its
 * value; with spreads, the value already checked (see `spreadProps`).
 */
class Prop {
    constructor(
        readonly name: string,
        readonly node: Node,
        readonly value: Node,
        readonly operand: Operand | null = null,
    ) {}
}

/**
 * The properties of an object literal with `...object` spreads: each value is
 * checked and held in order (with the expected type's field type as its
 * context), and a spread gives the public fields of a class or object type,
 * or the fields of an interface; a later property replaces an earlier one.
 */
function spreadProps(c: Checker, node: Node, scope: Scope, expected: Type | null, locals: BindLocal[]): Prop[] | null {
    const hold = (value: Expr): Expr => {
        const local = c.newLocal("prop", value.type, false)
        locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
    const context = expected !== null && (expected.kind === "struct" || expected.kind === "interface") ? expected : null
    const props: Prop[] = []
    const put = (prop: Prop) => {
        // Moved to the end: the fields of the object come in the order of their last property.
        let at = -1
        for (let i = 0; i < props.length; i++) if (at === -1 && props[i].name === prop.name) at = i
        if (at !== -1) {
            for (let i = at; i + 1 < props.length; i++) props[i] = props[i + 1]
            props.pop()
        }
        props.push(prop)
    }
    for (const prop of properties(node)) {
        if (prop.kind === "SpreadAssignment") {
            const inner = expression(prop)
            const value = checkExpr(c, inner, scope)
            if (value.k === "error") return null
            const object = c.toDefault(value, inner)
            const type = object.type
            if (type.kind === "struct" && !type.tuple) {
                const held = hold(object)
                for (const f of type.fields)
                    if (!f.private) put(new Prop(f.name, prop, inner, typed(new FieldGet(f.type, held, f.name))))
                continue
            }
            if (type.kind === "interface") {
                const held = hold(object)
                for (let i = 0; i < type.members.length; i++) {
                    const m = type.members[i]
                    if (m.k === "field") put(new Prop(m.name, prop, inner, typed(new IfaceField(m.type, held, i))))
                }
                continue
            }
            c.error(inner, `Only an object can be spread into an object literal, got '${typeToString(type)}'.`)
            return null
        }
        let name: string | null = null
        let at = prop
        let valueNode = prop
        if (prop.kind === "PropertyAssignment") {
            name = c.memberName(nameNode(prop))
            at = nameNode(prop)
            valueNode = initializer(prop)!
        } else {
            // A shorthand property: methods and accessors make an object literal with methods.
            name = nameNode(prop).text
            at = nameNode(prop)
            valueNode = nameNode(prop)
        }
        if (name === null) return null
        const hint = context !== null ? fieldType(context, name) : null
        const value = checkExpr(c, valueNode, scope, hint)
        if (value.k === "error") return null
        const expr = hint !== null ? c.coerce(value, hint, valueNode) : c.toDefault(value, valueNode)
        for (const p of props)
            if (p.name === name && p.node.kind !== "SpreadAssignment") {
                c.error(at, `Duplicate property '${name}'.`)
                return null
            }
        put(new Prop(name, at, valueNode, typed(hold(expr))))
    }
    return props
}

/**
 * An object literal with methods or accessors: `{ count: 0, add(n: int) {
 * this.count += n } }`. A method is a field holding a closure whose `this` is
 * the object; the object is allocated first and its fields assigned in order,
 * so that the closures can refer to it. The types of a method come from its
 * annotations, or from the expected type. A getter or setter of property `x`
 * is a closure in the hidden field `get x` or `set x`, which reads and writes
 * of `x` call.
 */
function objectWithMethods(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    let hints: StructType | InterfaceType | null = null
    if (expected !== null && expected.kind === "struct") hints = expected
    else if (expected !== null && expected.kind === "interface") hints = expected
    // The values are held in locals in order, then the object is allocated and its fields assigned.
    const locals: BindLocal[] = []
    const hold = (value: Expr): Expr => {
        const local = c.newLocal("prop", value.type, false)
        locals.push(new BindLocal(local, value))
        return new LocalRef(value.type, local)
    }
    // The fields, in order: names, the properties they define, nodes, values
    // (null for a method or accessor, checked once `this` is known), types.
    const names: string[] = []
    const properties_: string[] = []
    const nodes: Node[] = []
    const values: (Expr | null)[] = []
    const fields: Field[] = []
    const spread: bool[] = []
    let accessors = false
    // A later property replaces one from a spread; two written ones are a
    // duplicate. A getter and a setter of a property go together.
    const put = (name: string, property: string, at: Node, value: Expr | null, type: Type, fromSpread: bool): bool => {
        // Entries for the same property, but for the getter and setter of an accessor.
        const clashes = (i: int): bool =>
            properties_[i] === property && (names[i] === name || names[i] === property || name === property)
        for (let i = 0; i < names.length; i++) {
            if (clashes(i) && !fromSpread && !spread[i]) {
                c.error(at, `Duplicate property '${property}'.`)
                return false
            }
        }
        for (let i = names.length - 1; i >= 0; i--) {
            if (!clashes(i)) continue
            removeAt(names, i)
            removeAt(properties_, i)
            removeAt(nodes, i)
            removeAt(values, i)
            removeAt(fields, i)
            removeAt(spread, i)
        }
        names.push(name)
        properties_.push(property)
        nodes.push(at)
        values.push(value)
        fields.push(new Field(name, type, false, name !== property))
        spread.push(fromSpread)
        return true
    }
    for (const prop of properties(node)) {
        const k = prop.kind
        if (k === "SpreadAssignment") {
            const inner = expression(prop)
            const operand_ = checkExpr(c, inner, scope)
            if (operand_.k === "error") return errorOperand
            const object = hold(c.toDefault(operand_, inner))
            const type = object.type
            if (type.kind === "struct" && !type.tuple) {
                for (const f of type.fields)
                    if (!f.private && !put(f.name, f.name, prop, new FieldGet(f.type, object, f.name), f.type, true))
                        return errorOperand
            } else if (type.kind === "interface") {
                for (let m = 0; m < type.members.length; m++) {
                    const member_ = type.members[m]
                    if (member_.k !== "field") continue
                    const value = new IfaceField(member_.type, object, m)
                    if (!put(member_.name, member_.name, prop, value, member_.type, true)) return errorOperand
                }
            } else {
                return c.fail(
                    inner,
                    `Only an object can be spread into an object literal, got '${typeToString(type)}'.`,
                )
            }
            continue
        }
        const nameAt = prop.child("name")
        const name = nameAt !== null ? c.memberName(nameAt) : null
        if (nameAt === null || name === null) return errorOperand
        if (k === "GetAccessor" || k === "SetAccessor") {
            const type = accessorType(c, prop, name, scope)
            if (type === null) return errorOperand
            const field = accessorField(k === "GetAccessor" ? "get" : "set", name)
            if (!put(field, name, prop, null, type, false)) return errorOperand
            accessors = true
            continue
        }
        if (k === "MethodDeclaration") {
            const hint = hints !== null ? memberHint(hints, name) : null
            if (typeNode(prop) === null && isGenerator(prop) && (hint === null || hint.kind !== "func")) {
                const closure = generatorMethod(c, prop, scope)
                if (closure === null || !put(name, name, prop, closure, closure.type, false)) return errorOperand
                continue
            }
            const type = methodType(c, prop, scope, hint)
            if (type === null || !put(name, name, prop, null, type, false)) return errorOperand
            continue
        }
        const valueNode = k === "ShorthandPropertyAssignment" ? nameAt : initializer(prop)!
        const hint = hints !== null ? memberHint(hints, name) : null
        const value = checkExpr(c, valueNode, scope, hint)
        if (value.k === "error") return errorOperand
        const expr = hint !== null ? c.coerce(value, hint, valueNode) : c.toDefault(value, valueNode)
        if (!put(name, name, prop, hold(expr), expr.type, false)) return errorOperand
    }
    // The getter and setter of a property have the same type.
    for (let i = 0; i < names.length; i++) {
        const property = properties_[i]
        if (names[i] !== accessorField("set", property)) continue
        for (let j = 0; j < names.length; j++) {
            if (names[j] !== accessorField("get", property)) continue
            const getter = fields[j].type
            const setter = fields[i].type
            if (getter.kind !== "func" || setter.kind !== "func" || sameType(getter.result, setter.params[0])) continue
            return c.fail(
                nameNode(nodes[i]),
                `The getter and setter of '${property}' must have the same type, got '${typeToString(getter.result)}' and '${typeToString(setter.params[0])}'.`,
            )
        }
    }
    const fits = !accessors && expected !== null && expected.kind === "struct" && !expected.nominal
    const struct = fits && expected !== null && expected.kind === "struct" ? expected : c.shape(fields)
    const self = c.newLocal("this", struct, false)
    const selfRef: Expr = new LocalRef(struct, self)
    const assigns: Expr[] = []
    for (let i = 0; i < names.length; i++) {
        const field = findField(struct, names[i])
        if (field === null)
            return c.fail(nodes[i], `Property '${names[i]}' does not exist in type '${typeToString(struct)}'.`)
        const given = values[i]
        let value: Expr
        if (given === null) {
            const closure = checkClosure(c, nodes[i], scope, field.type, false, self)
            if (closure.k === "error") return errorOperand
            value = c.coerce(closure, field.type, nodes[i])
        } else value = c.coerce(typed(given), field.type, nodes[i])
        assigns.push(new Assign(field.type, new FieldLValue(selfRef, names[i]), value))
    }
    assigns.push(selfRef)
    locals.push(new BindLocal(self, new Alloc(struct)))
    return typed(new Bind(struct, locals, new Seq(struct, assigns)))
}

/**
 * The function type of a getter (`() => T`, with its result type annotated)
 * or setter (`(v: T) => void`, with one annotated parameter) of an object
 * literal, as in a class.
 */
function accessorType(c: Checker, node: Node, name: string, scope: Scope): FuncType | null {
    if (node.kind === "GetAccessor") {
        const annotation = typeNode(node)
        if (annotation === null) {
            c.error(nameNode(node), `Getter '${name}' must have a return type annotation.`)
            return null
        }
        const result = c.resolveValueType(annotation, scope)
        return result !== null ? new FuncType([], result) : null
    }
    const list = parameters(node)
    const annotation = list.length === 1 ? typeNode(list[0]) : null
    if (annotation === null) {
        c.error(nameNode(node), `Setter '${name}' must take one parameter with a type annotation.`)
        return null
    }
    const type = c.resolveValueType(annotation, scope)
    return type !== null ? new FuncType([type], types.void) : null
}

/** Removes the element at an index, moving the later ones down. */
function removeAt<T>(xs: T[], index: int) {
    for (let i = index; i + 1 < xs.length; i++) xs[i] = xs[i + 1]
    xs.pop()
}

/** The type the expected struct or interface gives a member, or null. */
function memberHint(hints: StructType | InterfaceType, name: string): Type | null {
    if (hints.kind === "struct") {
        const f = findField(hints, name)
        return f !== null ? f.type : null
    }
    for (const m of hints.members) if (m.name === name) return m.type
    return null
}

/** The function type of a method of an object literal, from its annotations or the expected type. */
function methodType(c: Checker, method: Node, scope: Scope, hint: Type | null): FuncType | null {
    const want = hint !== null && hint.kind === "func" ? hint : null
    const params: Type[] = []
    const list = parameters(method)
    for (let i = 0; i < list.length; i++) {
        const annotation = typeNode(list[i])
        let type: Type | null = null
        if (annotation !== null) type = c.resolveValueType(annotation, scope)
        else if (want !== null && i < want.params.length) type = want.params[i]
        if (type === null) {
            c.error(list[i], `Parameter '${c.text(nameNode(list[i]))}' needs a type annotation here.`)
            return null
        }
        params.push(type)
    }
    const annotation = typeNode(method)
    let result: Type | null = annotation !== null ? c.resolveType(annotation, scope) : null
    if (result === null && want !== null) result = want.result
    if (result === null) {
        if (returnsValue(body(method))) {
            c.error(
                method.child("name")!,
                "A method of an object literal needs a return type annotation, or a type to fit.",
            )
            return null
        }
        result = types.void
    }
    return new FuncType(params, result)
}

/**
 * A generator method of an object literal without a return type annotation
 * or a type to fit: its body gives its type, before the object's type, its
 * `this`, is known, so it cannot use `this`.
 */
function generatorMethod(c: Checker, method: Node, scope: Scope): Closure | null {
    if (usesThis(body(method))) {
        c.error(
            method.child("name")!,
            "A generator function needs a return type annotation, such as 'Generator<T>': a method of an object literal that uses 'this'.",
        )
        return null
    }
    const closure = checkClosure(c, method, scope)
    return closure.k === "typed" && closure.expr.k === "closure" ? closure.expr : null
}

/** Whether a function body uses `this` or `super` (not counting nested functions other than arrow functions). */
function usesThis(node: Node | null): bool {
    if (node === null) return false
    const k = node.kind
    if (k === "ThisKeyword" || k === "SuperKeyword") return true
    // Functions other than arrow functions, and classes, have a `this` of their own.
    if (k === "FunctionDeclaration" || k === "FunctionExpression" || k === "MethodDeclaration") return false
    if (k === "ClassDeclaration") return false
    for (const child of node.children) if (usesThis(child)) return true
    return false
}

/** Whether a function body returns a value somewhere (not counting nested functions). */
function returnsValue(node: Node | null): bool {
    if (node === null) return false
    if (node.kind === "ReturnStatement" && node.child("expression") !== null) return true
    const k = node.kind
    if (k === "FunctionDeclaration" || k === "FunctionExpression" || k === "ArrowFunction" || k === "MethodDeclaration")
        return false
    for (const child of node.children) if (returnsValue(child)) return true
    return false
}

export function checkObjectLiteral(c: Checker, node: Node, scope: Scope, expected: Type | null): Operand {
    const dict = expectedDict(expected)
    if (dict !== null) return dictLiteral(c, node, scope, dict)
    const withMethods = (p: Node): bool =>
        p.kind === "MethodDeclaration" || p.kind === "GetAccessor" || p.kind === "SetAccessor"
    if (properties(node).some(withMethods)) return objectWithMethods(c, node, scope, expected)
    if (properties(node).some((p) => p.kind === "SpreadAssignment")) {
        const locals: BindLocal[] = []
        const props = spreadProps(c, node, scope, expected, locals)
        if (props === null) return errorOperand
        const literal = objectOf(c, node, scope, expected, props)
        if (literal.k !== "typed" || locals.length === 0) return literal
        return typed(new Bind(literal.expr.type, locals, literal.expr))
    }
    const props: Prop[] = []
    for (const prop of properties(node)) {
        if (prop.kind === "PropertyAssignment") {
            const name = c.memberName(nameNode(prop))
            if (name !== null) props.push(new Prop(name, nameNode(prop), initializer(prop)!))
        } else {
            // A shorthand property: methods, accessors and spreads are handled above.
            props.push(new Prop(nameNode(prop).text, nameNode(prop), nameNode(prop)))
        }
    }
    for (let i = 0; i < props.length; i++) {
        let first = -1
        for (let j = 0; j < props.length && first === -1; j++) if (props[j].name === props[i].name) first = j
        if (first !== i) return c.fail(props[i].node, `Duplicate property '${props[i].name}'.`)
    }
    return objectOf(c, node, scope, expected, props)
}

/** The dictionary an object literal is for: the expected type, or its only dictionary member when it has no object members. */
function expectedDict(expected: Type | null): MapType | null {
    if (expected === null) return null
    if (expected.kind === "map" && expected.dict) return expected
    if (expected.kind !== "union") return null
    let found: MapType | null = null
    for (const m of expected.members) {
        if (m.kind === "struct" || m.kind === "interface") return null
        if (m.kind === "map" && m.dict) {
            if (found !== null) return null
            found = m
        }
    }
    return found
}

/** The object of an object literal with these properties, of the expected type or of their shape. */
function objectOf(c: Checker, node: Node, scope: Scope, expected: Type | null, props: Prop[]): Operand {
    // The value of a property, checked against a type unless it already was.
    const valueOf = (p: Prop, type: Type | null): Operand => {
        const o = p.operand
        return o !== null ? o : checkExpr(c, p.value, scope, type)
    }

    if (expected !== null && expected.kind === "union") {
        // Pick the object member whose literal-typed fields match the literal, as in a tagged union.
        const candidates = expected.members.filter((m) => m.kind === "struct" || m.kind === "interface")
        const matching = candidates.filter((m) =>
            props.every((p) => {
                const type = fieldType(m, p.name)
                if (type === null) return false
                const k = p.value.kind
                if (k === "TrueKeyword" || k === "FalseKeyword") {
                    const value = k === "TrueKeyword" ? "true" : "false"
                    return membersOf(type).some((t) => t.kind === "bool" && (t.literal === "" || t.literal === value))
                }
                if (!isStringLiteralNode(p.value)) return true
                const lit = literalText(p.value)
                return membersOf(type).some((t) => t.kind === "string" || (t.kind === "literal" && t.value === lit))
            }),
        )
        if (matching.length === 1) return objectOf(c, node, scope, matching[0], props)
        // Otherwise the member with these property names, to report what does not match.
        const byNames = candidates.filter((m) => props.every((p) => fieldType(m, p.name) !== null))
        if (byNames.length === 1 && matching.length === 0) return objectOf(c, node, scope, byNames[0], props)
        if (candidates.length === 1) return objectOf(c, node, scope, candidates[0], props)
        if (candidates.length > 1) {
            return c.fail(
                node,
                matching.length > 1
                    ? `Cannot tell which member of '${typeToString(expected)}' this object literal is. Give its discriminant field a literal value.`
                    : `No member of '${typeToString(expected)}' matches this object literal.`,
            )
        }
    }
    if (expected !== null && expected.kind === "struct") {
        // A literal for a known object type must have exactly its fields.
        let ok = true
        for (const p of props) {
            if (findField(expected, p.name) === null) {
                c.error(p.node, `Property '${p.name}' does not exist in type '${typeToString(expected)}'.`)
                ok = false
            }
        }
        const missing: string[] = []
        for (const f of expected.fields)
            if (!f.optional && !props.some((p) => p.name === f.name)) missing.push(`'${f.name}'`)
        if (missing.length > 0) {
            c.error(
                node,
                `Missing ${missing.length === 1 ? "property" : "properties"} ${missing.join(", ")} of type '${typeToString(expected)}'.`,
            )
            ok = false
        }
        const fields: FieldInit[] = []
        for (const p of props) {
            const field = findField(expected, p.name)
            // A property already reported as unknown has no type to check its value against.
            if (field === null) {
                valueOf(p, null)
                continue
            }
            fields.push(new FieldInit(p.name, c.coerce(valueOf(p, field.type), field.type, p.value)))
        }
        // Optional fields left out are null.
        for (const f of expected.fields) {
            const ft = f.type
            if (f.optional && ft.kind === "union" && !props.some((p) => p.name === f.name))
                fields.push(new FieldInit(f.name, new NullLit(ft)))
        }
        return ok ? typed(new ObjectLit(expected, fields)) : errorOperand
    }

    // For an interface, its field types guide the literal, which is then converted by the caller.
    const hints = expected !== null && expected.kind === "interface" ? expected : null
    if (hints !== null) {
        for (const p of props) {
            if (!hints.members.some((m) => m.k === "field" && m.name === p.name)) {
                return c.fail(
                    p.node,
                    `Object literal may only specify known properties, and '${p.name}' does not exist in type '${hints.name}'.`,
                )
            }
        }
    }
    const fields: FieldInit[] = []
    for (const p of props) {
        let hint: Type | null = null
        if (hints !== null)
            for (const m of hints.members) if (hint === null && m.k === "field" && m.name === p.name) hint = m.type
        const value = valueOf(p, hint)
        if (value.k === "error") return errorOperand
        const expr = hint !== null ? c.coerce(value, hint, p.value) : c.toDefault(value, p.value)
        if (expr.type.kind === "void" || expr.type.kind === "never")
            return c.fail(p.value, `A property cannot have type '${expr.type.kind}'.`)
        fields.push(new FieldInit(p.name, expr))
    }
    const type = c.shape(fields.map((f) => new Field(f.name, f.value.type, false)))
    return typed(new ObjectLit(type, fields))
}

export function checkTemplate(c: Checker, node: Node, scope: Scope): Operand {
    const parts: Expr[] = []
    const head = templateText(templateHead(node))
    if (head !== "") parts.push(new StringLit(types.string, head))
    for (const span of templateSpans(node)) {
        const e = expression(span)
        const value = checkExpr(c, e, scope)
        if (value.k !== "error") {
            const expr = stringified(c, c.toDefault(value, e))
            if (printable(c, expr, e)) parts.push(expr)
        }
        const text = templateText(literal(span))
        if (text !== "") parts.push(new StringLit(types.string, text))
    }
    return typed(new Concat(types.string, parts))
}

/**
 * An object in a template, converted as JavaScript does: a class or an
 * interface with a `toString(): string` method calls it, so an instance of
 * the Error class gives "Name: message"; an `Error` interface value calls
 * the method of the Error class it holds, or gives "Error: message" for
 * another class. Other values are returned as they are.
 */
function stringified(c: Checker, expr: Expr): Expr {
    const type = expr.type
    if (type.kind === "struct" && type.nominal) {
        const method = findMethod(type, "toString")
        if (method !== null && !method.private) {
            const ft = method.func.type
            if (ft.params.length === 0 && ft.result.kind === "string") {
                const call = new MethodCall(types.string, method.func, expr, [])
                dispatch(c, call, "toString")
                return call
            }
        }
        return expr
    }
    if (type.kind !== "interface") return expr
    for (let i = 0; i < type.members.length; i++) {
        const m = type.members[i]
        if (m.k === "method" && m.name === "toString") {
            if (m.type.params.length === 0 && m.type.result.kind === "string")
                return new IfaceCall(types.string, expr, i, m.type, [])
        }
    }
    const basic = c.basicError
    const errorType = c.errorType
    if (type !== errorType || basic === null) return expr
    const toString = findMethod(basic, "toString")
    let messageIndex = -1
    for (let i = 0; i < type.members.length; i++) if (type.members[i].name === "message") messageIndex = i
    if (toString === null || messageIndex === -1) return expr
    const local = c.newLocal("error", type, false)
    const ref = new LocalRef(type, local)
    const call = new MethodCall(types.string, toString.func, new Downcast(basic, ref), [])
    dispatch(c, call, "toString")
    const plain = new Concat(types.string, [
        new StringLit(types.string, "Error: "),
        new IfaceField(types.string, ref, messageIndex),
    ])
    return new Bind(
        types.string,
        [new BindLocal(local, expr)],
        new Conditional(types.string, new Is(types.bool, ref, basic), call, plain),
    )
}

/** Whether a value can be printed or interpolated; reports an error if not. */
export function printable(c: Checker, expr: Expr, node: Node): bool {
    const type = expr.type
    if (
        membersOf(type).every(
            (t) =>
                isNumeric(t) ||
                t.kind === "number-literal" ||
                t.kind === "bigint" ||
                t.kind === "bool" ||
                isStringLike(t) ||
                t.kind === "null",
        )
    )
        return true
    c.error(node, `Cannot format a value of type '${typeToString(type)}'.`)
    return false
}

/** Whether console.log can print a value; reports an error if not. */
export function inspectable(c: Checker, expr: Expr, node: Node): bool {
    if (canInspect(expr.type, new Set<int>())) return true
    c.error(node, `Cannot format a value of type '${typeToString(expr.type)}'.`)
    return false
}

/** Whether console.log prints values of a type: anything but channels and C pointers, and what holds them. */
function canInspect(t: Type, seen: Set<int>): bool {
    switch (t.kind) {
        case "chan":
        case "ptr":
        case "select-case":
        case "void":
        case "never":
            return false
        case "array":
            return canInspect(t.elem, seen)
        case "map":
            return canInspect(t.key, seen) && canInspect(t.value, seen)
        case "set":
            return canInspect(t.elem, seen)
        case "union":
            return t.members.every((m) => canInspect(m, seen))
        case "struct": {
            // A class may refer to itself.
            if (seen.has(t.id)) return true
            seen.add(t.id)
            return t.fields.every((f) => canInspect(f.type, seen))
        }
        default:
            return true
    }
}

/**
 * The exported value `m.name` of a module imported as `* as m`, or null if
 * the expression is not such an access. Reports missing exports.
 */
export function moduleMember(c: Checker, node: Node, scope: Scope): ValueSymbol | null {
    if (node.kind !== "PropertyAccessExpression") return null
    const object = expression(node)
    const nameId = nameNode(node)
    // A built-in namespace, or one nested in it, as `process.command`.
    const ns = c.namespaceAt(object, scope)
    if (ns !== null) {
        // An export of the module implementing the namespace in Ore, such as `fs.stat`.
        const implementation = ns.module
        const exported = implementation !== null ? implementation(nameId.text) : null
        const value = exported !== null ? exported.value : null
        if (value !== null) {
            if (isIdentifier(nameId)) c.info.definitions.set(nameId, value.decl)
            return value
        }
        // A constant of a built-in namespace, such as `Math.PI`, or a nested namespace.
        const member_ = ns.members.get(nameId.text)
        if (member_ === null || (member_.k !== "const" && member_.k !== "namespace")) return null
        if (isIdentifier(nameId)) c.info.definitions.set(nameId, member_.decl)
        return member_
    }
    if (!isIdentifier(object)) return null
    const module = scope.lookupValue(object.text)
    if (module === null) return null
    if (module.k === "class") return staticOf(c, module.type, module.decl, object, nameId)
    if (module.k !== "module") return null
    c.info.definitions.set(object, module.decl)
    const exported = module.exports(nameId.text)
    const value = exported === null ? null : exported.value
    if (value === null) {
        c.error(nameId, `Module '${module.name}' has no exported value '${nameId.text}'.`)
        return new ConstSymbol(errorOperand, null, node)
    }
    if (isIdentifier(nameId)) c.info.definitions.set(nameId, value.decl)
    return value
}

/** `C.name`: a static member of class `C` (or of a base class) as a value symbol, or null. */
function staticOf(c: Checker, type: StructType | null, decl: Node, object: Node, nameId: Node): ValueSymbol | null {
    if (type === null) return genericStatic(c, decl, object, nameId)
    const info = type !== null ? c.classInfos.get(type.id) : null
    const member_ = info !== null ? staticMember(c, info, nameId.text) : null
    if (member_ === null) {
        const name = object.text
        c.error(
            nameId,
            type === null
                ? `Static members of generic classes are not supported yet.`
                : `Class '${name}' has no static member '${nameId.text}'.`,
        )
        return new ConstSymbol(errorOperand, null, nameId)
    }
    c.info.definitions.set(object, decl)
    if (isIdentifier(nameId)) c.info.definitions.set(nameId, member_.decl)
    // A private static member is used only inside the declaration of its class.
    const owner = member_.owner.decl
    const inside = c.sourceOf(nameId) === c.sourceOf(owner) && nameId.start >= owner.start && nameId.end <= owner.end
    if (member_.isPrivate && !inside) {
        c.error(nameId, `'${nameId.text}' is private and only accessible inside class '${member_.owner.type.name}'.`)
        return new ConstSymbol(errorOperand, null, nameId)
    }
    const local = member_.local
    if (local !== null) return new LocalSymbol(local, member_.decl)
    const generic = member_.generic
    if (generic !== null) return new GenericFuncSymbol(generic, member_.decl)
    const symbol = new FuncSymbol(member_.func!, member_.decl)
    symbol.overloads = member_.overloads
    return symbol
}

export function checkProperty(c: Checker, node: Node, scope: Scope): Operand {
    const nameId = nameNode(node)
    const found = moduleMember(c, node, scope)
    if (found !== null) return symbolValue(c, found, nameId)
    // A member of a built-in namespace that is no value: a function, or none.
    const ns = c.namespaceAt(expression(node), scope)
    if (ns !== null) {
        const member_ = ns.members.get(nameId.text)
        if (member_ !== null)
            return c.fail(nameId, `'${ns.name}.${nameId.text}' is a function and cannot be used as a value yet.`)
        return c.fail(nameId, `'${ns.name}' has no member '${nameId.text}'.`)
    }
    const target = checkExpr(c, expression(node), scope)
    if (target.k === "error") return target
    const value = c.toDefault(target, expression(node))
    if (questionDotToken(node) !== null) return optional(c, value, node, (v) => member(c, v, nameId, nameId.text))
    const result = member(c, value, nameId, nameId.text)
    const key = refKey(c, node, scope)
    return result.k === "typed" && key !== null ? typed(narrowed(c, key, result.expr)) : result
}

/** Reads the field or length named by a property access from a value. */
export function member(c: Checker, value: Expr, nameNode_: Node, name: string): Operand {
    const type = value.type
    if (type.kind === "unknown") return c.fail(nameNode_, unknownObject)
    if (type.kind === "map" && type.dict) {
        const entry = dictMember(type, name)
        if (entry !== null) return typed(entryGet(c, value, type, entry))
        return typed(dictGet(c, value, type, new StringLit(types.string, name)))
    }
    if (name === "length" && (type.kind === "string" || type.kind === "array")) return typed(new Len(types.i64, value))
    if (name === "raw" && type.kind === "array" && type.template) return typed(templateRawOf(c, value))
    if (name === "length" && type.kind === "struct" && type.tuple) return new UntypedInt(bigOf(type.fields.length))
    if (name === "length" && membersOf(type).every(isStringLike))
        return typed(new Len(types.i64, new Recast(types.string, value)))
    if (name === "size" && type.kind === "map") return typed(new MapOp("size", types.i64, type, value))
    if (name === "size" && type.kind === "set") return typed(new SetOp("size", types.i64, type, value))
    const property = accessor(c, type, name)
    if (property !== null && type.kind === "struct") {
        defineMember(c, nameNode_, type, name)
        if (!checkAccess(c, type, property.private, name, nameNode_)) return errorOperand
        if (!property.hasGet) return c.fail(nameNode_, `Property '${name}' has a setter but no getter.`)
        return typed(callGetter(property, name, value))
    }
    if (type.kind === "struct") {
        const field = findField(type, name)
        defineMember(c, nameNode_, type, name)
        if (field !== null) {
            if (!checkAccess(c, type, field.private, name, nameNode_)) return errorOperand
            return typed(new FieldGet(field.type, value, name))
        }
        const method = findMethod(type, name)
        if (method !== null) {
            if (!checkAccess(c, type, method.private, name, nameNode_)) return errorOperand
            if (!inferGenerator(c, method.func, nameNode_)) return errorOperand
            const bound: Expr = new BoundMethod(method.func.type, value, method.func)
            dispatch(c, bound, name)
            return typed(bound)
        }
        if (genericMethod(c, type, name) !== null)
            return c.fail(nameNode_, `'${name}' is a generic method and cannot be used as a value; call it.`)
        if (findOverloads(type, name).length > 0)
            return c.fail(
                nameNode_,
                `Function '${type.name}.${name}' has overload signatures and cannot be used as a value.`,
            )
    }
    if (type.kind === "interface") {
        defineMember(c, nameNode_, type, name)
        for (let index = 0; index < type.members.length; index++) {
            const m = type.members[index]
            if (m.name !== name) continue
            if (m.k === "field") return typed(new IfaceField(m.type, value, index))
            return typed(new BoundMethod(m.type, value, null, index))
        }
    }
    if (type.kind === "union" && !canBeNull(type)) {
        // A field that every member has, such as the discriminant of a tagged union.
        const fieldTypes: Type[] = []
        let all = true
        for (const m of type.members) {
            const t = fieldType(m, name)
            if (t === null) all = false
            else fieldTypes.push(t)
        }
        if (all) return typed(new UnionField(c.unionOf(fieldTypes), value, name))
    }
    return c.fail(nameNode_, noProperty(type, name))
}

/** The error for using a value of type `unknown` as an object before narrowing it, as TypeScript reports it. */
export const unknownObject = "Object is of type 'unknown'."

export function noProperty(type: Type, name: string): string {
    const message = `Property '${name}' does not exist on type '${typeToString(type)}'.`
    if (type.kind === "union" && type.members.some((m) => m.kind === "null")) {
        return `${message} The value may be null: check it with '!== null' first, or use '?.'.`
    }
    return message
}

/**
 * Optional chaining: `access` applied to the non-null value, or `null`.
 * Values that cannot be null are accessed directly.
 */
export function optional(c: Checker, value: Expr, node: Node, access: (value: Expr) => Operand): Operand {
    if (!canBeNull(value.type)) return access(value)
    const binding = c.newLocal("opt", c.withoutNull(value.type), false)
    const result = access(new LocalRef(binding.type, binding))
    if (result.k !== "typed") return result
    const resultType = result.expr.type
    if (resultType.kind === "void") return typed(new Optional(types.void, value, binding, result.expr))
    const union = c.unionOf([resultType, types.null])
    if (union.kind !== "union") process.panic("optional: not a union")
    return typed(new Optional(union, value, binding, c.coerce(result, union, node)))
}

export function checkInstanceOf(c: Checker, node: Node, scope: Scope): Operand {
    const value_ = checkExpr(c, left(node), scope)
    if (value_.k !== "typed") return value_.k === "error" ? value_ : c.fail(left(node), "A constant is not an object.")
    const value = value_.expr
    const target = instanceOfTarget(c, right(node), scope, value.type)
    if (target === null) return errorOperand
    const test = instanceTest(c, value, target)
    if (test !== null) return typed(test)
    return c.fail(
        node,
        `A value of type '${typeToString(value.type)}' is never an instance of '${typeToString(target)}'.`,
    )
}

/** The `is` test of `value instanceof target`, or null if it can never be true. */
export function instanceTest(c: Checker, value: Expr, target: StructType | InterfaceType): Expr | null {
    const type = value.type
    if (type.kind === "unknown") return target.kind === "struct" ? new Is(types.bool, value, target) : null
    if (sameType(type, target)) return new BoolLit(types.bool, true)
    // An instance of a class is an instance of its base classes; one of a base class may be of a subclass.
    const related = (m: Type): bool =>
        m.kind === "struct" && target.kind === "struct" && (isSubclass(m, target) || isSubclass(target, m))
    if (type.kind === "struct" && target.kind === "struct" && isSubclass(type, target))
        return new BoolLit(types.bool, true)
    if (type.kind === "struct" && related(type)) return new Is(types.bool, value, target)
    if (type.kind === "union" && type.members.some((m) => sameType(m, target) || related(m)))
        return new Is(types.bool, value, target)
    // A class with the members of an interface is always an instance of it, as an error class is of `Error`.
    if (
        type.kind === "struct" &&
        type.nominal &&
        target.kind === "interface" &&
        conformance(c, type, target).reason === null
    )
        return new BoolLit(types.bool, true)
    if (target.kind !== "struct") return null
    if (type.kind === "interface" && conformance(c, target, type).reason === null)
        return new Is(types.bool, value, target)
    const via = interfaceFor(c, type, target)
    return via !== null ? new Is(types.bool, value, target, via) : null
}

/** The interface member of a union that a class implements, if exactly one. */
export function interfaceFor(c: Checker, type: Type, cls: StructType): InterfaceType | null {
    if (type.kind !== "union") return null
    const ifaces: InterfaceType[] = []
    for (const m of type.members) if (m.kind === "interface" && conformance(c, cls, m).reason === null) ifaces.push(m)
    return ifaces.length === 1 ? ifaces[0] : null
}

export function instanceOfTarget(
    c: Checker,
    node: Node,
    scope: Scope,
    valueType: Type,
): StructType | InterfaceType | null {
    const symbol = isIdentifier(node) ? scope.lookupType(node.text) : null
    if (symbol !== null) c.info.definitions.set(node, symbol.decl)
    // A generic class without type arguments, as in TypeScript: the instance of it among the value's types.
    const generic = symbol !== null ? symbol.generic : null
    if (generic !== null && generic.decl.kind === "ClassDeclaration") {
        const found: StructType[] = []
        for (const m of membersOf(valueType)) {
            const info = m.kind === "struct" ? c.instanceOf.get(m) : null
            if (m.kind === "struct" && info !== null && info.generic === generic) found.push(m)
        }
        if (found.length === 1) return found[0]
        c.error(
            node,
            found.length === 0
                ? `A value of type '${typeToString(valueType)}' is never an instance of '${generic.name}'.`
                : `'${generic.name}' needs its type arguments here: the value may be one of several instances of it.`,
        )
        return null
    }
    const type = symbol !== null ? symbol.type : null
    if (type !== null && type.kind === "struct" && type.nominal) return type
    if (type !== null && type.kind === "interface") return type
    c.error(node, "The right side of 'instanceof' must be a class or an interface.")
    return null
}

export function checkNonNull(c: Checker, node: Node, scope: Scope): Operand {
    const value_ = checkExpr(c, expression(node), scope)
    if (value_.k !== "typed") return value_
    const value = value_.expr
    if (!canBeNull(value.type))
        return c.fail(node, `Type '${typeToString(value.type)}' cannot be null; '!' is not needed.`)
    return typed(new Recast(c.withoutNull(value.type), value))
}

export function checkCoalesce(c: Checker, node: Node, scope: Scope): Operand {
    const value_ = checkExpr(c, left(node), scope)
    if (value_.k !== "typed")
        return value_.k === "error" ? value_ : c.fail(left(node), "The left side of '??' cannot be null.")
    const value = value_.expr
    if (!canBeNull(value.type))
        return c.fail(left(node), `Type '${typeToString(value.type)}' cannot be null; '??' is not needed.`)
    const type = c.withoutNull(value.type)
    const fallback = c.coerce(checkExpr(c, right(node), scope, type), type, right(node))
    return typed(new Coalesce(type, value, fallback))
}

export function checkElement(c: Checker, node: Node, scope: Scope): Operand {
    const target = checkExpr(c, expression(node), scope)
    if (target.k === "error") return target
    const value = c.toDefault(target, expression(node))
    const element = (whole: Expr): Operand => {
        const v = matchCaptures(whole) ?? whole
        const vt = v.type
        if (vt.kind === "struct" && vt.tuple) {
            const field = tupleField(c, vt, argumentExpression(node), scope)
            return field === null ? errorOperand : typed(new FieldGet(field.type, v, field.name))
        }
        if (vt.kind === "map" && vt.dict) {
            const key = dictKey(c, argumentExpression(node), scope)
            if (key === null) return errorOperand
            const entry = entryNamed(vt, key)
            return typed(entry !== null ? entryGet(c, v, vt, entry) : dictGet(c, v, vt, key))
        }
        if (vt.kind === "struct" || vt.kind === "interface" || vt.kind === "union") {
            const keyed = keyedMember(c, v, argumentExpression(node), scope)
            if (keyed !== null) return keyed
            return c.fail(
                argumentExpression(node),
                `Type '${typeToString(vt)}' is indexed by the name of a member, a string literal or a 'keyof' type.`,
            )
        }
        const index = checkIndex(c, argumentExpression(node), scope)
        if (index === null) return errorOperand
        if (vt.kind === "string") return typed(new Index(types.u8, v, index))
        if (vt.kind === "array") return typed(new Index(vt.elem, v, index))
        if (vt.kind === "unknown") return c.fail(expression(node), unknownObject)
        return c.fail(expression(node), `Type '${typeToString(vt)}' cannot be indexed.`)
    }
    return questionDotToken(node) !== null ? optional(c, value, node, element) : element(value)
}

/**
 * The captures of a `RegExpMatch`, which is indexed, destructured and
 * iterated as JavaScript's match arrays are: `m[1]`, `const [, k, v] = m`;
 * null for any other value.
 */
export function matchCaptures(v: Expr): Expr | null {
    const t = v.type
    if (t.kind !== "struct" || !t.nominal || t.name !== "RegExpMatch") return null
    for (const f of t.fields) if (f.name === "captures") return new FieldGet(f.type, v, f.name)
    return null
}

/** The element of a tuple at a constant index. */
export function tupleField(c: Checker, tuple: StructType, node: Node, scope: Scope): Field | null {
    const index = checkExpr(c, node, scope)
    if (index.k === "error") return null
    if (index.k !== "untyped-int") {
        c.error(node, "A tuple is indexed by a constant integer.")
        return null
    }
    const n = tuple.fields.length
    if (bigIsNeg(index.value) || !bigLt(index.value, bigOf(n))) {
        c.error(
            node,
            `Tuple type '${typeToString(tuple)}' of length ${n} has no element at index ${bigText(index.value)}.`,
        )
        return null
    }
    return tuple.fields[bigToI64(index.value)]
}

/** Checks an index or offset: any integer type, and untyped constants must not be negative. */
export function checkIndex(c: Checker, node: Node, scope: Scope, allowNegative: bool = false): Expr | null {
    const value = checkExpr(c, node, scope)
    if (value.k === "error") return null
    if (value.k === "untyped-int" && bigIsNeg(value.value) && !allowNegative) {
        c.error(node, `Index ${bigText(value.value)} must not be negative.`)
        return null
    }
    const expr = value.k === "typed" ? value.expr : c.coerce(value, types.i64, node)
    if (expr.type.kind !== "int") {
        c.error(node, `An index must be an integer, got '${typeToString(expr.type)}'.`)
        return null
    }
    return expr
}

/** Records the declaration of a field or method for go to definition. */
export function defineMember(c: Checker, node: Node, type: StructType | InterfaceType, name: string) {
    const decls = c.memberDecls.get(type)
    const decl = decls === null ? null : decls.get(name)
    if (decl !== null && isIdentifier(node)) c.info.definitions.set(node, decl)
}

/**
 * `C.name` for a generic class `C`: its static methods do not see the class's
 * type parameters, as in TypeScript, so they are functions of their own,
 * made once on first use (generic ones per call); a static field is one
 * global shared by all instances (see `genericStaticField`).
 */
function genericStatic(c: Checker, decl: Node, object: Node, nameId: Node): ValueSymbol | null {
    const known = c.genericStatics.get(nameId.text + "@" + `${decl.start}`)
    if (known !== null) return known
    const owner = c.genericsByDecl.get(decl)
    const scope = owner !== null ? owner.scope : null
    let found: Node | null = null
    for (const m of members(decl)) {
        const n = m.child("name")
        if (n !== null && isIdentifier(n) && n.text === nameId.text && hasModifier(m, "StaticKeyword")) found = m
    }
    if (found === null || scope === null) {
        c.error(nameId, `Class '${object.text}' has no static member '${nameId.text}'.`)
        return new ConstSymbol(errorOperand, null, nameId)
    }
    c.info.definitions.set(object, decl)
    if (isIdentifier(nameId)) c.info.definitions.set(nameId, found)
    // A private static member is used only inside the declaration of its class.
    const inside = c.sourceOf(nameId) === c.sourceOf(decl) && nameId.start >= decl.start && nameId.end <= decl.end
    if (hasModifier(found, "PrivateKeyword") && !inside) {
        c.error(nameId, `'${nameId.text}' is private and only accessible inside class '${object.text}'.`)
        return new ConstSymbol(errorOperand, null, nameId)
    }
    if (found.kind === "PropertyDeclaration") {
        const local = genericStaticField(c, found, owner!)
        return new LocalSymbol(local, found)
    }
    if (found.kind !== "MethodDeclaration" || body(found) === null) {
        c.error(nameId, `Class '${object.text}' has no static member '${nameId.text}'.`)
        return new ConstSymbol(errorOperand, null, nameId)
    }
    const name = `${object.text}.${nameId.text}`
    let symbol: ValueSymbol
    if (typeParameters(found).length > 0) {
        symbol = new GenericFuncSymbol(
            new Generic(name, found, typeParameters(found), scope, new Map<string, Instance>()),
            found,
        )
    } else {
        const func = makeFunc(c, found, scope, name, `${cIdent(object.text)}_gs_${cIdent(nameId.text)}`, false)
        const method = found
        c.pending.push(inContext(c, name, () => checkFunctionBody(c, method, func, scope)))
        symbol = new FuncSymbol(func, found)
    }
    c.genericStatics.set(nameId.text + "@" + `${decl.start}`, symbol)
    return symbol
}

/**
 * The type of `x as const`: literals keep their literal types, an array
 * literal is a read-only tuple and an object literal has read-only fields,
 * all the way down; any other value keeps its type.
 */
function constType(c: Checker, node: Node, scope: Scope): Type | null {
    const k = node.kind
    if (k === "ParenthesizedExpression") return constType(c, expression(node), scope)
    if (k === "StringLiteral") return c.literal(stringText(node))
    if (k === "NoSubstitutionTemplateLiteral") return c.literal(templateText(node))
    if (k === "NumericLiteral") return c.numberLiteral(node.text)
    if (k === "PrefixUnaryExpression" && c.text(node).startsWith("-") && operand(node).kind === "NumericLiteral")
        return c.numberLiteral(`-${operand(node).text}`)
    if (k === "ArrayLiteralExpression") {
        const elems: Type[] = []
        for (const e of elements(node)) {
            if (e.kind === "SpreadElement") {
                c.error(e, "'as const' takes array literals without spread elements.")
                return null
            }
            const t = constType(c, e, scope)
            if (t === null) return null
            elems.push(t)
        }
        return c.tupleOf(elems, [], true)
    }
    if (k === "ObjectLiteralExpression") {
        const fields: Field[] = []
        for (const p of properties(node)) {
            const value = p.kind === "PropertyAssignment" ? initializer(p) : null
            const name = p.kind === "PropertyAssignment" ? c.memberName(nameNode(p)) : null
            if (value === null || name === null) {
                c.error(p, "'as const' takes object literals of 'name: value' properties.")
                return null
            }
            const t = constType(c, value, scope)
            if (t === null) return null
            fields.push(new Field(name, t, true))
        }
        return c.shape(fields)
    }
    const value = checkExpr(c, node, scope)
    if (value.k === "error") return null
    return typeOf(c.toDefault(value, node))
}
