} from "../ir/types"
import { type Node } from "../syntax/ast"
import {
    argumentExpression,
    elements,
    expression,
    initializer,
    isIdentifier,
    isStringLiteralNode,
    left,
    literal,
    nameNode,
    operand,
    operatorToken,
