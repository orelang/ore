// The Ore language server, over the JSON-RPC of ./jsonrpc. Documents are
// kept as the client edits them (full or incremental changes, positions in
// UTF-16 units) and analyzed on every change, which publishes diagnostics.
// Repositories imported by GitHub URLs are downloaded in tasks, one at a
// time and once per session, reported with work-done progress.

import {
    analyze,
    tokenModifiers,
    tokenTypes,
    type Analysis,
    type Hover,
    type Location,
    type Reference,
} from "./analysis"
import {
    Connection,
    InvalidParams,
    InvalidRequest,
    MethodNotFound,
    params,
    ServerNotInitialized,
    type Message,
} from "./jsonrpc"
import { dirname, isAbsolute, join } from "ore:path"
import { resolveImport } from "../project/resolve"
import {
    Fetched,
    fetchRepository,
    GithubModule,
    isCommitHash,
    isGithubUrl,
    known,
    parseGithubUrl,
    repositoryKey,
} from "../project/remote"
import { moduleSpecifier, stringValue } from "../syntax/imports"
import { parse as parseFile } from "../syntax/parse"
import { cacheRoot } from "../driver/cache"
import { docsUrl } from "../syntax/codes"
import { format } from "../fmt/print"
import { offsetAt, pathToUri, positionAt, rangeOf, uriToPath, type Position, type Range } from "./text"

// ---------------------------------------------------------------------------
// The params and results of the methods, as JSON

type TextDocumentIdentifier = { uri: string }
type TextDocumentItem = { uri: string; languageId: string; version: int; text: string }
type WorkspaceFolder = { uri: string; name: string }
type InitializeParams = {
    rootUri: string | null
    workspaceFolders: WorkspaceFolder[] | null
    capabilities: { window: { workDoneProgress: bool | null } | null } | null
}
type DidOpenParams = { textDocument: TextDocumentItem }
type ContentChange = { range: Range | null; text: string }
type DidChangeParams = { textDocument: { uri: string; version: int | null }; contentChanges: ContentChange[] }
type DidCloseParams = { textDocument: TextDocumentIdentifier }
type PositionParams = { textDocument: TextDocumentIdentifier; position: Position }
type ReferenceParams = {
    textDocument: TextDocumentIdentifier
    position: Position
    context: { includeDeclaration: bool }
}
type RenameParams = { textDocument: TextDocumentIdentifier; position: Position; newName: string }

type LspLocation = { uri: string; range: Range }
type LspRelated = { location: LspLocation; message: string }
type LspDiagnostic = {
    range: Range
    severity: int
    source: string
    message: string
    /** The code of the message, and the address of its page. */
    code: string | null
    codeDescription: { href: string } | null
    /** The places related to the message, as the declaration of a name declared twice. */
    relatedInformation: LspRelated[]
}
type TextEdit = { range: Range; newText: string }
/** A diagnostic as a client sends it back in a code action request. */
type ClientDiagnostic = { range: Range; message: string; code: string | null }
type CodeActionParams = {
    textDocument: TextDocumentIdentifier
    range: Range
    context: { diagnostics: ClientDiagnostic[] }
}
type CodeAction = {
    title: string
    kind: string
    diagnostics: ClientDiagnostic[]
    isPreferred: bool
    edit: { changes: Map<string, TextEdit[]> }
}

/** TextDocumentSyncKind.Incremental */
const syncIncremental = 2
/** DiagnosticSeverity */
const severityError = 1
const severityWarning = 2
/** CompletionItemKind */
const kindMethod = 2
const kindField = 5
/** MessageType.Error of window/logMessage */
const messageError = 1

/** The method of the notifications the server's download tasks post to it. */
const remoteMethod = "ore/remote"

/**
 * What a download task reports: a phase of the download of a repository
 * ("checking", "downloading", "done"), or its end ("fetched" with the
 * commit, or "failed" with the error).
 */
type RemoteEvent = {
    key: string
    phase: string
    percent: int
    dir: string
    commit: string
    warning: string | null
    error: string | null
}

/** A repository imported by a GitHub URL, downloaded once per session. */
class Remote {
    constructor(
        readonly module: GithubModule,
        /** The token of its work-done progress. */
        readonly token: string,
    ) {}

    /** "waiting", "checking", "downloading" or "done", then "fetched" or "failed". */
    phase = "waiting"
    fetched: Fetched | null = null
    error = ""

    /** The repository's name, with the branch or tag when the URL names one. */
    get name(): string {
        const module = this.module
        const ref = module.ref
        const named = ref !== "" && !isCommitHash(ref)
        return named ? `${module.owner}/${module.repo} (${ref})` : `${module.owner}/${module.repo}`
    }
}

/** What a phase of a download is doing, for the editor. */
function phaseText(phase: string): string {
    switch (phase) {
        case "waiting":
            return "waiting for another download"
        case "checking":
            return "checking for a new commit"
        case "downloading":
            return "downloading"
    }
    return phase
}

/** An open document: its text as the client has it. */
class Document {
    constructor(
        readonly uri: string,
        public version: int,
        public text: string,
    ) {}

    /** Changed since its last analysis, which waits for the changes typed right after. */
    stale = false
}

/** The text with a change applied: a whole new text, or a range replaced. */
function applyChange(text: string, change: ContentChange): string {
    const range = change.range
    if (range === null) return change.text
    const start = offsetAt(text, range.start)
    const end = Math.max(start, offsetAt(text, range.end))
    return text.slice(0, start) + change.text + text.slice(end)
}

/** Whether a new name is an identifier. */
function validName(name: string): bool {
    if (name.length === 0) return false
    for (let i = 0; i < name.length; i++) {
        const b = name[i]
        const letter = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b === 95 || b === 36
        if (!letter && (i === 0 || b < 48 || b > 57)) return false
    }
    return true
}

/** Serves Ore language features over a connection. */
export class Server {
    private readonly documents = new Map<string, Document>()
    private readonly analyses = new Map<string, Analysis>()
    private roots: string[] = []
    private initialized = false
    private shutdown = false
    /** The repositories imported by GitHub URLs, by `repositoryKey`. */
    private readonly remotes = new Map<string, Remote>()
    /** The repositories to download after the one being downloaded, in order. */
    private waiting: Remote[] = []
    private downloading = false
    /** Whether the client shows work-done progress the server creates. */
    private workDoneProgress = false
    private progressTokens = 0

    constructor(
        private readonly connection: Connection,
        private readonly version: string,
    ) {
        // Analyses take repositories from GitHub that are in the cache or
        // downloaded by the server, and never wait for a download.
        known.enabled = true
    }

    /** Handles messages until `exit` or the end of the input; the exit code. */
    run(): int {
        this.connection.listen()
        while (true) {
            const m = this.connection.next()
            if (m === null) return this.shutdown ? 0 : 1
            if (m.method === "exit") return this.shutdown ? 0 : 1
            // A response: to window/workDoneProgress/create, whose result the server does not need.
            if (m.method === "") continue
            this.handle(m)
            this.fetchWanted()
        }
    }

    private handle(m: Message): void {
        const request = m.isRequest()
        if (!this.initialized && m.method !== "initialize") {
            if (request) this.connection.respondError(m.id, ServerNotInitialized, "The server is not initialized.")
            return
        }
        if (this.shutdown && request) {
            this.connection.respondError(m.id, InvalidRequest, "The server is shutting down.")
            return
        }
        switch (m.method) {
            case "initialize":
                this.initialize(m)
                return
            case "initialized":
                return
            case remoteMethod:
                this.remoteEvent(m)
                return
            case "shutdown":
                this.shutdown = true
                this.connection.respond(m.id, "null")
                return
            case "textDocument/didOpen":
                this.didOpen(m)
                return
            case "textDocument/didChange":
                this.didChange(m)
                return
            case "textDocument/didClose":
                this.didClose(m)
                return
            case "textDocument/hover":
                this.hover(m)
                return
            case "textDocument/completion":
                this.completion(m)
                return
            case "textDocument/definition":
                this.definition(m)
                return
            case "textDocument/signatureHelp":
                this.signatureHelp(m)
                return
            case "textDocument/formatting":
                this.formatting(m)
                return
            case "textDocument/semanticTokens/full": {
                const p = params<{ textDocument: TextDocumentIdentifier }>(m)
                if (p instanceof Error) return this.invalid(m, p)
                const analysis = this.analysisOf(p.textDocument.uri)
                const data: int[] = analysis !== null ? analysis.semanticTokens() : []
                const result: { data: int[] } = { data }
                this.connection.respond(m.id, JSON.stringify(result))
                return
            }
            case "textDocument/codeAction":
                this.codeAction(m)
                return
            case "textDocument/inlayHint": {
                const p = params<{ textDocument: TextDocumentIdentifier; range: Range }>(m)
                if (p instanceof Error) return this.invalid(m, p)
                const analysis = this.analysisOf(p.textDocument.uri)
                // kind 1: a type, after the name.
                const hints: { position: Position; label: string; kind: int; paddingLeft: bool }[] = []
                if (analysis !== null)
                    for (const h of analysis.inlayHints(p.range))
                        hints.push({ position: h.position, label: h.label, kind: 1, paddingLeft: false })
                this.connection.respond(m.id, JSON.stringify(hints))
                return
            }
            case "textDocument/documentSymbol": {
                const p = params<{ textDocument: TextDocumentIdentifier }>(m)
                if (p instanceof Error) return this.invalid(m, p)
                const analysis = this.analysisOf(p.textDocument.uri)
                this.connection.respond(m.id, analysis === null ? "[]" : JSON.stringify(analysis.symbols()))
                return
            }
            case "textDocument/references":
                this.references(m)
                return
            case "textDocument/prepareRename":
                this.prepareRename(m)
                return
            case "textDocument/rename":
                this.rename(m)
                return
        }
        // Notifications the server does not handle, such as didSave and `$/...`, are ignored.
        if (request) this.connection.respondError(m.id, MethodNotFound, `Unhandled method ${m.method}`)
    }

    /** Reports params that could not be read: an error for a request, a log message for a notification. */
    private invalid(m: Message, error: Error): void {
        if (m.isRequest()) this.connection.respondError(m.id, InvalidParams, error.message)
        else this.log(`ore: invalid params for ${m.method}: ${error.message}`)
    }

    private log(message: string): void {
        const p: { type: int; message: string } = { type: messageError, message }
        this.connection.notify("window/logMessage", JSON.stringify(p))
    }

    // -------------------------------------------------------------------------
    // Lifecycle

    private initialize(m: Message): void {
        if (this.initialized) {
            this.connection.respondError(m.id, InvalidRequest, "The server is already initialized.")
            return
        }
        const p = params<InitializeParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const roots: string[] = []
        const folders = p.workspaceFolders
        if (folders !== null) for (const f of folders) roots.push(uriToPath(f.uri))
        else if (p.rootUri !== null) roots.push(uriToPath(p.rootUri))
        this.roots = roots
        const capabilities = p.capabilities
        const window = capabilities === null ? null : capabilities.window
        this.workDoneProgress = window !== null && window.workDoneProgress === true
        this.initialized = true
        const result = {
            capabilities: {
                textDocumentSync: syncIncremental,
                hoverProvider: true,
                definitionProvider: true,
                referencesProvider: true,
                renameProvider: { prepareProvider: true },
                completionProvider: { triggerCharacters: ["."] },
                signatureHelpProvider: { triggerCharacters: ["(", ","] },
                documentFormattingProvider: true,
                documentSymbolProvider: true,
                inlayHintProvider: true,
                semanticTokensProvider: { legend: { tokenTypes, tokenModifiers }, full: true },
                codeActionProvider: { codeActionKinds: ["quickfix"] },
            },
            serverInfo: { name: "ore", version: this.version },
        }
        this.connection.respond(m.id, JSON.stringify(result))
    }

    // -------------------------------------------------------------------------
    // Documents

    private didOpen(m: Message): void {
        const p = params<DidOpenParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const item = p.textDocument
        const document = new Document(item.uri, item.version, item.text)
        this.documents.set(item.uri, document)
        this.update(document)
    }

    private didChange(m: Message): void {
        const p = params<DidChangeParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const document = this.documents.get(p.textDocument.uri)
        if (document === null) return
        for (const change of p.contentChanges) document.text = applyChange(document.text, change)
        const version = p.textDocument.version
        if (version !== null) document.version = version
        // While typing, only the last of the changes received is analyzed.
        if (this.connection.pending("textDocument/didChange")) {
            document.stale = true
            return
        }
        this.update(document)
    }

    private didClose(m: Message): void {
        const p = params<DidCloseParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const uri = p.textDocument.uri
        this.documents.delete(uri)
        this.analyses.delete(uri)
        this.publish(uri, [])
    }

    /** The analysis of an open document, brought up to date if it is stale. */
    private analysisOf(uri: string): Analysis | null {
        const document = this.documents.get(uri)
        if (document !== null && document.stale) this.update(document)
        return this.analyses.get(uri)
    }

    /** Analyzes a document and publishes its diagnostics. */
    private update(document: Document): void {
        document.stale = false
        const analysis = analyze(uriToPath(document.uri), document.text)
        this.analyses.set(document.uri, analysis)
        const diagnostics: LspDiagnostic[] = []
        for (const d of analysis.diagnostics()) {
            const coded = d.code !== ""
            const related: LspRelated[] = []
            for (const r of d.related)
                related.push({
                    location: { uri: locationUri(r.location, document.uri), range: r.location.range },
                    message: r.message,
                })
            diagnostics.push({
                range: analysis.range(d.start, d.end),
                severity: d.severity === "error" ? severityError : severityWarning,
                source: "ore",
                message: d.message,
                code: coded ? d.code : null,
                codeDescription: coded ? { href: docsUrl(d.code) } : null,
                relatedInformation: related,
            })
        }
        this.publish(document.uri, diagnostics)
    }

    private publish(uri: string, diagnostics: LspDiagnostic[]): void {
        const p: { uri: string; diagnostics: LspDiagnostic[] } = { uri, diagnostics }
        this.connection.notify("textDocument/publishDiagnostics", JSON.stringify(p))
    }

    /** The current text of a file: the open document's, or the file on disk. */
    private textOf(path: string): string | null {
        const open = this.documents.get(pathToUri(path))
        if (open !== null) return open.text
        const text = fs.readFile(path)
        return text instanceof Error ? null : text
    }

    /** The analysis of the current text of a document (kept for an open one), or null if it cannot be read. */
    private fresh(uri: string): Analysis | null {
        const kept = this.analysisOf(uri)
        if (kept !== null) return kept
        const path = uriToPath(uri)
        const open = this.documents.get(uri)
        const text = open !== null ? open.text : this.textOf(path)
        if (text === null) return null
        return analyze(path, text)
    }

    /**
     * The references to a symbol in the document's program and in the .ore
     * files of the workspace that can refer to it: the file that declares it,
     * and the files that name it and import that file.
     */
    private workspaceReferences(uri: string, key: string, name: string): Reference[] {
        const current = uriToPath(uri)
        const declared = key.slice(0, key.lastIndexOf(":"))
        const files = [current]
        if (isAbsolute(declared)) {
            for (const file of this.workspaceFiles()) {
                if (file === current) continue
                const text = this.textOf(file)
                if (text === null || !text.includes(name)) continue
                if (file === declared || importsFile(file, text, declared)) files.push(file)
            }
        }
        const found = new Map<string, Reference>()
        for (const file of files) {
            const analysis = this.fresh(pathToUri(file))
            if (analysis === null) continue
            for (const r of analysis.references(key))
                found.set(`${r.path}:${r.range.start.line}:${r.range.start.character}`, r)
        }
        return found.values()
    }

    /** The .ore files below the workspace's folders, outside node_modules, dist and hidden directories. */
    private workspaceFiles(): string[] {
        const files: string[] = []
        for (const root of this.roots) collectOreFiles(root, files)
        return files
    }

    // -------------------------------------------------------------------------
    // Modules from GitHub

    /** Queues the downloads of the repositories the analyses looked up and did not find. */
    private fetchWanted(): void {
        if (known.wanted.length === 0) return
        const wanted = known.wanted
        known.wanted = []
        for (const module of wanted) {
            const key = repositoryKey(module)
            if (this.remotes.has(key)) continue
            const remote = new Remote(module, `ore/github/${this.progressTokens}`)
            this.progressTokens++
            this.remotes.set(key, remote)
            this.waiting.push(remote)
            if (this.workDoneProgress) {
                // The client handles the request before the notifications that follow it.
                const create: { token: string } = { token: remote.token }
                this.connection.request(remote.token, "window/workDoneProgress/create", JSON.stringify(create))
                const begin: { kind: string; title: string; message: string; percentage: int; cancellable: bool } = {
                    kind: "begin",
                    title: `GitHub: ${remote.name}`,
                    message: phaseText(remote.phase),
                    percentage: 0,
                    cancellable: false,
                }
                this.progress(remote, JSON.stringify(begin))
            }
        }
        this.nextDownload()
    }

    /** Sends the work-done progress of a download, given its value as JSON text. */
    private progress(remote: Remote, value: string): void {
        if (!this.workDoneProgress) return
        this.connection.notify("$/progress", `{"token":${JSON.stringify(remote.token)},"value":${value}}`)
    }

    /**
     * Starts downloading the next repository in a task, unless one is being
     * downloaded: one at a time, since the downloads share the record of the
     * repositories found in the process. The task posts its progress and its
     * result to the server's own queue of messages.
     */
    private nextDownload(): void {
        if (this.downloading || this.waiting.length === 0) return
        const remote = this.waiting[0]
        this.waiting = this.waiting.slice(1)
        this.downloading = true
        const connection = this.connection
        const module = remote.module
        const key = repositoryKey(module)
        const root = cacheRoot()
        task.spawn(() => {
            const progress = (phase: string, percent: int) => {
                const event: RemoteEvent = { key, phase, percent, dir: "", commit: "", warning: null, error: null }
                connection.post(remoteMethod, JSON.stringify(event))
            }
            const result = fetchRepository(root, module, progress)
            const end: RemoteEvent = {
                key,
                phase: "failed",
                percent: 100,
                dir: "",
                commit: "",
                warning: null,
                error: null,
            }
            if (result instanceof Error) end.error = result.message
            else {
                end.phase = "fetched"
                end.dir = result.dir
                end.commit = result.commit
                end.warning = result.warning
            }
            connection.post(remoteMethod, JSON.stringify(end))
        })
    }

    /** A phase of a download, or its end: reported, and at the end the open documents analyzed again. */
    private remoteEvent(m: Message): void {
        const p = params<RemoteEvent>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const remote = this.remotes.get(p.key)
        if (remote === null) return
        remote.phase = p.phase
        const failed = p.phase === "failed"
        if (!failed && p.phase !== "fetched") {
            const report: { kind: string; message: string; percentage: int } = {
                kind: "report",
                message: phaseText(p.phase),
                percentage: p.percent,
            }
            this.progress(remote, JSON.stringify(report))
            return
        }
        let message = ""
        if (failed) {
            const error = p.error ?? ""
            remote.error = error
            known.found.set(p.key, new Error(error))
            message = error
        } else {
            const fetched = new Fetched(p.dir, p.commit, p.warning)
            remote.fetched = fetched
            known.found.set(p.key, fetched)
            message = `at commit ${p.commit.slice(0, 12)}`
        }
        const end: { kind: string; message: string } = { kind: "end", message }
        this.progress(remote, JSON.stringify(end))
        this.downloading = false
        this.nextDownload()
        // Any open document may import the repository, through other modules too.
        for (const document of this.documents.values()) this.update(document)
    }

    /** The hover of an import specifier that is a GitHub URL: the state of its repository's download. */
    private remoteHover(uri: string, position: Position): Hover | null {
        const document = this.documents.get(uri)
        if (document === null || !document.text.includes("https://github.com/")) return null
        const text = document.text
        const offset = offsetAt(text, position)
        const parsed = parseFile(uriToPath(uri), text)
        for (const stmt of parsed.source.ast.list("statements")) {
            const specifier = moduleSpecifier(stmt)
            if (specifier === null || offset < specifier.start || offset >= specifier.end) continue
            const url = stringValue(specifier)
            if (!isGithubUrl(url)) return null
            const range = rangeOf(text, specifier.start, specifier.end)
            const module = parseGithubUrl(url)
            if (module instanceof Error) return { contents: module.message, range }
            const remote = this.remotes.get(repositoryKey(module))
            const contents =
                remote !== null ? remoteText(remote) : `GitHub: **${module.owner}/${module.repo}**: not downloaded`
            return { contents, range }
        }
        return null
    }

    // -------------------------------------------------------------------------
    // Language features

    private hover(m: Message): void {
        const p = params<PositionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const remote = this.remoteHover(p.textDocument.uri, p.position)
        if (remote !== null) return this.respondHover(m, remote)
        const analysis = this.analysisOf(p.textDocument.uri)
        const hover = analysis === null ? null : analysis.hover(p.position)
        if (hover === null) return this.connection.respond(m.id, "null")
        this.respondHover(m, hover)
    }

    private respondHover(m: Message, hover: Hover): void {
        const result: { contents: { kind: string; value: string }; range: Range } = {
            contents: { kind: "markdown", value: hover.contents },
            range: hover.range,
        }
        this.connection.respond(m.id, JSON.stringify(result))
    }

    private completion(m: Message): void {
        const p = params<PositionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        // Analyze the current text: completion is requested right after typing.
        const document = this.documents.get(p.textDocument.uri)
        const items: {
            label: string
            kind: int
            detail: string
            documentation: { kind: string; value: string } | null
        }[] = []
        if (document !== null) {
            const analysis = analyze(uriToPath(document.uri), document.text)
            for (const c of analysis.completions(p.position)) {
                const doc = c.documentation
                items.push({
                    label: c.label,
                    kind: c.kind === "method" ? kindMethod : kindField,
                    detail: c.detail,
                    documentation: doc === "" ? null : { kind: "markdown", value: doc },
                })
            }
        }
        this.connection.respond(m.id, JSON.stringify(items))
    }

    /** The whole document formatted as `ore fmt` does: one edit, none when it is formatted, null when it does not parse. */
    private formatting(m: Message): void {
        const p = params<{ textDocument: TextDocumentIdentifier }>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const document = this.documents.get(p.textDocument.uri)
        if (document === null) return this.connection.respond(m.id, "null")
        const text = document.text
        const formatted = format(text)
        if (formatted instanceof Error) return this.connection.respond(m.id, "null")
        const edits: TextEdit[] = []
        if (formatted !== text)
            edits.push({
                range: { start: { line: 0, character: 0 }, end: positionAt(text, text.length) },
                newText: formatted,
            })
        this.connection.respond(m.id, JSON.stringify(edits))
    }

    /** Quick fixes of the diagnostics in the range that have a mechanical fix. */
    private codeAction(m: Message): void {
        const p = params<CodeActionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const uri = p.textDocument.uri
        const document = this.documents.get(uri)
        const actions: CodeAction[] = []
        if (document !== null) {
            for (const d of p.context.diagnostics) {
                const fix = quickFix(document.text, d.message, d.range)
                if (fix === null) continue
                const changes = new Map<string, TextEdit[]>()
                changes.set(uri, [fix.edit])
                actions.push({
                    title: fix.title,
                    kind: "quickfix",
                    diagnostics: [d],
                    isPreferred: true,
                    edit: { changes },
                })
            }
        }
        this.connection.respond(m.id, JSON.stringify(actions))
    }

    private signatureHelp(m: Message): void {
        const p = params<PositionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        // The current text: signature help is requested right after typing.
        const document = this.documents.get(p.textDocument.uri)
        const help =
            document === null ? null : analyze(uriToPath(document.uri), document.text).signatureHelp(p.position)
        if (help === null) return this.connection.respond(m.id, "null")
        const parameters: { label: string }[] = []
        for (const label of help.parameters) parameters.push({ label })
        const result: {
            signatures: {
                label: string
                documentation: { kind: string; value: string }
                parameters: { label: string }[]
            }[]
            activeSignature: int
            activeParameter: int
        } = {
            signatures: [
                { label: help.label, documentation: { kind: "markdown", value: help.documentation }, parameters },
            ],
            activeSignature: 0,
            activeParameter: help.active,
        }
        this.connection.respond(m.id, JSON.stringify(result))
    }

    private definition(m: Message): void {
        const p = params<PositionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const analysis = this.analysisOf(p.textDocument.uri)
        const location = analysis === null ? null : analysis.definition(p.position)
        if (location === null) return this.connection.respond(m.id, "null")
        const result: LspLocation = { uri: locationUri(location, p.textDocument.uri), range: location.range }
        this.connection.respond(m.id, JSON.stringify(result))
    }

    private references(m: Message): void {
        const p = params<ReferenceParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const locations: LspLocation[] = []
        const analysis = this.fresh(p.textDocument.uri)
        const symbol = analysis === null ? null : analysis.symbolAt(p.position)
        if (symbol !== null) {
            for (const r of this.workspaceReferences(p.textDocument.uri, symbol.key, symbol.name)) {
                if (p.context.includeDeclaration || !r.declaration)
                    locations.push({ uri: pathToUri(r.path), range: r.range })
            }
        }
        this.connection.respond(m.id, JSON.stringify(locations))
    }

    private prepareRename(m: Message): void {
        const p = params<PositionParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        const analysis = this.fresh(p.textDocument.uri)
        const symbol = analysis === null ? null : analysis.symbolAt(p.position)
        if (symbol === null) return this.connection.respond(m.id, "null")
        if (symbol.builtin) return this.connection.respondError(m.id, 0, "Built-in declarations cannot be renamed.")
        const result: { range: Range; placeholder: string } = { range: symbol.range, placeholder: symbol.name }
        this.connection.respond(m.id, JSON.stringify(result))
    }

    private rename(m: Message): void {
        const p = params<RenameParams>(m)
        if (p instanceof Error) return this.invalid(m, p)
        if (!validName(p.newName)) return this.connection.respondError(m.id, 0, `'${p.newName}' is not a valid name.`)
        const analysis = this.fresh(p.textDocument.uri)
        const symbol = analysis === null ? null : analysis.symbolAt(p.position)
        if (symbol === null || symbol.builtin) return this.connection.respond(m.id, "null")
        const changes = new Map<string, TextEdit[]>()
        for (const r of this.workspaceReferences(p.textDocument.uri, symbol.key, symbol.name)) {
            const uri = pathToUri(r.path)
            const existing = changes.get(uri)
            const edits: TextEdit[] = existing ?? []
            if (existing === null) changes.set(uri, edits)
            edits.push({ range: r.range, newText: `${r.prefix}${p.newName}${r.suffix}` })
        }
        const result: { changes: Map<string, TextEdit[]> } = { changes }
        this.connection.respond(m.id, JSON.stringify(result))
    }
}

/**
 * The URI of a location. Files without a path on disk (the embedded std) are
 * written into the build cache, `<cache>/lsp/<path>` (see driver/cache), or
 * into the temporary directory when the cache is off.
 */
function locationUri(location: Location, current: string): string {
    const text = location.text
    if (text === null) return location.path === uriToPath(current) ? current : pathToUri(location.path)
    const root = cacheRoot()
    const base = root !== "" ? root : join(fs.tempDir(), "ore")
    const path = join(base, "lsp", location.path.replaceAll(":", "/"))
    fs.mkdir(dirname(path), true)
    fs.writeFile(path, text)
    return pathToUri(path)
}

/** The markdown that tells the state of a repository's download: its phase, its commit, or why it failed. */
function remoteText(remote: Remote): string {
    const name = `GitHub: **${remote.name}**`
    const fetched = remote.fetched
    if (fetched !== null) {
        const cached = `${name}: cached at commit \`${fetched.commit.slice(0, 12)}\``
        const warning = fetched.warning
        return warning === null ? cached : `${cached}\n\n${warning}`
    }
    if (remote.phase === "failed") return `${name}: ${remote.error}`
    return `${name}: ${phaseText(remote.phase)}`
}

/** A fix of a diagnostic: what it does, and the edit. */
class QuickFix {
    constructor(
        readonly title: string,
        readonly edit: TextEdit,
    ) {}
}

/**
 * The fix of a diagnostic that says the change to make: an explicit
 * conversion, `===` for `==`, `let` for `var`, a name for a misspelled
 * one, a `!` that is not needed. Null for the others.
 */
function quickFix(text: string, message: string, range: Range): QuickFix | null {
    const start = offsetAt(text, range.start)
    const end = offsetAt(text, range.end)
    const written = text.slice(start, end)
    const conversion = "Use an explicit conversion: '"
    const at = message.indexOf(conversion)
    if (at >= 0) {
        const rest = message.slice(at + conversion.length)
        const open = rest.indexOf("(")
        if (open > 0) {
            const name = rest.slice(0, open)
            return new QuickFix(`Convert with '${name}(...)'`, { range, newText: `${name}(${written})` })
        }
    }
    if (message.endsWith("'!' is not needed.") && written.endsWith("!"))
        return new QuickFix("Remove the '!'", { range, newText: written.slice(0, written.length - 1) })
    if (message.startsWith("'var' is not supported in Ore.") && written.startsWith("var"))
        return new QuickFix("Use 'let'", { range, newText: `let${written.slice(3)}` })
    // "'==' is not supported in Ore. Use '==='." and "Cannot find name 'x'. Use 'y'.": the written text replaced.
    const use = message.lastIndexOf(" Use '")
    if (use >= 0 && message.endsWith("'.")) {
        const replacement = message.slice(use + 6, message.length - 2)
        if (!replacement.includes("'") && !replacement.includes("(") && replacement !== written)
            return new QuickFix(`Use '${replacement}'`, { range, newText: replacement })
    }
    return null
}

/** Adds the .ore files below a directory, outside node_modules, dist, target and hidden directories. */
function collectOreFiles(dir: string, out: string[]): void {
    const names = fs.readDir(dir)
    if (names instanceof Error) return
    for (const name of names) {
        if (name.startsWith(".") || name === "node_modules" || name === "dist" || name === "target") continue
        const path = join(dir, name)
        if (fs.isDir(path)) collectOreFiles(path, out)
        else if (name.endsWith(".ore")) out.push(path)
    }
}

/** Whether a module imports the file `target`. */
function importsFile(file: string, text: string, target: string): bool {
    const parsed = parseFile(file, text)
    for (const stmt of parsed.source.ast.list("statements")) {
        const specifier = moduleSpecifier(stmt)
        if (specifier === null) continue
        const resolved = resolveImport(stringValue(specifier), file)
        if (typeof resolved === "string" && resolved === target) return true
    }
    return false
}

/** Serves on standard input and output; the exit code. */
export function serve(version: string): int {
    return new Server(new Connection(0, 1), version).run()
}
