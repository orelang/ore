// What the language server knows of a document, behind a small interface.
// For now only the parser runs:
// diagnostics are syntax errors. The parts that need the checker (hover,
// definition, completion, references, rename) are marked TODO(checker), with
// the signatures they will have.
//
// Positions are zero-based UTF-16 offsets, as in LSP (see ./text).

import { parse } from "../syntax/parser"
import { rangeOf, type Position, type Range } from "./text"

/** A problem in the document, with its span in bytes. */
export type Diagnostic = { message: string; severity: "error" | "warning"; start: int; end: int }

/** A location in the analyzed file, or in a file such as `runtime/std/builtin.d.ore`. */
export type Location = {
    path: string
    /** Text of the target file, for files that are not on disk. */
    text: string | null
    range: Range
}

/** A use or the declaration of a symbol, with how to rename it there. */
export type Reference = {
    path: string
    range: Range
    /** Text kept before and after the new name, for shorthand `{ x }` that must become `x: y` or `y: x`. */
    prefix: string
    suffix: string
    declaration: bool
}

/** A symbol declared in source code, identified across analyses by where its name is. */
export type SymbolAt = {
    key: string
    name: string
    range: Range
    /** Declared in the standard library, which cannot be renamed. */
    builtin: bool
}

export type Completion = {
    label: string
    kind: "field" | "method"
    /** The member's type. */
    detail: string
}

/** Markdown hover text and the range of the identifier it describes. */
export type Hover = { contents: string; range: Range }

/** The result of analyzing one document. */
export interface Analysis {
    /** The document's own diagnostics. */
    diagnostics(): Diagnostic[]
    /** The range of a span of bytes of the document. */
    range(start: int, end: int): Range
    /** The symbol named by the identifier at a position: used or declared there. */
    symbolAt(position: Position): SymbolAt | null
    /** The uses and the declaration of a symbol in the modules of this program. */
    references(key: string): Reference[]
    /** Markdown hover text for the identifier at a position. */
    hover(position: Position): Hover | null
    /** Members of the value before a `.` at a position. */
    completions(position: Position): Completion[]
    /** Where the identifier at a position is declared. */
    definition(position: Position): Location | null
}

/** An analysis from the parser alone: syntax errors, and nothing that needs types. */
class SyntaxAnalysis {
    private readonly errors: Diagnostic[] = []

    constructor(
        readonly path: string,
        readonly text: string,
    ) {
        const parser = parse(text)
        for (const e of parser.diagnostics)
            this.errors.push({ message: e.message, severity: "error", start: e.start, end: e.end })
    }

    diagnostics(): Diagnostic[] {
        return this.errors
    }

    range(start: int, end: int): Range {
        return rangeOf(this.text, start, end)
    }

    // TODO(checker): the declaration the checker resolved for the identifier at
    // the position (CheckInfo.definitions), or the declaration it names; the
    // key is `${file}:${offset of its name}`, `builtin` when the file is not
    // absolute (the embedded std).
    symbolAt(position: Position): SymbolAt | null {
        return null
    }

    // TODO(checker): the identifier at the offset of the key in its module,
    // and every identifier whose definition has that key, with the prefix and
    // suffix of shorthand properties and binding elements.
    references(key: string): Reference[] {
        return []
    }

    // TODO(checker): "```ore\n...\n```" with the signature of a function,
    // method or constructor, `type`, `class` and `interface` text, `(property)
    // Owner.name: T`, or `const|let|(parameter) name: T` from CheckInfo.types.
    hover(position: Position): Hover | null {
        return null
    }

    // TODO(checker): for the property access around the position, the
    // functions of a built-in namespace, or the members of the type of the
    // expression: fields and methods of structs (private ones only inside the
    // class), interface members, and the built-in members of arrays, strings,
    // channels and maps.
    completions(position: Position): Completion[] {
        return []
    }

    // TODO(checker): the name of the declaration the identifier refers to,
    // with the text of `runtime/std/builtin.d.ore`, which is not on disk.
    definition(position: Position): Location | null {
        return null
    }
}

/**
 * Analyzes a document. TODO(checker): load the program with the modules the
 * document imports, read from the disk with `text` for `path`, check it, and
 * report the document's own diagnostics; with syntax errors, only those, with
 * types still collected for completion where possible.
 */
export function analyze(path: string, text: string): Analysis {
    return new SyntaxAnalysis(path, text)
}
