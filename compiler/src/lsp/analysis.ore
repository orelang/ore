// What the language server knows of a document: the program it belongs to,
// loaded with the document's text and checked, so that its diagnostics are
// the checker's, and hover, definition, references, rename and completion
// come from the checker's facts (the type of each expression, the
// declaration of each identifier, the source of each node).
//
// Positions are zero-based UTF-16 offsets, as in LSP (see ./text).

import { basename, dirname, isAbsolute, resolve } from "ore:path"
import { check } from "../checker/checker"
import { type CheckInfo } from "../checker/context"
import { arrayMethods, stringMethods } from "../checker/helpers"
import { typeToString, type Type } from "../ir/types"
import { LoadOptions, loadProgram } from "../project/load"
import { stdModules } from "../project/resolve"
import { type Node } from "../syntax/ast"
import { type Diagnostic as SourceDiagnostic } from "../syntax/diagnostic"
import { parse as parseFile, type ParseResult } from "../syntax/parse"
import { parse } from "../syntax/parser"
import { type Source } from "../syntax/source"
import { offsetAt, positionAt, rangeOf, type Position, type Range } from "./text"

/** A location in the analyzed file, or in a file such as `runtime/std/builtin.d.ore`. */
export type Location = {
    path: string
    /** Text of the target file, for files that are not on disk. */
    text: string | null
    range: Range
}

/** A place related to a diagnostic, with a short message: `'x' is declared here.` */
export type RelatedPlace = { location: Location; message: string }

/** A problem in the document, with its span in bytes and the places related to it. */
export type Diagnostic = {
    message: string
    severity: "error" | "warning"
    start: int
    end: int
    code: string
    related: RelatedPlace[]
}

/** A use or the declaration of a symbol, with how to rename it there. */
export type Reference = {
    path: string
    range: Range
    /** Text kept before and after the new name, for shorthand `{ x }` that must become `x: y` or `y: x`. */
    prefix: string
    suffix: string
    declaration: bool
}

/** A symbol declared in source code, identified across analyses by where its name is. */
export type SymbolAt = {
    key: string
    name: string
    range: Range
    /** Declared in the standard library, which cannot be renamed. */
    builtin: bool
}

export type Completion = {
    label: string
    kind: "field" | "method"
    /** The member's type. */
    detail: string
    /** The member's JSDoc comment, as Markdown. */
    documentation: string
}

/** The signature of the function being called, its parameters (substrings of `label`), and which one is being written. */
export type SignatureHelp = { label: string; documentation: string; parameters: string[]; active: int }

/** A declaration of the document for its outline: its kind is LSP's SymbolKind. */
export class DocumentSymbol {
    constructor(
        readonly name: string,
        readonly kind: int,
        readonly range: Range,
        readonly selectionRange: Range,
        readonly children: DocumentSymbol[],
    ) {}
}

/** A type shown after a name that has none written: `const total` shows `: i64`. */
export type InlayHint = { position: Position; label: string }

/** Markdown hover text and the range of the identifier it describes. */
export type Hover = { contents: string; range: Range }

/** The result of analyzing one document. */
export interface Analysis {
    /** The document's own diagnostics. */
    diagnostics(): Diagnostic[]
    /** The range of a span of bytes of the document. */
    range(start: int, end: int): Range
    /** The symbol named by the identifier at a position: used or declared there. */
    symbolAt(position: Position): SymbolAt | null
    /** The uses and the declaration of a symbol in the modules of this program. */
    references(key: string): Reference[]
    /** Markdown hover text for the identifier at a position. */
    hover(position: Position): Hover | null
    /** Members of the value before a `.` at a position. */
    completions(position: Position): Completion[]
    /** Where the identifier at a position is declared. */
    definition(position: Position): Location | null
    /** The signature of the call whose arguments are being written at a position. */
    signatureHelp(position: Position): SignatureHelp | null
    /** The declarations of the document, for its outline. */
    symbols(): DocumentSymbol[]
    /** The inferred types of the variables and parameters declared without one in a range. */
    inlayHints(range: Range): InlayHint[]
    /** The semantic tokens of the document, encoded as LSP sends them (see `tokenTypes`). */
    semanticTokens(): int[]
}

/** The legend of semantic tokens: their types and modifiers, by index. */
export const tokenTypes = [
    "namespace",
    "type",
    "class",
    "interface",
    "typeParameter",
    "parameter",
    "variable",
    "property",
    "function",
    "method",
]
export const tokenModifiers = ["declaration", "readonly", "defaultLibrary"]

// LSP's SymbolKind.
const kindNamespace = 3
const kindClass = 5
const kindMethod = 6
const kindProperty = 7
const kindField = 8
const kindConstructor = 9
const kindInterface = 11
const kindFunction = 12
const kindVariable = 13
const kindConstant = 14
const kindTypeParameter = 26

/** Kinds of nodes whose leading comment documents the declaration inside them. */
const documented = [
    "VariableStatement",
    "FunctionDeclaration",
    "ClassDeclaration",
    "InterfaceDeclaration",
    "TypeAliasDeclaration",
    "ModuleDeclaration",
    "MethodDeclaration",
    "MethodSignature",
    "PropertyDeclaration",
    "PropertySignature",
    "GetAccessor",
    "SetAccessor",
    "Constructor",
    "Parameter",
    "EnumDeclaration",
]

/** Kinds of declarations whose hover shows their text up to the body. */
const headed = [
    "FunctionDeclaration",
    "MethodDeclaration",
    "MethodSignature",
    "ClassDeclaration",
    "InterfaceDeclaration",
    "TypeAliasDeclaration",
    "ModuleDeclaration",
    "GetAccessor",
    "SetAccessor",
    "Constructor",
]

/** The runtime and the standard library, parsed once per session and reused by every analysis. */
const parsedModules = new Map<string, ParseResult>()

/** The parent of each node of a tree. */
class Parents {
    readonly of = new Map<Node, Node>()

    constructor(root: Node) {
        this.add(root)
    }

    private add(node: Node) {
        for (const child of node.children) {
            this.of.set(child, node)
            this.add(child)
        }
    }
}

/** An analysis from the checker, or from the parser alone when the program does not load or parse. */
class CheckedAnalysis {
    private readonly errors: Diagnostic[] = []
    /** The document's module, once loaded. */
    private source: Source | null = null
    private info: CheckInfo | null = null
    private readonly parents = new Map<Source, Parents>()

    constructor(
        readonly path: string,
        readonly text: string,
    ) {
        const absolute = isAbsolute(path) ? path : resolve(path)
        // The declarations of the built-in names are not a module of a
        // program: the checker reads them itself; only their syntax is checked.
        if (absolute.endsWith("/runtime/std/builtin.d.ore")) {
            // As the checker parses it.
            for (const d of parseFile("runtime/std/builtin.d.ore", text).diagnostics)
                this.errors.push({
                    message: d.message,
                    severity: d.severity,
                    start: d.start,
                    end: d.start + d.length,
                    code: d.code,
                    related: [],
                })
            return
        }
        const options = new LoadOptions()
        options.absolutePaths = true
        options.parsed = parsedModules
        // A module of the runtime or the standard library is checked as the
        // module it is, `ore:...`, which every program loads or may import.
        const module = moduleName(absolute)
        let entryPath = absolute
        if (module !== "") {
            options.overrides.set(module, text)
            entryPath = `${dirname(absolute)}/.ore-lsp-entry.ore`
            options.overrides.set(
                entryPath,
                module.startsWith("ore:runtime/") ? "" : `import * as m from "${module}"\n`,
            )
        } else {
            options.overrides.set(absolute, text)
        }
        const loaded = loadProgram(entryPath, options)
        if (loaded instanceof Error) {
            const parser = parse(text)
            for (const e of parser.diagnostics)
                this.errors.push({
                    message: e.message,
                    severity: "error",
                    start: e.start,
                    end: e.end,
                    code: "",
                    related: [],
                })
            return
        }
        let entry = loaded.entry
        if (module !== "") for (const m of loaded.modules) if (m.path === module) entry = m
        this.source = entry
        for (const d of loaded.diagnostics) if (d.source === entry) this.errors.push(this.diagnosticOf(d))
        if (loaded.syntaxErrors) return
        // The runtime and the standard library are checked by their tests:
        // only their declarations matter here, unless one is the document.
        const signaturesOnly = new Set<Source>()
        for (const m of loaded.modules) if (m !== entry && m.path.startsWith("ore:")) signaturesOnly.add(m)
        const result = check(loaded, signaturesOnly)
        this.info = result.info
        for (const d of result.diagnostics) if (d.source === entry) this.errors.push(this.diagnosticOf(d))
    }

    /** A diagnostic of the document's module, with its related places in any module. */
    private diagnosticOf(d: SourceDiagnostic): Diagnostic {
        const related: RelatedPlace[] = []
        for (const r of d.related) {
            const path = this.pathOf(r.source)
            related.push({
                location: {
                    path,
                    text: isAbsolute(path) ? null : r.source.text,
                    range: rangeOf(r.source.text, r.start, r.start + r.length),
                },
                message: r.message,
            })
        }
        return {
            message: d.message,
            severity: d.severity,
            start: d.start,
            end: d.start + d.length,
            code: d.code,
            related,
        }
    }

    diagnostics(): Diagnostic[] {
        return this.errors
    }

    range(start: int, end: int): Range {
        return rangeOf(this.text, start, end)
    }

    /** The identifier of the document at a position (or just before it, at its end). */
    private identifierAt(position: Position): Node | null {
        const source = this.source
        if (source === null) return null
        const offset = offsetAt(this.text, position)
        return identifierIn(source.ast, offset)
    }

    /** The parents of the nodes of a module, computed once. */
    private parentsOf(source: Source): Parents {
        const known = this.parents.get(source)
        if (known !== null) return known
        const parents = new Parents(source.ast)
        this.parents.set(source, parents)
        return parents
    }

    /** The declaration an identifier refers to, or the declaration it names. */
    private declarationOf(identifier: Node): Node | null {
        const info = this.info
        if (info === null) return null
        const decl = info.definitions.get(identifier)
        if (decl !== null) return decl
        // The name of a declaration refers to that declaration.
        const source = this.source
        if (source === null) return null
        const parent = this.parentsOf(source).of.get(identifier)
        if (parent !== null && parent.child("name") === identifier) return parent
        if (info.types.has(identifier)) return identifier
        return null
    }

    /** The name of a declaration: its `name`, or itself for an identifier. */
    private nameOf(decl: Node): Node {
        if (decl.kind === "Identifier") return decl
        return decl.child("name") ?? decl
    }

    /** The path of a module: the document's file for the document, even when it is an `ore:` module. */
    private pathOf(source: Source): string {
        if (source === this.source) return isAbsolute(this.path) ? this.path : resolve(this.path)
        return source.path
    }

    private sourceOf(node: Node): Source | null {
        const info = this.info
        return info === null ? null : info.sources.get(node)
    }

    symbolAt(position: Position): SymbolAt | null {
        const identifier = this.identifierAt(position)
        if (identifier === null) return null
        const decl = this.declarationOf(identifier)
        if (decl === null) return null
        const name = this.nameOf(decl)
        const source = this.sourceOf(name)
        if (source === null) return null
        return {
            key: `${this.pathOf(source)}:${name.start}`,
            name: identifier.text,
            range: this.range(identifier.start, identifier.end),
            builtin: !isAbsolute(this.pathOf(source)),
        }
    }

    references(key: string): Reference[] {
        const found: Reference[] = []
        const source = this.source
        const info = this.info
        if (source === null || info === null) return found
        const parents = this.parentsOf(source)
        const identifiers: Node[] = []
        collectIdentifiers(source.ast, identifiers)
        for (const identifier of identifiers) {
            const decl = this.declarationOf(identifier)
            if (decl === null) continue
            const name = this.nameOf(decl)
            const declSource = this.sourceOf(name)
            if (declSource === null || `${this.pathOf(declSource)}:${name.start}` !== key) continue
            // A shorthand property `{ x }` keeps its key or its value when renamed.
            const parent = parents.of.get(identifier)
            let prefix = ""
            let suffix = ""
            if (parent !== null && parent.kind === "ShorthandPropertyAssignment") {
                if (decl === identifier || name === identifier) suffix = `: ${identifier.text}`
                else prefix = `${identifier.text}: `
            }
            found.push({
                path: this.pathOf(source),
                range: this.range(identifier.start, identifier.end),
                prefix,
                suffix,
                declaration: name === identifier,
            })
        }
        return found
    }

    hover(position: Position): Hover | null {
        const identifier = this.identifierAt(position)
        const info = this.info
        if (identifier === null || info === null) return null
        const decl = this.declarationOf(identifier)
        const type = info.types.get(identifier)
        let code = ""
        let doc = ""
        if (decl !== null) {
            const source = this.sourceOf(decl)
            if (source !== null) {
                code = this.header(source, decl, identifier.text, type)
                doc = this.docOf(source, decl)
            }
        }
        if (code === "" && type !== null) code = `${identifier.text}: ${typeToString(type)}`
        if (code === "") return null
        const contents = doc === "" ? "```ore\n" + code + "\n```" : "```ore\n" + code + "\n```\n\n" + doc
        return { contents, range: this.range(identifier.start, identifier.end) }
    }

    /** The code shown for a declaration: its text up to the body, or `kind name: T`. */
    private header(source: Source, decl: Node, name: string, type: Type | null): string {
        if (headed.includes(decl.kind)) {
            const body = decl.child("body")
            let end = decl.end
            if (body !== null) end = body.start
            else if (decl.kind === "ClassDeclaration" || decl.kind === "InterfaceDeclaration") {
                const open = source.text.indexOf("{", decl.start)
                if (open >= 0 && open < decl.end) end = open
            }
            // As TypeScript shows them: without `export` and `declare`.
            let header = collapse(source.text.slice(decl.start, end))
            if (header.startsWith("export ")) header = header.slice(7)
            if (header.startsWith("declare ")) header = header.slice(8)
            return header
        }
        const parents = this.parentsOf(source)
        let what = ""
        let node: Node | null = decl
        while (node !== null && what === "") {
            const k = node.kind
            if (k === "Parameter") what = "(parameter) "
            else if (k === "PropertyDeclaration" || k === "PropertySignature") what = "(property) "
            else if (k === "VariableDeclarationList") {
                const text = source.text.slice(node.start, node.end)
                what = text.startsWith("const") ? "const " : text.startsWith("let") ? "let " : "var "
            } else if (documented.includes(k) || k === "Block" || k === "SourceFile") what = " "
            node = parents.of.get(node)
        }
        const shown = type !== null ? typeToString(type) : null
        if (shown === null) {
            const annotation = decl.child("type")
            if (annotation === null) return ""
            return `${what.trim() === "" ? "" : what}${name}: ${source.text.slice(annotation.start, annotation.end)}`
        }
        return `${what.trim() === "" ? "" : what}${name}: ${shown}`
    }

    /** The JSDoc comment of a declaration, as Markdown, or "". */
    private docOf(source: Source, decl: Node): string {
        const parents = this.parentsOf(source)
        // A parameter without a comment of its own has the `@param` of its function.
        let param = ""
        let node: Node | null = decl
        while (node !== null) {
            if (documented.includes(node.kind)) {
                const comment = jsdocBefore(source.text, node.start)
                if (comment !== "") return param === "" ? renderJsdoc(comment) : paramDoc(comment, param)
                if (node.kind !== "Parameter") return ""
                const name = node.child("name")
                if (name !== null && name.kind === "Identifier") param = name.text
            }
            node = parents.of.get(node)
        }
        return ""
    }

    signatureHelp(position: Position): SignatureHelp | null {
        const offset = offsetAt(this.text, position)
        // The `(` of the call around the offset, and the commas of its arguments before the offset.
        let depth = 0
        let commas = 0
        let open = -1
        for (let i = offset - 1; i >= 0 && open < 0; i--) {
            const c = this.text[i]
            if (c === 41 || c === 93 || c === 125) depth++
            else if (c === 40 || c === 91 || c === 123) {
                if (depth === 0 && c === 40) open = i
                else if (depth === 0) return null
                else depth--
            } else if (c === 44 && depth === 0) commas++
            else if (c === 59) return null
        }
        if (open < 0) return null
        let end = open
        while (end > 0 && (this.text[end - 1] === 32 || this.text[end - 1] === 9)) end--
        // A call being written does not parse: its signature comes from the program with the call closed.
        if (this.info === null) {
            // The rest of the line, which may be half written, is left out.
            const lineEnd = this.text.indexOf("\n", offset)
            const rest = lineEnd < 0 ? "" : this.text.slice(lineEnd)
            const patched = new CheckedAnalysis(this.path, this.text.slice(0, offset) + ")" + rest)
            return patched.signatureAt(end, commas)
        }
        return this.signatureAt(end, commas)
    }

    /** The signature of the function named by the identifier that ends at `end`. */
    signatureAt(end: int, active: int): SignatureHelp | null {
        const source = this.source
        if (source === null || this.info === null) return null
        const callee = identifierIn(source.ast, end)
        if (callee === null || callee.end !== end) return null
        const decl = this.declarationOf(callee)
        if (decl === null) return null
        const declSource = this.sourceOf(decl)
        if (declSource === null) return null
        const k = decl.kind
        if (k !== "FunctionDeclaration" && k !== "MethodDeclaration" && k !== "MethodSignature") return null
        const parameters: string[] = []
        for (const p of decl.list("parameters")) parameters.push(collapse(declSource.text.slice(p.start, p.end)))
        return {
            label: this.header(declSource, decl, callee.text, null),
            documentation: this.docOf(declSource, decl),
            parameters,
            active,
        }
    }

    semanticTokens(): int[] {
        const data: int[] = []
        const source = this.source
        const info = this.info
        if (source === null || info === null) return data
        const identifiers: Node[] = []
        collectIdentifiers(source.ast, identifiers)
        const parents = this.parentsOf(source)
        let line = 0
        let character = 0
        for (const identifier of identifiers) {
            const decl = this.declarationOf(identifier)
            if (decl === null) continue
            const declSource = this.sourceOf(decl)
            if (declSource === null) continue
            let type = tokenType(decl, declSource, this.parentsOf(declSource))
            if (type < 0) continue
            let modifiers = 0
            const name = this.nameOf(decl)
            // A parameter property (`constructor(readonly x: int)`) is a field where it is used.
            if (type === 5 && name !== identifier && decl.list("modifiers").length > 0) type = 7
            if (name === identifier) modifiers |= 1
            if (isReadonly(decl, declSource, this.parentsOf(declSource))) modifiers |= 2
            if (!isAbsolute(this.pathOf(declSource))) modifiers |= 4
            const start = positionAt(this.text, identifier.start)
            const end = positionAt(this.text, identifier.end)
            if (start.line !== end.line) continue
            const deltaLine = start.line - line
            data.push(deltaLine)
            data.push(deltaLine === 0 ? start.character - character : start.character)
            data.push(end.character - start.character)
            data.push(type)
            data.push(modifiers)
            line = start.line
            character = start.character
        }
        return data
    }

    inlayHints(range: Range): InlayHint[] {
        const found: InlayHint[] = []
        const source = this.source
        const info = this.info
        if (source === null || info === null) return found
        const start = offsetAt(this.text, range.start)
        const end = offsetAt(this.text, range.end)
        this.hintsIn(source.ast, start, end, info, found)
        return found
    }

    private hintsIn(node: Node, start: int, end: int, info: CheckInfo, out: InlayHint[]) {
        if (node.end < start || node.start > end) return
        const k = node.kind
        // A variable, or a parameter of a function literal, without a type annotation.
        if ((k === "VariableDeclaration" || k === "Parameter") && node.child("type") === null) {
            const name = node.child("name")
            const type = name !== null && name.kind === "Identifier" ? info.types.get(name) : null
            if (name !== null && type !== null && (k === "VariableDeclaration" || node.child("initializer") === null))
                out.push({ position: positionAt(this.text, name.end), label: `: ${typeToString(type)}` })
        }
        for (const child of node.children) this.hintsIn(child, start, end, info, out)
    }

    symbols(): DocumentSymbol[] {
        const source = this.source
        const ast = source !== null ? source.ast : parse(this.text).file
        if (ast === null) return []
        return this.symbolsIn(ast.list("statements"))
    }

    private symbolsIn(nodes: Node[]): DocumentSymbol[] {
        const found: DocumentSymbol[] = []
        for (const n of nodes) {
            const k = n.kind
            if (k === "VariableStatement") {
                const list = n.child("declarationList")
                if (list === null) continue
                const constant = this.text.slice(list.start, list.end).startsWith("const")
                for (const d of list.list("declarations")) {
                    const name = d.child("name")
                    if (name !== null && name.kind === "Identifier")
                        found.push(this.symbol(name.text, constant ? kindConstant : kindVariable, d, name, []))
                }
                continue
            }
            const name = n.child("name")
            if (name === null) continue
            const label = name.kind === "Identifier" ? name.text : this.text.slice(name.start, name.end)
            if (k === "FunctionDeclaration") found.push(this.symbol(label, kindFunction, n, name, []))
            else if (k === "ClassDeclaration")
                found.push(this.symbol(label, kindClass, n, name, this.membersOf(n.list("members"))))
            else if (k === "InterfaceDeclaration")
                found.push(this.symbol(label, kindInterface, n, name, this.membersOf(n.list("members"))))
            else if (k === "TypeAliasDeclaration") found.push(this.symbol(label, kindTypeParameter, n, name, []))
            else if (k === "ModuleDeclaration") {
                const body = n.child("body")
                const children: DocumentSymbol[] = body !== null ? this.symbolsIn(body.list("statements")) : []
                found.push(this.symbol(label, kindNamespace, n, name, children))
            }
        }
        return found
    }

    private membersOf(members: Node[]): DocumentSymbol[] {
        const found: DocumentSymbol[] = []
        for (const m of members) {
            const k = m.kind
            const name = m.child("name")
            if (k === "Constructor") {
                found.push(this.symbol("constructor", kindConstructor, m, m, []))
                continue
            }
            if (name === null) continue
            const label = name.kind === "Identifier" ? name.text : this.text.slice(name.start, name.end)
            if (k === "MethodDeclaration" || k === "MethodSignature")
                found.push(this.symbol(label, kindMethod, m, name, []))
            else if (k === "GetAccessor" || k === "SetAccessor")
                found.push(this.symbol(label, kindProperty, m, name, []))
            else if (k === "PropertyDeclaration" || k === "PropertySignature")
                found.push(this.symbol(label, kindField, m, name, []))
        }
        return found
    }

    private symbol(name: string, kind: int, node: Node, nameNode: Node, children: DocumentSymbol[]): DocumentSymbol {
        const selection =
            nameNode === node ? this.range(node.start, node.start) : this.range(nameNode.start, nameNode.end)
        return new DocumentSymbol(name, kind, this.range(node.start, node.end), selection, children)
    }

    completions(position: Position): Completion[] {
        const offset = offsetAt(this.text, position)
        // The start of the name being typed after the dot.
        let start = offset
        while (start > 0 && isNameByte(this.text[start - 1])) start--
        const dot = start - 1
        if (dot < 0 || this.text[dot] !== 46) return []
        // `a.` alone does not parse: the members come from the program with a name after the dot.
        if (start === offset && (this.info === null || this.source === null)) {
            const patched = new CheckedAnalysis(this.path, this.text.slice(0, offset) + "x" + this.text.slice(offset))
            return patched.membersBefore(dot)
        }
        return this.membersBefore(dot)
    }

    /** The members of the expression that ends at the dot at `dot`. */
    membersBefore(dot: int): Completion[] {
        const source = this.source
        const info = this.info
        const found: Completion[] = []
        if (source === null || info === null) return found
        const target = expressionEndingAt(source.ast, dot, info)
        if (target === null) return found
        // A namespace (`Math.`), a module imported as `* as m`, or a class's static members.
        const decl = target.kind === "Identifier" ? info.definitions.get(target) : null
        if (decl !== null && !info.types.has(target)) {
            const declSource = info.sources.get(decl)
            if (declSource !== null) membersOfDeclaration(decl, declSource, found)
            return found
        }
        const type = info.types.get(target)
        if (type === null) return found
        membersOfType(type, found)
        // The documentation of the members declared in source.
        const owners: Type[] = []
        if (type.kind === "union") for (const m of type.members) owners.push(m)
        else owners.push(type)
        const withDocs: Completion[] = []
        for (const c of found)
            withDocs.push({
                label: c.label,
                kind: c.kind,
                detail: c.detail,
                documentation: this.memberDoc(owners, c.label),
            })
        return withDocs
    }

    /** The JSDoc comment of the member `name` of one of the types, or "". */
    private memberDoc(owners: Type[], name: string): string {
        const info = this.info
        if (info === null) return ""
        for (const owner of owners) {
            let decls: Map<string, Node> | null = null
            if (owner.kind === "struct") decls = info.members.get(owner)
            else if (owner.kind === "interface") decls = info.members.get(owner)
            const decl = decls === null ? null : decls.get(name)
            if (decl === null) continue
            const source = this.sourceOf(decl)
            if (source !== null) return this.docOf(source, decl)
        }
        return ""
    }

    definition(position: Position): Location | null {
        const identifier = this.identifierAt(position)
        if (identifier === null) return null
        const decl = this.declarationOf(identifier)
        if (decl === null) return null
        const name = this.nameOf(decl)
        const source = this.sourceOf(name)
        if (source === null) return null
        const path = this.pathOf(source)
        const onDisk = isAbsolute(path)
        return {
            path,
            text: onDisk ? null : source.text,
            range: rangeOf(source.text, name.start, name.end),
        }
    }
}

function isNameByte(b: u8): bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b === 95 || b === 36 || b >= 128
}

/** The outermost expression that ends at a byte offset and has a type or a declaration. */
function expressionEndingAt(node: Node, end: int, info: CheckInfo): Node | null {
    if (node.start > end || node.end < end) return null
    if (node.end === end && (info.types.has(node) || info.definitions.has(node))) return node
    for (const child of node.children) {
        const found = expressionEndingAt(child, end, info)
        if (found !== null) return found
    }
    return null
}

/** The members of a namespace declaration, a module, or the static members of a class. */
function membersOfDeclaration(decl: Node, source: Source, out: Completion[]) {
    if (decl.kind === "ClassDeclaration") {
        for (const m of decl.list("members")) {
            const name = m.child("name")
            if (name === null || !source.text.slice(m.start, name.start).includes("static")) continue
            if (source.text.slice(m.start, name.start).includes("private")) continue
            out.push({
                label: name.text,
                kind: m.kind === "MethodDeclaration" ? "method" : "field",
                detail: "",
                documentation: "",
            })
        }
        return
    }
    const body = decl.child("body")
    const statements = body !== null ? body.list("statements") : decl.list("statements")
    for (const st of statements) {
        if (st.kind === "FunctionDeclaration") {
            const name = st.child("name")
            if (name !== null) out.push({ label: name.text, kind: "method", detail: "", documentation: "" })
        } else if (st.kind === "VariableStatement") {
            const list = st.child("declarationList")
            if (list === null) continue
            for (const d of list.list("declarations")) {
                const name = d.child("name")
                if (name !== null && name.kind === "Identifier")
                    out.push({ label: name.text, kind: "field", detail: "", documentation: "" })
            }
        } else if (
            st.kind === "ClassDeclaration" ||
            st.kind === "InterfaceDeclaration" ||
            st.kind === "TypeAliasDeclaration" ||
            st.kind === "ModuleDeclaration"
        ) {
            // A nested namespace too, as `process.command`.
            const name = st.child("name")
            if (name !== null) out.push({ label: name.text, kind: "field", detail: "", documentation: "" })
        }
    }
}

/** The members of a value of a type: fields and methods, or the built-in members of arrays, strings and collections. */
function membersOfType(type: Type, out: Completion[]) {
    switch (type.kind) {
        case "struct":
            for (const f of type.fields)
                if (!f.private)
                    out.push({ label: f.name, kind: "field", detail: typeToString(f.type), documentation: "" })
            for (const m of type.methods)
                if (!m.private)
                    out.push({ label: m.name, kind: "method", detail: typeToString(m.func.type), documentation: "" })
            if (type.tuple) out.push({ label: "length", kind: "field", detail: "int", documentation: "" })
            return
        case "interface":
            for (const m of type.members)
                out.push({
                    label: m.name,
                    kind: m.k === "method" ? "method" : "field",
                    detail: typeToString(m.type),
                    documentation: "",
                })
            return
        case "array":
            out.push({ label: "length", kind: "field", detail: "int", documentation: "" })
            for (const name of ["push", "pop", "slice"])
                out.push({ label: name, kind: "method", detail: "", documentation: "" })
            for (const [name, _] of arrayMethods)
                out.push({ label: name, kind: "method", detail: "", documentation: "" })
            return
        case "string":
        case "literal":
            out.push({ label: "length", kind: "field", detail: "int", documentation: "" })
            for (const [name, sig] of stringMethods) {
                const result = typeToString(sig.result)
                out.push({
                    label: name,
                    kind: "method",
                    detail: sig.nullable ? `${result} | null` : result,
                    documentation: "",
                })
            }
            out.push({ label: "concat", kind: "method", detail: "string", documentation: "" })
            return
        case "map":
            out.push({ label: "size", kind: "field", detail: "int", documentation: "" })
            for (const name of ["get", "set", "has", "delete", "clear", "keys", "values", "entries", "forEach"])
                out.push({ label: name, kind: "method", detail: "", documentation: "" })
            return
        case "set": {
            const setMethodNames = [
                "add",
                "has",
                "delete",
                "clear",
                "keys",
                "values",
                "entries",
                "forEach",
                "union",
                "intersection",
                "difference",
                "symmetricDifference",
                "isSubsetOf",
                "isSupersetOf",
                "isDisjointFrom",
            ]
            out.push({ label: "size", kind: "field", detail: "int", documentation: "" })
            for (const name of setMethodNames) out.push({ label: name, kind: "method", detail: "", documentation: "" })
            return
        }
        case "chan":
            for (const name of ["send", "receive", "close", "onReceive", "onSend"])
                out.push({ label: name, kind: "method", detail: "", documentation: "" })
            return
        case "union": {
            // The members that every member of the union has, by name.
            const each: Completion[][] = []
            for (const m of type.members) {
                if (m.kind === "null") continue
                const members: Completion[] = []
                membersOfType(m, members)
                each.push(members)
            }
            if (each.length === 0) return
            for (const c of each[0]) if (each.every((ms) => ms.some((x) => x.label === c.label))) out.push(c)
            return
        }
        default:
            return
    }
}

/**
 * The name of the module of the runtime (`runtime/core/NAME.ore`, which is
 * `ore:runtime/NAME`) or of the standard library (`runtime/std/NAME.ore`,
 * `ore:NAME`) that a file is, or "".
 */
function moduleName(path: string): string {
    const name = basename(path, ".ore")
    const dir = dirname(path)
    let module = ""
    if (dir.endsWith("/runtime/core")) module = `ore:runtime/${name}`
    else if (dir.endsWith("/runtime/std")) module = `ore:${name}`
    return module !== "" && stdModules.has(module) ? module : ""
}

/** The index in `tokenTypes` of what a declaration declares, or -1. */
function tokenType(decl: Node, source: Source, parents: Parents): int {
    let k = decl.kind
    let node = decl
    // A name declared by itself: a variable, a parameter or a binding element, by its parent.
    if (k === "Identifier") {
        const parent = parents.of.get(decl)
        if (parent === null) return 6
        node = parent
        k = parent.kind
    }
    switch (k) {
        case "ModuleDeclaration":
            return 0
        case "TypeAliasDeclaration":
            return 1
        case "ClassDeclaration":
            return 2
        case "InterfaceDeclaration":
            return 3
        case "TypeParameter":
            return 4
        case "Parameter":
            // A parameter property is a field too, but where it is declared it is a parameter.
            return 5
        case "VariableDeclaration":
        case "BindingElement":
            return 6
        case "PropertyDeclaration":
        case "PropertySignature":
        case "PropertyAssignment":
        case "ShorthandPropertyAssignment":
        case "GetAccessor":
        case "SetAccessor":
            return 7
        case "FunctionDeclaration":
            return 8
        case "MethodDeclaration":
        case "MethodSignature":
            return 9
        default:
            return node === decl ? -1 : 6
    }
}

/** Whether a declaration is read-only: a `const`, or a `readonly` field. */
function isReadonly(decl: Node, source: Source, parents: Parents): bool {
    let node: Node | null = decl
    while (node !== null) {
        const k = node.kind
        if (k === "VariableDeclarationList") return source.text.slice(node.start, node.end).startsWith("const")
        if (k === "PropertyDeclaration" || k === "PropertySignature" || k === "Parameter") {
            const name = node.child("name")
            return name !== null && source.text.slice(node.start, name.start).includes("readonly")
        }
        if (k === "VariableStatement" || k === "Block" || k === "SourceFile") return false
        node = parents.of.get(node)
    }
    return false
}

/** The innermost identifier at a byte offset, or ending there. */
function identifierIn(node: Node, offset: int): Node | null {
    if (offset < node.start || offset > node.end) return null
    for (const child of node.children) {
        const found = identifierIn(child, offset)
        if (found !== null) return found
    }
    return node.kind === "Identifier" ? node : null
}

function collectIdentifiers(node: Node, out: Node[]) {
    if (node.kind === "Identifier") out.push(node)
    for (const child of node.children) collectIdentifiers(child, out)
}

/** Text on one line: runs of white space as one space. */
export function collapse(text: string): string {
    let out = ""
    let space = false
    for (let i = 0; i < text.length; i++) {
        const c = text[i]
        if (c === 32 || c === 9 || c === 10 || c === 13) {
            space = true
            continue
        }
        if (space && out.length > 0) out += " "
        space = false
        out += text.slice(i, i + 1)
    }
    return out
}

/** The `/** ... *\/` comment that ends right before `pos`, past white space, or "". */
export function jsdocBefore(text: string, pos: int): string {
    let i = pos
    while (i > 0) {
        const c = text[i - 1]
        if (c === 32 || c === 9 || c === 10 || c === 13) i--
        else break
    }
    if (i < 2 || text[i - 1] !== 47 || text[i - 2] !== 42) return ""
    const start = text.slice(0, i - 2).lastIndexOf("/**")
    if (start < 0) return ""
    // Not the end of a comment that starts earlier.
    const inner = text.slice(start + 3, i - 2)
    if (inner.includes("*/")) return ""
    return inner
}

/** The `@param` description of a parameter in a JSDoc comment, or "". */
function paramDoc(inner: string, name: string): string {
    let found = ""
    let collecting = false
    for (const line of jsdocLines(inner)) {
        if (line.startsWith("@")) {
            collecting = false
            const words = line.split(" ")
            if (words.length >= 2 && words[0] === "@param" && (words[1] === name || words[1] === `{${name}}`)) {
                collecting = true
                let rest = line.slice(words[0].length + 1 + words[1].length).trim()
                if (rest.startsWith("- ")) rest = rest.slice(2)
                found = rest
            }
        } else if (collecting && line !== "") found = `${found} ${line}`
    }
    return found.trim()
}

/** A line of a JSDoc comment split before each ` @tag` that follows other text. */
function splitTags(line: string): string[] {
    const parts: string[] = []
    let start = 0
    for (let i = 1; i + 1 < line.length; i++) {
        const letter = (line[i + 1] >= 97 && line[i + 1] <= 122) || (line[i + 1] >= 65 && line[i + 1] <= 90)
        if (line[i] === 64 && line[i - 1] === 32 && letter && line.slice(start, i).trim() !== "") {
            parts.push(line.slice(start, i).trimEnd())
            start = i
        }
    }
    parts.push(line.slice(start))
    return parts
}

/** The text of a JSDoc comment as Markdown: the description, then its tags. */
/** The lines of a JSDoc comment without their `*`; a tag after text on the same line starts a line of its own. */
export function jsdocLines(inner: string): string[] {
    const lines: string[] = []
    for (const raw of inner.split("\n")) {
        let line = raw.trim()
        if (line.startsWith("*")) line = line.slice(1)
        if (line.startsWith(" ")) line = line.slice(1)
        for (const part of splitTags(line.trimEnd())) lines.push(part)
    }
    return lines
}

function renderJsdoc(inner: string): string {
    const lines = jsdocLines(inner)
    const description: string[] = []
    const tags: string[] = []
    let inTags = false
    for (const line of lines) {
        if (line.startsWith("@")) inTags = true
        if (!inTags) {
            description.push(line)
            continue
        }
        if (!line.startsWith("@")) {
            if (tags.length > 0 && line !== "") tags[tags.length - 1] = `${tags[tags.length - 1]} ${line}`
            continue
        }
        const space = line.indexOf(" ")
        const tag = space < 0 ? line.slice(1) : line.slice(1, space)
        let rest = space < 0 ? "" : line.slice(space + 1).trim()
        if (tag === "param" || tag === "throws" || tag === "template") {
            const nameEnd = rest.indexOf(" ")
            const name = nameEnd < 0 ? rest : rest.slice(0, nameEnd)
            rest = nameEnd < 0 ? "" : rest.slice(nameEnd + 1).trim()
            if (rest.startsWith("- ")) rest = rest.slice(2)
            tags.push(`*@${tag}* \`${name}\`${rest === "" ? "" : ` — ${rest}`}`)
        } else {
            tags.push(`*@${tag}*${rest === "" ? "" : ` — ${rest}`}`)
        }
    }
    let text = description.join("\n").trim()
    if (tags.length > 0) text = text === "" ? tags.join("\n\n") : `${text}\n\n${tags.join("\n\n")}`
    return text
}

/** Analyzes a document: loads its program with `text` for `path`, and checks it. */
export function analyze(path: string, text: string): Analysis {
    return new CheckedAnalysis(path, text)
}
