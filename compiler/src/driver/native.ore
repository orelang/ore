// The native code of a program: what the packages of its modules ask for in
// `"ore"` of their package.json.

import { dirname, join, resolve } from "ore:path"
import { findPackageRoot, readPackageJson } from "../project/resolve"

export class NativeCode {
    /** Libraries to link, as for `-l`. */
    link: string[] = []
    /** C source files to compile into the program. */
    sources: string[] = []
    /** Directories to search for the libraries, as for `-L`. */
    libDirs: string[] = []
}

/**
 * The native code of the packages of the modules at these paths, and the
 * libraries of the standard modules that need one ("ore:tls").
 */
export function nativeCode(paths: string[]): NativeCode | Error {
    const native = new NativeCode()
    const roots = new Set<string>()
    for (const path of paths) {
        if (path === "ore:tls") {
            const error = addOpenssl(native)
            if (error !== null) return error
        }
        if (path.startsWith("ore:")) continue
        const root = findPackageRoot(dirname(resolve(path)))
        if (root === null || roots.has(root)) continue
        roots.add(root)
        const json = readPackageJson(root)
        if (json instanceof Error) return json
        if (json === null) continue
        const ore = json.ore
        if (ore === null) continue
        const link = ore.link
        if (link !== null) for (const lib of link) if (!native.link.includes(lib)) native.link.push(lib)
        const sources = ore.sources
        if (sources !== null) for (const source of sources) native.sources.push(join(root, source))
        const libDirs = ore.libDirs
        if (libDirs !== null) {
            for (const entry of libDirs) {
                const dir = libDir(root, entry)
                if (dir !== null && !native.libDirs.includes(dir)) native.libDirs.push(dir)
            }
        }
    }
    return native
}

/**
 * OpenSSL 3, for "ore:tls". On Linux, the system's libssl.so.3 and
 * libcrypto.so.3 by their file names, so that the run-time package (libssl3)
 * is enough, without the development one. On macOS, Homebrew's openssl@3: the
 * system has no OpenSSL to link against.
 */
function addOpenssl(native: NativeCode): Error | null {
    if (target.os !== "darwin") {
        native.link.push(":libssl.so.3")
        native.link.push(":libcrypto.so.3")
        return null
    }
    let found = false
    for (const dir of ["/opt/homebrew/opt/openssl@3/lib", "/usr/local/opt/openssl@3/lib"]) {
        if (!fs.isFile(join(dir, "libssl.3.dylib"))) continue
        found = true
        if (!native.libDirs.includes(dir)) native.libDirs.push(dir)
    }
    // $LIBRARY_PATH may name another.
    if (!found && process.getenv("LIBRARY_PATH") === null)
        return new Error("ore:tls needs OpenSSL 3: brew install openssl@3")
    native.link.push("ssl")
    native.link.push("crypto")
    return null
}

/**
 * A directory of `"ore": { "libDirs": [...] }`: a path relative to the
 * package, or `$(command args...)`, the output of a command run without a
 * shell, such as `$(llvm-config --libdir)`. Null when the directory does not
 * exist or the command fails.
 */
export function libDir(root: string, entry: string): string | null {
    let dir = entry
    if (entry.startsWith("$(") && entry.endsWith(")")) {
        const words = entry
            .slice(2, -1)
            .trim()
            .split(" ")
            .filter((w) => w !== "")
        if (words.length === 0) return null
        const out = process.output(words[0], words.slice(1))
        if (out instanceof Error || !out.ok) return null
        dir = out.stdout.trim()
        if (dir === "") return null
    }
    const path = resolve(root, dir)
    return fs.isDir(path) ? path : null
}
