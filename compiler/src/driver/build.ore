// Building programs: a program loaded, checked and translated to LLVM IR
// (llvm/emit.ore), the IR compiled to object files through LLVM's C API
// (llvm/object.ore), or taken from the build cache (cache.ore), C sources of
// packages compiled by the C compiler, and the objects linked with lld
// (link.ore).

import { basename, join } from "ore:path"
import { check } from "../checker/checker"
import { emitModule, EmitOptions } from "../llvm/emit"
import { emitObject, initializeLLVM, objectTarget, ObjectOptions, ObjectTimes } from "../llvm/object"
import { splitModule } from "../llvm/split"
import { loadProgram, programFiles } from "../project/load"
import { type Diagnostic } from "../syntax/diagnostic"
import { cacheRoot, ObjectCache, openCache } from "./cache"
import { compileC, link, targetTriple } from "./link"
import { NativeCode, nativeCode } from "./native"

export class CompileResult {
    constructor(
        /** The LLVM IR, present only when there are no errors. */
        readonly ir: string | null,
        readonly diagnostics: Diagnostic[],
        /** The native code of the program's packages, with the IR. */
        readonly native: NativeCode | null = null,
        /** The files the program is made of (`programFiles`), and the C sources of its packages. */
        readonly files: string[] = [],
    ) {}
}

export class BuildOptions {
    constructor(
        /** The executable to write. */
        readonly output: string,
        /** Optimize (`default<O2>`, inlining) instead of building fast with stack traces (`default<O0>`). */
        readonly release: bool = false,
        /** Also write the generated LLVM IR to this path; "" for none. */
        readonly emitLlvm: string = "",
        /** Print how long each step takes to stderr. */
        readonly times: bool = false,
        /**
         * The directory of the build cache (driver/cache.ore): null for
         * `cacheRoot()`, from the environment; "" for none.
         */
        readonly cache: string | null = null,
    ) {}
}

export class BuildResult {
    /** The object files compiled from the program's LLVM IR (one per part in a debug build). */
    objects = 0
    /** How many of them came from the build cache. */
    cached = 0
    /** The files the program is made of, as `CompileResult.files`: what `ore run --watch` watches. */
    files: string[] = []

    constructor(
        readonly ok: bool,
        readonly diagnostics: Diagnostic[],
    ) {}
}

/**
 * Loads, checks and translates a program, given by its entry file, to LLVM
 * IR: with frames for stack traces when `debug`, else with calls inlined. An
 * Error when a file cannot be read; errors in the program are diagnostics.
 */
export function compileToIr(entry: string, debug: bool, options: BuildOptions | null = null): CompileResult | Error {
    const timed = options ?? new BuildOptions("")
    let started = Date.now()
    const program = loadProgram(entry)
    if (program instanceof Error) return program
    report(timed, "load", Date.now() - started)
    const files = programFiles(program)
    if (program.syntaxErrors) return new CompileResult(null, program.diagnostics, null, files)
    started = Date.now()
    const checked = check(program)
    report(timed, "check", Date.now() - started)
    const diagnostics = program.diagnostics.slice()
    for (const d of checked.diagnostics) diagnostics.push(d)
    const module = checked.module
    if (module === null || program.diagnostics.length > 0) return new CompileResult(null, diagnostics, null, files)
    const paths: string[] = []
    for (const source of program.modules) paths.push(source.path)
    const native = nativeCode(paths)
    if (native instanceof Error) return native
    for (const source of native.sources) if (!files.includes(source)) files.push(source)
    started = Date.now()
    // ORE_COVERAGE=1 counts the runs of every statement; a release build counts them too, without inlining.
    const ir = emitModule(module, new EmitOptions(debug, process.getenv("ORE_COVERAGE") === "1"))
    report(timed, "emit", Date.now() - started)
    return new CompileResult(ir, diagnostics, native, files)
}

/**
 * Builds a program into an executable: debug (`default<O0>`, stack traces)
 * or release (`default<O2>`, inlining). `ok` is false when the program has
 * errors, given as diagnostics; an Error when a file cannot be read or
 * written, or a tool fails.
 */
export function build(entry: string, options: BuildOptions): BuildResult | Error {
    const compiled = compileToIr(entry, !options.release, options)
    if (compiled instanceof Error) return compiled
    const ir = compiled.ir
    const native = compiled.native
    if (ir === null || native === null) {
        const failed = new BuildResult(false, compiled.diagnostics)
        failed.files = compiled.files
        return failed
    }
    if (options.emitLlvm !== "") {
        const written = fs.writeFile(options.emitLlvm, ir)
        if (written !== null) return written
    }
    const name = options.emitLlvm !== "" ? options.emitLlvm : `${basename(entry, ".ore")}.ll`
    const result = new BuildResult(true, compiled.diagnostics)
    result.files = compiled.files
    const error = buildCounted(ir, name, native, options, result)
    if (error !== null) return error
    return result
}

/** Prints a step's time to stderr with `--time`. */
export function report(options: BuildOptions, step: string, ms: int): void {
    if (options.times) console.error(`${step.padEnd(10)} ${ms} ms`)
}

/**
 * Builds an executable from LLVM IR and the native code of its packages: the
 * IR into object files (or from the build cache), the C sources into others,
 * all linked. `name` names the IR in LLVM's messages. Intermediate files go
 * to a temporary directory, removed at the end.
 */
export function buildIr(ir: string, name: string, native: NativeCode, options: BuildOptions): Error | null {
    return buildCounted(ir, name, native, options, new BuildResult(true, []))
}

/** `buildIr`, counting the objects and those from the cache in `result`. */
function buildCounted(
    ir: string,
    name: string,
    native: NativeCode,
    options: BuildOptions,
    result: BuildResult,
): Error | null {
    const dir = fs.mkdtemp("ore-build-")
    if (dir instanceof Error) return dir
    const error = buildIn(dir, ir, name, native, options, result)
    fs.remove(dir, true)
    return error
}

/** An object file of a part of the IR: compiled, with LLVM's times, or from the cache. */
class PartObject {
    constructor(
        readonly path: string,
        /** Null when it came from the cache. */
        readonly times: ObjectTimes | null,
    ) {}
}

function buildIn(
    dir: string,
    ir: string,
    name: string,
    native: NativeCode,
    options: BuildOptions,
    counts: BuildResult,
): Error | null {
    let started = Date.now()
    // A debug build splits the module by source file, so that LLVM compiles
    // the parts on every CPU and the cache keeps them apart; a release build
    // keeps one, for inlining across functions.
    const parts = options.release ? [ir] : splitModule(ir)
    if (parts.length > 1) report(options, "split", Date.now() - started)
    started = Date.now()
    initializeLLVM()
    const objectOptions = new ObjectOptions("", options.release, targetTriple(), name)
    const cache = openCache(options.cache ?? cacheRoot(), objectTarget(objectOptions), dir)
    const results: (PartObject | Error | null)[] = []
    for (let i = 0; i < parts.length; i++) results.push(null)
    const done = new Chan<int>(parts.length)
    for (let i = 0; i < parts.length; i++) {
        const index = i
        task.spawn(() => {
            const output = join(dir, parts.length === 1 ? "main.o" : `main-${index}.o`)
            results[index] = partObject(parts[index], output, cache, options, name)
            done.send(index)
        })
    }
    for (let i = 0; i < parts.length; i++) done.receive()
    const objects: string[] = []
    let parse = 0
    let optimize = 0
    let codegen = 0
    let cached = 0
    for (const result of results) {
        if (result instanceof Error) return result
        if (result === null) continue
        objects.push(result.path)
        const times = result.times
        if (times === null) cached++
        else {
            parse = parse > times.parse ? parse : times.parse
            optimize = optimize > times.optimize ? optimize : times.optimize
            codegen = codegen > times.codegen ? codegen : times.codegen
        }
    }
    counts.objects = parts.length
    counts.cached = cached
    // The slowest part's times; with several parts, also the whole.
    if (cached < parts.length) {
        report(options, "llvm parse", parse)
        report(options, options.release ? "llvm O2" : "llvm O0", optimize)
        report(options, "codegen", codegen)
    }
    if (parts.length > 1) report(options, `llvm x${parts.length}`, Date.now() - started)
    if (options.times && cache !== null) console.error(`${"cached".padEnd(10)} ${cached} of ${parts.length}`)
    started = Date.now()
    for (let i = 0; i < native.sources.length; i++) {
        const source = native.sources[i]
        const out = join(dir, `${i}-${basename(source, ".c")}.o`)
        const error = compileC(source, out, options.release)
        if (error !== null) return error
        objects.push(out)
    }
    if (native.sources.length > 0) report(options, "cc", Date.now() - started)
    started = Date.now()
    const error = link(objects, native, options.output)
    if (error !== null) return error
    report(options, "link", Date.now() - started)
    return null
}

/**
 * The object file of a part of the IR: from the cache if it has it, else
 * compiled by LLVM into the cache (written under a temporary name, then
 * renamed); into `output` without a cache, or when the cache cannot be
 * written.
 */
function partObject(
    ir: string,
    output: string,
    cache: ObjectCache | null,
    options: BuildOptions,
    name: string,
): PartObject | Error {
    if (cache !== null) {
        const key = cache.key(ir)
        const path = cache.path(key)
        if (fs.isFile(path)) return new PartObject(path, null)
        const temporary = cache.temporary(key)
        const cached = emitObject(ir, new ObjectOptions(temporary, options.release, targetTriple(), name))
        if (cached instanceof Error) fs.remove(temporary)
        else if (fs.rename(temporary, path) === null) return new PartObject(path, cached)
        else fs.remove(temporary)
    }
    const times = emitObject(ir, new ObjectOptions(output, options.release, targetTriple(), name))
    if (times instanceof Error) return times
    return new PartObject(output, times)
}
