// The parser: builds the syntax tree of a source file from its tokens, with
// the node kinds, spans and children of the TypeScript parser for the syntax
// that Ore uses.

import { Node, type NodeKind } from "./ast"
import { regexClose, tokenize, type Token } from "./lexer"
import { type Kind } from "./tokens"

/** Parses a source text; syntax errors are in `errors`. */
export function parse(text: string): Parser {
    const parser = new Parser(text)
    parser.parseSourceFile()
    return parser
}

/** Keywords that cannot be identifiers. */
const reserved = [
    "BreakKeyword",
    "CaseKeyword",
    "CatchKeyword",
    "ClassKeyword",
    "ConstKeyword",
    "ContinueKeyword",
    "DebuggerKeyword",
    "DefaultKeyword",
    "DeleteKeyword",
    "DoKeyword",
    "ElseKeyword",
    "EnumKeyword",
    "ExportKeyword",
    "ExtendsKeyword",
    "FalseKeyword",
    "FinallyKeyword",
    "ForKeyword",
    "FunctionKeyword",
    "IfKeyword",
    "ImportKeyword",
    "InKeyword",
    "InstanceOfKeyword",
    "NewKeyword",
    "NullKeyword",
    "ReturnKeyword",
    "SuperKeyword",
    "SwitchKeyword",
    "ThisKeyword",
    "ThrowKeyword",
    "TrueKeyword",
    "TryKeyword",
    "TypeOfKeyword",
    "VarKeyword",
    "VoidKeyword",
    "WhileKeyword",
    "WithKeyword",
]

/** Keywords that name built-in types. */
const keywordTypes = [
    "AnyKeyword",
    "UnknownKeyword",
    "StringKeyword",
    "NumberKeyword",
    "BigIntKeyword",
    "BooleanKeyword",
    "SymbolKeyword",
    "ObjectKeyword",
    "NeverKeyword",
    "UndefinedKeyword",
    "VoidKeyword",
]

/** Keywords that modify declarations and class members. */
const modifierKinds = [
    "ExportKeyword",
    "DefaultKeyword",
    "DeclareKeyword",
    "AbstractKeyword",
    "AsyncKeyword",
    "ConstKeyword",
    "PublicKeyword",
    "PrivateKeyword",
    "ProtectedKeyword",
    "ReadonlyKeyword",
    "StaticKeyword",
    "OverrideKeyword",
    "AccessorKeyword",
]

const assignmentOperators = [
    "EqualsToken",
    "PlusEqualsToken",
    "MinusEqualsToken",
    "AsteriskEqualsToken",
    "AsteriskAsteriskEqualsToken",
    "SlashEqualsToken",
    "PercentEqualsToken",
    "LessThanLessThanEqualsToken",
    "GreaterThanGreaterThanEqualsToken",
    "GreaterThanGreaterThanGreaterThanEqualsToken",
    "AmpersandEqualsToken",
    "BarEqualsToken",
    "CaretEqualsToken",
    "AmpersandAmpersandEqualsToken",
    "BarBarEqualsToken",
    "QuestionQuestionEqualsToken",
]

/** The precedence of a binary operator (higher binds tighter), or 0. */
function precedence(kind: NodeKind): int {
    switch (kind) {
        case "QuestionQuestionToken":
            return 4
        case "BarBarToken":
            return 5
        case "AmpersandAmpersandToken":
            return 6
        case "BarToken":
            return 7
        case "CaretToken":
            return 8
        case "AmpersandToken":
            return 9
        case "EqualsEqualsToken":
        case "ExclamationEqualsToken":
        case "EqualsEqualsEqualsToken":
        case "ExclamationEqualsEqualsToken":
            return 10
        case "LessThanToken":
        case "GreaterThanToken":
        case "LessThanEqualsToken":
        case "GreaterThanEqualsToken":
        case "InstanceOfKeyword":
        case "InKeyword":
        case "AsKeyword":
        case "SatisfiesKeyword":
            return 11
        case "LessThanLessThanToken":
        case "GreaterThanGreaterThanToken":
        case "GreaterThanGreaterThanGreaterThanToken":
            return 12
        case "PlusToken":
        case "MinusToken":
            return 13
        case "AsteriskToken":
        case "SlashToken":
        case "PercentToken":
            return 14
        case "AsteriskAsteriskToken":
            return 15
    }
    return 0
}

/** An operator made of one or more tokens, such as `>>=` from `>`, `>` and `=`. */
type Operator = { kind: NodeKind; tokens: int }

/** A syntax error: its message and the span of the token where it was found. */
export type SyntaxError = { message: string; start: int; end: int }

export class Parser {
    private tokens: Token[]
    private i = 0
    /** The end of the last token consumed. */
    private last = 0
    /** Inside the initializer of a `for`, where `in` is not an operator. */
    private noIn = false
    /** Whether a type stops before `extends`: in the `extends` clause of a conditional type. */
    private noConditional = false
    errors: string[] = []
    /** The same errors, with the span of their token instead of its offset in the message. */
    diagnostics: SyntaxError[] = []
    file: Node | null = null

    constructor(readonly text: string) {
        this.tokens = tokenize(text)
    }

    // -------------------------------------------------------------------------
    // Tokens

    private token(): Token {
        return this.tokens[this.i]
    }

    private kind(): Kind {
        return this.tokens[this.i].kind
    }

    private peek(n: int): Token {
        const i = this.i + n
        return i < this.tokens.length ? this.tokens[i] : this.tokens[this.tokens.length - 1]
    }

    private next(): Token {
        const token = this.tokens[this.i]
        // The lexer ends a string without its closing quote at the line end.
        if (token.kind === "StringLiteral" && !closedString(this.text, token.start, token.end))
            this.error("Unterminated string literal")
        if (token.kind !== "EndOfFileToken") this.i++
        this.last = token.end
        return token
    }

    private at(kind: Kind): bool {
        return this.kind() === kind
    }

    private eat(kind: Kind): bool {
        if (!this.at(kind)) return false
        this.next()
        return true
    }

    private expect(kind: Kind): bool {
        if (this.eat(kind)) return true
        this.error(`'${kind}' expected`)
        return false
    }

    private error(message: string) {
        const t = this.token()
        this.errors.push(`${message}, got '${t.kind}' at ${t.start}`)
        this.diagnostics.push({ message: `${message}, got '${t.kind}'`, start: t.start, end: t.end })
    }

    /** The current token as a node. */
    private tokenNode(): Node {
        const t = this.next()
        const node = new Node(t.kind, t.start, t.end)
        node.text = this.text.slice(t.start, t.end)
        return node
    }

    /** A node from `start` to the end of the last token consumed. */
    private finish(node: Node, start: int): Node {
        node.start = start
        node.end = this.last
        return node
    }

    private make(kind: NodeKind, start: int): Node {
        return new Node(kind, start, this.last)
    }

    /** A node of children already parsed, with their roles, from `start` to the end of the last token consumed. */
    private node(kind: NodeKind, start: int, children: (Node | null)[], roles: string[]): Node {
        const node = new Node(kind, start, 0)
        for (let i = 0; i < children.length; i++) node.add(children[i], roles[i])
        node.end = this.last
        return node
    }

    /** Runs a parse that may not apply; undoes it when it fails or reports errors. */
    private speculate(parse: () => Node | null): Node | null {
        const i = this.i
        const last = this.last
        const errors = this.errors.length
        const noIn = this.noIn
        const node = parse()
        if (node !== null && this.errors.length === errors) return node
        this.i = i
        this.last = last
        this.noIn = noIn
        this.errors = this.errors.slice(0, errors)
        this.diagnostics = this.diagnostics.slice(0, errors)
        return null
    }

    /** Ends a statement: at `;`, before `}` or the end, or at a line break. */
    private semicolon() {
        if (this.eat("SemicolonToken")) return
        const k = this.kind()
        if (k === "CloseBraceToken" || k === "EndOfFileToken" || this.token().newline) return
        this.error("';' expected")
    }

    private canEndStatement(): bool {
        const k = this.kind()
        return k === "SemicolonToken" || k === "CloseBraceToken" || k === "EndOfFileToken" || this.token().newline
    }

    // -------------------------------------------------------------------------
    // Names

    private isIdentifier(kind: Kind): bool {
        return kind === "Identifier" || (kind.endsWith("Keyword") && !reserved.includes(kind))
    }

    private identifier(): Node {
        if (this.isIdentifier(this.kind())) return this.nameNode()
        this.error("Identifier expected")
        return new Node("Identifier", this.token().start, this.token().start)
    }

    /** An identifier where any keyword is allowed, such as after `.`. */
    private identifierName(): Node {
        const k = this.kind()
        if (k === "Identifier" || k.endsWith("Keyword")) return this.nameNode()
        if (k === "PrivateIdentifier") return this.tokenNode()
        this.error("Identifier expected")
        return new Node("Identifier", this.token().start, this.token().start)
    }

    private nameNode(): Node {
        const t = this.next()
        const node = new Node("Identifier", t.start, t.end)
        node.text = this.text.slice(t.start, t.end)
        return node
    }

    /** The name of a property: an identifier or keyword, a string, a number, `#name` or `[expression]`. */
    private propertyName(): Node {
        const k = this.kind()
        if (k === "StringLiteral" || k === "NumericLiteral" || k === "PrivateIdentifier") return this.tokenNode()
        if (k === "OpenBracketToken") {
            const start = this.next().start
            const expression = this.assignment()
            this.expect("CloseBracketToken")
            return this.make("ComputedPropertyName", start).add(expression, "expression")
        }
        return this.identifierName()
    }

    private isPropertyNameStart(kind: Kind): bool {
        return (
            kind === "Identifier" ||
            kind.endsWith("Keyword") ||
            kind === "StringLiteral" ||
            kind === "NumericLiteral" ||
            kind === "PrivateIdentifier" ||
            kind === "OpenBracketToken"
        )
    }

    /** An identifier or a destructuring pattern. */
    private bindingName(): Node {
        if (this.at("OpenBraceToken")) return this.objectBindingPattern()
        if (this.at("OpenBracketToken")) return this.arrayBindingPattern()
        return this.identifier()
    }

    private objectBindingPattern(): Node {
        const start = this.next().start
        const pattern = new Node("ObjectBindingPattern", start, start)
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const elementStart = this.token().start
            const element = new Node("BindingElement", elementStart, elementStart)
            if (this.at("DotDotDotToken")) {
                element.add(this.tokenNode(), "dotDotDotToken")
                element.add(this.bindingName(), "name")
            } else {
                const name = this.propertyName()
                if (this.eat("ColonToken")) element.add(name, "propertyName").add(this.bindingName(), "name")
                else element.add(name, "name")
            }
            if (this.eat("EqualsToken")) element.add(this.assignment(), "initializer")
            pattern.add(this.finish(element, elementStart), "elements")
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBraceToken")
        return this.finish(pattern, start)
    }

    private arrayBindingPattern(): Node {
        const start = this.next().start
        const pattern = new Node("ArrayBindingPattern", start, start)
        while (!this.at("CloseBracketToken") && !this.at("EndOfFileToken")) {
            if (this.at("CommaToken")) {
                // A hole: an empty node at the end of the previous token, as in TypeScript.
                pattern.add(new Node("OmittedExpression", this.last, this.last), "elements")
                this.next()
                continue
            }
            const elementStart = this.token().start
            const element = new Node("BindingElement", elementStart, elementStart)
            if (this.at("DotDotDotToken")) element.add(this.tokenNode(), "dotDotDotToken")
            element.add(this.bindingName(), "name")
            if (this.eat("EqualsToken")) element.add(this.assignment(), "initializer")
            pattern.add(this.finish(element, elementStart), "elements")
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBracketToken")
        return this.finish(pattern, start)
    }

    // -------------------------------------------------------------------------
    // Statements

    parseSourceFile(): Node {
        const start = this.token().start
        const file = new Node("SourceFile", start, this.text.length)
        while (!this.at("EndOfFileToken")) {
            const before = this.i
            file.add(this.statement(), "statements")
            if (this.i === before) this.next()
        }
        file.add(this.tokenNode(), "endOfFileToken")
        file.end = this.text.length
        this.file = file
        return file
    }

    private statement(): Node {
        const start = this.token().start
        const next = this.peek(1)
        switch (this.kind()) {
            case "OpenBraceToken":
                return this.block()
            case "SemicolonToken":
                this.next()
                return this.make("EmptyStatement", start)
            case "VarKeyword":
                return this.variableStatement([], start)
            case "ConstKeyword":
                if (next.kind === "EnumKeyword") return this.declaration(this.modifiers(), start)
                return this.variableStatement([], start)
            case "LetKeyword":
                if (this.isIdentifier(next.kind) || next.kind === "OpenBraceToken" || next.kind === "OpenBracketToken")
                    return this.variableStatement([], start)
                break
            case "UsingKeyword":
                if (this.isIdentifier(next.kind) && !next.newline) return this.variableStatement([], start)
                break
            case "IfKeyword":
                return this.ifStatement()
            case "ForKeyword":
                return this.forStatement()
            case "WhileKeyword": {
                this.next()
                this.expect("OpenParenToken")
                const condition = this.expression()
                this.expect("CloseParenToken")
                const body = this.statement()
                return this.make("WhileStatement", start).add(condition, "expression").add(body, "statement")
            }
            case "DoKeyword": {
                this.next()
                const body = this.statement()
                this.expect("WhileKeyword")
                this.expect("OpenParenToken")
                const condition = this.expression()
                this.expect("CloseParenToken")
                this.eat("SemicolonToken")
                return this.make("DoStatement", start).add(body, "statement").add(condition, "expression")
            }
            case "ReturnKeyword": {
                this.next()
                const value = this.canEndStatement() ? null : this.expression()
                this.semicolon()
                return this.make("ReturnStatement", start).add(value, "expression")
            }
            case "BreakKeyword":
            case "ContinueKeyword": {
                const kind: NodeKind = this.at("BreakKeyword") ? "BreakStatement" : "ContinueStatement"
                this.next()
                const label = this.isIdentifier(this.kind()) && !this.token().newline ? this.identifier() : null
                this.semicolon()
                return this.make(kind, start).add(label, "label")
            }
            case "ThrowKeyword": {
                this.next()
                const value = this.expression()
                this.semicolon()
                return this.make("ThrowStatement", start).add(value, "expression")
            }
            case "SwitchKeyword":
                return this.switchStatement()
            case "TryKeyword":
                return this.tryStatement()
            case "FunctionKeyword":
            case "ClassKeyword":
            case "EnumKeyword":
                return this.declaration([], start)
            case "InterfaceKeyword":
            case "TypeKeyword":
            case "NamespaceKeyword":
            case "ModuleKeyword":
                if (!next.newline && (this.isIdentifier(next.kind) || next.kind === "StringLiteral"))
                    return this.declaration([], start)
                break
            case "ImportKeyword":
                if (next.kind !== "OpenParenToken" && next.kind !== "DotToken") return this.importDeclaration()
                break
            case "ExportKeyword":
                return this.exportStatement()
            case "AsyncKeyword":
                if (next.kind === "FunctionKeyword" && !next.newline) return this.declaration(this.modifiers(), start)
                break
            case "DeclareKeyword":
            case "AbstractKeyword":
                if (!next.newline && (next.kind.endsWith("Keyword") || next.kind === "Identifier"))
                    return this.declaration(this.modifiers(), start)
                break
        }
        if (this.isIdentifier(this.kind()) && next.kind === "ColonToken") {
            const label = this.identifier()
            this.next()
            const body = this.statement()
            return this.make("LabeledStatement", start).add(label, "label").add(body, "statement")
        }
        const expression = this.expression()
        this.semicolon()
        return this.make("ExpressionStatement", start).add(expression, "expression")
    }

    private block(): Node {
        const start = this.token().start
        this.expect("OpenBraceToken")
        const block = new Node("Block", start, start)
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const before = this.i
            block.add(this.statement(), "statements")
            if (this.i === before) this.next()
        }
        this.expect("CloseBraceToken")
        return this.finish(block, start)
    }

    private ifStatement(): Node {
        const start = this.next().start
        this.expect("OpenParenToken")
        const condition = this.expression()
        this.expect("CloseParenToken")
        const node = new Node("IfStatement", start, start)
            .add(condition, "expression")
            .add(this.statement(), "thenStatement")
        if (this.eat("ElseKeyword")) node.add(this.statement(), "elseStatement")
        return this.finish(node, start)
    }

    private forStatement(): Node {
        const start = this.next().start
        this.expect("OpenParenToken")
        let initializer: Node | null = null
        if (!this.at("SemicolonToken")) {
            this.noIn = true
            const k = this.kind()
            const next = this.peek(1)
            const declares =
                k === "VarKeyword" ||
                k === "ConstKeyword" ||
                ((k === "LetKeyword" || k === "UsingKeyword") &&
                    (this.isIdentifier(next.kind) ||
                        next.kind === "OpenBraceToken" ||
                        next.kind === "OpenBracketToken"))
            initializer = declares ? this.variableDeclarationList() : this.expression()
            this.noIn = false
        }
        if (initializer !== null && (this.at("OfKeyword") || this.at("InKeyword"))) {
            const kind: NodeKind = this.at("OfKeyword") ? "ForOfStatement" : "ForInStatement"
            this.next()
            const iterable = kind === "ForOfStatement" ? this.assignment() : this.expression()
            this.expect("CloseParenToken")
            const body = this.statement()
            return this.make(kind, start)
                .add(initializer, "initializer")
                .add(iterable, "expression")
                .add(body, "statement")
        }
        this.expect("SemicolonToken")
        const condition = this.at("SemicolonToken") ? null : this.expression()
        this.expect("SemicolonToken")
        const update = this.at("CloseParenToken") ? null : this.expression()
        this.expect("CloseParenToken")
        const body = this.statement()
        return this.make("ForStatement", start)
            .add(initializer, "initializer")
            .add(condition, "condition")
            .add(update, "incrementor")
            .add(body, "statement")
    }

    private switchStatement(): Node {
        const start = this.next().start
        this.expect("OpenParenToken")
        const value = this.expression()
        this.expect("CloseParenToken")
        const blockStart = this.token().start
        this.expect("OpenBraceToken")
        const caseBlock = new Node("CaseBlock", blockStart, blockStart)
        while (this.at("CaseKeyword") || this.at("DefaultKeyword")) {
            const clauseStart = this.token().start
            const isCase = this.at("CaseKeyword")
            this.next()
            const clause = new Node(isCase ? "CaseClause" : "DefaultClause", clauseStart, clauseStart)
            if (isCase) clause.add(this.expression(), "expression")
            this.expect("ColonToken")
            while (
                !this.at("CaseKeyword") &&
                !this.at("DefaultKeyword") &&
                !this.at("CloseBraceToken") &&
                !this.at("EndOfFileToken")
            ) {
                const before = this.i
                clause.add(this.statement(), "statements")
                if (this.i === before) this.next()
            }
            caseBlock.add(this.finish(clause, clauseStart), "clauses")
        }
        this.expect("CloseBraceToken")
        return this.node(
            "SwitchStatement",
            start,
            [value, this.finish(caseBlock, blockStart)],
            ["expression", "caseBlock"],
        )
    }

    private tryStatement(): Node {
        const start = this.next().start
        const node = new Node("TryStatement", start, start).add(this.block(), "tryBlock")
        if (this.at("CatchKeyword")) {
            const catchStart = this.next().start
            const clause = new Node("CatchClause", catchStart, catchStart)
            if (this.eat("OpenParenToken")) {
                const declarationStart = this.token().start
                const declaration = new Node("VariableDeclaration", declarationStart, declarationStart).add(
                    this.bindingName(),
                    "name",
                )
                if (this.eat("ColonToken")) declaration.add(this.type(), "type")
                clause.add(this.finish(declaration, declarationStart), "variableDeclaration")
                this.expect("CloseParenToken")
            }
            node.add(this.finish(clause.add(this.block(), "block"), catchStart), "catchClause")
        }
        if (this.eat("FinallyKeyword")) node.add(this.block(), "finallyBlock")
        return this.finish(node, start)
    }

    private variableStatement(modifiers: Node[], start: int): Node {
        const list = this.variableDeclarationList()
        this.semicolon()
        return this.make("VariableStatement", start).addAll(modifiers, "modifiers").add(list, "declarationList")
    }

    /** `let`, `const`, `var` or `using` and declarations, without the `;`. */
    private variableDeclarationList(): Node {
        const start = this.next().start
        const list = new Node("VariableDeclarationList", start, start)
        for (;;) {
            const declarationStart = this.token().start
            const declaration = new Node("VariableDeclaration", declarationStart, declarationStart).add(
                this.bindingName(),
                "name",
            )
            if (this.at("ExclamationToken")) declaration.add(this.tokenNode(), "exclamationToken")
            if (this.eat("ColonToken")) declaration.add(this.type(), "type")
            if (this.eat("EqualsToken")) declaration.add(this.assignment(), "initializer")
            list.add(this.finish(declaration, declarationStart), "declarations")
            if (!this.eat("CommaToken")) break
        }
        return this.finish(list, start)
    }

    // -------------------------------------------------------------------------
    // Declarations

    /** Modifier keywords before a declaration or class member. */
    private modifiers(): Node[] {
        const found: Node[] = []
        while (modifierKinds.includes(this.kind())) {
            const next = this.peek(1)
            // A modifier is followed, on the same line, by what it modifies.
            const follows =
                next.kind === "Identifier" ||
                next.kind.endsWith("Keyword") ||
                next.kind === "OpenBracketToken" ||
                next.kind === "OpenBraceToken" ||
                next.kind === "AsteriskToken" ||
                next.kind === "PrivateIdentifier" ||
                next.kind === "StringLiteral" ||
                next.kind === "NumericLiteral"
            if (!follows || next.newline) break
            // `const` modifies only `enum`; otherwise it starts a declaration.
            if (this.at("ConstKeyword") && next.kind !== "EnumKeyword") break
            found.push(this.tokenNode())
        }
        return found
    }

    private declaration(modifiers: Node[], start: int): Node {
        switch (this.kind()) {
            case "FunctionKeyword":
                return this.functionDeclaration(modifiers, start)
            case "ClassKeyword":
                return this.classDeclaration(modifiers, start)
            case "InterfaceKeyword":
                return this.interfaceDeclaration(modifiers, start)
            case "TypeKeyword":
                return this.typeAliasDeclaration(modifiers, start)
            case "EnumKeyword":
                return this.enumDeclaration(modifiers, start)
            case "NamespaceKeyword":
            case "ModuleKeyword":
            case "GlobalKeyword":
                return this.moduleDeclaration(modifiers, start)
            case "VarKeyword":
            case "LetKeyword":
            case "ConstKeyword":
            case "UsingKeyword":
                return this.variableStatement(modifiers, start)
        }
        this.error("Declaration expected")
        const expression = this.expression()
        this.semicolon()
        return this.make("ExpressionStatement", start).add(expression, "expression")
    }

    private functionDeclaration(modifiers: Node[], start: int): Node {
        this.next()
        const node = new Node("FunctionDeclaration", start, start).addAll(modifiers, "modifiers")
        if (this.at("AsteriskToken")) node.add(this.tokenNode(), "asteriskToken")
        node.add(this.identifier(), "name")
        this.signature(node)
        if (this.at("OpenBraceToken")) node.add(this.block(), "body")
        else this.semicolon()
        return this.finish(node, start)
    }

    /** Type parameters, parameters and the return type of a function, added to `node`. */
    private signature(node: Node) {
        if (this.at("LessThanToken")) node.addAll(this.typeParameters(), "typeParameters")
        node.addAll(this.parameters(), "parameters")
        if (this.eat("ColonToken")) node.add(this.returnType(), "type")
    }

    /** A return type, or a type predicate: `x is T`, `this is T`, `asserts x is T` or `asserts x`. */
    private returnType(): Node {
        const start = this.token().start
        const asserts =
            this.at("AssertsKeyword") &&
            !this.peek(1).newline &&
            (this.isIdentifier(this.peek(1).kind) || this.peek(1).kind === "ThisKeyword")
        const at = asserts ? 1 : 0
        const name = this.peek(at)
        const is = this.peek(at + 1)
        const named = this.isIdentifier(name.kind) || name.kind === "ThisKeyword"
        if (!named || (!asserts && (is.kind !== "IsKeyword" || is.newline))) return this.type()
        const node = new Node("TypePredicate", start, start)
        if (asserts) node.add(this.tokenNode(), "assertsModifier")
        node.add(this.at("ThisKeyword") ? this.tokenNode() : this.nameNode(), "parameterName")
        if (this.at("IsKeyword") && !this.token().newline) {
            this.next()
            node.add(this.type(), "type")
        }
        return this.finish(node, start)
    }

    private typeParameters(): Node[] {
        this.expect("LessThanToken")
        const list: Node[] = []
        while (!this.at("GreaterThanToken") && !this.at("EndOfFileToken")) {
            const start = this.token().start
            const parameter = new Node("TypeParameter", start, start)
                .addAll(this.modifiers(), "modifiers")
                .add(this.identifier(), "name")
            if (this.eat("ExtendsKeyword")) parameter.add(this.type(), "constraint")
            if (this.eat("EqualsToken")) parameter.add(this.type(), "default")
            list.push(this.finish(parameter, start))
            if (!this.eat("CommaToken")) break
        }
        this.expect("GreaterThanToken")
        return list
    }

    private parameters(): Node[] {
        return this.parameterList("OpenParenToken", "CloseParenToken")
    }

    /** Parameters between `open` and `close`: parentheses, or the brackets of an index signature. */
    private parameterList(open: Kind, close: Kind): Node[] {
        this.expect(open)
        const list: Node[] = []
        while (!this.at(close) && !this.at("EndOfFileToken")) {
            const start = this.token().start
            const parameter = new Node("Parameter", start, start).addAll(this.modifiers(), "modifiers")
            if (this.at("DotDotDotToken")) parameter.add(this.tokenNode(), "dotDotDotToken")
            parameter.add(this.at("ThisKeyword") ? this.nameNode() : this.bindingName(), "name")
            if (this.at("QuestionToken")) parameter.add(this.tokenNode(), "questionToken")
            if (this.eat("ColonToken")) parameter.add(this.type(), "type")
            if (this.eat("EqualsToken")) parameter.add(this.assignment(), "initializer")
            list.push(this.finish(parameter, start))
            if (!this.eat("CommaToken")) break
        }
        this.expect(close)
        return list
    }

    /**
     * Whether `[` starts an index signature, `[key: string]: T`, rather than a
     * computed property name: TypeScript's `isUnambiguouslyIndexSignature`.
     */
    private atIndexSignature(): bool {
        if (!this.at("OpenBracketToken")) return false
        let n = 1
        let k = this.peek(n).kind
        if (k === "DotDotDotToken" || k === "CloseBracketToken") return true
        if (modifierKinds.includes(k)) {
            n++
            if (this.isIdentifier(this.peek(n).kind)) return true
        } else if (!this.isIdentifier(k)) return false
        n++
        k = this.peek(n).kind
        if (k === "ColonToken" || k === "CommaToken") return true
        if (k !== "QuestionToken") return false
        k = this.peek(n + 1).kind
        return k === "ColonToken" || k === "CommaToken" || k === "CloseBracketToken"
    }

    /** `[key: K]: T` after its modifiers, in an interface, an object type or a class. */
    private indexSignature(modifiers: Node[], start: int): Node {
        const node = new Node("IndexSignature", start, start)
            .addAll(modifiers, "modifiers")
            .addAll(this.parameterList("OpenBracketToken", "CloseBracketToken"), "parameters")
        if (this.eat("ColonToken")) node.add(this.type(), "type")
        return node
    }

    private heritageClauses(node: Node) {
        while (this.at("ExtendsKeyword") || this.at("ImplementsKeyword")) {
            const start = this.next().start
            const clause = new Node("HeritageClause", start, start)
            for (;;) {
                const typeStart = this.token().start
                let expression = this.identifier()
                while (this.eat("DotToken"))
                    expression = this.node(
                        "PropertyAccessExpression",
                        typeStart,
                        [expression, this.identifierName()],
                        ["expression", "name"],
                    )
                const type = new Node("ExpressionWithTypeArguments", typeStart, typeStart).add(expression, "expression")
                if (this.at("LessThanToken")) type.addAll(this.typeArguments(), "typeArguments")
                clause.add(this.finish(type, typeStart), "types")
                if (!this.eat("CommaToken")) break
            }
            node.add(this.finish(clause, start), "heritageClauses")
        }
    }

    private classDeclaration(modifiers: Node[], start: int): Node {
        this.next()
        const node = new Node("ClassDeclaration", start, start).addAll(modifiers, "modifiers")
        if (this.isIdentifier(this.kind()) && !this.at("ImplementsKeyword")) node.add(this.identifier(), "name")
        if (this.at("LessThanToken")) node.addAll(this.typeParameters(), "typeParameters")
        this.heritageClauses(node)
        this.expect("OpenBraceToken")
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const before = this.i
            node.add(this.classMember(), "members")
            if (this.i === before) this.next()
        }
        this.expect("CloseBraceToken")
        return this.finish(node, start)
    }

    private classMember(): Node {
        const start = this.token().start
        if (this.eat("SemicolonToken")) return this.make("SemicolonClassElement", start)
        // `static { ... }`: a block run where the class is declared.
        if (this.at("StaticKeyword") && this.peek(1).kind === "OpenBraceToken") {
            this.next()
            const block = new Node("ClassStaticBlockDeclaration", start, start).add(this.block(), "body")
            return this.finish(block, start)
        }
        const modifiers = this.modifiers()
        const next = this.peek(1)
        if (this.at("ConstructorKeyword") && next.kind === "OpenParenToken") {
            this.next()
            const node = new Node("Constructor", start, start).addAll(modifiers, "modifiers")
            this.signature(node)
            if (this.at("OpenBraceToken")) node.add(this.block(), "body")
            else this.semicolon()
            return this.finish(node, start)
        }
        if ((this.at("GetKeyword") || this.at("SetKeyword")) && this.isPropertyNameStart(next.kind) && !next.newline) {
            const kind: NodeKind = this.at("GetKeyword") ? "GetAccessor" : "SetAccessor"
            this.next()
            const node = new Node(kind, start, start).addAll(modifiers, "modifiers").add(this.propertyName(), "name")
            this.signature(node)
            if (this.at("OpenBraceToken")) node.add(this.block(), "body")
            else this.semicolon()
            return this.finish(node, start)
        }
        if (this.atIndexSignature()) {
            const signature = this.indexSignature(modifiers, start)
            if (!this.eat("CommaToken")) this.semicolon()
            return this.finish(signature, start)
        }
        const asterisk = this.at("AsteriskToken") ? this.tokenNode() : null
        const name = this.propertyName()
        const optional = this.at("QuestionToken") || this.at("ExclamationToken") ? this.tokenNode() : null
        const optionalRole =
            optional !== null && optional.kind === "ExclamationToken" ? "exclamationToken" : "questionToken"
        if (asterisk !== null || this.at("OpenParenToken") || this.at("LessThanToken")) {
            const node = new Node("MethodDeclaration", start, start)
                .addAll(modifiers, "modifiers")
                .add(asterisk, "asteriskToken")
                .add(name, "name")
                .add(optional, optionalRole)
            this.signature(node)
            if (this.at("OpenBraceToken")) node.add(this.block(), "body")
            else this.semicolon()
            return this.finish(node, start)
        }
        const node = new Node("PropertyDeclaration", start, start)
            .addAll(modifiers, "modifiers")
            .add(name, "name")
            .add(optional, optionalRole)
        if (this.eat("ColonToken")) node.add(this.type(), "type")
        if (this.eat("EqualsToken")) node.add(this.assignment(), "initializer")
        this.semicolon()
        return this.finish(node, start)
    }

    private interfaceDeclaration(modifiers: Node[], start: int): Node {
        this.next()
        const node = new Node("InterfaceDeclaration", start, start)
            .addAll(modifiers, "modifiers")
            .add(this.identifier(), "name")
        if (this.at("LessThanToken")) node.addAll(this.typeParameters(), "typeParameters")
        this.heritageClauses(node)
        node.addAll(this.typeMembers(), "members")
        return this.finish(node, start)
    }

    private typeAliasDeclaration(modifiers: Node[], start: int): Node {
        this.next()
        const node = new Node("TypeAliasDeclaration", start, start)
            .addAll(modifiers, "modifiers")
            .add(this.identifier(), "name")
        if (this.at("LessThanToken")) node.addAll(this.typeParameters(), "typeParameters")
        this.expect("EqualsToken")
        // `intrinsic` is a type only here.
        const next = this.peek(1).kind
        if (this.at("IntrinsicKeyword") && next !== "DotToken" && next !== "LessThanToken")
            node.add(this.tokenNode(), "type")
        else node.add(this.type(), "type")
        this.semicolon()
        return this.finish(node, start)
    }

    private enumDeclaration(modifiers: Node[], start: int): Node {
        this.next()
        const node = new Node("EnumDeclaration", start, start)
            .addAll(modifiers, "modifiers")
            .add(this.identifier(), "name")
        this.expect("OpenBraceToken")
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const memberStart = this.token().start
            const member = new Node("EnumMember", memberStart, memberStart).add(this.propertyName(), "name")
            if (this.eat("EqualsToken")) member.add(this.assignment(), "initializer")
            node.add(this.finish(member, memberStart), "members")
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBraceToken")
        return this.finish(node, start)
    }

    private moduleDeclaration(modifiers: Node[], start: int): Node {
        const node = new Node("ModuleDeclaration", start, start).addAll(modifiers, "modifiers")
        if (this.at("GlobalKeyword")) node.add(this.nameNode(), "name")
        else {
            this.next()
            node.add(this.at("StringLiteral") ? this.tokenNode() : this.identifier(), "name")
        }
        if (this.at("OpenBraceToken")) {
            const blockStart = this.next().start
            const body = new Node("ModuleBlock", blockStart, blockStart)
            while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
                const before = this.i
                body.add(this.statement(), "statements")
                if (this.i === before) this.next()
            }
            this.expect("CloseBraceToken")
            node.add(this.finish(body, blockStart), "body")
        } else {
            this.semicolon()
        }
        return this.finish(node, start)
    }

    private importDeclaration(): Node {
        const start = this.next().start
        const node = new Node("ImportDeclaration", start, start)
        if (!this.at("StringLiteral")) {
            const clauseStart = this.token().start
            const clause = new Node("ImportClause", clauseStart, clauseStart)
            // `import type { ... }`
            if (
                this.at("TypeKeyword") &&
                (this.peek(1).kind === "OpenBraceToken" || this.peek(1).kind === "AsteriskToken")
            )
                this.next()
            if (this.isIdentifier(this.kind()) && !this.at("FromKeyword")) {
                clause.add(this.identifier(), "name")
                this.eat("CommaToken")
            }
            if (this.at("AsteriskToken")) {
                const namespaceStart = this.next().start
                this.expect("AsKeyword")
                clause.add(this.node("NamespaceImport", namespaceStart, [this.identifier()], ["name"]), "namedBindings")
            } else if (this.at("OpenBraceToken")) {
                clause.add(this.namedBindings("NamedImports", "ImportSpecifier"), "namedBindings")
            }
            node.add(this.finish(clause, clauseStart), "importClause")
            this.expect("FromKeyword")
        }
        if (this.at("StringLiteral")) node.add(this.tokenNode(), "moduleSpecifier")
        else this.error("Module specifier expected")
        // Import attributes: `with { type: "text" }`, from the `with` keyword.
        if (this.at("WithKeyword")) {
            const attributesStart = this.next().start
            const attributes = new Node("ImportAttributes", attributesStart, attributesStart)
            this.expect("OpenBraceToken")
            while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
                const attributeStart = this.token().start
                const name = this.at("StringLiteral") ? this.tokenNode() : this.identifierName()
                this.expect("ColonToken")
                const value = this.assignment()
                attributes.add(
                    this.node("ImportAttribute", attributeStart, [name, value], ["name", "value"]),
                    "elements",
                )
                if (!this.eat("CommaToken")) break
            }
            this.expect("CloseBraceToken")
            node.add(this.finish(attributes, attributesStart), "attributes")
        }
        this.semicolon()
        return this.finish(node, start)
    }

    /** `{ a, b as c }` of an import or export. */
    private namedBindings(kind: NodeKind, element: NodeKind): Node {
        const start = this.next().start
        const node = new Node(kind, start, start)
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const elementStart = this.token().start
            // An inline `type` modifier is part of the element but not a node.
            if (this.at("TypeKeyword") && this.isIdentifier(this.peek(1).kind) && this.peek(1).kind !== "AsKeyword")
                this.next()
            const first = this.identifierName()
            const specifier = new Node(element, elementStart, elementStart)
            if (this.eat("AsKeyword")) specifier.add(first, "propertyName").add(this.identifierName(), "name")
            else specifier.add(first, "name")
            node.add(this.finish(specifier, elementStart), "elements")
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBraceToken")
        return this.finish(node, start)
    }

    private exportStatement(): Node {
        const start = this.token().start
        const next = this.peek(1).kind
        if (
            next === "OpenBraceToken" ||
            next === "AsteriskToken" ||
            (next === "TypeKeyword" && this.peek(2).kind === "OpenBraceToken")
        ) {
            this.next()
            if (this.at("TypeKeyword")) this.next()
            const node = new Node("ExportDeclaration", start, start)
            if (this.at("AsteriskToken")) {
                // `export * from "m"`, or `export * as ns from "m"`.
                const namespaceStart = this.next().start
                if (this.eat("AsKeyword"))
                    node.add(
                        this.node("NamespaceExport", namespaceStart, [this.identifierName()], ["name"]),
                        "exportClause",
                    )
            } else {
                node.add(this.namedBindings("NamedExports", "ExportSpecifier"), "exportClause")
            }
            if (this.eat("FromKeyword")) {
                if (this.at("StringLiteral")) node.add(this.tokenNode(), "moduleSpecifier")
                else this.error("Module specifier expected")
            }
            this.semicolon()
            return this.finish(node, start)
        }
        if (next === "DefaultKeyword" || next === "EqualsToken") {
            const third = this.peek(2).kind
            if (
                next === "EqualsToken" ||
                (third !== "FunctionKeyword" && third !== "ClassKeyword" && third !== "InterfaceKeyword")
            ) {
                const modifiers: Node[] = []
                this.next()
                if (this.at("DefaultKeyword")) modifiers.push(this.tokenNode())
                else this.next()
                const node = new Node("ExportAssignment", start, start)
                    .addAll(modifiers, "modifiers")
                    .add(this.assignment(), "expression")
                this.semicolon()
                return this.finish(node, start)
            }
        }
        return this.declaration(this.modifiers(), start)
    }

    // -------------------------------------------------------------------------
    // Expressions

    expression(): Node {
        const start = this.token().start
        let left = this.assignment()
        while (this.at("CommaToken")) {
            const operator = this.tokenNode()
            left = this.node(
                "BinaryExpression",
                start,
                [left, operator, this.assignment()],
                ["left", "operatorToken", "right"],
            )
        }
        return left
    }

    private assignment(): Node {
        if (this.at("YieldKeyword")) return this.yieldExpression()
        const arrow = this.arrowFunction()
        if (arrow !== null) return arrow
        const start = this.token().start
        const left = this.conditional()
        const operator = this.operator()
        if (operator !== null && assignmentOperators.includes(operator.kind)) {
            const node = this.operatorNode(operator)
            return this.node(
                "BinaryExpression",
                start,
                [left, node, this.assignment()],
                ["left", "operatorToken", "right"],
            )
        }
        return left
    }

    /** `yield`, `yield value` or `yield* iterable`: a value follows unless the expression ends there. */
    private yieldExpression(): Node {
        const start = this.token().start
        this.next()
        const asterisk = this.at("AsteriskToken") ? this.tokenNode() : null
        const k = this.kind()
        const ends =
            k === "CloseParenToken" ||
            k === "CloseBracketToken" ||
            k === "CloseBraceToken" ||
            k === "CommaToken" ||
            k === "SemicolonToken" ||
            k === "ColonToken" ||
            k === "EndOfFileToken" ||
            (this.token().newline && asterisk === null)
        const operand = ends && asterisk === null ? null : this.assignment()
        return this.node("YieldExpression", start, [asterisk, operand], ["asteriskToken", "expression"])
    }

    /** The binary or assignment operator at the current token, joining `>` with what follows. */
    private operator(): Operator | null {
        const k = this.kind()
        if (k !== "GreaterThanToken") return { kind: k, tokens: 1 }
        // `>` tokens that touch form `>>`, `>>>`, `>=`, `>>=` and `>>>=`.
        let count = 1
        while (
            count < 3 &&
            this.peek(count).kind === "GreaterThanToken" &&
            this.peek(count).start === this.peek(count - 1).end
        )
            count++
        const equals = this.peek(count).kind === "EqualsToken" && this.peek(count).start === this.peek(count - 1).end
        const kinds: NodeKind[] = equals
            ? [
                  "GreaterThanEqualsToken",
                  "GreaterThanGreaterThanEqualsToken",
                  "GreaterThanGreaterThanGreaterThanEqualsToken",
              ]
            : ["GreaterThanToken", "GreaterThanGreaterThanToken", "GreaterThanGreaterThanGreaterThanToken"]
        return { kind: kinds[count - 1], tokens: equals ? count + 1 : count }
    }

    private operatorNode(operator: Operator): Node {
        const start = this.token().start
        for (let n = 0; n < operator.tokens; n++) this.next()
        const node = new Node(operator.kind, start, this.last)
        node.text = this.text.slice(start, this.last)
        return node
    }

    private conditional(): Node {
        const start = this.token().start
        const condition = this.binary(0)
        if (!this.at("QuestionToken")) return condition
        const question = this.tokenNode()
        const noIn = this.noIn
        this.noIn = false
        const whenTrue = this.assignment()
        this.noIn = noIn
        const colon = this.at("ColonToken") ? this.tokenNode() : null
        if (colon === null) this.error("':' expected")
        const whenFalse = this.assignment()
        return this.make("ConditionalExpression", start)
            .add(condition, "condition")
            .add(question, "questionToken")
            .add(whenTrue, "whenTrue")
            .add(colon, "colonToken")
            .add(whenFalse, "whenFalse")
    }

    private binary(minimum: int): Node {
        const start = this.token().start
        let left = this.unary()
        for (;;) {
            const operator = this.operator()
            if (operator === null) break
            if (this.noIn && operator.kind === "InKeyword") break
            const level = precedence(operator.kind)
            if (level === 0) break
            // `**` groups to the right, the others to the left.
            if (operator.kind === "AsteriskAsteriskToken" ? level < minimum : level <= minimum) break
            if (operator.kind === "AsKeyword" || operator.kind === "SatisfiesKeyword") {
                if (this.token().newline) break
                this.next()
                left = this.node(
                    operator.kind === "AsKeyword" ? "AsExpression" : "SatisfiesExpression",
                    start,
                    [left, this.type()],
                    ["expression", "type"],
                )
                continue
            }
            const node = this.operatorNode(operator)
            let right = this.binary(level)
            if (operator.kind === "InstanceOfKeyword" && this.at("LessThanToken")) right = this.instantiation(right)
            left = this.make("BinaryExpression", start).add(left, "left").add(node, "operatorToken").add(right, "right")
        }
        return left
    }

    private unary(): Node {
        const start = this.token().start
        switch (this.kind()) {
            case "PlusPlusToken":
            case "MinusMinusToken":
            case "PlusToken":
            case "MinusToken":
            case "TildeToken":
            case "ExclamationToken": {
                this.next()
                const operand = this.unary()
                return this.make("PrefixUnaryExpression", start).add(operand, "operand")
            }
            case "TypeOfKeyword":
            case "VoidKeyword":
            case "DeleteKeyword":
            case "AwaitKeyword": {
                const kind: NodeKind = this.at("TypeOfKeyword")
                    ? "TypeOfExpression"
                    : this.at("VoidKeyword")
                      ? "VoidExpression"
                      : this.at("DeleteKeyword")
                        ? "DeleteExpression"
                        : "AwaitExpression"
                this.next()
                const operand = this.unary()
                return this.make(kind, start).add(operand, "expression")
            }
        }
        const expression = this.leftHandSide()
        if ((this.at("PlusPlusToken") || this.at("MinusMinusToken")) && !this.token().newline) {
            this.next()
            return this.make("PostfixUnaryExpression", start).add(expression, "operand")
        }
        return expression
    }

    private leftHandSide(): Node {
        const start = this.token().start
        let expression = this.at("NewKeyword") ? this.newExpression() : this.primary()
        for (;;) {
            if (this.at("DotToken")) {
                this.next()
                expression = this.node(
                    "PropertyAccessExpression",
                    start,
                    [expression, this.identifierName()],
                    ["expression", "name"],
                )
            } else if (this.at("QuestionDotToken")) {
                const question = this.tokenNode()
                if (this.at("OpenBracketToken")) {
                    this.next()
                    const argument = this.expression()
                    this.expect("CloseBracketToken")
                    expression = this.make("ElementAccessExpression", start)
                        .add(expression, "expression")
                        .add(question, "questionDotToken")
                        .add(argument, "argumentExpression")
                } else if (this.at("OpenParenToken")) {
                    const args = this.arguments()
                    expression = this.make("CallExpression", start)
                        .add(expression, "expression")
                        .add(question, "questionDotToken")
                        .addAll(args, "arguments")
                } else {
                    const name = this.identifierName()
                    expression = this.make("PropertyAccessExpression", start)
                        .add(expression, "expression")
                        .add(question, "questionDotToken")
                        .add(name, "name")
                }
            } else if (this.at("OpenBracketToken")) {
                this.next()
                const argument = this.expression()
                this.expect("CloseBracketToken")
                expression = this.make("ElementAccessExpression", start)
                    .add(expression, "expression")
                    .add(argument, "argumentExpression")
            } else if (this.at("ExclamationToken") && !this.token().newline) {
                this.next()
                expression = this.make("NonNullExpression", start).add(expression, "expression")
            } else if (this.at("OpenParenToken")) {
                const args = this.arguments()
                expression = this.make("CallExpression", start).add(expression, "expression").addAll(args, "arguments")
            } else if (this.at("NoSubstitutionTemplateLiteral") || this.at("TemplateHead")) {
                // A tagged template: the tag is called with the strings and the substitutions.
                const template = this.at("TemplateHead") ? this.template() : this.tokenNode()
                expression = this.make("TaggedTemplateExpression", start)
                    .add(expression, "tag")
                    .add(template, "template")
            } else if (this.at("LessThanToken")) {
                const typeArguments = this.typeArgumentsInExpression()
                if (typeArguments === null) break
                const args = this.arguments()
                expression = this.make("CallExpression", start)
                    .add(expression, "expression")
                    .addAll(typeArguments, "typeArguments")
                    .addAll(args, "arguments")
            } else {
                break
            }
        }
        return expression
    }

    private newExpression(): Node {
        const start = this.next().start
        const targetStart = this.token().start
        let target = this.primary()
        while (this.eat("DotToken"))
            target = this.node(
                "PropertyAccessExpression",
                targetStart,
                [target, this.identifierName()],
                ["expression", "name"],
            )
        const node = new Node("NewExpression", start, start).add(target, "expression")
        if (this.at("LessThanToken")) {
            const typeArguments = this.speculate(() => {
                const list = this.typeArguments()
                return new Node("SyntaxList", 0, 0).addAll(list, "typeArguments")
            })
            if (typeArguments !== null) node.addAll(typeArguments.children, "typeArguments")
        }
        if (this.at("OpenParenToken")) node.addAll(this.arguments(), "arguments")
        return this.finish(node, start)
    }

    private arguments(): Node[] {
        this.expect("OpenParenToken")
        const list: Node[] = []
        while (!this.at("CloseParenToken") && !this.at("EndOfFileToken")) {
            if (this.at("DotDotDotToken")) {
                const start = this.next().start
                list.push(this.node("SpreadElement", start, [this.assignment()], ["expression"]))
            } else {
                list.push(this.assignment())
            }
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseParenToken")
        return list
    }

    /**
     * A class with type arguments on the right of `instanceof`, `x instanceof
     * Box<int>`, as TypeScript's instantiation expressions; `expression`
     * itself when `<` is a comparison or starts a call.
     */
    private instantiation(expression: Node): Node {
        if (expression.kind !== "Identifier" && expression.kind !== "PropertyAccessExpression") return expression
        const node = this.speculate(() => {
            const types = this.typeArguments()
            if (this.at("OpenParenToken") || this.at("NoSubstitutionTemplateLiteral") || this.at("TemplateHead"))
                return null
            const node = new Node("ExpressionWithTypeArguments", expression.start, expression.start)
            return this.finish(node.add(expression, "expression").addAll(types, "typeArguments"), expression.start)
        })
        return node ?? expression
    }

    /** `<T, U>` before `(` in a call; null, consuming nothing, when `<` is a comparison. */
    private typeArgumentsInExpression(): Node[] | null {
        const list = this.speculate(() => {
            const types = this.typeArguments()
            if (!this.at("OpenParenToken")) return null
            return new Node("SyntaxList", 0, 0).addAll(types, "typeArguments")
        })
        return list === null ? null : list.children
    }

    private primary(): Node {
        const start = this.token().start
        const k = this.kind()
        switch (k) {
            case "NumericLiteral":
            case "BigIntLiteral":
            case "StringLiteral":
            case "NoSubstitutionTemplateLiteral":
            case "ThisKeyword":
            case "SuperKeyword":
            case "TrueKeyword":
            case "FalseKeyword":
            case "NullKeyword":
                return this.tokenNode()
            case "TemplateHead":
                return this.template()
            case "RegularExpressionLiteral": {
                const t = this.token()
                if (regexClose(this.text, t.start + 1) < 0) this.error("Unterminated regular expression literal")
                return this.tokenNode()
            }
            case "OpenParenToken": {
                this.next()
                const expression = this.expression()
                this.expect("CloseParenToken")
                return this.make("ParenthesizedExpression", start).add(expression, "expression")
            }
            case "OpenBracketToken":
                return this.arrayLiteral()
            case "OpenBraceToken":
                return this.objectLiteral()
            case "AsyncKeyword":
                if (this.peek(1).kind !== "FunctionKeyword" || this.peek(1).newline) break
            // An `async function` expression.
            case "FunctionKeyword": {
                const modifier = this.at("AsyncKeyword") ? this.tokenNode() : null
                this.next()
                const node = new Node("FunctionExpression", start, start).add(modifier, "modifiers")
                if (this.at("AsteriskToken")) node.add(this.tokenNode(), "asteriskToken")
                if (this.isIdentifier(this.kind())) node.add(this.identifier(), "name")
                this.signature(node)
                node.add(this.block(), "body")
                return this.finish(node, start)
            }
        }
        return this.identifier()
    }

    private template(): Node {
        const start = this.token().start
        const node = new Node("TemplateExpression", start, start).add(this.tokenNode(), "head")
        for (;;) {
            const spanStart = this.token().start
            const expression = this.expression()
            const k = this.kind()
            if (k !== "TemplateMiddle" && k !== "TemplateTail") {
                this.error("Template continuation expected")
                break
            }
            const literal = this.tokenNode()
            node.add(
                this.make("TemplateSpan", spanStart).add(expression, "expression").add(literal, "literal"),
                "templateSpans",
            )
            if (k === "TemplateTail") break
        }
        return this.finish(node, start)
    }

    private arrayLiteral(): Node {
        const start = this.next().start
        const node = new Node("ArrayLiteralExpression", start, start)
        while (!this.at("CloseBracketToken") && !this.at("EndOfFileToken")) {
            if (this.at("CommaToken")) {
                node.add(new Node("OmittedExpression", this.last, this.last), "elements")
                this.next()
                continue
            }
            if (this.at("DotDotDotToken")) {
                const spreadStart = this.next().start
                node.add(this.node("SpreadElement", spreadStart, [this.assignment()], ["expression"]), "elements")
            } else {
                node.add(this.assignment(), "elements")
            }
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBracketToken")
        return this.finish(node, start)
    }

    private objectLiteral(): Node {
        const start = this.next().start
        const node = new Node("ObjectLiteralExpression", start, start)
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const memberStart = this.token().start
            if (this.at("DotDotDotToken")) {
                this.next()
                node.add(this.node("SpreadAssignment", memberStart, [this.assignment()], ["expression"]), "properties")
            } else {
                const next = this.peek(1)
                const accessor =
                    (this.at("GetKeyword") || this.at("SetKeyword")) &&
                    this.isPropertyNameStart(next.kind) &&
                    !next.newline
                if (accessor) {
                    const kind: NodeKind = this.at("GetKeyword") ? "GetAccessor" : "SetAccessor"
                    this.next()
                    const member = new Node(kind, memberStart, memberStart).add(this.propertyName(), "name")
                    this.signature(member)
                    member.add(this.block(), "body")
                    node.add(this.finish(member, memberStart), "properties")
                } else {
                    // `*name() { ... }`: a generator method.
                    const asterisk = this.at("AsteriskToken") ? this.tokenNode() : null
                    const name = this.propertyName()
                    if (asterisk !== null || this.at("OpenParenToken") || this.at("LessThanToken")) {
                        const member = new Node("MethodDeclaration", memberStart, memberStart)
                            .add(asterisk, "asteriskToken")
                            .add(name, "name")
                        this.signature(member)
                        member.add(this.block(), "body")
                        node.add(this.finish(member, memberStart), "properties")
                    } else if (this.eat("ColonToken")) {
                        node.add(
                            this.node(
                                "PropertyAssignment",
                                memberStart,
                                [name, this.assignment()],
                                ["name", "initializer"],
                            ),
                            "properties",
                        )
                    } else {
                        const member = new Node("ShorthandPropertyAssignment", memberStart, memberStart).add(
                            name,
                            "name",
                        )
                        if (this.at("EqualsToken"))
                            member
                                .add(this.tokenNode(), "equalsToken")
                                .add(this.assignment(), "objectAssignmentInitializer")
                        node.add(this.finish(member, memberStart), "properties")
                    }
                }
            }
            if (!this.eat("CommaToken")) break
        }
        this.expect("CloseBraceToken")
        return this.finish(node, start)
    }

    /** An arrow function, or null, consuming nothing, when none starts here. */
    private arrowFunction(): Node | null {
        const start = this.token().start
        const next = this.peek(1)
        // `async x => ...`, `async (x) => ...`
        if (
            this.at("AsyncKeyword") &&
            !next.newline &&
            (next.kind === "OpenParenToken" || next.kind === "LessThanToken" || this.isIdentifier(next.kind))
        ) {
            return this.speculate(() => {
                const modifier = this.tokenNode()
                const arrow = this.arrowFunction()
                if (arrow === null || arrow.kind !== "ArrowFunction") return null
                const children = [modifier]
                const roles = ["modifiers"]
                for (let i = 0; i < arrow.children.length; i++) {
                    children.push(arrow.children[i])
                    roles.push(arrow.roles[i])
                }
                arrow.children = children
                arrow.roles = roles
                arrow.start = start
                return arrow
            })
        }
        const k = this.kind()
        if (this.isIdentifier(k) && this.peek(1).kind === "EqualsGreaterThanToken" && !this.peek(1).newline) {
            const name = this.identifier()
            const parameter = new Node("Parameter", name.start, name.end).add(name, "name")
            const arrow = this.tokenNode()
            const body = this.arrowBody()
            return this.make("ArrowFunction", start)
                .add(parameter, "parameters")
                .add(arrow, "equalsGreaterThanToken")
                .add(body, "body")
        }
        if (k !== "OpenParenToken" && k !== "LessThanToken") return null
        return this.speculate(() => {
            const node = new Node("ArrowFunction", start, start)
            this.signature(node)
            if (!this.at("EqualsGreaterThanToken") || this.token().newline) return null
            node.add(this.tokenNode(), "equalsGreaterThanToken")
            node.add(this.arrowBody(), "body")
            return this.finish(node, start)
        })
    }

    private arrowBody(): Node {
        if (this.at("OpenBraceToken")) return this.block()
        const noIn = this.noIn
        this.noIn = false
        const body = this.assignment()
        this.noIn = noIn
        return body
    }

    // -------------------------------------------------------------------------
    // Types

    type(): Node {
        if (this.at("LessThanToken")) return this.functionType()
        if (this.at("NewKeyword")) return this.functionType()
        if (this.at("OpenParenToken")) {
            const functionType = this.speculate(() => this.functionType())
            if (functionType !== null) return functionType
        }
        const start = this.token().start
        const check = this.unionType()
        if (this.noConditional || !this.at("ExtendsKeyword") || this.token().newline) return check
        // `T extends U ? X : Y`: the `extends` clause cannot be conditional itself.
        this.next()
        const noConditional = this.noConditional
        this.noConditional = true
        const extendsType = this.type()
        this.noConditional = noConditional
        this.expect("QuestionToken")
        const trueType = this.type()
        this.expect("ColonToken")
        const falseType = this.type()
        return this.make("ConditionalType", start)
            .add(check, "checkType")
            .add(extendsType, "extendsType")
            .add(trueType, "trueType")
            .add(falseType, "falseType")
    }

    /** A type in brackets or parentheses, where a conditional type is allowed again. */
    private nestedType(): Node {
        const noConditional = this.noConditional
        this.noConditional = false
        const type = this.type()
        this.noConditional = noConditional
        return type
    }

    /** `(params) => T`, or a constructor type, `new (params) => T`. */
    private functionType(): Node {
        const start = this.token().start
        const node = new Node(this.eat("NewKeyword") ? "ConstructorType" : "FunctionType", start, start)
        if (this.at("LessThanToken")) node.addAll(this.typeParameters(), "typeParameters")
        node.addAll(this.parameters(), "parameters")
        this.expect("EqualsGreaterThanToken")
        node.add(this.returnType(), "type")
        return this.finish(node, start)
    }

    private unionType(): Node {
        const start = this.token().start
        const leading = this.eat("BarToken")
        const first = this.intersectionType()
        if (!this.at("BarToken") && !leading) return first
        const node = new Node("UnionType", start, start).add(first, "types")
        while (this.eat("BarToken")) node.add(this.intersectionType(), "types")
        return this.finish(node, start)
    }

    private intersectionType(): Node {
        const start = this.token().start
        const first = this.postfixType()
        if (!this.at("AmpersandToken")) return first
        const node = new Node("IntersectionType", start, start).add(first, "types")
        while (this.eat("AmpersandToken")) node.add(this.postfixType(), "types")
        return this.finish(node, start)
    }

    private postfixType(): Node {
        const start = this.token().start
        let type = this.primaryType()
        while (this.at("OpenBracketToken") && !this.token().newline) {
            this.next()
            if (this.eat("CloseBracketToken")) {
                type = this.make("ArrayType", start).add(type, "elementType")
            } else {
                const index = this.nestedType()
                this.expect("CloseBracketToken")
                type = this.make("IndexedAccessType", start).add(type, "objectType").add(index, "indexType")
            }
        }
        return type
    }

    private primaryType(): Node {
        const start = this.token().start
        const k = this.kind()
        if (keywordTypes.includes(k) && this.peek(1).kind !== "DotToken") return this.tokenNode()
        switch (k) {
            case "NullKeyword":
            case "TrueKeyword":
            case "FalseKeyword":
            case "StringLiteral":
            case "NumericLiteral":
            case "BigIntLiteral":
            case "NoSubstitutionTemplateLiteral":
                return this.node("LiteralType", start, [this.tokenNode()], ["literal"])
            case "MinusToken": {
                this.next()
                const literal = this.tokenNode()
                const negative = this.make("PrefixUnaryExpression", start).add(literal, "operand")
                return this.make("LiteralType", start).add(negative, "literal")
            }
            case "TypeOfKeyword": {
                this.next()
                const nameStart = this.token().start
                let name = this.identifier()
                while (this.eat("DotToken"))
                    name = this.node("QualifiedName", nameStart, [name, this.identifierName()], ["left", "right"])
                return this.node("TypeQuery", start, [name], ["exprName"])
            }
            case "KeyOfKeyword":
            case "UniqueKeyword":
            case "ReadonlyKeyword": {
                this.next()
                return this.node("TypeOperator", start, [this.postfixType()], ["type"])
            }
            case "InferKeyword": {
                if (!this.isIdentifier(this.peek(1).kind)) break
                this.next()
                const nameStart = this.token().start
                const parameter = this.make("TypeParameter", nameStart).add(this.identifier(), "name")
                return this.make("InferType", start).add(this.finish(parameter, nameStart), "typeParameter")
            }
            case "ThisKeyword":
                this.next()
                return this.make("ThisType", start)
            case "TemplateHead":
                return this.templateType()
            case "OpenParenToken": {
                this.next()
                const inner = this.nestedType()
                this.expect("CloseParenToken")
                return this.make("ParenthesizedType", start).add(inner, "type")
            }
            case "OpenBraceToken": {
                if (this.atMappedType()) return this.mappedType()
                const node = new Node("TypeLiteral", start, start).addAll(this.typeMembers(), "members")
                return this.finish(node, start)
            }
            case "OpenBracketToken": {
                this.next()
                const node = new Node("TupleType", start, start)
                while (!this.at("CloseBracketToken") && !this.at("EndOfFileToken")) {
                    node.add(this.tupleElement(), "elements")
                    if (!this.eat("CommaToken")) break
                }
                this.expect("CloseBracketToken")
                return this.finish(node, start)
            }
        }
        // `as const` names the type `const`, as in TypeScript.
        let name = k === "ConstKeyword" ? this.identifierName() : this.identifier()
        while (this.at("DotToken")) {
            this.next()
            name = this.node("QualifiedName", start, [name, this.identifierName()], ["left", "right"])
        }
        const reference = new Node("TypeReference", start, start).add(name, "typeName")
        if (this.at("LessThanToken") && !this.token().newline) reference.addAll(this.typeArguments(), "typeArguments")
        return this.finish(reference, start)
    }

    /** An element of a tuple type: `T`, `T?`, `...T`, or named, `name: T`, `name?: T`, `...name: T`. */
    private tupleElement(): Node {
        const start = this.token().start
        const rest = this.at("DotDotDotToken")
        const n = rest ? 1 : 0
        const named =
            this.isIdentifier(this.peek(n).kind) &&
            (this.peek(n + 1).kind === "ColonToken" ||
                (this.peek(n + 1).kind === "QuestionToken" && this.peek(n + 2).kind === "ColonToken"))
        if (named) {
            const node = new Node("NamedTupleMember", start, start)
            if (rest) node.add(this.tokenNode(), "dotDotDotToken")
            node.add(this.identifier(), "name")
            if (this.at("QuestionToken")) node.add(this.tokenNode(), "questionToken")
            this.expect("ColonToken")
            node.add(this.type(), "type")
            return this.finish(node, start)
        }
        if (rest) {
            this.next()
            const inner = this.type()
            return this.make("RestType", start).add(inner, "type")
        }
        const type = this.type()
        if (!this.at("QuestionToken")) return type
        this.next()
        return this.make("OptionalType", start).add(type, "type")
    }

    private typeArguments(): Node[] {
        this.expect("LessThanToken")
        const list: Node[] = []
        while (!this.at("GreaterThanToken") && !this.at("EndOfFileToken")) {
            list.push(this.nestedType())
            if (!this.eat("CommaToken")) break
        }
        this.expect("GreaterThanToken")
        return list
    }

    /** Whether a `{` starts a mapped type: `{ [K in T]: X }`, maybe with `readonly`, `+readonly` or `-readonly`. */
    private atMappedType(): bool {
        let n = 1
        let k = this.peek(n).kind
        if (k === "PlusToken" || k === "MinusToken") {
            n++
            k = this.peek(n).kind
            if (k !== "ReadonlyKeyword") return false
        }
        if (k === "ReadonlyKeyword") {
            n++
            k = this.peek(n).kind
        }
        return (
            k === "OpenBracketToken" &&
            this.isIdentifier(this.peek(n + 1).kind) &&
            this.peek(n + 2).kind === "InKeyword"
        )
    }

    /** `{ readonly [K in T as N]?: X }`. */
    private mappedType(): Node {
        const start = this.next().start
        const node = new Node("MappedType", start, start)
        if (this.at("PlusToken") || this.at("MinusToken")) {
            node.add(this.tokenNode(), "readonlyToken")
            this.expect("ReadonlyKeyword")
        } else if (this.at("ReadonlyKeyword")) node.add(this.tokenNode(), "readonlyToken")
        this.expect("OpenBracketToken")
        const parameterStart = this.token().start
        const parameter = this.make("TypeParameter", parameterStart).add(this.identifier(), "name")
        this.expect("InKeyword")
        parameter.add(this.nestedType(), "constraint")
        node.add(this.finish(parameter, parameterStart), "typeParameter")
        if (this.eat("AsKeyword")) node.add(this.nestedType(), "nameType")
        this.expect("CloseBracketToken")
        if (this.at("PlusToken") || this.at("MinusToken")) {
            node.add(this.tokenNode(), "questionToken")
            this.expect("QuestionToken")
        } else if (this.at("QuestionToken")) node.add(this.tokenNode(), "questionToken")
        if (this.eat("ColonToken")) node.add(this.nestedType(), "type")
        if (!this.eat("SemicolonToken")) this.eat("CommaToken")
        this.expect("CloseBraceToken")
        return this.finish(node, start)
    }

    /** A template literal type: `` `on${Capitalize<K>}` ``. */
    private templateType(): Node {
        const start = this.token().start
        const node = new Node("TemplateLiteralType", start, start).add(this.tokenNode(), "head")
        for (;;) {
            const spanStart = this.token().start
            const type = this.nestedType()
            const k = this.kind()
            if (k !== "TemplateMiddle" && k !== "TemplateTail") {
                this.error("Template continuation expected")
                break
            }
            const literal = this.tokenNode()
            node.add(
                this.make("TemplateLiteralTypeSpan", spanStart).add(type, "type").add(literal, "literal"),
                "templateSpans",
            )
            if (k === "TemplateTail") break
        }
        return this.finish(node, start)
    }

    /** `{ members }` of an interface or object type. */
    private typeMembers(): Node[] {
        this.expect("OpenBraceToken")
        const members: Node[] = []
        while (!this.at("CloseBraceToken") && !this.at("EndOfFileToken")) {
            const start = this.token().start
            const before = this.i
            const modifiers = this.modifiers()
            if (this.atIndexSignature()) {
                const signature = this.indexSignature(modifiers, start)
                // The separator belongs to the member.
                if (!this.eat("SemicolonToken")) this.eat("CommaToken")
                members.push(this.finish(signature, start))
                continue
            }
            const next = this.peek(1)
            if (
                (this.at("GetKeyword") || this.at("SetKeyword")) &&
                this.isPropertyNameStart(next.kind) &&
                !next.newline
            ) {
                // `get x(): T` and `set x(value: T)`: accessor signatures.
                const kind: NodeKind = this.at("GetKeyword") ? "GetAccessor" : "SetAccessor"
                this.next()
                const accessor = new Node(kind, start, start)
                    .addAll(modifiers, "modifiers")
                    .add(this.propertyName(), "name")
                this.signature(accessor)
                if (!this.eat("SemicolonToken")) this.eat("CommaToken")
                members.push(this.finish(accessor, start))
                continue
            }
            const name = this.propertyName()
            const question = this.at("QuestionToken") ? this.tokenNode() : null
            const method = this.at("OpenParenToken") || this.at("LessThanToken")
            const member = new Node(method ? "MethodSignature" : "PropertySignature", start, start)
                .addAll(modifiers, "modifiers")
                .add(name, "name")
                .add(question, "questionToken")
            if (method) this.signature(member)
            else if (this.eat("ColonToken")) member.add(this.type(), "type")
            // The separator belongs to the member.
            if (!this.eat("SemicolonToken")) this.eat("CommaToken")
            members.push(this.finish(member, start))
            if (this.i === before) this.next()
        }
        this.expect("CloseBraceToken")
        return members
    }
}

/** Whether the string literal from `start` to `end` ends with its quote (not an escaped one). */
function closedString(text: string, start: int, end: int): bool {
    if (end - start < 2 || text[end - 1] !== text[start]) return false
    let backslashes = 0
    while (end - 2 - backslashes > start && text[end - 2 - backslashes] === 92) backslashes++
    return backslashes % 2 === 0
}
