// The syntax tree, in the shape of the TypeScript compiler's: the same node
// kinds (ts.SyntaxKind names), spans, and children in the order of
// ts.forEachChild.

import { type Kind } from "./tokens"

export type NodeKind =
    | Kind
    | "SourceFile"
    /** A list of nodes, used while parsing. */
    | "SyntaxList"
    /** An argument the checker made for one value of a spread tuple, never parsed. */
    | "SpreadPart"
    // Statements
    | "Block"
    | "EmptyStatement"
    | "VariableStatement"
    | "VariableDeclarationList"
    | "VariableDeclaration"
    | "ExpressionStatement"
    | "IfStatement"
    | "DoStatement"
    | "WhileStatement"
    | "ForStatement"
    | "ForInStatement"
    | "ForOfStatement"
    | "ContinueStatement"
    | "BreakStatement"
    | "ReturnStatement"
    | "SwitchStatement"
    | "CaseBlock"
    | "CaseClause"
    | "DefaultClause"
    | "LabeledStatement"
    | "ThrowStatement"
    | "TryStatement"
    | "CatchClause"
    // Declarations
    | "FunctionDeclaration"
    | "ClassDeclaration"
    | "InterfaceDeclaration"
    | "TypeAliasDeclaration"
    | "EnumDeclaration"
    | "EnumMember"
    | "ModuleDeclaration"
    | "ModuleBlock"
    | "ImportDeclaration"
    | "ImportAttributes"
    | "ImportAttribute"
    | "ImportClause"
    | "NamespaceImport"
    | "NamespaceExport"
    | "NamedImports"
    | "ImportSpecifier"
    | "ExportDeclaration"
    | "NamedExports"
    | "ExportSpecifier"
    | "ExportAssignment"
    | "HeritageClause"
    | "ExpressionWithTypeArguments"
    | "Parameter"
    | "IndexSignature"
    | "TypeParameter"
    | "PropertyDeclaration"
    | "MethodDeclaration"
    | "Constructor"
    | "GetAccessor"
    | "SetAccessor"
    | "SemicolonClassElement"
    | "ComputedPropertyName"
    | "ObjectBindingPattern"
    | "ArrayBindingPattern"
    | "BindingElement"
    // Expressions
    | "BinaryExpression"
    | "PrefixUnaryExpression"
    | "PostfixUnaryExpression"
    | "CallExpression"
    | "NewExpression"
    | "PropertyAccessExpression"
    | "ElementAccessExpression"
    | "ParenthesizedExpression"
    | "ArrowFunction"
    | "FunctionExpression"
    | "ObjectLiteralExpression"
    | "PropertyAssignment"
    | "ShorthandPropertyAssignment"
    | "SpreadAssignment"
    | "ArrayLiteralExpression"
    | "SpreadElement"
    | "OmittedExpression"
    | "ConditionalExpression"
    | "NonNullExpression"
    | "AsExpression"
    | "SatisfiesExpression"
    | "TypeOfExpression"
    | "VoidExpression"
    | "DeleteExpression"
    | "AwaitExpression"
    | "TemplateExpression"
    | "TemplateSpan"
    | "TaggedTemplateExpression"
    | "QualifiedName"
    // Types
    | "TypeReference"
    | "ArrayType"
    | "UnionType"
    | "IntersectionType"
    | "LiteralType"
    | "FunctionType"
    | "ConstructorType"
    | "TypeLiteral"
    | "PropertySignature"
    | "MethodSignature"
    | "ParenthesizedType"
    | "TypeQuery"
    | "TypeOperator"
    | "IndexedAccessType"
    | "ConditionalType"
    | "InferType"
    | "MappedType"
    | "TemplateLiteralType"
    | "TemplateLiteralTypeSpan"
    | "TupleType"
    | "GreaterThanGreaterThanToken"
    | "GreaterThanGreaterThanGreaterThanToken"
    | "GreaterThanEqualsToken"
    | "GreaterThanGreaterThanEqualsToken"
    | "GreaterThanGreaterThanGreaterThanEqualsToken"

/**
 * A node of the syntax tree: its kind, its span in bytes, and its children,
 * each with its role: the name of the TypeScript AST property that holds it,
 * since optional children are left out and positions alone do not tell which
 * child is which.
 */
export class Node {
    children: Node[] = []
    /** The role of each child, parallel to `children`; the children of a list share its name. */
    roles: string[] = []
    /** The text of an identifier or a literal, as written. */
    text: string = ""

    constructor(
        readonly kind: NodeKind,
        public start: int,
        public end: int,
    ) {}

    add(child: Node | null, role: string): Node {
        if (child !== null) {
            this.children.push(child)
            this.roles.push(role)
        }
        return this
    }

    addAll(children: Node[], role: string): Node {
        for (const child of children) this.add(child, role)
        return this
    }

    /** The child with a role, or null when it is absent. */
    child(role: string): Node | null {
        for (let i = 0; i < this.children.length; i++) if (this.roles[i] === role) return this.children[i]
        return null
    }

    /** The children with a role, in order. */
    list(role: string): Node[] {
        const found: Node[] = []
        for (let i = 0; i < this.children.length; i++) if (this.roles[i] === role) found.push(this.children[i])
        return found
    }
}

/** Writes a tree in pre-order, one node per line: its kind, start and end. */
export function dump(node: Node, out: string[]) {
    out.push(`${node.kind} ${node.start} ${node.end}`)
    for (const child of node.children) dump(child, out)
}

/** Writes a tree in pre-order, one node per line: its role, kind, start and end. */
export function dumpRoles(node: Node, role: string, out: string[]) {
    out.push(`${role} ${node.kind} ${node.start} ${node.end}`)
    for (let i = 0; i < node.children.length; i++) dumpRoles(node.children[i], node.roles[i], out)
}
