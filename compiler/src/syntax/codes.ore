// The codes of diagnostics. Each message has a code, found by its text:
// a template whose `*` stands for the parts that vary, such as names and
// types. A code keeps its number once given; new messages take new numbers
// at the end of their group. Every code has a page in docs/errors, which
// diagnostics link to.
//
// Groups: 1 syntax, 2 types and constants, 3 expressions, 4 calls and
// built-in functions, 5 classes and interfaces, 6 declarations, functions,
// generics, modules and C, 7 statements.

/**
 * The address of the page of a code: `{code}` is replaced by the code. The
 * documentation is on GitHub for now; `ORE_DOCS` overrides it, with the same
 * `{code}`.
 */
export const docsPattern = "https://github.com/orelang/ore/blob/main/docs/errors/{code}.md"

/** The address of the page of a diagnostic code. */
export function docsUrl(code: string): string {
    const pattern = process.getenv("ORE_DOCS") ?? docsPattern
    return pattern.replaceAll("{code}", code)
}

export class DiagnosticCode {
    constructor(
        readonly code: string,
        /** The message, with `*` for each part that varies. */
        readonly template: string,
    ) {}
}

