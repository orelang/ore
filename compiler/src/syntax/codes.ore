/** Whether a message fits a template: its fixed parts, in order, with anything between them. */
function fits(template: string, message: string): bool {
    const parts = template.split("*")
    if (parts.length === 1) return template === message
    const first = parts[0]
    const last = parts[parts.length - 1]
    if (!message.startsWith(first) || !message.endsWith(last)) return false
    if (message.length < first.length + last.length) return false
    let at = first.length
    const end = message.length - last.length
    for (let i = 1; i < parts.length - 1; i++) {
        const found = message.slice(at, end).indexOf(parts[i])
        if (found < 0) return false
        at += found + parts[i].length
    }
    return true
}

/**
 * The code of a message: of the template it fits with the most fixed text,
 * or "" for none. A message about an instance of a generic ends with where:
 * ` (in 'f<T>')`.
 */
export function codeOf(given: string): string {
    const inside = given.lastIndexOf(" (in '")
    const message = inside > 0 && given.endsWith("')") ? given.slice(0, inside) : given
    let best = ""
    let fixed = -1
    for (const c of diagnosticCodes) {
        if (!fits(c.template, message)) continue
        const length = c.template.length - c.template.split("*").length + 1
        if (length > fixed) {
            best = c.code
            fixed = length
        }
    }
    return best
}
