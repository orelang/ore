// `ore test [--watch] [paths...]`: builds and runs the *.test.ore files below
// the paths (default: "."), and reports which failed; with `--watch`, again
// after each change of the files the test programs are made of (watch.ore).
//
// A test file is a program whose `test(...)` calls (ore:test) run each test
// in its own task and print `✓ name` or `✗ name` and the failure; its
// runtime prints the counts at the end and exits with status 1 if a test
// failed (runtime/core/program.ore and io.ore). The files are built and run
// in parallel, one task per CPU, each building in a child process of this
// same compiler (the checker keeps state that tasks would share); their
// outputs are printed in the order of the files.

import { join, resolve } from "ore:path"
import { toolError } from "./commands"
import { oreFiles } from "./files"
import { executablePath } from "../driver/self"
import { loadProgram, programFiles } from "../project/load"
import { stdout } from "./style"
import { baselineOf, describe, stamps, waitForChange, watched } from "./watch"

/** What building and running a test file printed, and whether it passed. */
class FileResult {
    constructor(
        readonly stdout: string,
        readonly stderr: string,
        readonly passed: bool,
    ) {}
}

export function testCommand(args: string[]): i32 {
    const paths = args.filter((a) => a !== "--watch" && a !== "-w")
    if (paths.length === args.length) return runTests(paths)
    let files: string[] = []
    while (true) {
        const before = stamps(files)
        const status = runTests(paths)
        const tested = testedFiles(paths)
        if (tested.length === 0) return status
        files = watched(tested, files)
        const changed = waitForChange(baselineOf(files, before), null)
        console.error(`[ore] testing again: ${describe(changed)} changed`)
    }
}

/** The files that the test programs below the paths are made of (`programFiles`), each once. */
function testedFiles(paths: string[]): string[] {
    const tests = oreFiles(paths, true)
    if (tests instanceof Error) return []
    const files: string[] = []
    for (const test of tests) {
        const program = loadProgram(test)
        const found: string[] = program instanceof Error ? [resolve(test)] : programFiles(program)
        for (const file of found) if (!files.includes(file)) files.push(file)
    }
    return files
}

/** Builds and runs the test files below the paths, and prints the results. */
function runTests(paths: string[]): i32 {
    const files = oreFiles(paths, true)
    if (files instanceof Error) return toolError(files)
    if (files.length === 0) {
        console.error("ore: no *.test.ore files found")
        return 1
    }
    const ore = executablePath()
    if (ore instanceof Error) return toolError(ore)
    const dir = fs.mkdtemp("ore-test-")
    if (dir instanceof Error) return toolError(dir)

    const results: (FileResult | null)[] = []
    const queue = new Chan<int>(files.length)
    for (let i = 0; i < files.length; i++) {
        results.push(null)
        queue.send(i)
    }
    queue.close()
    const done = new Chan<int>(files.length)
    const workers = Math.max(1, Math.min(files.length, process.cpus()))
    for (let w = 0; w < workers; w++) {
        task.spawn(() => {
            for (const i of queue) {
                results[i] = testFile(ore, files[i], join(dir, `test${i}`))
                done.send(i)
            }
        })
    }

    // Each file's output once it and the files before it are done.
    let failed = 0
    let printed = 0
    for (let n = 0; n < files.length; n++) {
        done.receive()
        for (; printed < files.length; printed++) {
            const result = results[printed]
            if (result === null) break
            console.log(files[printed])
            console.write(styledMarks(result.stdout))
            if (result.stderr !== "") console.error(result.stderr.trimEnd())
            if (!result.passed) failed++
        }
    }
    fs.remove(dir, true)
    console.log(
        failed === 0
            ? `\n${stdout.success(`All ${files.length} test file(s) passed.`)}`
            : `\n${stdout.error(`${failed} of ${files.length} test file(s) failed.`)}`,
    )
    return failed === 0 ? 0 : 1
}

/** A test program's output with its marks in color, `✓` in the success color and `✗` in the error color, when stdout shows colors. */
function styledMarks(output: string): string {
    if (!stdout.enabled) return output
    const lines: string[] = []
    for (const line of output.split("\n")) {
        if (line.startsWith("  ✓ ")) lines.push(`  ${stdout.success("✓")}${line.slice("  ✓".length)}`)
        else if (line.startsWith("  ✗ ")) lines.push(`  ${stdout.error("✗")}${line.slice("  ✗".length)}`)
        else lines.push(line)
    }
    return lines.join("\n")
}

/** Builds a test file into `output` with `ore build`, and runs it. */
function testFile(ore: string, file: string, output: string): FileResult {
    const built = process.output(ore, ["build", file, "-o", output])
    if (built instanceof Error) return new FileResult("", `ore: ${built.message}`, false)
    if (!built.ok) return new FileResult(built.stdout, built.stderr, false)
    const ran = process.output(output)
    if (ran instanceof Error) return new FileResult("", `${built.stderr}ore: ${ran.message}`, false)
    return new FileResult(ran.stdout, `${built.stderr}${ran.stderr}`, ran.ok)
}
