// `ore lock [file.ore] [--update [repos...]] [--frozen] [--offline]`: the
// program's ore.lock (project/lock.ore). It loads the program as a build
// does: the repositories the lock has are downloaded at their commits when
// the cache does not have them, and their files checked against the locked
// hashes; those it does not have are added. With `--update`, it first moves
// the locked repositories, or those named, to the commits their branches
// are at now.

import { entry, lockOption, report, toolError, usageError } from "./commands"
import { loadProgram, lockPath } from "../project/load"
import { lockSettings, readLock } from "../project/lock"
import { settings as remoteSettings } from "../project/remote"

/** `ore lock [file.ore] [--update [repos...]] [--frozen] [--offline]` */
export function lockCommand(args: string[]): i32 {
    let update = false
    const repositories: string[] = []
    const positionals: string[] = []
    for (const arg of args) {
        if (arg === "--update") update = true
        else if (lockOption(arg)) continue
        else if (arg.startsWith("-")) return usageError(`unknown option '${arg}'`)
        else if (update && !arg.endsWith(".ore")) repositories.push(arg)
        else positionals.push(arg)
    }
    if (!update && repositories.length > 0) return usageError(`unexpected arguments: ${repositories.join(" ")}`)
    if (update && remoteSettings.offline)
        return usageError("--update asks GitHub for new commits: it cannot be --offline")
    if (update && lockSettings.frozen) return usageError("--update changes ore.lock: it cannot be --frozen")
    const target = entry(positionals)
    if (target === null) return 2
    if (target.args.length > 0) return usageError(`unexpected arguments: ${target.args.join(" ")}`)
    const path = lockPath(target.file)
    if (update) {
        const status = updateLock(path, repositories)
        if (status !== 0) return status
    }
    const program = loadProgram(target.file)
    if (program instanceof Error) return toolError(program)
    report(program.diagnostics)
    for (const d of program.diagnostics) if (d.severity === "error") return 1
    const lock = readLock(path)
    if (lock instanceof Error) return toolError(lock)
    if (!fs.exists(path)) console.log("The program imports nothing from GitHub: there is nothing to lock.")
    else console.log(`${path}: ${lock.entries.size} ${lock.entries.size === 1 ? "repository" : "repositories"} locked.`)
    return 0
}

/** Moves the repositories of a lock file, all or those named, to the commits their branches are at now, and writes it. */
function updateLock(path: string, named: string[]): i32 {
    const lock = readLock(path)
    if (lock instanceof Error) return toolError(lock)
    const moved = lock.update(named)
    if (moved instanceof Error) return toolError(moved)
    for (const line of moved) console.log(line)
    const written = lock.write()
    return written === null ? 0 : toolError(written)
}
