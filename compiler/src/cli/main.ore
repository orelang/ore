// The `ore` command: run, build, check, init, test, fmt, doc, cache, lsp, version, help.

import { serve } from "../lsp/server"
import { cacheCommand } from "./cache"
import { buildCommand, checkCommand, initCommand, runCommand } from "./commands"
import { docCommand } from "./doc"
import { fmtCommand } from "./fmt"
import { stderr, stdout, Style } from "./style"
import { testCommand } from "./test"
import { updateCommand } from "./update"
import packageText from "../../package.json" with { type: "text" }

class Package {
    constructor(readonly version: string) {}
}

/** The version of `ore`: that of compiler/package.json, read when the compiler is built. */
function packageVersion(): string {
    const parsed = JSON.parse<Package>(packageText)
    return parsed instanceof Error ? "unknown" : parsed.version
}

export const version = packageVersion()

export const usage = `Ore ${version}

Usage:
  ore run [file.ore] [args...]   Build and run a program
      -w, --watch                Run it again when its files change (before the file)
  ore build [file.ore]           Build a native binary
      -o, --output <path>        Output path (default: package name or file name)
      --release                  Optimize instead of building with debug info
      --emit-llvm <path>         Also write the generated LLVM IR
      --time                     Print how long each step takes
      -w, --watch                Build it again when its files change
  ore check [file.ore | dirs...] Report errors without building
  ore test [paths...]            Run the tests in *.test.ore files (default: all below .)
      -w, --watch                Run them again when their files change
  ore fmt [--check] [paths...]   Format .ore files in place, or list unformatted ones
      --stdout                   Print the formatted files instead
  ore doc [file.ore | dirs...]   Print the API of modules: their exports and JSDoc
      --md                       As Markdown (with -o <dir>: a file per module and index.md)
      --json                     As JSON (with -o <file>: into the file)
  ore init [directory]           Create a project: package.json and src/main.ore
  ore cache [clean]              Print the size of the build cache, or empty it
  ore lsp                        Start the language server on stdio
  ore update [--force]           Update ore to its latest release

Without a file, the program is the 'main' of the nearest package.json.
  ore version                    Print the version
  ore help                       Print this help
`

/** The usage with its headings in bold and the commands in the accent color, when the stream shows colors. */
function styledUsage(style: Style): string {
    if (!style.enabled) return usage
    const lines: string[] = []
    for (const line of usage.split("\n")) {
        if (line.startsWith("  ore ")) {
            const space = line.indexOf(" ", 6)
            const end = space < 0 ? line.length : space
            lines.push(`  ${style.accent(line.slice(2, end))}${line.slice(end)}`)
        } else if (line.startsWith("Ore ") || line.endsWith(":")) lines.push(style.bold(line))
        else lines.push(line)
    }
    return lines.join("\n")
}

/** Runs the command of the command line; returns the exit status. */
export function main(args: string[]): i32 {
    const command = args.length > 0 ? args[0] : ""
    const rest = args.slice(1)
    switch (command) {
        case "run":
            return runCommand(rest)
        case "build":
            return buildCommand(rest)
        case "check":
            return checkCommand(rest)
        case "init":
            return initCommand(rest)
        case "test":
            return testCommand(rest)
        case "fmt":
            return fmtCommand(rest)
        case "doc":
            return docCommand(rest)
        case "cache":
            return cacheCommand(rest)
        case "lsp":
            return i32(serve(version))
        case "update":
            return updateCommand(rest)
        case "version":
        case "--version":
            console.log(version)
            return 0
        case "":
        case "help":
        case "--help":
        case "-h":
            console.write(styledUsage(stdout))
            return 0
    }
    console.error(`ore: unknown command '${command}'\n\n${styledUsage(stderr).trimEnd()}`)
    return 2
}
