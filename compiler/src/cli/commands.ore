// `ore build`, `ore run`, `ore check` and `ore init`, with these exit
// statuses: 0 success, 1 errors in the program or a failing tool, 2 a wrong
// command line. Builds take LLVM's objects from the build cache when it has
// them (driver/cache.ore).

import { basename, join, resolve } from "ore:path"
import { check } from "../checker/checker"
import { build, BuildOptions } from "../driver/build"
import { loadProgram } from "../project/load"
import { lockSettings } from "../project/lock"
import { settings as remoteSettings } from "../project/remote"
import { findPackageRoot, readPackageJson } from "../project/resolve"
import { type Diagnostic, formatDiagnostic } from "../syntax/diagnostic"
import { oreFiles } from "./files"
import { styledDiagnostic } from "./style"
import { watch } from "./watch"

/** The program to build: its entry file, the name of its executable, and the arguments for it. */
export class Entry {
    constructor(
        readonly file: string,
        readonly name: string,
        readonly args: string[],
    ) {}
}

/**
 * The program to build: a `.ore` file given first, or else the `main` of
 * the nearest package.json. The other arguments are for the program. Null,
 * after explaining why on stderr, when there is neither.
 */
export function entry(positionals: string[]): Entry | null {
    if (positionals.length > 0 && positionals[0].endsWith(".ore")) {
        const file = positionals[0]
        return new Entry(file, basename(file, ".ore"), positionals.slice(1))
    }
    const root = findPackageRoot(process.cwd())
    const json = root === null ? null : readPackageJson(root)
    if (json instanceof Error) {
        console.error(`ore: ${json.message}`)
        return null
    }
    const main = json === null ? null : json.main
    if (root === null || json === null || main === null || main === "") {
        console.error("ore: give a .ore file, or run in a project whose package.json has a 'main' (see 'ore init')")
        return null
    }
    let name = json.name ?? basename(main, ".ore")
    // A scoped package's name without its scope: "@scope/app" is "app".
    if (name.startsWith("@") && name.includes("/")) name = name.slice(name.lastIndexOf("/") + 1)
    return new Entry(join(root, main), name, positionals)
}

/** Prints diagnostics to stderr. */
export function report(diagnostics: Diagnostic[]): void {
    for (const d of diagnostics) console.error(styledDiagnostic(d))
}

/** A wrong command line: the message on stderr, status 2. */
export function usageError(message: string): i32 {
    console.error(`ore: ${message}`)
    return 2
}

/** A file that cannot be read or written, or a tool that fails: the message on stderr, status 1. */
export function toolError(error: Error): i32 {
    console.error(`ore: ${error.message}`)
    return 1
}

/**
 * Takes an option of the imports from GitHub: `--frozen`, which fails
 * instead of adding a repository to ore.lock (project/lock.ore), or
 * `--offline`, which never downloads (project/remote.ore). Whether `arg` is
 * one of them.
 */
export function lockOption(arg: string): bool {
    if (arg === "--frozen") lockSettings.frozen = true
    else if (arg === "--offline") remoteSettings.offline = true
    else return false
    return true
}

/** The options `lockOption` took, for an `ore build` in a child process. */
export function lockOptions(): string[] {
    const options: string[] = []
    if (lockSettings.frozen) options.push("--frozen")
    if (remoteSettings.offline) options.push("--offline")
    return options
}

/** `ore build [file.ore] [-o out] [--release] [--emit-llvm file.ll] [--time] [--watch] [--frozen] [--offline]` */
export function buildCommand(args: string[]): i32 {
    let output = ""
    let release = false
    let emitLlvm = ""
    let times = false
    let watching = false
    const positionals: string[] = []
    for (let i = 0; i < args.length; i++) {
        const arg = args[i]
        if (arg === "--release") release = true
        else if (arg === "--watch" || arg === "-w") watching = true
        else if (arg === "--time") times = true
        else if (lockOption(arg)) continue
        else if (arg.startsWith("--output=")) output = arg.slice(9)
        else if (arg.startsWith("--emit-llvm=")) emitLlvm = arg.slice(12)
        else if (arg === "-o" || arg === "--output" || arg === "--emit-llvm") {
            if (i + 1 >= args.length) return usageError(`option ${arg} needs a value`)
            i++
            if (arg === "--emit-llvm") emitLlvm = args[i]
            else output = args[i]
        } else if (arg === "--") {
            for (const rest of args.slice(i + 1)) positionals.push(rest)
            break
        } else if (arg.startsWith("-") && arg !== "-") return usageError(`unknown option '${arg}'`)
        else positionals.push(arg)
    }
    const target = entry(positionals)
    if (target === null) return 2
    if (target.args.length > 0) return usageError(`unexpected arguments: ${target.args.join(" ")}`)
    const options = new BuildOptions(output !== "" ? output : target.name, release, emitLlvm, times)
    if (watching) return watch(target.file, options, [], false)
    const result = build(target.file, options)
    if (result instanceof Error) return toolError(result)
    report(result.diagnostics)
    return result.ok ? 0 : 1
}

/**
 * `ore run [--watch] [--frozen] [--offline] [file.ore] [args...]`: builds
 * into a temporary directory and runs the program with this process's
 * stdio; with `--watch`, again after each change of its files. The options
 * come before the file; those after it are the program's.
 */
export function runCommand(args: string[]): i32 {
    let watching = false
    let start = 0
    for (; start < args.length; start++) {
        const arg = args[start]
        if (arg === "--watch" || arg === "-w") watching = true
        else if (!lockOption(arg)) break
    }
    const target = entry(args.slice(start))
    if (target === null) return 2
    const dir = fs.mkdtemp("ore-run-")
    if (dir instanceof Error) return toolError(dir)
    if (watching) return watch(target.file, new BuildOptions(join(dir, target.name)), target.args, true)
    const status = buildAndRun(target, join(dir, target.name))
    fs.remove(dir, true)
    return status
}

function buildAndRun(target: Entry, output: string): i32 {
    const result = build(target.file, new BuildOptions(output))
    if (result instanceof Error) return toolError(result)
    report(result.diagnostics)
    if (!result.ok) return 1
    const status = process.run(output, target.args)
    if (status instanceof Error) return toolError(status)
    return i32(status)
}

/**
 * `ore check [--frozen] [--offline] [file.ore | paths...]`: reports errors
 * without building. Given directories (or several files), it checks each
 * `.ore` file in them as the entry of a program, except the files that a
 * program checked before already loaded, and reports each diagnostic once.
 */
export function checkCommand(given: string[]): i32 {
    const args: string[] = []
    for (const arg of given) if (!lockOption(arg)) args.push(arg)
    const paths = args.length > 0 && args.every((a) => a.endsWith(".ore") || fs.isDir(a))
    if (paths && (args.length > 1 || fs.isDir(args[0]))) return checkPaths(args)
    const target = entry(args)
    if (target === null) return 2
    if (target.args.length > 0) return usageError(`unexpected arguments: ${target.args.join(" ")}`)
    const diagnostics = checkProgram(target.file)
    if (diagnostics instanceof Error) return toolError(diagnostics)
    report(diagnostics)
    return hasErrors(diagnostics) ? 1 : 0
}

/** The diagnostics of a program: the loader's, then, without syntax errors, the checker's. */
function checkProgram(file: string, loaded: Set<string> | null = null): Diagnostic[] | Error {
    const program = loadProgram(file)
    if (program instanceof Error) return program
    if (loaded !== null)
        for (const source of program.modules) if (!source.path.startsWith("ore:")) loaded.add(resolve(source.path))
    const diagnostics = program.diagnostics.slice()
    if (!program.syntaxErrors) for (const d of check(program).diagnostics) diagnostics.push(d)
    return diagnostics
}

function checkPaths(paths: string[]): i32 {
    const files = oreFiles(paths)
    if (files instanceof Error) return toolError(files)
    const loaded = new Set<string>()
    const reported = new Set<string>()
    let errors = false
    for (const file of files) {
        if (loaded.has(resolve(file))) continue
        const diagnostics = checkProgram(file, loaded)
        if (diagnostics instanceof Error) return toolError(diagnostics)
        for (const d of diagnostics) {
            const text = formatDiagnostic(d)
            if (reported.has(text)) continue
            reported.add(text)
            console.error(styledDiagnostic(d))
            if (d.severity === "error") errors = true
        }
    }
    return errors ? 1 : 0
}

function hasErrors(diagnostics: Diagnostic[]): bool {
    for (const d of diagnostics) if (d.severity === "error") return true
    return false
}

/** `ore init [directory]`: a package.json with a `main`, and src/main.ore. */
export function initCommand(args: string[]): i32 {
    const dir = resolve(args.length > 0 ? args[0] : ".")
    const manifest = join(dir, "package.json")
    if (fs.exists(manifest)) return usageError(`${manifest} already exists`)
    const name = packageName(basename(dir))
    const made = fs.mkdir(join(dir, "src"), true)
    if (made !== null) return toolError(made)
    const json = `{\n  "name": "${name}",\n  "version": "0.1.0",\n  "private": true,\n  "main": "src/main.ore"\n}\n`
    const written = fs.writeFile(manifest, json)
    if (written !== null) return toolError(written)
    const main = join(dir, "src/main.ore")
    if (!fs.exists(main)) {
        const error = fs.writeFile(main, `console.log("hello, ${name}")\n`)
        if (error !== null) return toolError(error)
    }
    console.log(`Created ${name} in ${dir}. Run it with 'ore run'.`)
    return 0
}

/**
 * A package name from a directory's name: lowercase, with a "-" for each
 * UTF-16 code unit of a character other than a-z, 0-9, ".", "_" and "-", as
 * `name.toLowerCase().replace(/[^a-z0-9._-]/g, "-")` in JavaScript.
 */
function packageName(dir: string): string {
    let name = ""
    for (const r of dir.toLowerCase()) {
        const ok = (r >= 0x61 && r <= 0x7a) || (r >= 0x30 && r <= 0x39) || r === 0x2e || r === 0x5f || r === 0x2d
        if (ok) name += String.fromCodePoint(i64(r))
        else name += r > 0xffff ? "--" : "-"
    }
    return name
}
