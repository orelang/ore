// Definite assignment; see compiler/checker/src/assigned.ts.

import { type Block, type Expr, type Local, type Stmt } from "../ir/nodes"

/**
 * Definite assignment: reports reads of variables that may not be assigned
 * yet. A variable declared without a value and with a type that has no zero
 * value (a class, an object or an interface) must be assigned on every path
 * before it is read. A closure that captures such a variable reads it when
 * it is created, since it may run at any time after.
 *
 * The analysis walks the structured IR of one function with the set of
 * variables certainly assigned so far. Branches meet with the intersection of
 * their sets; code after `return`, `break`, `continue` or a call that never
 * returns is unreachable (no set). A loop body may not run, and the right
 * operand of `&&`, `||` and `??` may not be evaluated, so their assignments
 * do not count after them.
 */
export function checkAssigned(body: Block, tracked: Map<Local, bool>, report: (local: Local, at: Expr) => void) {
    new Flow(tracked, report).block(body.body, new LocalSet())
}

/** A set of locals: `Set<ir.Local>` in TypeScript. */
export class LocalSet {
    readonly locals = new Map<Local, bool>()

    has(local: Local): bool {
        return this.locals.has(local)
    }

    add(local: Local) {
        this.locals.set(local, true)
    }

    delete(local: Local) {
        this.locals.delete(local)
    }

    copy(): LocalSet {
        const s = new LocalSet()
        for (const [local, _] of this.locals) s.add(local)
        return s
    }
}

/** The variables certainly assigned at a point, or null where control cannot reach. */
type State = LocalSet | null

function join(a: State, b: State): State {
    if (a === null) return b
    if (b === null) return a
    const s = new LocalSet()
    for (const [local, _] of a.locals) if (b.has(local)) s.add(local)
    return s
}

function copy(s: State): State {
    return s === null ? null : s.copy()
}

/** A loop or switch around the current statement. */
class Target {
    constructor(
        readonly id: int,
        readonly loop: bool,
    ) {}
}

/** The end state of a loop or switch body and the states at its `break` and `continue` statements. */
class Within {
    constructor(
        readonly end: State,
        readonly breaks: State,
        readonly continues: State,
    ) {}
}

class Flow {
    /** Tracked variables declared in this function; others belong to enclosing functions. */
    private declared = new LocalSet()
    private reported = new LocalSet()
    /** States at the `break` and `continue` statements of each loop or switch, by id. */
    private breaks = new Map<int, State>()
    private continues = new Map<int, State>()
    /** Loops and switches around the current statement, innermost last. */
    private targets: Target[] = []

    constructor(
        private tracked: Map<Local, bool>,
        private report: (local: Local, at: Expr) => void,
    ) {}

    block(stmts: Stmt[], s: State): State {
        let state = s
        for (const stmt of stmts) state = this.stmt(stmt, state)
        return state
    }

    private read(local: Local, at: Expr, s: State) {
        if (s === null || !this.declared.has(local) || s.has(local) || this.reported.has(local)) return
        this.reported.add(local)
        this.report(local, at)
    }

    private enter(id: int, loop: bool) {
        this.targets.push(new Target(id, loop))
        this.breaks.set(id, null)
        this.continues.set(id, null)
    }

    /** The end state of the loop or switch `id` and its break and continue states, after its body. */
    private leave(id: int, end: State): Within {
        this.targets.pop()
        return new Within(end, this.breaks.get(id), this.continues.get(id))
    }

    private stmt(st: Stmt, s: State): State {
        if (s === null) return null
        switch (st.k) {
            case "block":
                return this.block(st.body, s)
            case "let": {
                const init = st.init
                if (init !== null) {
                    const after = this.expr(init, s)
                    if (after !== null) after.add(st.local)
                    return after
                }
                if (this.tracked.has(st.local)) {
                    // Declared again on each pass through a loop.
                    this.declared.add(st.local)
                    s.delete(st.local)
                }
                return s
            }
            case "expr": {
                const after = this.expr(st.expr, s)
                return st.expr.type.kind === "never" ? null : after
            }
            case "if": {
                const after = this.expr(st.cond, s)
                const then = this.stmt(st.then, copy(after))
                const otherwise = st.else
                const other = otherwise !== null ? this.stmt(otherwise, copy(after)) : after
                return join(then, other)
            }
            case "loop": {
                const cond = st.cond
                const forever = cond === null || (cond.k === "bool" && cond.value)
                if (st.condAfter) {
                    // `do ... while (cond)`: the body runs at least once.
                    this.enter(st.id, true)
                    const inner = this.leave(st.id, this.stmt(st.body, s))
                    const beforeCond = join(inner.end, inner.continues)
                    const after = beforeCond === null || cond === null ? null : this.expr(cond, beforeCond)
                    return join(forever ? null : after, inner.breaks)
                }
                const entry = forever || cond === null ? s : this.expr(cond, s)
                this.enter(st.id, true)
                const inner = this.leave(st.id, this.stmt(st.body, copy(entry)))
                const beforeUpdate = join(inner.end, inner.continues)
                const update = st.update
                if (update !== null && beforeUpdate !== null) this.expr(update, beforeUpdate)
                return join(forever ? null : entry, inner.breaks)
            }
            case "for-of": {
                const after = this.expr(st.iterable, s)
                this.enter(st.id, true)
                const inner = this.leave(st.id, this.stmt(st.body, copy(after)))
                return join(after, inner.breaks)
            }
            case "switch": {
                const selected = this.expr(st.value, s)
                for (const clause of st.clauses) {
                    const test = clause.test
                    if (test !== null) this.expr(test, copy(selected))
                }
                this.enter(st.id, false)
                // Each clause is entered by a match or by falling through the one before.
                let current: State = null
                for (const clause of st.clauses) current = this.block(clause.body, join(current, copy(selected)))
                const inner = this.leave(st.id, current)
                let hasDefault = false
                for (const c of st.clauses) if (c.test === null) hasDefault = true
                const unmatched = st.exhaustive || hasDefault ? null : selected
                return join(join(inner.end, inner.breaks), unmatched)
            }
            case "using": {
                let after = this.expr(st.init, s)
                if (after !== null) after.add(st.local)
                after = this.block(st.body, after)
                return after === null ? null : this.stmt(st.dispose, after)
            }
            case "break":
            case "continue": {
                const target = this.targetOf(st.k === "break", st.target)
                if (target !== null) {
                    const states = st.k === "break" ? this.breaks : this.continues
                    states.set(target.id, join(states.get(target.id), copy(s)))
                }
                return null
            }
            case "return": {
                const value = st.value
                if (value !== null) this.expr(value, s)
                return null
            }
        }
    }

    /** The loop or switch a `break` or `continue` leaves. */
    private targetOf(isBreak: bool, id: int | null): Target | null {
        if (id !== null) {
            for (const t of this.targets) if (t.id === id) return t
            return null
        }
        for (let i = this.targets.length - 1; i >= 0; i--) {
            const t = this.targets[i]
            if (isBreak || t.loop) return t
        }
        return null
    }

    /** The state after evaluating an expression, reporting reads of unassigned variables. */
    private expr(e: Expr, s: State): State {
        if (s === null) return null
        switch (e.k) {
            case "local":
                this.read(e.local, e, s)
                return s
            case "assign": {
                const target = e.target
                let after: State = s
                if (target.k === "field") after = this.expr(target.object, after)
                else if (target.k === "element") after = this.expr(target.index, this.expr(target.array, after))
                else if (target.k === "iface-field") after = this.expr(target.value, after)
                after = this.expr(e.value, after)
                if (target.k === "local" && after !== null) after.add(target.local)
                return after
            }
            case "incdec": {
                const target = e.target
                if (target.k === "local") {
                    this.read(target.local, e, s)
                    return s
                }
                if (target.k === "field") return this.expr(target.object, s)
                if (target.k === "element") return this.expr(target.index, this.expr(target.array, s))
                return this.expr(target.value, s)
            }
            case "logical": {
                const after = this.expr(e.left, s)
                this.expr(e.right, copy(after))
                return after
            }
            case "coalesce": {
                const after = this.expr(e.value, s)
                this.expr(e.fallback, copy(after))
                return after
            }
            case "optional": {
                const after = this.expr(e.value, s)
                if (after !== null) after.add(e.binding)
                this.expr(e.body, copy(after))
                return after
            }
            case "cond": {
                const after = this.expr(e.cond, s)
                return join(this.expr(e.then, copy(after)), this.expr(e.else, copy(after)))
            }
            case "closure": {
                const captures = e.func.captures
                if (captures !== null) for (const c of captures) this.read(c, e, s)
                return s
            }
            case "bind": {
                let after: State = s
                for (const b of e.locals) {
                    after = this.expr(b.init, after)
                    if (after !== null) after.add(b.local)
                }
                return this.expr(e.body, after)
            }
            default: {
                let after: State = s
                for (const child of children(e)) after = this.expr(child, after)
                return after
            }
        }
    }
}

function withOptional(first: Expr, rest: (Expr | null)[]): Expr[] {
    const out: Expr[] = [first]
    for (const e of rest) if (e !== null) out.push(e)
    return out
}

function concat(first: Expr, rest: Expr[]): Expr[] {
    const out: Expr[] = [first]
    for (const e of rest) out.push(e)
    return out
}

/** The subexpressions of an expression in evaluation order, for those without a rule of their own. */
function children(e: Expr): Expr[] {
    switch (e.k) {
        case "arith":
        case "compare":
            return [e.left, e.right]
        case "unary":
        case "not":
            return [e.operand]
        case "convert":
        case "len":
        case "recast":
        case "is-null":
        case "union-field":
        case "typeof":
        case "is":
        case "downcast":
        case "to-iface":
        case "iface-field":
            return [e.value]
        case "call":
        case "builtin":
            return e.args
        case "concat":
            return e.parts
        case "index":
            return [e.target, e.index]
        case "slice":
            return withOptional(e.value, [e.start, e.end])
        case "array":
            return e.elems
        case "push":
            return concat(e.array, e.values)
        case "pop":
            return [e.array]
        case "object": {
            const values: Expr[] = []
            for (const f of e.fields) values.push(f.value)
            return values
        }
        case "field":
            return [e.object]
        case "method-call":
            return concat(e.receiver, e.args)
        case "iface-call":
            return concat(e.value, e.args)
        case "map": {
            const out: Expr[] = []
            const map = e.map
            if (map !== null) out.push(map)
            const key = e.key
            if (key !== null) out.push(key)
            const value = e.value
            if (value !== null) out.push(value)
            return out
        }
        case "call-value":
            return concat(e.callee, e.args)
        case "bound-method":
            return [e.receiver]
        case "array-method":
            return concat(e.array, e.args)
        case "string-method":
            return concat(e.value, e.args)
        case "chan": {
            const out: Expr[] = []
            const chan = e.chan
            if (chan !== null) out.push(chan)
            const value = e.value
            if (value !== null) out.push(value)
            const handler = e.handler
            if (handler !== null) out.push(handler)
            return out
        }
        case "seq":
            return e.exprs
        default:
            return []
    }
}
