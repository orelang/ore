// The modes of the compiler that the test harness compares with the
// TypeScript compiler (tests/harness/next.test.ts, build-next.test.ts): they
// print what a stage makes of a file, and go once the TypeScript compiler
// is gone.
//
//   ore tokens <file.ore>    one token per line: kind, start and end byte
//   ore tree <file.ore>      the syntax tree in pre-order: kind, start and end byte
//   ore roles <file.ore>     the same, each node after its role in its parent ("-" for the root)
//   ore modules <entry.ore>  the modules of the program in load order, each with its
//                            imports ("import <specifier> <module>") and text imports
//                            ("text <specifier> <bytes>"), then the diagnostics
//   ore ir <entry.ore>       the IR of the checked program (`dump` of ir/dump.ore), or
//                            its diagnostics on stderr with status 1
//   ore read <dump.txt>      reads the dump of an IR module (compiler/ir/src/dump.ts) and
//                            writes it again: the round trip of ir/read.ore
//   ore llvm <dump.txt> [--debug]
//                            the LLVM IR of the module of a dump, from opt/ and llvm/:
//                            inlined unless --debug, which keeps frames for stack traces
//   ore object <in.ll> [<src.c> ...] -o <out> [--release] [-c] [-l lib] [-L dir] [--time]
//                            an executable from LLVM IR: compiled through LLVM's C API,
//                            with the C sources and libraries, linked with lld; with -c,
//                            only the IR's object file
//
// `ore fmt --stdout <file.ore>` prints a file formatted (cli/fmt.ore).

import { check } from "../checker/checker"
import { BuildOptions, buildIr } from "../driver/build"
import { targetTriple } from "../driver/link"
import { NativeCode } from "../driver/native"
import { dump as dumpModule } from "../ir/dump"
import { readModule } from "../ir/read"
import { emitModule, EmitOptions } from "../llvm/emit"
import { emitObject, ObjectOptions } from "../llvm/object"
import { loadProgram } from "../project/load"
import { dump, dumpRoles } from "../syntax/ast"
import { formatDiagnostic } from "../syntax/diagnostic"
import { tokenize } from "../syntax/lexer"
import { parse } from "../syntax/parser"

/** Whether a command is one of the oracle modes. */
export function isOracle(command: string): bool {
    return ["tokens", "tree", "roles", "modules", "ir", "read", "llvm", "object"].includes(command)
}

/** Runs an oracle mode with its arguments; returns the exit status. */
export function oracle(mode: string, args: string[]): i32 {
    if (mode === "object") return objectCommand(args)
    const llvm = mode === "llvm" && (args.length === 1 || (args.length === 2 && args[1] === "--debug"))
    if (!llvm && args.length !== 1) {
        console.error(
            "usage: ore tokens|tree|roles|modules|ir <file.ore> | ore read <dump.txt> | ore llvm <dump.txt> [--debug]",
        )
        return 2
    }
    const path = args[0]
    if (mode === "read" || mode === "llvm") {
        const text = fs.readFile(path)
        if (text instanceof Error) return fail(text)
        const module = readModule(text)
        if (module instanceof Error) return fail(module)
        if (mode === "read") console.write(dumpModule(module))
        else console.write(emitModule(module, new EmitOptions(args.length === 2)))
        return 0
    }
    if (mode === "ir") {
        const program = loadProgram(path)
        if (program instanceof Error) return fail(program)
        // As the driver does: the loader's diagnostics, then the checker's.
        const diagnostics = program.diagnostics.slice()
        const checked = program.syntaxErrors ? null : check(program)
        if (checked !== null) for (const d of checked.diagnostics) diagnostics.push(d)
        const module = checked !== null ? checked.module : null
        if (module === null || program.diagnostics.length > 0) {
            for (const d of diagnostics) console.error(formatDiagnostic(d))
            return 1
        }
        console.write(dumpModule(module))
        return 0
    }
    if (mode === "modules") {
        const program = loadProgram(path)
        if (program instanceof Error) return fail(program)
        for (const source of program.modules) {
            console.log(source.path)
            const imports = program.imports.get(source)
            if (imports !== null)
                for (const [specifier, target] of imports) console.log("  import", specifier, target.path)
            const texts = program.texts.get(source)
            if (texts !== null) for (const [specifier, text] of texts) console.log("  text", specifier, text.length)
        }
        for (const d of program.diagnostics) console.log(formatDiagnostic(d))
        return 0
    }
    const text = fs.readFile(path)
    if (text instanceof Error) return fail(text)
    if (mode === "tokens") {
        for (const token of tokenize(text)) console.log(token.kind, token.start, token.end)
        return 0
    }
    const parser = parse(text)
    for (const error of parser.errors) console.error(error)
    const lines: string[] = []
    if (parser.file !== null) {
        if (mode === "roles") dumpRoles(parser.file, "-", lines)
        else dump(parser.file, lines)
    }
    for (const line of lines) console.log(line)
    return parser.errors.length > 0 ? 1 : 0
}

function fail(error: Error): i32 {
    console.error(error.message)
    return 1
}

/** The arguments of `ore object`: the files, and the flags (`-o out`, `-l lib`, `-L dir`, `--release`...). */
class ObjectArgs {
    files: string[] = []
    output = ""
    release = false
    objectOnly = false
    times = false
    native = new NativeCode()
}

function parseObjectArgs(args: string[]): ObjectArgs | Error {
    const parsed = new ObjectArgs()
    for (let i = 0; i < args.length; i++) {
        const arg = args[i]
        if (arg === "--release") parsed.release = true
        else if (arg === "--time") parsed.times = true
        else if (arg === "-c") parsed.objectOnly = true
        else if (arg === "-o" || arg === "-l" || arg === "-L") {
            if (i + 1 >= args.length) return new Error(`${arg} needs a value`)
            i++
            const value = args[i]
            if (arg === "-o") parsed.output = value
            else if (arg === "-l") parsed.native.link.push(value)
            else parsed.native.libDirs.push(value)
        } else if (arg.startsWith("-")) return new Error(`unknown option ${arg}`)
        else parsed.files.push(arg)
    }
    if (parsed.output === "") return new Error("no output: -o <file>")
    return parsed
}

function objectCommand(args: string[]): i32 {
    const parsed = parseObjectArgs(args)
    const none: string[] = []
    const ll = parsed instanceof Error ? none : parsed.files.filter((f) => f.endsWith(".ll"))
    if (parsed instanceof Error || ll.length !== 1) {
        if (parsed instanceof Error) console.error(parsed.message)
        console.error("usage: ore object <in.ll> [<src.c> ...] -o <out> [--release] [-c] [-l lib] [-L dir] [--time]")
        return 2
    }
    for (const file of parsed.files) if (!file.endsWith(".ll")) parsed.native.sources.push(file)
    const ir = fs.readFile(ll[0])
    if (ir instanceof Error) return fail(ir)
    const options = new BuildOptions(parsed.output, parsed.release, "", parsed.times)
    const error = parsed.objectOnly
        ? emitObject(ir, new ObjectOptions(parsed.output, parsed.release, targetTriple(), ll[0]))
        : buildIr(ir, ll[0], parsed.native, options)
    if (error instanceof Error) return fail(error)
    return 0
}
