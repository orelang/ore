keywords.set("accessor", "AccessorKeyword")
keywords.set("as", "AsKeyword")
keywords.set("asserts", "AssertsKeyword")
keywords.set("assert", "AssertKeyword")
keywords.set("any", "AnyKeyword")
keywords.set("async", "AsyncKeyword")
keywords.set("await", "AwaitKeyword")
keywords.set("boolean", "BooleanKeyword")
