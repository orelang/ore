keywords.set("unique", "UniqueKeyword")
keywords.set("unknown", "UnknownKeyword")
keywords.set("using", "UsingKeyword")
keywords.set("from", "FromKeyword")
keywords.set("global", "GlobalKeyword")
keywords.set("bigint", "BigIntKeyword")
