// The canonical text of an IR module, in the format of compiler/ir/src/dump.ts
// (described there): the IR built by the checker written in Ore must dump to
// the same text as the IR of the TypeScript checker.

import { type Expr, type Func, type Local, type LValue, type Module, type Stmt } from "./nodes"
import { type InterfaceType, type StructType, type Type } from "./types"

/** The canonical text of a module: one node per line, children indented under their parent. */
export function dump(module: Module): string {
    return new Dumper().module(module)
}

const hexDigits = "0123456789abcdef"

/** A string in double quotes: `"` and `\` escaped, `\n`, `\r`, `\t`, other control characters as `\u00XX`. */
export function quote(s: string): string {
    let out = "\""
    let start = 0
    for (let i = 0; i < s.length; i++) {
        const c = s[i]
        let escape = ""
        if (c === 0x22) escape = "\\\""
        else if (c === 0x5c) escape = "\\\\"
        else if (c === 0x0a) escape = "\\n"
        else if (c === 0x0d) escape = "\\r"
        else if (c === 0x09) escape = "\\t"
        else if (c < 0x20) escape = `\\u00${hexDigits.slice(c >> 4, (c >> 4) + 1)}${hexDigits.slice(c & 15, (c & 15) + 1)}`
        else continue
        out += s.slice(start, i) + escape
        start = i + 1
    }
    return `${out}${s.slice(start)}"`
}

function isIdentStart(c: u8): bool {
    return (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a) || c === 0x5f || c === 0x24
}

function isIdentPart(c: u8): bool {
    return isIdentStart(c) || (c >= 0x30 && c <= 0x39)
}

/** Whether a name is a plain identifier: ASCII letters, digits, `_` and `$`, not starting with a digit. */
export function isIdent(name: string): bool {
    if (name.length === 0 || !isIdentStart(name[0])) return false
    for (let i = 1; i < name.length; i++) if (!isIdentPart(name[i])) return false
    return true
}

/** A struct or interface name as the dump writes it: as is when it is an identifier, else quoted. */
export function ident(name: string): string {
    return isIdent(name) ? name : quote(name)
}

/** A float as JavaScript's `String` writes it, but `-0` for negative zero. */
function floatText(v: f64): string {
    if (v === 0.0 && 1.0 / v < 0.0) return "-0"
    return `${v}`
}

class Dumper {
    lines: string[] = []
    /** Interfaces referred to so far, written at the end. */
    ifaces: InterfaceType[] = []
    /** For the functions that share their name with others: `name#k`. */
    refs = new Map<Func, string>()

    module(m: Module): string {
        const names: string[] = []
        const named = new Map<string, Func[]>()
        for (const f of m.functions) {
            const list = named.get(f.name)
            if (list === null) {
                names.push(f.name)
                named.set(f.name, [f])
            } else if (!list.includes(f)) list.push(f)
        }
        for (const name of names) {
            const list = named.get(name) ?? []
            if (list.length > 1) for (let k = 0; k < list.length; k++) this.refs.set(list[k], `${name}#${k}`)
        }
        this.line(0, `module ${quote(m.file)}`)
        for (const s of m.structs) this.struct(s)
        for (const u of m.unions) this.line(0, `union ${this.type(u)}${u.name !== null ? ` name=${quote(u.name)}` : ""}`)
        for (const t of m.itabs) this.line(0, `itab ${t.id}: ${this.type(t.struct)} -> ${this.type(t.iface)}`)
        for (const f of m.functions) this.func("func", f)
        for (const f of m.inits) this.func("init", f)
        // Interfaces found while writing interfaces are appended to the list.
        for (let i = 0; i < this.ifaces.length; i++) this.iface(this.ifaces[i])
        // One join: appending each line would copy the text so far every time.
        this.lines.push("")
        return this.lines.join("\n")
    }

    line(depth: int, text: string) {
        this.lines.push(`${"  ".repeat(depth)}${text}`)
    }

    /** A reference to a function: its name, with `#k` when others share it. */
    ref(f: Func): string {
        return this.refs.get(f) ?? f.name
    }

    struct(s: StructType) {
        this.line(0, `struct ${this.type(s)}${s.nominal ? " nominal" : ""}`)
        for (const f of s.fields) this.line(1, `field ${f.name}: ${this.type(f.type)}${f.readonly ? " readonly" : ""}${f.private ? " private" : ""}`)
        for (const m of s.methods) this.line(1, `method ${m.name}: ${this.ref(m.func)}${m.private ? " private" : ""}`)
        const ctor = s.ctor
        if (ctor !== null) this.line(1, `ctor: ${this.ref(ctor)}`)
    }

    iface(t: InterfaceType) {
        this.line(0, `interface ${this.type(t)}`)
        for (const m of t.members) {
            if (m.k === "field") this.line(1, `field ${m.name}: ${this.type(m.type)}${m.readonly ? " readonly" : ""}`)
            else this.line(1, `method ${m.name}: ${this.type(m.type)}`)
        }
    }

    func(what: string, f: Func) {
        let head = `${what} ${f.name} ${quote(f.sourceName)} line=${f.line}`
        const file = f.file
        if (file !== null) head += ` file=${quote(file)}`
        if (f.extern) head += " extern"
        const variadic = f.variadic
        if (variadic !== null) head += ` variadic=${this.type(variadic)}`
        if (f.exported) head += " exported"
        if (f.captures !== null) head += " closure"
        this.line(0, `${head} : ${this.type(f.type)}`)
        const a = f.attributes
        if (a !== null) {
            let text = "attributes"
            if (a.noinline) text += " noinline"
            if (a.inline) text += " inline"
            if (a.cold) text += " cold"
            const exportName = a.exportName
            if (exportName !== null) text += ` export=${quote(exportName)}`
            const runtime = a.runtime
            if (runtime !== null) text += ` runtime=${quote(runtime)}`
            if (a.naked) text += " naked"
            this.line(1, text)
        }
        const receiver = f.receiver
        if (receiver !== null) this.line(1, `receiver: ${this.local(receiver)}`)
        for (const p of f.params) this.line(1, `param: ${this.local(p)}`)
        const captures = f.captures
        if (captures !== null) for (const c of captures) this.line(1, `capture: ${this.local(c)}`)
        this.stmt(f.body, 1, "body: ")
    }

    /** A local where it is declared: `$id name: T` and its flags. */
    local(l: Local): string {
        let text = `$${l.id} ${l.name}: ${this.type(l.type)}`
        if (l.mutable) text += " mut"
        if (l.captured) text += " captured"
        if (l.assigned) text += " assigned"
        if (l.global) text += " global"
        if (l.threadLocal) text += " threadlocal"
        const exportName = l.exportName
        if (exportName !== null) text += ` export=${quote(exportName)}`
        return text
    }

    /** The line of a statement: its prefix, kind and fields, and its source line. */
    stmtHead(s: Stmt, depth: int, prefix: string, text: string) {
        const line = s.line
        this.line(depth, `${prefix}${text}${line !== null ? ` line=${line}` : ""}`)
    }

    stmt(s: Stmt, depth: int, prefix: string) {
        const d = depth + 1
        switch (s.k) {
            case "block":
                this.stmtHead(s, depth, prefix, "block")
                for (const b of s.body) this.stmt(b, d, "")
                return
            case "let": {
                this.stmtHead(s, depth, prefix, `let ${this.local(s.local)}`)
                const init = s.init
                if (init !== null) this.expr(init, d, "init")
                return
            }
            case "expr":
                this.stmtHead(s, depth, prefix, "expr")
                this.expr(s.expr, d, "expr")
                return
            case "if": {
                this.stmtHead(s, depth, prefix, "if")
                this.expr(s.cond, d, "cond")
                this.stmt(s.then, d, "then: ")
                const otherwise = s.else
                if (otherwise !== null) this.stmt(otherwise, d, "else: ")
                return
            }
            case "loop": {
                this.stmtHead(s, depth, prefix, `loop #${s.id}${s.labeled ? " labeled" : ""}${s.condAfter ? " condAfter" : ""}`)
                const perIteration = s.perIteration
                if (perIteration !== null) for (const l of perIteration) this.line(d, `perIteration: ${this.local(l)}`)
                const cond = s.cond
                if (cond !== null) this.expr(cond, d, "cond")
                const update = s.update
                if (update !== null) this.expr(update, d, "update")
                this.stmt(s.body, d, "body: ")
                return
            }
            case "for-of": {
                this.stmtHead(s, depth, prefix, `for-of #${s.id}${s.labeled ? " labeled" : ""}`)
                this.line(d, `local: ${this.local(s.local)}`)
                const value = s.value
                if (value !== null) this.line(d, `value: ${this.local(value)}`)
                this.expr(s.iterable, d, "iterable")
                this.stmt(s.body, d, "body: ")
                return
            }
            case "switch":
                this.stmtHead(s, depth, prefix, `switch #${s.id}${s.labeled ? " labeled" : ""}${s.exhaustive ? " exhaustive" : ""}`)
                this.line(d, `local: ${this.local(s.local)}`)
                this.expr(s.value, d, "value")
                for (const c of s.clauses) {
                    const test = c.test
                    this.line(d, test !== null ? "clause: case" : "clause: default")
                    if (test !== null) this.expr(test, d + 1, "test")
                    for (const b of c.body) this.stmt(b, d + 1, "body: ")
                }
                return
            case "using":
                this.stmtHead(s, depth, prefix, "using")
                this.line(d, `local: ${this.local(s.local)}`)
                this.expr(s.init, d, "init")
                this.stmt(s.dispose, d, "dispose: ")
                for (const b of s.body) this.stmt(b, d, "body: ")
                return
            case "break": {
                const target = s.target
                this.stmtHead(s, depth, prefix, `break${target !== null ? ` target=#${target}` : ""}`)
                return
            }
            case "continue": {
                const target = s.target
                this.stmtHead(s, depth, prefix, `continue${target !== null ? ` target=#${target}` : ""}`)
                return
            }
            case "return": {
                this.stmtHead(s, depth, prefix, "return")
                const value = s.value
                if (value !== null) this.expr(value, d, "value")
                return
            }
        }
    }

    lvalue(t: LValue, depth: int) {
        const d = depth + 1
        switch (t.k) {
            case "local":
                this.line(depth, `target: local $${t.local.id} ${t.local.name}`)
                return
            case "element":
                this.line(depth, "target: element")
                this.expr(t.array, d, "array")
                this.expr(t.index, d, "index")
                return
            case "field":
                this.line(depth, `target: field ${t.name}`)
                this.expr(t.object, d, "object")
                return
            case "iface-field":
                this.line(depth, `target: iface-field ${t.index}`)
                this.expr(t.value, d, "value")
                return
            case "union-field":
                this.line(depth, `target: union-field ${t.name}`)
                this.expr(t.value, d, "value")
                return
        }
    }

    /** The line of an expression: its role, kind and fields, and its type. */
    exprHead(e: Expr, depth: int, role: string, text: string) {
        this.line(depth, `${role}: ${text} : ${this.type(e.type)}`)
    }

    all(es: Expr[], depth: int, role: string) {
        for (const x of es) this.expr(x, depth, role)
    }

    expr(e: Expr, depth: int, role: string) {
        const d = depth + 1
        switch (e.k) {
            case "int":
                this.exprHead(e, depth, role, e.type.name === "u64" ? `int ${u64(e.value)}` : `int ${e.value}`)
                return
            case "float":
                this.exprHead(e, depth, role, `float ${floatText(e.value)}`)
                return
            case "bool":
                this.exprHead(e, depth, role, `bool ${e.value}`)
                return
            case "string":
                this.exprHead(e, depth, role, `string ${quote(e.value)}`)
                return
            case "local":
                this.exprHead(e, depth, role, `local $${e.local.id} ${e.local.name}`)
                return
            case "assign": {
                const op = e.op
                this.exprHead(e, depth, role, `assign${op !== null ? ` ${op}` : ""}`)
                this.lvalue(e.target, d)
                this.expr(e.value, d, "value")
                return
            }
            case "incdec":
                this.exprHead(e, depth, role, `incdec ${e.op} ${e.prefix ? "prefix" : "postfix"}`)
                this.lvalue(e.target, d)
                return
            case "arith":
                this.exprHead(e, depth, role, `arith ${e.op}`)
                this.expr(e.left, d, "left")
                this.expr(e.right, d, "right")
                return
            case "compare":
                this.exprHead(e, depth, role, `compare ${e.op}`)
                this.expr(e.left, d, "left")
                this.expr(e.right, d, "right")
                return
            case "logical":
                this.exprHead(e, depth, role, `logical ${e.op}`)
                this.expr(e.left, d, "left")
                this.expr(e.right, d, "right")
                return
            case "unary":
                this.exprHead(e, depth, role, `unary ${e.op}`)
                this.expr(e.operand, d, "operand")
                return
            case "not":
                this.exprHead(e, depth, role, "not")
                this.expr(e.operand, d, "operand")
                return
            case "convert":
                this.exprHead(e, depth, role, "convert")
                this.expr(e.value, d, "value")
                return
            case "len":
                this.exprHead(e, depth, role, "len")
                this.expr(e.value, d, "value")
                return
            case "recast":
                this.exprHead(e, depth, role, "recast")
                this.expr(e.value, d, "value")
                return
            case "is-null":
                this.exprHead(e, depth, role, "is-null")
                this.expr(e.value, d, "value")
                return
            case "typeof":
                this.exprHead(e, depth, role, "typeof")
                this.expr(e.value, d, "value")
                return
            case "downcast":
                this.exprHead(e, depth, role, "downcast")
                this.expr(e.value, d, "value")
                return
            case "call":
                this.exprHead(e, depth, role, `call ${this.ref(e.func)}`)
                this.all(e.args, d, "arg")
                return
            case "builtin": {
                let text = `builtin ${e.name}`
                const typeArgs = e.typeArgs
                if (typeArgs !== null) {
                    const names: string[] = []
                    for (const t of typeArgs) names.push(this.type(t))
                    text += ` typeArgs=<${names.join(", ")}>`
                }
                const error = e.error
                if (error !== null) text += ` error=${this.ref(error.ctor)} itab=${error.itab.id}`
                this.exprHead(e, depth, role, text)
                this.all(e.args, d, "arg")
                return
            }
            case "cond":
                this.exprHead(e, depth, role, "cond")
                this.expr(e.cond, d, "cond")
                this.expr(e.then, d, "then")
                this.expr(e.else, d, "else")
                return
            case "concat":
                this.exprHead(e, depth, role, "concat")
                this.all(e.parts, d, "part")
                return
            case "index":
                this.exprHead(e, depth, role, "index")
                this.expr(e.target, d, "target")
                this.expr(e.index, d, "index")
                return
            case "slice": {
                this.exprHead(e, depth, role, "slice")
                this.expr(e.value, d, "value")
                const start = e.start
                if (start !== null) this.expr(start, d, "start")
                const end = e.end
                if (end !== null) this.expr(end, d, "end")
                return
            }
            case "array":
                this.exprHead(e, depth, role, "array")
                this.all(e.elems, d, "elem")
                return
            case "push":
                this.exprHead(e, depth, role, "push")
                this.expr(e.array, d, "array")
                this.all(e.values, d, "value")
                return
            case "pop":
                this.exprHead(e, depth, role, "pop")
                this.expr(e.array, d, "array")
                return
            case "object":
                this.exprHead(e, depth, role, "object")
                for (const f of e.fields) this.expr(f.value, d, `field ${f.name}`)
                return
            case "field":
                this.exprHead(e, depth, role, `field ${e.name}`)
                this.expr(e.object, d, "object")
                return
            case "alloc":
                this.exprHead(e, depth, role, "alloc")
                return
            case "method-call":
                this.exprHead(e, depth, role, `method-call ${this.ref(e.func)}`)
                this.expr(e.receiver, d, "receiver")
                this.all(e.args, d, "arg")
                return
            case "to-iface": {
                let text = "to-iface"
                const itab = e.itab
                if (itab !== null) text += ` itab=${itab.id}`
                const indices = e.indices
                if (indices !== null) text += ` indices=[${indices.map((i) => `${i}`).join(", ")}]`
                this.exprHead(e, depth, role, text)
                this.expr(e.value, d, "value")
                return
            }
            case "iface-field":
                this.exprHead(e, depth, role, `iface-field ${e.index}`)
                this.expr(e.value, d, "value")
                return
            case "iface-call":
                this.exprHead(e, depth, role, `iface-call ${e.index} method=${this.type(e.method)}`)
                this.expr(e.value, d, "value")
                this.all(e.args, d, "arg")
                return
            case "null":
                this.exprHead(e, depth, role, "null")
                return
            case "optional":
                this.exprHead(e, depth, role, "optional")
                this.expr(e.value, d, "value")
                this.line(d, `binding: ${this.local(e.binding)}`)
                this.expr(e.body, d, "body")
                return
            case "coalesce":
                this.exprHead(e, depth, role, "coalesce")
                this.expr(e.value, d, "value")
                this.expr(e.fallback, d, "fallback")
                return
            case "union-field":
                this.exprHead(e, depth, role, `union-field ${e.name}`)
                this.expr(e.value, d, "value")
                return
            case "is": {
                const via = e.via
                this.exprHead(e, depth, role, `is member=${this.type(e.member)}${via !== null ? ` via=${this.type(via)}` : ""}`)
                this.expr(e.value, d, "value")
                return
            }
            case "map": {
                this.exprHead(e, depth, role, `map ${e.op} mapType=${this.type(e.mapType)}`)
                const map = e.map
                if (map !== null) this.expr(map, d, "map")
                const key = e.key
                if (key !== null) this.expr(key, d, "key")
                const value = e.value
                if (value !== null) this.expr(value, d, "value")
                return
            }
            case "func-ref":
                this.exprHead(e, depth, role, `func-ref ${this.ref(e.func)}`)
                return
            case "closure":
                this.exprHead(e, depth, role, `closure ${this.ref(e.func)}`)
                return
            case "call-value":
                this.exprHead(e, depth, role, "call-value")
                this.expr(e.callee, d, "callee")
                this.all(e.args, d, "arg")
                return
            case "bound-method": {
                const func = e.func
                const index = e.index
                this.exprHead(e, depth, role, `bound-method${func !== null ? ` func=${this.ref(func)}` : ""}${index !== null ? ` index=${index}` : ""}`)
                this.expr(e.receiver, d, "receiver")
                return
            }
            case "array-method": {
                const arity = e.arity
                this.exprHead(e, depth, role, `array-method ${e.method}${arity !== null ? ` arity=${arity}` : ""}`)
                this.expr(e.array, d, "array")
                this.all(e.args, d, "arg")
                return
            }
            case "string-method":
                this.exprHead(e, depth, role, `string-method ${e.method}`)
                this.expr(e.value, d, "value")
                this.all(e.args, d, "arg")
                return
            case "chan": {
                const arity = e.arity
                this.exprHead(e, depth, role, `chan ${e.op} chanType=${this.type(e.chanType)}${arity !== null ? ` arity=${arity}` : ""}`)
                const chan = e.chan
                if (chan !== null) this.expr(chan, d, "chan")
                const value = e.value
                if (value !== null) this.expr(value, d, "value")
                const handler = e.handler
                if (handler !== null) this.expr(handler, d, "handler")
                return
            }
            case "bind":
                this.exprHead(e, depth, role, "bind")
                for (const b of e.locals) {
                    this.line(d, `local: ${this.local(b.local)}`)
                    this.expr(b.init, d + 1, "init")
                }
                this.expr(e.body, d, "body")
                return
            case "seq":
                this.exprHead(e, depth, role, "seq")
                this.all(e.exprs, d, "expr")
                return
        }
    }

    /** A type in a line; see compiler/ir/src/dump.ts. */
    type(t: Type): string {
        switch (t.kind) {
            case "int":
                return t.name
            case "float":
                return t.name
            case "func": {
                const params: string[] = []
                for (const p of t.params) params.push(this.type(p))
                return `(${params.join(", ")}) => ${this.type(t.result)}`
            }
            case "array":
                return t.elem.kind === "func" ? `(${this.type(t.elem)})[]` : `${this.type(t.elem)}[]`
            case "struct": {
                const name = t.name
                return `${name === null ? "" : ident(name)}#${t.id}`
            }
            case "interface": {
                let known = false
                for (const i of this.ifaces) if (i === t) known = true
                if (!known) this.ifaces.push(t)
                return `${ident(t.name)}@${t.id}`
            }
            case "union": {
                const members: string[] = []
                for (const m of t.members) members.push(m.kind === "func" ? `(${this.type(m)})` : this.type(m))
                return `(${members.join(" | ")})%${t.id}`
            }
            case "literal":
                return quote(t.value)
            case "map":
                return `Map<${this.type(t.key)}, ${this.type(t.value)}>`
            case "chan":
                return `Chan<${this.type(t.elem)}>`
            case "select-case":
                return "SelectCase"
            default:
                return t.kind
        }
    }
}
