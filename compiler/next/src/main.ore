// ore-next: for now, prints the tokens or the syntax tree of a file or the
// modules of a program, formats a file, or serves the language server.
//
//   ore-next tokens <file.ore>    one token per line: kind, start and end byte
//   ore-next tree <file.ore>      the syntax tree in pre-order: kind, start and end byte
//   ore-next roles <file.ore>     the same, each node after its role in its parent ("-" for the root)
//   ore-next modules <entry.ore>  the modules of the program in load order, each with its
//                                 imports ("import <specifier> <module>") and text imports
//                                 ("text <specifier> <bytes>"), then the diagnostics
//   ore-next fmt <file.ore>       the file formatted in the Ore style, as `ore fmt` formats it
//   ore-next ir <entry.ore>       the IR of the checked program (`dump` of ir/dump.ore), or
//                                 its diagnostics on stderr with status 1
//   ore-next lsp                  the language server on stdin and stdout

import { check } from "./checker/checker"
import { format } from "./fmt/print"
import { dump as dumpModule } from "./ir/dump"
import { serve } from "./lsp/server"
import { loadProgram } from "./project/load"
import { dump, dumpRoles } from "./syntax/ast"
import { formatDiagnostic } from "./syntax/diagnostic"
import { tokenize } from "./syntax/lexer"
import { parse } from "./syntax/parser"

const version = "0.1.0-next"

if (process.args.length === 1 && process.args[0] === "lsp") process.exit(i32(serve(version)))

const mode = process.args.length === 2 ? process.args[0] : ""
if (mode !== "tokens" && mode !== "tree" && mode !== "roles" && mode !== "modules" && mode !== "fmt" && mode !== "ir") {
    console.error("usage: ore-next tokens|tree|roles|modules|fmt|ir <file.ore> | ore-next lsp")
    process.exit(2)
}
if (mode === "ir") {
    const program = loadProgram(process.args[1])
    if (program instanceof Error) {
        console.error(program.message)
        process.exit(1)
    }
    // As the driver does: the loader's diagnostics, then the checker's.
    const diagnostics = program.diagnostics.slice()
    const checked = program.syntaxErrors ? null : check(program)
    if (checked !== null) for (const d of checked.diagnostics) diagnostics.push(d)
    const module = checked !== null ? checked.module : null
    if (module === null || program.diagnostics.length > 0) {
        for (const d of diagnostics) console.error(formatDiagnostic(d))
        process.exit(1)
    }
    console.write(dumpModule(module))
    process.exit(0)
}
if (mode === "modules") {
    const program = loadProgram(process.args[1])
    if (program instanceof Error) {
        console.error(program.message)
        process.exit(1)
    }
    for (const source of program.modules) {
        console.log(source.path)
        const imports = program.imports.get(source)
        if (imports !== null) for (const [specifier, target] of imports) console.log("  import", specifier, target.path)
        const texts = program.texts.get(source)
        if (texts !== null) for (const [specifier, text] of texts) console.log("  text", specifier, text.length)
    }
    for (const d of program.diagnostics) console.log(formatDiagnostic(d))
    process.exit(0)
}
const text = fs.readFile(process.args[1])
if (text instanceof Error) {
    console.error(text.message)
    process.exit(1)
}
if (mode === "fmt") {
    const formatted = format(text)
    if (formatted instanceof Error) {
        console.error(formatted.message)
        process.exit(1)
    }
    console.write(formatted)
} else if (mode === "tokens") {
    for (const token of tokenize(text)) console.log(token.kind, token.start, token.end)
} else {
    const parser = parse(text)
    for (const error of parser.errors) console.error(error)
    const lines: string[] = []
    if (parser.file !== null) {
        if (mode === "roles") dumpRoles(parser.file, "-", lines)
        else dump(parser.file, lines)
    }
    for (const line of lines) console.log(line)
    if (parser.errors.length > 0) process.exit(1)
}
