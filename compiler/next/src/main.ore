// ore-next: for now, prints the tokens or the syntax tree of a file or the
// modules of a program, formats a file, or serves the language server.
//
//   ore-next tokens <file.ore>    one token per line: kind, start and end byte
//   ore-next tree <file.ore>      the syntax tree in pre-order: kind, start and end byte
//   ore-next roles <file.ore>     the same, each node after its role in its parent ("-" for the root)
//   ore-next modules <entry.ore>  the modules of the program in load order, each with its
//                                 imports ("import <specifier> <module>") and text imports
//                                 ("text <specifier> <bytes>"), then the diagnostics
//   ore-next fmt <file.ore>       the file formatted in the Ore style, as `ore fmt` formats it
//   ore-next ir <entry.ore>       the IR of the checked program (`dump` of ir/dump.ore), or
//                                 its diagnostics on stderr with status 1
//   ore-next read <dump.txt>      reads the dump of an IR module (compiler/ir/src/dump.ts) and
//                                 writes it again: the round trip of ir/read.ore
//   ore-next llvm <dump.txt> [--debug]
//                                 the LLVM IR of the module of a dump, from opt/ and llvm/:
//                                 inlined unless --debug, which keeps frames for stack traces
//   ore-next lsp                  the language server on stdin and stdout
//   ore-next build <entry.ore> -o <out> [--release] [--emit-llvm <file.ll>] [--time]
//                                 an executable: the program checked, translated to LLVM IR,
//                                 compiled through LLVM's C API (no clang) and linked with lld;
//                                 C sources of packages are compiled with $CC (cc)
//   ore-next object <in.ll> [<src.c> ...] -o <out> [--release] [-c] [-l lib] [-L dir] [--time]
//                                 an executable from LLVM IR: compiled through LLVM's C API,
//                                 with the C sources and libraries, linked with lld; with -c,
//                                 only the IR's object file

import { check } from "./checker/checker"
import { build, BuildOptions, buildIr } from "./driver/build"
import { targetTriple } from "./driver/link"
import { NativeCode } from "./driver/native"
import { format } from "./fmt/print"
import { dump as dumpModule } from "./ir/dump"
import { readModule } from "./ir/read"
import { emitModule, EmitOptions } from "./llvm/emit"
import { emitObject, ObjectOptions } from "./llvm/object"
import { serve } from "./lsp/server"
import { loadProgram } from "./project/load"
import { dump, dumpRoles } from "./syntax/ast"
import { formatDiagnostic } from "./syntax/diagnostic"
import { tokenize } from "./syntax/lexer"
import { parse } from "./syntax/parser"

const version = "0.1.0-next"

if (process.args.length === 1 && process.args[0] === "lsp") process.exit(i32(serve(version)))
if (process.args.length > 0 && process.args[0] === "object") process.exit(objectCommand(process.args.slice(1)))
if (process.args.length > 0 && process.args[0] === "build") process.exit(buildCommand(process.args.slice(1)))

/** The arguments of a build: the files, and the flags (`-o out`, `-l lib`, `-L dir`, `--release`...). */
class BuildArgs {
    files: string[] = []
    output = ""
    release = false
    objectOnly = false
    times = false
    emitLlvm = ""
    native = new NativeCode()
}

function parseBuildArgs(args: string[]): BuildArgs | Error {
    const parsed = new BuildArgs()
    for (let i = 0; i < args.length; i++) {
        const arg = args[i]
        if (arg === "--release") parsed.release = true
        else if (arg === "--time") parsed.times = true
        else if (arg === "-c") parsed.objectOnly = true
        else if (arg === "-o" || arg === "-l" || arg === "-L" || arg === "--emit-llvm") {
            if (i + 1 >= args.length) return new Error(`${arg} needs a value`)
            i++
            const value = args[i]
            if (arg === "-o") parsed.output = value
            else if (arg === "--emit-llvm") parsed.emitLlvm = value
            else if (arg === "-l") parsed.native.link.push(value)
            else parsed.native.libDirs.push(value)
        } else if (arg.startsWith("-")) return new Error(`unknown option ${arg}`)
        else parsed.files.push(arg)
    }
    if (parsed.output === "") return new Error("no output: -o <file>")
    return parsed
}

function buildCommand(args: string[]): i32 {
    const parsed = parseBuildArgs(args)
    if (parsed instanceof Error || parsed.files.length !== 1 || parsed.objectOnly || parsed.native.link.length > 0 || parsed.native.libDirs.length > 0) {
        if (parsed instanceof Error) console.error(parsed.message)
        console.error("usage: ore-next build <entry.ore> -o <out> [--release] [--emit-llvm <file.ll>] [--time]")
        return 2
    }
    const result = build(parsed.files[0], new BuildOptions(parsed.output, parsed.release, parsed.emitLlvm, parsed.times))
    if (result instanceof Error) {
        console.error(result.message)
        return 1
    }
    for (const d of result.diagnostics) console.error(formatDiagnostic(d))
    return result.ok ? 0 : 1
}

function objectCommand(args: string[]): i32 {
    const parsed = parseBuildArgs(args)
    const none: string[] = []
    const ll = parsed instanceof Error ? none : parsed.files.filter((f) => f.endsWith(".ll"))
    if (parsed instanceof Error || ll.length !== 1) {
        if (parsed instanceof Error) console.error(parsed.message)
        console.error("usage: ore-next object <in.ll> [<src.c> ...] -o <out> [--release] [-c] [-l lib] [-L dir] [--time]")
        return 2
    }
    for (const file of parsed.files) if (!file.endsWith(".ll")) parsed.native.sources.push(file)
    const ir = fs.readFile(ll[0])
    if (ir instanceof Error) {
        console.error(ir.message)
        return 1
    }
    const options = new BuildOptions(parsed.output, parsed.release, "", parsed.times)
    const error = parsed.objectOnly
        ? emitObject(ir, new ObjectOptions(parsed.output, parsed.release, targetTriple(), ll[0]))
        : buildIr(ir, ll[0], parsed.native, options)
    if (error instanceof Error) {
        console.error(error.message)
        return 1
    }
    return 0
}

const llvm = process.args.length >= 2 && process.args.length <= 3 && process.args[0] === "llvm" && (process.args.length === 2 || process.args[2] === "--debug")
const mode = llvm ? "llvm" : process.args.length === 2 ? process.args[0] : ""
if (mode !== "tokens" && mode !== "tree" && mode !== "roles" && mode !== "modules" && mode !== "fmt" && mode !== "ir" && mode !== "read" && mode !== "llvm") {
    console.error("usage: ore-next tokens|tree|roles|modules|fmt|ir <file.ore> | ore-next read <dump.txt> | ore-next llvm <dump.txt> [--debug] | ore-next lsp")
    process.exit(2)
}
if (mode === "read" || mode === "llvm") {
    const text = fs.readFile(process.args[1])
    if (text instanceof Error) {
        console.error(text.message)
        process.exit(1)
    }
    const module = readModule(text)
    if (module instanceof Error) {
        console.error(module.message)
        process.exit(1)
    }
    if (mode === "read") console.write(dumpModule(module))
    else console.write(emitModule(module, new EmitOptions(process.args.length === 3)))
    process.exit(0)
}
if (mode === "ir") {
    const program = loadProgram(process.args[1])
    if (program instanceof Error) {
        console.error(program.message)
        process.exit(1)
    }
    // As the driver does: the loader's diagnostics, then the checker's.
    const diagnostics = program.diagnostics.slice()
    const checked = program.syntaxErrors ? null : check(program)
    if (checked !== null) for (const d of checked.diagnostics) diagnostics.push(d)
    const module = checked !== null ? checked.module : null
    if (module === null || program.diagnostics.length > 0) {
        for (const d of diagnostics) console.error(formatDiagnostic(d))
        process.exit(1)
    }
    console.write(dumpModule(module))
    process.exit(0)
}
if (mode === "modules") {
    const program = loadProgram(process.args[1])
    if (program instanceof Error) {
        console.error(program.message)
        process.exit(1)
    }
    for (const source of program.modules) {
        console.log(source.path)
        const imports = program.imports.get(source)
        if (imports !== null) for (const [specifier, target] of imports) console.log("  import", specifier, target.path)
        const texts = program.texts.get(source)
        if (texts !== null) for (const [specifier, text] of texts) console.log("  text", specifier, text.length)
    }
    for (const d of program.diagnostics) console.log(formatDiagnostic(d))
    process.exit(0)
}
const text = fs.readFile(process.args[1])
if (text instanceof Error) {
    console.error(text.message)
    process.exit(1)
}
if (mode === "fmt") {
    const formatted = format(text)
    if (formatted instanceof Error) {
        console.error(formatted.message)
        process.exit(1)
    }
    console.write(formatted)
} else if (mode === "tokens") {
    for (const token of tokenize(text)) console.log(token.kind, token.start, token.end)
} else {
    const parser = parse(text)
    for (const error of parser.errors) console.error(error)
    const lines: string[] = []
    if (parser.file !== null) {
        if (mode === "roles") dumpRoles(parser.file, "-", lines)
        else dump(parser.file, lines)
    }
    for (const line of lines) console.log(line)
    if (parser.errors.length > 0) process.exit(1)
}
