type Union = "first" | "second" | "third" | "fourth" | "fifth" | "sixth" | "seventh" | "eighth" | "ninth" | "tenth"
type Short = "a" | "b"
type Nullable = { a: int; b: string } | null
type Commented =
    // the first group
    | "one"
    /** the second */
    | "two"
type Fn = (a: int, b: string) => Map<string, Array<{ key: string; value: int }>>
type Generic<T extends object = {}, U = T[]> = { value: T; values: U; keys: keyof T; first: T[keyof T] }
type Tuple = [int, string, boolean]
type Intersection = { a: int } & { b: string } & Other
type Query = typeof someValue
type ReadonlyArr = readonly int[]
type Arr = (int | string)[]
type Ret = () => void
type Obj = {
    a: int
    b?: string
    readonly c: boolean
    method(x: int): string
}

interface Shape extends Base, Other<T> {
    readonly kind: "circle" | "square"
    area(): f64
    optional?: int
    // a comment in an interface
    callback: (value: int) => void
}
interface Empty {}

class Point<T> implements Shape, Serializable {
    #secret = 1
    static origin = new Point(0, 0)
    private readonly x: f64
    protected y = 0
    declare z: int
    value!: string
    [Symbol.dispose](): void {}
    constructor(public a: int, private b: string) {}
    get length(): f64 { return Math.sqrt(this.x * this.x + this.y * this.y) }
    set length(value: f64) { this.x = value }
    static create<U>(): Point<U> { return new Point() }
    async load() { await fetch() }
    abstractish?(): void
    /** Documented method. */
    documented() {}
}
abstract class Base { abstract area(): f64; abstract name: string }
class Empty2 {}
class Extending extends someModule.Base {}

