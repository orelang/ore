// The parser's entry point (syntax/parse.ore) and the format of diagnostics
// (syntax/diagnostic.ore). Ported from compiler/syntax/test/parse.test.ts.

import { test, expect, fail } from "ore:test"
import { formatDiagnostic } from "../src/syntax/diagnostic"
import { parse } from "../src/syntax/parse"

test("parses a valid file without diagnostics", () => {
    const { source, diagnostics } = parse("main.ore", "export function main() {\n  console.log(42)\n}\n")
    for (const d of diagnostics) fail(`unexpected diagnostic: ${formatDiagnostic(d)}`)
    expect(source.ast.list("statements").length).toBe(1)
})

test("reports syntax errors with positions", () => {
    const { diagnostics } = parse("bad.ore", "let x = \n")
    expect(diagnostics.length).toBe(1)
    // TypeScript reports "Expression expected." at 1:8, after the "=".
    const want = ["bad.ore:2:1: error: Identifier expected.", "  ", "  ^"].join("\n")
    const got = formatDiagnostic(diagnostics[0])
    if (got !== want) fail(`expected:\n${want}\ngot:\n${got}`)
})
