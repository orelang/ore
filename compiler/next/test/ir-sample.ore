// The IR module built by hand for the tests of the dump and the reader: the
// same module as compiler/ir/test/dump.test.ts, with every node and type
// kind and every field. Not a test file itself.

import {
    Alloc,
    ArrayLit,
    ArrayMethod,
    Arith,
    Assign,
    Bind,
    BindLocal,
    Block,
    BoolLit,
    BoundMethod,
    BreakStmt,
    BuiltinCall,
    BuiltinError,
    Call,
    CallValue,
    ChanOp,
    Closure,
    Coalesce,
    Compare,
    Concat,
    Conditional,
    ContinueStmt,
    Convert,
    Downcast,
    ElementLValue,
    ExprStmt,
    FieldGet,
    FieldInit,
    FieldLValue,
    FloatLit,
    ForOfStmt,
    Func,
    FuncAttributes,
    FuncRef,
    IfaceCall,
    IfaceField,
    IfaceFieldLValue,
    IfStmt,
    IncDec,
    Index,
    IntLit,
    Is,
    IsNull,
    Itab,
    Len,
    LetStmt,
    Local,
    LocalLValue,
    LocalRef,
    Logical,
    LoopStmt,
    MapOp,
    MethodCall,
    Module,
    Not,
    NullLit,
    ObjectLit,
    Optional,
    Pop,
    Push,
    Recast,
    ReturnStmt,
    Seq,
    Slice,
    StringLit,
    StringMethod,
    SwitchClause,
    SwitchStmt,
    ToIface,
    TypeOf,
    Unary,
    UnionField,
    UsingStmt,
    type Expr,
    type Stmt,
} from "../src/ir/nodes"
import {
    ChanType,
    Field,
    FuncType,
    InterfaceField,
    InterfaceMethod,
    InterfaceType,
    LiteralType,
    MapType,
    Method,
    StructType,
    UnionType,
    arrayOf,
    types,
    type IntType,
    type Type,
} from "../src/ir/types"

function fn(params: Type[], result: Type): FuncType {
    return new FuncType(params, result)
}

function block(body: Stmt[], line: int | null = null): Block {
    const b = new Block(body)
    b.line = line
    return b
}

function int(value: i64, type: IntType | null = null): Expr {
    return new IntLit(type ?? types.i64, value)
}

function ref(local: Local): Expr {
    return new LocalRef(local.type, local)
}

function bool(value: bool): Expr {
    return new BoolLit(types.bool, value)
}

function str(value: string): Expr {
    return new StringLit(types.string, value)
}

function float(value: f64): Expr {
    return new FloatLit(types.f64, value)
}

function withLine(s: Stmt, line: int): Stmt {
    s.line = line
    return s
}

/** The module with every node and type kind and every field, built by hand. */
function virtualCall(call: MethodCall): Expr {
    call.virtual = true
    return call
}

function virtualBound(bound: BoundMethod): Expr {
    bound.virtual = true
    return bound
}

export function sample(): Module {
    const tI64 = types.i64
    const tF64 = types.f64
    const tString = types.string
    const voidType = types.void

    const other = new InterfaceType(6, "Other<i64>", [])
    const shape = new InterfaceType(3, "Shape", [
        new InterfaceField("area", tF64, true),
        new InterfaceMethod("scale", fn([tF64], other)),
    ])
    const point = new StructType(1, "Point", true, [], [])
    const anon = new StructType(2, null, false, [new Field("a", tString, false)], [])
    const pair = new StructType(
        9,
        "Pair<i64, string>",
        false,
        [new Field("a", tI64, true), new Field("b", tString, false)],
        [],
    )
    const maybe = new UnionType(7, [tI64, types.null], "MaybeInt")
    const mixed = new UnionType(8, [new LiteralType('a"b'), fn([tI64], voidType), point, types.null])
    const map = new MapType(tString, tI64)
    const chan = new ChanType(tI64)

    const self = new Local(0, "this", point, false)
    const norm = new Func(
        "Point_norm",
        "norm",
        3,
        fn([], tF64),
        [],
        block([new ReturnStmt(new FieldGet(tF64, ref(self), "x"))]),
        false,
    )
    norm.receiver = self
    const ctor = new Func(
        "Point_new",
        "constructor",
        2,
        fn([tF64], point),
        [new Local(1, "x", tF64, false)],
        block([new ReturnStmt(new Alloc(point))]),
        false,
    )
    point.fields = [new Field("x", tF64, true), new Field("secret", tI64, false, true)]
    point.methods = [new Method("norm", norm, false), new Method("hidden", norm, true)]
    point.ctor = ctor
    const point3 = new StructType(10, "Point3", true, point.fields, point.methods)
    point3.base = point
    const itab = new Itab(0, point, shape)

    const puts = new Func(
        "puts",
        "puts",
        1,
        fn([tString], types.i32),
        [new Local(2, "s", tString, false)],
        block([]),
        false,
        "c.ore",
        true,
        types.ptr,
    )
    // Another declaration of the C function, as another module may make: references say which one.
    const putsPtr = new Func(
        "puts",
        "puts",
        2,
        fn([types.ptr], types.i32),
        [new Local(3, "p", types.ptr, false)],
        block([]),
        false,
        "d.ore",
        true,
    )

    const n = new Local(10, "n", tI64, true, true, true)
    const xs = new Local(11, "xs", arrayOf(tI64), false)
    const p = new Local(12, "p", point, false)
    const s = new Local(13, "s", shape, false)
    const m = new Local(14, "m", maybe, false)
    const g = new Local(15, "g", tI64, true, false, false, true, true, "g_c")
    const k = new Local(16, "k", tString, false)
    const v = new Local(17, "v", tI64, false)
    const b = new Local(18, "b", point, false)
    const c = new Local(19, "c", chan, false)
    const f = new Local(20, "f", fn([tI64], voidType), false)

    const closure = new Func(
        "main_lambda_1",
        "",
        9,
        fn([tI64], voidType),
        [new Local(21, "y", tI64, false)],
        block([new ExprStmt(new Assign(tI64, new LocalLValue(n), ref(new Local(21, "y", tI64, false))))]),
        false,
    )
    closure.captures = [n]

    const typeArgs: Type[] = [tI64, maybe]
    const exprs: Expr[] = [
        int(-5),
        int(-1, types.u64),
        float(1.5),
        float(-0.0 * 1.0),
        new FloatLit(types.f32, 1e21),
        bool(true),
        str('tab\tquote"back\\slash\nnul\u0001é'),
        new StringLit(new LiteralType("lit"), "lit"),
        new Assign(tI64, new LocalLValue(n), int(1), "+"),
        new Assign(tI64, new ElementLValue(ref(xs), int(0)), int(2)),
        new Assign(tF64, new FieldLValue(ref(p), "x"), float(2.0)),
        new Assign(tF64, new IfaceFieldLValue(ref(s), 0), float(3.0)),
        new IncDec(tI64, new LocalLValue(n), "++", true),
        new IncDec(tI64, new LocalLValue(n), "--", false),
        new Arith(tI64, "<<", ref(n), int(1)),
        new Compare(types.bool, "!==", ref(n), int(0)),
        new Logical(types.bool, "&&", bool(true), new Not(types.bool, bool(false))),
        new Unary(tI64, "~", ref(n)),
        new Convert(tF64, ref(n)),
        new Call(types.i32, puts, [str("hi")]),
        new Call(types.i32, putsPtr, []),
        new BuiltinCall(voidType, "console.log", [ref(n)]),
        new BuiltinCall(tI64, "JSON.parse", [str("1")], new BuiltinError(ctor, itab), typeArgs),
        new Conditional(tI64, bool(true), int(1), int(2)),
        new Concat(tString, [str("n="), ref(n)]),
        new Index(tI64, ref(xs), int(0)),
        new Len(tI64, ref(xs)),
        new Slice(arrayOf(tI64), ref(xs)),
        new Slice(arrayOf(tI64), ref(xs), int(1), int(2)),
        new ArrayLit(arrayOf(fn([], voidType)), []),
        new Push(tI64, ref(xs), [int(1), int(2)]),
        new Pop(tI64, ref(xs)),
        new ObjectLit(anon, [new FieldInit("a", str("x"))]),
        new MethodCall(tF64, norm, ref(p), []),
        virtualCall(new MethodCall(tF64, norm, ref(p), [])),
        new ToIface(shape, ref(p), itab),
        new ToIface(shape, ref(s), null, [1, 0]),
        new IfaceField(tF64, ref(s), 0),
        new IfaceCall(other, ref(s), 1, fn([tF64], other), [float(2.0)]),
        new NullLit(maybe),
        new Recast(tI64, ref(m)),
        new IsNull(types.bool, ref(m)),
        new Optional(maybe, ref(m), new Local(22, "o", tI64, false), int(1)),
        new Coalesce(tI64, ref(m), int(0)),
        new UnionField(tF64, ref(m), "x"),
        new TypeOf(tString, ref(m)),
        new Is(types.bool, ref(m), tI64),
        new Is(types.bool, ref(m), point, shape),
        new Downcast(point, ref(s)),
        new MapOp("new", map, map),
        new MapOp("set", map, map, ref(k), ref(k), int(1)),
        new FuncRef(fn([tString], types.i32), puts),
        new Closure(fn([tI64], voidType), closure),
        new CallValue(voidType, ref(f), [int(1)]),
        new BoundMethod(fn([], tF64), ref(p), norm),
        virtualBound(new BoundMethod(fn([], tF64), ref(p), norm)),
        new BoundMethod(fn([tF64], other), ref(s), null, 1),
        new ArrayMethod("map", arrayOf(tI64), ref(xs), [ref(f)], 1),
        new ArrayMethod("join", tString, ref(xs), []),
        new StringMethod("indexOf", tI64, ref(k), [ref(k)]),
        new ChanOp("new", chan, chan, null, int(4)),
        new ChanOp("on-send", types.SelectCase, chan, ref(c), int(1), ref(f), 0),
        new Bind(tI64, [new BindLocal(v, int(7))], ref(v)),
        new Seq(tI64, [int(1), int(2)]),
    ]

    const body: Stmt[] = [
        withLine(new LetStmt(n, int(0)), 5),
        new LetStmt(b),
        withLine(new IfStmt(bool(true), block([new BreakStmt()]), withLine(new ReturnStmt(), 6)), 6),
        new IfStmt(bool(false), block([], 7)),
        new LoopStmt(
            1,
            true,
            false,
            block([new ContinueStmt(1), new BreakStmt(1), new ContinueStmt()]),
            [v],
            new Compare(types.bool, "<", ref(v), int(3)),
            new IncDec(tI64, new LocalLValue(v), "++", false),
        ),
        new LoopStmt(2, false, true, block([])),
        new ForOfStmt(3, false, v, ref(xs), block([])),
        new ForOfStmt(4, true, k, ref(k), block([]), v),
        new SwitchStmt(5, false, true, k, str("a"), [
            new SwitchClause([new BreakStmt()], str("a")),
            new SwitchClause([]),
        ]),
        new UsingStmt(s, ref(s), new ExprStmt(new Call(voidType, norm, [])), [new ReturnStmt(int(1))]),
    ]
    for (const e of exprs) body.push(new ExprStmt(e))

    const main = new Func(
        "main",
        "main",
        4,
        fn([arrayOf(tI64), point, shape, maybe, chan, fn([tI64], voidType)], voidType),
        [xs, p, s, m, c, f],
        block(body, 4),
        true,
    )
    main.attributes = new FuncAttributes(true, true, true, "ore_main", "main", true)
    const init = new Func(
        "init_test",
        "<init>",
        1,
        fn([], voidType),
        [],
        block([withLine(new LetStmt(g, int(1)), 1)]),
        false,
    )
    init.attributes = new FuncAttributes()
    return new Module(
        "test.ore",
        [norm, ctor, puts, putsPtr, closure, main],
        [init],
        [point, anon, pair, point3],
        [itab],
        [maybe, mixed],
    )
}
