// The reader of IR dumps: reading a dump and dumping the module again gives
// the same text, for the module built by hand (tests/harness/next.test.ts
// checks the dumps of every test program the same way).

import { test, expect } from "ore:test"
import expected from "./ir-dump.txt" with { type: "text" }
import { dump, quote } from "../src/ir/dump"
import { readModule } from "../src/ir/read"
import { sample } from "./ir-sample"

function same(text: string, want: string) {
    if (text !== want) {
        const got = text.split("\n")
        const lines = want.split("\n")
        for (let i = 0; i < got.length || i < lines.length; i++) {
            const a = i < got.length ? got[i] : "<end>"
            const b = i < lines.length ? lines[i] : "<end>"
            if (a !== b) process.panic(`line ${i + 1}: expected ${quote(b)}, got ${quote(a)}`)
        }
    }
    expect(text).toBe(want)
}

test("reading a dump and dumping it again gives the same text", () => {
    const text = dump(sample())
    const module = readModule(text)
    if (module instanceof Error) process.panic(module.message)
    same(dump(module), text)
    same(text, expected)
})

test("the module read has the same shape as the one dumped", () => {
    const module = readModule(expected)
    if (module instanceof Error) process.panic(module.message)
    expect(module.file).toBe("test.ore")
    expect(module.functions.length).toBe(5)
    expect(module.inits.length).toBe(1)
    expect(module.structs.length).toBe(3)
    expect(module.itabs.length).toBe(1)
    expect(module.unions.length).toBe(2)
    const point = module.structs[0]
    expect(point.name ?? "").toBe("Point")
    expect(point.nominal).toBe(true)
    expect(point.fields.length).toBe(2)
    expect(point.methods[0].func === module.functions[0]).toBe(true)
    expect(point.ctor === module.functions[1]).toBe(true)
    expect(module.itabs[0].struct === point).toBe(true)
    const main = module.functions[4]
    expect(main.params.length).toBe(6)
    // A local is one object wherever it is referred to.
    expect(main.params[0] === module.functions[0].receiver).toBe(false)
    const closure = module.functions[3]
    const captures = closure.captures
    expect(captures !== null && captures.length === 1).toBe(true)
})

test("a malformed dump is an error naming the line", () => {
    const bad = readModule("module \"x\"\nfunc f \"f\" line=1 : () => void\n  body: block\n    expr\n      expr: int x : i64\n")
    expect(bad instanceof Error).toBe(true)
    if (bad instanceof Error) expect(bad.message.startsWith("line 5: ")).toBe(true)
})
