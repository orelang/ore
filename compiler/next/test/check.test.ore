// The checker (checker/checker.ore): the diagnostics of small programs, and
// the IR of a few. Ported from compiler/checker/test/check.test.ts; the
// messages are the same as those of the TypeScript checker.

import { test, expect, fail } from "ore:test"
import { check } from "../src/checker/checker"
import { type CheckResult } from "../src/checker/context"
import { dump } from "../src/ir/dump"
import { LoadOptions, loadProgram } from "../src/project/load"

/** The path of the program checked; its text is an override, never on disk. */
const path = "/ore-check-test/test.ore"

/** The messages of the syntax errors and unresolved imports of a text, or null when there are none. */
function loadErrors(text: string): string[] | null {
    const options = new LoadOptions()
    options.overrides.set(path, text)
    const program = loadProgram(path, options)
    if (program instanceof Error) fail(program.message)
    if (program.diagnostics.length === 0) return null
    const messages: string[] = []
    for (const d of program.diagnostics) messages.push(d.message)
    return messages
}

/** Loads and checks a program of one file. */
function program(text: string): CheckResult {
    const options = new LoadOptions()
    options.overrides.set(path, text)
    const loaded = loadProgram(path, options)
    if (loaded instanceof Error) fail(loaded.message)
    for (const d of loaded.diagnostics) fail(`unexpected diagnostic before checking: ${d.message}`)
    return check(loaded)
}

/** A program whose `main` has this body, after the top-level code `top`. */
function source(body: string, top: string): string {
    return `${top}\nexport function main() {\n${body}\n}\n`
}

function run(body: string, top = ""): CheckResult {
    return program(source(body, top))
}

/** The messages of a program, syntax errors included. */
function errors(body: string, top = ""): string[] {
    const text = source(body, top)
    const syntax = loadErrors(text)
    if (syntax !== null) return syntax
    const messages: string[] = []
    for (const d of program(text).diagnostics) messages.push(d.message)
    return messages
}

function show(messages: string[]): string {
    return messages.length === 0 ? "no errors" : messages.map((m) => `"${m}"`).join(", ")
}

function ok(body: string, top = "") {
    const messages = errors(body, top)
    if (messages.length > 0) fail(`expected no errors, got ${show(messages)}`)
}

function errorsAre(want: string[], body: string, top = "") {
    const got = errors(body, top)
    if (got.join("\n") !== want.join("\n")) fail(`expected ${show(want)}, got ${show(got)}`)
}

/** The first error contains a text. */
function firstContains(part: string, body: string, top = "") {
    const got = errors(body, top)
    if (got.length === 0 || !got[0].includes(part)) {
        fail(`expected a first error containing "${part}", got ${show(got)}`)
    }
}

// Numeric literals

test("untyped integers adapt to context", () => {
    ok("let a: u8 = 255; let b: i64 = -9223372036854775808; let c: f32 = 1")
})

test("constant overflow is an error", () => {
    errorsAre(["Constant 256 overflows 'u8' (range 0..255)."], "let a: u8 = 256")
    errorsAre(["Constant -129 overflows 'i8' (range -128..127)."], "let a: i8 = -129")
})

test("a failed constant conversion does not cascade", () => {
    errorsAre(
        ["A floating-point constant is not assignable to integer type 'i32'. Use 'i32(...)' to truncate."],
        "let x: i32 = 1; let y: f64 = x + 0.5",
    )
})

test("float constants are not assignable to integers", () => {
    firstContains("not assignable to integer type 'i32'", "let a: i32 = 1.5")
})

test("constant expressions fold with arbitrary precision", () => {
    ok("let a: u64 = (1 << 64) - 1")
    ok("const big = 1 << 100; let a: i32 = big >> 98")
})

test("constant division by zero is an error", () => {
    errorsAre(["Division by zero."], "let a = 1 / 0")
})

test("default types are int and f64", () => {
    // The TypeScript test reads the types the checker records; here the types of the locals in the IR.
    const { module, diagnostics } = run("let a = 5; let b = 5.0; console.log(a, b)")
    for (const d of diagnostics) fail(`unexpected error: ${d.message}`)
    if (module === null) fail("no module")
    const text = dump(module)
    const start = text.indexOf('\nfunc main "main"')
    if (start < 0) fail("no main in the dump")
    const main = text.slice(start)
    if (!main.includes(" a: i64")) fail(`'a' is not an i64 in:\n${main}`)
    if (!main.includes(" b: f64")) fail(`'b' is not an f64 in:\n${main}`)
})

// Conversions

test("mixing numeric types requires explicit conversion", () => {
    firstContains(
        "Operator '+' cannot be applied to types 'i32' and 'f64'",
        "let a: i32 = 1; let b: f64 = 2; let c = a + b",
    )
})

test("conversion functions convert between numeric types", () => {
    ok("let a: i32 = 1; let b: f64 = 2; let c = f64(a) + b; let d: u8 = u8(c)")
})

test("untyped constants are range-checked by conversions", () => {
    errorsAre(["Constant 300 overflows 'u8' (range 0..255)."], "let a = u8(300)")
})

test("float constants are truncated by integer conversions", () => {
    ok("let a: i32 = i32(2.7); let b: i8 = i8(-128.9)")
    errorsAre(["Constant 256 overflows 'u8' (range 0..255)."], "let a = u8(256.5)")
})

test("number is f64", () => {
    ok("let a: number = 1.5; let b: f64 = a")
})

// Statements

test("loops and branches", () => {
    ok(`
      let sum = 0
      for (let i = 0; i < 10; i++) {
        if (i % 2 === 0) continue
        sum += i
      }
      while (true) { break }
      do { sum-- } while (sum > 0)
    `)
})

test("const variables cannot be assigned", () => {
    errorsAre(["Cannot assign to 'a' because it is a constant."], "const a: i32 = 1; a = 2")
})

test("break outside a loop", () => {
    errorsAre(["'break' must be inside a loop or switch."], "break")
})

test("var and == are rejected", () => {
    firstContains("'var' is not supported", "var a = 1")
    firstContains("Use '==='", "let a = 1 == 1")
})

// Functions

test("calls check arity and argument types", () => {
    const top = "function add(a: i32, b: i32): i32 { return a + b }"
    ok("let x: i32 = add(1, 2)", top)
    firstContains("expects 2 argument(s), got 1", "add(1)", top)
    firstContains("Type 'i64' is not assignable to type 'i32'", "let x: i64 = 1; add(x, 2)", top)
})

test("missing return is an error", () => {
    firstContains("must return a value", "", "function f(a: i32): i32 { if (a > 0) return 1 }")
})

test("functions may end with an infinite loop or panic", () => {
    ok("", 'function f(): i32 { while (true) {} }\nfunction g(): i32 { process.panic("no") }')
})

test("mutual recursion", () => {
    const top = `
      function even(n: u32): bool { return n === 0 ? true : odd(n - 1) }
      function odd(n: u32): bool { return n === 0 ? false : even(n - 1) }
    `
    ok("", top)
})

test("parameters require type annotations", () => {
    errorsAre(["Parameter 'a' must have a type annotation."], "", "function f(a): void {}")
})

// Top level

test("top-level statements are the program; variables are globals", () => {
    const { module, diagnostics } = program("let count = 0\nfunction bump() { count++ }\nbump()\nconsole.log(count)")
    for (const d of diagnostics) fail(`unexpected error: ${d.message}`)
    if (module === null) fail("no module")
    // The entry's top-level code runs last, after the runtime's.
    const init = module.inits[module.inits.length - 1]
    const decl = init.body.body[0]
    expect(decl.k === "let" && decl.local.global).toBe(true)
})

test("constants of literals are known before any code runs", () => {
    ok("let a: u8 = N; let b: f32 = N", "const N = 200")
    firstContains("overflows", "let a: u8 = N", "const N = 300")
})

test("'return' needs a function", () => {
    const messages: string[] = []
    for (const d of program("return").diagnostics) messages.push(d.message)
    if (messages.length === 0 || !messages[0].includes("'return' is only allowed in a function")) {
        fail(`expected an error about 'return', got ${show(messages)}`)
    }
})

// Contextual types

test("branches of ?: take an expected literal union", () => {
    const top = 'type Dir = "up" | "down"\nconst n = 1'
    ok('const a: Dir = n > 0 ? "up" : "down"', top)
    firstContains("'Dir'", 'const a: Dir = n > 0 ? "up" : "left"', top)
})

test("messages name a union by its alias", () => {
    errorsAre(["Type 'string' is not assignable to type 'Kind'."], 'const k: Kind = "c"', 'type Kind = "a" | "b"')
})
