// The constants of the LLVM backend (llvm/ll.ore): integers, floats and
// strings as LLVM IR writes them. Ported from compiler/codegen/test/ll.test.ts.

import { test, expect } from "ore:test"
import { cString, floatConstant, intConstant } from "../src/llvm/ll"

test("integer constants are two's complement in their width", () => {
    // A u64 above the range of i64 is passed as the i64 of the same bits.
    const max: u64 = 18446744073709551615
    expect(intConstant(unsafe.bitcast<i64>(max), 64)).toBe("-1")
    expect(intConstant(-9223372036854775808, 64)).toBe("-9223372036854775808")
    expect(intConstant(255, 8)).toBe("-1")
    expect(intConstant(127, 8)).toBe("127")
    expect(intConstant(1, 1)).toBe("true")
})

test("float constants are exact IEEE doubles in hexadecimal", () => {
    let zero = 0.0
    expect(floatConstant(1, 64)).toBe("0x3FF0000000000000")
    expect(floatConstant(-zero, 64)).toBe("0x8000000000000000")
    expect(floatConstant(1 / zero, 64)).toBe("0x7FF0000000000000")
    // A float constant is the double of the value rounded to f32.
    expect(floatConstant(0.1, 32)).toBe("0x3FB99999A0000000")
})

test("string constants escape quotes, backslashes, control bytes and UTF-8", () => {
    expect(cString('a"b\\c\n')).toBe('c"a\\22b\\5Cc\\0A"')
    expect(cString("ё")).toBe('c"\\D1\\91"')
})
