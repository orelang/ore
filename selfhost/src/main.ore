// ore-selfhost: for now, prints the tokens of a file, one per line: kind, start and end byte.

import { tokenize } from "./lexer"

if (process.args.length !== 1) {
    console.error("usage: ore-selfhost <file.ore>")
    process.exit(2)
}
const text = fs.readFile(process.args[0])
if (text instanceof Error) {
    console.error(text.message)
    process.exit(1)
}
for (const token of tokenize(text)) console.log(token.kind, token.start, token.end)
