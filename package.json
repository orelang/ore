{
  "name": "ore",
  "private": true,
  "type": "module",
  "workspaces": [
    "compiler/syntax",
    "compiler/project",
    "compiler/checker",
    "compiler/ir",
    "compiler/opt",
    "compiler/codegen",
    "compiler/driver",
    "compiler/lsp",
    "compiler/cli"
  ],
  "scripts": {
    "ore": "bun compiler/cli/src/main.ts",
    "build": "bun build --compile compiler/cli/src/main.ts --outfile dist/ore",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@ore/checker": "workspace:*",
    "@ore/cli": "workspace:*",
    "@ore/driver": "workspace:*",
    "@ore/project": "workspace:*",
    "@ore/syntax": "workspace:*",
    "@types/bun": "1.3.14",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.25.10"
  }
}
