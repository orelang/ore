{
  "name": "ore",
  "private": true,
  "type": "module",
  "workspaces": [
    "compiler/syntax",
    "compiler/project",
    "compiler/checker",
    "compiler/ir",
    "compiler/opt",
    "compiler/codegen",
    "compiler/driver",
    "compiler/lsp",
    "compiler/cli"
  ],
  "scripts": {
    "ore": "bun compiler/cli/src/main.ts",
    "build": "mkdir -p dist && bun compiler/cli/src/main.ts build compiler/next/src/main.ore -o dist/ore --release",
    "test": "bun test --parallel --timeout 120000 --path-ignore-patterns='tests/harness/async.test.ts' && bun test --timeout 120000 tests/harness/async.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@ore/checker": "workspace:*",
    "@ore/cli": "workspace:*",
    "@ore/codegen": "workspace:*",
    "@ore/driver": "workspace:*",
    "@ore/ir": "workspace:*",
    "@ore/project": "workspace:*",
    "@ore/syntax": "workspace:*",
    "@types/bun": "1.3.14",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.25.10"
  }
}
