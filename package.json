{
  "name": "ore",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ore": "bun packages/cli/src/main.ts",
    "build": "bun build --compile packages/cli/src/main.ts --outfile dist/ore",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@ore/checker": "workspace:*",
    "@ore/cli": "workspace:*",
    "@ore/driver": "workspace:*",
    "@ore/syntax": "workspace:*",
    "@types/bun": "1.3.14",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.25.10"
  }
}
