{
  "name": "ore",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ore": "bun packages/cli/src/main.ts",
    "build": "bun build --compile packages/cli/src/main.ts --outfile dist/ore",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3",
    "@ore/cli": "workspace:*"
  }
}
