// The namespace `process` in Ore: running other programs, and the
// environment. Its exports are members of `process` (see `namespaceModule`
// in compiler/src/checker/builtins.ore): `process.run`, `process.output`,
// `process.spawn`, `process.Child`, `process.Output`,
// `process.CommandOptions`, `process.env`, `process.cpus`, the constants
// `process.pid` and the others, and the variable `process.exitCode`. args,
// getenv, cwd, panic and exit are runtime functions of other files.
//
// The short `run`, `output` and `spawn` here are those of the nested
// namespace `process.command` (runtime/core/process-command.ore) without
// options; children are started and awaited by runtime/core/spawn.ore.

import { heapSize, releasedSize, used } from "ore:runtime/gc"
import { chdir as cChdir, cpuCount, isatty as cIsatty, nil, pageSize } from "ore:runtime/os"
import { programName } from "ore:runtime/program"
import { changeVariable, codeOf, reason, variables, waitExit } from "ore:runtime/spawn"
import { errno, fromCString } from "ore:runtime/sys"
import { now } from "ore:runtime/time"

declare function kill(pid: i32, signal: i32): i32
declare function getpid(): i32
declare function getppid(): i32
declare function _NSGetExecutablePath(buffer: ptr, size: ptr): i32
declare function proc_pid_rusage(pid: i32, flavor: i32, buffer: ptr): i32

const sigterm = 15

// ---------------------------------------------------------------------------
// The environment

/** The number of CPUs the system has online. */
export function cpus(): int {
    return cpuCount()
}

/** Whether a file descriptor (0 stdin, 1 stdout, 2 stderr) is a terminal. */
export function isatty(fd: int): bool {
    return cIsatty(i32(fd)) === 1
}

/** The variables of this process's environment, by name. */
export function env(): Map<string, string> {
    return variables()
}

/** Why a variable cannot be set: a name that is empty or holds `=` or NUL, or a value that holds NUL; or null. */
function invalidVariable(name: string, value: string): string | null {
    if (name === "" || name.includes("=") || name.includes("\x00"))
        return `cannot set the environment variable "${name}": invalid name`
    if (value.includes("\x00")) return `cannot set the environment variable ${name}: its value holds a NUL`
    return null
}

/**
 * Sets a variable of this process's environment, which `getenv` and `env`
 * then read and the programs it starts inherit, as `process.env.NAME =
 * value` does in Node; an Error for an invalid name (empty, or holding `=`)
 * or a value holding a NUL.
 */
export function setenv(name: string, value: string): Error | null {
    const invalid = invalidVariable(name, value)
    if (invalid !== null) return new Error(invalid)
    if (!changeVariable(name, value))
        return new Error(`cannot set the environment variable ${name}: ${reason(errno())}`)
    return null
}

/** Removes a variable of this process's environment, as `delete process.env.NAME` does in Node; nothing when it is not set. */
export function unsetenv(name: string): Error | null {
    const invalid = invalidVariable(name, "")
    if (invalid !== null) return new Error(invalid)
    if (!changeVariable(name, null))
        return new Error(`cannot unset the environment variable ${name}: ${reason(errno())}`)
    return null
}

/** Changes the working directory of the process, as Node's `process.chdir`; an Error when it cannot. */
export function chdir(directory: string): Error | null {
    if (directory.includes("\x00"))
        return new Error(`cannot change the working directory to ${directory}: invalid path`)
    if (cChdir(directory) === 0) return null
    return new Error(`cannot change the working directory to ${directory}: ${reason(errno())}`)
}

/** The process id. */
export const pid = int(getpid())

/** The process id of the parent, when the program started. */
export const ppid = int(getppid())

/** The program's name as it was started: its first argument, as Node's `process.argv0`. */
export const argv0 = programName()

/** The absolute path of the program's executable, with symbolic links resolved, as Node's `process.execPath`. */
export const execPath = executablePath()

function executablePath(): string {
    let path = "/proc/self/exe"
    if (target.os === "darwin") {
        const size = unsafe.allocBytes(4)
        _NSGetExecutablePath(nil(), size)
        const buffer = unsafe.allocBytes(i64(unsafe.load<u32>(size)) + 1)
        if (_NSGetExecutablePath(buffer, size) !== 0) return ""
        path = fromCString(buffer)
    }
    const resolved = fs.realpath(path)
    return resolved instanceof Error ? path : resolved
}

/**
 * The status the program exits with when it ends without `process.exit`,
 * as Node's `process.exitCode`: 0 while it is null. A panic still exits
 * with 2.
 */
export let exitCode: int | null = null

/** High-resolution time, as Node's `process.hrtime`: only `bigint()`, the legacy `hrtime()` left out. */
export const hrtime = {
    /** Nanoseconds on a monotonic clock, from an arbitrary time in the past. */
    bigint(): bigint {
        return BigInt(now())
    },
}

/**
 * The memory of the process in bytes, as Node's `process.memoryUsage()`:
 * `rss` is the resident set, `heapTotal` the memory of the collected heap
 * and `heapUsed` the part of it in use, live after the last collection or
 * allocated since. No memory is outside the heap: `external` and
 * `arrayBuffers` are 0.
 */
export type MemoryUsage = { rss: int; heapTotal: int; heapUsed: int; external: int; arrayBuffers: int }

/** How much memory the process uses: see `MemoryUsage`. */
export function memoryUsage(): MemoryUsage {
    const heapUsed = used()
    let heapTotal = heapSize() - releasedSize()
    if (heapTotal < heapUsed) heapTotal = heapUsed
    return { rss: residentSize(), heapTotal, heapUsed, external: 0, arrayBuffers: 0 }
}

/** The resident set size of the process in bytes: from proc_pid_rusage on macOS, /proc/self/statm on Linux. */
function residentSize(): int {
    if (target.os === "darwin") {
        // struct rusage_info_v0: a 16-byte uuid, then u64s, resident_size the seventh.
        const info = unsafe.allocBytes(96)
        if (proc_pid_rusage(i32(pid), 0, info) !== 0) return 0
        return unsafe.load<i64>(unsafe.add(info, 64))
    }
    const statm = fs.readFile("/proc/self/statm")
    if (statm instanceof Error) return 0
    const fields = statm.split(" ")
    if (fields.length < 2) return 0
    const pages = Number.parseInt(fields[1])
    return pages === null ? 0 : pages * pageSize()
}

// ---------------------------------------------------------------------------
// Other programs

/**
 * How `process.command.run`, `output` and `spawn` start a program; every
 * setting may be left out.
 *
 *   process.command.output("git", ["status"], { cwd: "repo", env: new Map([["LANG", "C"]]) })
 */
export type CommandOptions = {
    /** The working directory of the child; this process's when left out or "". */
    cwd?: string
    /** Variables to set in the child's environment, over the inherited ones. */
    env?: Map<string, string>
    /** Whether the child starts from an empty environment instead of this process's (then only `env`). */
    clearEnv?: bool
    /** Text written to the child's standard input, which is then closed; for `run` and `spawn`, the child shares this process's standard input when left out. */
    stdin?: string
}

/** What a finished program wrote, and how it ended. */
export class Output {
    constructor(
        /** The exit status; 128 plus the signal's number when a signal killed it, as shells report. */
        readonly code: int,
        /** Everything it wrote to standard output. */
        readonly stdout: string,
        /** Everything it wrote to standard error. */
        readonly stderr: string,
        /** The signal that killed it, or 0 if it exited. */
        readonly signal: int,
    ) {}

    /** Whether it exited with status 0. */
    get ok(): bool {
        return this.code === 0 && this.signal === 0
    }
}

/**
 * A program started by `process.spawn` or `process.command.spawn`, running
 * alongside this process. Wait for it once it is started, or it stays a
 * zombie until this process ends.
 *
 *   const server = process.spawn("./server")
 *   ...
 *   server.kill()
 *   const status = server.wait()
 */
export class Child {
    /** The wait status once `wait()` has collected the child; -1 before. */
    private collected = -1

    constructor(
        /** The process id of the child. */
        readonly pid: int,
    ) {}

    /**
     * Waits for the child to end, and returns its exit status: 128 plus the
     * signal's number if a signal killed it. Called again, it returns the
     * same status. Waiting parks the task, not an OS thread; to wait with a
     * timeout, wait in another task and `task.select` on a channel and
     * `task.after`.
     */
    wait(): int | Error {
        if (this.collected >= 0) return codeOf(this.collected)
        const status = waitExit(i32(this.pid))
        if (status instanceof Error) return status
        this.collected = status
        return codeOf(status)
    }

    /**
     * Sends a signal to the child: SIGTERM (15) by default; 9 is SIGKILL
     * and 2 SIGINT, on macOS and Linux alike. Nothing is sent once `wait()`
     * has collected the child, whose process id may then be another's.
     */
    kill(signal: int = sigterm): Error | null {
        if (this.collected >= 0) return null
        if (kill(i32(this.pid), i32(signal)) === 0) return null
        return new Error(`cannot signal process ${this.pid}: ${reason(errno())}`)
    }
}

/** Runs a program with this process's standard input and output and waits for it; returns its exit status. */
export function run(program: string, args: string[] = []): int | Error {
    return process.command.run(program, args)
}

/** Runs a program and waits for it, collecting its standard output and error. */
export function output(program: string, args: string[] = []): Output | Error {
    return process.command.output(program, args)
}

/** Starts a program with this process's standard input and output, without waiting for it. */
export function spawn(program: string, args: string[] = []): Child | Error {
    return process.command.spawn(program, args)
}
