//ore:internal
// Strings: a pointer to UTF-8 bytes and a length in bytes. The null of
// `string | null` is a string with a null pointer.
//
// The exports of this module are the members of the namespace `String`.
//
// This code must not use the operations it implements: comparing strings in
// strEq would call strEq. See README.md for how the runtime is put together.

import { sliceOffset } from "ore:runtime/array"
import { allocGrowable, growable, objectSize } from "ore:runtime/gc"
import { decode, decodedValid, encode } from "ore:runtime/unicode"

function isNull(p: ptr): bool {
    return unsafe.toInt(p) === 0
}

/** The `length` bytes at `p + start`, as a string sharing them. */
function view(p: ptr, start: int, length: int): string {
    return unsafe.makeString(unsafe.add(p, start), length)
}

/** Whether the `n` bytes of `sub` are at `p + at`. */
function bytesAt(p: ptr, at: int, sub: ptr, n: int): bool {
    return n === 0 || unsafe.compare(unsafe.add(p, at), sub, n) === 0
}

/** The strings joined, with `sep` between them. */
function joinWith(parts: string[], sep: string): string {
    if (parts.length === 0) return ""
    let length = sep.length * (parts.length - 1)
    for (let i = 0; i < parts.length; i++) length += parts[i].length
    const out = unsafe.allocBytes(length)
    let at = 0
    for (let i = 0; i < parts.length; i++) {
        if (i > 0 && sep.length > 0) {
            unsafe.copy(unsafe.add(out, at), unsafe.stringData(sep), sep.length)
            at += sep.length
        }
        const part = parts[i]
        if (part.length > 0) unsafe.copy(unsafe.add(out, at), unsafe.stringData(part), part.length)
        at += part.length
    }
    return unsafe.makeString(out, length)
}

//ore:runtime ore_rt_str_eq
function strEq(a: string, b: string): bool {
    const pa = unsafe.stringData(a)
    const pb = unsafe.stringData(b)
    // Real strings always have a pointer, so a null pointer equals only another.
    if (isNull(pa) || isNull(pb)) return pa === pb
    return a.length === b.length && (pa === pb || unsafe.compare(pa, pb, a.length) === 0)
}

//ore:runtime ore_rt_str_cmp
function strCmp(a: string, b: string): i32 {
    const n = a.length < b.length ? a.length : b.length
    if (n > 0) {
        const c = unsafe.compare(unsafe.stringData(a), unsafe.stringData(b), n)
        if (c !== 0) return c < 0 ? -1 : 1
    }
    return a.length < b.length ? -1 : a.length > b.length ? 1 : 0
}

/**
 * The bytes before the text in the buffer of a concatenation: how many of the
 * buffer's bytes are taken, by the strings that end furthest in it.
 */
const header = 8

/**
 * The parts joined. A concatenation's buffer is growable, with room for more
 * text after it, so a string built by appending, `s += piece` in a loop, takes
 * linear time like Go's `append`: when the first part ends where the taken
 * bytes of its buffer end and the rest fits, the rest is written in place and
 * the taken length moves past it. Another string ending at the same place
 * finds it taken and copies, so strings sharing a buffer never see each
 * other's text. A first part that was the end of a full buffer gets a new
 * buffer twice the size it needs.
 */
//ore:runtime ore_rt_str_concat
function strConcat(count: int, parts: ptr): string {
    const size = unsafe.sizeOf<string>()
    let length = 0
    for (let i = 0; i < count; i++) length += unsafe.load<string>(unsafe.add(parts, i * size)).length
    const first = unsafe.load<string>(parts)
    const data = unsafe.stringData(first)
    let grow = false
    if (first.length > 0) {
        const start = growable(data)
        if (!isNull(start)) {
            const end = unsafe.diff(unsafe.add(data, first.length), start) - header
            const room = objectSize(start) - header
            if (
                end + length - first.length <= room &&
                unsafe.atomicCompareExchange<i64>(start, end, end + length - first.length)
            ) {
                copyParts(unsafe.add(data, first.length), count, parts, 1)
                return unsafe.makeString(data, length)
            }
            grow = unsafe.atomicLoad<i64>(start) === end
        }
    }
    const out = allocGrowable(header + (grow ? length * 2 : length))
    unsafe.store<i64>(out, length)
    copyParts(unsafe.add(out, header), count, parts, 0)
    return unsafe.makeString(unsafe.add(out, header), length)
}

/** Copies the parts from the one at `from` on to `to`, one after another. */
function copyParts(to: ptr, count: int, parts: ptr, from: int): void {
    const size = unsafe.sizeOf<string>()
    let at = 0
    for (let i = from; i < count; i++) {
        const part = unsafe.load<string>(unsafe.add(parts, i * size))
        if (part.length > 0) unsafe.copy(unsafe.add(to, at), unsafe.stringData(part), part.length)
        at += part.length
    }
}

//ore:runtime ore_rt_str_slice
function strSlice(s: string, start: int, end: int): string {
    const from = sliceOffset(start, s.length)
    const to = sliceOffset(end, s.length)
    return view(unsafe.stringData(s), from, to < from ? 0 : to - from)
}

//ore:runtime ore_rt_str_substring
function strSubstring(s: string, start: int, end: int): string {
    const a = start < 0 ? 0 : start > s.length ? s.length : start
    const b = end < 0 ? 0 : end > s.length ? s.length : end
    return a <= b ? view(unsafe.stringData(s), a, b - a) : view(unsafe.stringData(s), b, a - b)
}

//ore:runtime ore_rt_str_decode
function strDecode(s: string, pos: ptr): i32 {
    const at = unsafe.load<int>(pos)
    const r = decode(unsafe.add(unsafe.stringData(s), at), s.length - at)
    unsafe.store<int>(pos, at + (r & 7))
    return i32(r >> 3)
}

/** `s.codePointAt(at)`: the character that starts at byte `at`, U+FFFD if none does there, or null past the end. */
//ore:runtime ore_rt_str_code_point_at
function strCodePointAt(s: string, at: int): int | null {
    if (at < 0 || at >= s.length) return null
    return decode(unsafe.add(unsafe.stringData(s), at), s.length - at) >> 3
}

/** The character that starts at byte `at`, or the byte there if no valid character starts there. */
function charView(s: string, at: int): string {
    const p = unsafe.stringData(s)
    return view(p, at, decode(unsafe.add(p, at), s.length - at) & 7)
}

/** `s.at(index)`: `charAt` with a negative index counting from the end; null out of range. */
//ore:runtime ore_rt_str_char_at_relative
function strAtRelative(s: string, index: int): string | null {
    const at = index < 0 ? s.length + index : index
    if (at < 0 || at >= s.length) return null
    return charView(s, at)
}

/** `s.charAt(at)`: the character that starts at byte `at`, or "" out of range. */
//ore:runtime ore_rt_str_char_at
function strCharAt(s: string, at: int): string {
    if (at < 0 || at >= s.length) return ""
    return charView(s, at)
}

/** `s.charCodeAt(at)`: the byte (UTF-8 code unit) at `at`, or null out of range (JavaScript's NaN). */
//ore:runtime ore_rt_str_char_code_at
function strCharCodeAt(s: string, at: int): int | null {
    if (at < 0 || at >= s.length) return null
    return i64(unsafe.load<u8>(unsafe.add(unsafe.stringData(s), at)))
}

/** `s.isWellFormed()`: whether the bytes are valid UTF-8. */
//ore:runtime ore_rt_str_is_well_formed
function strIsWellFormed(s: string): bool {
    const p = unsafe.stringData(s)
    let at = 0
    while (at < s.length) {
        const q = unsafe.add(p, at)
        const r = decode(q, s.length - at)
        if (!decodedValid(q, r)) return false
        at += r & 7
    }
    return true
}

/** `s.toWellFormed()`: each byte that is not part of a valid UTF-8 character replaced by U+FFFD. */
//ore:runtime ore_rt_str_to_well_formed
function strToWellFormed(s: string): string {
    if (strIsWellFormed(s)) return s
    const p = unsafe.stringData(s)
    const out = unsafe.allocBytes(s.length * 3)
    let n = 0
    let at = 0
    while (at < s.length) {
        const q = unsafe.add(p, at)
        const r = decode(q, s.length - at)
        n += encode(unsafe.add(out, n), r >> 3)
        at += r & 7
    }
    return unsafe.makeString(out, n)
}

/**
 * The string of UTF-16 code units: a high surrogate followed by a low one is
 * one character; a lone surrogate, which UTF-8 cannot encode, is U+FFFD.
 */
function fromUnits(units: int[]): string {
    // At most 3 bytes per unit: a surrogate pair takes 4 for 2 units.
    const out = unsafe.allocBytes(units.length * 3)
    let n = 0
    let i = 0
    while (i < units.length) {
        let point = units[i]
        i++
        if (point >= 0xd800 && point < 0xe000) {
            const low = i < units.length ? units[i] : 0
            if (point < 0xdc00 && low >= 0xdc00 && low < 0xe000) {
                point = 0x10000 + ((point - 0xd800) << 10) + (low - 0xdc00)
                i++
            } else {
                point = 0xfffd
            }
        }
        n += encode(unsafe.add(out, n), point)
    }
    return unsafe.makeString(out, n)
}

/**
 * `String.fromCharCode(...codes)`: the string of UTF-16 code units, as in
 * JavaScript, each taken modulo 2^16. A surrogate pair is one character; a
 * lone surrogate is U+FFFD, since Ore strings are UTF-8.
 */
export function fromCharCode(...codes: int[]): string {
    const units: int[] = []
    for (const code of codes) units.push(code & 0xffff)
    return fromUnits(units)
}

/**
 * `String.fromCodePoint(...points)`: the string of code points, as in
 * JavaScript; a code point past U+10FFFF or negative panics (a RangeError in
 * JavaScript). Surrogates combine as in `fromCharCode`.
 */
export function fromCodePoint(...points: int[]): string {
    const units: int[] = []
    for (const point of points) {
        if (point < 0 || point > 0x10ffff) process.panic(`RangeError: Invalid code point ${point}`)
        if (point < 0x10000) {
            units.push(point)
        } else {
            units.push(0xd800 + ((point - 0x10000) >> 10))
            units.push(0xdc00 + ((point - 0x10000) & 0x3ff))
        }
    }
    return fromUnits(units)
}

/**
 * `String.raw(template, ...substitutions)`: the raw strings of a template
 * with the substitutions between them, as in JavaScript; substitutions past
 * the last gap are left out. A `TemplateStringsArray` passes its `raw`.
 * `` String.raw`...` `` the checker writes as a template of the raw strings.
 */
export function raw(template: { readonly raw: string[] }, ...substitutions: string[]): string {
    const strings = template.raw
    const parts: string[] = []
    for (let i = 0; i < strings.length; i++) {
        parts.push(strings[i])
        if (i + 1 < strings.length && i < substitutions.length) parts.push(substitutions[i])
    }
    return joinWith(parts, "")
}

// Tagged templates. A `TemplateStringsArray` is the array of the cooked
// strings with a header one word longer than an array's (see array.ore):
// the array of the raw strings. Array operations see a plain array.

/** The bytes of an array header. */
const arrayHeader = 32

/** The strings object of a tagged template site, created once (see checker/templates.ore). */
//ore:noinline
function templateObject(cooked: (string | null)[], raw: string[]): TemplateStringsArray {
    const header = unsafe.alloc(arrayHeader + 8)
    unsafe.copy(header, unsafe.addressOf(cooked), arrayHeader)
    unsafe.store<ptr>(unsafe.add(header, arrayHeader), unsafe.addressOf(raw))
    return unsafe.fromAddress<TemplateStringsArray>(header)
}

/** `strings.raw`: the array after the header. */
function templateRaw(strings: TemplateStringsArray): string[] {
    return unsafe.fromAddress<string[]>(unsafe.load<ptr>(unsafe.add(unsafe.addressOf(strings), arrayHeader)))
}

/** An offset clamped to the string, as JavaScript clamps positions. */
function clamp(at: int, length: int): int {
    return at < 0 ? 0 : at > length ? length : at
}

/** `s.indexOf(sub, from)`: the first occurrence at or after `from` (clamped), or -1. */
//ore:runtime ore_rt_str_index_of
function strIndexOf(s: string, sub: string, from: int): int {
    const p = unsafe.stringData(s)
    const q = unsafe.stringData(sub)
    const start = clamp(from, s.length)
    if (sub.length === 0) return start
    // Comparing the rest only where the first byte is there.
    const first = unsafe.load<u8>(q)
    for (let i = start; i + sub.length <= s.length; i++) {
        if (unsafe.load<u8>(unsafe.add(p, i)) === first && bytesAt(p, i, q, sub.length)) return i
    }
    return -1
}

/** `s.lastIndexOf(sub, from)`: the last occurrence at or before `from` (clamped), or -1. */
//ore:runtime ore_rt_str_last_index_of
function strLastIndexOf(s: string, sub: string, from: int): int {
    const p = unsafe.stringData(s)
    const q = unsafe.stringData(sub)
    const start = clamp(from, s.length)
    for (let i = start < s.length - sub.length ? start : s.length - sub.length; i >= 0; i--) {
        if (bytesAt(p, i, q, sub.length)) return i
    }
    return -1
}

/** `s.startsWith(prefix, at)`: whether `prefix` is at `at` (clamped). */
//ore:runtime ore_rt_str_starts_with
function strStartsWith(s: string, prefix: string, at: int): bool {
    const start = clamp(at, s.length)
    return (
        prefix.length <= s.length - start &&
        bytesAt(unsafe.stringData(s), start, unsafe.stringData(prefix), prefix.length)
    )
}

/** `s.endsWith(suffix, end)`: whether `suffix` ends at `end` (clamped). */
//ore:runtime ore_rt_str_ends_with
function strEndsWith(s: string, suffix: string, end: int): bool {
    const start = clamp(end, s.length) - suffix.length
    return start >= 0 && bytesAt(unsafe.stringData(s), start, unsafe.stringData(suffix), suffix.length)
}

/**
 * `s.split(sep, limit)`: at most `limit` parts, which JavaScript takes
 * modulo 2^32 (so -1 is no limit). An empty separator splits into UTF-8
 * characters.
 */
//ore:runtime ore_rt_str_split
function strSplit(s: string, sep: string, limit: int): string[] {
    const parts: string[] = []
    const most = limit & 0xffffffff
    if (most === 0) return parts
    const p = unsafe.stringData(s)
    if (sep.length === 0) {
        let at = 0
        while (at < s.length && parts.length < most) {
            const size = decode(unsafe.add(p, at), s.length - at) & 7
            parts.push(view(p, at, size))
            at += size
        }
        return parts
    }
    let start = 0
    while (true) {
        const at = strIndexOf(s, sep, start)
        if (at === -1) break
        parts.push(view(p, start, at - start))
        if (parts.length === most) return parts
        start = at + sep.length
    }
    parts.push(view(p, start, s.length - start))
    return parts
}

//ore:runtime ore_rt_str_join
function strJoin(strings: string[], sep: string): string {
    return joinWith(strings, sep)
}

/** Whether a character is white space or a line terminator to JavaScript's `trim`. */
function isWhiteSpace(c: int): bool {
    if (c < 0x80) return c === 0x20 || (c >= 0x09 && c <= 0x0d)
    return (
        c === 0xa0 ||
        c === 0x1680 ||
        (c >= 0x2000 && c <= 0x200a) ||
        c === 0x2028 ||
        c === 0x2029 ||
        c === 0x202f ||
        c === 0x205f ||
        c === 0x3000 ||
        c === 0xfeff
    )
}

/** The size of the white space character that ends at `end`, after `limit`, or 0 if none does. */
function spaceBefore(p: ptr, end: int, limit: int): int {
    let start = end - 1
    while (start > limit && end - start < 4 && (unsafe.load<u8>(unsafe.add(p, start)) & 0xc0) === 0x80) start--
    const r = decode(unsafe.add(p, start), end - start)
    return (r & 7) === end - start && isWhiteSpace(r >> 3) ? end - start : 0
}

/** Trims JavaScript's white space and line terminators from the start (sides 1), the end (2) or both (3). */
//ore:runtime ore_rt_str_trim
function strTrim(s: string, sides: int): string {
    const p = unsafe.stringData(s)
    let start = 0
    let end = s.length
    if ((sides & 1) !== 0) {
        while (start < end) {
            const r = decode(unsafe.add(p, start), end - start)
            if (!isWhiteSpace(r >> 3)) break
            start += r & 7
        }
    }
    if ((sides & 2) !== 0) {
        while (end > start) {
            const size = spaceBefore(p, end, start)
            if (size === 0) break
            end -= size
        }
    }
    return view(p, start, end - start)
}

/**
 * Where `replace` (the first) or `replaceAll` (all) replaces `pattern`:
 * occurrences that do not overlap; an empty pattern is at the start and,
 * for all, after each character.
 */
function occurrences(s: string, pattern: string, all: bool): int[] {
    const out: int[] = []
    if (pattern.length === 0) {
        out.push(0)
        if (!all) return out
        const p = unsafe.stringData(s)
        let at = 0
        while (at < s.length) {
            at += decode(unsafe.add(p, at), s.length - at) & 7
            out.push(at)
        }
        return out
    }
    let from = 0
    while (true) {
        const at = strIndexOf(s, pattern, from)
        if (at === -1) break
        out.push(at)
        if (!all) break
        from = at + pattern.length
    }
    return out
}

/**
 * The replacement of the occurrence at `at` with `$` patterns, as
 * JavaScript's GetSubstitution reads them without groups: `$$` is `$`, `$&`
 * the matched text, `` $` `` the text before it and `$'` the text after it;
 * any other `$` stays.
 */
function substitute(s: string, at: int, matched: int, template: string, parts: string[]) {
    const p = unsafe.stringData(s)
    const t = unsafe.stringData(template)
    let from = 0
    let i = 0
    while (i + 1 < template.length) {
        if (unsafe.load<u8>(unsafe.add(t, i)) !== 0x24) {
            i++
            continue
        }
        const c = unsafe.load<u8>(unsafe.add(t, i + 1))
        if (c !== 0x24 && c !== 0x26 && c !== 0x60 && c !== 0x27) {
            i++
            continue
        }
        parts.push(view(t, from, c === 0x24 ? i + 1 - from : i - from))
        if (c === 0x26) parts.push(view(p, at, matched))
        else if (c === 0x60) parts.push(view(p, 0, at))
        else if (c === 0x27) parts.push(view(p, at + matched, s.length - at - matched))
        i += 2
        from = i
    }
    parts.push(view(t, from, template.length - from))
}

/** `s.replace(pattern, replacement)` and `replaceAll`, with the `$` patterns of `substitute`. */
//ore:runtime ore_rt_str_replace
function strReplace(s: string, pattern: string, replacement: string, all: bool): string {
    const found = occurrences(s, pattern, all)
    if (found.length === 0) return s
    const p = unsafe.stringData(s)
    const parts: string[] = []
    const dollar = strIndexOf(replacement, "$", 0) >= 0
    let start = 0
    for (const at of found) {
        parts.push(view(p, start, at - start))
        if (dollar) substitute(s, at, pattern.length, replacement, parts)
        else parts.push(replacement)
        start = at + pattern.length
    }
    parts.push(view(p, start, s.length - start))
    return joinWith(parts, "")
}

/** `s.replace(pattern, fn)` and `replaceAll`: each occurrence replaced by `fn(matched, offset, s)`. */
//ore:runtime ore_rt_str_replace_with
function strReplaceWith(
    s: string,
    pattern: string,
    replacer: (matched: string, offset: int, input: string) => string,
    all: bool,
): string {
    const found = occurrences(s, pattern, all)
    if (found.length === 0) return s
    const p = unsafe.stringData(s)
    const parts: string[] = []
    let start = 0
    for (const at of found) {
        parts.push(view(p, start, at - start))
        parts.push(replacer(view(p, at, pattern.length), at, s))
        start = at + pattern.length
    }
    parts.push(view(p, start, s.length - start))
    return joinWith(parts, "")
}

//ore:runtime ore_rt_str_repeat
function strRepeat(s: string, count: int): string {
    if (count < 0) process.panic(`RangeError: Invalid count value: ${count}`)
    const out = unsafe.allocBytes(s.length * count)
    for (let i = 0; i < count; i++) unsafe.copy(unsafe.add(out, i * s.length), unsafe.stringData(s), s.length)
    return unsafe.makeString(out, s.length * count)
}

/**
 * Pads to `length` bytes with repetitions of `pad`, at the start or the
 * end. The last repetition is cut where a character starts, so the result
 * may be up to 3 bytes shorter than `length` rather than invalid UTF-8.
 */
//ore:runtime ore_rt_str_pad
function strPad(s: string, length: int, pad: string, start: bool): string {
    if (length <= s.length || pad.length === 0) return s
    const q = unsafe.stringData(pad)
    let fill = length - s.length
    let cut = fill % pad.length
    while (cut > 0 && (unsafe.load<u8>(unsafe.add(q, cut)) & 0xc0) === 0x80) cut--
    fill = fill - (fill % pad.length) + cut
    const out = unsafe.allocBytes(s.length + fill)
    const filled = start ? out : unsafe.add(out, s.length)
    for (let i = 0; i < fill; i++)
        unsafe.store<u8>(unsafe.add(filled, i), unsafe.load<u8>(unsafe.add(q, i % pad.length)))
    if (s.length > 0) unsafe.copy(start ? unsafe.add(out, fill) : out, unsafe.stringData(s), s.length)
    return unsafe.makeString(out, s.length + fill)
}

/** `s.substr(start, length)`: `length` bytes from `start`, which counts from the end when negative. */
//ore:runtime ore_rt_str_substr
function strSubstr(s: string, start: int, length: int): string {
    const from = start < 0 ? clamp(s.length + start, s.length) : clamp(start, s.length)
    return view(unsafe.stringData(s), from, clamp(length, s.length - from))
}

/** The byte at `i`, bounds-checked. */
//ore:runtime ore_rt_str_at
function strAt(s: string, i: int): u8 {
    if (u64(i) >= u64(s.length)) process.panic(`index out of range [${i}] with length ${s.length}`)
    return unsafe.load<u8>(unsafe.add(unsafe.stringData(s), i))
}
