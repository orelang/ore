// The operating system under the scheduler: threads, locks, memory mappings,
// clocks, the network poller and the signals of the garbage collector, from
// libc. Struct sizes and constants differ between platforms; they
// were read from the system headers of macOS (arm64) and Linux (arm64 and
// x86-64).

// ---------------------------------------------------------------------------
// libc

export declare function malloc(size: u64): ptr
export declare function calloc(count: u64, size: u64): ptr
export declare function getenv(name: string): ptr
export declare function sysconf(name: i32): i64
export declare function clock_gettime(clock: i32, time: ptr): i32
export declare function mmap(address: ptr, size: u64, protection: i32, flags: i32, fd: i32, offset: i64): ptr
export declare function mprotect(address: ptr, size: u64, protection: i32): i32
export declare function munmap(address: ptr, size: u64): i32

export declare function pthread_mutex_init(mutex: ptr, attributes: ptr): i32
export declare function pthread_mutex_lock(mutex: ptr): i32
export declare function pthread_mutex_unlock(mutex: ptr): i32
export declare function pthread_cond_init(cond: ptr, attributes: ptr): i32
export declare function pthread_cond_signal(cond: ptr): i32
export declare function pthread_cond_wait(cond: ptr, mutex: ptr): i32
export declare function pthread_cond_timedwait(cond: ptr, mutex: ptr, deadline: ptr): i32
export declare function pthread_attr_init(attributes: ptr): i32
export declare function pthread_attr_setdetachstate(attributes: ptr, state: i32): i32
export declare function pthread_attr_destroy(attributes: ptr): i32
export declare function pthread_create(thread: ptr, attributes: ptr, start: ptr, argument: ptr): i32

// The network poller: kqueue on macOS, epoll on Linux.
export declare function kqueue(): i32
export declare function kevent(
    queue: i32,
    changes: ptr,
    changeCount: i32,
    events: ptr,
    eventCount: i32,
    timeout: ptr,
): i32
export declare function epoll_create1(flags: i32): i32
export declare function epoll_ctl(poller: i32, op: i32, fd: i32, event: ptr): i32
export declare function epoll_wait(poller: i32, events: ptr, count: i32, timeout: i32): i32

// Files and directories, for fs (runtime/core/fs.ore). `stat` and `readdir`
// fill structs whose layouts differ by platform: see fs.ore.
export declare function stat(path: string, info: ptr): i32
export declare function lstat(path: string, info: ptr): i32
export declare function mkdir(path: string, mode: u32): i32
export declare function rmdir(path: string): i32
export declare function unlink(path: string): i32
export declare function rename(from: string, to: string): i32
export declare function opendir(path: string): ptr
export declare function readdir(dir: ptr): ptr
export declare function closedir(dir: ptr): i32
export declare function realpath(path: string, resolved: ptr): ptr
export declare function mkdtemp(template: ptr): ptr
export declare function free(p: ptr): void

// ---------------------------------------------------------------------------
// Threads and signals, for the collector

export declare function pthread_self(): ptr
export declare function pthread_kill(thread: ptr, signal: i32): i32
export declare function sigaction(signal: i32, action: ptr, previous: ptr): i32
export declare function nanosleep(duration: ptr, remaining: ptr): i32
/** macOS: the base (highest address) of a thread's stack. */
export declare function pthread_get_stackaddr_np(thread: ptr): ptr
/** Linux: a thread's attributes, which hold its stack. */
export declare function pthread_getattr_np(thread: ptr, attributes: ptr): i32
export declare function pthread_attr_getstack(attributes: ptr, address: ptr, size: ptr): i32

// ---------------------------------------------------------------------------
// Output that allocates nothing: for signal handlers, threads the collector
// does not know, and a program that is stuck.

declare function write(fd: i32, bytes: ptr, size: u64): i64

/** Writes the bytes of `s` (a constant, or any string already made). */
export function writeRaw(fd: i32, s: string): void {
    write(fd, unsafe.stringData(s), u64(s.length))
}

/** Writes `n` in base 10 or 16, formatted in `scratch` (at least 24 bytes). */
export function writeNumber(fd: i32, n: int, hex: bool, scratch: ptr): void {
    const base = hex ? 16 : 10
    let v = u64(n)
    if (!hex && n < 0) v = u64(-n)
    let i = 24
    while (true) {
        i--
        const digit = i64(v % u64(base))
        unsafe.store<u8>(unsafe.add(scratch, i), u8(digit < 10 ? 0x30 + digit : 0x57 + digit))
        v = v / u64(base)
        if (v === u64(0)) break
    }
    if (hex) {
        i -= 2
        unsafe.store<u8>(unsafe.add(scratch, i), 0x30)
        unsafe.store<u8>(unsafe.add(scratch, i + 1), 0x78)
    } else if (n < 0) {
        i--
        unsafe.store<u8>(unsafe.add(scratch, i), 0x2d)
    }
    write(fd, unsafe.add(scratch, i), u64(24 - i))
}

// ---------------------------------------------------------------------------
// Memory outside the collector, for state that C and assembly reach by address

/** Zeroed memory that is never freed or collected. */
export function permanent(size: int): ptr {
    return calloc(1, u64(size))
}

export function nil(): ptr {
    return unsafe.fromInt(0)
}

export function isNil(p: ptr): bool {
    return unsafe.toInt(p) === 0
}

// ---------------------------------------------------------------------------
// Locks: buffers larger than any platform's pthread types (at most 200 bytes, a
// macOS rwlock), set up by pthread_*_init since static initializers differ.

const lockSize = 256

/** A new mutex, in collected memory: it lives as long as the object holding it. */
export function newMutex(): ptr {
    const m = unsafe.allocBytes(lockSize)
    pthread_mutex_init(m, nil())
    return m
}

/** A new mutex that is never freed, for the scheduler. */
export function permanentMutex(): ptr {
    const m = permanent(lockSize)
    pthread_mutex_init(m, nil())
    return m
}

export function permanentCond(): ptr {
    const c = permanent(lockSize)
    pthread_cond_init(c, nil())
    return c
}

export function lock(m: ptr): void {
    pthread_mutex_lock(m)
}

export function unlock(m: ptr): void {
    pthread_mutex_unlock(m)
}

// ---------------------------------------------------------------------------
// Threads

/** Starts a detached OS thread running `start(argument)`, a C function; false if it could not. */
export function startThread(start: ptr, argument: ptr): bool {
    const attributes = unsafe.allocBytes(lockSize)
    const thread = unsafe.allocBytes(8)
    pthread_attr_init(attributes)
    pthread_attr_setdetachstate(attributes, target.os === "darwin" ? 2 : 1)
    const started = pthread_create(thread, attributes, start, argument) === 0
    pthread_attr_destroy(attributes)
    return started
}

export function cpuCount(): int {
    const n = sysconf(target.os === "darwin" ? 58 : 84)
    return n > 0 ? n : 1
}

export function pageSize(): int {
    return sysconf(target.os === "darwin" ? 29 : 30)
}

// ---------------------------------------------------------------------------
// Clocks

const clockRealtime: i32 = 0

function clockMonotonic(): i32 {
    return target.os === "darwin" ? 6 : 1
}

/** Milliseconds on a clock that only goes forward. */
export function nowMs(time: ptr): int {
    clock_gettime(clockMonotonic(), time)
    return unsafe.load<i64>(time) * 1000 + unsafe.load<i64>(unsafe.add(time, 8)) / 1000000
}

/** Nanoseconds on a clock that only goes forward. */
export function nowNs(time: ptr): int {
    clock_gettime(clockMonotonic(), time)
    return unsafe.load<i64>(time) * 1000000000 + unsafe.load<i64>(unsafe.add(time, 8))
}

/** Milliseconds since the Unix epoch, on the wall clock. */
export function epochMs(time: ptr): int {
    clock_gettime(clockRealtime, time)
    return unsafe.load<i64>(time) * 1000 + unsafe.load<i64>(unsafe.add(time, 8)) / 1000000
}

/** Fills `deadline` (a timespec) with the wall-clock time `ms` from now, for pthread_cond_timedwait. */
export function deadlineIn(deadline: ptr, ms: int): void {
    clock_gettime(clockRealtime, deadline)
    let seconds = unsafe.load<i64>(deadline) + ms / 1000
    let nanos = unsafe.load<i64>(unsafe.add(deadline, 8)) + (ms % 1000) * 1000000
    if (nanos >= 1000000000) {
        seconds++
        nanos -= 1000000000
    }
    unsafe.store<i64>(deadline, seconds)
    unsafe.store<i64>(unsafe.add(deadline, 8), nanos)
}

// ---------------------------------------------------------------------------
// Memory mappings, for task stacks

const protNone: i32 = 0
const protReadWrite: i32 = 3
const mapPrivate: i32 = 2

function mapAnonymous(): i32 {
    return target.os === "darwin" ? 0x1000 : 0x20
}

/** A private mapping of `size` bytes whose lowest page faults when touched; null if there is no memory. */
export function mapGuarded(size: int): ptr {
    const p = mmap(nil(), u64(size), protReadWrite, mapPrivate | mapAnonymous(), -1, 0)
    // MAP_FAILED is the address -1.
    if (unsafe.toInt(p) === 18446744073709551615) return nil()
    mprotect(p, u64(pageSize()), protNone)
    return p
}

export function unmap(p: ptr, size: int): void {
    munmap(p, u64(size))
}

// ---------------------------------------------------------------------------
// The network poller

const pollBatch = 64

/** The size of one event of the poller. */
function eventSize(): int {
    if (target.os === "darwin") return 32
    return target.arch === "x86_64" ? 12 : 16
}

export function newPoller(): i32 {
    // EPOLL_CLOEXEC on Linux.
    return target.os === "darwin" ? kqueue() : epoll_create1(0x80000)
}

/** Room for the events of one wait. */
export function newEvents(): ptr {
    return permanent(pollBatch * eventSize())
}

/** Waits for readiness events; returns how many there are. */
export function pollWait(poller: i32, events: ptr): int {
    if (target.os === "darwin") return i64(kevent(poller, nil(), 0, events, pollBatch, nil()))
    return i64(epoll_wait(poller, events, pollBatch, -1))
}

/** The data registered with event `i`. */
export function eventData(events: ptr, i: int): ptr {
    const event = unsafe.add(events, i * eventSize())
    if (target.os === "darwin") return unsafe.load<ptr>(unsafe.add(event, 24))
    // epoll_event is packed on x86-64: its data follows the 4 bytes of the event mask.
    return unsafe.load<ptr>(unsafe.add(event, target.arch === "x86_64" ? 4 : 8))
}

/** Asks for one readiness event of `fd` (writable, or readable), carrying `data`; false if it failed. */
export function pollOnce(poller: i32, fd: i32, write: bool, data: ptr): bool {
    const event = unsafe.allocBytes(32)
    if (target.os === "darwin") {
        // EV_SET(event, fd, EVFILT_WRITE or EVFILT_READ, EV_ADD | EV_ONESHOT, 0, 0, data)
        unsafe.store<u64>(event, u64(fd))
        unsafe.store<i16>(unsafe.add(event, 8), write ? -2 : -1)
        unsafe.store<u16>(unsafe.add(event, 10), 0x1 | 0x10)
        unsafe.store<ptr>(unsafe.add(event, 24), data)
        return kevent(poller, event, 1, nil(), 0, nil()) >= 0
    }
    // EPOLLOUT or EPOLLIN, with EPOLLONESHOT; modified if registered before, else added.
    const flags: u32 = u32(write ? 0x4 : 0x1) | 0x40000000
    unsafe.store<u32>(event, flags)
    unsafe.store<ptr>(unsafe.add(event, target.arch === "x86_64" ? 4 : 8), data)
    return epoll_ctl(poller, 3, fd, event) >= 0 || epoll_ctl(poller, 1, fd, event) >= 0
}

/**
 * Asks kqueue for one event when process `pid` exits (EVFILT_PROC with
 * NOTE_EXIT), carrying `data`; false if it failed, as for a process that
 * already exited. macOS only: Linux waits on a pidfd with pollOnce.
 */
export function pollExitOnce(poller: i32, pid: i32, data: ptr): bool {
    if (target.os === "darwin") {
        // EV_SET(event, pid, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, data)
        const event = unsafe.allocBytes(32)
        unsafe.store<u64>(event, u64(pid))
        unsafe.store<i16>(unsafe.add(event, 8), -5)
        unsafe.store<u16>(unsafe.add(event, 10), 0x1 | 0x10)
        unsafe.store<u32>(unsafe.add(event, 12), 0x80000000)
        unsafe.store<ptr>(unsafe.add(event, 24), data)
        return kevent(poller, event, 1, nil(), 0, nil()) >= 0
    }
    return false
}
