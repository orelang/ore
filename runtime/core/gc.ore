// The garbage collector: a non-moving mark-sweep collector in the shape of
// Go's. The heap is one reserved range of addresses, used in pages of 8 KB
// grouped into spans; a span holds objects of one size class (or one large
// object), with a bitmap of the allocated and of the marked ones. A page table
// maps any address in the heap to its span, so a pointer into the middle of
// an object keeps it alive. Each thread allocates from its own spans without
// locking; the slow path, which takes a span from the shared lists or new
// pages, is under `heapLock`.
//
// A collection stops the world: it sends a signal to every registered thread,
// whose handler records the stack pointer and waits; the kernel's signal frame
// holds the registers, so scanning the stack from there finds every pointer.
// A thread inside an allocation finishes it first (its span would change under
// it otherwise), then stops where the allocation ends. Stacks are scanned
// conservatively; objects word by word, except those allocated as bytes.
// Roots: the stacks of the threads, the stacks of parked tasks (through a
// hook set by the scheduler), and the program's globals, in a table that the
// compiler emits.
//
// The collector's state lives in globals that are numbers or pointers, which a
// declaration without a value does not reset, since `init` runs before the
// top-level code of the runtime.

import {
    getenv,
    startThread,
    pthread_cond_wait,
    pthread_cond_broadcast,
    permanentCond,
    cpuCount,
    isNil,
    lock,
    mmap,
    nanosleep,
    nil,
    nowNs,
    writeNumber,
    writeRaw,
    permanent,
    permanentMutex,
    pthread_attr_destroy,
    pthread_attr_getstack,
    pthread_get_stackaddr_np,
    pthread_getattr_np,
    pthread_kill,
    pthread_self,
    sigaction,
    unlock,
} from "ore:runtime/os"

/** The table of the program's globals, {address, size} pairs, emitted by the compiler. */
declare function ore_globals_table(): ptr
declare function ore_globals_count(): i64
declare function dprintf(fd: i32, format: string, ...args: i64[]): i32
declare function dladdr(address: ptr, info: ptr): i32
declare function strlen(s: ptr): u64
declare function madvise(address: ptr, size: u64, advice: i32): i32

const pageShift = 13
const pageSize = 8192
/** The reserved heap: 16 GB of addresses, touched only as they are used. */
const heapPages = 1 << 21
/** Objects up to this size share spans by size class; larger ones get their own. */
const maxSmall = 8192
/** A bitmap of 512 bits: the most objects in a span (8 KB of 16-byte objects). */
const bitmapSize = 64
const maxClasses = 48
/** A thread tells the collector what it allocated every this many bytes. */
const flushEvery = 128 << 10
const minHeap = 4 << 20

// A span record, in permanent memory.
const spanStart = 0
const spanPages = 8
const spanElemSize = 16
const spanElems = 24
const spanNoscan = 32
const spanFreeIndex = 40
const spanAllocBits = 48
const spanMarkBits = 56
const spanNext = 64
const spanClass = 72
/**
 * 2^32 / size rounded up: the index of the object at `offset` in the span is
 * (offset * divMul) >> 32, without a division, as in Go's mspan; exact for
 * every offset in a span of every size class (checked for all of them).
 * 0 for a span of one large object.
 */
const spanDivMul = 80
/** A bitmap of the objects allocated as growable strings (see `allocGrowable`). */
const spanGrowBits = 88
/**
 * The type of each object, for scanning it precisely: a pointer to its
 * `gcdata` (see `allocTyped`), or nil to scan it word by word.
 */
const spanTypes = 96
/** For a free run: 1 once its pages were given back to the system (see `scavenge`). */
const spanReleased = 104
const spanRecordSize = 112
/** The most objects a span holds; a span of more would have room for more, unused. */
const maxElems = 512

// A thread record, in permanent memory, pointed to by the thread-local `thread`.
const threadId = 0
/** The base of the stack the thread runs on: its own, or the task's. */
const threadBase = 8
/** The stack pointer recorded when the thread stopped for a collection. */
const threadSp = 16
/** Nonzero while the thread allocates: the collector then waits for the allocation to end. */
const threadInAlloc = 24
/** Set by the signal handler when it found the thread allocating. */
const threadStopRequested = 32
const threadNext = 40
/** Bytes allocated since the thread last told the collector. */
const threadAllocated = 48
const threadOwnBase = 56
/** The span the thread allocates from, per size class, scanned and noscan apart. */
/** The number of the last collection the thread stopped for. */
const threadStoppedFor = 64
/** Room for the return addresses of the thread's stack, when the watchdog asks for it (see `dumpThreads`). */
const threadTrace = 72
/** Set by the thread once it has printed its stack for the watchdog. */
const threadDumped = 80
/** The objects the thread's write barrier shaded, for the markers: a buffer of `wbCap` pointers, and how many it holds. */
const threadWbBuffer = 88
const threadWbCount = 96
const threadCache = 104
const threadRecordSize = threadCache + maxClasses * 2 * 8
const wbCap = 256

let heapBase: ptr
let pageTable: ptr
let nextPage: int
/** Runs of free pages: span records whose pages are free, linked by `spanNext`. */
let freeRuns: ptr
/** Span records ready for reuse. */
let freeRecords: ptr
let metaNext: ptr
let metaEnd: ptr

/** The size of each class (a table of ints), and the class of each size in units of 16 bytes. */
let classSizes: ptr
let classCount: int
let classOfSize: ptr
/** Spans with free objects, per class and noscan, linked by `spanNext`. */
let partial: ptr
/** Every span in use, for the sweep. */
let spans: ptr
let spanCount: int
let spanCap: int

/** Allocation since the last collection, as the threads reported it, and the amount that triggers the next. */
let allocatedCell: ptr
let nextCollection: int
let liveBytes: int
let collections: int
/** Bytes allocated since the program started, as the threads reported them: the watchdog's sign of progress. */
let allocatedEver: ptr

let markStack: ptr
let markTop: int
let markCap: int

/** The registered threads, under `heapLock`. */
let threads: ptr
let threadCount: int
/** Serializes collections, and the slow path of allocation. */
let gcLock: ptr
let heapLock: ptr
/** 1 while the world is stopped; the threads wait on it. */
let stoppingCell: ptr
/** The number of the current (or last) collection: a thread acknowledges a stop with it. */
let generationCell: ptr
/** The pause between checks of a waiting thread: a timespec. */
let pause: ptr
/** The scheduler's hook that scans the stacks of parked tasks: a closure cell, or null. */
let stackRootsHook: ptr
/** Memory outside the heap that holds pointers into it, such as the workers' blocks: {address, size} pairs, under `gcLock`. */
let extraRoots: ptr
let extraRootCount: int
let extraRootCap: int
/** 1 when ORE_GCTRACE is set: each collection prints a line to stderr. */
let trace: int
/** 1 to mark alongside the program (the default), 0 with the world stopped throughout (ORE_GCSTW set). */
let concurrentMarking: int
/** ORE_GOGC: how much the heap grows between collections, in percent of the live heap (100 by default); -1 for `off`. */
let gcPercent: int
/** ORE_MEMLIMIT: a soft limit of the heap in bytes, 0 for none: collections come sooner as the live heap nears it. */
let memoryLimit: int
let clock: ptr

/**
 * A lock taken for reading by a worker while it switches stacks, and for
 * writing by the collector before it stops the world, so that every stopped
 * thread is on the stack its record says. No code allocates while it holds the
 * read side. It is made of atomics: a reader blocked in the kernel on a
 * pthread rwlock and interrupted by the stop signal could lose its wakeup on
 * macOS, and every thread then waited for a writer that had long gone.
 * The word holds the number of readers, and `switchWriter` while the
 * collector holds or wants it.
 */
let switchState: ptr

const switchWriter = 1 << 62

/** Takes the read side: before a worker leaves one stack for another. */
export function enterSwitch(): void {
    while (true) {
        const state = unsafe.atomicLoad<i64>(switchState)
        if ((state & switchWriter) === 0 && unsafe.atomicCompareExchange<i64>(switchState, state, state + 1)) return
        nanosleep(pause, nil())
    }
}

/** Releases the read side, on whichever stack the worker went on. */
export function exitSwitch(): void {
    unsafe.atomicSub<i64>(switchState, 1)
}

//ore:threadlocal
let thread: ptr

//ore:noinline
function threadRecord(): ptr {
    return thread
}

//ore:noinline
function setThreadRecord(t: ptr): void {
    thread = t
}

function field(p: ptr, offset: int): int {
    return unsafe.load<int>(unsafe.add(p, offset))
}

function setField(p: ptr, offset: int, value: int): void {
    unsafe.store<int>(unsafe.add(p, offset), value)
}

function pointerAt(p: ptr, offset: int): ptr {
    return unsafe.load<ptr>(unsafe.add(p, offset))
}

function setPointer(p: ptr, offset: int, value: ptr): void {
    unsafe.store<ptr>(unsafe.add(p, offset), value)
}

// ---------------------------------------------------------------------------
// Memory from the system

function mapMemory(size: int): ptr {
    const anonymous = target.os === "darwin" ? 0x1000 : 0x20
    const noReserve = target.os === "darwin" ? 0 : 0x4000
    const p = mmap(nil(), u64(size), 3, i32(2 | anonymous | noReserve), -1, 0)
    if (unsafe.toInt(p) === ~u64(0)) process.panic("gc: out of address space")
    return p
}

/** Metadata memory, never freed; the caller holds `heapLock`. */
function meta(size: int): ptr {
    if (unsafe.toInt(metaNext) + u64(size) > unsafe.toInt(metaEnd)) {
        metaNext = mapMemory(1 << 20)
        metaEnd = unsafe.add(metaNext, 1 << 20)
    }
    const p = metaNext
    metaNext = unsafe.add(metaNext, ((size + 15) / 16) * 16)
    return p
}

/** Sets up the heap and the stop signal; called once, before anything is allocated. */
export function init(): void {
    gcLock = permanentMutex()
    heapLock = permanentMutex()
    switchState = permanent(8)
    allocatedCell = permanent(8)
    stoppingCell = permanent(8)
    generationCell = permanent(8)
    markingCell = permanent(8)
    pause = permanent(16)
    unsafe.store<i64>(unsafe.add(pause, 8), 20000)
    heapBase = mapMemory(heapPages * pageSize)
    pageTable = mapMemory(heapPages * 8)

    // Size classes: every 16 bytes up to 128, then steps of a quarter, then of an eighth.
    classSizes = meta(maxClasses * 8)
    let size = 16
    while (size < maxSmall) {
        setField(classSizes, classCount * 8, size)
        classCount++
        size += size < 128 ? 16 : size < 1024 ? size / 4 : size / 8
        size = ((size + 15) / 16) * 16
    }
    setField(classSizes, classCount * 8, maxSmall)
    classCount++
    classOfSize = meta((maxSmall / 16 + 1) * 8)
    let c = 0
    for (let units = 0; units <= maxSmall / 16; units++) {
        while (field(classSizes, c * 8) < units * 16) c++
        setField(classOfSize, units * 8, c)
    }
    partial = meta(classCount * 16)
    spanCap = 1024
    spans = mapMemory(spanCap * 8)
    markCap = 1 << 16
    markStack = mapMemory(markCap * 8)
    nextCollection = minHeap
    clock = permanent(16)
    allocatedEver = permanent(8)
    installStopHandler()
}

/** The scheduler's function that scans the stacks of parked tasks (a C function). */
export function setStackRootsHook(hook: ptr): void {
    stackRootsHook = permanent(16)
    unsafe.store<ptr>(stackRootsHook, hook)
}

// ---------------------------------------------------------------------------
// Threads

/** The base of the current thread's stack: the highest address. */
function stackBase(): ptr {
    if (target.os === "darwin") return pthread_get_stackaddr_np(pthread_self())
    const attributes = permanent(128)
    const address = permanent(16)
    pthread_getattr_np(pthread_self(), attributes)
    pthread_attr_getstack(attributes, address, unsafe.add(address, 8))
    pthread_attr_destroy(attributes)
    return unsafe.add(unsafe.load<ptr>(address), unsafe.load<int>(unsafe.add(address, 8)))
}

/** Registers the calling thread: it may allocate from now on, and its stack is scanned. */
export function registerThread(): void {
    const t = permanent(threadRecordSize)
    setPointer(t, threadTrace, permanent(64))
    setPointer(t, threadId, pthread_self())
    const base = stackBase()
    setPointer(t, threadOwnBase, base)
    setPointer(t, threadBase, base)
    setThreadRecord(t)
    // Not during a collection: the collector stops only the threads it knew when it started.
    lock(gcLock)
    setPointer(t, threadNext, threads)
    threads = t
    threadCount++
    unlock(gcLock)
    // The first thread reads the settings; getenv's argument is a copy, so the thread must be registered.
    if (threadCount === 1) {
        trace = isNil(getenv("ORE_GCTRACE")) ? 0 : 1
        concurrentMarking = isNil(getenv("ORE_GCSTW")) ? 1 : 0
        gcPercent = envNumber("ORE_GOGC", 100)
        memoryLimit = envNumber("ORE_MEMLIMIT", 0)
        nextCollection = budget(0)
        startMarkers()
    }
}

/**
 * Makes [address, address + size) a root: memory outside the heap, such as
 * the scheduler's per-worker blocks, that may hold the only reference to an
 * object. It must not allocate: it may run before the thread is registered.
 */
export function addRoot(address: ptr, size: int): void {
    lock(gcLock)
    if (extraRootCount === extraRootCap) {
        const cap = extraRootCap === 0 ? 16 : extraRootCap * 2
        const grown = permanent(cap * 16)
        if (extraRootCount > 0) unsafe.copy(grown, extraRoots, extraRootCount * 16)
        extraRoots = grown
        extraRootCap = cap
    }
    setPointer(extraRoots, extraRootCount * 16, address)
    setField(extraRoots, extraRootCount * 16 + 8, size)
    extraRootCount++
    unlock(gcLock)
}

/**
 * Keeps any collection from starting until `allowCollections`: around a
 * call that a signal must not interrupt while other threads are stopped, such
 * as posix_spawn under Rosetta. The code in between must not allocate.
 */
export function holdCollections(): void {
    lock(gcLock)
}

export function allowCollections(): void {
    unlock(gcLock)
}

/**
 * Brackets code that the collector must not stop in the middle of, such as
 * changes of the lists it reads; the code must not wait for other threads.
 */
export function enterNoStop(): void {
    const t = threadRecord()
    unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 1)
    lock(heapLock)
}

export function exitNoStop(): void {
    const t = threadRecord()
    unlock(heapLock)
    unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 0)
    if (unsafe.atomicLoad<i64>(unsafe.add(t, threadStopRequested)) !== 0) stopHere(t)
}

/** Tells the collector which stack the thread runs on from now: `base` is its highest address. */
//ore:noinline
export function setStackBase(base: ptr): void {
    setPointer(thread, threadBase, base)
}

/** The thread's own stack: what it runs on outside any task. */
//ore:noinline
export function ownStackBase(): ptr {
    return pointerAt(thread, threadOwnBase)
}

// ---------------------------------------------------------------------------
// Spans

function newRecord(): ptr {
    if (!isNil(freeRecords)) {
        const r = freeRecords
        freeRecords = pointerAt(r, spanNext)
        return r
    }
    const r = meta(spanRecordSize)
    setPointer(r, spanAllocBits, meta(bitmapSize))
    setPointer(r, spanMarkBits, meta(bitmapSize))
    setPointer(r, spanGrowBits, meta(bitmapSize))
    setPointer(r, spanTypes, meta(maxElems * 8))
    return r
}

/** A run of `pages` pages, reused or new, with a span record for it; the caller holds `heapLock`. */
function newSpan(pages: int): ptr {
    let prev = nil()
    let run = freeRuns
    while (!isNil(run)) {
        const have = field(run, spanPages)
        if (have >= pages) {
            const next = pointerAt(run, spanNext)
            if (field(run, spanReleased) !== 0) {
                // Its pages come back into use: those taken now, or all of them for the rest, counted once.
                releasedBytes -= have * pageSize
                if (releasedBytes < 0) releasedBytes = 0
                setField(run, spanReleased, 0)
            }
            if (have === pages) {
                if (isNil(prev)) freeRuns = next
                else setPointer(prev, spanNext, next)
                return run
            }
            // Split: the rest stays free.
            const span = newRecord()
            setPointer(span, spanStart, pointerAt(run, spanStart))
            setField(span, spanPages, pages)
            setField(span, spanReleased, 0)
            setPointer(run, spanStart, unsafe.add(pointerAt(run, spanStart), pages * pageSize))
            setField(run, spanPages, have - pages)
            return span
        }
        prev = run
        run = pointerAt(run, spanNext)
    }
    if (nextPage + pages > heapPages) outOfMemory()
    const span = newRecord()
    setPointer(span, spanStart, unsafe.add(heapBase, nextPage * pageSize))
    setField(span, spanPages, pages)
    nextPage += pages
    return span
}

//ore:cold
//ore:noinline
function outOfMemory(): void {
    process.panic("out of memory")
}

/** Sets up `span` for `elems` objects of `size` bytes, in the page table and the span list. */
function useSpan(span: ptr, size: int, elems: int, noscan: bool, cls: int): void {
    setField(span, spanElemSize, size)
    setField(span, spanElems, elems)
    setField(span, spanNoscan, noscan ? 1 : 0)
    setField(span, spanFreeIndex, 0)
    setField(span, spanClass, cls)
    // A large object is alone in its span: any offset is index 0, which a multiplier of 0 gives.
    setField(span, spanDivMul, elems === 1 ? 0 : i64(~u32(0) / u32(size)) + 1)
    unsafe.fill(pointerAt(span, spanAllocBits), 0, bitmapSize)
    unsafe.fill(pointerAt(span, spanMarkBits), 0, bitmapSize)
    unsafe.fill(pointerAt(span, spanGrowBits), 0, bitmapSize)
    const first = unsafe.diff(pointerAt(span, spanStart), heapBase) >> pageShift
    for (let i = 0; i < field(span, spanPages); i++) setPointer(pageTable, (first + i) * 8, span)
    if (spanCount === spanCap) {
        const grown = mapMemory(spanCap * 16)
        unsafe.copy(grown, spans, spanCount * 8)
        spans = grown
        spanCap *= 2
    }
    setPointer(spans, spanCount * 8, span)
    spanCount++
}

/** Frees the pages of a span: out of the page table, into the free runs. */
function releaseSpan(span: ptr): void {
    const first = unsafe.diff(pointerAt(span, spanStart), heapBase) >> pageShift
    for (let i = 0; i < field(span, spanPages); i++) setPointer(pageTable, (first + i) * 8, nil())
    setField(span, spanReleased, 0)
    setPointer(span, spanNext, freeRuns)
    freeRuns = span
}

function bit(bits: ptr, i: int): bool {
    return (unsafe.load<u8>(unsafe.add(bits, i >> 3)) & u8(1 << (i & 7))) !== 0
}

function setBit(bits: ptr, i: int): void {
    const at = unsafe.add(bits, i >> 3)
    unsafe.store<u8>(at, unsafe.load<u8>(at) | u8(1 << (i & 7)))
}

// ---------------------------------------------------------------------------
// Allocation

/** The first object of a span with free room for class `cls`: from the shared lists, or a new span. */
//ore:noinline
function refill(t: ptr, cls: int, noscan: bool): ptr {
    lock(heapLock)
    const list = unsafe.add(partial, (cls * 2 + (noscan ? 1 : 0)) * 8)
    let span = unsafe.load<ptr>(list)
    if (!isNil(span)) {
        unsafe.store<ptr>(list, pointerAt(span, spanNext))
    } else {
        const elemSize = field(classSizes, cls * 8)
        const pages = elemSize * 8 > pageSize ? (elemSize * 8 + pageSize - 1) / pageSize : 1
        span = newSpan(pages)
        const elems = (pages * pageSize) / elemSize
        useSpan(span, elemSize, elems < maxElems ? elems : maxElems, noscan, cls)
    }
    unlock(heapLock)
    setPointer(t, threadCache + (cls * 2 + (noscan ? 1 : 0)) * 8, span)
    return span
}

/** One large object in a span of its own. */
//ore:noinline
function allocLarge(size: int, noscan: bool, gcdata: ptr): ptr {
    const pages = (size + pageSize - 1) / pageSize
    lock(heapLock)
    const span = newSpan(pages)
    useSpan(span, pages * pageSize, 1, noscan, -1)
    setPointer(pointerAt(span, spanTypes), 0, gcdata)
    setBit(pointerAt(span, spanAllocBits), 0)
    if (!isNil(markingCell) && unsafe.atomicLoad<i64>(markingCell) !== 0) setBit(pointerAt(span, spanMarkBits), 0)
    unlock(heapLock)
    const p = pointerAt(span, spanStart)
    unsafe.fill(p, 0, size)
    return p
}

/** Reports the thread's allocation to the collector, and collects when it is time. */
//ore:noinline
function flush(t: ptr): void {
    const allocated = field(t, threadAllocated)
    setField(t, threadAllocated, 0)
    unsafe.atomicAdd<i64>(allocatedEver, allocated)
    if (unsafe.atomicAdd<i64>(allocatedCell, allocated) + allocated >= nextCollection) collect()
}

/** `size` zeroed bytes; `noscan` memory is never scanned for pointers, the rest word by word. */
export function alloc(size: int, noscan: bool): ptr {
    return allocTyped(size, noscan, nil())
}

/**
 * `size` zeroed bytes of a type whose pointers the collector knows: `gcdata`
 * is `{ unit: i64, bits: u64[] }`, the object being units of `unit` bytes,
 * one after the other (one for a struct, many for the elements of an
 * array), and bit i of `bits` set when the word at byte 8 * i of a unit may
 * hold a pointer. A nil `gcdata` has the object scanned word by word.
 */
export function allocTyped(size: int, noscan: bool, gcdata: ptr): ptr {
    if (size <= 0) size = 1
    const t = threadRecord()
    if (isNil(t)) process.panic("gc: allocation on an unregistered thread")
    setField(t, threadAllocated, field(t, threadAllocated) + size)
    if (field(t, threadAllocated) >= flushEvery) flush(t)
    // From here to the end, a collection waits for this thread (see `onStop`).
    unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 1)
    let p: ptr
    if (size > maxSmall) {
        p = allocLarge(size, noscan, gcdata)
    } else {
        const cls = field(classOfSize, ((size + 15) >> 4) * 8)
        const slot = unsafe.add(t, threadCache + (cls * 2 + (noscan ? 1 : 0)) * 8)
        let span = unsafe.load<ptr>(slot)
        let i = 0
        while (true) {
            if (!isNil(span)) {
                const bits = pointerAt(span, spanAllocBits)
                const elems = field(span, spanElems)
                i = field(span, spanFreeIndex)
                while (i < elems && bit(bits, i)) i++
                if (i < elems) {
                    setBit(bits, i)
                    setField(span, spanFreeIndex, i + 1)
                    break
                }
            }
            span = refill(t, cls, noscan)
        }
        const elemSize = field(span, spanElemSize)
        p = unsafe.add(pointerAt(span, spanStart), i * elemSize)
        unsafe.fill(p, 0, elemSize)
        if (!noscan) setPointer(pointerAt(span, spanTypes), i * 8, gcdata)
        // Allocated black while marking runs: it holds nothing yet that the snapshot did not.
        if (!isNil(markingCell) && unsafe.atomicLoad<i64>(markingCell) !== 0)
            unsafe.atomicOr<i64>(unsafe.add(pointerAt(span, spanMarkBits), (i >> 6) * 8), 1 << (i & 63))
    }
    unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 0)
    if (unsafe.atomicLoad<i64>(unsafe.add(t, threadStopRequested)) !== 0) stopHere(t)
    return p
}

/**
 * `size` zeroed bytes, never scanned, flagged as the buffer of a growable
 * string: `growable` finds it again from a pointer into it.
 */
export function allocGrowable(size: int): ptr {
    const p = alloc(size, true)
    const span = spanOf(p)
    const index = objectIndex(span, p)
    // Atomic: after a sweep, another thread may allocate from the same span.
    unsafe.atomicOr<i64>(unsafe.add(pointerAt(span, spanGrowBits), (index >> 6) * 8), 1 << (index & 63))
    return p
}

/**
 * The start of the growable buffer that `p` points into, or nil if `p` points
 * elsewhere: into another object, outside the heap, or nowhere.
 */
export function growable(p: ptr): ptr {
    const offset = unsafe.toInt(p) - unsafe.toInt(heapBase)
    if (offset >= u64(nextPage * pageSize)) return nil()
    const span = pointerAt(pageTable, i64(offset >> 13) * 8)
    if (isNil(span)) return nil()
    const index = objectIndex(span, p)
    if (index >= field(span, spanElems)) return nil()
    if (!bit(pointerAt(span, spanGrowBits), index)) return nil()
    return unsafe.add(pointerAt(span, spanStart), index * field(span, spanElemSize))
}

/** The size in bytes of the object at `p`, which `growable` returned: at least the size it was allocated with. */
export function objectSize(p: ptr): int {
    return field(spanOf(p), spanElemSize)
}

/** The span of `p`, an address in the heap's used pages. */
function spanOf(p: ptr): ptr {
    return pointerAt(pageTable, (unsafe.diff(p, heapBase) >> pageShift) * 8)
}

/** The index in `span` of the object that `p` points into. */
function objectIndex(span: ptr, p: ptr): int {
    return i64((u64(unsafe.diff(p, pointerAt(span, spanStart))) * u64(field(span, spanDivMul))) >> 32)
}

// ---------------------------------------------------------------------------
// Stopping the world

/** SIGUSR1: a function, since a constant chosen by the target would be a global, unset before the top-level code runs. */
function stopSignal(): i32 {
    return target.os === "darwin" ? 30 : 10
}

/** Installs `onStop` for the stop signal, restarting the system calls it interrupts. */
function installStopHandler(): void {
    const action = permanent(256)
    unsafe.store<ptr>(action, unsafe.functionAddress(onStop))
    if (target.os === "darwin") {
        // struct sigaction: handler, mask (4 bytes), flags; SA_RESTART is 2.
        unsafe.store<i32>(unsafe.add(action, 12), 2)
    } else {
        // struct sigaction: handler, mask (128 bytes), flags, restorer; SA_RESTART is 0x10000000.
        unsafe.store<i32>(unsafe.add(action, 136), 0x10000000)
    }
    if (sigaction(stopSignal(), action, nil()) !== 0) process.panic("gc: cannot install the stop signal")
    const dump = permanent(256)
    unsafe.store<ptr>(dump, unsafe.functionAddress(onDump))
    unsafe.store<i32>(unsafe.add(dump, target.os === "darwin" ? 12 : 136), target.os === "darwin" ? 2 : 0x10000000)
    if (sigaction(dumpSignal(), dump, nil()) !== 0) process.panic("gc: cannot install the dump signal")
}

// ---------------------------------------------------------------------------
// Stacks for the watchdog

const traceDepth = 64

/** SIGUSR2: asks a thread to print its stack. */
function dumpSignal(): i32 {
    return target.os === "darwin" ? 31 : 12
}

/**
 * The dump signal's handler: prints this thread's native stack to stderr,
 * walking the chain of frame pointers itself, since libc's backtrace stops at
 * the end of the thread's own stack and tasks run on stacks of their own. The
 * walk ends at a null or misaligned frame pointer, or one that goes down: the
 * first frame of a task has a null one.
 */
function onDump(signal: i32): void {
    const t = threadRecord()
    const scratch = pointerAt(t, threadTrace)
    const info = unsafe.add(scratch, 32)
    writeRaw(2, "thread ")
    writeNumber(2, i64(unsafe.toInt(pointerAt(t, threadId))), true, scratch)
    writeRaw(2, ":\n")
    let fp = currentFp()
    for (let depth = 0; depth < traceDepth; depth++) {
        if (unsafe.toInt(fp) === 0 || (unsafe.toInt(fp) & 7) !== 0) break
        const ret = unsafe.load<ptr>(unsafe.add(fp, 8))
        const next = unsafe.load<ptr>(fp)
        writeRaw(2, "  ")
        writeNumber(2, i64(unsafe.toInt(ret)), true, scratch)
        writeSymbol(ret, info, scratch)
        writeRaw(2, "\n")
        if (unsafe.toInt(next) <= unsafe.toInt(fp)) break
        fp = next
    }
    unsafe.atomicStore<i64>(unsafe.add(t, threadDumped), 1)
}

/**
 * Writes " name + offset" for a return address: dladdr's name, or on Linux,
 * where dladdr knows only exported symbols, the function of the executable's
 * own symbol table that contains it.
 */
function writeSymbol(address: ptr, info: ptr, scratch: ptr): void {
    if (dladdr(address, info) === 0) return
    let name = unsafe.load<ptr>(unsafe.add(info, 16))
    let offset = 0
    if (!isNil(name)) {
        offset = unsafe.diff(address, unsafe.load<ptr>(unsafe.add(info, 24)))
    } else {
        if (target.os === "darwin") return
        const base = unsafe.load<ptr>(unsafe.add(info, 8))
        // The executable's own functions: a library's are its exported ones.
        if (base !== elfBase) return
        const symbol = elfFunction(unsafe.diff(address, base))
        if (isNil(symbol)) return
        name = unsafe.add(elfNames, i64(unsafe.load<u32>(symbol)))
        offset = unsafe.diff(address, base) - unsafe.load<i64>(unsafe.add(symbol, 8))
    }
    writeRaw(2, " ")
    writeRaw(2, unsafe.makeString(name, i64(strlen(name))))
    writeRaw(2, " + ")
    writeNumber(2, offset, false, scratch)
}

declare function open(path: ptr, flags: i32): i32
declare function lseek(fd: i32, offset: i64, whence: i32): i64
declare function close(fd: i32): i32

/** The executable's ELF symbols (24 bytes each) and their names, mapped by `loadElfSymbols`; Linux only. */
let elfSymbols: ptr
let elfSymbolCount: int
let elfNames: ptr
/** Where the executable is loaded: the symbols' values are relative to it. */
let elfBase: ptr

/** Maps /proc/self/exe and finds its symbol table: once, from the watchdog's thread. Allocates nothing. */
function loadElfSymbols(): void {
    if (target.os === "darwin" || !isNil(elfSymbols)) return
    const path = "/proc/self/exe\x00"
    const fd = open(unsafe.stringData(path), 0)
    if (fd < 0) return
    const size = lseek(fd, 0, 2)
    const image = size > 0 ? mmap(nil(), u64(size), 1, 2, fd, 0) : nil()
    close(fd)
    if (isNil(image) || unsafe.toInt(image) === ~u64(0)) return
    // Elf64_Ehdr: e_shoff at 0x28, e_shentsize at 0x3a, e_shnum at 0x3c.
    const sections = unsafe.add(image, unsafe.load<i64>(unsafe.add(image, 0x28)))
    const entry = i64(unsafe.load<u16>(unsafe.add(image, 0x3a)))
    const count = i64(unsafe.load<u16>(unsafe.add(image, 0x3c)))
    for (let i = 0; i < count; i++) {
        // Elf64_Shdr: sh_type at 4, sh_offset at 0x18, sh_size at 0x20, sh_link at 0x28; SHT_SYMTAB is 2.
        const section = unsafe.add(sections, i * entry)
        if (unsafe.load<u32>(unsafe.add(section, 4)) !== u32(2)) continue
        const names = unsafe.add(sections, i64(unsafe.load<u32>(unsafe.add(section, 0x28))) * entry)
        elfNames = unsafe.add(image, unsafe.load<i64>(unsafe.add(names, 0x18)))
        elfSymbolCount = unsafe.load<i64>(unsafe.add(section, 0x20)) / 24
        elfSymbols = unsafe.add(image, unsafe.load<i64>(unsafe.add(section, 0x18)))
        const info = permanent(32)
        if (dladdr(unsafe.functionAddress(onDump), info) !== 0) elfBase = unsafe.load<ptr>(unsafe.add(info, 8))
        return
    }
}

/** The function symbol (Elf64_Sym) whose range holds `offset` from the executable's base, or null. */
function elfFunction(offset: int): ptr {
    for (let i = 0; i < elfSymbolCount; i++) {
        // Elf64_Sym: st_name at 0, st_info at 4 (STT_FUNC is 2), st_value at 8, st_size at 16.
        const symbol = unsafe.add(elfSymbols, i * 24)
        if ((unsafe.load<u8>(unsafe.add(symbol, 4)) & 15) !== 2) continue
        const start = unsafe.load<i64>(unsafe.add(symbol, 8))
        if (offset >= start && offset < start + unsafe.load<i64>(unsafe.add(symbol, 16))) return symbol
    }
    return nil()
}

function currentFp(): ptr {
    if (target.arch === "arm64") return unsafe.asm<ptr>("mov $0, x29", "=r")
    return unsafe.asm<ptr>("movq %rbp, $0", "=r")
}

/**
 * Prints the native stack of every registered thread, each printed by the
 * thread itself in a signal handler; for the watchdog, when the program is
 * stuck. Allocates nothing and takes no lock, since the program may hold any.
 */
export function dumpThreads(): void {
    loadElfSymbols()
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) {
        unsafe.atomicStore<i64>(unsafe.add(t, threadDumped), 0)
        pthread_kill(pointerAt(t, threadId), dumpSignal())
        // A thread that does not answer within a second is reported as such.
        let waited = 0
        while (unsafe.atomicLoad<i64>(unsafe.add(t, threadDumped)) === 0 && waited < 50000) {
            nanosleep(pause, nil())
            waited++
        }
        if (waited >= 50000) {
            writeRaw(2, "thread ")
            writeNumber(2, i64(unsafe.toInt(pointerAt(t, threadId))), true, pointerAt(t, threadTrace))
            writeRaw(2, ": no answer\n")
        }
    }
}

/** Bytes allocated since the program started (as reported every 128 KB per thread). */
export function allocatedTotal(): int {
    return unsafe.atomicLoad<i64>(allocatedEver)
}

/** The stop signal's handler: the thread stops here, unless it is allocating, in which case it stops after. */
function onStop(signal: i32): void {
    const t = threadRecord()
    if (unsafe.atomicLoad<i64>(unsafe.add(t, threadInAlloc)) !== 0) {
        unsafe.atomicStore<i64>(unsafe.add(t, threadStopRequested), 1)
        return
    }
    stopHere(t)
}

/**
 * Records the stack pointer and waits for the collection to end. The clobbers
 * make the function save every callee-saved register in its frame, above the
 * recorded stack pointer, so that pointers the thread held in registers are
 * scanned (in the signal handler, the kernel's frame holds them as well).
 */
//ore:noinline
function stopHere(t: ptr): void {
    if (target.arch === "arm64") unsafe.asm("", "~{x19},~{x20},~{x21},~{x22},~{x23},~{x24},~{x25},~{x26},~{x27},~{x28}")
    else unsafe.asm("", "~{rbx},~{r12},~{r13},~{r14},~{r15}")
    unsafe.atomicStore<i64>(unsafe.add(t, threadStopRequested), 0)
    unsafe.atomicStore<ptr>(unsafe.add(t, threadSp), currentSp())
    // A late signal, after the collection it was for, stops nothing.
    while (unsafe.atomicLoad<i64>(stoppingCell) !== 0) {
        // Acknowledged once per collection: one may start while the thread
        // still waits here for the previous one, and it waits on for that one.
        const generation = unsafe.atomicLoad<i64>(generationCell)
        if (unsafe.atomicLoad<i64>(unsafe.add(t, threadStoppedFor)) !== generation) {
            unsafe.atomicStore<i64>(unsafe.add(t, threadStoppedFor), generation)
        }
        nanosleep(pause, nil())
    }
}

function currentSp(): ptr {
    if (target.arch === "arm64") return unsafe.asm<ptr>("mov $0, sp", "=r")
    return unsafe.asm<ptr>("movq %rsp, $0", "=r")
}

// ---------------------------------------------------------------------------
// Marking, on several threads
//
// The collector marks from the roots on its own, then with helper threads:
// each marker has a stack of objects to scan, gives batches of it to a shared
// pool when the pool is empty, and takes from the pool when its stack is.
// An object belongs to the marker whose atomic `or` set its mark bit first.
// Marking ends when the pool is empty and every marker is idle, both seen
// under the pool's lock, which a marker holds to publish work. The helpers
// allocate nothing and run only while the world is stopped, so the collector
// does not stop them.

// A marker's record, in permanent memory: its stack, the stack's top and capacity.
const markerStack = 0
const markerTop = 8
const markerCap = 16
const markerSize = 24
/** The most markers, the collector included. */
const maxMarkers = 8
/** Objects moved to and from the pool at a time. */
const batch = 256

/** The markers' records; the collector is marker 0. */
/**
 * Holds 1 while the markers run alongside the program: the write barrier shades
 * the pointers that stores overwrite, and new objects are allocated marked.
 */
let markingCell: ptr
let markers: ptr
let markerCount: int
let poolLock: ptr
let pool: ptr
let poolCount: int
let poolCap: int
/** `poolCount` as markers outside the lock read it, to decide to share: a hint. */
let poolHint: ptr
/** How many markers wait for work, under `poolLock`. */
let idleMarkers: int
/** `idleMarkers` as markers outside the lock read it: while some are idle, the others share. */
let idleHint: ptr
/** The helpers sleep on `helperCond` until `markRound` changes, and count themselves in `helpersDone` at the end. */
let helperLock: ptr
let helperCond: ptr
let markRound: int
let helpersDone: ptr

function newMarker(): ptr {
    const m = permanent(markerSize)
    setField(m, markerCap, 1 << 14)
    setPointer(m, markerStack, mapMemory((1 << 14) * 8))
    return m
}

/** Starts the helpers: one per CPU besides the collector, at most `maxMarkers` in all, or ORE_GCPROCS. */
function startMarkers(): void {
    poolLock = permanentMutex()
    helperLock = permanentMutex()
    helperCond = permanentCond()
    helpersDone = permanent(8)
    poolHint = permanent(8)
    idleHint = permanent(8)
    poolCap = 1 << 14
    pool = mapMemory(poolCap * 8)
    markers = permanent(maxMarkers * 8)
    let wanted = cpuCount()
    const configured = getenv("ORE_GCPROCS")
    if (!isNil(configured)) {
        let n = 0
        let i = 0
        while (true) {
            const c = unsafe.load<u8>(unsafe.add(configured, i))
            if (c < 0x30 || c > 0x39) break
            n = n * 10 + i64(c - 0x30)
            i++
        }
        if (n > 0) wanted = n
    }
    if (wanted > maxMarkers) wanted = maxMarkers
    setPointer(markers, 0, newMarker())
    markerCount = 1
    while (markerCount < wanted) {
        const m = newMarker()
        if (!startThread(unsafe.functionAddress(helperMain), m)) break
        setPointer(markers, markerCount * 8, m)
        markerCount++
    }
}

/** A helper: marks in every collection, from the pool. */
function helperMain(m: ptr): ptr {
    let seen = 0
    while (true) {
        lock(helperLock)
        while (markRound === seen) pthread_cond_wait(helperCond, helperLock)
        seen = markRound
        unlock(helperLock)
        drain(m)
        unsafe.atomicAdd<i64>(helpersDone, 1)
    }
    return m
}

/**
 * `bytes` zeroed bytes for elements whose pointers `gcdata` describes: never
 * scanned when they have none, word by word for a nil `gcdata`.
 */
export function allocElements(bytes: int, gcdata: ptr): ptr {
    if (isNil(gcdata)) return alloc(bytes, false)
    const words = field(gcdata, 0) >> 3
    for (let w = 0; w < words; w += 64)
        if (field(gcdata, 8 + (w >> 6) * 8) !== 0) return allocTyped(bytes, false, gcdata)
    return alloc(bytes, true)
}

/** Marks the object that `p` points into, if it is an allocated object of the heap, on marker `m`. */
function mark(m: ptr, p: u64): void {
    const object = greyen(p)
    if (!isNil(object)) push(m, object)
}

/**
 * Marks the object that `p` points into, if it is an allocated object of the
 * heap not marked yet; returns it when it is to be scanned, nil otherwise.
 */
function greyen(p: u64): ptr {
    const offset = p - unsafe.toInt(heapBase)
    if (offset >= u64(nextPage * pageSize)) return nil()
    const span = pointerAt(pageTable, i64(offset >> 13) * 8)
    if (isNil(span)) return nil()
    const elemSize = field(span, spanElemSize)
    const index = i64(
        (u64(unsafe.diff(unsafe.fromInt(p), pointerAt(span, spanStart))) * u64(field(span, spanDivMul))) >> 32,
    )
    if (index >= field(span, spanElems)) return nil()
    if (!bit(pointerAt(span, spanAllocBits), index)) return nil()
    // The bitmaps are read as bytes elsewhere: little-endian words hold the same bits.
    const word = unsafe.add(pointerAt(span, spanMarkBits), (index >> 6) * 8)
    const mask = 1 << (index & 63)
    if ((unsafe.atomicOr<i64>(word, mask) & mask) !== 0) return nil()
    if (field(span, spanNoscan) !== 0) return nil()
    return unsafe.add(pointerAt(span, spanStart), index * elemSize)
}

// ---------------------------------------------------------------------------
// The write barrier
//
// While the markers run alongside the program, the collector keeps what was
// reachable when marking began (snapshot at the beginning): the stacks and
// the globals were scanned then, with the world stopped, and a store into the
// heap shades the pointer it overwrites, so that no object reachable at the
// start loses its last path unseen. Objects allocated meanwhile are marked
// already. Stores to locals and globals need no barrier: what they held at
// the start was scanned as a root.

/**
 * Before a store over `words` words at `slot` in the heap: shades what they
 * point to while marking runs. The compiler calls it before every store of
 * a value with pointers into an object.
 */
//ore:runtime ore_rt_write_barrier
export function writeBarrier(slot: ptr, words: int): void {
    // Before `init`, while the runtime's modules set up their globals, nothing is marking.
    if (isNil(markingCell) || unsafe.atomicLoad<i64>(markingCell) === 0) return
    shadeWords(slot, words)
}

/** Before a copy or a fill over `bytes` bytes at `to`: shades what the words there point to while marking runs. */
//ore:runtime ore_rt_write_barrier_range
export function writeBarrierRange(to: ptr, bytes: int): void {
    if (isNil(markingCell) || unsafe.atomicLoad<i64>(markingCell) === 0) return
    const from = unsafe.fromInt(unsafe.toInt(to) & ~u64(7))
    shadeWords(from, (unsafe.diff(to, from) + bytes) >> 3)
}

//ore:noinline
function shadeWords(slot: ptr, words: int): void {
    // A stop waits until the shaded objects are in the thread's buffer, where the collector finds them.
    const t = threadRecord()
    if (!isNil(t)) unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 1)
    for (let i = 0; i < words; i++) {
        const object = greyen(unsafe.load<u64>(unsafe.add(slot, i * 8)))
        if (!isNil(object)) shade(object)
    }
    if (isNil(t)) return
    unsafe.atomicStore<i64>(unsafe.add(t, threadInAlloc), 0)
    if (unsafe.atomicLoad<i64>(unsafe.add(t, threadStopRequested)) !== 0) stopHere(t)
}

/** Hands an object the barrier marked to the markers, through the thread's buffer. */
function shade(object: ptr): void {
    const t = threadRecord()
    if (isNil(t)) {
        lock(poolLock)
        addToPool(object)
        unlock(poolLock)
        return
    }
    let buffer = pointerAt(t, threadWbBuffer)
    if (isNil(buffer)) {
        buffer = permanent(wbCap * 8)
        setPointer(t, threadWbBuffer, buffer)
    }
    const n = field(t, threadWbCount)
    setPointer(buffer, n * 8, object)
    setField(t, threadWbCount, n + 1)
    if (n + 1 === wbCap) flushBarrier(t)
}

/** Moves the objects a thread's barrier shaded to the pool. */
function flushBarrier(t: ptr): void {
    const n = field(t, threadWbCount)
    if (n === 0) return
    const buffer = pointerAt(t, threadWbBuffer)
    lock(poolLock)
    for (let i = 0; i < n; i++) addToPool(pointerAt(buffer, i * 8))
    unlock(poolLock)
    setField(t, threadWbCount, 0)
}

/** Adds an object to scan to the pool; the caller holds `poolLock`. */
function addToPool(object: ptr): void {
    if (poolCount === poolCap) {
        const cap = poolCap < 64 ? 64 : poolCap * 2
        const grown = mapMemory(cap * 8)
        if (poolCount > 0) unsafe.copy(grown, pool, poolCount * 8)
        pool = grown
        poolCap = cap
    }
    setPointer(pool, poolCount * 8, object)
    poolCount++
    unsafe.atomicStore<i64>(poolHint, poolCount)
}

function push(m: ptr, object: ptr): void {
    const top = field(m, markerTop)
    if (top === field(m, markerCap)) {
        const cap = top * 2
        const grown = mapMemory(cap * 8)
        unsafe.copy(grown, pointerAt(m, markerStack), top * 8)
        setPointer(m, markerStack, grown)
        setField(m, markerCap, cap)
    }
    setPointer(pointerAt(m, markerStack), top * 8, object)
    setField(m, markerTop, top + 1)
}

/** Marks what the words in [from, from + size) point to. */
function scanOn(m: ptr, from: ptr, size: int): void {
    for (let i = 0; i + 8 <= size; i += 8) mark(m, unsafe.load<u64>(unsafe.add(from, i)))
}

/** Marks what the pointer words of the units of an object point to, as its `gcdata` says (see `allocTyped`). */
function scanTyped(m: ptr, object: ptr, size: int, gcdata: ptr): void {
    const unit = field(gcdata, 0)
    const words = unit >> 3
    for (let base = 0; base + unit <= size; base += unit) {
        for (let w = 0; w < words; w += 64) {
            let bits = unsafe.load<u64>(unsafe.add(gcdata, 8 + (w >> 6) * 8))
            while (bits !== 0) {
                const i = ctz(bits)
                mark(m, unsafe.load<u64>(unsafe.add(object, base + (w + i) * 8)))
                bits = bits & (bits - 1)
            }
        }
    }
}

/** The number of trailing zero bits of a word that is not zero. */
function ctz(x: u64): int {
    let n = 0
    let v = x
    while ((v & 1) === 0) {
        v = v >> 1
        n++
    }
    return n
}

/** Marks what the words in [from, from + size) point to: a root, scanned by the collector. */
export function scan(from: ptr, size: int): void {
    scanOn(pointerAt(markers, 0), from, size)
}

/** Marks what the words in [lo, hi) point to, for the stack of a parked task. */
export function scanRange(lo: ptr, hi: ptr): void {
    const from = unsafe.fromInt(unsafe.toInt(lo) & ~u64(7))
    scan(from, unsafe.diff(hi, from))
}

/** Moves a batch from the bottom of `m`'s stack to the pool; the caller holds `poolLock`. */
function share(m: ptr): void {
    const top = field(m, markerTop)
    const n = top < batch * 2 ? top / 2 : batch
    if (poolCount + n > poolCap) {
        const cap = (poolCount + n) * 2
        const grown = mapMemory(cap * 8)
        unsafe.copy(grown, pool, poolCount * 8)
        pool = grown
        poolCap = cap
    }
    const stack = pointerAt(m, markerStack)
    unsafe.copy(unsafe.add(pool, poolCount * 8), stack, n * 8)
    unsafe.copy(stack, unsafe.add(stack, n * 8), (top - n) * 8)
    poolCount += n
    unsafe.atomicStore<i64>(poolHint, poolCount)
    setField(m, markerTop, top - n)
}

/** Moves up to a batch from the pool to `m`'s stack; the caller holds `poolLock`. */
function take(m: ptr): void {
    const n = poolCount < batch ? poolCount : batch
    for (let i = 0; i < n; i++) {
        poolCount--
        push(m, pointerAt(pool, poolCount * 8))
    }
    unsafe.atomicStore<i64>(poolHint, poolCount)
}

/** Marks until there is nothing left to mark on any marker. */
function drain(m: ptr): void {
    while (true) {
        while (field(m, markerTop) > 0) {
            const top = field(m, markerTop) - 1
            setField(m, markerTop, top)
            const object = pointerAt(pointerAt(m, markerStack), top * 8)
            const span = pointerAt(pageTable, (unsafe.diff(object, heapBase) >> pageShift) * 8)
            const gcdata = pointerAt(pointerAt(span, spanTypes), objectIndex(span, object) * 8)
            if (isNil(gcdata)) scanOn(m, object, field(span, spanElemSize))
            else scanTyped(m, object, field(span, spanElemSize), gcdata)
            // Others are idle: give them half of the work.
            if (top >= 2 && unsafe.atomicLoad<i64>(idleHint) > 0 && unsafe.atomicLoad<i64>(poolHint) === 0) {
                lock(poolLock)
                if (poolCount === 0) share(m)
                unlock(poolLock)
            }
        }
        lock(poolLock)
        if (poolCount > 0) {
            take(m)
            unlock(poolLock)
            continue
        }
        idleMarkers++
        unsafe.atomicStore<i64>(idleHint, idleMarkers)
        while (true) {
            if (poolCount > 0) {
                idleMarkers--
                unsafe.atomicStore<i64>(idleHint, idleMarkers)
                take(m)
                break
            }
            if (idleMarkers === markerCount) {
                unlock(poolLock)
                return
            }
            unlock(poolLock)
            nanosleep(pause, nil())
            lock(poolLock)
        }
        unlock(poolLock)
    }
}

/** Stops every thread but this one; the caller holds `gcLock`. Returns how many it stopped. */
function stopWorld(self: ptr): int {
    // No worker is between two stacks while the collector holds the write side.
    unsafe.atomicOr<i64>(switchState, switchWriter)
    while ((unsafe.atomicLoad<i64>(switchState) & ~switchWriter) !== 0) nanosleep(pause, nil())
    const generation = unsafe.atomicAdd<i64>(generationCell, 1) + 1
    unsafe.atomicStore<i64>(stoppingCell, 1)
    let others = 0
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) {
        if (t === self) continue
        pthread_kill(pointerAt(t, threadId), stopSignal())
        others++
    }
    // Every other thread has stopped once it acknowledged this stop.
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) {
        if (t === self) continue
        while (unsafe.atomicLoad<i64>(unsafe.add(t, threadStoppedFor)) !== generation) nanosleep(pause, nil())
    }
    return others
}

/** Lets the threads `stopWorld` stopped run again. */
function startWorld(): void {
    unsafe.atomicStore<i64>(stoppingCell, 0)
    unsafe.atomicAnd<i64>(switchState, ~switchWriter)
}

/** Marks until there is nothing left to mark, on this thread and the helpers. */
function markAll(): void {
    idleMarkers = 0
    unsafe.atomicStore<i64>(idleHint, 0)
    unsafe.atomicStore<i64>(helpersDone, 0)
    if (markerCount > 1) {
        lock(helperLock)
        markRound++
        pthread_cond_broadcast(helperCond)
        unlock(helperLock)
    }
    drain(pointerAt(markers, 0))
    while (unsafe.atomicLoad<i64>(helpersDone) < markerCount - 1) nanosleep(pause, nil())
}

/**
 * Collects garbage, marking alongside the program: the world stops to scan
 * the roots and turn the write barrier on, runs while the markers mark what
 * was reachable then, and stops again to mark what the barrier shaded
 * meanwhile, turn it off and sweep.
 */
//ore:noinline
export function collect(): void {
    lock(gcLock)
    if (unsafe.atomicLoad<i64>(allocatedCell) < nextCollection) {
        // Another thread collected meanwhile.
        unlock(gcLock)
        return
    }
    const self = threadRecord()
    const start = nowNs(clock)
    const others = stopWorld(self)
    const stopped = nowNs(clock)
    collections++

    // The roots: this stack, the other threads' stacks, the parked tasks' stacks, the globals.
    if (target.arch === "arm64") unsafe.asm("", "~{x19},~{x20},~{x21},~{x22},~{x23},~{x24},~{x25},~{x26},~{x27},~{x28}")
    else unsafe.asm("", "~{rbx},~{r12},~{r13},~{r14},~{r15}")
    scanRange(currentSp(), pointerAt(self, threadBase))
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) {
        if (t !== self) scanRange(pointerAt(t, threadSp), pointerAt(t, threadBase))
    }
    if (!isNil(stackRootsHook)) {
        const hook = unsafe.load<() => void>(stackRootsHook)
        hook()
    }
    for (let i = 0; i < extraRootCount; i++) scan(pointerAt(extraRoots, i * 16), field(extraRoots, i * 16 + 8))
    const globals = ore_globals_table()
    const count = ore_globals_count()
    for (let i = 0; i < count; i++) scan(pointerAt(globals, i * 16), field(globals, i * 16 + 8))
    unsafe.atomicStore<i64>(markingCell, 1)
    const concurrent = concurrentMarking !== 0
    if (concurrent) startWorld()
    const resumed = nowNs(clock)

    markAll()
    const marked = nowNs(clock)
    if (concurrent) stopWorld(self)
    const stoppedAgain = nowNs(clock)
    // What the barrier shaded since: in the threads' buffers and the pool.
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) flushBarrier(t)
    markAll()
    unsafe.atomicStore<i64>(markingCell, 0)
    const terminated = nowNs(clock)
    sweep()
    startWorld()
    const end = nowNs(clock)
    const number = collections
    unlock(gcLock)
    if (trace !== 0) {
        dprintf(
            2,
            "gc %ld: %ld KB live, %ld KB heap (%ld KB released), %ld threads, %ld markers, pauses %ld + %ld us (roots %ld; finish %ld, sweep %ld), marking %ld us\n",
            number,
            liveBytes >> 10,
            heapSize() >> 10,
            releasedBytes >> 10,
            others + 1,
            markerCount,
            (resumed - start) / 1000,
            (end - stoppedAgain) / 1000 + (stoppedAgain - marked) / 1000,
            (resumed - stopped) / 1000,
            (terminated - stoppedAgain) / 1000,
            (end - terminated) / 1000,
            (marked - resumed) / 1000,
        )
    }
}

// ---------------------------------------------------------------------------
// Sweeping

/** The number of bits set in `x`. */
function popcount(x: u64): int {
    let v = x - ((x >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0f0f0f0f0f0f0f0f
    return i64((v * 0x0101010101010101) >> 56)
}

/** Frees every unmarked object: the marks become the allocation bits. The world is stopped. */
function sweep(): void {
    for (let c = 0; c < classCount * 2; c++) setPointer(partial, c * 8, nil())
    for (let t = threads; !isNil(t); t = pointerAt(t, threadNext)) {
        unsafe.fill(unsafe.add(t, threadCache), 0, maxClasses * 16)
    }
    liveBytes = 0
    let kept = 0
    for (let s = 0; s < spanCount; s++) {
        const span = pointerAt(spans, s * 8)
        const marks = pointerAt(span, spanMarkBits)
        const elems = field(span, spanElems)
        let live = 0
        // Bits past `elems` are never set: count whole words.
        for (let w = 0; w < (elems + 63) / 64; w++) live += popcount(unsafe.load<u64>(unsafe.add(marks, w * 8)))
        if (live === 0) {
            releaseSpan(span)
            continue
        }
        liveBytes += live * field(span, spanElemSize)
        const bits = pointerAt(span, spanAllocBits)
        // A freed object is no longer growable: its slot may hold anything next.
        const grow = pointerAt(span, spanGrowBits)
        for (let w = 0; w < (elems + 63) / 64; w++) {
            const at = unsafe.add(grow, w * 8)
            unsafe.store<u64>(at, unsafe.load<u64>(at) & unsafe.load<u64>(unsafe.add(marks, w * 8)))
        }
        setPointer(span, spanAllocBits, marks)
        setPointer(span, spanMarkBits, bits)
        unsafe.fill(bits, 0, bitmapSize)
        setField(span, spanFreeIndex, 0)
        const cls = field(span, spanClass)
        if (live < elems && cls >= 0) {
            const list = unsafe.add(partial, (cls * 2 + field(span, spanNoscan)) * 8)
            setPointer(span, spanNext, unsafe.load<ptr>(list))
            unsafe.store<ptr>(list, span)
        }
        setPointer(spans, kept * 8, span)
        kept++
    }
    spanCount = kept
    unsafe.atomicStore<i64>(allocatedCell, 0)
    nextCollection = budget(liveBytes)
    scavenge()
}

/** Bytes of the heap's pages given back to the system and not used since. */
let releasedBytes: int

/**
 * Gives the pages of free runs back to the system once more than half of the
 * heap's pages are free: they stay reserved, and come back (zeroed) when a
 * span uses them again.
 */
function scavenge(): void {
    let free = 0
    for (let run = freeRuns; !isNil(run); run = pointerAt(run, spanNext)) free += field(run, spanPages)
    if (free * 2 < nextPage) return
    // MADV_FREE_REUSABLE on macOS, which the kernel counts out of the footprint at once; MADV_DONTNEED on Linux.
    const advice: i32 = target.os === "darwin" ? 7 : 4
    for (let run = freeRuns; !isNil(run); run = pointerAt(run, spanNext)) {
        if (field(run, spanReleased) !== 0) continue
        const bytes = field(run, spanPages) * pageSize
        if (madvise(pointerAt(run, spanStart), u64(bytes), advice) === 0) releasedBytes += bytes
        setField(run, spanReleased, 1)
    }
}

/**
 * The pacer: how many bytes the program may allocate before the next
 * collection, given the live heap after this one. `ORE_GOGC` percent of the
 * live heap (at least `minHeap`), and less as the live heap nears
 * `ORE_MEMLIMIT`, down to a quarter of `minHeap`.
 */
function budget(live: int): int {
    let allowed = gcPercent < 0 ? 1 << 62 : (live * gcPercent) / 100
    if (allowed < minHeap) allowed = minHeap
    if (memoryLimit > 0) {
        const room = memoryLimit - live
        if (room < allowed) allowed = room > minHeap / 4 ? room : minHeap / 4
    }
    return allowed
}

/**
 * A number from the environment: digits with an optional K, M or G suffix
 * (powers of 1024), or `off` for -1; `fallback` when unset or unreadable.
 */
function envNumber(name: string, fallback: int): int {
    const p = getenv(name)
    if (isNil(p)) return fallback
    if (unsafe.load<u8>(p) === 0x6f) return -1
    let n = 0
    let i = 0
    let digits = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(p, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        digits++
        i++
    }
    if (digits === 0) return fallback
    const unit = unsafe.load<u8>(unsafe.add(p, i))
    if (unit === 0x4b || unit === 0x6b) return n << 10
    if (unit === 0x4d || unit === 0x6d) return n << 20
    if (unit === 0x47 || unit === 0x67) return n << 30
    return n
}

// ---------------------------------------------------------------------------
// Statistics

/** Bytes of the heap that were live after the last collection. */
export function live(): int {
    return liveBytes
}

/** Bytes of address space the heap has used. */
export function heapSize(): int {
    return nextPage * pageSize
}

/** Bytes of the heap given back to the system and not used since. */
export function releasedSize(): int {
    return releasedBytes
}

export function collectionCount(): int {
    return collections
}
