// Strings and bytes, as the globals of JavaScript's hosts: the classes
// `TextEncoder` and `TextDecoder` (UTF-8, the only encoding), and `atob` and
// `btoa` (base64). Bytes are `u8[]`, where JavaScript has a `Uint8Array`.

import { decode, decodedValid, encode } from "ore:runtime/unicode"

/** What `TextEncoder.encodeInto` read and wrote: bytes of the string (JavaScript counts UTF-16 code units) and bytes of the array. */
export type TextEncoderEncodeIntoResult = { read: int; written: int }

/** The length in bytes of the UTF-8 character that starts with `b`, 0 when no character starts with it. */
function charLength(b: u8): int {
    if (b < 0x80) return 1
    if (b >= 0xc2 && b <= 0xdf) return 2
    if (b >= 0xe0 && b <= 0xef) return 3
    if (b >= 0xf0 && b <= 0xf4) return 4
    return 0
}

/**
 * The length of the valid UTF-8 character at `at` in `bytes`, which end at
 * `stop`, or minus the length of the longest prefix of one there (at least
 * 1), which decodes as one U+FFFD, as the Encoding Standard's decoder reads
 * it.
 */
function validAt(bytes: u8[], at: int, stop: int): int {
    const b = bytes[at]
    const n = charLength(b)
    if (n === 1) return 1
    if (n === 0) return -1
    for (let i = 1; i < n; i++) {
        if (at + i >= stop) return -i
        const c = bytes[at + i]
        // The second byte's range rules out overlong forms, surrogates and values past U+10FFFF.
        let lo: u8 = 0x80
        let hi: u8 = 0xbf
        if (i === 1 && b === 0xe0) lo = 0xa0
        if (i === 1 && b === 0xed) hi = 0x9f
        if (i === 1 && b === 0xf0) lo = 0x90
        if (i === 1 && b === 0xf4) hi = 0x8f
        if (c < lo || c > hi) return -i
    }
    return n
}

/**
 * The string of the UTF-8 `bytes` from `start` to `stop`, invalid sequences
 * replaced by U+FFFD; panics on one when `fatal`.
 */
export function decodeBytes(bytes: u8[], start: int, stop: int, fatal: bool): string {
    const out = unsafe.allocBytes((stop - start) * 3)
    let n = 0
    let at = start
    while (at < stop) {
        const k = validAt(bytes, at, stop)
        if (k > 0) {
            for (let i = 0; i < k; i++) unsafe.store<u8>(unsafe.add(out, n + i), bytes[at + i])
            n += k
            at += k
        } else {
            if (fatal) process.panic("TypeError: The encoded data was not valid for encoding utf-8")
            n += encode(unsafe.add(out, n), 0xfffd)
            at -= k
        }
    }
    return unsafe.makeString(out, n)
}

/**
 * Encodes strings as UTF-8 bytes: `new TextEncoder().encode("é")` is
 * `[195, 169]`. Bytes of a string that are not valid UTF-8 encode as
 * U+FFFD, as JavaScript encodes a lone surrogate.
 */
export class TextEncoder {
    /** Always `"utf-8"`. */
    readonly encoding = "utf-8"

    /** The UTF-8 bytes of a string. */
    encode(input: string = ""): u8[] {
        const s = input.toWellFormed()
        const out: u8[] = []
        for (let i = 0; i < s.length; i++) out.push(s[i])
        return out
    }

    /**
     * Writes the UTF-8 bytes of `source` into `destination` from its start,
     * the whole characters that fit, and tells how many bytes it read and
     * wrote.
     */
    encodeInto(source: string, destination: u8[]): TextEncoderEncodeIntoResult {
        const p = unsafe.stringData(source)
        let read = 0
        let written = 0
        while (read < source.length) {
            const q = unsafe.add(p, read)
            const r = decode(q, source.length - read)
            // An invalid byte is read alone and written as U+FFFD.
            const valid = decodedValid(q, r)
            const n = valid ? r & 7 : 3
            if (written + n > destination.length) break
            if (valid) for (let i = 0; i < n; i++) destination[written + i] = source[read + i]
            else {
                destination[written] = 0xef
                destination[written + 1] = 0xbf
                destination[written + 2] = 0xbd
            }
            read += r & 7
            written += n
        }
        return { read, written }
    }
}

/** The options of `new TextDecoder`. */
export type TextDecoderOptions = { fatal?: bool; ignoreBOM?: bool }

/**
 * Decodes UTF-8 bytes as strings: `new TextDecoder().decode([195, 169])` is
 * `"é"`. A sequence that is not valid UTF-8 decodes as U+FFFD (the longest
 * prefix of a character as one), or panics with `fatal`; a leading byte
 * order mark is dropped unless `ignoreBOM`.
 */
export class TextDecoder {
    /** Always `"utf-8"`. */
    readonly encoding = "utf-8"
    /** Whether an invalid sequence panics instead of decoding as U+FFFD. */
    readonly fatal: bool
    /** Whether a leading byte order mark is kept. */
    readonly ignoreBOM: bool

    /** A decoder of `label`'s encoding: only UTF-8, as `"utf-8"`, `"utf8"` or `"unicode-1-1-utf-8"` in any case. */
    constructor(label: string = "utf-8", options: TextDecoderOptions = {}) {
        const name = label.trim().toLowerCase()
        if (name !== "utf-8" && name !== "utf8" && name !== "unicode-1-1-utf-8")
            process.panic(`RangeError: The "${label}" encoding is not supported`)
        this.fatal = options.fatal ?? false
        this.ignoreBOM = options.ignoreBOM ?? false
    }

    /** The string of UTF-8 bytes. */
    decode(input: u8[] = []): string {
        const bom = !this.ignoreBOM && input.length >= 3 && input[0] === 0xef && input[1] === 0xbb && input[2] === 0xbf
        return decodeBytes(input, bom ? 3 : 0, input.length, this.fatal)
    }
}

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/** The value of a base64 digit, -1 for another byte. */
function digit(b: u8): int {
    if (b >= 0x41 && b <= 0x5a) return i64(b) - 0x41
    if (b >= 0x61 && b <= 0x7a) return i64(b) - 0x61 + 26
    if (b >= 0x30 && b <= 0x39) return i64(b) - 0x30 + 52
    if (b === 0x2b) return 62
    if (b === 0x2f) return 63
    return -1
}

/**
 * The base64 of a binary string, each of whose characters is a byte
 * (U+0000 to U+00FF): `btoa("hello")` is `"aGVsbG8="`. Panics on another
 * character, as JavaScript throws.
 */
export function btoa(data: string): string {
    const bytes: int[] = []
    for (const r of data) {
        if (r > 0xff) process.panic("InvalidCharacterError: Invalid character")
        bytes.push(i64(r))
    }
    const parts: string[] = []
    for (let i = 0; i < bytes.length; i += 3) {
        const n = bytes.length - i
        const v = (bytes[i] << 16) | ((n > 1 ? bytes[i + 1] : 0) << 8) | (n > 2 ? bytes[i + 2] : 0)
        parts.push(alphabet.charAt((v >> 18) & 63))
        parts.push(alphabet.charAt((v >> 12) & 63))
        parts.push(n > 1 ? alphabet.charAt((v >> 6) & 63) : "=")
        parts.push(n > 2 ? alphabet.charAt(v & 63) : "=")
    }
    return parts.join("")
}

/**
 * The binary string of base64 text, each byte a character U+0000 to
 * U+00FF: `atob("aGVsbG8=")` is `"hello"`. ASCII whitespace is skipped and
 * the padding may be left out; other text panics, as JavaScript throws.
 */
export function atob(data: string): string {
    const digits: int[] = []
    for (let i = 0; i < data.length; i++) {
        const b = data[i]
        if (b === 0x20 || b === 0x09 || b === 0x0a || b === 0x0c || b === 0x0d) continue
        digits.push(b === 0x3d ? -2 : digit(b))
    }
    // Up to two `=` at the end of a multiple of four digits.
    let n = digits.length
    if (n % 4 === 0 && n > 0 && digits[n - 1] === -2) {
        n--
        if (digits[n - 1] === -2) n--
    }
    for (let i = 0; i < n; i++) if (digits[i] < 0) process.panic("InvalidCharacterError: Invalid character")
    if (n % 4 === 1) process.panic("InvalidCharacterError: The string to be decoded is not correctly encoded.")
    const out: string[] = []
    let v = 0
    let bits = 0
    for (let i = 0; i < n; i++) {
        v = (v << 6) | digits[i]
        bits += 6
        if (bits >= 8) {
            bits -= 8
            out.push(String.fromCodePoint((v >> bits) & 0xff))
        }
    }
    return out.join("")
}
