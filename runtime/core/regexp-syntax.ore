/**
 * The characters that ignoring case with the flag `u` or `v` takes as one
 * (the same simple case folding), in groups of two or more, in runs of
 * groups of the same shape: the distance from the first character of
 * the group before - 1, how many groups - 1, the distance between their
 * first characters - 1, how many next characters in a group, and each
 * as its distance from the one before - 1.
 */
function foldOrbits(): string {
    return ""
}

/**
 * The same without `u` or `v`, where the canonical case is the uppercase
 * when it is one character (not an ASCII one for another), of the
 * characters up to U+FFFF.
 */
function caseOrbits(): string {
    return ""
}

// End of the tables.

/** The value of a digit of a table: 0-31 ends a number, 32-63 continues it. */
function tableDigit(b: int): int {
    if (b >= 48 && b <= 57) return b - 48
    if (b >= 65 && b <= 90) return b - 55
    if (b >= 97 && b <= 122) return b - 61
    return b === 43 ? 62 : 63
}

/** The numbers of a table. */
function tableNumbers(text: string): int[] {
    const out: int[] = []
    let n = 0
    for (let i = 0; i < text.length; i++) {
        const d = tableDigit(int(text[i]))
        n = n * 32 + (d & 31)
        if (d < 32) {
            out.push(n)
            n = 0
        }
    }
    return out
}

/** The ranges of a table of gaps and lengths, sorted. */
function tableRanges(text: string): int[] {
    const n = tableNumbers(text)
    const out: int[] = []
    let previous = -1
    for (let i = 0; i < n.length; i += 2) {
        const start = previous + 1 + n[i]
        previous = start + n[i + 1]
        out.push(start)
        out.push(previous)
    }
    return out
}

/**
 * The characters of a table of runs over all characters (`categoryRuns`,
 * `scriptRuns`) whose value has its index in `wanted` true, sorted.
 */
function runRanges(text: string, wanted: bool[]): int[] {
    const n = tableNumbers(text)
    const out: int[] = []
    let start = 0
    for (let i = 0; i < n.length; i += 2) {
        const last = start + n[i]
        if (n[i + 1] < wanted.length && wanted[n[i + 1]]) {
            const k = out.length
            if (k > 0 && out[k - 1] === start - 1) {
                out[k - 1] = last
            } else {
                out.push(start)
                out.push(last)
            }
        }
        start = last + 1
    }
    return out
}

/** The characters in one of two sorted ranges but not in both. */
function symmetricDifference(a: int[], b: int[]): int[] {
    const all = intersect(a, complement(b))
    for (const r of intersect(b, complement(a))) all.push(r)
    return normalize(all)
}

/** The values of `categoryOrder` that a General_Category value is, by any of its names, joined by commas; or "". */
function categoryLeaves(value: string): string {
    for (const line of categoryNames()) {
        const colon = line.indexOf(":")
        for (const name of line.slice(0, colon).split(",")) if (name === value) return line.slice(colon + 1)
    }
    return ""
}

/** The characters of General_Category values of `categoryOrder`, joined by commas. */
function categoryRanges(leaves: string): int[] {
    const wanted: bool[] = []
    const names = leaves.split(",")
    for (const value of categoryOrder().split(",")) wanted.push(names.includes(value))
    return runRanges(categoryRuns(), wanted)
}

/** The index of a script by any of its names, or -1. */
function scriptIndex(value: string): int {
    const scripts = scriptNames().split(";")
    for (let i = 0; i < scripts.length; i++) for (const name of scripts[i].split(",")) if (name === value) return i
    return -1
}

/**
 * The characters of a script, by index: those of that Script, or with
 * `extensions` those whose Script_Extensions have it.
 */
function scriptRanges(index: int, extensions: bool): int[] {
    const wanted: bool[] = []
    for (let i = 0; i <= index; i++) wanted.push(i === index)
    const ranges = runRanges(scriptRuns(), wanted)
    if (!extensions) return ranges
    const n = tableNumbers(scriptExtensions())
    const listed: int[] = []
    const has: int[] = []
    let previous = -1
    let i = 0
    while (i < n.length) {
        const start = previous + 1 + n[i]
        previous = start + n[i + 1]
        const count = n[i + 2] + 1
        listed.push(start)
        listed.push(previous)
        for (let k = 0; k < count; k++) {
            if (n[i + 3 + k] === index) {
                has.push(start)
                has.push(previous)
            }
        }
        i += 3 + count
    }
    const all = intersect(ranges, complement(listed))
    for (const r of has) all.push(r)
    return normalize(all)
}

/** The characters of a binary property of `binaryProperties` by any of its names, or null for another name. */
function binaryRanges(value: string): int[] | null {
    for (const entry of binaryProperties()) {
        if (!entry[0].split(",").includes(value)) continue
        const own = tableRanges(entry[2])
        if (entry[1] === "") return own
        // The base: General_Category values and other properties.
        const leaves: string[] = []
        const base: int[] = []
        for (const part of entry[1].split(",")) {
            if (categoryOrder().split(",").includes(part)) {
                leaves.push(part)
            } else {
                for (const r of binaryRanges(part)!) base.push(r)
            }
        }
        if (leaves.length > 0) for (const r of categoryRanges(leaves.join(","))) base.push(r)
        return symmetricDifference(normalize(base), own)
    }
    return null
}

/**
 * The characters of a property of strings (RGI_Emoji, all of
 * `stringProperties`, or one of them) by name, or null for another name;
 * its strings into `strings`.
 */
function stringRanges(value: string, strings: int[][]): int[] | null {
    const all = value === "RGI_Emoji"
    const ranges: int[] = []
    let found = false
    let points: int[] = []
    for (const entry of stringProperties()) {
        if (!all && entry[0] !== value) continue
        if (!found) {
            for (const r of tableRanges(stringPoints())) points.push(r)
            const list: int[] = []
            for (let i = 0; i < points.length; i += 2) for (let c = points[i]; c <= points[i + 1]; c++) list.push(c)
            points = list
            found = true
        }
        for (const r of tableRanges(entry[1])) ranges.push(r)
        const n = tableNumbers(entry[2])
        let before: int[] = []
        let i = 0
        while (i < n.length) {
            const s = before.slice(0, n[i])
            const more = n[i + 1] + 1
            for (let k = 0; k < more; k++) s.push(points[n[i + 2 + k]])
            strings.push(s)
            before = s
            i += 2 + more
        }
    }
    return found ? normalize(ranges) : null
}

/**
 * The characters of a property of `\p{...}` into `out`, sorted: a
 * General_Category value (`L`, `Lu`, `gc=Lu`, `General_Category=Letter`...),
 * a script (`sc=Greek`, `Script=Grek`), the characters with a script among
 * their Script_Extensions (`scx=Greek`, `Script_Extensions=Grek`), a binary
 * property (`Alphabetic`, `Emoji`, `Any`, `ASCII`, `Assigned`...) or, with
 * the flag `v` (`sets`), a property of strings (`RGI_Emoji`...), whose
 * strings go into `strings`. Returns false for another name.
 */
function propertyRanges(text: string, sets: bool, out: int[], strings: int[][]): bool {
    const eq = text.indexOf("=")
    let ranges: int[] | null = null
    if (eq >= 0) {
        const name = text.slice(0, eq)
        const value = text.slice(eq + 1)
        if (name === "General_Category" || name === "gc") {
            const leaves = categoryLeaves(value)
            if (leaves !== "") ranges = categoryRanges(leaves)
        } else if (name === "Script" || name === "sc" || name === "Script_Extensions" || name === "scx") {
            const index = scriptIndex(value)
            if (index >= 0) ranges = scriptRanges(index, name === "Script_Extensions" || name === "scx")
        }
    } else if (text === "Any") {
        ranges = [0, 0x10ffff]
    } else if (text === "ASCII") {
        ranges = [0, 127]
    } else if (text === "Assigned") {
        ranges = complement(categoryRanges("Cn"))
    } else {
        const leaves = categoryLeaves(text)
        ranges = leaves !== "" ? categoryRanges(leaves) : binaryRanges(text)
        if (ranges === null && sets) ranges = stringRanges(text, strings)
    }
    if (ranges === null) return false
    for (const r of ranges) out.push(r)
    return true
}

// -----------------------------------------------------------------------------
// Parsing

class Parser {
    pos = 0
    error = ""
    /** The name of each group, by number; group 0 is the whole match. */
    /**
     * For each group, the alternatives it is in: pairs of a disjunction's
     * number and the alternative's index, outermost first; two groups of one
     * name must be in different alternatives of a disjunction (ES2025).
     */
    paths: int[][] = [[]]
    /** The disjunctions open at the position, as pairs like those of `paths`. */
    path: int[] = []
    disjunctions = 0
    names: string[] = [""]
    /** The number of groups in the whole pattern, which tells `\10` a backreference from an escape. */
    total = 0
    /** Whether the pattern has named groups, in which `\k` must name one. */
    named = false
    /** The backreferences by name, resolved at the end. */
    references: Node[] = []
    /** The `u` or `v` flag: the stricter syntax, `\u{...}` and `\p{...}`. */
    unicode = false
    /** The `v` flag: classes with nested classes and the operators `--` and `&&`. */
    sets = false
    /** Whether the last group read was a lookahead or a lookbehind, which a quantifier may follow only without `u` and for a lookahead. */
    look = false
    /** The character of the last `setOperand`, or -1 when it was a class. */
    single = -1
    /** The flags `v` and `i`: the operands of a class are closed under case (`closeCase`). */
    caseless = false
    /** The flags `u` (or `v`) and `i`: `\w` has ſ and the Kelvin sign too. */
    folded = false
    /** The strings of the last `setOperand` or `classSetBody`: those of `\q{...}` that are not one character. */
    strings: int[][] = []
    /** Whether the last `setOperand` or `classSetBody` may hold strings, which a negated class may not. */
    mayStrings = false

    constructor(readonly text: string) {}

    parse(): Node {
        this.countGroups()
        const root = this.disjunction()
        if (this.error !== "") return root
        if (this.pos < this.text.length) {
            // Only `)` stops a disjunction before the end.
            this.fail("Unmatched ')'")
            return root
        }
        for (const ref of this.references) {
            let found = false
            for (let i = 1; i < this.names.length; i++) {
                if (this.names[i] !== ref.name) continue
                // A name of several groups: at most one takes part, and the others match empty.
                if (found) ref.alsoGroups.push(i)
                else ref.value = i
                found = true
            }
            if (!found) this.fail("Invalid named capture referenced")
        }
        return root
    }

    fail(message: string): Node {
        if (this.error === "") this.error = message
        return new Node(K_EMPTY, 0)
    }

    /** The groups of the pattern counted ahead, and whether any is named. */
    countGroups() {
        const t = this.text
        let inClass = false
        for (let i = 0; i < t.length; i++) {
            const c = t[i]
            if (c === 92) i++
            else if (c === 91) inClass = true
            else if (c === 93) inClass = false
            else if (c === 40 && !inClass) {
                if (i + 1 < t.length && t[i + 1] === 63) {
                    // `(?<name>`, but not `(?<=` or `(?<!`.
                    if (i + 3 < t.length && t[i + 2] === 60 && t[i + 3] !== 61 && t[i + 3] !== 33) {
                        this.total++
                        this.named = true
                    }
                } else {
                    this.total++
                }
            }
        }
    }

    atEnd(): bool {
        return this.pos >= this.text.length
    }

    /** The byte at the position, or -1 at the end. */
    peek(): int {
        return this.pos < this.text.length ? int(this.text[this.pos]) : -1
    }

    peekAt(offset: int): int {
        const i = this.pos + offset
        return i < this.text.length ? int(this.text[i]) : -1
    }

    /** The character at the position, decoded from UTF-8, and the position moved past it. */
    char(): int {
        const t = this.text
        const b = int(t[this.pos])
        let n = 1
        let c = b
        if (b >= 0xf0 && b < 0xf8) {
            n = 4
            c = b & 7
        } else if (b >= 0xe0) {
            n = 3
            c = b & 15
        } else if (b >= 0xc0) {
            n = 2
            c = b & 31
        }
        if (b >= 0x80 && (b < 0xc0 || b >= 0xf8 || this.pos + n > t.length)) {
            this.pos++
            return 0xfffd
        }
        for (let k = 1; k < n; k++) {
            const x = int(t[this.pos + k])
            if ((x & 0xc0) !== 0x80) {
                this.pos++
                return 0xfffd
            }
            c = (c << 6) | (x & 63)
        }
        this.pos += n
        return c
    }

    disjunction(): Node {
        const id = this.disjunctions++
        this.path.push(id)
        this.path.push(0)
        const first = this.alternative()
        if (this.peek() !== 124) {
            this.path.pop()
            this.path.pop()
            return first
        }
        const alt = new Node(K_ALT, 0)
        alt.kids.push(first)
        let index = 0
        while (this.peek() === 124 && this.error === "") {
            this.pos++
            this.path[this.path.length - 1] = ++index
            alt.kids.push(this.alternative())
        }
        this.path.pop()
        this.path.pop()
        return alt
    }

    /** Whether the groups of these paths can both take part in a match: no disjunction has them in different alternatives. */
    together(a: int[], b: int[]): bool {
        for (let i = 0; i + 1 < a.length; i += 2)
            for (let j = 0; j + 1 < b.length; j += 2) if (a[i] === b[j] && a[i + 1] !== b[j + 1]) return false
        return true
    }

    alternative(): Node {
        const seq = new Node(K_SEQ, 0)
        while (!this.atEnd() && this.error === "") {
            const c = this.peek()
            if (c === 124 || c === 41) break
            const term = this.term()
            if (this.error !== "") break
            seq.kids.push(term)
        }
        if (seq.kids.length === 1) return seq.kids[0]
        return seq
    }

    /** An atom or an assertion, with its quantifier. */
    term(): Node {
        const c = this.peek()
        if (c === 94) {
            this.pos++
            return this.unquantifiable(new Node(K_BOL, 0))
        }
        if (c === 36) {
            this.pos++
            return this.unquantifiable(new Node(K_EOL, 0))
        }
        if (c === 92 && (this.peekAt(1) === 98 || this.peekAt(1) === 66)) {
            const negate = this.peekAt(1) === 66 ? 1 : 0
            this.pos += 2
            return this.unquantifiable(new Node(K_WORD, negate))
        }
        if (c === 42 || c === 43 || c === 63) return this.fail("Nothing to repeat")
        if (c === 123 && this.quantifierAhead()) return this.fail("Nothing to repeat")
        if (this.unicode && (c === 123 || c === 125 || c === 93)) return this.fail("Lone quantifier brackets")
        // A lookaround written as this atom, not one inside a group that is: `(?:(?<=a))*` repeats a group.
        const lookaround = this.lookaroundAhead()
        this.look = false
        const atom = this.atom()
        if (this.error !== "") return atom
        if (lookaround !== 0 && (this.unicode || lookaround === 2)) {
            const q = this.peek()
            if (q === 42 || q === 43 || q === 63 || (q === 123 && this.quantifierAhead()))
                return this.fail("Invalid quantifier")
            return atom
        }
        return this.quantified(atom)
    }

    /** Whether the atom at the position is a lookaround: 0 for none, 1 for `(?=` or `(?!`, 2 for `(?<=` or `(?<!`. */
    lookaroundAhead(): int {
        const t = this.text
        const i = this.pos
        if (i + 2 >= t.length || t[i] !== 40 || t[i + 1] !== 63) return 0
        const c = t[i + 2]
        if (c === 61 || c === 33) return 1
        return c === 60 && i + 3 < t.length && (t[i + 3] === 61 || t[i + 3] === 33) ? 2 : 0
    }

    /** An assertion, which no quantifier may follow. */
    unquantifiable(node: Node): Node {
        const c = this.peek()
        if (c === 42 || c === 43 || c === 63 || (c === 123 && this.quantifierAhead()))
            return this.fail("Nothing to repeat")
        return node
    }

    /** Whether a `{` at the position starts a quantifier: `{n}`, `{n,}` or `{n,m}`. */
    quantifierAhead(): bool {
        let i = this.pos + 1
        const t = this.text
        const start = i
        while (i < t.length && isDigit(int(t[i]))) i++
        if (i === start || i >= t.length) return false
        if (t[i] === 125) return true
        if (t[i] !== 44) return false
        i++
        while (i < t.length && isDigit(int(t[i]))) i++
        return i < t.length && t[i] === 125
    }

    /** A decimal number at the position, at most `limit` (larger ones stay `limit`). */
    number(limit: int): int {
        let n = 0
        while (isDigit(this.peek())) {
            n = n * 10 + this.peek() - 48
            if (n > limit) n = limit
            this.pos++
        }
        return n
    }

    quantified(atom: Node): Node {
        const c = this.peek()
        let min = 0
        let max = 0
        if (c === 42) {
            min = 0
            max = unbounded
            this.pos++
        } else if (c === 43) {
            min = 1
            max = unbounded
            this.pos++
        } else if (c === 63) {
            min = 0
            max = 1
            this.pos++
        } else if (c === 123 && this.quantifierAhead()) {
            const limit = 1000000000
            this.pos++
            min = this.number(limit)
            max = min
            if (this.peek() === 44) {
                this.pos++
                max = isDigit(this.peek()) ? this.number(limit) : unbounded
            }
            this.pos++
            if (max !== unbounded && max < min) return this.fail("numbers out of order in {} quantifier")
        } else if (c === 123 && this.unicode) {
            return this.fail("Incomplete quantifier")
        } else {
            return atom
        }
        const repeat = new Node(K_REPEAT, 0)
        repeat.min = min
        repeat.max = max
        if (this.peek() === 63) {
            repeat.greedy = false
            this.pos++
        }
        repeat.kids.push(atom)
        return repeat
    }

    atom(): Node {
        const c = this.peek()
        if (c === 46) {
            this.pos++
            return new Node(K_ANY, 0)
        }
        if (c === 40) return this.group()
        if (c === 91) return this.sets ? this.classSet() : this.characterClass()
        if (c === 92) return this.atomEscape()
        const start = this.pos
        const node = new Node(K_CHAR, this.char())
        node.from = start
        node.to = this.pos
        return node
    }

    group(): Node {
        this.pos++
        let node: Node
        if (this.peek() === 63) {
            const kind = this.peekAt(1)
            if (kind === 58) {
                this.pos += 2
                node = this.disjunction()
            } else if (kind === 61 || kind === 33) {
                this.pos += 2
                node = new Node(K_LOOK, kind === 33 ? 1 : 0)
                node.kids.push(this.disjunction())
                this.look = true
            } else if (kind === 60 && (this.peekAt(2) === 61 || this.peekAt(2) === 33)) {
                const negate = this.peekAt(2) === 33 ? 1 : 0
                this.pos += 3
                node = new Node(K_LOOKBEHIND, negate)
                node.kids.push(this.disjunction())
                this.look = true
            } else if (kind === 60) {
                this.pos += 2
                const name = this.groupName()
                if (this.error !== "") return new Node(K_EMPTY, 0)
                // The same name in different alternatives names one group in effect (ES2025).
                for (let g = 1; g < this.names.length; g++)
                    if (this.names[g] === name && this.together(this.paths[g], this.path))
                        return this.fail("Duplicate capture group name")
                node = new Node(K_GROUP, this.names.length)
                this.names.push(name)
                this.paths.push(this.path.slice())
                node.kids.push(this.disjunction())
            } else {
                return this.fail("Invalid group")
            }
        } else {
            node = new Node(K_GROUP, this.names.length)
            this.names.push("")
            this.paths.push(this.path.slice())
            node.kids.push(this.disjunction())
        }
        if (this.error !== "") return node
        if (this.peek() !== 41) return this.fail("Unterminated group")
        this.pos++
        return node
    }

    /** A group's name after `<`, and its `>`. */
    groupName(): string {
        const start = this.pos
        while (!this.atEnd() && this.peek() !== 62) {
            const at = this.pos
            const c = this.char()
            if (!isNameChar(c, at === start)) {
                this.fail("Invalid capture group name")
                return ""
            }
        }
        if (this.atEnd() || this.pos === start) {
            this.fail("Invalid capture group name")
            return ""
        }
        const name = this.text.slice(start, this.pos)
        this.pos++
        return name
    }

    /** An escape outside a class, after which the position is past it. */
    atomEscape(): Node {
        this.pos++
        if (this.atEnd()) return this.fail("\\ at end of pattern")
        const c = this.peek()
        if (c >= 49 && c <= 57) {
            // `\1`..: a backreference when there are that many groups, else an octal escape or the digit.
            const start = this.pos
            const n = this.number(1000000)
            if (n <= this.total) return new Node(K_BACKREF, n)
            if (this.unicode) return this.fail("Invalid escape")
            this.pos = start
            if (c >= 56) {
                this.pos++
                return new Node(K_CHAR, c)
            }
            return new Node(K_CHAR, this.octal())
        }
        if (c === 107 && (this.named || this.unicode)) {
            this.pos++
            if (this.peek() !== 60) return this.fail("Invalid named reference")
            this.pos++
            const name = this.groupName()
            if (this.error !== "") return new Node(K_EMPTY, 0)
            const ref = new Node(K_BACKREF, 0)
            ref.name = name
            this.references.push(ref)
            return ref
        }
        const ranges = classEscape(c, this.folded)
        if (ranges !== null) {
            this.pos++
            const node = new Node(K_CLASS, 0)
            node.ranges = ranges
            return node
        }
        if ((c === 112 || c === 80) && this.unicode) {
            const node = new Node(K_CLASS, 0)
            this.strings = []
            node.ranges = this.property(false)
            if (this.strings.length === 0) return node
            return classWithStrings(node, this.strings)
        }
        return new Node(K_CHAR, this.characterEscape(false))
    }

    /**
     * `\p{...}` or `\P{...}`, at its `p`: the characters of the property, or
     * of the others for `\P`; the strings of a property of strings (the flag
     * `v`) in `strings` and `mayStrings`. Its errors say whether it is in a
     * class, as V8's do.
     */
    property(inClass: bool): int[] {
        const invalid = inClass ? "Invalid property name in character class" : "Invalid property name"
        const negate = this.peek() === 80
        this.pos++
        const out: int[] = []
        if (this.peek() !== 123) {
            this.fail(invalid)
            return out
        }
        this.pos++
        const start = this.pos
        while (this.peek() !== 125) {
            const c = this.peek()
            if (!isLetter(c) && !isDigit(c) && c !== 95 && c !== 61) {
                this.fail(invalid)
                return out
            }
            this.pos++
        }
        const strings: int[][] = []
        const found = propertyRanges(this.text.slice(start, this.pos), this.sets, out, strings)
        this.pos++
        // Every property of strings has strings; `\P` takes none.
        if (!found || (negate && strings.length > 0)) {
            this.fail(invalid)
            return out
        }
        if (strings.length > 0) {
            this.mayStrings = true
            if (this.caseless) {
                for (const t of strings) for (let i = 0; i < t.length; i++) t[i] = canonicalizeUnicode(t[i])
            }
            this.strings = strings
        }
        if (this.caseless) return negate ? complement(closeCase(out)) : out
        return negate ? complement(out) : out
    }

    /** Up to three octal digits, at most 0o377. */
    octal(): int {
        let n = 0
        let count = 0
        while (count < 3 && this.peek() >= 48 && this.peek() <= 55 && n * 8 + this.peek() - 48 <= 255) {
            n = n * 8 + this.peek() - 48
            this.pos++
            count++
        }
        return n
    }

    /** `count` hex digits at the position, or -1 (consuming nothing) when they are not there. */
    hex(count: int): int {
        let n = 0
        for (let i = 0; i < count; i++) {
            const d = hexValue(this.peekAt(i))
            if (d < 0) return -1
            n = n * 16 + d
        }
        this.pos += count
        return n
    }

    /**
     * The character of an escape after its `\`, other than a class escape
     * or a backreference: `\n`, `\x41`, `A`, `\cJ`, `\0`, octal, or the
     * character itself. In a class, `\b` is a backspace and `\-` a `-`.
     */
    characterEscape(inClass: bool): int {
        const c = this.peek()
        switch (c) {
            case 116:
                this.pos++
                return 9
            case 110:
                this.pos++
                return 10
            case 118:
                this.pos++
                return 11
            case 102:
                this.pos++
                return 12
            case 114:
                this.pos++
                return 13
            case 98:
                this.pos++
                return 8
            case 48:
                this.pos++
                if (isDigit(this.peek())) {
                    if (this.unicode) {
                        this.fail("Invalid decimal escape")
                        return 0
                    }
                    this.pos--
                    return this.octal()
                }
                return 0
            case 99: {
                const letter = this.peekAt(1)
                if (isLetter(letter) || (inClass && !this.unicode && (isDigit(letter) || letter === 95))) {
                    this.pos += 2
                    return letter % 32
                }
                if (this.unicode) {
                    this.fail("Invalid Unicode escape")
                    return 0
                }
                // A `\` that escapes nothing: the `c` is read next.
                return 92
            }
            case 120: {
                this.pos++
                const value = this.hex(2)
                if (value < 0 && this.unicode) {
                    this.fail("Invalid escape")
                    return 0
                }
                return value < 0 ? 120 : value
            }
            case 117: {
                this.pos++
                if (this.unicode && this.peek() === 123) return this.codePoint()
                const value = this.hex(4)
                if (value < 0 && this.unicode) {
                    this.fail("Invalid Unicode escape")
                    return 0
                }
                if (value < 0) return 117
                // A surrogate pair written as two escapes is one character.
                if (value >= 0xd800 && value <= 0xdbff && this.peek() === 92 && this.peekAt(1) === 117) {
                    const save = this.pos
                    this.pos += 2
                    const low = this.hex(4)
                    if (low >= 0xdc00 && low <= 0xdfff) return 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00)
                    this.pos = save
                }
                return value
            }
        }
        if (this.unicode) {
            // Only the characters of the syntax escape themselves: `^$\.*+?()[]{}|/`, and `-` in a class.
            if ((c >= 49 && c <= 55 && inClass) || isDigit(c)) {
                this.fail(c >= 56 ? "Invalid escape" : "Invalid decimal escape")
                return 0
            }
            if (!isSyntaxChar(c) && !(inClass && c === 45)) {
                this.fail("Invalid escape")
                return 0
            }
            this.pos++
            return c
        }
        if (inClass && c >= 49 && c <= 55) return this.octal()
        return this.char()
    }

    /** `{hex}` of `\u{...}`, at its `{`: a code point up to U+10FFFF. */
    codePoint(): int {
        this.pos++
        let n = 0
        const start = this.pos
        while (hexValue(this.peek()) >= 0) {
            n = n * 16 + hexValue(this.peek())
            if (n > 0x10ffff) n = 0x110000
            this.pos++
        }
        if (this.pos === start || this.peek() !== 125 || n > 0x10ffff) {
            this.fail("Invalid Unicode escape")
            return 0
        }
        this.pos++
        return n
    }

    characterClass(): Node {
        this.pos++
        const node = new Node(K_CLASS, 0)
        if (this.peek() === 94) {
            node.value = 1
            this.pos++
        }
        const ranges: int[] = []
        for (;;) {
            if (this.atEnd()) return this.fail("Unterminated character class")
            if (this.peek() === 93) {
                this.pos++
                break
            }
            const first = this.classAtom(ranges)
            if (this.error !== "") return node
            if (this.peek() !== 45 || this.peekAt(1) === 93 || this.peekAt(1) === -1) {
                if (first >= 0) {
                    ranges.push(first)
                    ranges.push(first)
                }
                continue
            }
            // A range `a-b`; with a class escape on either side, `-` is itself (Annex B).
            this.pos++
            const last = this.classAtom(ranges)
            if (this.error !== "") return node
            if (first < 0 || last < 0) {
                if (this.unicode) return this.fail("Invalid character class")
                if (first >= 0) {
                    ranges.push(first)
                    ranges.push(first)
                }
                if (last >= 0) {
                    ranges.push(last)
                    ranges.push(last)
                }
                ranges.push(45)
                ranges.push(45)
                continue
            }
            if (first > last) return this.fail("Range out of order in character class")
            ranges.push(first)
            ranges.push(last)
        }
        node.ranges = normalize(ranges)
        return node
    }

    /**
     * A class of the `v` flag, at its `[`: characters, ranges, class escapes
     * and nested classes joined, or operands of `--` (the characters of the
     * first but not the others) or `&&` (the characters of all of them).
     */
    classSet(): Node {
        this.pos++
        const node = new Node(K_CLASS, 0)
        if (this.peek() === 94) {
            node.value = 1
            this.pos++
        }
        node.ranges = this.classSetBody()
        if (this.error !== "") return node
        if (node.value === 1 && this.mayStrings) return this.fail("Negated character class may contain strings")
        if (this.strings.length === 0) return node
        return classWithStrings(node, this.strings)
    }

    /**
     * The characters of a class of the `v` flag after its `[` or `[^`, sorted,
     * and its strings in `strings` and `mayStrings`; past its `]`.
     */
    classSetBody(): int[] {
        const none: int[] = []
        this.strings = []
        this.mayStrings = false
        if (this.peek() === 93) {
            this.pos++
            return none
        }
        if (this.doubled()) {
            this.fail("Invalid set operation in character class")
            return none
        }
        let operand = this.setOperand()
        if (this.error !== "") return none
        if (this.caseless) operand = closeCase(operand)
        let strings = this.strings
        let may = this.mayStrings
        const op = this.peek()
        if ((op === 45 || op === 38) && this.peekAt(1) === op) {
            // `A--B--C` or `A&&B&&C`: one operator, no ranges.
            let set = operand
            for (;;) {
                this.pos += 2
                if (op === 38 && this.peek() === 38) {
                    this.fail("Invalid character in character class")
                    return none
                }
                let next = this.setOperand()
                if (this.error !== "") return none
                if (this.caseless) next = closeCase(next)
                set = op === 45 ? intersect(set, complement(next)) : intersect(set, next)
                // The strings of the first operand also in the next (`&&`) or not in it (`--`).
                const kept: int[][] = []
                const keys = stringKeys(this.strings)
                for (const t of strings) if (keys.has(stringKey(t)) === (op === 38)) kept.push(t)
                strings = kept
                if (op === 38) may = may && this.mayStrings
                if (this.atEnd()) {
                    this.fail("Unterminated character class")
                    return none
                }
                if (this.peek() === 93) {
                    this.pos++
                    this.strings = strings
                    this.mayStrings = may
                    return set
                }
                if (this.peek() !== op || this.peekAt(1) !== op) {
                    this.fail("Invalid set operation in character class")
                    return none
                }
            }
        }
        // A union of characters, ranges, classes and strings.
        const ranges: int[] = []
        const all: int[][] = []
        const keys = new Set<string>()
        for (;;) {
            for (const t of strings) {
                const key = stringKey(t)
                if (keys.has(key)) continue
                keys.add(key)
                all.push(t)
            }
            if (this.single >= 0 && this.peek() === 45 && this.peekAt(1) !== 45) {
                const first = this.single
                this.pos++
                if (this.peek() === 93) {
                    this.fail("Invalid character in character class")
                    return none
                }
                this.setOperand()
                if (this.error !== "") return none
                const last = this.single
                if (last < 0) {
                    this.fail("Invalid character class")
                    return none
                }
                if (first > last) {
                    this.fail("Range out of order in character class")
                    return none
                }
                operand = [first, last]
                if (this.caseless) operand = closeCase(operand)
            }
            for (const r of operand) ranges.push(r)
            if (this.atEnd()) {
                this.fail("Unterminated character class")
                return none
            }
            if (this.peek() === 93) {
                this.pos++
                this.strings = all
                this.mayStrings = may
                return normalize(ranges)
            }
            if (this.peek() === 45 && this.peekAt(1) !== 45) {
                this.fail("Invalid character class")
                return none
            }
            if (this.doubled()) {
                this.fail("Invalid set operation in character class")
                return none
            }
            operand = this.setOperand()
            if (this.error !== "") return none
            if (this.caseless) operand = closeCase(operand)
            strings = this.strings
            may = may || this.mayStrings
        }
    }

    /** Whether a doubled punctuator that a class of the `v` flag reserves is at the position. */
    doubled(): bool {
        const c = this.peek()
        return c >= 0 && c === this.peekAt(1) && isSetPunctuator(c)
    }

    /**
     * An operand of a class of the `v` flag: a character (also in `single`), a
     * class escape, `\q{...}` or a nested class, sorted; its strings in
     * `strings` and `mayStrings`.
     */
    setOperand(): int[] {
        this.single = -1
        this.strings = []
        this.mayStrings = false
        const none: int[] = []
        if (this.atEnd()) {
            this.fail("Unterminated character class")
            return none
        }
        const c = this.peek()
        if (c === 91) {
            this.pos++
            let negate = false
            if (this.peek() === 94) {
                negate = true
                this.pos++
            }
            const inner = this.classSetBody()
            this.single = -1
            if (!negate) return inner
            if (this.mayStrings && this.error === "") this.fail("Negated character class may contain strings")
            return complement(inner)
        }
        if (c === 92) {
            this.pos++
            if (this.atEnd()) {
                this.fail("\\ at end of pattern")
                return none
            }
            const e = this.peek()
            if (this.caseless && (e === 68 || e === 83 || e === 87)) {
                // `\D`, `\S` and `\W` complement the characters of `\d`, `\s` or `\w` closed under case.
                this.pos++
                return complement(closeCase(classEscape(e + 32, this.folded)!))
            }
            const escape = classEscape(e, this.folded)
            if (escape !== null) {
                this.pos++
                return escape
            }
            if (e === 112 || e === 80) return this.property(true)
            if (e === 113) return this.classStrings()
            if (isSetPunctuator(e) || isSyntaxChar(e)) {
                this.pos++
                this.single = e
            } else {
                this.single = this.characterEscape(true)
            }
            return [this.single, this.single]
        }
        if (isSetSyntaxChar(c) || c === 93) {
            this.fail("Invalid character in character class")
            return none
        }
        if (this.doubled()) {
            this.fail("Invalid set operation in character class")
            return none
        }
        this.single = this.char()
        return [this.single, this.single]
    }

    /**
     * `\q{...}` at its `q`: its alternatives of one character as ranges, the
     * others (empty or longer) in `strings`, folded with the flag `i`.
     */
    classStrings(): int[] {
        const ranges: int[] = []
        this.pos++
        if (this.peek() !== 123) {
            this.fail("Invalid escape")
            return ranges
        }
        this.pos++
        let current: int[] = []
        for (;;) {
            if (this.atEnd()) {
                this.fail("Unterminated character class")
                return ranges
            }
            const c = this.peek()
            if (c === 124 || c === 125) {
                this.pos++
                if (current.length === 1) {
                    ranges.push(current[0])
                    ranges.push(current[0])
                } else {
                    this.mayStrings = true
                    if (!hasString(this.strings, current)) this.strings.push(current)
                }
                if (c === 125) return normalize(ranges)
                current = []
            } else {
                const ch = this.stringChar()
                if (this.error !== "") return ranges
                current.push(this.caseless ? canonicalizeUnicode(ch) : ch)
            }
        }
    }

    /** A character of a string of `\q{...}`: itself, or an escape of one. */
    stringChar(): int {
        const c = this.peek()
        if (c !== 92) {
            if (isSetSyntaxChar(c)) {
                this.fail("Invalid character in character class")
                return 0
            }
            if (this.doubled()) {
                this.fail("Invalid set operation in character class")
                return 0
            }
            return this.char()
        }
        this.pos++
        if (this.atEnd()) {
            this.fail("\\ at end of pattern")
            return 0
        }
        const e = this.peek()
        if (isSetPunctuator(e) || isSyntaxChar(e)) {
            this.pos++
            return e
        }
        if (classEscape(e, false) !== null || e === 112 || e === 80 || e === 113) {
            this.fail("Invalid escape")
            return 0
        }
        return this.characterEscape(true)
    }

    /** A character of a class, or -1 for a class escape such as `\d`, whose ranges are added. */
    classAtom(ranges: int[]): int {
        if (this.peek() !== 92) return this.char()
        this.pos++
        if (this.atEnd()) {
            this.fail("\\ at end of pattern")
            return -1
        }
        const c = this.peek()
        const escape = classEscape(c, this.folded)
        if (escape !== null) {
            this.pos++
            for (const r of escape) ranges.push(r)
            return -1
        }
        if ((c === 112 || c === 80) && this.unicode) {
            for (const r of this.property(true)) ranges.push(r)
            return -1
        }
        if (c === 45) {
            this.pos++
            return 45
        }
        return this.characterEscape(true)
    }
}

/** Whether two strings of `\q{...}`, as their characters, are the same. */
function sameString(a: int[], b: int[]): bool {
    if (a.length !== b.length) return false
    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false
    return true
}

/** A string of a class as a key of a `Set`: its characters joined by commas. */
function stringKey(s: int[]): string {
    return s.join(",")
}

/** The keys of strings of a class. */
function stringKeys(list: int[][]): Set<string> {
    const keys = new Set<string>()
    for (const t of list) keys.add(stringKey(t))
    return keys
}

/** Whether a list of strings of `\q{...}` holds a string. */
function hasString(list: int[][], s: int[]): bool {
    for (const t of list) if (sameString(t, s)) return true
    return false
}

/** The strings of a class by their characters: the next ones, the strings after each, and whether one ends here. */
class StringTrie {
    chars: int[] = []
    kids: StringTrie[] = []
    end = false

    /** Adds the characters of a string from `from` on. */
    add(s: int[], from: int) {
        if (from === s.length) {
            this.end = true
            return
        }
        const c = s[from]
        for (let i = 0; i < this.chars.length; i++) {
            if (this.chars[i] === c) {
                this.kids[i].add(s, from + 1)
                return
            }
        }
        const kid = new StringTrie()
        this.chars.push(c)
        this.kids.push(kid)
        kid.add(s, from + 1)
    }

    /**
     * A node that matches the rest of one of the strings: the longer ones
     * first, as a class tries its longest strings first (two strings that
     * both match at a position are one the start of the other).
     */
    node(): Node {
        const alt = new Node(K_ALT, 0)
        for (let i = 0; i < this.chars.length; i++) {
            const char = new Node(K_CHAR, this.chars[i])
            const kid = this.kids[i]
            if (kid.chars.length === 0) {
                alt.kids.push(char)
                continue
            }
            const seq = new Node(K_SEQ, 0)
            seq.kids.push(char)
            seq.kids.push(kid.node())
            alt.kids.push(seq)
        }
        if (this.end) alt.kids.push(new Node(K_EMPTY, 0))
        if (alt.kids.length === 1) return alt.kids[0]
        return alt
    }
}

/**
 * A class of the `v` flag with strings, as alternatives that try its strings
 * of two or more characters first, the longest first, then the class's
 * characters, then the empty string.
 */
function classWithStrings(node: Node, strings: int[][]): Node {
    const alt = new Node(K_ALT, 0)
    const trie = new StringTrie()
    let empty = false
    for (const t of strings) {
        if (t.length === 0) empty = true
        else trie.add(t, 0)
    }
    if (trie.chars.length > 0) alt.kids.push(trie.node())
    if (node.ranges.length > 0) alt.kids.push(node)
    if (empty) alt.kids.push(new Node(K_EMPTY, 0))
    if (alt.kids.length === 1) return alt.kids[0]
    return alt
}

// -----------------------------------------------------------------------------
// Compiling

/** Whether a node can match the empty string, so that a loop around it must check its progress. */
function canBeEmpty(node: Node): bool {
    switch (node.kind) {
        case K_CHAR:
        case K_ANY:
        case K_CLASS:
            return false
        case K_SEQ:
            for (const kid of node.kids) if (!canBeEmpty(kid)) return false
            return true
        case K_ALT:
            for (const kid of node.kids) if (canBeEmpty(kid)) return true
            return false
        case K_GROUP:
            return canBeEmpty(node.kids[0])
        case K_REPEAT:
            return node.min === 0 || canBeEmpty(node.kids[0])
    }
    return true
}

/** The lowest and one past the highest group number in a node, or [0, 0]. */
function groupSpan(node: Node, span: int[]) {
    if (node.kind === K_GROUP) {
        if (span[1] === 0 || node.value < span[0]) span[0] = node.value
        if (node.value + 1 > span[1]) span[1] = node.value + 1
    }
    for (const kid of node.kids) groupSpan(kid, span)
}

class Compiler {
    constructor(
        readonly program: Program,
        readonly pattern: string,
    ) {}

    /** Whether the code emitted reads backwards, in a lookbehind. */
    back = false
    /** Where each `STAR` is. */
    stars: int[] = []

    op(code: int) {
        this.program.code.push(code)
    }

    /** Emits an instruction with a target filled later; returns the operand's index. */
    hole(): int {
        this.program.code.push(-1)
        return this.program.code.length - 1
    }

    here(): int {
        return this.program.code.length
    }

    patch(at: int) {
        this.program.code[at] = this.program.code.length
    }

    emit(node: Node) {
        const p = this.program
        if (p.code.length > maxCode) return
        switch (node.kind) {
            case K_EMPTY:
                return
            case K_CHAR:
                if (p.ignoreCase) {
                    this.read(OP_CHAR_I)
                    this.op(p.unicode ? canonicalizeUnicode(node.value) : canonicalize(node.value))
                } else {
                    this.read(OP_CHAR)
                    this.op(node.value)
                }
                return
            case K_ANY:
                this.read(p.dotAll ? OP_ANY_ALL : OP_ANY)
                return
            case K_CLASS:
                this.read(p.ignoreCase ? OP_CLASS_I : OP_CLASS)
                this.op(p.sets.length)
                this.op(node.value)
                p.sets.push(node.ranges)
                return
            case K_SEQ:
                // Backwards, a sequence matches its last term first.
                if (this.back) for (let i = node.kids.length - 1; i >= 0; i--) this.emit(node.kids[i])
                else for (const kid of node.kids) this.emit(kid)
                return
            case K_ALT: {
                const ends: int[] = []
                for (let i = 0; i < node.kids.length; i++) {
                    if (i < node.kids.length - 1) {
                        this.op(OP_SPLIT)
                        this.op(this.here() + 2)
                        const next = this.hole()
                        this.emit(node.kids[i])
                        this.op(OP_JUMP)
                        ends.push(this.hole())
                        this.patch(next)
                    } else {
                        this.emit(node.kids[i])
                    }
                }
                for (const end of ends) this.patch(end)
                return
            }
            case K_GROUP:
                // Backwards, a group's end is known first.
                this.op(OP_SAVE)
                this.op(this.back ? 2 * node.value + 1 : 2 * node.value)
                this.emit(node.kids[0])
                this.op(OP_SAVE)
                this.op(this.back ? 2 * node.value : 2 * node.value + 1)
                return
            case K_REPEAT:
                this.repeat(node)
                return
            case K_BOL:
                this.op(OP_BOL)
                return
            case K_EOL:
                this.op(OP_EOL)
                return
            case K_WORD:
                this.op(OP_WORD)
                this.op(node.value)
                return
            case K_BACKREF:
                this.read(OP_BACKREF)
                this.op(node.value)
                for (const other of node.alsoGroups) {
                    this.read(OP_BACKREF)
                    this.op(other)
                }
                return
            case K_LOOK:
            case K_LOOKBEHIND: {
                this.op(OP_LOOK)
                this.op(node.value)
                const end = this.hole()
                const back = this.back
                this.back = node.kind === K_LOOKBEHIND
                this.emit(node.kids[0])
                this.back = back
                this.op(OP_LOOK_END)
                this.patch(end)
                return
            }
        }
    }

    /** An instruction that reads a character, backwards in a lookbehind. */
    read(code: int) {
        this.op(this.back ? code + OP_BACK : code)
    }

    /**
     * A repetition: its atom copied `min` times, then a loop or `max - min`
     * optional copies. Each iteration starts with the atom's groups unset,
     * and one beyond the minimum fails when it matches nothing.
     */
    repeat(node: Node) {
        const atom = node.kids[0]
        if (node.max === 0) return
        const span = [0, 0]
        groupSpan(atom, span)
        const empty = canBeEmpty(atom)
        for (let i = 0; i < node.min && this.program.code.length <= maxCode; i++) this.iteration(atom, span, -1)
        const single = atom.kind === K_CHAR || atom.kind === K_CLASS || atom.kind === K_ANY
        if (node.max === unbounded && node.greedy && !this.back && single) {
            this.stars.push(this.here())
            this.op(OP_STAR)
            const exit = this.hole()
            this.op(0)
            this.emit(atom)
            this.patch(exit)
            return
        }
        if (node.max === unbounded) {
            const loop = this.here()
            const exit = this.split(node.greedy)
            this.iteration(atom, span, empty ? this.register() : -1)
            this.op(OP_JUMP)
            this.op(loop)
            this.patch(exit)
            return
        }
        const exits: int[] = []
        for (let i = node.min; i < node.max && this.program.code.length <= maxCode; i++) {
            exits.push(this.split(node.greedy))
            this.iteration(atom, span, empty ? this.register() : -1)
        }
        for (const exit of exits) this.patch(exit)
    }

    /** A `SPLIT` into the code that follows and an exit, in the order of greediness; returns the exit's hole. */
    split(greedy: bool): int {
        this.op(OP_SPLIT)
        if (greedy) {
            this.op(this.here() + 2)
            return this.hole()
        }
        const exit = this.hole()
        this.op(this.here() + 1)
        return exit
    }

    register(): int {
        this.program.slots++
        return this.program.slots - 1
    }

    iteration(atom: Node, span: int[], register: int) {
        if (register >= 0) {
            this.op(OP_SAVE)
            this.op(register)
        }
        if (span[1] > 0) {
            this.op(OP_RESET)
            this.op(2 * span[0])
            this.op(2 * span[1])
        }
        this.emit(atom)
        if (register >= 0) {
            this.op(OP_PROGRESS)
            this.op(register)
        }
    }

    /** What every match starts with: literal text, or the start of the input. */
    start(root: Node) {
        const p = this.program
        let first = root
        if (root.kind === K_SEQ && root.kids.length > 0) first = root.kids[0]
        if (first.kind === K_BOL && !p.multiline) p.anchored = true
        if (p.ignoreCase) return
        let prefix = ""
        const kids = root.kind === K_SEQ ? root.kids : [root]
        for (const kid of kids) {
            if (kid.kind !== K_CHAR || kid.from < 0) break
            prefix += this.pattern.slice(kid.from, kid.to)
        }
        p.prefix = prefix
    }
}
