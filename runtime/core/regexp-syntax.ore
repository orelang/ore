// The syntax of regular expressions, as in JavaScript (ECMAScript with its
// Annex B, and the stricter syntax of the `u` and `v` flags): a pattern and
// its flags parsed and compiled into a program for the backtracking matcher
// of regexp.ore.
//
// The compiler imports this module too, to report the errors of a regular
// expression literal at compile time; so it uses only what the compiler
// that builds the compiler (stage 0 of the bootstrap) has.

// Instructions of a program: an opcode and its operands, in `Program.code`.

/** `CHAR c`: the character `c`. */
export const OP_CHAR = 1
/** `CHAR_I c`: a character whose canonical case (`canonicalize`) is `c`. */
export const OP_CHAR_I = 2
/** `ANY`: any character but a line terminator. */
export const OP_ANY = 3
/** `ANY_ALL`: any character (`.` with the `s` flag). */
export const OP_ANY_ALL = 4
/** `CLASS set negate`: a character in `Program.sets[set]`, or not in it. */
export const OP_CLASS = 5
/** `CLASS_I set negate`: the same, ignoring case. */
export const OP_CLASS_I = 6
/** `SPLIT a b`: continues at `a`, and at `b` when that fails. */
export const OP_SPLIT = 7
/** `JUMP a`. */
export const OP_JUMP = 8
/** `SAVE slot`: the position into a slot (a capture's start or end, or a loop's start). */
export const OP_SAVE = 9
/** `RESET from to`: the slots `from` to `to - 1` unset, at each iteration of a loop around groups. */
export const OP_RESET = 10
/** `BOL`: the start of the input (or of a line, with the `m` flag). */
export const OP_BOL = 11
/** `EOL`: the end of the input (or of a line, with the `m` flag). */
export const OP_EOL = 12
/** `WORD negate`: a word boundary (`\b`), or not one (`\B`). */
export const OP_WORD = 13
/** `BACKREF group`: the text of a group again; nothing when the group is unset. */
export const OP_BACKREF = 14
/** `LOOK negate end`: a lookahead, whose body follows and ends with `LOOK_END`; continues at `end`. */
export const OP_LOOK = 15
/** The end of a lookahead's body. */
export const OP_LOOK_END = 16
/** `PROGRESS slot`: fails when the position is still the one in the slot: a loop's iteration matched nothing. */
export const OP_PROGRESS = 17
/** The end of the pattern: a match. */
export const OP_MATCH = 18
/**
 * `STAR exit`, then one instruction that reads a character: a greedy loop
 * of that character, as `SPLIT`s around it would run it, but without going
 * through the loop's instructions at each character; continues at `exit`.
 */
export const OP_STAR = 19
/**
 * Added to the opcode of an instruction that reads a character (`CHAR`,
 * `CHAR_I`, `ANY`, `ANY_ALL`, `CLASS`, `CLASS_I`, `BACKREF`): it reads the
 * one before the position and moves back, inside a lookbehind.
 */
export const OP_BACK = 32

/** The largest program, in instructions and operands, as a counted repetition copies its atom. */
const maxCode = 1000000
/** "Unbounded", as the maximum of a repetition. */
const unbounded = -1

// Kinds of the nodes of a parsed pattern.
const K_EMPTY = 0
const K_CHAR = 1
const K_ANY = 2
const K_CLASS = 3
const K_SEQ = 4
const K_ALT = 5
const K_GROUP = 6
const K_REPEAT = 7
const K_BOL = 8
const K_EOL = 9
const K_WORD = 10
const K_BACKREF = 11
const K_LOOK = 12
const K_LOOKBEHIND = 13

/** A node of a parsed pattern. */
class Node {
    kids: Node[] = []
    /** The ranges of a class: first and last character of each. */
    ranges: int[] = []
    /** The group a backreference names, resolved once all groups are known. */
    name = ""
    /** For a character written as itself, its bytes in the pattern; -1 for an escape. */
    from = -1
    to = -1
    /** For a repetition: the minimum and maximum (`unbounded`) counts, and whether it is greedy. */
    min = 0
    max = 0
    greedy = true

    constructor(
        readonly kind: int,
        /** The character, the group's number, or 1 when negated (classes, `\B`, `(?!`). */
        public value: int,
    ) {}
}

/** A compiled regular expression: what the matcher runs. */
export class Program {
    code: int[] = []
    /** The ranges of each class. */
    sets: int[][] = []
    /** The number of capture groups, with the whole match as group 0. */
    groups = 1
    /** The number of slots: two per group (start and end), then one per loop that could match nothing. */
    slots = 2
    /** The name of each group, "" for one without. */
    names: string[] = [""]
    /** Text that every match starts with, for a fast search of where to try. */
    prefix = ""
    /** Whether matches can only start at the start of the input (`^` first, without the `m` flag). */
    anchored = false
    /**
     * For each byte, 1 when a match can start with it, to skip the others
     * fast; empty when any byte could start one or a match can be empty.
     */
    first: int[] = []
    /** For each class, 128 entries: 1 for each ASCII character it holds, before negation. */
    ascii: int[] = []
    global = false
    ignoreCase = false
    multiline = false
    dotAll = false
    sticky = false
    hasIndices = false
    /** The `u` flag, or `v`: code points, `\u{...}`, `\p{...}` and a stricter syntax. */
    unicode = false
    /** The `v` flag: also nested classes and their operators `--` and `&&`. */
    unicodeSets = false
    /** The error that makes the pattern or the flags invalid, or "". */
    error = ""
}

/** The program of a pattern and its flags; `error` tells when they are invalid. */
export function compileRegExp(pattern: string, flags: string): Program {
    const program = new Program()
    const flagError = readFlags(program, flags)
    if (flagError !== "") {
        program.error = flagError
        return program
    }
    const parser = new Parser(pattern)
    parser.unicode = program.unicode
    parser.sets = program.unicodeSets
    parser.caseless = program.unicodeSets && program.ignoreCase
    parser.folded = program.unicode && program.ignoreCase
    const root = parser.parse()
    if (parser.error !== "") {
        program.error = parser.error
        return program
    }
    program.groups = parser.names.length
    program.names = parser.names
    program.slots = 2 * program.groups
    const compiler = new Compiler(program, pattern)
    compiler.emit(root)
    program.code.push(OP_MATCH)
    if (program.code.length > maxCode) {
        program.error = "Regular expression too large"
        return program
    }
    compiler.start(root)
    for (const ranges of program.sets) for (let c = 0; c < 128; c++) program.ascii.push(inRanges(ranges, c) ? 1 : 0)
    program.first = firstBytes(program)
    return program
}

/**
 * The bytes that a match can start with (see `Program.first`), from the
 * instructions that can read the first character; empty when unknown. Any
 * non-ASCII character counts as all the bytes from 0x80 on.
 */
function firstBytes(program: Program): int[] {
    const code = program.code
    const none: int[] = []
    const first: int[] = []
    for (let b = 0; b < 256; b++) first.push(b < 128 ? 0 : 1)
    const seen: bool[] = []
    for (let i = 0; i < code.length; i++) seen.push(false)
    const work: int[] = [0]
    while (work.length > 0) {
        const pc = work[work.length - 1]
        work.pop()
        if (seen[pc]) continue
        seen[pc] = true
        const op = code[pc]
        if (op === OP_CHAR) {
            if (code[pc + 1] < 128) first[code[pc + 1]] = 1
        } else if (op === OP_CHAR_I) {
            const c = code[pc + 1]
            if (c < 128) {
                first[c] = 1
                first[lowercase(c)] = 1
            }
        } else if (op === OP_CLASS) {
            const negate = code[pc + 2] === 1
            for (let c = 0; c < 128; c++) if ((program.ascii[128 * code[pc + 1] + c] === 1) !== negate) first[c] = 1
        } else if (op === OP_STAR) {
            work.push(pc + 2)
            work.push(code[pc + 1])
        } else if (op === OP_SPLIT) {
            work.push(code[pc + 1])
            work.push(code[pc + 2])
        } else if (op === OP_JUMP) {
            work.push(code[pc + 1])
        } else if (op === OP_SAVE || op === OP_WORD || op === OP_PROGRESS) {
            work.push(pc + 2)
        } else if (op === OP_RESET) {
            work.push(pc + 3)
        } else if (op === OP_BOL || op === OP_EOL) {
            work.push(pc + 1)
        } else if (op === OP_LOOK) {
            // A lookaround reads nothing: what follows it reads the first character.
            work.push(code[pc + 2])
        } else {
            // A match that can be empty, a backreference, `.`, or a class ignoring case.
            return none
        }
    }
    return first
}

/** Sets the flags of a program; an error message for an invalid or unsupported flag, or "". */
function readFlags(program: Program, flags: string): string {
    for (let i = 0; i < flags.length; i++) {
        const f = flags[i]
        let seen = false
        for (let j = 0; j < i; j++) if (flags[j] === f) seen = true
        if (seen) return `Invalid flags '${flags}'`
        if (f === 103) program.global = true
        else if (f === 105) program.ignoreCase = true
        else if (f === 109) program.multiline = true
        else if (f === 115) program.dotAll = true
        else if (f === 121) program.sticky = true
        else if (f === 100) program.hasIndices = true
        else if (f === 117) program.unicode = true
        else if (f === 118) program.unicodeSets = true
        else return `Invalid flags '${flags}'`
    }
    if (program.unicode && program.unicodeSets) return `Invalid flags '${flags}'`
    if (program.unicodeSets) program.unicode = true
    return ""
}

// -----------------------------------------------------------------------------
// Characters

/** Whether a character ends a line: `\n`, `\r`, U+2028 or U+2029. */
export function isLineTerminator(c: int): bool {
    return c === 10 || c === 13 || c === 0x2028 || c === 0x2029
}

/** Whether a character is a word character of `\w`: an ASCII letter, a digit or `_`. */
export function isWordChar(c: int): bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c === 95
}

/**
 * Whether a character is a word character of `\w` with the flags `u` (or
 * `v`) and `i`: also the long s (ſ) and the Kelvin sign, whose simple case
 * folding is an ASCII letter.
 */
export function isFoldedWordChar(c: int): bool {
    return isWordChar(c) || c === 0x17f || c === 0x212a
}

/**
 * The canonical case of a character, which the `i` flag compares: its
 * uppercase, as JavaScript's Canonicalize without the `u` flag, for ASCII,
 * Latin-1, Greek and Cyrillic letters; other characters are their own.
 */
export function canonicalize(c: int): int {
    if (c < 97) return c
    if (c <= 122) return c - 32
    if (c < 0xb5) return c
    if (c === 0xb5) return 0x39c
    if (c >= 0xe0 && c <= 0xfe && c !== 0xf7) return c - 32
    if (c === 0xff) return 0x178
    if (c >= 0x3b1 && c <= 0x3c9) return c === 0x3c2 ? 0x3a3 : c - 32
    if (c >= 0x3ac && c <= 0x3af) return c === 0x3ac ? 0x386 : c - 37
    if (c >= 0x430 && c <= 0x44f) return c - 32
    if (c >= 0x450 && c <= 0x45f) return c - 80
    return c
}

/**
 * The canonical case with the `u` or `v` flag, which compares the simple
 * case folding of characters: `canonicalize`, and also the long s (ſ), the
 * Kelvin and Ohm signs and the capital sharp s (ẞ), which have none
 * without the flags.
 */
export function canonicalizeUnicode(c: int): int {
    if (c === 0x17f) return 83
    if (c === 0x212a) return 75
    if (c === 0x2126) return 0x3a9
    if (c === 0x1e9e) return 0xdf
    return canonicalize(c)
}

/** The other character of a canonical case that `canonicalizeUnicode` adds, or -1. */
export function unicodeVariant(c: int): int {
    if (c === 83) return 0x17f
    if (c === 75) return 0x212a
    if (c === 0x3a9) return 0x2126
    if (c === 0xdf) return 0x1e9e
    return -1
}

/** The lowercase of an uppercase letter that `canonicalize` maps, or the character itself. */
export function lowercase(c: int): int {
    if (c >= 65 && c <= 90) return c + 32
    if (c >= 0xc0 && c <= 0xde && c !== 0xd7) return c + 32
    if (c === 0x178) return 0xff
    if (c >= 0x391 && c <= 0x3a9 && c !== 0x3a2) return c + 32
    if (c === 0x386) return 0x3ac
    if (c >= 0x388 && c <= 0x38a) return c + 37
    if (c >= 0x410 && c <= 0x42f) return c + 32
    if (c >= 0x400 && c <= 0x40f) return c + 80
    return c
}

/** Whether a character is in sorted ranges (as `normalize` leaves them). */
export function inRanges(ranges: int[], c: int): bool {
    let low = 0
    let high = ranges.length / 2
    while (low < high) {
        const mid = (low + high) / 2
        if (c < ranges[2 * mid]) high = mid
        else if (c > ranges[2 * mid + 1]) low = mid + 1
        else return true
    }
    return false
}

/** Ranges sorted by their first character, overlapping and adjacent ones merged. */
export function normalize(ranges: int[]): int[] {
    // A merge sort of the pairs, bottom up.
    const count = ranges.length / 2
    let from = ranges
    let width = 1
    while (width < count) {
        const to: int[] = []
        for (let lo = 0; lo < count; lo += 2 * width) {
            const mid = lo + width < count ? lo + width : count
            const hi = lo + 2 * width < count ? lo + 2 * width : count
            let i = lo
            let j = mid
            while (i < mid || j < hi) {
                let k = j
                if (j >= hi || (i < mid && from[2 * i] <= from[2 * j])) {
                    k = i
                    i++
                } else {
                    j++
                }
                to.push(from[2 * k])
                to.push(from[2 * k + 1])
            }
        }
        from = to
        width *= 2
    }
    const out: int[] = []
    for (let i = 0; i < from.length; i += 2) {
        const n = out.length
        if (n > 0 && from[i] <= out[n - 1] + 1) {
            if (from[i + 1] > out[n - 1]) out[n - 1] = from[i + 1]
        } else {
            out.push(from[i])
            out.push(from[i + 1])
        }
    }
    return out
}

/**
 * What `canonicalizeUnicode` maps: the first and last character of each
 * run and the distance to their canonical case.
 */
const caseRuns: int[][] = [
    [97, 122, -32],
    [0xb5, 0xb5, 0x39c - 0xb5],
    [0xe0, 0xf6, -32],
    [0xf8, 0xfe, -32],
    [0xff, 0xff, 0x178 - 0xff],
    [0x17f, 0x17f, 83 - 0x17f],
    [0x3ac, 0x3ac, 0x386 - 0x3ac],
    [0x3ad, 0x3af, -37],
    [0x3b1, 0x3c1, -32],
    [0x3c2, 0x3c2, 0x3a3 - 0x3c2],
    [0x3c3, 0x3c9, -32],
    [0x430, 0x44f, -32],
    [0x450, 0x45f, -80],
    [0x1e9e, 0x1e9e, 0xdf - 0x1e9e],
    [0x2126, 0x2126, 0x3a9 - 0x2126],
    [0x212a, 0x212a, 75 - 0x212a],
]

/**
 * Sorted ranges with every character of the same canonical case as one of
 * them added: a class of the `v` flag ignoring case folds each operand so,
 * before its operators and complements.
 */
function closeCase(ranges: int[]): int[] {
    let out = ranges
    // Twice, for the characters that share a canonical case with another: ς, σ and Σ.
    for (let pass = 0; pass < 2; pass++) {
        const all: int[] = []
        for (const r of out) all.push(r)
        for (const run of caseRuns) {
            const delta = run[2]
            for (const r of intersect(out, [run[0], run[1]])) all.push(r + delta)
            for (const r of intersect(out, [run[0] + delta, run[1] + delta])) all.push(r - delta)
        }
        out = normalize(all)
    }
    return out
}

/** The characters in both of two sorted ranges. */
function intersect(a: int[], b: int[]): int[] {
    const out: int[] = []
    let i = 0
    let j = 0
    while (i < a.length && j < b.length) {
        const low = a[i] > b[j] ? a[i] : b[j]
        const high = a[i + 1] < b[j + 1] ? a[i + 1] : b[j + 1]
        if (low <= high) {
            out.push(low)
            out.push(high)
        }
        if (a[i + 1] < b[j + 1]) i += 2
        else j += 2
    }
    return out
}

const digitRanges = [48, 57]
const wordRanges = [48, 57, 65, 90, 95, 95, 97, 122]
/** The characters of `\w` with the flags `u` (or `v`) and `i`: also ſ and the Kelvin sign. */
const foldedWordRanges = [48, 57, 65, 90, 95, 95, 97, 122, 0x17f, 0x17f, 0x212a, 0x212a]
const spaceRanges = [
    9, 13, 32, 32, 0xa0, 0xa0, 0x1680, 0x1680, 0x2000, 0x200a, 0x2028, 0x2029, 0x202f, 0x202f, 0x205f, 0x205f, 0x3000,
    0x3000, 0xfeff, 0xfeff,
]

/** The characters not in sorted ranges, up to U+10FFFF. */
function complement(ranges: int[]): int[] {
    const out: int[] = []
    let next = 0
    for (let i = 0; i < ranges.length; i += 2) {
        if (ranges[i] > next) {
            out.push(next)
            out.push(ranges[i] - 1)
        }
        next = ranges[i + 1] + 1
    }
    if (next <= 0x10ffff) {
        out.push(next)
        out.push(0x10ffff)
    }
    return out
}

/**
 * The ranges of a class escape letter (`d`, `D`, `w`, `W`, `s`, `S`), or null
 * for another letter; `folded` with the flags `u` (or `v`) and `i`, whose
 * `\w` has ſ and the Kelvin sign too.
 */
function classEscape(letter: int, folded: bool): int[] | null {
    const word = folded ? foldedWordRanges : wordRanges
    if (letter === 100) return digitRanges
    if (letter === 68) return complement(digitRanges)
    if (letter === 119) return word
    if (letter === 87) return complement(word)
    if (letter === 115) return spaceRanges
    if (letter === 83) return complement(spaceRanges)
    return null
}

function isDigit(c: int): bool {
    return c >= 48 && c <= 57
}

function hexValue(c: int): int {
    if (c >= 48 && c <= 57) return c - 48
    if (c >= 97 && c <= 102) return c - 87
    if (c >= 65 && c <= 70) return c - 55
    return -1
}

function isLetter(c: int): bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

/** Whether a character is one of the bytes of a text. */
function oneOf(chars: string, c: int): bool {
    for (let i = 0; i < chars.length; i++) if (int(chars[i]) === c) return true
    return false
}

/** Whether a character is one of the syntax, `^$\.*+?()[]{}|` or `/`, which an escape with the `u` flag may name. */
function isSyntaxChar(c: int): bool {
    return oneOf("^$\\.*+?()[]{}|/", c)
}

/** Whether a character is one of the doubled punctuators that a class of the `v` flag reserves (`&&`, `--`, `!!`...). */
function isSetPunctuator(c: int): bool {
    return oneOf("&-!#$%*+,.:;<=>?@^`~", c)
}

/** Whether a character cannot be itself in a class of the `v` flag: `()[]{}/-\|`. */
function isSetSyntaxChar(c: int): bool {
    return oneOf("()[]{}/-\\|", c)
}

/** Whether a character can be in a group's name: ASCII letters, digits, `$`, `_`, and any other non-ASCII character. */
function isNameChar(c: int, first: bool): bool {
    return isLetter(c) || c === 36 || c === 95 || c >= 128 || (!first && isDigit(c))
}

// -----------------------------------------------------------------------------
// Unicode properties

/**
 * The characters of the properties that `\p{...}` knows, from Unicode 17.0
 * (as node 24 has them): the letters and numbers of each General_Category
 * and four scripts. Each table is a list of ranges, each range the number
 * of characters since the previous one and its length less one, written in
 * base 32: a digit `0`-`9`, `A`-`V` ends a number, and one of `W`-`Z`,
 * `a`-`z`, `+`, `/` is a digit with more to follow.
 */
const propertyTables = [
    [
        "Lu",
        "",
    ],
    [
        "Ll",
        "",
    ],
    ["Lt", "k502020X60diL78787C0F0XF0"],
    [
        "Lm",
        "rGH4BE47010a5050kU0d60b41eD140V09030b00b70XcK0ZV0nL0XsQ0ZB0p30kG5bEXUD0X2X4rH0D0GCY+V1dH0bV0kL0XB450Z11YT2xuM0Xd25eE0ZI0S1ZP8YG0N0Z8331kL0M0a90ZC0L1Z7390rW60XD1X/051X918XiJ0X00gL0ZuJ0ph63lS2X81n6CY0110E1l/S31611iXHXTc96zD0mJ0oB0",
    ],
    [
        "Lo",
        "",
    ],
    [
        "Nd",
        "XG9Xn69a69c69iS9ZM9ZM9ZM9ZM9ZM9ZM9ZM9ZM9ZM9Z09ZM9Y69eM9Y69Xw69X69fC9a09b6969bM9YM9a6969XYk69r69X69c69M9YM9iM9quM9Xi69Ya6969uS9a09XS9aG9eM9gM9ZM9hM9Z696JYC9j69Z69qM9YM9dM9Y69XM9h69mkM9Yf69YM9a69mM9txM9YsKXHYg09j69lM9dN9wL9aqM9",
    ],
    ["Nl", "btE2YpFX223ZpU0P8E2zrB9soGXKkC080a64eXAZEoy52"],
    [
        "No",
        "bI15022YfL5hO5ZO2a56cP6H8jH9XXLJXZJ9l00XqL03569c6FX90sMXRYELpMTXh90XaK3aA9U71EX09X7EzhG5scHXCY13H1gLQX43XfK7P6X78YB4M5b012F2XDY08XK1U2YB4Z87O7X96gA5h0UaU9XA3ZG6a6JhRJXg51jE8x7IwJKoy66uUMvX9JCJZCObgE8z1XQ1213YCXC1E+2C",
    ],
    [
        "Latin",
        "Y1P6PXF0F05M1U1k0X74cmRX56XG535C1Y5Y1dVhH0D0GCaD160R0HX8YsNV+r2Z53YHKEvGXA1813pyM6XWQP6PYX551X918Xrw5U65",
    ],
    ["Greek", "xG3122310401012101J1XUEFcf64XI444YK0g0L252X525271010101U2XK1E1D251I2218f70XYnU0rkQYEH0XqYVY5"],
    ["Cyrillic", "XW0a42b8bwGAb00YC0aZ7V+Y0YVryE1Xum0XTX10"],
    ["Han", "hq0P1YOCcLXF010P8E3+4cjVY0qlVse0hD2Z9ze81C6XaW9XfsVX0aeT2bqD2dfGFpDYj2mTXl2awA5ef9"],
]

/** The value of a digit of `propertyTables`: 0-31 ends a number, 32-63 continues it. */
function tableDigit(b: int): int {
    if (b >= 48 && b <= 57) return b - 48
    if (b >= 65 && b <= 90) return b - 55
    if (b >= 97 && b <= 122) return b - 61
    return b === 43 ? 62 : 63
}

/** The ranges of a table of `propertyTables`, by name: sorted. */
function propertyTable(name: string): int[] {
    const out: int[] = []
    for (const entry of propertyTables) {
        if (entry[0] !== name) continue
        const text = entry[1]
        let previous = -1
        let start = -1
        let n = 0
        for (let i = 0; i < text.length; i++) {
            const d = tableDigit(int(text[i]))
            if (d >= 32) {
                n = n * 32 + d - 32
                continue
            }
            n = n * 32 + d
            if (start < 0) {
                start = previous + 1 + n
            } else {
                out.push(start)
                out.push(start + n)
                previous = start + n
                start = -1
            }
            n = 0
        }
    }
    return out
}

/** The tables of a General_Category value by either name, joined by commas, or "". */
function categoryTables(value: string): string {
    const names = [
        "L,Letter:Lu,Ll,Lt,Lm,Lo",
        "LC,Cased_Letter:Lu,Ll,Lt",
        "Lu,Uppercase_Letter:Lu",
        "Ll,Lowercase_Letter:Ll",
        "Lt,Titlecase_Letter:Lt",
        "Lm,Modifier_Letter:Lm",
        "Lo,Other_Letter:Lo",
        "N,Number:Nd,Nl,No",
        "Nd,Decimal_Number,digit:Nd",
        "Nl,Letter_Number:Nl",
        "No,Other_Number:No",
    ]
    for (const line of names) {
        const colon = line.indexOf(":")
        for (const name of line.slice(0, colon).split(",")) if (name === value) return line.slice(colon + 1)
    }
    return ""
}

/** The table of a script by either name, or "". */
function scriptTable(value: string): string {
    if (value === "Latin" || value === "Latn") return "Latin"
    if (value === "Greek" || value === "Grek") return "Greek"
    if (value === "Cyrillic" || value === "Cyrl") return "Cyrillic"
    if (value === "Han" || value === "Hani") return "Han"
    return ""
}

/**
 * The characters of a property of `\p{...}`, sorted, into `out`: a
 * General_Category of letters or numbers (`L`, `Lu`, `gc=Nd`,
 * `General_Category=Letter`...), a script (`Script=Greek`, `sc=Cyrl`), or
 * `Any` and `ASCII`. Returns an error message, or "".
 */
function propertyRanges(text: string, out: int[]): string {
    const invalid = "Invalid property name"
    const unsupported = `The property '${text}' is not supported`
    const eq = text.indexOf("=")
    let tables = ""
    if (eq >= 0) {
        const name = text.slice(0, eq)
        const value = text.slice(eq + 1)
        if (value === "" || value.indexOf("=") >= 0) return invalid
        if (name === "General_Category" || name === "gc") tables = categoryTables(value)
        else if (name === "Script" || name === "sc") tables = scriptTable(value)
        else if (name === "Script_Extensions" || name === "scx") return unsupported
        else return invalid
    } else if (text === "Any") {
        out.push(0)
        out.push(0x10ffff)
        return ""
    } else if (text === "ASCII") {
        out.push(0)
        out.push(127)
        return ""
    } else {
        if (text === "" || scriptTable(text) !== "") return invalid
        tables = categoryTables(text)
    }
    if (tables === "") return unsupported
    const all: int[] = []
    for (const name of tables.split(",")) for (const r of propertyTable(name)) all.push(r)
    for (const r of normalize(all)) out.push(r)
    return ""
}

// -----------------------------------------------------------------------------
// Parsing

class Parser {
    pos = 0
    error = ""
    /** The name of each group, by number; group 0 is the whole match. */
    names: string[] = [""]
    /** The number of groups in the whole pattern, which tells `\10` a backreference from an escape. */
    total = 0
    /** Whether the pattern has named groups, in which `\k` must name one. */
    named = false
    /** The backreferences by name, resolved at the end. */
    references: Node[] = []
    /** The `u` or `v` flag: the stricter syntax, `\u{...}` and `\p{...}`. */
    unicode = false
    /** The `v` flag: classes with nested classes and the operators `--` and `&&`. */
    sets = false
    /** Whether the last group read was a lookahead or a lookbehind, which a quantifier may follow only without `u` and for a lookahead. */
    look = false
    /** The character of the last `setOperand`, or -1 when it was a class. */
    single = -1
    /** The flags `v` and `i`: the operands of a class are closed under case (`closeCase`). */
    caseless = false
    /** The flags `u` (or `v`) and `i`: `\w` has ſ and the Kelvin sign too. */
    folded = false
    /** The strings of the last `setOperand` or `classSetBody`: those of `\q{...}` that are not one character. */
    strings: int[][] = []
    /** Whether the last `setOperand` or `classSetBody` may hold strings, which a negated class may not. */
    mayStrings = false

    constructor(readonly text: string) {}

    parse(): Node {
        this.countGroups()
        const root = this.disjunction()
        if (this.error !== "") return root
        if (this.pos < this.text.length) {
            // Only `)` stops a disjunction before the end.
            this.fail("Unmatched ')'")
            return root
        }
        for (const ref of this.references) {
            let found = false
            for (let i = 1; i < this.names.length; i++) {
                if (!found && this.names[i] === ref.name) {
                    ref.value = i
                    found = true
                }
            }
            if (!found) this.fail("Invalid named capture referenced")
        }
        return root
    }

    fail(message: string): Node {
        if (this.error === "") this.error = message
        return new Node(K_EMPTY, 0)
    }

    /** The groups of the pattern counted ahead, and whether any is named. */
    countGroups() {
        const t = this.text
        let inClass = false
        for (let i = 0; i < t.length; i++) {
            const c = t[i]
            if (c === 92) i++
            else if (c === 91) inClass = true
            else if (c === 93) inClass = false
            else if (c === 40 && !inClass) {
                if (i + 1 < t.length && t[i + 1] === 63) {
                    // `(?<name>`, but not `(?<=` or `(?<!`.
                    if (i + 3 < t.length && t[i + 2] === 60 && t[i + 3] !== 61 && t[i + 3] !== 33) {
                        this.total++
                        this.named = true
                    }
                } else {
                    this.total++
                }
            }
        }
    }

    atEnd(): bool {
        return this.pos >= this.text.length
    }

    /** The byte at the position, or -1 at the end. */
    peek(): int {
        return this.pos < this.text.length ? int(this.text[this.pos]) : -1
    }

    peekAt(offset: int): int {
        const i = this.pos + offset
        return i < this.text.length ? int(this.text[i]) : -1
    }

    /** The character at the position, decoded from UTF-8, and the position moved past it. */
    char(): int {
        const t = this.text
        const b = int(t[this.pos])
        let n = 1
        let c = b
        if (b >= 0xf0 && b < 0xf8) {
            n = 4
            c = b & 7
        } else if (b >= 0xe0) {
            n = 3
            c = b & 15
        } else if (b >= 0xc0) {
            n = 2
            c = b & 31
        }
        if (b >= 0x80 && (b < 0xc0 || b >= 0xf8 || this.pos + n > t.length)) {
            this.pos++
            return 0xfffd
        }
        for (let k = 1; k < n; k++) {
            const x = int(t[this.pos + k])
            if ((x & 0xc0) !== 0x80) {
                this.pos++
                return 0xfffd
            }
            c = (c << 6) | (x & 63)
        }
        this.pos += n
        return c
    }

    disjunction(): Node {
        const first = this.alternative()
        if (this.peek() !== 124) return first
        const alt = new Node(K_ALT, 0)
        alt.kids.push(first)
        while (this.peek() === 124 && this.error === "") {
            this.pos++
            alt.kids.push(this.alternative())
        }
        return alt
    }

    alternative(): Node {
        const seq = new Node(K_SEQ, 0)
        while (!this.atEnd() && this.error === "") {
            const c = this.peek()
            if (c === 124 || c === 41) break
            const term = this.term()
            if (this.error !== "") break
            seq.kids.push(term)
        }
        if (seq.kids.length === 1) return seq.kids[0]
        return seq
    }

    /** An atom or an assertion, with its quantifier. */
    term(): Node {
        const c = this.peek()
        if (c === 94) {
            this.pos++
            return this.unquantifiable(new Node(K_BOL, 0))
        }
        if (c === 36) {
            this.pos++
            return this.unquantifiable(new Node(K_EOL, 0))
        }
        if (c === 92 && (this.peekAt(1) === 98 || this.peekAt(1) === 66)) {
            const negate = this.peekAt(1) === 66 ? 1 : 0
            this.pos += 2
            return this.unquantifiable(new Node(K_WORD, negate))
        }
        if (c === 42 || c === 43 || c === 63) return this.fail("Nothing to repeat")
        if (c === 123 && this.quantifierAhead()) return this.fail("Nothing to repeat")
        if (this.unicode && (c === 123 || c === 125 || c === 93)) return this.fail("Lone quantifier brackets")
        this.look = false
        const atom = this.atom()
        if (this.error !== "") return atom
        if (this.look && (this.unicode || atom.kind === K_LOOKBEHIND)) {
            const q = this.peek()
            if (q === 42 || q === 43 || q === 63 || (q === 123 && this.quantifierAhead()))
                return this.fail("Invalid quantifier")
            return atom
        }
        return this.quantified(atom)
    }

    /** An assertion, which no quantifier may follow. */
    unquantifiable(node: Node): Node {
        const c = this.peek()
        if (c === 42 || c === 43 || c === 63 || (c === 123 && this.quantifierAhead()))
            return this.fail("Nothing to repeat")
        return node
    }

    /** Whether a `{` at the position starts a quantifier: `{n}`, `{n,}` or `{n,m}`. */
    quantifierAhead(): bool {
        let i = this.pos + 1
        const t = this.text
        const start = i
        while (i < t.length && isDigit(int(t[i]))) i++
        if (i === start || i >= t.length) return false
        if (t[i] === 125) return true
        if (t[i] !== 44) return false
        i++
        while (i < t.length && isDigit(int(t[i]))) i++
        return i < t.length && t[i] === 125
    }

    /** A decimal number at the position, at most `limit` (larger ones stay `limit`). */
    number(limit: int): int {
        let n = 0
        while (isDigit(this.peek())) {
            n = n * 10 + this.peek() - 48
            if (n > limit) n = limit
            this.pos++
        }
        return n
    }

    quantified(atom: Node): Node {
        const c = this.peek()
        let min = 0
        let max = 0
        if (c === 42) {
            min = 0
            max = unbounded
            this.pos++
        } else if (c === 43) {
            min = 1
            max = unbounded
            this.pos++
        } else if (c === 63) {
            min = 0
            max = 1
            this.pos++
        } else if (c === 123 && this.quantifierAhead()) {
            const limit = 1000000000
            this.pos++
            min = this.number(limit)
            max = min
            if (this.peek() === 44) {
                this.pos++
                max = isDigit(this.peek()) ? this.number(limit) : unbounded
            }
            this.pos++
            if (max !== unbounded && max < min) return this.fail("numbers out of order in {} quantifier")
        } else if (c === 123 && this.unicode) {
            return this.fail("Incomplete quantifier")
        } else {
            return atom
        }
        const repeat = new Node(K_REPEAT, 0)
        repeat.min = min
        repeat.max = max
        if (this.peek() === 63) {
            repeat.greedy = false
            this.pos++
        }
        repeat.kids.push(atom)
        return repeat
    }

    atom(): Node {
        const c = this.peek()
        if (c === 46) {
            this.pos++
            return new Node(K_ANY, 0)
        }
        if (c === 40) return this.group()
        if (c === 91) return this.sets ? this.classSet() : this.characterClass()
        if (c === 92) return this.atomEscape()
        const start = this.pos
        const node = new Node(K_CHAR, this.char())
        node.from = start
        node.to = this.pos
        return node
    }

    group(): Node {
        this.pos++
        let node: Node
        if (this.peek() === 63) {
            const kind = this.peekAt(1)
            if (kind === 58) {
                this.pos += 2
                node = this.disjunction()
            } else if (kind === 61 || kind === 33) {
                this.pos += 2
                node = new Node(K_LOOK, kind === 33 ? 1 : 0)
                node.kids.push(this.disjunction())
                this.look = true
            } else if (kind === 60 && (this.peekAt(2) === 61 || this.peekAt(2) === 33)) {
                const negate = this.peekAt(2) === 33 ? 1 : 0
                this.pos += 3
                node = new Node(K_LOOKBEHIND, negate)
                node.kids.push(this.disjunction())
                this.look = true
            } else if (kind === 60) {
                this.pos += 2
                const name = this.groupName()
                if (this.error !== "") return new Node(K_EMPTY, 0)
                for (const other of this.names) if (other === name) return this.fail("Duplicate capture group name")
                node = new Node(K_GROUP, this.names.length)
                this.names.push(name)
                node.kids.push(this.disjunction())
            } else {
                return this.fail("Invalid group")
            }
        } else {
            node = new Node(K_GROUP, this.names.length)
            this.names.push("")
            node.kids.push(this.disjunction())
        }
        if (this.error !== "") return node
        if (this.peek() !== 41) return this.fail("Unterminated group")
        this.pos++
        return node
    }

    /** A group's name after `<`, and its `>`. */
    groupName(): string {
        const start = this.pos
        while (!this.atEnd() && this.peek() !== 62) {
            const at = this.pos
            const c = this.char()
            if (!isNameChar(c, at === start)) {
                this.fail("Invalid capture group name")
                return ""
            }
        }
        if (this.atEnd() || this.pos === start) {
            this.fail("Invalid capture group name")
            return ""
        }
        const name = this.text.slice(start, this.pos)
        this.pos++
        return name
    }

    /** An escape outside a class, after which the position is past it. */
    atomEscape(): Node {
        this.pos++
        if (this.atEnd()) return this.fail("\\ at end of pattern")
        const c = this.peek()
        if (c >= 49 && c <= 57) {
            // `\1`..: a backreference when there are that many groups, else an octal escape or the digit.
            const start = this.pos
            const n = this.number(1000000)
            if (n <= this.total) return new Node(K_BACKREF, n)
            if (this.unicode) return this.fail("Invalid escape")
            this.pos = start
            if (c >= 56) {
                this.pos++
                return new Node(K_CHAR, c)
            }
            return new Node(K_CHAR, this.octal())
        }
        if (c === 107 && (this.named || this.unicode)) {
            this.pos++
            if (this.peek() !== 60) return this.fail("Invalid named reference")
            this.pos++
            const name = this.groupName()
            if (this.error !== "") return new Node(K_EMPTY, 0)
            const ref = new Node(K_BACKREF, 0)
            ref.name = name
            this.references.push(ref)
            return ref
        }
        const ranges = classEscape(c, this.folded)
        if (ranges !== null) {
            this.pos++
            const node = new Node(K_CLASS, 0)
            node.ranges = ranges
            return node
        }
        if ((c === 112 || c === 80) && this.unicode) {
            const node = new Node(K_CLASS, 0)
            node.ranges = this.property()
            return node
        }
        return new Node(K_CHAR, this.characterEscape(false))
    }

    /** `\p{...}` or `\P{...}`, at its `p`: the characters of the property, or of the others for `\P`. */
    property(): int[] {
        const negate = this.peek() === 80
        this.pos++
        const out: int[] = []
        if (this.peek() !== 123) {
            this.fail("Invalid property name")
            return out
        }
        this.pos++
        const start = this.pos
        while (this.peek() !== 125) {
            const c = this.peek()
            if (!isLetter(c) && !isDigit(c) && c !== 95 && c !== 61) {
                this.fail("Invalid property name")
                return out
            }
            this.pos++
        }
        const error = propertyRanges(this.text.slice(start, this.pos), out)
        this.pos++
        if (error !== "") {
            this.fail(error)
            return out
        }
        if (this.caseless) return negate ? complement(closeCase(out)) : out
        return negate ? complement(out) : out
    }

    /** Up to three octal digits, at most 0o377. */
    octal(): int {
        let n = 0
        let count = 0
        while (count < 3 && this.peek() >= 48 && this.peek() <= 55 && n * 8 + this.peek() - 48 <= 255) {
            n = n * 8 + this.peek() - 48
            this.pos++
            count++
        }
        return n
    }

    /** `count` hex digits at the position, or -1 (consuming nothing) when they are not there. */
    hex(count: int): int {
        let n = 0
        for (let i = 0; i < count; i++) {
            const d = hexValue(this.peekAt(i))
            if (d < 0) return -1
            n = n * 16 + d
        }
        this.pos += count
        return n
    }

    /**
     * The character of an escape after its `\`, other than a class escape
     * or a backreference: `\n`, `\x41`, `A`, `\cJ`, `\0`, octal, or the
     * character itself. In a class, `\b` is a backspace and `\-` a `-`.
     */
    characterEscape(inClass: bool): int {
        const c = this.peek()
        switch (c) {
            case 116:
                this.pos++
                return 9
            case 110:
                this.pos++
                return 10
            case 118:
                this.pos++
                return 11
            case 102:
                this.pos++
                return 12
            case 114:
                this.pos++
                return 13
            case 98:
                this.pos++
                return 8
            case 48:
                this.pos++
                if (isDigit(this.peek())) {
                    if (this.unicode) {
                        this.fail("Invalid decimal escape")
                        return 0
                    }
                    this.pos--
                    return this.octal()
                }
                return 0
            case 99: {
                const letter = this.peekAt(1)
                if (isLetter(letter) || (inClass && !this.unicode && (isDigit(letter) || letter === 95))) {
                    this.pos += 2
                    return letter % 32
                }
                if (this.unicode) {
                    this.fail("Invalid Unicode escape")
                    return 0
                }
                // A `\` that escapes nothing: the `c` is read next.
                return 92
            }
            case 120: {
                this.pos++
                const value = this.hex(2)
                if (value < 0 && this.unicode) {
                    this.fail("Invalid escape")
                    return 0
                }
                return value < 0 ? 120 : value
            }
            case 117: {
                this.pos++
                if (this.unicode && this.peek() === 123) return this.codePoint()
                const value = this.hex(4)
                if (value < 0 && this.unicode) {
                    this.fail("Invalid Unicode escape")
                    return 0
                }
                if (value < 0) return 117
                // A surrogate pair written as two escapes is one character.
                if (value >= 0xd800 && value <= 0xdbff && this.peek() === 92 && this.peekAt(1) === 117) {
                    const save = this.pos
                    this.pos += 2
                    const low = this.hex(4)
                    if (low >= 0xdc00 && low <= 0xdfff) return 0x10000 + ((value - 0xd800) << 10) + (low - 0xdc00)
                    this.pos = save
                }
                return value
            }
        }
        if (this.unicode) {
            // Only the characters of the syntax escape themselves: `^$\.*+?()[]{}|/`, and `-` in a class.
            if ((c >= 49 && c <= 55 && inClass) || isDigit(c)) {
                this.fail(c >= 56 ? "Invalid escape" : "Invalid decimal escape")
                return 0
            }
            if (!isSyntaxChar(c) && !(inClass && c === 45)) {
                this.fail("Invalid escape")
                return 0
            }
            this.pos++
            return c
        }
        if (inClass && c >= 49 && c <= 55) return this.octal()
        return this.char()
    }

    /** `{hex}` of `\u{...}`, at its `{`: a code point up to U+10FFFF. */
    codePoint(): int {
        this.pos++
        let n = 0
        const start = this.pos
        while (hexValue(this.peek()) >= 0) {
            n = n * 16 + hexValue(this.peek())
            if (n > 0x10ffff) n = 0x110000
            this.pos++
        }
        if (this.pos === start || this.peek() !== 125 || n > 0x10ffff) {
            this.fail("Invalid Unicode escape")
            return 0
        }
        this.pos++
        return n
    }

    characterClass(): Node {
        this.pos++
        const node = new Node(K_CLASS, 0)
        if (this.peek() === 94) {
            node.value = 1
            this.pos++
        }
        const ranges: int[] = []
        for (;;) {
            if (this.atEnd()) return this.fail("Unterminated character class")
            if (this.peek() === 93) {
                this.pos++
                break
            }
            const first = this.classAtom(ranges)
            if (this.error !== "") return node
            if (this.peek() !== 45 || this.peekAt(1) === 93 || this.peekAt(1) === -1) {
                if (first >= 0) {
                    ranges.push(first)
                    ranges.push(first)
                }
                continue
            }
            // A range `a-b`; with a class escape on either side, `-` is itself (Annex B).
            this.pos++
            const last = this.classAtom(ranges)
            if (this.error !== "") return node
            if (first < 0 || last < 0) {
                if (this.unicode) return this.fail("Invalid character class")
                if (first >= 0) {
                    ranges.push(first)
                    ranges.push(first)
                }
                if (last >= 0) {
                    ranges.push(last)
                    ranges.push(last)
                }
                ranges.push(45)
                ranges.push(45)
                continue
            }
            if (first > last) return this.fail("Range out of order in character class")
            ranges.push(first)
            ranges.push(last)
        }
        node.ranges = normalize(ranges)
        return node
    }

    /**
     * A class of the `v` flag, at its `[`: characters, ranges, class escapes
     * and nested classes joined, or operands of `--` (the characters of the
     * first but not the others) or `&&` (the characters of all of them).
     */
    classSet(): Node {
        this.pos++
        const node = new Node(K_CLASS, 0)
        if (this.peek() === 94) {
            node.value = 1
            this.pos++
        }
        node.ranges = this.classSetBody()
        if (this.error !== "") return node
        if (node.value === 1 && this.mayStrings) return this.fail("Negated character class may contain strings")
        if (this.strings.length === 0) return node
        return classWithStrings(node, this.strings)
    }

    /**
     * The characters of a class of the `v` flag after its `[` or `[^`, sorted,
     * and its strings in `strings` and `mayStrings`; past its `]`.
     */
    classSetBody(): int[] {
        const none: int[] = []
        this.strings = []
        this.mayStrings = false
        if (this.peek() === 93) {
            this.pos++
            return none
        }
        if (this.doubled()) {
            this.fail("Invalid set operation in character class")
            return none
        }
        let operand = this.setOperand()
        if (this.error !== "") return none
        if (this.caseless) operand = closeCase(operand)
        let strings = this.strings
        let may = this.mayStrings
        const op = this.peek()
        if ((op === 45 || op === 38) && this.peekAt(1) === op) {
            // `A--B--C` or `A&&B&&C`: one operator, no ranges.
            let set = operand
            for (;;) {
                this.pos += 2
                if (op === 38 && this.peek() === 38) {
                    this.fail("Invalid character in character class")
                    return none
                }
                let next = this.setOperand()
                if (this.error !== "") return none
                if (this.caseless) next = closeCase(next)
                set = op === 45 ? intersect(set, complement(next)) : intersect(set, next)
                // The strings of the first operand also in the next (`&&`) or not in it (`--`).
                const kept: int[][] = []
                for (const t of strings) if (hasString(this.strings, t) === (op === 38)) kept.push(t)
                strings = kept
                if (op === 38) may = may && this.mayStrings
                if (this.atEnd()) {
                    this.fail("Unterminated character class")
                    return none
                }
                if (this.peek() === 93) {
                    this.pos++
                    this.strings = strings
                    this.mayStrings = may
                    return set
                }
                if (this.peek() !== op || this.peekAt(1) !== op) {
                    this.fail("Invalid set operation in character class")
                    return none
                }
            }
        }
        // A union of characters, ranges, classes and strings.
        const ranges: int[] = []
        const all: int[][] = []
        for (;;) {
            for (const t of strings) if (!hasString(all, t)) all.push(t)
            if (this.single >= 0 && this.peek() === 45 && this.peekAt(1) !== 45) {
                const first = this.single
                this.pos++
                if (this.peek() === 93) {
                    this.fail("Invalid character in character class")
                    return none
                }
                this.setOperand()
                if (this.error !== "") return none
                const last = this.single
                if (last < 0) {
                    this.fail("Invalid character class")
                    return none
                }
                if (first > last) {
                    this.fail("Range out of order in character class")
                    return none
                }
                operand = [first, last]
                if (this.caseless) operand = closeCase(operand)
            }
            for (const r of operand) ranges.push(r)
            if (this.atEnd()) {
                this.fail("Unterminated character class")
                return none
            }
            if (this.peek() === 93) {
                this.pos++
                this.strings = all
                this.mayStrings = may
                return normalize(ranges)
            }
            if (this.peek() === 45 && this.peekAt(1) !== 45) {
                this.fail("Invalid character class")
                return none
            }
            if (this.doubled()) {
                this.fail("Invalid set operation in character class")
                return none
            }
            operand = this.setOperand()
            if (this.error !== "") return none
            if (this.caseless) operand = closeCase(operand)
            strings = this.strings
            may = may || this.mayStrings
        }
    }

    /** Whether a doubled punctuator that a class of the `v` flag reserves is at the position. */
    doubled(): bool {
        const c = this.peek()
        return c >= 0 && c === this.peekAt(1) && isSetPunctuator(c)
    }

    /**
     * An operand of a class of the `v` flag: a character (also in `single`), a
     * class escape, `\q{...}` or a nested class, sorted; its strings in
     * `strings` and `mayStrings`.
     */
    setOperand(): int[] {
        this.single = -1
        this.strings = []
        this.mayStrings = false
        const none: int[] = []
        if (this.atEnd()) {
            this.fail("Unterminated character class")
            return none
        }
        const c = this.peek()
        if (c === 91) {
            this.pos++
            let negate = false
            if (this.peek() === 94) {
                negate = true
                this.pos++
            }
            const inner = this.classSetBody()
            this.single = -1
            if (!negate) return inner
            if (this.mayStrings && this.error === "") this.fail("Negated character class may contain strings")
            return complement(inner)
        }
        if (c === 92) {
            this.pos++
            if (this.atEnd()) {
                this.fail("\\ at end of pattern")
                return none
            }
            const e = this.peek()
            if (this.caseless && (e === 68 || e === 83 || e === 87)) {
                // `\D`, `\S` and `\W` complement the characters of `\d`, `\s` or `\w` closed under case.
                this.pos++
                return complement(closeCase(classEscape(e + 32, this.folded)!))
            }
            const escape = classEscape(e, this.folded)
            if (escape !== null) {
                this.pos++
                return escape
            }
            if (e === 112 || e === 80) return this.property()
            if (e === 113) return this.classStrings()
            if (isSetPunctuator(e) || isSyntaxChar(e)) {
                this.pos++
                this.single = e
            } else {
                this.single = this.characterEscape(true)
            }
            return [this.single, this.single]
        }
        if (isSetSyntaxChar(c) || c === 93) {
            this.fail("Invalid character in character class")
            return none
        }
        if (this.doubled()) {
            this.fail("Invalid set operation in character class")
            return none
        }
        this.single = this.char()
        return [this.single, this.single]
    }

    /**
     * `\q{...}` at its `q`: its alternatives of one character as ranges, the
     * others (empty or longer) in `strings`, folded with the flag `i`.
     */
    classStrings(): int[] {
        const ranges: int[] = []
        this.pos++
        if (this.peek() !== 123) {
            this.fail("Invalid escape")
            return ranges
        }
        this.pos++
        let current: int[] = []
        for (;;) {
            if (this.atEnd()) {
                this.fail("Unterminated character class")
                return ranges
            }
            const c = this.peek()
            if (c === 124 || c === 125) {
                this.pos++
                if (current.length === 1) {
                    ranges.push(current[0])
                    ranges.push(current[0])
                } else {
                    this.mayStrings = true
                    if (!hasString(this.strings, current)) this.strings.push(current)
                }
                if (c === 125) return normalize(ranges)
                current = []
            } else {
                const ch = this.stringChar()
                if (this.error !== "") return ranges
                current.push(this.caseless ? canonicalizeUnicode(ch) : ch)
            }
        }
    }

    /** A character of a string of `\q{...}`: itself, or an escape of one. */
    stringChar(): int {
        const c = this.peek()
        if (c !== 92) {
            if (isSetSyntaxChar(c)) {
                this.fail("Invalid character in character class")
                return 0
            }
            if (this.doubled()) {
                this.fail("Invalid set operation in character class")
                return 0
            }
            return this.char()
        }
        this.pos++
        if (this.atEnd()) {
            this.fail("\\ at end of pattern")
            return 0
        }
        const e = this.peek()
        if (isSetPunctuator(e) || isSyntaxChar(e)) {
            this.pos++
            return e
        }
        if (classEscape(e, false) !== null || e === 112 || e === 80 || e === 113) {
            this.fail("Invalid escape")
            return 0
        }
        return this.characterEscape(true)
    }

    /** A character of a class, or -1 for a class escape such as `\d`, whose ranges are added. */
    classAtom(ranges: int[]): int {
        if (this.peek() !== 92) return this.char()
        this.pos++
        if (this.atEnd()) {
            this.fail("\\ at end of pattern")
            return -1
        }
        const c = this.peek()
        const escape = classEscape(c, this.folded)
        if (escape !== null) {
            this.pos++
            for (const r of escape) ranges.push(r)
            return -1
        }
        if ((c === 112 || c === 80) && this.unicode) {
            for (const r of this.property()) ranges.push(r)
            return -1
        }
        if (c === 45) {
            this.pos++
            return 45
        }
        return this.characterEscape(true)
    }
}

/** Whether two strings of `\q{...}`, as their characters, are the same. */
function sameString(a: int[], b: int[]): bool {
    if (a.length !== b.length) return false
    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false
    return true
}

/** Whether a list of strings of `\q{...}` holds a string. */
function hasString(list: int[][], s: int[]): bool {
    for (const t of list) if (sameString(t, s)) return true
    return false
}

/**
 * A class of the `v` flag with strings, as alternatives that try the longest
 * strings first, then the class's characters, then the empty string.
 */
function classWithStrings(node: Node, strings: int[][]): Node {
    const alt = new Node(K_ALT, 0)
    let empty = false
    let longest = 0
    for (const t of strings) {
        if (t.length === 0) empty = true
        if (t.length > longest) longest = t.length
    }
    for (let length = longest; length >= 2; length--) {
        for (const t of strings) {
            if (t.length !== length) continue
            const seq = new Node(K_SEQ, 0)
            for (const c of t) seq.kids.push(new Node(K_CHAR, c))
            alt.kids.push(seq)
        }
    }
    if (node.ranges.length > 0) alt.kids.push(node)
    if (empty) alt.kids.push(new Node(K_EMPTY, 0))
    if (alt.kids.length === 1) return alt.kids[0]
    return alt
}

// -----------------------------------------------------------------------------
// Compiling

/** Whether a node can match the empty string, so that a loop around it must check its progress. */
function canBeEmpty(node: Node): bool {
    switch (node.kind) {
        case K_CHAR:
        case K_ANY:
        case K_CLASS:
            return false
        case K_SEQ:
            for (const kid of node.kids) if (!canBeEmpty(kid)) return false
            return true
        case K_ALT:
            for (const kid of node.kids) if (canBeEmpty(kid)) return true
            return false
        case K_GROUP:
            return canBeEmpty(node.kids[0])
        case K_REPEAT:
            return node.min === 0 || canBeEmpty(node.kids[0])
    }
    return true
}

/** The lowest and one past the highest group number in a node, or [0, 0]. */
function groupSpan(node: Node, span: int[]) {
    if (node.kind === K_GROUP) {
        if (span[1] === 0 || node.value < span[0]) span[0] = node.value
        if (node.value + 1 > span[1]) span[1] = node.value + 1
    }
    for (const kid of node.kids) groupSpan(kid, span)
}

class Compiler {
    constructor(
        readonly program: Program,
        readonly pattern: string,
    ) {}

    /** Whether the code emitted reads backwards, in a lookbehind. */
    back = false

    op(code: int) {
        this.program.code.push(code)
    }

    /** Emits an instruction with a target filled later; returns the operand's index. */
    hole(): int {
        this.program.code.push(-1)
        return this.program.code.length - 1
    }

    here(): int {
        return this.program.code.length
    }

    patch(at: int) {
        this.program.code[at] = this.program.code.length
    }

    emit(node: Node) {
        const p = this.program
        if (p.code.length > maxCode) return
        switch (node.kind) {
            case K_EMPTY:
                return
            case K_CHAR:
                if (p.ignoreCase) {
                    this.read(OP_CHAR_I)
                    this.op(p.unicode ? canonicalizeUnicode(node.value) : canonicalize(node.value))
                } else {
                    this.read(OP_CHAR)
                    this.op(node.value)
                }
                return
            case K_ANY:
                this.read(p.dotAll ? OP_ANY_ALL : OP_ANY)
                return
            case K_CLASS:
                this.read(p.ignoreCase ? OP_CLASS_I : OP_CLASS)
                this.op(p.sets.length)
                this.op(node.value)
                p.sets.push(node.ranges)
                return
            case K_SEQ:
                // Backwards, a sequence matches its last term first.
                if (this.back) for (let i = node.kids.length - 1; i >= 0; i--) this.emit(node.kids[i])
                else for (const kid of node.kids) this.emit(kid)
                return
            case K_ALT: {
                const ends: int[] = []
                for (let i = 0; i < node.kids.length; i++) {
                    if (i < node.kids.length - 1) {
                        this.op(OP_SPLIT)
                        this.op(this.here() + 2)
                        const next = this.hole()
                        this.emit(node.kids[i])
                        this.op(OP_JUMP)
                        ends.push(this.hole())
                        this.patch(next)
                    } else {
                        this.emit(node.kids[i])
                    }
                }
                for (const end of ends) this.patch(end)
                return
            }
            case K_GROUP:
                // Backwards, a group's end is known first.
                this.op(OP_SAVE)
                this.op(this.back ? 2 * node.value + 1 : 2 * node.value)
                this.emit(node.kids[0])
                this.op(OP_SAVE)
                this.op(this.back ? 2 * node.value : 2 * node.value + 1)
                return
            case K_REPEAT:
                this.repeat(node)
                return
            case K_BOL:
                this.op(OP_BOL)
                return
            case K_EOL:
                this.op(OP_EOL)
                return
            case K_WORD:
                this.op(OP_WORD)
                this.op(node.value)
                return
            case K_BACKREF:
                this.read(OP_BACKREF)
                this.op(node.value)
                return
            case K_LOOK:
            case K_LOOKBEHIND: {
                this.op(OP_LOOK)
                this.op(node.value)
                const end = this.hole()
                const back = this.back
                this.back = node.kind === K_LOOKBEHIND
                this.emit(node.kids[0])
                this.back = back
                this.op(OP_LOOK_END)
                this.patch(end)
                return
            }
        }
    }

    /** An instruction that reads a character, backwards in a lookbehind. */
    read(code: int) {
        this.op(this.back ? code + OP_BACK : code)
    }

    /**
     * A repetition: its atom copied `min` times, then a loop or `max - min`
     * optional copies. Each iteration starts with the atom's groups unset,
     * and one beyond the minimum fails when it matches nothing.
     */
    repeat(node: Node) {
        const atom = node.kids[0]
        if (node.max === 0) return
        const span = [0, 0]
        groupSpan(atom, span)
        const empty = canBeEmpty(atom)
        for (let i = 0; i < node.min && this.program.code.length <= maxCode; i++) this.iteration(atom, span, -1)
        const single = atom.kind === K_CHAR || atom.kind === K_CLASS || atom.kind === K_ANY
        if (node.max === unbounded && node.greedy && !this.back && single) {
            this.op(OP_STAR)
            const exit = this.hole()
            this.emit(atom)
            this.patch(exit)
            return
        }
        if (node.max === unbounded) {
            const loop = this.here()
            const exit = this.split(node.greedy)
            this.iteration(atom, span, empty ? this.register() : -1)
            this.op(OP_JUMP)
            this.op(loop)
            this.patch(exit)
            return
        }
        const exits: int[] = []
        for (let i = node.min; i < node.max && this.program.code.length <= maxCode; i++) {
            exits.push(this.split(node.greedy))
            this.iteration(atom, span, empty ? this.register() : -1)
        }
        for (const exit of exits) this.patch(exit)
    }

    /** A `SPLIT` into the code that follows and an exit, in the order of greediness; returns the exit's hole. */
    split(greedy: bool): int {
        this.op(OP_SPLIT)
        if (greedy) {
            this.op(this.here() + 2)
            return this.hole()
        }
        const exit = this.hole()
        this.op(this.here() + 1)
        return exit
    }

    register(): int {
        this.program.slots++
        return this.program.slots - 1
    }

    iteration(atom: Node, span: int[], register: int) {
        if (register >= 0) {
            this.op(OP_SAVE)
            this.op(register)
        }
        if (span[1] > 0) {
            this.op(OP_RESET)
            this.op(2 * span[0])
            this.op(2 * span[1])
        }
        this.emit(atom)
        if (register >= 0) {
            this.op(OP_PROGRESS)
            this.op(register)
        }
    }

    /** What every match starts with: literal text, or the start of the input. */
    start(root: Node) {
        const p = this.program
        let first = root
        if (root.kind === K_SEQ && root.kids.length > 0) first = root.kids[0]
        if (first.kind === K_BOL && !p.multiline) p.anchored = true
        if (p.ignoreCase) return
        let prefix = ""
        const kids = root.kind === K_SEQ ? root.kids : [root]
        for (const kid of kids) {
            if (kid.kind !== K_CHAR || kid.from < 0) break
            prefix += this.pattern.slice(kid.from, kid.to)
        }
        p.prefix = prefix
    }
}
