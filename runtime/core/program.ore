//ore:internal
// The program: its entry point, its arguments, panics, and what the tests of
// "ore:test" (runtime/std/test.ore) need from the runtime.

import { getTop } from "ore:runtime/frames"
import { init as initGc, registerThread } from "ore:runtime/gc"
import { countTest as count, exitProgram, flushOutput, initOutput, writeString } from "ore:runtime/io"
import { isNil, nil } from "ore:runtime/os"
import { endTask, isMainTask, runMain, setMainEnd, spawnTest, taskCurrent, Task } from "ore:runtime/task"

/** The program's top-level code, generated by the compiler. */
declare function ore_entry(): void

let argCount: i32
let argValues: ptr
let envValues: ptr

/** The NUL-terminated bytes at `p`, copied into a string. */
function copyCString(p: ptr): string {
    let n = 0
    while (unsafe.load<u8>(unsafe.add(p, n)) !== 0) n++
    const copy = unsafe.allocBytes(n)
    unsafe.copy(copy, p, n)
    return unsafe.makeString(copy, n)
}

/** The process starts here: the GC and the output, then the top-level code as the first task. */
//ore:export main
function main(argc: i32, argv: ptr, envp: ptr): i32 {
    argCount = argc
    argValues = argv
    envValues = envp
    initGc()
    registerThread()
    initOutput()
    runMain(unsafe.functionAddress(ore_entry))
    return 0
}

/** The command-line arguments after the program name. */
//ore:runtime ore_rt_args
function args(): string[] {
    const out: string[] = []
    for (let i = 1; i < i64(argCount); i++) out.push(copyCString(unsafe.load<ptr>(unsafe.add(argValues, i * 8))))
    return out
}

/** The environment the process started with: a NULL-terminated array of "NAME=value" C strings. */
export function environment(): ptr {
    return envValues
}

// ---------------------------------------------------------------------------
// Panics

/** The record of a test that runs: whether it failed and why, and a channel its end is signalled on. */
class TestRecord {
    failed = false
    failure = ""
    done = new Chan<bool>(1)
}

/**
 * Stops the program with a message and the stack of debug frames. In a test
 * of `ore test`, it fails the test instead and ends only the test's task.
 */
//ore:runtime ore_rt_panic
function panic(message: string): void {
    const current = taskCurrent()
    if (!isNil(current)) {
        const t = unsafe.fromAddress<Task>(current)
        if (!isNil(t.test)) {
            const record = unsafe.fromAddress<TestRecord>(t.test)
            record.failed = true
            record.failure = message
            record.done.send(true)
            endTask()
        }
    }
    flushOutput()
    writeString(2, `panic: ${message}\n\n`)
    // The shadow stack: frames of {previous, function, file, line}.
    let frame = getTop()
    if (isNil(frame)) {
        // Release builds keep no shadow stack, and native symbols of static
        // functions are unreliable, so no trace is better than a wrong one.
        writeString(2, "  (no stack trace in release builds; rebuild without --release)\n")
    }
    while (!isNil(frame)) {
        const func = copyCString(unsafe.load<ptr>(unsafe.add(frame, 8)))
        const file = copyCString(unsafe.load<ptr>(unsafe.add(frame, 16)))
        writeString(2, `  ${func} at ${file}:${unsafe.load<i32>(unsafe.add(frame, 24))}\n`)
        frame = unsafe.load<ptr>(frame)
    }
    exitProgram(2)
}

/** A panic with a C string, for the C runtime and generated code. */
//ore:runtime ore_rt_panic_cstr
//ore:export ore_rt_panic_cstr
function panicCString(message: ptr): void {
    panic(copyCString(message))
}

/** An index out of an array's or a string's bounds; also called by the C runtime's inline helpers. */
//ore:runtime ore_rt_panic_index
//ore:export ore_rt_panic_index
function panicIndex(index: i64, length: i64): void {
    panic(`index out of range [${index}] with length ${length}`)
}

// ---------------------------------------------------------------------------
// Tests

/**
 * Runs a body of "ore:test" (a test or a hook) in its own task: the panic
 * that ends it is its failure, returned; null when it ends normally.
 */
//ore:runtime ore_rt_catch_panic
function catchPanic(body: () => void): string {
    const record = new TestRecord()
    spawnTest(() => {
        body()
        record.done.send(true)
    }, unsafe.addressOf(record))
    record.done.receive()
    // A string without bytes is null as a `string | null`.
    if (!record.failed) return unsafe.makeString(nil(), 0)
    return record.failure === "" ? "panic" : record.failure
}

/**
 * Counts a test of "ore:test" for the summary at the end (0 passed, 1
 * failed, 2 skipped, 3 todo), and writes out what it printed.
 */
//ore:runtime ore_rt_count_test
function countTest(outcome: int): void {
    count(outcome)
    flushOutput()
}

/** Whether the current task is the one running the program's top-level code. */
//ore:runtime ore_rt_in_main_task
function inMainTask(): bool {
    return isMainTask()
}

/** Calls `body` when the program's top-level code ends, before the program does (once; a later call replaces it). */
//ore:runtime ore_rt_at_main_end
function atMainEnd(body: () => void): void {
    setMainEnd(body)
}
