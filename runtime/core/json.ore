//ore:internal
// JSON: the string builder that encoders write into, the parser into a tree of
// values, and the helpers of the decoders that the compiler generates per
// type. Generated code reads these layouts directly:
//   builder  {data: ptr, len: int, cap: int}
//   value    {kind: i32 @0, bool: u8 @4, number: f64 @8, text: string @16,
//             len: int @32, items: ptr @40, keys: ptr @48, source: string @56},
//             72 bytes; `source` is the text of a parsed string, quotes and
//             escapes included, for the context of a reviver
//   context  {failed: u8 @0, message: string @8, path: string @24}
// Messages and field names come from generated code as NUL-terminated bytes.

/** Reads decimal text exactly, rounding to the nearest f64; from libc. */
declare function strtod(text: ptr, end: ptr): f64

const kindNull = 0
const kindBool = 1
const kindNumber = 2
const kindString = 3
const kindArray = 4
const kindObject = 5
const kindNames = ["null", "a boolean", "a number", "a string", "an array", "an object"]

function nil(): ptr {
    return unsafe.fromInt(0)
}

function isNil(p: ptr): bool {
    return unsafe.toInt(p) === 0
}

/** The NUL-terminated bytes at `p`, as a string sharing them. */
function cText(p: ptr): string {
    let n = 0
    while (unsafe.load<u8>(unsafe.add(p, n)) !== 0) n++
    return unsafe.makeString(p, n)
}

// ---------------------------------------------------------------------------
// The string builder

/** Makes room for `n` more bytes. */
function reserve(b: ptr, n: int): void {
    const len = unsafe.load<int>(unsafe.add(b, 8))
    const cap = unsafe.load<int>(unsafe.add(b, 16))
    if (len + n <= cap) return
    let grown = cap < 64 ? 64 : cap * 2
    while (grown < len + n) grown *= 2
    const data = unsafe.allocBytes(grown)
    if (len > 0) unsafe.copy(data, unsafe.load<ptr>(b), len)
    unsafe.store<ptr>(b, data)
    unsafe.store<int>(unsafe.add(b, 16), grown)
}

//ore:runtime ore_sb_put
function sbPut(b: ptr, bytes: ptr, n: int): void {
    if (n <= 0) return
    reserve(b, n)
    const len = unsafe.load<int>(unsafe.add(b, 8))
    unsafe.copy(unsafe.add(unsafe.load<ptr>(b), len), bytes, n)
    unsafe.store<int>(unsafe.add(b, 8), len + n)
}

//ore:runtime ore_sb_putc
function sbPutc(b: ptr, c: u8): void {
    reserve(b, 1)
    const len = unsafe.load<int>(unsafe.add(b, 8))
    unsafe.store<u8>(unsafe.add(unsafe.load<ptr>(b), len), c)
    unsafe.store<int>(unsafe.add(b, 8), len + 1)
}

//ore:runtime ore_sb_string
function sbString(b: ptr): string {
    return unsafe.makeString(unsafe.load<ptr>(b), unsafe.load<int>(unsafe.add(b, 8)))
}

function sbPutString(b: ptr, s: string): void {
    sbPut(b, unsafe.stringData(s), s.length)
}

/** A new, empty builder. */
function builder(): ptr {
    return unsafe.alloc(24)
}

// ---------------------------------------------------------------------------
// Writing JSON

const hexDigits = "0123456789abcdef"

/** Writes `s` as a JSON string literal. */
//ore:runtime ore_rt_json_str
function jsonStr(b: ptr, s: string): void {
    const p = unsafe.stringData(s)
    sbPutc(b, 0x22)
    let start = 0
    for (let i = 0; i < s.length; i++) {
        const c = unsafe.load<u8>(unsafe.add(p, i))
        if (c >= 0x20 && c !== 0x22 && c !== 0x5c) continue
        sbPut(b, unsafe.add(p, start), i - start)
        start = i + 1
        if (c === 0x22) sbPutString(b, '\\"')
        else if (c === 0x5c) sbPutString(b, "\\\\")
        else if (c === 0x0a) sbPutString(b, "\\n")
        else if (c === 0x0d) sbPutString(b, "\\r")
        else if (c === 0x09) sbPutString(b, "\\t")
        else if (c === 0x08) sbPutString(b, "\\b")
        else if (c === 0x0c) sbPutString(b, "\\f")
        else {
            sbPutString(b, "\\u00")
            sbPutc(b, hexDigits[i64(c >> 4)])
            sbPutc(b, hexDigits[i64(c & 15)])
        }
    }
    sbPut(b, unsafe.add(p, start), s.length - start)
    sbPutc(b, 0x22)
}

/** Writes the decimal digits of `value` straight into the builder, after a minus sign if `negative`. */
function putDecimal(b: ptr, value: u64, negative: bool): void {
    let digits = 1
    for (let rest = value / 10; rest !== 0; rest /= 10) digits++
    const n = negative ? digits + 1 : digits
    reserve(b, n)
    const len = unsafe.load<int>(unsafe.add(b, 8))
    const data = unsafe.add(unsafe.load<ptr>(b), len)
    if (negative) unsafe.store<u8>(data, 0x2d)
    let rest = value
    for (let at = n - 1; at >= n - digits; at--) {
        unsafe.store<u8>(unsafe.add(data, at), u8(rest % 10) + 0x30)
        rest /= 10
    }
    unsafe.store<int>(unsafe.add(b, 8), len + n)
}

//ore:runtime ore_rt_json_i64
function jsonI64(b: ptr, v: i64): void {
    // The magnitude as u64, which also holds that of the smallest i64.
    if (v < 0) putDecimal(b, u64(0) - u64(v), true)
    else putDecimal(b, u64(v), false)
}

//ore:runtime ore_rt_json_u64
function jsonU64(b: ptr, v: u64): void {
    putDecimal(b, v, false)
}

/**
 * The options of a `JSON.stringify` call: `gap`, the indentation of each
 * level ("" for none), the keys the replacer array keeps, in its order
 * without repeats, or null when there is none, and the replacer function.
 * Not exported: the exports of this module are members of `JSON`.
 */
class JsonOptions {
    keys: string[] | null = null
    replacer: ((key: string, value: unknown) => unknown) | null = null
    constructor(readonly gap: string) {}
}

/** The options of a call indented by `space` spaces, at most 10 as in JavaScript. */
//ore:runtime ore_rt_json_spaces
function jsonSpaces(space: int): JsonOptions {
    return new JsonOptions(" ".repeat(space < 0 ? 0 : space > 10 ? 10 : space))
}

/** The options of a call indented by a string, its first 10 characters as in JavaScript. */
//ore:runtime ore_rt_json_gap
function jsonGap(space: string): JsonOptions {
    let end = 0
    let n = 0
    for (const r of space) {
        if (n === 10) break
        end += String.fromCodePoint(i64(r)).length
        n++
    }
    return new JsonOptions(space.slice(0, end))
}

/** Keeps only the `keys` of objects. */
//ore:runtime ore_rt_json_keep
function jsonKeep(o: JsonOptions, keys: string[]): void {
    const kept: string[] = []
    for (const k of keys) if (!kept.includes(k)) kept.push(k)
    o.keys = kept
}

/** How many keys the replacer array keeps, -1 without one. */
//ore:runtime ore_rt_json_key_count
function jsonKeyCount(o: JsonOptions): int {
    const keys = o.keys
    return keys === null ? -1 : keys.length
}

//ore:runtime ore_rt_json_key_at
function jsonKeyAt(o: JsonOptions, i: int): string {
    return o.keys![i]
}

/** How many passes write the entries of a map: one for each key of the replacer array, else one. */
//ore:runtime ore_rt_json_rounds
function jsonRounds(o: JsonOptions): int {
    const keys = o.keys
    return keys === null ? 1 : keys.length
}

/** Whether pass `round` writes the entry of a map with a key: all without a replacer array, else the one with its key. */
//ore:runtime ore_rt_json_kept
function jsonKept(o: JsonOptions, round: int, key: string): bool {
    const keys = o.keys
    return keys === null || keys[round] === key
}

/** Whether a space follows the colon of each entry: with an indentation. */
//ore:runtime ore_rt_json_spaced
function jsonSpaced(o: JsonOptions): bool {
    return o.gap.length > 0
}

/** With an indentation: a line break and the gap `depth` times. */
//ore:runtime ore_rt_json_newline
function jsonNewline(b: ptr, o: JsonOptions, depth: int): void {
    const gap = o.gap
    if (gap.length === 0) return
    sbPutc(b, 0x0a)
    for (let i = 0; i < depth; i++) for (let j = 0; j < gap.length; j++) sbPutc(b, gap[j])
}

// ---------------------------------------------------------------------------
// Parsing JSON into values

const valueSize = 72

function newValue(kind: int): ptr {
    const v = unsafe.alloc(valueSize)
    unsafe.store<i32>(v, i32(kind))
    return v
}

function kindOf(v: ptr): int {
    return i64(unsafe.load<i32>(v))
}

function textOf(v: ptr): string {
    return unsafe.load<string>(unsafe.add(v, 16))
}

class Parser {
    /** The first error, or "". */
    error = ""
    depth = 0
    /** A buffer for the text of a number, NUL-terminated for strtod. */
    scratch: ptr = unsafe.fromInt(0)
    scratchSize = 0
    /** Where `jsonReadKey` puts the key it read, a string. */
    key: ptr = unsafe.alloc(16)

    constructor(
        public text: ptr,
        public at: int,
        public end: int,
    ) {}

    more(): bool {
        return this.at < this.end
    }

    peek(): u8 {
        return unsafe.load<u8>(unsafe.add(this.text, this.at))
    }

    fail(error: string): ptr {
        if (this.error === "") this.error = error
        return nil()
    }

    space(): void {
        // Locals rather than the methods above: this runs before every token.
        const text = this.text
        let at = this.at
        while (at < this.end) {
            const c = unsafe.load<u8>(unsafe.add(text, at))
            if (c !== 0x20 && c !== 0x09 && c !== 0x0a && c !== 0x0d) break
            at++
        }
        this.at = at
    }

    literal(word: string): bool {
        if (this.end - this.at < word.length) return false
        if (unsafe.compare(unsafe.add(this.text, this.at), unsafe.stringData(word), word.length) !== 0) return false
        this.at += word.length
        return true
    }

    isDigit(): bool {
        return this.more() && this.peek() >= 0x30 && this.peek() <= 0x39
    }
}

/** Four hex digits, or -1. */
function hex4(ps: Parser): int {
    if (ps.end - ps.at < 4) return -1
    let v = 0
    for (let i = 0; i < 4; i++) {
        const c = unsafe.load<u8>(unsafe.add(ps.text, ps.at + i))
        v <<= 4
        if (c >= 0x30 && c <= 0x39) v |= i64(c - 0x30)
        else if (c >= 0x61 && c <= 0x66) v |= i64(c - 0x61) + 10
        else if (c >= 0x41 && c <= 0x46) v |= i64(c - 0x41) + 10
        else return -1
    }
    ps.at += 4
    return v
}

function putUtf8(b: ptr, cp: int): void {
    if (cp < 0x80) sbPutc(b, u8(cp))
    else if (cp < 0x800) {
        sbPutc(b, u8(0xc0 | (cp >> 6)))
        sbPutc(b, u8(0x80 | (cp & 0x3f)))
    } else if (cp < 0x10000) {
        sbPutc(b, u8(0xe0 | (cp >> 12)))
        sbPutc(b, u8(0x80 | ((cp >> 6) & 0x3f)))
        sbPutc(b, u8(0x80 | (cp & 0x3f)))
    } else {
        sbPutc(b, u8(0xf0 | (cp >> 18)))
        sbPutc(b, u8(0x80 | ((cp >> 12) & 0x3f)))
        sbPutc(b, u8(0x80 | ((cp >> 6) & 0x3f)))
        sbPutc(b, u8(0x80 | (cp & 0x3f)))
    }
}

/**
 * A string at the opening quote, written to `out`, or false with an error. A
 * string without escapes shares the bytes of the text.
 */
function scanString(ps: Parser, out: ptr): bool {
    const first = ps.at + 1
    const text = ps.text
    let at = first
    while (at < ps.end) {
        const c = unsafe.load<u8>(unsafe.add(text, at))
        if (c === 0x22) {
            unsafe.store<string>(out, unsafe.makeString(unsafe.add(text, first), at - first))
            ps.at = at + 1
            return true
        }
        if (c < 0x20 || c === 0x5c) break
        at++
    }
    ps.at = at
    const b = builder()
    let run = first
    while (ps.more() && ps.peek() !== 0x22) {
        const c = ps.peek()
        if (c < 0x20) {
            ps.fail("control character in string")
            return false
        }
        if (c !== 0x5c) {
            ps.at++
            continue
        }
        sbPut(b, unsafe.add(ps.text, run), ps.at - run)
        ps.at++
        if (!ps.more()) break
        const e = ps.peek()
        ps.at++
        if (e === 0x22 || e === 0x5c || e === 0x2f) sbPutc(b, e)
        else if (e === 0x62) sbPutc(b, 0x08)
        else if (e === 0x66) sbPutc(b, 0x0c)
        else if (e === 0x6e) sbPutc(b, 0x0a)
        else if (e === 0x72) sbPutc(b, 0x0d)
        else if (e === 0x74) sbPutc(b, 0x09)
        else if (e === 0x75) {
            let cp = hex4(ps)
            if (cp < 0) {
                ps.fail("invalid \\u escape")
                return false
            }
            // A surrogate pair encodes a code point above U+FFFF.
            if (
                cp >= 0xd800 &&
                cp < 0xdc00 &&
                ps.end - ps.at >= 6 &&
                ps.peek() === 0x5c &&
                unsafe.load<u8>(unsafe.add(ps.text, ps.at + 1)) === 0x75
            ) {
                const save = ps.at
                ps.at += 2
                const low = hex4(ps)
                if (low >= 0xdc00 && low < 0xe000) cp = 0x10000 + ((cp - 0xd800) << 10) + (low - 0xdc00)
                else ps.at = save
            }
            if (cp >= 0xd800 && cp < 0xe000) cp = 0xfffd
            putUtf8(b, cp)
        } else {
            ps.fail("invalid escape in string")
            return false
        }
        run = ps.at
    }
    if (!ps.more()) {
        ps.fail("unterminated string")
        return false
    }
    sbPut(b, unsafe.add(ps.text, run), ps.at - run)
    ps.at++
    unsafe.store<string>(out, sbString(b))
    return true
}

/** A string at the opening quote, as a string value with its source, or null with an error. */
function parseString(ps: Parser): ptr {
    const start = ps.at
    const v = newValue(kindString)
    if (!scanString(ps, unsafe.add(v, 16))) return nil()
    unsafe.store<string>(unsafe.add(v, 56), unsafe.makeString(unsafe.add(ps.text, start), ps.at - start))
    return v
}

/** The byte at `at`, or 0 at the end. */
function byteAt(ps: Parser, at: int): u8 {
    return at < ps.end ? unsafe.load<u8>(unsafe.add(ps.text, at)) : 0
}

/** Where the digits from `at` end. */
function digitsEnd(ps: Parser, at: int): int {
    let i = at
    while (i < ps.end) {
        const c = unsafe.load<u8>(unsafe.add(ps.text, i))
        if (c < 0x30 || c > 0x39) break
        i++
    }
    return i
}

/** Skips a number, or fails with false where it went wrong. */
function scanNumber(ps: Parser): bool {
    let at = ps.at
    if (byteAt(ps, at) === 0x2d) at++
    let c = byteAt(ps, at)
    let ok = c >= 0x30 && c <= 0x39
    if (ok) {
        at = c === 0x30 ? at + 1 : digitsEnd(ps, at)
        if (byteAt(ps, at) === 0x2e) {
            at++
            const end = digitsEnd(ps, at)
            ok = end > at
            at = end
        }
    }
    c = byteAt(ps, at)
    if (ok && (c === 0x65 || c === 0x45)) {
        at++
        c = byteAt(ps, at)
        if (c === 0x2b || c === 0x2d) at++
        const end = digitsEnd(ps, at)
        ok = end > at
        at = end
    }
    ps.at = at
    return ok
}

/** The number in the text from `start` to the current place, read by strtod from a NUL-terminated copy. */
function numberAt(ps: Parser, start: int): f64 {
    const n = ps.at - start
    if (n + 1 > ps.scratchSize) {
        ps.scratchSize = n + 1 < 64 ? 64 : n + 1
        ps.scratch = unsafe.allocBytes(ps.scratchSize)
    }
    unsafe.copy(ps.scratch, unsafe.add(ps.text, start), n)
    unsafe.store<u8>(unsafe.add(ps.scratch, n), 0)
    return strtod(ps.scratch, nil())
}

function parseNumber(ps: Parser): ptr {
    const start = ps.at
    if (!scanNumber(ps)) return ps.fail("invalid number")
    const v = newValue(kindNumber)
    unsafe.store<string>(unsafe.add(v, 16), unsafe.makeString(unsafe.add(ps.text, start), ps.at - start))
    unsafe.store<f64>(unsafe.add(v, 8), numberAt(ps, start))
    return v
}

/** Appends an item, with its key in an object, growing the arrays as needed. */
function append(v: ptr, cap: int, item: ptr, key: string, keyed: bool): int {
    const len = unsafe.load<int>(unsafe.add(v, 32))
    let capacity = cap
    if (len === capacity) {
        capacity = capacity === 0 ? 4 : capacity * 2
        const items = unsafe.alloc(capacity * 8)
        if (len > 0) unsafe.copy(items, unsafe.load<ptr>(unsafe.add(v, 40)), len * 8)
        unsafe.store<ptr>(unsafe.add(v, 40), items)
        if (keyed) {
            const keys = unsafe.alloc(capacity * 16)
            if (len > 0) unsafe.copy(keys, unsafe.load<ptr>(unsafe.add(v, 48)), len * 16)
            unsafe.store<ptr>(unsafe.add(v, 48), keys)
        }
    }
    if (keyed) unsafe.store<string>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 48)), len * 16), key)
    unsafe.store<ptr>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 40)), len * 8), item)
    unsafe.store<int>(unsafe.add(v, 32), len + 1)
    return capacity
}

function parseArray(ps: Parser): ptr {
    ps.at++
    const v = newValue(kindArray)
    let cap = 0
    ps.space()
    if (ps.more() && ps.peek() === 0x5d) {
        ps.at++
        return v
    }
    while (true) {
        const item = parseValue(ps)
        if (isNil(item)) return nil()
        cap = append(v, cap, item, "", false)
        ps.space()
        if (ps.more() && ps.peek() === 0x2c) {
            ps.at++
            continue
        }
        if (ps.more() && ps.peek() === 0x5d) {
            ps.at++
            return v
        }
        return ps.fail("expected ',' or ']'")
    }
}

function parseObject(ps: Parser): ptr {
    ps.at++
    const v = newValue(kindObject)
    let cap = 0
    ps.space()
    if (ps.more() && ps.peek() === 0x7d) {
        ps.at++
        return v
    }
    while (true) {
        ps.space()
        if (!ps.more() || ps.peek() !== 0x22) return ps.fail("expected a string key")
        const key = parseString(ps)
        if (isNil(key)) return nil()
        ps.space()
        if (!ps.more() || ps.peek() !== 0x3a) return ps.fail("expected ':'")
        ps.at++
        const item = parseValue(ps)
        if (isNil(item)) return nil()
        cap = append(v, cap, item, textOf(key), true)
        ps.space()
        if (ps.more() && ps.peek() === 0x2c) {
            ps.at++
            continue
        }
        if (ps.more() && ps.peek() === 0x7d) {
            ps.at++
            return v
        }
        return ps.fail("expected ',' or '}'")
    }
}

function parseValue(ps: Parser): ptr {
    ps.space()
    if (!ps.more()) return ps.fail("unexpected end of input")
    ps.depth++
    if (ps.depth > 512) return ps.fail("nested too deeply")
    const c = ps.peek()
    let result = nil()
    if (c === 0x6e) {
        if (ps.literal("null")) result = newValue(kindNull)
    } else if (c === 0x74 || c === 0x66) {
        if (ps.literal(c === 0x74 ? "true" : "false")) {
            result = newValue(kindBool)
            unsafe.store<u8>(unsafe.add(result, 4), c === 0x74 ? 1 : 0)
        }
    } else if (c === 0x22) {
        result = parseString(ps)
        if (isNil(result)) return nil()
    } else if (c === 0x5b) {
        result = parseArray(ps)
        if (isNil(result)) return nil()
    } else if (c === 0x7b) {
        result = parseObject(ps)
        if (isNil(result)) return nil()
    } else {
        result = parseNumber(ps)
    }
    ps.depth--
    return isNil(result) ? ps.fail("unexpected character") : result
}

/** Parses a JSON text, or returns null and writes an error message. */
//ore:runtime ore_rt_json_parse
function jsonParse(text: string, error: ptr): ptr {
    const ps = new Parser(unsafe.stringData(text), 0, text.length)
    let v = parseValue(ps)
    if (!isNil(v)) {
        ps.space()
        if (ps.more()) v = ps.fail("unexpected text after the value")
    }
    if (!isNil(v)) return v
    unsafe.store<string>(error, `JSON: ${ps.error} at offset ${ps.at}`)
    return nil()
}

/** The value of a key of an object, the last one if repeated, or null. */
//ore:runtime ore_rt_json_field
function jsonField(object: ptr, key: ptr, len: int): ptr {
    const keys = unsafe.load<ptr>(unsafe.add(object, 48))
    const items = unsafe.load<ptr>(unsafe.add(object, 40))
    for (let i = unsafe.load<int>(unsafe.add(object, 32)) - 1; i >= 0; i--) {
        const k = unsafe.load<string>(unsafe.add(keys, i * 16))
        if (k.length === len && unsafe.compare(unsafe.stringData(k), key, len) === 0)
            return unsafe.load<ptr>(unsafe.add(items, i * 8))
    }
    return nil()
}

// ---------------------------------------------------------------------------
// Untyped values: what `JSON.parse<unknown>` gives and a reviver sees

/** The number of items of an array or an object. */
function lengthOf(v: ptr): int {
    return unsafe.load<int>(unsafe.add(v, 32))
}

function itemAt(v: ptr, i: int): ptr {
    return unsafe.load<ptr>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 40)), i * 8))
}

function keyAt(v: ptr, i: int): string {
    return unsafe.load<string>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 48)), i * 16))
}

/**
 * A value as an `unknown`, as JavaScript makes it: a number as an `f64`, a
 * string, a `bool`, null, an array as an `unknown[]` and an object as a
 * dictionary `{ [key: string]: unknown }`, a repeated key where it first
 * appears with the value it has last.
 */
//ore:runtime ore_rt_json_untyped
function untyped(v: ptr): unknown {
    const kind = kindOf(v)
    if (kind === kindNull) return null
    if (kind === kindBool) return unsafe.load<u8>(unsafe.add(v, 4)) !== 0
    if (kind === kindNumber) return unsafe.load<f64>(unsafe.add(v, 8))
    if (kind === kindString) return textOf(v)
    if (kind === kindArray) {
        const a: unknown[] = []
        for (let i = 0; i < lengthOf(v); i++) a.push(untyped(itemAt(v, i)))
        return a
    }
    const o: { [key: string]: unknown } = {}
    for (let i = 0; i < lengthOf(v); i++) o[keyAt(v, i)] = untyped(itemAt(v, i))
    return o
}

/** The text a value was parsed from, for the context of a reviver: a string's with its quotes. */
function sourceOf(v: ptr): string {
    const kind = kindOf(v)
    if (kind === kindNull) return "null"
    if (kind === kindBool) return unsafe.load<u8>(unsafe.add(v, 4)) !== 0 ? "true" : "false"
    if (kind === kindString) return unsafe.load<string>(unsafe.add(v, 56))
    return textOf(v)
}

/** A reviver function of `JSON.parse`. */
type Reviver = (key: string, value: unknown, context: { source: string } | null) => unknown

/**
 * What the reviver gives for the value at `key`, as JavaScript's
 * InternalizeJSONProperty: the parts of an array or an object are revived
 * first, depth-first, each replaced by what the reviver gives for it, an
 * element's key its index as a string. A part left out (`JSON.omit`) is
 * deleted from an object, and is null in an array, which has no holes. The
 * context has the source text of a value that is neither an array nor an
 * object, and is null for those.
 */
function revive(reviver: Reviver, key: string, v: ptr): unknown {
    const kind = kindOf(v)
    if (kind === kindArray) {
        const a: unknown[] = []
        for (let i = 0; i < lengthOf(v); i++) {
            const x = revive(reviver, `${i}`, itemAt(v, i))
            a.push(x instanceof Omitted ? null : x)
        }
        return reviver(key, a, null)
    }
    if (kind === kindObject) {
        // Each key once, where it first appears, with the value it has last.
        const o: { [key: string]: unknown } = {}
        const keys: string[] = []
        for (let i = 0; i < lengthOf(v); i++) {
            const k = keyAt(v, i)
            if (k in o) continue
            o[k] = null
            keys.push(k)
        }
        for (const k of keys) {
            const x = revive(reviver, k, jsonField(v, unsafe.stringData(k), k.length))
            if (x instanceof Omitted) delete o[k]
            else o[k] = x
        }
        return reviver(key, o, null)
    }
    return reviver(key, untyped(v), { source: sourceOf(v) })
}

/** A parsed value passed through a reviver, first the parts, last the whole with the key ""; the whole left out is null. */
//ore:runtime ore_rt_json_revive
function jsonRevive(v: ptr, reviver: Reviver): unknown {
    const x = revive(reviver, "", v)
    return x instanceof Omitted ? null : x
}

// The values that the decoder of `JSON.parse` with a reviver reads what the
// reviver gave from (`jsonTree` in compiler/src/llvm/json.ore).

//ore:runtime ore_rt_json_null
function jsonNull(): ptr {
    return newValue(kindNull)
}

//ore:runtime ore_rt_json_bool
function jsonBool(b: bool): ptr {
    const v = newValue(kindBool)
    unsafe.store<u8>(unsafe.add(v, 4), b ? 1 : 0)
    return v
}

/** A number, with its text as JavaScript writes it, which the decoders of integers read. */
//ore:runtime ore_rt_json_number
function jsonNumber(x: f64): ptr {
    const v = newValue(kindNumber)
    unsafe.store<f64>(unsafe.add(v, 8), x)
    unsafe.store<string>(unsafe.add(v, 16), `${x}`)
    return v
}

//ore:runtime ore_rt_json_string
function jsonString(s: string): ptr {
    const v = newValue(kindString)
    unsafe.store<string>(unsafe.add(v, 16), s)
    return v
}

/** An array, or an object if `keyed`, with room for `n` items, which `jsonPush` adds. */
//ore:runtime ore_rt_json_list
function jsonList(n: int, keyed: bool): ptr {
    const v = newValue(keyed ? kindObject : kindArray)
    const room = n > 0 ? n : 1
    unsafe.store<ptr>(unsafe.add(v, 40), unsafe.alloc(room * 8))
    if (keyed) unsafe.store<ptr>(unsafe.add(v, 48), unsafe.alloc(room * 16))
    return v
}

/** Adds an item, with its key in an object, to a value of `jsonList`. */
//ore:runtime ore_rt_json_push
function jsonPush(v: ptr, key: string, item: ptr): void {
    const len = lengthOf(v)
    if (kindOf(v) === kindObject) unsafe.store<string>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 48)), len * 16), key)
    unsafe.store<ptr>(unsafe.add(unsafe.load<ptr>(unsafe.add(v, 40)), len * 8), item)
    unsafe.store<int>(unsafe.add(v, 32), len + 1)
}

// ---------------------------------------------------------------------------
// Reading JSON straight into types: the readers that the compiler generates
// per type call these on a parser, with no tree of values in between. They
// only report whether they succeeded; on any failure the text is parsed again
// into values and decoded from them, which finds the error to report.

/** A parser of a text, for generated readers. */
//ore:runtime ore_rt_json_reader
function jsonReader(text: string): Parser {
    return new Parser(unsafe.stringData(text), 0, text.length)
}

/** Whether only white space is left. */
//ore:runtime ore_rt_json_read_done
function jsonReadDone(ps: Parser): bool {
    ps.space()
    return !ps.more()
}

/** Skips white space before a scalar; false at the end or nested too deeply. */
function scalar(ps: Parser): bool {
    ps.space()
    return ps.more() && ps.depth < 512
}

/** Reads the `open` bracket of an array or an object, a level deeper. */
//ore:runtime ore_rt_json_read_open
function jsonReadOpen(ps: Parser, open: u8): bool {
    if (!scalar(ps) || ps.peek() !== open) return false
    ps.at++
    ps.depth++
    return true
}

/** Reads the `close` bracket of an empty array or object, if it is next. */
//ore:runtime ore_rt_json_read_empty
function jsonReadEmpty(ps: Parser, close: u8): bool {
    ps.space()
    if (!ps.more() || ps.peek() !== close) return false
    ps.at++
    ps.depth--
    return true
}

/** After an item: 1 for a comma, 0 for the `close` bracket, -1 for anything else. */
//ore:runtime ore_rt_json_read_next
function jsonReadNext(ps: Parser, close: u8): int {
    ps.space()
    if (!ps.more()) return -1
    const c = ps.peek()
    ps.at++
    if (c === 0x2c) return 1
    if (c === close) {
        ps.depth--
        return 0
    }
    return -1
}

/** Reads a key and the colon after it, putting the key in `ps.key`. */
//ore:runtime ore_rt_json_read_key
function jsonReadKey(ps: Parser): bool {
    ps.space()
    if (!ps.more() || ps.peek() !== 0x22) return false
    if (!scanString(ps, ps.key)) return false
    ps.space()
    if (!ps.more() || ps.peek() !== 0x3a) return false
    ps.at++
    return true
}

/** Whether the last key read is the `len` bytes at `name`. */
//ore:runtime ore_rt_json_key_is
function jsonKeyIs(ps: Parser, name: ptr, len: int): bool {
    const key = unsafe.load<string>(ps.key)
    return key.length === len && unsafe.compare(unsafe.stringData(key), name, len) === 0
}

/** Reads any value as a tree, or null. */
//ore:runtime ore_rt_json_read_value
function jsonReadValue(ps: Parser): ptr {
    return parseValue(ps)
}

/** Reads `null`, if it is next. */
//ore:runtime ore_rt_json_read_null
function jsonReadNull(ps: Parser): bool {
    return scalar(ps) && ps.peek() === 0x6e && ps.literal("null")
}

//ore:runtime ore_rt_json_read_bool
function jsonReadBool(ps: Parser, out: ptr): bool {
    if (!scalar(ps)) return false
    if (ps.peek() === 0x74 && ps.literal("true")) {
        unsafe.store<u8>(out, 1)
        return true
    }
    if (ps.peek() === 0x66 && ps.literal("false")) {
        unsafe.store<u8>(out, 0)
        return true
    }
    return false
}

//ore:runtime ore_rt_json_read_string
function jsonReadString(ps: Parser, out: ptr): bool {
    return scalar(ps) && ps.peek() === 0x22 && scanString(ps, out)
}

//ore:runtime ore_rt_json_read_float
function jsonReadFloat(ps: Parser, out: ptr): bool {
    if (!scalar(ps)) return false
    const start = ps.at
    if (!scanNumber(ps)) return false
    unsafe.store<f64>(out, numberAt(ps, start))
    return true
}

/**
 * Reads an integer written without a fraction or an exponent, whose
 * magnitude goes to `out`; returns 1 if it is negative, 0 if not, and -1 for
 * anything else, which the decoders of values handle.
 */
function readInteger(ps: Parser, out: ptr): int {
    if (!scalar(ps)) return -1
    const start = ps.at
    if (!scanNumber(ps)) return -1
    let i = start
    const negative = unsafe.load<u8>(unsafe.add(ps.text, i)) === 0x2d
    if (negative) i++
    let value: u64 = 0
    for (; i < ps.at; i++) {
        const c = unsafe.load<u8>(unsafe.add(ps.text, i))
        if (c < 0x30 || c > 0x39) return -1
        const d = u64(c - 0x30)
        if (value > (18446744073709551615 - d) / 10) return -1
        value = value * 10 + d
    }
    unsafe.store<u64>(out, value)
    return negative ? 1 : 0
}

/** Reads an integer in [min, max]. */
//ore:runtime ore_rt_json_read_int
function jsonReadInt(ps: Parser, min: i64, max: i64, out: ptr): bool {
    const sign = readInteger(ps, out)
    if (sign < 0) return false
    const m = unsafe.load<u64>(out)
    if (sign === 1 ? m > 9223372036854775808 : m > 9223372036854775807) return false
    const n = sign === 1 ? i64(u64(0) - m) : i64(m)
    if (n < min || n > max) return false
    unsafe.store<i64>(out, n)
    return true
}

//ore:runtime ore_rt_json_read_uint
function jsonReadUint(ps: Parser, max: u64, out: ptr): bool {
    const sign = readInteger(ps, out)
    return sign === 0 && unsafe.load<u64>(out) <= max
}

// ---------------------------------------------------------------------------
// Decoding values into types: the first error and where it happened

function setError(c: ptr, message: string): void {
    if (unsafe.load<u8>(c) !== 0) return
    unsafe.store<u8>(c, 1)
    unsafe.store<string>(unsafe.add(c, 8), message)
    unsafe.store<string>(unsafe.add(c, 24), "")
}

/** Fails with "expected <what>, got <the kind of v>". */
//ore:runtime ore_rt_json_expected
function jsonExpected(c: ptr, what: ptr, v: ptr): void {
    setError(c, `expected ${cText(what)}, got ${kindNames[kindOf(v)]}`)
}

/** Fails with "expected <n> elements, got <got>", for a tuple. */
//ore:runtime ore_rt_json_length
function jsonLength(c: ptr, n: int, got: int): void {
    setError(c, `expected ${n} elements, got ${got}`)
}

//ore:runtime ore_rt_json_missing
function jsonMissing(c: ptr, field: ptr): void {
    setError(c, `missing field '${cText(field)}'`)
}

function prefixPath(c: ptr, segment: string): void {
    const path = unsafe.load<string>(unsafe.add(c, 24))
    unsafe.store<string>(unsafe.add(c, 24), segment + path)
}

//ore:runtime ore_rt_json_at_field
function jsonAtField(c: ptr, field: ptr): void {
    prefixPath(c, `.${cText(field)}`)
}

//ore:runtime ore_rt_json_at_index
function jsonAtIndex(c: ptr, index: int): void {
    prefixPath(c, `[${index}]`)
}

/** Whether the text of a number has a fraction or an exponent. */
function isFloatText(text: string): bool {
    for (let i = 0; i < text.length; i++) {
        const ch = text[i]
        if (ch === 0x2e || ch === 0x65 || ch === 0x45) return true
    }
    return false
}

/** The magnitude of an integer's text and whether it fits in a u64; the sign is skipped. */
class Magnitude {
    value: u64 = 0
    fits = true
}

function magnitude(text: string): Magnitude {
    const m = new Magnitude()
    for (let i = text[0] === 0x2d ? 1 : 0; i < text.length; i++) {
        const d = u64(text[i] - 0x30)
        if (m.value > (18446744073709551615 - d) / 10) {
            m.fits = false
            return m
        }
        m.value = m.value * 10 + d
    }
    return m
}

/** Reads an integer in [min, max]. */
//ore:runtime ore_rt_json_int
function jsonInt(c: ptr, v: ptr, min: i64, max: i64, out: ptr): bool {
    if (kindOf(v) !== kindNumber) {
        setError(c, `expected an integer, got ${kindNames[kindOf(v)]}`)
        return false
    }
    const text = textOf(v)
    const num = unsafe.load<f64>(unsafe.add(v, 8))
    let n: i64 = 0
    let ok = true
    // A number a reviver gave may be NaN or infinite, whose text has no digits.
    if (isFloatText(text) || !Number.isFinite(num)) {
        ok = num === Math.trunc(num) && num >= -9223372036854775808.0 && num < 9223372036854775808.0
        if (ok) n = i64(num)
    } else {
        const m = magnitude(text)
        const negative = text[0] === 0x2d
        ok = m.fits && (negative ? m.value <= 9223372036854775808 : m.value <= 9223372036854775807)
        if (ok) n = negative ? i64(u64(0) - m.value) : i64(m.value)
    }
    if (!ok || n < min || n > max) {
        setError(c, `number ${text} is not an integer in [${min}, ${max}]`)
        return false
    }
    unsafe.store<i64>(out, n)
    return true
}

//ore:runtime ore_rt_json_uint
function jsonUint(c: ptr, v: ptr, max: u64, out: ptr): bool {
    if (kindOf(v) !== kindNumber) {
        setError(c, `expected an integer, got ${kindNames[kindOf(v)]}`)
        return false
    }
    const text = textOf(v)
    const num = unsafe.load<f64>(unsafe.add(v, 8))
    let n: u64 = 0
    let ok = text.length === 0 || text[0] !== 0x2d
    if (ok && (isFloatText(text) || !Number.isFinite(num))) {
        ok = num === Math.trunc(num) && num < 18446744073709551616.0
        if (ok) n = u64(num)
    } else if (ok) {
        const m = magnitude(text)
        ok = m.fits
        n = m.value
    }
    if (!ok || n > max) {
        setError(c, `number ${text} is not an integer in [0, ${max}]`)
        return false
    }
    unsafe.store<u64>(out, n)
    return true
}

/** The message of a failed decoding, with its path. */
//ore:runtime ore_rt_json_error
function jsonError(c: ptr): string {
    const message = unsafe.load<string>(unsafe.add(c, 8))
    const path = unsafe.load<string>(unsafe.add(c, 24))
    return path.length > 0 ? `JSON: ${message} at ${path}` : `JSON: ${message}`
}

// ---------------------------------------------------------------------------
// Replacer functions of JSON.stringify

/** The class of `JSON.omit`. */
class Omitted {}

/**
 * What a replacer function of `JSON.stringify` returns to leave a value out,
 * as JavaScript's `undefined`: a property is not written, an element of an
 * array is written as `null`, and the whole value makes the result `null`.
 */
export const omit = new Omitted()

/** Passes the values through a replacer function. */
//ore:runtime ore_rt_json_replacer
function jsonReplacer(o: JsonOptions, replacer: (key: string, value: unknown) => unknown): void {
    o.replacer = replacer
}

/** Whether the values go through a replacer function. */
//ore:runtime ore_rt_json_replacing
function jsonReplacing(o: JsonOptions): bool {
    return o.replacer !== null
}

/** What the replacer function gives for a value at a key; without one (an `unknown` written), the value itself. */
//ore:runtime ore_rt_json_replace
function jsonReplace(o: JsonOptions, key: string, value: unknown): unknown {
    const replacer = o.replacer
    return replacer === null ? value : replacer(key, value)
}

/** Whether a replacer's result is left out: `JSON.omit`, or a function, as in JavaScript. */
//ore:runtime ore_rt_json_omits
function omits(value: unknown): bool {
    return value instanceof Omitted || typeof value === "function"
}
