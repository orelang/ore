// The class of `new Error(message)`, which other classes extend: `class
// NotFound extends Error`. The type `Error` stays the interface of
// builtin.d.ore, which any class with a `message` implements; the value
// `Error` is the class, for its static `Error.isError`. Also the global
// class `AggregateError`.

/** The options of `new Error(message, options)`: the error that caused this one. */
export type ErrorOptions = { cause?: unknown }

/**
 * An error, as JavaScript's: its `name` is "Error" unless a subclass sets
 * it, and `cause` is the one given to the constructor, or null.
 */
export class Error {
    name: string = "Error"
    message: string
    cause: unknown = null

    constructor(message: string = "", options: ErrorOptions | null = null) {
        this.message = message
        if (options !== null) this.cause = options.cause
    }

    /** "Name: message", or the name alone without a message, as in JavaScript. */
    toString(): string {
        if (this.message === "") return this.name
        if (this.name === "") return this.message
        return `${this.name}: ${this.message}`
    }

    /**
     * Whether `value` is an instance of this class or of a subclass, as
     * JavaScript's `Error.isError` tells a genuine error: what `value
     * instanceof Error` tells of an `unknown`.
     */
    static isError(value: unknown): value is Error {
        return value instanceof Error
    }
}

/**
 * Several errors as one, as JavaScript's: what `Promise.any` gives when
 * every promise fails. `errors` are the errors, in order.
 */
export class AggregateError extends Error {
    errors: unknown[]

    constructor(errors: unknown[], message: string = "", options: ErrorOptions | null = null) {
        super(message, options)
        this.name = "AggregateError"
        this.errors = errors
    }
}

/** How console.log prints an error and its subclasses: "Name: message", the first line of Node's. */
//ore:runtime ore_rt_error_inspect
function inspectError(e: Error): string {
    return e.message === "" ? e.name : `${e.name}: ${e.message}`
}
