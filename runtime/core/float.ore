//ore:internal
// Floats as strings, as JavaScript writes numbers: the shortest decimal that
// reads back to the same float, laid out like Number.prototype.toString.
//
// f64 digits come from Ryu (Ulf Adams, "Ryu: Fast Float-to-String
// Conversion", 2018), with the tables of float-tables.ore. f32 digits, rarely
// needed, come from the free-format algorithm of Burger and Dybvig
// ("Printing Floating-Point Numbers Quickly and Accurately", 1996) on exact
// big integers: the value and the halfway points to its neighbors are
// scaled to integers r / s, m- / s and m+ / s, and digits are generated
// until the remainder is within the halfway points.

import { pow5BitCount, pow5InvBitCount, pow5InvSplit, pow5Split } from "ore:runtime/float-tables"

/** A non-negative big integer: 32-bit limbs, least significant first, no leading zero limbs. */
export class Big {
    limbs: u32[] = []

    copy(): Big {
        const b = new Big()
        for (const l of this.limbs) b.limbs.push(l)
        return b
    }

    /** Multiplies by 2^n. */
    shiftLeft(n: int): Big {
        const words = n / 32
        const bits = n % 32
        const out = new Big()
        for (let i = 0; i < words; i++) out.limbs.push(0)
        let carry: u64 = 0
        for (const l of this.limbs) {
            const v = (u64(l) << u64(bits)) | carry
            out.limbs.push(u32(v & 0xffffffff))
            carry = v >> 32
        }
        if (carry !== 0) out.limbs.push(u32(carry))
        if (this.limbs.length === 0) return new Big()
        return out
    }

    /** Multiplies by a small number, in place. */
    times(m: u32): Big {
        let carry: u64 = 0
        for (let i = 0; i < this.limbs.length; i++) {
            const v = u64(this.limbs[i]) * u64(m) + carry
            this.limbs[i] = u32(v & 0xffffffff)
            carry = v >> 32
        }
        if (carry !== 0) this.limbs.push(u32(carry))
        return this
    }

    /** Multiplies by 10^n, in place. */
    timesPow10(n: int): Big {
        let left = n
        while (left >= 9) {
            this.times(1000000000)
            left -= 9
        }
        let rest: u32 = 1
        for (let i = 0; i < left; i++) rest *= 10
        if (rest !== 1) this.times(rest)
        return this
    }

    plus(other: Big): Big {
        const out = new Big()
        const n = this.limbs.length > other.limbs.length ? this.limbs.length : other.limbs.length
        let carry: u64 = 0
        for (let i = 0; i < n; i++) {
            const a = i < this.limbs.length ? u64(this.limbs[i]) : 0
            const b = i < other.limbs.length ? u64(other.limbs[i]) : 0
            const v = a + b + carry
            out.limbs.push(u32(v & 0xffffffff))
            carry = v >> 32
        }
        if (carry !== 0) out.limbs.push(u32(carry))
        return out
    }

    /** Subtracts a smaller or equal number, in place. */
    minus(other: Big): Big {
        let borrow: i64 = 0
        for (let i = 0; i < this.limbs.length; i++) {
            let v = i64(this.limbs[i]) - borrow - (i < other.limbs.length ? i64(other.limbs[i]) : 0)
            borrow = 0
            if (v < 0) {
                v += 0x100000000
                borrow = 1
            }
            this.limbs[i] = u32(v)
        }
        while (this.limbs.length > 0 && this.limbs[this.limbs.length - 1] === 0) this.limbs.pop()
        return this
    }

    /** Divides by 2^n, rounding down. */
    shiftRight(n: int): Big {
        const words = n / 32
        const bits = u64(n % 32)
        const out = new Big()
        for (let i = words; i < this.limbs.length; i++) {
            const low = u64(this.limbs[i]) >> bits
            const high =
                i + 1 < this.limbs.length && bits !== 0 ? (u64(this.limbs[i + 1]) << (32 - bits)) & 0xffffffff : 0
            out.limbs.push(u32(low | high))
        }
        while (out.limbs.length > 0 && out.limbs[out.limbs.length - 1] === 0) out.limbs.pop()
        return out
    }

    /** Divides by a small number in place, and returns the remainder. */
    divide(d: u32): u32 {
        let rest: u64 = 0
        for (let i = this.limbs.length - 1; i >= 0; i--) {
            const v = (rest << 32) | u64(this.limbs[i])
            this.limbs[i] = u32(v / u64(d))
            rest = v % u64(d)
        }
        while (this.limbs.length > 0 && this.limbs[this.limbs.length - 1] === 0) this.limbs.pop()
        return u32(rest)
    }

    /** The decimal digits; this becomes zero. */
    decimal(): string {
        if (this.limbs.length === 0) return "0"
        const chunks: string[] = []
        while (this.limbs.length > 0) {
            const chunk = this.divide(1000000000)
            chunks.push(this.limbs.length > 0 ? `${chunk}`.padStart(9, "0") : `${chunk}`)
        }
        chunks.reverse()
        return chunks.join("")
    }

    /** Negative, zero or positive as this is less than, equal to or greater than other. */
    compare(other: Big): int {
        if (this.limbs.length !== other.limbs.length) return this.limbs.length - other.limbs.length
        for (let i = this.limbs.length - 1; i >= 0; i--) {
            if (this.limbs[i] !== other.limbs[i]) return this.limbs[i] < other.limbs[i] ? -1 : 1
        }
        return 0
    }
}

export function big(value: u64): Big {
    const b = new Big()
    let v = value
    while (v !== 0) {
        b.limbs.push(u32(v & 0xffffffff))
        v >>= 32
    }
    return b
}

/** The number of significant bits of a non-zero value. */
function bitLength(v: u64): int {
    let n = 0
    let x = v
    while (x !== 0) {
        n++
        x >>= 1
    }
    return n
}

/** The shortest digits of f × 2^e and the exponent k with value = 0.digits × 10^k. */
class Digits {
    digits: u8[] = []
    exponent = 0
}

/**
 * The shortest digits of a positive float f × 2^e, where f has `precision`
 * significant bits when normal and `minExponent` is the exponent of the
 * subnormals.
 */
function shortest(f: u64, e: int, precision: int, minExponent: int): Digits {
    // A float with an even mantissa reads back from its halfway points too (round half to even).
    const inclusive = f % 2 === 0
    // At a power of two the gap below is half the gap above.
    const unequalGaps = f === u64(1) << u64(precision - 1) && e > minExponent
    let r: Big
    let s: Big
    let mPlus: Big
    let mMinus: Big
    if (e >= 0) {
        if (!unequalGaps) {
            r = big(f).shiftLeft(e + 1)
            s = big(2)
            mPlus = big(1).shiftLeft(e)
            mMinus = big(1).shiftLeft(e)
        } else {
            r = big(f).shiftLeft(e + 2)
            s = big(4)
            mPlus = big(1).shiftLeft(e + 1)
            mMinus = big(1).shiftLeft(e)
        }
    } else if (!unequalGaps) {
        r = big(f).shiftLeft(1)
        s = big(1).shiftLeft(1 - e)
        mPlus = big(1)
        mMinus = big(1)
    } else {
        r = big(f).shiftLeft(2)
        s = big(1).shiftLeft(2 - e)
        mPlus = big(2)
        mMinus = big(1)
    }

    // Scale by 10^k with k estimated from the bit length, at most one too low.
    let k = i64(Math.ceil(f64(e + bitLength(f) - 1) * 0.30102999566398114 - 1e-10))
    if (k >= 0) s.timesPow10(k)
    else {
        r.timesPow10(-k)
        mPlus.timesPow10(-k)
        mMinus.timesPow10(-k)
    }
    const high = r.plus(mPlus).compare(s)
    if (inclusive ? high >= 0 : high > 0) {
        s.times(10)
        k++
    }

    const out = new Digits()
    out.exponent = k
    while (true) {
        r.times(10)
        mPlus.times(10)
        mMinus.times(10)
        let d: u8 = 0
        while (r.compare(s) >= 0) {
            r.minus(s)
            d++
        }
        const low = r.compare(mMinus)
        const up = r.plus(mPlus).compare(s)
        const nearLow = inclusive ? low <= 0 : low < 0
        const nearHigh = inclusive ? up >= 0 : up > 0
        if (!nearLow && !nearHigh) {
            out.digits.push(d)
            continue
        }
        if (nearLow && nearHigh) {
            // Both digits read back: take the closer one, or the even one on a tie.
            const twice = r.shiftLeft(1).compare(s)
            out.digits.push(twice < 0 || (twice === 0 && d % 2 === 0) ? d : d + 1)
        } else {
            out.digits.push(nearLow ? d : d + 1)
        }
        return out
    }
}

// ---------------------------------------------------------------------------
// Ryu, for f64

/** The high 64 bits of the 128-bit product of a and b. */
function mulHigh(a: u64, b: u64): u64 {
    const aLo = a & 0xffffffff
    const aHi = a >> 32
    const bLo = b & 0xffffffff
    const bHi = b >> 32
    const lo = aLo * bLo
    const mid1 = aHi * bLo + (lo >> 32)
    const mid2 = aLo * bHi + (mid1 & 0xffffffff)
    return aHi * bHi + (mid1 >> 32) + (mid2 >> 32)
}

/** (m × the 128-bit table entry at `index`) >> j, for j >= 64. */
function mulShift(m: u64, table: u64[], index: int, j: int): u64 {
    const low = table[index * 2]
    const high = table[index * 2 + 1]
    const b0High = mulHigh(m, low)
    const b2Low = m * high
    const b2High = mulHigh(m, high)
    const sum = b0High + b2Low
    const carry: u64 = sum < b0High ? 1 : 0
    const top = b2High + carry
    const dist = u64(j - 64)
    return dist === 0 ? sum : (sum >> dist) | (top << (64 - dist))
}

/** floor(log10(2^e)), for 0 <= e <= 1650. */
function log10Pow2(e: int): int {
    return (e * 78913) >> 18
}

/** floor(log10(5^e)), for 0 <= e <= 2620. */
function log10Pow5(e: int): int {
    return (e * 732923) >> 20
}

/** The bit length of 5^e, for 0 <= e <= 3528. */
function pow5Bits(e: int): int {
    return ((e * 1217359) >> 19) + 1
}

function pow5Factor(value: u64): int {
    let v = value
    let count = 0
    while (v % 5 === 0) {
        v /= 5
        count++
    }
    return count
}

function multipleOfPow5(value: u64, p: int): bool {
    return pow5Factor(value) >= p
}

function multipleOfPow2(value: u64, p: int): bool {
    return (value & ((u64(1) << u64(p)) - 1)) === 0
}

/** The shortest digits of a positive, finite f64 from its mantissa and biased exponent bits. */
/** A positive, finite f64 from its mantissa and biased exponent bits, as JavaScript writes it. */
function ryu(negative: bool, mantissa: u64, biased: int): string {
    // An integer below 2^53 is its own shortest decimal.
    if (biased !== 0) {
        const e = biased - 1075
        const m = mantissa | (u64(1) << 52)
        if (e <= 0 && e >= -52 && multipleOfPow2(m, -e)) return decimalString(negative, m >> u64(-e), 0)
    }
    let e2: int
    let m2: u64
    if (biased === 0) {
        e2 = 1 - 1023 - 52 - 2
        m2 = mantissa
    } else {
        e2 = biased - 1023 - 52 - 2
        m2 = mantissa | (u64(1) << 52)
    }
    const even = (m2 & 1) === 0
    const acceptBounds = even
    // The scaled value and its halfway points: mv = 4 m2, mp = 4 m2 + 2, mm = 4 m2 - 1 - mmShift.
    const mv = m2 * 4
    const mmShift: u64 = mantissa !== 0 || biased <= 1 ? 1 : 0

    let vr: u64
    let vp: u64
    let vm: u64
    let e10: int
    let vmIsTrailingZeros = false
    let vrIsTrailingZeros = false
    if (e2 >= 0) {
        const q = log10Pow2(e2) - (e2 > 3 ? 1 : 0)
        e10 = q
        const k = pow5InvBitCount + pow5Bits(q) - 1
        const i = -e2 + q + k
        vr = mulShift(mv, pow5InvSplit, q, i)
        vp = mulShift(mv + 2, pow5InvSplit, q, i)
        vm = mulShift(mv - 1 - mmShift, pow5InvSplit, q, i)
        if (q <= 21) {
            // Only one of mp, mv and mm can be a multiple of 5, if any.
            if (mv % 5 === 0) vrIsTrailingZeros = multipleOfPow5(mv, q)
            else if (acceptBounds) vmIsTrailingZeros = multipleOfPow5(mv - 1 - mmShift, q)
            else if (multipleOfPow5(mv + 2, q)) vp--
        }
    } else {
        const q = log10Pow5(-e2) - (-e2 > 1 ? 1 : 0)
        e10 = q + e2
        const i = -e2 - q
        const k = pow5Bits(i) - pow5BitCount
        const j = q - k
        vr = mulShift(mv, pow5Split, i, j)
        vp = mulShift(mv + 2, pow5Split, i, j)
        vm = mulShift(mv - 1 - mmShift, pow5Split, i, j)
        if (q <= 1) {
            // mv has at least q trailing zero bits, so vr ends in a zero digit.
            vrIsTrailingZeros = true
            if (acceptBounds) vmIsTrailingZeros = mmShift === 1
            else vp--
        } else if (q < 63) {
            vrIsTrailingZeros = multipleOfPow2(mv, q)
        }
    }

    // Remove digits while the bounds stay apart.
    let removed = 0
    let lastRemovedDigit: u64 = 0
    let output: u64
    if (vmIsTrailingZeros || vrIsTrailingZeros) {
        while (vp / 10 > vm / 10) {
            vmIsTrailingZeros = vmIsTrailingZeros && vm % 10 === 0
            vrIsTrailingZeros = vrIsTrailingZeros && lastRemovedDigit === 0
            lastRemovedDigit = vr % 10
            vr /= 10
            vp /= 10
            vm /= 10
            removed++
        }
        if (vmIsTrailingZeros) {
            while (vm % 10 === 0) {
                vrIsTrailingZeros = vrIsTrailingZeros && lastRemovedDigit === 0
                lastRemovedDigit = vr % 10
                vr /= 10
                vp /= 10
                vm /= 10
                removed++
            }
        }
        // Exactly halfway: round to even.
        if (vrIsTrailingZeros && lastRemovedDigit === 5 && vr % 2 === 0) lastRemovedDigit = 4
        const roundUp = (vr === vm && (!acceptBounds || !vmIsTrailingZeros)) || lastRemovedDigit >= 5
        output = vr + u64(roundUp ? 1 : 0)
    } else {
        let roundUp = false
        while (vp / 10 > vm / 10) {
            roundUp = vr % 10 >= 5
            vr /= 10
            vp /= 10
            vm /= 10
            removed++
        }
        output = vr + u64(vr === vm || roundUp ? 1 : 0)
    }
    return decimalString(negative, output, e10 + removed)
}

/** 10^n, for 0 <= n <= 19. */
function pow10(n: int): u64 {
    let p: u64 = 1
    for (let i = 0; i < n; i++) p *= 10
    return p
}

/** Writes the `count` decimal digits of `value` at `at`, with leading zeros; returns the position after them. */
function putDigits(buffer: ptr, at: int, value: u64, count: int): int {
    let v = value
    for (let i = count - 1; i >= 0; i--) {
        unsafe.store<u8>(unsafe.add(buffer, at + i), u8(v % 10) + 0x30)
        v /= 10
    }
    return at + count
}

function putByte(buffer: ptr, at: int, byte: u8): int {
    unsafe.store<u8>(unsafe.add(buffer, at), byte)
    return at + 1
}

/**
 * The number value × 10^exponent (value > 0), laid out as JavaScript's
 * Number.prototype.toString does, written into one buffer.
 */
function decimalString(negative: bool, value: u64, exponent: int): string {
    let digits = value
    let e = exponent
    while (digits % 10 === 0) {
        digits /= 10
        e++
    }
    let k = 0
    for (let v = digits; v !== 0; v /= 10) k++
    // value = 0.d1...dk × 10^n
    const n = e + k
    // At most a sign, 21 digits and zeros, or "0." with 6 zeros and 17 digits, or 17 digits with ".", "e-" and 3 digits.
    const buffer = unsafe.allocBytes(32)
    let at = 0
    if (negative) at = putByte(buffer, at, 0x2d)
    if (k <= n && n <= 21) {
        // An integer: the digits, then zeros.
        at = putDigits(buffer, at, digits, k)
        for (let i = k; i < n; i++) at = putByte(buffer, at, 0x30)
    } else if (0 < n && n <= 21) {
        // A point inside the digits.
        const scale = pow10(k - n)
        at = putDigits(buffer, at, digits / scale, n)
        at = putByte(buffer, at, 0x2e)
        at = putDigits(buffer, at, digits % scale, k - n)
    } else if (-6 < n && n <= 0) {
        // A small number: zeros after the point.
        at = putByte(buffer, at, 0x30)
        at = putByte(buffer, at, 0x2e)
        for (let i = 0; i < -n; i++) at = putByte(buffer, at, 0x30)
        at = putDigits(buffer, at, digits, k)
    } else {
        // Exponent notation: d.ddde±x.
        const scale = pow10(k - 1)
        at = putDigits(buffer, at, digits / scale, 1)
        if (k > 1) {
            at = putByte(buffer, at, 0x2e)
            at = putDigits(buffer, at, digits % scale, k - 1)
        }
        at = putByte(buffer, at, 0x65)
        at = putByte(buffer, at, n - 1 >= 0 ? 0x2b : 0x2d)
        const x = n - 1 >= 0 ? n - 1 : 1 - n
        at = putDigits(buffer, at, u64(x), x >= 100 ? 3 : x >= 10 ? 2 : 1)
    }
    return unsafe.makeString(buffer, at)
}

/** Big-integer digits as value × 10^exponent. */
function digitsValue(d: Digits): u64 {
    let v: u64 = 0
    for (const digit of d.digits) v = v * 10 + u64(digit)
    return v
}

//ore:runtime ore_rt_str_from_f64
export function strFromF64(v: f64): string {
    if (v !== v) return "NaN"
    if (v === 0) return "0"
    const bits = unsafe.bitcast<u64>(v)
    const negative = bits >> 63 !== 0
    const biased = i64((bits >> 52) & 0x7ff)
    const mantissa = bits & 0xfffffffffffff
    if (biased === 0x7ff) return negative ? "-Infinity" : "Infinity"
    return ryu(negative, mantissa, biased)
}

//ore:runtime ore_rt_str_from_f32
export function strFromF32(v: f32): string {
    if (v !== v) return "NaN"
    if (v === 0) return "0"
    const bits = unsafe.bitcast<u32>(v)
    const negative = bits >> 31 !== 0
    const biased = i64((bits >> 23) & 0xff)
    const mantissa = u64(bits & 0x7fffff)
    if (biased === 0xff) return negative ? "-Infinity" : "Infinity"
    const d =
        biased === 0 ? shortest(mantissa, -149, 24, -149) : shortest(mantissa | (u64(1) << 23), biased - 150, 24, -149)
    return decimalString(negative, digitsValue(d), d.exponent - d.digits.length)
}
