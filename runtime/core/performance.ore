// The namespace `performance`, the High Resolution Time and User Timing
// APIs of the Web as JavaScript's hosts have them: a monotonic clock in
// milliseconds as `number`, and marks and measures recorded by name. Its
// exports are members of `performance` (see `namespaceModule` in
// compiler/src/checker/builtins.ore); the classes `PerformanceEntry`,
// `PerformanceMark` and `PerformanceMeasure` are global names.
//
//   performance.mark("start")
//   work()
//   const m = performance.measure("work", "start")
//   console.log(`${m.duration} ms`)
//
// Times are milliseconds as `number`, as in JavaScript, unlike the
// nanoseconds of the namespace `time`.

import { lock, permanentMutex, unlock } from "ore:runtime/os"
import { millisecond, now as clock, unixNanos } from "ore:runtime/time"

/** The monotonic clock when the program started, in nanoseconds: the zero of `now()`. */
const origin = clock()

/** The time `now()` counts from: milliseconds since the Unix epoch when the program started, as `number`. */
export const timeOrigin = f64(unixNanos()) / f64(millisecond)

/** Milliseconds since `timeOrigin` on a monotonic clock, with fractions down to nanoseconds. */
export function now(): number {
    return f64(clock() - origin) / f64(millisecond)
}

/** What `toJSON()` of the performance namespace returns. */
export type PerformanceJSON = { timeOrigin: number }

/** The fields of an entry as `toJSON()` returns them; JSON.stringify writes an entry the same way. */
export type PerformanceEntryJSON = {
    name: string
    entryType: string
    startTime: number
    duration: number
    detail: unknown
}

/** The options of `performance.mark` and `new PerformanceMark`. */
export type PerformanceMarkOptions = {
    /** Any value, kept with the mark; null by default. */
    detail?: unknown
    /** The time of the mark in milliseconds since `timeOrigin`; `now()` by default. */
    startTime?: number
}

/** The options of `performance.measure`: where it starts and ends, as names of marks or times. */
export type PerformanceMeasureOptions = {
    /** Any value, kept with the measure; null by default. */
    detail?: unknown
    start?: string | number
    duration?: number
    end?: string | number
}

/**
 * A mark or a measure: the abstract base of `PerformanceMark` and
 * `PerformanceMeasure`, as in JavaScript, where it cannot be constructed.
 */
export abstract class PerformanceEntry {
    constructor(
        /** The name given to `mark` or `measure`. */
        readonly name: string,
        /** `"mark"` or `"measure"`. */
        readonly entryType: string,
        /** Milliseconds since `timeOrigin`. */
        readonly startTime: number,
        /** Milliseconds; 0 for a mark. */
        readonly duration: number,
    ) {}

    /** The entry as an object: its name, type, times and detail. */
    toJSON(): PerformanceEntryJSON {
        return {
            name: this.name,
            entryType: this.entryType,
            startTime: this.startTime,
            duration: this.duration,
            detail: this.entryDetail(),
        }
    }

    /** The detail of a mark or a measure, for `toJSON`. */
    protected entryDetail(): unknown {
        return null
    }
}

/**
 * A named moment: `performance.mark` records one, and `new PerformanceMark`
 * makes one without recording it, as in JavaScript.
 */
export class PerformanceMark extends PerformanceEntry {
    /** The `detail` of the options, or null. */
    readonly detail: unknown

    constructor(markName: string, markOptions: PerformanceMarkOptions = {}) {
        super(markName, "mark", validTimestamp(markOptions.startTime ?? now()), 0)
        this.detail = markOptions.detail
    }

    protected override entryDetail(): unknown {
        return this.detail
    }
}

/**
 * The time between two moments: `performance.measure` records one. In
 * JavaScript only `measure` makes one; here `new PerformanceMeasure` takes
 * the arguments of `measure` and makes one without recording it.
 */
export class PerformanceMeasure extends PerformanceEntry {
    /** The `detail` of the options, or null. */
    readonly detail: unknown

    constructor(
        measureName: string,
        startOrMeasureOptions: string | PerformanceMeasureOptions | null = null,
        endMark: string | null = null,
    ) {
        const span = measureSpan(startOrMeasureOptions, endMark)
        super(measureName, "measure", span.start, span.end - span.start)
        this.detail = span.detail
    }

    protected override entryDetail(): unknown {
        return this.detail
    }
}

/** Guards the recorded entries, which tasks on several threads may add. */
const entriesLock = permanentMutex()
/** The recorded marks and measures, each in the order they were made. */
const marks: PerformanceMark[] = []
const measures: PerformanceMeasure[] = []

/** A time given as a number, which must not be negative. */
function validTimestamp(time: number): number {
    if (time < 0) process.panic(`TypeError: ${time} is not a valid timestamp`)
    return time
}

/** A time given to `measure`: a number, or the name of a mark, whose last one recorded gives its time. */
function timestampOf(mark: string | number): number {
    if (typeof mark === "number") return validTimestamp(mark)
    let found = -1.0
    let known = false
    lock(entriesLock)
    for (let i = marks.length - 1; i >= 0 && !known; i--) {
        if (marks[i].name === mark) {
            found = marks[i].startTime
            known = true
        }
    }
    unlock(entriesLock)
    if (!known) process.panic(`SyntaxError: The "${mark}" performance mark has not been set`)
    return found
}

/** Where a measure starts and ends, in milliseconds since `timeOrigin`, and its detail. */
type Span = { start: number; end: number; detail: unknown }

/**
 * The start and end of `measure(name, startOrMeasureOptions, endMark)`, as
 * the User Timing API computes them (and as Node checks the options): the
 * options count when they have a `start` or an `end`; the end defaults to
 * now and the start to 0.
 */
function measureSpan(startOrMeasureOptions: string | PerformanceMeasureOptions | null, endMark: string | null): Span {
    let start: string | number | null = null
    let end: string | number | null = null
    let duration: number | null = null
    let detail: unknown = null
    let options = false
    if (startOrMeasureOptions !== null && typeof startOrMeasureOptions !== "string") {
        detail = startOrMeasureOptions.detail
        start = startOrMeasureOptions.start
        end = startOrMeasureOptions.end
        duration = startOrMeasureOptions.duration
        options = start !== null || end !== null
    }
    if (options && endMark !== null) process.panic("TypeError: endMark must not be specified")
    if (options && start !== null && end !== null && duration !== null)
        process.panic("TypeError: Must not have options.start, options.end, and options.duration specified")
    let endTime = 0.0
    if (endMark !== null) endTime = timestampOf(endMark)
    else if (options && end !== null) endTime = timestampOf(end)
    else if (options && start !== null && duration !== null) endTime = timestampOf(start) + validTimestamp(duration)
    else endTime = now()
    let startTime = 0.0
    if (typeof startOrMeasureOptions === "string") startTime = timestampOf(startOrMeasureOptions)
    else if (options && start !== null) startTime = timestampOf(start)
    else if (options && duration !== null && end !== null) startTime = endTime - validTimestamp(duration)
    return { start: startTime, end: endTime, detail }
}

/** Records a mark named `markName`, at `startTime` of the options or now, and returns it. */
export function mark(markName: string, markOptions: PerformanceMarkOptions = {}): PerformanceMark {
    const entry = new PerformanceMark(markName, markOptions)
    lock(entriesLock)
    marks.push(entry)
    unlock(entriesLock)
    return entry
}

/**
 * Records the time between two moments and returns it: from a mark (its
 * name) to now, between two marks, or as the options say, with `start`,
 * `end` and `duration` as names of marks or times. A name of no mark panics
 * with SyntaxError, a negative time and conflicting options with TypeError,
 * as JavaScript throws.
 */
export function measure(
    measureName: string,
    startOrMeasureOptions: string | PerformanceMeasureOptions | null = null,
    endMark: string | null = null,
): PerformanceMeasure {
    const entry = new PerformanceMeasure(measureName, startOrMeasureOptions, endMark)
    lock(entriesLock)
    measures.push(entry)
    unlock(entriesLock)
    return entry
}

/** The recorded entries of `type` ("mark", "measure", or null for both) and `name` (null for any), by `startTime`. */
function select(name: string | null, type: string | null): PerformanceEntry[] {
    const out: PerformanceEntry[] = []
    lock(entriesLock)
    if (type === null || type === "mark") for (const m of marks) if (name === null || m.name === name) out.push(m)
    if (type === null || type === "measure") for (const m of measures) if (name === null || m.name === name) out.push(m)
    unlock(entriesLock)
    // Stable: entries at the same time keep marks before measures, each in the order made.
    return out.sort((a, b) => a.startTime - b.startTime)
}

/** The recorded marks and measures, by `startTime`. */
export function getEntries(): PerformanceEntry[] {
    return select(null, null)
}

/** The recorded entries named `name`, of `type` ("mark" or "measure") when given, by `startTime`. */
export function getEntriesByName(name: string, type: string | null = null): PerformanceEntry[] {
    return select(name, type)
}

/** The recorded entries of `type`, "mark" or "measure" (no others are recorded), by `startTime`. */
export function getEntriesByType(type: string): PerformanceEntry[] {
    return select(null, type)
}

/** Forgets the recorded marks named `markName`, or all of them. */
export function clearMarks(markName: string | null = null): void {
    lock(entriesLock)
    let kept = 0
    for (let i = 0; i < marks.length; i++) {
        if (markName !== null && marks[i].name !== markName) {
            marks[kept] = marks[i]
            kept++
        }
    }
    marks.length = kept
    unlock(entriesLock)
}

/** Forgets the recorded measures named `measureName`, or all of them. */
export function clearMeasures(measureName: string | null = null): void {
    lock(entriesLock)
    let kept = 0
    for (let i = 0; i < measures.length; i++) {
        if (measureName !== null && measures[i].name !== measureName) {
            measures[kept] = measures[i]
            kept++
        }
    }
    measures.length = kept
    unlock(entriesLock)
}

/** The namespace as an object: its `timeOrigin`. */
export function toJSON(): PerformanceJSON {
    return { timeOrigin }
}
