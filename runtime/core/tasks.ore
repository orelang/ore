// The namespace `task`, the part of it written in Ore: its exports are
// members of `task` (see `namespaceModule` in compiler/src/checker/builtins.ore),
// beside `task.spawn` and the others of runtime/std/builtin.d.ore.

import { microtask as queueMicrotask } from "ore:runtime/loop"

/**
 * Queues `job` on the event loop, to run after the current code and the
 * microtasks queued before it, before any timer: as `queueMicrotask` in
 * JavaScript. From a task that does not hold the loop, it is posted to it.
 */
export function microtask(job: () => void): void {
    queueMicrotask(job)
}
