// The utility types of TypeScript, which every module sees as global names.

/** The fields of T, each optional. */
export type Partial<T> = { [K in keyof T]?: T[K] }

/** The fields of T, none optional. */
export type Required<T> = { [K in keyof T]-?: T[K] }

/** The fields of T, each read-only. */
export type Readonly<T> = { readonly [K in keyof T]: T[K] }

/** The fields of T named by K. */
export type Pick<T, K extends keyof T> = { [P in K]: T[P] }

/** The fields of T not named by K. */
export type Omit<T, K extends string> = Pick<T, Exclude<keyof T, K>>

/** An object type with a field of type V for each of the string literal types of K; for any string, use a Map. */
export type Record<K extends string, V> = { [P in K]: V }

/** The members of the union T that are not assignable to U. */
export type Exclude<T, U> = T extends U ? never : T

/** The members of the union T that are assignable to U. */
export type Extract<T, U> = T extends U ? T : never

/** T without null. */
export type NonNullable<T> = T extends null ? never : T

/** The result type of the function type T. */
export type ReturnType<T> = T extends (...args: never) => infer R ? R : never

/** The parameter types of the function type T, as a tuple. */
export type Parameters<T> = T extends (...args: infer P) => never ? P : never

/** The string literal types of S in upper case. */
export type Uppercase<S extends string> = intrinsic

/** The string literal types of S in lower case. */
export type Lowercase<S extends string> = intrinsic

/** The string literal types of S with their first letter in upper case. */
export type Capitalize<S extends string> = intrinsic

/** The string literal types of S with their first letter in lower case. */
export type Uncapitalize<S extends string> = intrinsic
