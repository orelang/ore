// Arrays: a reference to a header {data, len, cap} with the elements in a
// growable buffer. The runtime sees elements as `size` bytes each, since it
// serves arrays of every element type.

import { sliceOffset } from "ore:runtime/string"

const lenOffset = 8
const capOffset = 16
const headerSize = 24

function data(a: ptr): ptr {
    return unsafe.load<ptr>(a)
}

function length(a: ptr): int {
    return unsafe.load<int>(unsafe.add(a, lenOffset))
}

/** A new array of `len` zeroed elements. */
//ore:runtime ore_rt_array_new
function arrayNew(size: int, len: int): ptr {
    const a = unsafe.alloc(headerSize)
    unsafe.store<ptr>(a, unsafe.alloc(size * len))
    unsafe.store<int>(unsafe.add(a, lenOffset), len)
    unsafe.store<int>(unsafe.add(a, capOffset), len)
    return a
}

/** Appends one element and returns its address; the caller writes it. */
//ore:runtime ore_rt_array_push
function arrayPush(a: ptr, size: int): ptr {
    const len = length(a)
    const cap = unsafe.load<int>(unsafe.add(a, capOffset))
    if (len === cap) {
        const grown = cap < 4 ? 4 : cap * 2
        const buffer = unsafe.alloc(size * grown)
        if (len > 0) unsafe.copy(buffer, data(a), size * len)
        unsafe.store<ptr>(a, buffer)
        unsafe.store<int>(unsafe.add(a, capOffset), grown)
    }
    unsafe.store<int>(unsafe.add(a, lenOffset), len + 1)
    return unsafe.add(data(a), size * len)
}

/** Removes the last element and returns its address. */
//ore:runtime ore_rt_array_pop
function arrayPop(a: ptr, size: int): ptr {
    const len = length(a)
    if (len === 0) process.panic("pop from an empty array")
    unsafe.store<int>(unsafe.add(a, lenOffset), len - 1)
    return unsafe.add(data(a), size * (len - 1))
}

/** A copy of the elements in [start, end), with JavaScript `slice` offsets. */
//ore:runtime ore_rt_array_slice
function arraySlice(a: ptr, size: int, start: int, end: int): ptr {
    const len = length(a)
    const from = sliceOffset(start, len)
    const to = sliceOffset(end, len)
    const count = to < from ? 0 : to - from
    const r = arrayNew(size, count)
    if (count > 0) unsafe.copy(data(r), unsafe.add(data(a), size * from), size * count)
    return r
}

//ore:runtime ore_rt_array_reverse
function arrayReverse(a: ptr, size: int): void {
    const d = data(a)
    let i = 0
    let j = length(a) - 1
    while (i < j) {
        swap(unsafe.add(d, i * size), unsafe.add(d, j * size), size)
        i++
        j--
    }
}

/**
 * Swaps two elements. Elements that hold references have a size that is a
 * multiple of 8 and are swapped a word at a time, so that a reference is
 * always whole in memory or in a local, where the collector finds it.
 */
function swap(x: ptr, y: ptr, size: int): void {
    if (size % 8 === 0) {
        for (let k = 0; k < size; k += 8) {
            const t = unsafe.load<int>(unsafe.add(x, k))
            unsafe.store<int>(unsafe.add(x, k), unsafe.load<int>(unsafe.add(y, k)))
            unsafe.store<int>(unsafe.add(y, k), t)
        }
        return
    }
    for (let k = 0; k < size; k++) {
        const t = unsafe.load<u8>(unsafe.add(x, k))
        unsafe.store<u8>(unsafe.add(x, k), unsafe.load<u8>(unsafe.add(y, k)))
        unsafe.store<u8>(unsafe.add(y, k), t)
    }
}

/**
 * Sorts in place, stably as JavaScript requires: a bottom-up merge sort.
 * `compare` is a function `(ctx, a, b) => i32` on the addresses of two
 * elements, generated by the compiler; with `ctx` it has the layout of a
 * closure (function, environment), which is how it is called here.
 */
//ore:runtime ore_rt_array_sort
function arraySort(a: ptr, size: int, compare: ptr, ctx: ptr): void {
    const n = length(a)
    if (n < 2) return
    const cell = unsafe.alloc(16)
    unsafe.store<ptr>(cell, compare)
    unsafe.store<ptr>(unsafe.add(cell, 8), ctx)
    const before = unsafe.load<(x: ptr, y: ptr) => i32>(cell)

    let src = data(a)
    let buf = unsafe.alloc(n * size)
    for (let width = 1; width < n; width *= 2) {
        for (let lo = 0; lo < n; lo += 2 * width) {
            const mid = lo + width < n ? lo + width : n
            const hi = lo + 2 * width < n ? lo + 2 * width : n
            let i = lo
            let j = mid
            let k = lo
            while (i < mid && j < hi) {
                // Taking the left element on ties keeps the sort stable.
                if (before(unsafe.add(src, j * size), unsafe.add(src, i * size)) < 0) {
                    unsafe.copy(unsafe.add(buf, k * size), unsafe.add(src, j * size), size)
                    j++
                } else {
                    unsafe.copy(unsafe.add(buf, k * size), unsafe.add(src, i * size), size)
                    i++
                }
                k++
            }
            if (i < mid) unsafe.copy(unsafe.add(buf, k * size), unsafe.add(src, i * size), (mid - i) * size)
            else if (j < hi) unsafe.copy(unsafe.add(buf, k * size), unsafe.add(src, j * size), (hi - j) * size)
        }
        const t = src
        src = buf
        buf = t
    }
    if (src !== data(a)) unsafe.copy(data(a), src, n * size)
}
