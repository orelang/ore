//ore:internal
// Arrays: a reference to a header {data, len, cap, gcdata} with the elements
// in a growable buffer. The runtime sees elements as `size` bytes each, since
// it serves arrays of every element type; `gcdata` describes the pointers of
// an element for the collector (see `allocTyped` in gc.ore), or is nil to
// have the buffer scanned word by word.

import { allocElements, writeBarrier } from "ore:runtime/gc"

const lenOffset = 8
const capOffset = 16
const gcdataOffset = 24
const headerSize = 32

function data(a: ptr): ptr {
    return unsafe.load<ptr>(a)
}

function length(a: ptr): int {
    return unsafe.load<int>(unsafe.add(a, lenOffset))
}

/** The `gcdata` of the elements of an array. */
function elements(a: ptr): ptr {
    return unsafe.load<ptr>(unsafe.add(a, gcdataOffset))
}

/** A buffer of `bytes` for the elements of an array, scanned as their type says. */
function newBuffer(a: ptr, bytes: int): ptr {
    return allocElements(bytes, elements(a))
}

/** A new array of `len` zeroed elements of `size` bytes, whose pointers `gcdata` describes. */
//ore:runtime ore_rt_array_new
function arrayNew(size: int, len: int, gcdata: ptr): ptr {
    const a = unsafe.alloc(headerSize)
    unsafe.store<ptr>(unsafe.add(a, gcdataOffset), gcdata)
    unsafe.store<ptr>(a, allocElements(size * len, gcdata))
    unsafe.store<int>(unsafe.add(a, lenOffset), len)
    unsafe.store<int>(unsafe.add(a, capOffset), len)
    return a
}

/** Appends one element and returns its address; the caller writes it. */
//ore:runtime ore_rt_array_push
function arrayPush(a: ptr, size: int): ptr {
    const len = length(a)
    const cap = unsafe.load<int>(unsafe.add(a, capOffset))
    if (len === cap) {
        const grown = cap < 4 ? 4 : cap * 2
        const buffer = newBuffer(a, size * grown)
        if (len > 0) unsafe.copy(buffer, data(a), size * len)
        unsafe.store<ptr>(a, buffer)
        unsafe.store<int>(unsafe.add(a, capOffset), grown)
    }
    unsafe.store<int>(unsafe.add(a, lenOffset), len + 1)
    return unsafe.add(data(a), size * len)
}

/** Appends the elements of `b`, which can be `a` itself. */
//ore:runtime ore_rt_array_append
function arrayAppend(a: ptr, b: ptr, size: int): void {
    const n = length(b)
    if (n === 0) return
    const len = length(a)
    const cap = unsafe.load<int>(unsafe.add(a, capOffset))
    if (len + n > cap) {
        let grown = cap < 4 ? 4 : cap * 2
        if (grown < len + n) grown = len + n
        const buffer = newBuffer(a, size * grown)
        if (len > 0) unsafe.copy(buffer, data(a), size * len)
        unsafe.store<ptr>(a, buffer)
        unsafe.store<int>(unsafe.add(a, capOffset), grown)
    }
    unsafe.copy(unsafe.add(data(a), size * len), data(b), size * n)
    unsafe.store<int>(unsafe.add(a, lenOffset), len + n)
}

/** Removes the last element and returns its address. */
//ore:runtime ore_rt_array_pop
function arrayPop(a: ptr, size: int): ptr {
    const len = length(a)
    if (len === 0) process.panic("pop from an empty array")
    unsafe.store<int>(unsafe.add(a, lenOffset), len - 1)
    return unsafe.add(data(a), size * (len - 1))
}

/**
 * Removes the first element and returns its address: the elements are
 * rotated one place down, so that the first ends up just past the new length.
 */
//ore:runtime ore_rt_array_shift
function arrayShift(a: ptr, size: int): ptr {
    const len = length(a)
    if (len === 0) process.panic("shift from an empty array")
    const d = data(a)
    for (let i = 0; i < len - 1; i++) swap(unsafe.add(d, i * size), unsafe.add(d, (i + 1) * size), size)
    unsafe.store<int>(unsafe.add(a, lenOffset), len - 1)
    return unsafe.add(d, size * (len - 1))
}

/** Makes room for `n` more elements, growing the buffer as push does. */
function reserve(a: ptr, size: int, n: int): void {
    const len = length(a)
    const cap = unsafe.load<int>(unsafe.add(a, capOffset))
    if (len + n <= cap) return
    let grown = cap < 4 ? 4 : cap * 2
    if (grown < len + n) grown = len + n
    const buffer = newBuffer(a, size * grown)
    if (len > 0) unsafe.copy(buffer, data(a), size * len)
    unsafe.store<ptr>(a, buffer)
    unsafe.store<int>(unsafe.add(a, capOffset), grown)
}

/**
 * Replaces the `removed` elements at `from` with the elements of `items`,
 * moving the ones after them; `items` is a new array, never `a` itself.
 */
function replace(a: ptr, size: int, from: int, removed: int, items: ptr): void {
    const len = length(a)
    const n = length(items)
    if (n > removed) reserve(a, size, n - removed)
    const tail = len - from - removed
    const d = data(a)
    if (tail > 0 && n !== removed)
        unsafe.copy(unsafe.add(d, size * (from + n)), unsafe.add(d, size * (from + removed)), size * tail)
    if (n > 0) unsafe.copy(unsafe.add(d, size * from), data(items), size * n)
    unsafe.store<int>(unsafe.add(a, lenOffset), len - removed + n)
}

/** Inserts the elements of `items` at the start and returns the new length. */
//ore:runtime ore_rt_array_unshift
function arrayUnshift(a: ptr, size: int, items: ptr): int {
    replace(a, size, 0, 0, items)
    return length(a)
}

/**
 * Replaces `count` elements from `start` with the elements of `items` and
 * returns the removed ones as a new array, with JavaScript `splice` offsets:
 * a negative start counts from the end, and both are clamped to the array.
 */
//ore:runtime ore_rt_array_splice
function arraySplice(a: ptr, size: int, start: int, count: int, items: ptr): ptr {
    const len = length(a)
    const from = sliceOffset(start, len)
    const removed = count < 0 ? 0 : count > len - from ? len - from : count
    const r = arrayNew(size, removed, elements(a))
    if (removed > 0) unsafe.copy(data(r), unsafe.add(data(a), size * from), size * removed)
    replace(a, size, from, removed, items)
    return r
}

/**
 * `a.length = n`: truncates to `n` elements, as JavaScript does. A negative
 * length panics as JavaScript throws; so does a longer one, as an array has
 * no holes to grow by.
 */
//ore:runtime ore_rt_array_set_length
function arraySetLength(a: ptr, size: int, n: int): void {
    const len = length(a)
    if (n < 0) process.panic("Invalid array length")
    if (n > len)
        process.panic(
            `Cannot grow an array from ${len} to ${n} elements by its length: arrays have no holes; use push()`,
        )
    if (n < len) replace(a, size, n, len - n, arrayNew(size, 0, elements(a)))
}

/** A copy of the elements in [start, end), with JavaScript `slice` offsets. */
//ore:runtime ore_rt_array_slice
function arraySlice(a: ptr, size: int, start: int, end: int): ptr {
    const len = length(a)
    const from = sliceOffset(start, len)
    const to = sliceOffset(end, len)
    const count = to < from ? 0 : to - from
    const r = arrayNew(size, count, elements(a))
    if (count > 0) unsafe.copy(data(r), unsafe.add(data(a), size * from), size * count)
    return r
}

//ore:runtime ore_rt_array_reverse
function arrayReverse(a: ptr, size: int): void {
    const d = data(a)
    let i = 0
    let j = length(a) - 1
    while (i < j) {
        swap(unsafe.add(d, i * size), unsafe.add(d, j * size), size)
        i++
        j--
    }
}

/**
 * Swaps two elements. Elements that hold references have a size that is a
 * multiple of 8 and are swapped a word at a time, so that a reference is
 * always whole in memory or in a local, where the collector finds it.
 */
function swap(x: ptr, y: ptr, size: int): void {
    if (size % 8 === 0) {
        for (let k = 0; k < size; k += 8) {
            const t = unsafe.load<int>(unsafe.add(x, k))
            unsafe.store<int>(unsafe.add(x, k), unsafe.load<int>(unsafe.add(y, k)))
            unsafe.store<int>(unsafe.add(y, k), t)
        }
        return
    }
    for (let k = 0; k < size; k++) {
        const t = unsafe.load<u8>(unsafe.add(x, k))
        unsafe.store<u8>(unsafe.add(x, k), unsafe.load<u8>(unsafe.add(y, k)))
        unsafe.store<u8>(unsafe.add(y, k), t)
    }
}

/** The length of the runs that the sort orders by insertion before it merges them. */
const RUN = 16

/**
 * Keeps an object alive up to here: a use of its address the optimizer
 * cannot remove, for buffers that loops reach only through addresses
 * derived from theirs, which may point past them.
 */
//ore:inline
function keepAlive(p: ptr): void {
    unsafe.asm("", "r", p)
}

/** The address of element `i` of a buffer of elements of `size` bytes. */
//ore:inline
function at(base: ptr, i: int, size: int): ptr {
    return unsafe.add(base, i * size)
}

/**
 * Whether the elements of an array may hold references, as `allocElements`
 * decides it: then a store of one needs the write barrier.
 */
function hasPointers(a: ptr): bool {
    const gcdata = elements(a)
    if (unsafe.toInt(gcdata) === 0) return true
    const words = unsafe.load<int>(gcdata) >> 3
    for (let w = 0; w < words; w += 64) if (unsafe.load<int>(unsafe.add(gcdata, 8 + (w >> 6) * 8)) !== 0) return true
    return false
}

/**
 * Copies one element, after the write barrier when it may hold references.
 * One or two words are moved whole, so that a reference is always whole in
 * memory or in a local.
 */
//ore:inline
function move(to: ptr, from: ptr, size: int, pointers: bool): void {
    if (size === 8) {
        const v = unsafe.load<int>(from)
        if (pointers) writeBarrier(to, 1)
        unsafe.store<int>(to, v)
    } else if (size === 16) {
        const low = unsafe.load<int>(from)
        const high = unsafe.load<int>(unsafe.add(from, 8))
        if (pointers) writeBarrier(to, 2)
        unsafe.store<int>(to, low)
        unsafe.store<int>(unsafe.add(to, 8), high)
    } else unsafe.copy(to, from, size)
}

/** Sorts elements [lo, hi) by insertion, stably; `hold` has room for one element. */
//ore:inline
function insertionSort(
    base: ptr,
    lo: int,
    hi: int,
    size: int,
    hold: ptr,
    pointers: bool,
    before: (x: ptr, y: ptr) => i32,
): void {
    for (let i = lo + 1; i < hi; i++) {
        if (before(at(base, i, size), at(base, i - 1, size)) >= 0) continue
        move(hold, at(base, i, size), size, pointers)
        let j = i
        while (true) {
            move(at(base, j, size), at(base, j - 1, size), size, pointers)
            j--
            if (j === lo || before(hold, at(base, j - 1, size)) >= 0) break
        }
        move(at(base, j, size), hold, size, pointers)
    }
}

/**
 * Merges the ordered runs [lo, mid) and [mid, hi), stably: the shorter one
 * is copied to `tmp` and merged back from its end of the range, taking the
 * left element on ties.
 */
//ore:inline
function merge(
    base: ptr,
    lo: int,
    mid: int,
    hi: int,
    size: int,
    tmp: ptr,
    pointers: bool,
    before: (x: ptr, y: ptr) => i32,
): void {
    // Already in order: the last of the left run is not after the first of the right one.
    if (before(at(base, mid, size), at(base, mid - 1, size)) >= 0) return
    if (mid - lo <= hi - mid) {
        const n = mid - lo
        unsafe.copy(tmp, at(base, lo, size), n * size)
        let i = 0
        let j = mid
        let k = lo
        while (i < n && j < hi) {
            if (before(at(base, j, size), at(tmp, i, size)) < 0) {
                move(at(base, k, size), at(base, j, size), size, pointers)
                j++
            } else {
                move(at(base, k, size), at(tmp, i, size), size, pointers)
                i++
            }
            k++
        }
        // What is left of the right run is in place already.
        if (i < n) unsafe.copy(at(base, k, size), at(tmp, i, size), (n - i) * size)
        return
    }
    const n = hi - mid
    unsafe.copy(tmp, at(base, mid, size), n * size)
    let i = mid - 1
    let j = n - 1
    let k = hi - 1
    while (i >= lo && j >= 0) {
        if (before(at(tmp, j, size), at(base, i, size)) < 0) {
            move(at(base, k, size), at(base, i, size), size, pointers)
            i--
        } else {
            move(at(base, k, size), at(tmp, j, size), size, pointers)
            j--
        }
        k--
    }
    if (j >= 0) unsafe.copy(at(base, lo, size), tmp, (j + 1) * size)
}

/**
 * Sorts in place, stably as JavaScript requires: runs of `RUN` elements by
 * insertion, then merged bottom-up, with a buffer for half the elements.
 * `before` compares the elements at two addresses, -1, 0 or 1: a closure
 * the compiler makes of a generated function and the comparator. The sort
 * is inlined where it is called, so that the size of the elements and the
 * function of the closure are constants there, and the comparison is
 * inlined in turn.
 */
//ore:runtime ore_rt_array_sort
//ore:inline
function arraySort(a: ptr, size: int, before: (x: ptr, y: ptr) => i32): void {
    const n = length(a)
    if (n < 2) return
    // The buffer of the array when the sort began, even if the comparison grows the array.
    const base = data(a)
    const pointers = size % 8 === 0 && hasPointers(a)
    const hold = newBuffer(a, size)
    for (let lo = 0; lo < n; lo += RUN)
        insertionSort(base, lo, lo + RUN < n ? lo + RUN : n, size, hold, pointers, before)
    if (n <= RUN) {
        keepAlive(hold)
        keepAlive(base)
        return
    }
    const tmp = newBuffer(a, (n / 2) * size)
    for (let width = RUN; width < n; width *= 2) {
        for (let lo = 0; lo + width < n; lo += 2 * width) {
            const hi = lo + 2 * width < n ? lo + 2 * width : n
            merge(base, lo, lo + width, hi, size, tmp, pointers, before)
        }
    }
    keepAlive(tmp)
    keepAlive(hold)
    keepAlive(base)
}

/** A JavaScript `slice` offset resolved against a length: negative counts from the end, then clamped. */
export function sliceOffset(offset: int, length: int): int {
    const at = offset < 0 ? offset + length : offset
    return at < 0 ? 0 : at > length ? length : at
}

/** Panics for an index out of bounds; apart, so that the checks that call it stay small. */
//ore:cold
//ore:noinline
export function indexOutOfRange(index: int, length: int): void {
    process.panic(`index out of range [${index}] with length ${length}`)
}

/** The address of element `i`, bounds-checked. */
//ore:runtime ore_rt_array_at
function arrayAt(a: ptr, i: int, size: int): ptr {
    const len = length(a)
    if (u64(i) >= u64(len)) indexOutOfRange(i, len)
    return unsafe.add(data(a), i * size)
}

/** A new array of `len` zeroed elements, as `new Array<T>(len)` makes it; a negative length panics as in JavaScript. */
//ore:runtime ore_rt_array_make
function arrayMake(size: int, len: int, gcdata: ptr): ptr {
    if (len < 0) process.panic("Invalid array length")
    return arrayNew(size, len, gcdata)
}

/** A JavaScript `slice` offset, for the methods that take a range: `fill`, `includes` and `indexOf`. */
//ore:runtime ore_rt_slice_offset
function rangeOffset(offset: int, length: int): int {
    return sliceOffset(offset, length)
}

/**
 * Where `lastIndexOf` starts: a negative offset counts from the end, and one
 * past the end is the last element; -1 when there is nothing to search.
 */
//ore:runtime ore_rt_last_offset
function lastOffset(offset: int, length: int): int {
    if (offset < 0) return offset + length
    return offset < length - 1 ? offset : length - 1
}

/** The index of `at(i)`: a negative index counts from the end; -1 when it is out of range. */
//ore:runtime ore_rt_array_relative
function arrayRelative(a: ptr, i: int): int {
    const len = length(a)
    const at = i < 0 ? i + len : i
    return at < 0 || at >= len ? -1 : at
}

/** The index of `with(i, value)`, counted as `at` does; out of range panics, as JavaScript throws a RangeError. */
//ore:runtime ore_rt_array_with_index
function arrayWithIndex(a: ptr, i: int): int {
    const at = arrayRelative(a, i)
    if (at === -1) process.panic(`Invalid index : ${i}`)
    return at
}

/** Panics for `reduce` and `reduceRight` without an initial value on an empty array, as JavaScript throws a TypeError. */
//ore:runtime ore_rt_array_reduce_empty
function arrayReduceEmpty(): void {
    process.panic("Reduce of empty array with no initial value")
}

/** `copyWithin(target, start, end)`: copies the elements in [start, end) to `target`, with JavaScript offsets. */
//ore:runtime ore_rt_array_copy_within
function arrayCopyWithin(a: ptr, size: int, target: int, start: int, end: int): void {
    const len = length(a)
    const to = sliceOffset(target, len)
    const from = sliceOffset(start, len)
    const final = sliceOffset(end, len)
    let count = final - from
    if (count > len - to) count = len - to
    if (count <= 0) return
    const d = data(a)
    unsafe.copy(unsafe.add(d, to * size), unsafe.add(d, from * size), count * size)
}
