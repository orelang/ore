// The namespace `crypto`, the Web Crypto API's global: random values from
// the system's secure random number generator. Its exports are members of
// `crypto` (see `namespaceModule` in compiler/src/checker/builtins.ore).
//
//   crypto.getRandomValues(new Array<u8>(16))   // 16 random bytes
//   crypto.randomUUIDv4()                       // "3b241101-e2bb-4255-8caf-4136c566a962"
//   crypto.randomUUIDv7()                       // "019a1c52-7d3e-7a41-9f0c-5b2e8d6a1c07"
//
// JavaScript's `randomUUID` is `randomUUIDv4` here, beside `randomUUIDv7`;
// "ore:crypto" exports both too.

import { millisecond, unixNanos } from "ore:runtime/time"

declare function getentropy(buffer: ptr, size: u64): i32

/** The most bytes `getRandomValues` fills in one call, as in JavaScript. */
const quota = 65536

/** Fills `size` bytes at `p` from the system's secure random number generator, 256 at a time (getentropy's limit). */
function randomBytes(p: ptr, size: int): void {
    for (let at = 0; at < size; at += 256) {
        if (getentropy(unsafe.add(p, at), u64(Math.min(256, size - at))) !== 0)
            process.panic("crypto: getentropy failed")
    }
}

/** The element types of the arrays `getRandomValues` fills: JavaScript's integer typed arrays. */
type Integer = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64

/**
 * Fills an array of integers with random values from the system's secure
 * random number generator and returns it, as JavaScript's
 * `crypto.getRandomValues` fills an integer typed array. An array of more
 * than 65536 bytes panics with QuotaExceededError; an array of floats is a
 * compile-time error.
 */
export function getRandomValues<T extends Integer>(array: T[]): T[] {
    const size = array.length * unsafe.sizeOf<T>()
    if (size > quota) process.panic("QuotaExceededError: The requested length exceeds 65,536 bytes")
    // The elements are in the buffer the array's header points to first.
    if (size > 0) randomBytes(unsafe.load<ptr>(unsafe.addressOf(array)), size)
    return array
}

const hexDigits = "0123456789abcdef"

/** The 16 bytes at `p` as a UUID: 36 lowercase hex characters, in groups of 8-4-4-4-12. */
function uuidText(p: ptr): string {
    const out = unsafe.allocBytes(36)
    let at = 0
    for (let i = 0; i < 16; i++) {
        if (i === 4 || i === 6 || i === 8 || i === 10) {
            unsafe.store<u8>(unsafe.add(out, at), 0x2d)
            at++
        }
        const byte = unsafe.load<u8>(unsafe.add(p, i))
        unsafe.store<u8>(unsafe.add(out, at), hexDigits[i64(byte >> 4)])
        unsafe.store<u8>(unsafe.add(out, at + 1), hexDigits[i64(byte & 15)])
        at += 2
    }
    return unsafe.makeString(out, 36)
}

/** Sets the version (the high 4 bits of byte 6) and the variant 0b10 (the high 2 bits of byte 8). */
function stamp(p: ptr, version: int): void {
    unsafe.store<u8>(unsafe.add(p, 6), (unsafe.load<u8>(unsafe.add(p, 6)) & 0x0f) | u8(version << 4))
    unsafe.store<u8>(unsafe.add(p, 8), (unsafe.load<u8>(unsafe.add(p, 8)) & 0x3f) | 0x80)
}

/**
 * A random UUID of version 4 (RFC 9562): 122 bits from the system's secure
 * random number generator, as "xxxxxxxx-xxxx-4xxx-Vxxx-xxxxxxxxxxxx" in
 * lowercase hex, where V is 8, 9, a or b. JavaScript's `crypto.randomUUID`.
 */
export function randomUUIDv4(): string {
    const bytes = unsafe.allocBytes(16)
    randomBytes(bytes, 16)
    stamp(bytes, 4)
    return uuidText(bytes)
}

/**
 * The last timestamp of `randomUUIDv7`: the milliseconds shifted left by 12
 * bits plus the 12 bits of `rand_a`, updated atomically. Held as a string
 * because the collector does not trace a `ptr`.
 */
const lastV7 = unsafe.makeString(unsafe.allocBytes(8), 8)

/**
 * A UUID of version 7 (RFC 9562): the 48-bit Unix time in milliseconds,
 * then 12 bits of the time within the millisecond (method 3 of section
 * 6.2), then 62 random bits, so UUIDs sort by creation time, as text too.
 * Within the process they increase strictly: one made in the same tick as
 * the one before takes the next value of the 60-bit timestamp.
 */
export function randomUUIDv7(): string {
    const nanos = unixNanos()
    const tick = (nanos / millisecond) * 4096 + ((nanos % millisecond) * 4096) / millisecond
    let next = tick
    for (;;) {
        const previous = unsafe.atomicLoad<i64>(unsafe.stringData(lastV7))
        next = tick > previous ? tick : previous + 1
        if (unsafe.atomicCompareExchange<i64>(unsafe.stringData(lastV7), previous, next)) break
    }
    const bytes = unsafe.allocBytes(16)
    randomBytes(unsafe.add(bytes, 8), 8)
    const ms = next >> 12
    for (let i = 0; i < 6; i++) unsafe.store<u8>(unsafe.add(bytes, i), u8((ms >> (40 - 8 * i)) & 0xff))
    unsafe.store<u8>(unsafe.add(bytes, 6), u8((next >> 8) & 0x0f))
    unsafe.store<u8>(unsafe.add(bytes, 7), u8(next & 0xff))
    stamp(bytes, 7)
    return uuidText(bytes)
}
