//ore:internal
// The iteration protocol of JavaScript, generators, and the iterators of
// arrays, maps, sets and strings.
//
// `for...of`, spread, `Array.from`, `new Map`, `new Set` and `yield*` take
// any value with a `[Symbol.iterator]()` method, whose iterator's `next()`
// returns an `IteratorResult` (declared in types.ore) until one is done.
// The classes and interfaces `Generator`, `Iterator`, `Iterable`,
// `IterableIterator` and `IteratorObject` are global names.
//
// Generators, the iterators of arrays, maps, sets and strings, and the
// iterator helpers' results extend `IteratorObject`, which has the iterator helpers
// of ES2025 (`map`, `filter`, `take`... of JavaScript's `Iterator.prototype`):
// lazy, they step their source only when they are stepped, and close it
// (`close()`, a generator's `return()`) when they end before it does.
//
// A generator is a fiber of its own (see "Fibers" in task.ore), started by
// the first `next()`: `next` hands the current task's turn to it, and
// `yield` hands it back with a value, so the body runs on its own stack
// between the calls. A generator that is not run to its end keeps its fiber
// parked until `return()` ends it; `for...of` ends it when it leaves the
// loop early, as JavaScript calls `return()`.

import { mapCount, mapKey, mapLive, mapValue } from "ore:runtime/map"
import { type Task, endFiber, handBack, handTo, newFiber } from "ore:runtime/task"

/** An object that produces values one at a time with `next()`. */
export interface Iterator<T, TReturn = void, TNext = null> {
    next(): IteratorResult<T, TReturn>
}

/** An object that `for...of`, spread and `Array.from` take: its `[Symbol.iterator]()` makes an iterator. */
export interface Iterable<T> {
    [Symbol.iterator](): Iterator<T>
}

/** An iterator that is iterable too, whose `[Symbol.iterator]()` returns itself, as generators and the built-in iterators. */
export interface IterableIterator<T, TReturn = void, TNext = null> {
    next(): IteratorResult<T, TReturn>
    [Symbol.iterator](): IterableIterator<T, TReturn, TNext>
}

/**
 * The type of the values of the iterable type R: what `for...of` and
 * `yield*` give, the `[key, value]` entries of a map.
 */
export type IteratedOf<R> = R extends (infer E)[]
    ? E
    : R extends Set<infer E>
      ? E
      : R extends Map<infer K, infer V>
        ? [K, V]
        : R extends IteratorObject<infer E, infer TReturn, infer TNext>
          ? E
          : R extends IterableIterator<infer E, infer TReturn, infer TNext>
            ? E
            : R extends Iterable<infer E>
              ? E
              : never

/**
 * An iterator with the iterator helpers of ES2025, JavaScript's
 * `Iterator.prototype` (TypeScript's `IteratorObject`): generators, the
 * iterators of arrays, maps and sets and the helpers' results extend it.
 * The helpers that return iterators are lazy: each step of the result
 * steps this iterator as far as it needs. Callbacks receive the value and
 * its index, the count of the values given to the callback before.
 */
export abstract class IteratorObject<T, TReturn = void, TNext = null> {
    abstract next(): IteratorResult<T, TReturn>

    /** The iterator itself. */
    [Symbol.iterator](): IterableIterator<T, TReturn, TNext> {
        return this
    }

    /**
     * Ends the iterator before it is done, as JavaScript's `IteratorClose`
     * calls `return()`: a generator returns, a helper closes its source.
     * The iterators of arrays, maps and sets have nothing to end.
     */
    close(): void {}

    /** The values passed through `mapper`. */
    map<U>(mapper: (value: T, index: int) => U): IteratorHelper<U> {
        let counter = 0
        return new IteratorHelper<U>(
            () => {
                const r = this.next()
                if (r.done) return { value: null, done: true }
                return { value: mapper(r.value, counter++), done: false }
            },
            () => this.close(),
        )
    }

    /** The values for which `predicate` is true. */
    filter(predicate: (value: T, index: int) => bool): IteratorHelper<T> {
        let counter = 0
        return new IteratorHelper<T>(
            () => {
                while (true) {
                    const r = this.next()
                    if (r.done) return { value: null, done: true }
                    if (predicate(r.value, counter++)) return { value: r.value, done: false }
                }
            },
            () => this.close(),
        )
    }

    /** The first `limit` values; the step after them closes this iterator. */
    take(limit: int): IteratorHelper<T> {
        if (limit < 0) process.panic(`RangeError: ${limit} must be positive`)
        let remaining = limit
        return new IteratorHelper<T>(
            () => {
                if (remaining === 0) {
                    this.close()
                    return { value: null, done: true }
                }
                remaining--
                const r = this.next()
                if (r.done) return { value: null, done: true }
                return { value: r.value, done: false }
            },
            () => this.close(),
        )
    }

    /** The values after the first `limit`, which the first step skips. */
    drop(limit: int): IteratorHelper<T> {
        if (limit < 0) process.panic(`RangeError: ${limit} must be positive`)
        let remaining = limit
        return new IteratorHelper<T>(
            () => {
                while (remaining > 0) {
                    remaining--
                    if (this.next().done) return { value: null, done: true }
                }
                const r = this.next()
                if (r.done) return { value: null, done: true }
                return { value: r.value, done: false }
            },
            () => this.close(),
        )
    }

    /**
     * The values of the iterables that `mapper` returns, in turn: arrays,
     * sets, maps (their entries), generators and other iterables, each
     * iterated as `yield*` iterates it, on a generator of its own.
     */
    flatMap<R extends object>(mapper: (value: T, index: int) => R): IteratorHelper<IteratedOf<R>> {
        let counter = 0
        // The generator of the current inner iterable: one element, or none between them.
        let inner: Generator<IteratedOf<R>>[] = []
        return new IteratorHelper<IteratedOf<R>>(
            () => {
                while (true) {
                    if (inner.length > 0) {
                        const r = inner[0].next()
                        if (!r.done) return { value: r.value, done: false }
                        inner = []
                    }
                    const r = this.next()
                    if (r.done) return { value: null, done: true }
                    inner = [flatten<R>(mapper(r.value, counter++))]
                }
            },
            () => {
                if (inner.length > 0) inner[0].close()
                this.close()
            },
        )
    }

    /** The values, in an array. */
    toArray(): T[] {
        const out: T[] = []
        while (true) {
            const r = this.next()
            if (r.done) return out
            out.push(r.value)
        }
    }

    /** Calls `fn` with each value. */
    forEach(fn: (value: T, index: int) => void): void {
        let counter = 0
        while (true) {
            const r = this.next()
            if (r.done) return
            fn(r.value, counter++)
        }
    }

    /** Whether `predicate` is true for a value; the first one closes the iterator. */
    some(predicate: (value: T, index: int) => bool): bool {
        let counter = 0
        while (true) {
            const r = this.next()
            if (r.done) return false
            if (predicate(r.value, counter++)) {
                this.close()
                return true
            }
        }
    }

    /** Whether `predicate` is true for every value; the first for which it is not closes the iterator. */
    every(predicate: (value: T, index: int) => bool): bool {
        let counter = 0
        while (true) {
            const r = this.next()
            if (r.done) return true
            if (!predicate(r.value, counter++)) {
                this.close()
                return false
            }
        }
    }

    /** The first value for which `predicate` is true, which closes the iterator, or null. */
    find(predicate: (value: T, index: int) => bool): T | null {
        let counter = 0
        while (true) {
            const r = this.next()
            if (r.done) return null
            if (predicate(r.value, counter++)) {
                this.close()
                return r.value
            }
        }
    }

    /** The values folded by `reducer`, from `initialValue`. */
    reduce<U>(reducer: (accumulator: U, value: T, index: int) => U, initialValue: U): U {
        let accumulator = initialValue
        let counter = 0
        while (true) {
            const r = this.next()
            if (r.done) return accumulator
            accumulator = reducer(accumulator, r.value, counter++)
        }
    }

    /** `reduce(reducer)` without an initial value, which the compiler calls for it: from the first value. */
    reduceFirst(reducer: (accumulator: T, value: T, index: int) => T): T {
        const first = this.next()
        if (first.done) process.panic("TypeError: Reduce of a done iterator with no initial value")
        let accumulator: T = first.value
        let counter = 1
        while (true) {
            const r = this.next()
            if (r.done) return accumulator
            accumulator = reducer(accumulator, r.value, counter++)
        }
    }
}

/**
 * The iterator that `map`, `filter`, `take`, `drop` and `flatMap` return
 * (JavaScript's `%IteratorHelperPrototype%`): `step` makes each value from
 * the source, and `closing` closes the source when `return()` ends the
 * helper first. Once done, it stays done.
 */
export class IteratorHelper<T> extends IteratorObject<T> {
    private done = false

    constructor(
        private readonly step: () => IteratorResult<T, void>,
        private readonly closing: () => void,
    ) {
        super()
    }

    next(): IteratorResult<T, void> {
        if (this.done) return { value: null, done: true }
        const r = this.step()
        if (r.done) this.done = true
        return r
    }

    /** Ends the helper and closes its source, unless it is done already. */
    return(): IteratorResult<T, void> {
        if (!this.done) {
            this.done = true
            this.closing()
        }
        return { value: null, done: true }
    }

    close(): void {
        this.return()
    }

    /** `[object Iterator Helper]`, as JavaScript names it. */
    toString(): string {
        return "[object Iterator Helper]"
    }
}

/** The values of an iterable on a generator, as `yield*` gives them: what `flatMap` and `Iterator.from` iterate. */
export function* flatten<R extends object>(iterable: R): Generator<IteratedOf<R>> {
    yield* iterable
}

const created = 0
const suspended = 1
const running = 2
const finished = 3

/**
 * The object a generator function returns: `next()` runs the body until
 * its next `yield`, whose value it returns; `next(value)` also makes
 * `value` the result of the `yield` the body waits at.
 */
export class Generator<T, TReturn = void, TNext = null> extends IteratorObject<T, TReturn, TNext> {
    /** The fiber of the body, from the first `next()` until it ends. */
    private fiber: Task | null = null
    private state = created
    /** The value of the last `yield`: one element once the body yielded. */
    private yielded: T[] = []
    /** What the body returned, or what `return(value)` gave: one element once done. */
    private returned: TReturn[] = []
    /** The value given to `next` for the `yield` it resumes: one element, or none. */
    private sent: TNext[] = []
    /** Whether `return()` asked the suspended body to end. */
    private ending = false
    /** Ends the generator that a `yield*` of the body waits on, when this one ends there. */
    private inner: (() => void) | null = null

    constructor(
        private readonly body: (generator: Generator<T, TReturn, TNext>) => TReturn,
        /** The value of a generator ended early without one, by `close()`: null when TReturn has it, else none. */
        private readonly closedValue: TReturn[],
    ) {
        super()
    }

    /** Runs the body until its next `yield` (`done: false`) or its end (`done: true`). */
    next(): IteratorResult<T, TReturn> {
        return this.result(this.resume(null))
    }

    /** `next(value)`: `value` is the result of the `yield` that the body waits at. */
    send(value: TNext): IteratorResult<T, TReturn> {
        return this.result(this.resume(value))
    }

    /**
     * Ends the generator, as if its body returned `value` at the `yield`
     * where it waits, and returns `{ value, done: true }`. A generator that
     * has not started never runs.
     */
    return(value: TReturn): IteratorResult<T, TReturn> {
        this.close()
        this.returned = [value]
        return { value, done: true }
    }

    /**
     * Runs the body until its next `yield` or its end: true when it yielded,
     * its value in `current()`. What `for...of` calls.
     */
    advance(value: TNext | null): bool {
        return this.resume(value)
    }

    /** The value of the last `yield`, after `advance` returned true. */
    current(): T {
        return this.yielded[0]
    }

    /** What the body returned, once done. */
    returnValue(): TReturn {
        return this.returned[0]
    }

    /** Ends the generator without running more of its body, as `return()` does: what `for...of` calls when it leaves early. */
    close(): void {
        if (this.state === running) process.panic("TypeError: Generator is already running")
        if (this.state === suspended) {
            this.ending = true
            this.state = running
            handTo(this.fiber!)
        }
        if (this.returned.length === 0) this.returned = this.closedValue
        this.state = finished
    }

    private result(yielded: bool): IteratorResult<T, TReturn> {
        if (yielded) return { value: this.yielded[0], done: false }
        if (this.returned.length === 0) process.panic("TypeError: Generator ended early without a return value")
        return { value: this.returned[0], done: true }
    }

    private resume(value: TNext | null): bool {
        if (this.state === finished) return false
        if (this.state === running) process.panic("TypeError: Generator is already running")
        if (this.state === created) {
            // The value of the first `next` has no `yield` to go to.
            this.fiber = newFiber(() => {
                this.finish(this.body(this))
                endFiber()
            })
        } else if (value !== null) {
            this.sent = [value]
        }
        this.state = running
        handTo(this.fiber!)
        return this.state === suspended
    }

    /** The body returned `value`. */
    private finish(value: TReturn): void {
        this.returned = [value]
        this.state = finished
        this.fiber = null
    }

    /**
     * `yield value` in the body: hands the value to `next` and waits for the
     * following call, whose value it returns (null when none was given). After
     * `return()`, the body ends here.
     */
    yieldValue(value: T): TNext | null {
        if (this.yielded.length === 0) this.yielded.push(value)
        else this.yielded[0] = value
        this.sent = []
        this.state = suspended
        handBack()
        if (this.ending) {
            const inner = this.inner
            if (inner !== null) inner()
            this.fiber = null
            endFiber()
        }
        return this.sent.length > 0 ? this.sent[0] : null
    }

    /** While a `yield*` of the body waits on another generator: what ends that one. */
    delegating(inner: (() => void) | null): void {
        this.inner = inner
    }
}

/** A generator whose body is `body`, given the generator for its `yield`s: what a generator function returns. */
export function generator<T, TReturn, TNext>(
    body: (generator: Generator<T, TReturn, TNext>) => TReturn,
    closedValue: TReturn[],
): Generator<T, TReturn, TNext> {
    return new Generator<T, TReturn, TNext>(body, closedValue)
}

/** `yield* inner` of a generator in the body of `self`: yields its values, passes on what `next` sends, returns its result. */
export function delegate<T, R, TReturn, TNext>(self: Generator<T, TReturn, TNext>, inner: Generator<T, R, TNext>): R {
    self.delegating(() => inner.close())
    let sent: TNext | null = null
    while (inner.advance(sent)) sent = self.yieldValue(inner.current())
    self.delegating(null)
    return inner.returnValue()
}

/** `yield* iterable` of any other iterable in the body of `self`: yields the values of its iterator. */
export function delegateIterator<T, TReturn, TNext>(self: Generator<T, TReturn, TNext>, iterator: Iterator<T>): void {
    while (true) {
        const r = iterator.next()
        if (r.done) return
        self.yieldValue(r.value)
    }
}

/** The values a generator yields, as an array: `[...generator]`. */
export function generatorToArray<T, TReturn, TNext>(g: Generator<T, TReturn, TNext>): T[] {
    const out: T[] = []
    while (g.advance(null)) out.push(g.current())
    return out
}

/** The values of an iterator, as an array: `[...iterable]`, `Array.from(iterable)`. */
export function iteratorToArray<T>(iterator: Iterator<T>): T[] {
    const out: T[] = []
    while (true) {
        const r = iterator.next()
        if (r.done) return out
        out.push(r.value)
    }
}

// ---------------------------------------------------------------------------
// The iterators of arrays, maps and sets
//
// They are lazy, as JavaScript's: an array iterator reads the length again
// at every step, so it sees elements pushed meanwhile; a map or set iterator
// visits the entries in insertion order as they are when it gets to them,
// including those added meanwhile. Once done, an iterator stays done.

/** The iterator of an array's `values()`, `keys()` and `entries()`: what `read` makes of each index. */
export class ArrayIterator<E, T> extends IteratorObject<T> {
    private index = 0
    private done = false

    constructor(
        private readonly items: E[],
        private readonly read: (items: E[], index: int) => T,
    ) {
        super()
    }

    next(): IteratorResult<T, void> {
        if (this.done || this.index >= this.items.length) {
            this.done = true
            return { value: null, done: true }
        }
        const value = this.read(this.items, this.index)
        this.index++
        return { value, done: false }
    }

    /** `[object Array Iterator]`, as JavaScript names it. */
    toString(): string {
        return "[object Array Iterator]"
    }
}

/** The iterator of a map's `keys()`, `values()` and `entries()`: what `read` makes of each entry. */
export class MapIterator<K, V, T> extends IteratorObject<T> {
    private index = 0
    private done = false

    constructor(
        private readonly source: Map<K, V>,
        private readonly read: (key: K, value: V) => T,
    ) {
        super()
    }

    next(): IteratorResult<T, void> {
        const m = unsafe.addressOf(this.source)
        while (!this.done && this.index < mapCount(m)) {
            const i = this.index
            this.index++
            if (!mapLive(m, i)) continue
            return { value: this.read(unsafe.load<K>(mapKey(m, i)), unsafe.load<V>(mapValue(m, i))), done: false }
        }
        this.done = true
        return { value: null, done: true }
    }

    /** `[object Map Iterator]`, as JavaScript names it. */
    toString(): string {
        return "[object Map Iterator]"
    }
}

/** The iterator of a set's `values()`, `keys()` and `entries()`: what `read` makes of each element. */
export class SetIterator<E, T> extends IteratorObject<T> {
    private index = 0
    private done = false

    constructor(
        private readonly set: Set<E>,
        private readonly read: (value: E) => T,
    ) {
        super()
    }

    next(): IteratorResult<T, void> {
        const m = unsafe.addressOf(this.set)
        while (!this.done && this.index < mapCount(m)) {
            const i = this.index
            this.index++
            if (!mapLive(m, i)) continue
            return { value: this.read(unsafe.load<E>(mapKey(m, i))), done: false }
        }
        this.done = true
        return { value: null, done: true }
    }

    /** `[object Set Iterator]`, as JavaScript names it. */
    toString(): string {
        return "[object Set Iterator]"
    }
}

/**
 * The iterator of a string's `[Symbol.iterator]()`: its characters, each a
 * string of one code point, as JavaScript's (whose `for...of` gives the
 * same; Ore's gives runes). A byte where no valid UTF-8 character starts is
 * a string of that byte, as `[...s]` and `s.split("")` give it.
 */
export class StringIterator extends IteratorObject<string> {
    private index = 0

    constructor(private readonly text: string) {
        super()
    }

    next(): IteratorResult<string, void> {
        if (this.index >= this.text.length) return { value: null, done: true }
        const value = this.text.charAt(this.index)
        this.index += value.length
        return { value, done: false }
    }

    /** `[object String Iterator]`, as JavaScript names it. */
    toString(): string {
        return "[object String Iterator]"
    }
}

/**
 * What `Iterator.from` makes of an iterator without the helpers (an object
 * with `next()`, or what a `[Symbol.iterator]()` returns), JavaScript's
 * `%WrapForValidIteratorPrototype%`: `next()` is the iterator's, and
 * `close()` calls `returning`, the iterator's `return()` when it has one.
 */
export class WrappedIterator<T> extends IteratorObject<T> {
    constructor(
        private readonly iterator: Iterator<T>,
        private readonly returning: () => void,
    ) {
        super()
    }

    next(): IteratorResult<T, void> {
        return this.iterator.next()
    }

    /** Calls the iterator's `return()`, if it has one, and is done. */
    return(): IteratorResult<T, void> {
        this.returning()
        return { value: null, done: true }
    }

    close(): void {
        this.returning()
    }

    /** `[object Iterator]`, as JavaScript names it. */
    toString(): string {
        return "[object Iterator]"
    }
}

/** `Iterator.from(iterator)` of an iterator without the helpers or a `return()`. */
export function wrapIterator<T>(iterator: Iterator<T>): WrappedIterator<T> {
    return new WrappedIterator<T>(iterator, () => {})
}

/** `Iterator.from(iterator)` of an iterator without the helpers whose `return()` is `returning`. */
export function wrapReturning<T, R>(iterator: Iterator<T>, returning: () => R): WrappedIterator<T> {
    return new WrappedIterator<T>(iterator, () => {
        returning()
    })
}

/** A string's `[Symbol.iterator]()`. */
export function stringValues(s: string): StringIterator {
    return new StringIterator(s)
}

/** `array.values()`, also an array's `[Symbol.iterator]()`. */
export function arrayValues<T>(items: T[]): ArrayIterator<T, T> {
    return new ArrayIterator<T, T>(items, (a, i) => a[i])
}

/** `array.keys()`. */
export function arrayKeys<T>(items: T[]): ArrayIterator<T, int> {
    return new ArrayIterator<T, int>(items, (a, i) => i)
}

/** `array.entries()`. */
export function arrayEntries<T>(items: T[]): ArrayIterator<T, [int, T]> {
    return new ArrayIterator<T, [int, T]>(items, (a, i) => [i, a[i]])
}

/** `map.keys()`. */
export function mapKeys<K, V>(map: Map<K, V>): MapIterator<K, V, K> {
    return new MapIterator<K, V, K>(map, (k, v) => k)
}

/** `map.values()`. */
export function mapValues<K, V>(map: Map<K, V>): MapIterator<K, V, V> {
    return new MapIterator<K, V, V>(map, (k, v) => v)
}

/** `map.entries()`, also a map's `[Symbol.iterator]()`. */
export function mapEntries<K, V>(map: Map<K, V>): MapIterator<K, V, [K, V]> {
    return new MapIterator<K, V, [K, V]>(map, (k, v) => [k, v])
}

/** `set.values()` and `set.keys()`, also a set's `[Symbol.iterator]()`. */
export function setValues<T>(set: Set<T>): SetIterator<T, T> {
    return new SetIterator<T, T>(set, (v) => v)
}

/** `set.entries()`: each value twice, as JavaScript's. */
export function setEntries<T>(set: Set<T>): SetIterator<T, [T, T]> {
    return new SetIterator<T, [T, T]>(set, (v) => [v, v])
}
