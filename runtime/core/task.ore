//ore:internal
// Green threads ("tasks") on several OS threads ("workers"), M:N like Go.
//
// Tasks run until they wait (on a channel, a timer or a select) or yield;
// each worker runs the tasks of its own run queue, and steals from the others
// when it has none (see "Run queues"). Every task that has started, including
// the one running the program's top-level code, has its own mapped stack with
// a guard page.
// The program ends when the top-level code ends.
//
// Garbage collection: each worker tells the collector the stack base of the
// task it runs (gc.setStackBase), and a hook scans the used part of every task
// that is not running, walking a list of stack records that spawning and
// ending a task do not lock (see "Stacks"). Switching stacks is not atomic,
// so a worker switches inside the read side of the collector's switch lock
// (gc.enterSwitch), which the collector takes for writing before it stops the
// world. No code allocates while it holds the read side, or a collection
// would wait for it forever.
//
// Waking before sleeping: a task that waits holds a lock (of a channel, or of
// the scheduler) that its wakers need, and releases it only after it has left
// its stack, in the worker's loop (`park` takes what to do then).
//
// Thread-local variables after a switch: a task may resume on another worker,
// and an address of a thread-local variable computed before the switch is the
// old thread's. Code reads them only through the noinline functions below,
// which compute the address again on the current thread.
//
// The scheduler's state starts at zero and is set by ore_rt_run_main before
// any top-level code runs, including the runtime's own: it lives in globals
// that are numbers or pointers, which a declaration without a value does not
// reset.

import { getTop, setTop } from "ore:runtime/frames"
import {
    addRoot,
    allocatedTotal,
    dumpThreads,
    enterSwitch,
    exitSwitch,
    ownStackBase,
    parkedSleep,
    parkedWait,
    registerThread,
    scanRange,
    setStackBase,
    setStackRootsHook,
} from "ore:runtime/gc"
import { exitProgram, flushOutputIfFree } from "ore:runtime/io"
import {
    cpuCount,
    deadlineIn,
    epochMs,
    getenv,
    nanosleep,
    isNil,
    lock,
    mapGuarded,
    sigaction,
    nil,
    nowMs,
    writeNumber,
    writeRaw,
    pageSize,
    permanent,
    permanentCond,
    permanentMutex,
    pthread_cond_signal,
    startThread,
    unlock,
    unmap,
} from "ore:runtime/os"

/**
 * The sizes of the stacks of the main task (and of tests) and of other tasks,
 * without the guard page: ORE_STACK for both, or 8 MiB and 1 MiB. A stack is
 * mapped at once but takes memory only for the pages it touches. Set by
 * ore_rt_run_main.
 */
let mainStackSize: int
let taskStackSize: int

export const runnable = 0
export const blocked = 1
export const done = 2

/** A select in progress: which case fired, or none yet, in a cell claimed atomically by its first waker. */
export class SelectState {
    fired: ptr = unsafe.allocBytes(8)

    constructor() {
        unsafe.store<i64>(this.fired, selectWaiting)
    }
}

export const selectWaiting = -1
export const selectTimeout = -2

export class Task {
    /** The task's stack record (see "Stacks"), from when a worker first runs it; nil before. */
    stack: ptr = nil()
    /** The size of stack it gets. */
    stackSize = 0
    /** The shadow stack of debug frames while the task is parked. */
    top: ptr = nil()
    state = runnable
    /** The next task in the run queue or the timers. */
    next: Task | null = null
    /** When a sleeping task wakes, in milliseconds. */
    wakeAt = 0
    /** The select the task waits in, if any, so that a timer can time it out. */
    select: SelectState | null = null
    /** The waiter the task reuses for channel operations (an address in chan.ore), or null. */
    waiter: ptr = nil()
    /** For a task running a test of `ore test`: its record (an address in program.ore), or null. */
    test: ptr = nil()
    /** Whether the task was spawned by the program: counted in `live` until it ends. */
    spawned = false
    /** For a fiber of the event loop (see "Fibers"): the task that ran it last and waits for it. */
    resumer: Task | null = null
    /** Whether the task is a fiber of the event loop. */
    fiber = false

    constructor(readonly body: () => void) {}

    /** The stack pointer saved while the task is parked. */
    sp(): ptr {
        return unsafe.load<ptr>(this.stack)
    }

    /** The top of the task's stack. */
    hi(): ptr {
        return unsafe.load<ptr>(unsafe.add(this.stack, stackHi))
    }
}

/**
 * The global run queue, the timers and the workers, under `lock`. Each worker
 * also has a run queue of its own (see "Run queues").
 */
class Scheduler {
    lock = permanentMutex()
    cond = permanentCond()
    runHead: Task | null = null
    runTail: Task | null = null
    /** How many tasks the global queue holds: changed under `lock`, read without it. */
    runCount = permanent(8)
    /** Sleeping tasks by wake time. */
    timers: Task | null = null
    /** The wake time of the first timer, or -1 when there is none: changed under `lock`, read without it. */
    timerAt = permanent(8)
    workers = 0
    /** Workers waiting on `cond`: changed under `lock`, read without it. */
    idle = permanent(8)
    /** Workers looking for tasks to steal, read and changed without `lock`. */
    spinning = permanent(8)
    /** The block of every worker (see "Per worker"), and how many there are, for thieves; set by ore_rt_run_main. */
    workerList: ptr = nil()
    workerListCount = permanent(8)
    blockingWorkers = 0
    maxWorkers = 0
    /** Tasks parked until a socket is ready: not a deadlock while there are any. */
    netWaiters = 0
    mainTask: Task | null = null
    /** Whether the network poller was started: 0 not yet, 1 starting, 2 running. */
    pollState = permanent(8)
    /** How many times a worker has started or resumed a task: the watchdog's sign of progress. */
    switches = permanent(8)
    /** How many tasks the program spawned that have not ended: changed atomically. */
    live = permanent(8)
    loopLock = permanentMutex()
}

/** The scheduler, set by ore_rt_run_main. */
let schedulerAddress: ptr

export function scheduler(): Scheduler {
    return unsafe.fromAddress<Scheduler>(schedulerAddress)
}

// ---------------------------------------------------------------------------
// Per worker: a block of memory that the thread-local `worker` points to.
//   0 the scheduler loop's stack pointer while a task runs
//   8 free stack records kept by this worker, linked by their stackFreeNext
//  16 how many
//  24 what to do after the current task has left its stack: a closure cell, or null
//  32 the current task, or null
//  40 a timespec, for clocks and deadlines (16 bytes)
//  56 a mutex to unlock after the current task has left its stack, or null
//  64 the state of Math.random's generator, zero until first used
//  72 the head of the run queue: how many tasks were ever taken from it (by thieves too)
//  80 the tail of the run queue: how many tasks were ever put in it (only by this worker)
//  88 the task to run next, before the queue: the one the running task woke last, or 0
//  96 how many tasks this worker has run
// 104 how many in a row came from the slot at 88
// 112 the state of the generator that picks whom to steal from
// 120 a timespec for short naps (16 bytes)
// 136 the run queue: a ring of `ringSize` task addresses

//ore:threadlocal
let worker: ptr

const workerHead = 72
const workerTail = 80
const workerNext = 88
const workerTicks = 96
const workerInRow = 104
const workerSeed = 112
const workerNap = 120
const workerRing = 136
const ringSize = 256
const workerSize = workerRing + ringSize * 8

//ore:noinline
function workerBlock(): ptr {
    return worker
}

//ore:noinline
function setWorkerBlock(block: ptr): void {
    worker = block
}

/** The running task of this worker. */
//ore:noinline
export function current(): Task {
    return unsafe.fromAddress<Task>(unsafe.load<ptr>(unsafe.add(workerBlock(), 32)))
}

function setCurrent(w: ptr, t: ptr): void {
    unsafe.store<ptr>(unsafe.add(w, 32), t)
}

function now(): int {
    return nowMs(unsafe.add(workerBlock(), 40))
}

/** Milliseconds since the Unix epoch, read through this worker's timespec. */
export function wallClockMs(): int {
    return epochMs(unsafe.add(workerBlock(), 40))
}

/** The 8 bytes of this worker's random number generator. */
export function randomState(): ptr {
    return unsafe.add(workerBlock(), 64)
}

/** A new worker block for this thread, known to thieves; allocates no collected memory. */
function newWorker(): ptr {
    const s = scheduler()
    const w = permanent(workerSize)
    // The block may hold the only reference to the closure a parked task left
    // for its worker (at 24), to the current task (at 32) and to queued tasks.
    addRoot(w, workerSize)
    unsafe.store<u64>(unsafe.add(w, workerSeed), unsafe.toInt(w) | 1)
    unsafe.store<i64>(unsafe.add(w, workerNap + 8), 3000)
    setWorkerBlock(w)
    lock(s.lock)
    const n = unsafe.atomicLoad<i64>(s.workerListCount)
    unsafe.store<ptr>(unsafe.add(s.workerList, n * 8), w)
    unsafe.atomicStore<i64>(s.workerListCount, n + 1)
    unlock(s.lock)
    return w
}

// ---------------------------------------------------------------------------
// Context switching

/**
 * Saves the callee-saved registers on the current stack, stores the stack
 * pointer at `save`, and resumes the stack `load`.
 */
//ore:naked
function switchContext(save: ptr, load: ptr): void {
    if (target.arch === "arm64") {
        unsafe.asm(
            "sub sp, sp, #160\nstp x19, x20, [sp, #0]\nstp x21, x22, [sp, #16]\nstp x23, x24, [sp, #32]\nstp x25, x26, [sp, #48]\nstp x27, x28, [sp, #64]\nstp x29, x30, [sp, #80]\nstp d8, d9, [sp, #96]\nstp d10, d11, [sp, #112]\nstp d12, d13, [sp, #128]\nstp d14, d15, [sp, #144]\nmov x2, sp\nstr x2, [x0]\nmov sp, x1\nldp x19, x20, [sp, #0]\nldp x21, x22, [sp, #16]\nldp x23, x24, [sp, #32]\nldp x25, x26, [sp, #48]\nldp x27, x28, [sp, #64]\nldp x29, x30, [sp, #80]\nldp d8, d9, [sp, #96]\nldp d10, d11, [sp, #112]\nldp d12, d13, [sp, #128]\nldp d14, d15, [sp, #144]\nadd sp, sp, #160\nret",
            "~{memory}",
        )
    } else {
        unsafe.asm(
            "pushq %rbp\npushq %rbx\npushq %r12\npushq %r13\npushq %r14\npushq %r15\nmovq %rsp, (%rdi)\nmovq %rsi, %rsp\npopq %r15\npopq %r14\npopq %r13\npopq %r12\npopq %rbx\npopq %rbp\nretq",
            "~{memory}",
        )
    }
}

/** The first code of a new task: calls the function in a saved register with the task in another. */
//ore:naked
function trampoline(): void {
    if (target.arch === "arm64") unsafe.asm("mov x0, x19\nblr x20\nbrk #0", "~{memory}")
    else unsafe.asm("movq %rbx, %rdi\ncallq *%r12\nud2", "~{memory}")
}

// ---------------------------------------------------------------------------
// Garbage collection

// Stacks
//
// A stack record is permanent memory that describes one mapped stack, linked
// into a list that only grows (a new record is published with one atomic
// compare-and-swap), so that the collector's hook can walk it while the world
// is stopped at any instruction, and spawning or ending a task takes no lock
// of the collector. A task gets a stack when a worker first runs it and gives
// it back when it ends: each worker keeps a few free stacks, a shared cache
// keeps more, and only what overflows both is unmapped; its record then waits
// for reuse with no mapping.
//   0 the stack pointer while the task is parked, or nil when no task uses the stack
//   8 the top of the stack: the GC's stack base
//  16 the mapping, guard page first, or nil
//  24 the size of the stack, without the guard page
//  32 whether a worker runs the task: its stack is then scanned as the worker's
//  40 the next record of all of them
//  48 the next free record
//  56 the task using the stack, for the watchdog, or nil

const stackHi = 8
const stackMap = 16
const stackUsable = 24
const stackRunning = 32
const stackAllNext = 40
const stackFreeNext = 48
const stackTask = 56
const stackRecordSize = 64

/** Free stacks a worker keeps for itself before it gives them to the shared cache. */
const workerStacks = 16
/** Free stacks the shared cache keeps mapped before it unmaps them. */
const sharedStacks = 256

/** A cell holding the first of every stack record, linked by their stackAllNext; set by ore_rt_run_main. */
let allStacks: ptr
/** Under `stackLock`: free records with a task stack mapped, how many, and free records with none. */
let stackLock: ptr
let freeStacks: ptr
let freeStackCount: int
let bareStacks: ptr

function stackField(record: ptr, offset: int): ptr {
    return unsafe.load<ptr>(unsafe.add(record, offset))
}

function setStackField(record: ptr, offset: int, value: ptr): void {
    unsafe.store<ptr>(unsafe.add(record, offset), value)
}

/** The first stack record, or nil. */
function firstStack(): ptr {
    return unsafe.fromInt(unsafe.atomicLoad<u64>(allStacks))
}

/** Pushes the used part of the stack of every task that no worker is running. */
function pushTaskStacks(): void {
    let r = firstStack()
    while (!isNil(r)) {
        const sp = stackField(r, 0)
        if (unsafe.load<i64>(unsafe.add(r, stackRunning)) === 0 && !isNil(sp)) scanRange(sp, stackField(r, stackHi))
        r = stackField(r, stackAllNext)
    }
}

/** A new record, published in the list of all of them. */
function newStackRecord(): ptr {
    const r = permanent(stackRecordSize)
    while (true) {
        const head = unsafe.atomicLoad<u64>(allStacks)
        setStackField(r, stackAllNext, unsafe.fromInt(head))
        if (unsafe.atomicCompareExchange<u64>(allStacks, head, unsafe.toInt(r))) return r
    }
}

/** Maps a stack of `size` usable bytes, with a guard page below it, for a record that has none. */
function mapStack(r: ptr, size: int): void {
    const mapSize = size + pageSize()
    const map = mapGuarded(mapSize)
    if (isNil(map)) process.panic("cannot allocate a task stack")
    setStackField(r, stackMap, map)
    unsafe.store<i64>(unsafe.add(r, stackUsable), size)
    setStackField(r, stackHi, unsafe.add(map, mapSize))
}

/** A free stack record of `size` usable bytes: one this worker keeps, one of the shared cache, or a new one. */
function takeStack(w: ptr, size: int): ptr {
    if (size === taskStackSize) {
        const own = unsafe.load<ptr>(unsafe.add(w, 8))
        if (!isNil(own)) {
            unsafe.store<ptr>(unsafe.add(w, 8), stackField(own, stackFreeNext))
            unsafe.store<i64>(unsafe.add(w, 16), unsafe.load<i64>(unsafe.add(w, 16)) - 1)
            return own
        }
    }
    lock(stackLock)
    if (size === taskStackSize && !isNil(freeStacks)) {
        const r = freeStacks
        freeStacks = stackField(r, stackFreeNext)
        freeStackCount--
        unlock(stackLock)
        return r
    }
    let r = bareStacks
    if (!isNil(r)) bareStacks = stackField(r, stackFreeNext)
    unlock(stackLock)
    if (isNil(r)) r = newStackRecord()
    mapStack(r, size)
    return r
}

/**
 * A size of ORE_STACK in bytes: digits with an optional unit K, M or G (powers
 * of 1024), such as `8M`; rounded up to whole pages, and at least 64 KiB. -1
 * when it is not such a size.
 */
function parseStackSize(text: ptr): int {
    let n = 0
    let i = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(text, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        if (n > 1 << 40) return -1
        i++
    }
    if (i === 0) return -1
    const unit = unsafe.load<u8>(unsafe.add(text, i))
    if (unit !== 0) {
        const lower = unit | 0x20
        if (lower === 0x6b) n = n << 10
        else if (lower === 0x6d) n = n << 20
        else if (lower === 0x67) n = n << 30
        else return -1
        i++
        // An optional "B" or "iB": `8MB`, `8MiB`.
        if ((unsafe.load<u8>(unsafe.add(text, i)) | 0x20) === 0x69) i++
        if ((unsafe.load<u8>(unsafe.add(text, i)) | 0x20) === 0x62) i++
        if (unsafe.load<u8>(unsafe.add(text, i)) !== 0) return -1
    }
    const page = pageSize()
    n = ((n + page - 1) / page) * page
    return n < 64 << 10 ? 64 << 10 : n
}

/** Sets the stack sizes from ORE_STACK, or to the defaults; ends the program when it is not a size. */
function setStackSizes(): void {
    mainStackSize = 8 << 20
    taskStackSize = 1 << 20
    const configured = getenv("ORE_STACK")
    if (isNil(configured)) return
    const size = parseStackSize(configured)
    if (size < 0) {
        writeRaw(2, "ORE_STACK: expected a stack size such as 8M, 512K or 1G\n")
        exitStuck(2)
    }
    mainStackSize = size
    taskStackSize = size
}

// Stack overflow
//
// Every task's stack has a guard page below it. A task that recurses too
// deep touches it, and the kernel sends SIGSEGV (or SIGBUS on macOS), whose
// handler runs on an alternate signal stack of the thread, since the task's
// own stack is full. When the fault address is in the guard page of a stack,
// the handler reports a panic "stack overflow" with the shadow stack of debug
// frames and ends the program; other faults get the default action, which
// kills the process as before. The handler allocates nothing and takes no
// lock: the thread may be anywhere, even in the allocator.

/** The size of a thread's alternate signal stack. */
const signalStackSize = 64 << 10

/** Lines printed of a stack that overflowed: the innermost ones, then the outermost ones. */
const overflowInner = 40
const overflowOuter = 10

/**
 * Memory of the handler, which cannot allocate: a flag set by the first
 * thread that reports an overflow (another one waits for the process to
 * end), a zeroed sigaction (the default action), a second to sleep, and
 * scratch for numbers.
 */
let overflowReported: ptr
let defaultAction: ptr
let oneSecond: ptr
let faultScratch: ptr

declare function sigaltstack(stack: ptr, previous: ptr): i32

/** SIGBUS: the signal of a guard page on macOS; Linux sends SIGSEGV. */
function busSignal(): i32 {
    return target.os === "darwin" ? 10 : 7
}

/** Installs the overflow handler for SIGSEGV and SIGBUS, on the alternate stack, with the fault's siginfo. */
function installOverflowHandler(): void {
    overflowReported = permanent(8)
    defaultAction = permanent(256)
    oneSecond = permanent(16)
    unsafe.store<i64>(oneSecond, 1)
    faultScratch = permanent(32)
    const action = permanent(256)
    unsafe.store<ptr>(action, unsafe.functionAddress(onFault))
    // SA_ONSTACK | SA_SIGINFO: 0x41 on macOS (flags after a 4-byte mask), 0x08000004 on Linux (after 128 bytes).
    if (target.os === "darwin") unsafe.store<i32>(unsafe.add(action, 12), 0x41)
    else unsafe.store<i32>(unsafe.add(action, 136), 0x08000004)
    sigaction(11, action, nil())
    sigaction(busSignal(), action, nil())
}

/** Gives the current thread an alternate signal stack, on which the overflow handler runs. */
function setSignalStack(): void {
    const map = mapGuarded(signalStackSize + pageSize())
    if (isNil(map)) return
    const stack = permanent(32)
    unsafe.store<ptr>(stack, unsafe.add(map, pageSize()))
    // stack_t: the stack, then its size and flags (macOS) or flags and its size (Linux).
    unsafe.store<i64>(unsafe.add(stack, target.os === "darwin" ? 8 : 16), signalStackSize)
    sigaltstack(stack, nil())
}

/** Whether an address is in the guard page of a task's stack. */
function inGuardPage(address: ptr): bool {
    const a = unsafe.toInt(address)
    const page = u64(pageSize())
    let r = firstStack()
    while (!isNil(r)) {
        const map = unsafe.toInt(stackField(r, stackMap))
        if (map !== 0 && a >= map && a < map + page) return true
        r = stackField(r, stackAllNext)
    }
    return false
}

/** The handler of SIGSEGV and SIGBUS: a stack overflow is a panic; any other fault kills the process. */
function onFault(signal: i32, info: ptr, context: ptr): void {
    // siginfo_t: si_addr after the signal's number, errno, code (and on macOS pid, uid, status).
    const address = unsafe.load<ptr>(unsafe.add(info, target.os === "darwin" ? 24 : 16))
    if (!inGuardPage(address)) {
        // The default action, taken when the faulting instruction runs again.
        sigaction(signal, defaultAction, nil())
        return
    }
    if (!unsafe.atomicCompareExchange<u64>(overflowReported, 0, 1)) {
        while (true) nanosleep(oneSecond, nil())
    }
    flushOutputIfFree()
    writeRaw(2, "panic: stack overflow\n\n")
    writeOverflowTrace(address)
    writeRaw(2, "\nThe stack of a task is limited: ORE_STACK sets its size, such as ORE_STACK=64M.\n")
    exitStuck(2)
}

/**
 * Writes the shadow stack of debug frames. Runs of the same frame, as
 * recursion makes, are one line with their count; of a deep stack, only the
 * innermost and the outermost lines.
 */
function writeOverflowTrace(guard: ptr): void {
    const page = u64(pageSize())
    const guardStart = unsafe.toInt(guard) & ~(page - 1)
    // A frame in the guard page was being pushed when the stack overflowed: it is not one yet.
    let first = getTop()
    while (!isNil(first) && unsafe.toInt(first) >= guardStart && unsafe.toInt(first) < guardStart + page)
        first = unsafe.load<ptr>(first)
    if (isNil(first)) {
        writeRaw(2, "  (no stack trace in release builds; rebuild without --release)\n")
        return
    }
    const lines = traceLines(first, -1, 0)
    if (lines <= overflowInner + overflowOuter) {
        traceLines(first, 0, lines)
        return
    }
    traceLines(first, 0, overflowInner)
    writeRaw(2, "  ...\n")
    traceLines(first, lines - overflowOuter, lines)
}

/** Whether two debug frames are the same function at the same line. */
function sameFrame(a: ptr, b: ptr): bool {
    return (
        unsafe.load<ptr>(unsafe.add(a, 8)) === unsafe.load<ptr>(unsafe.add(b, 8)) &&
        unsafe.load<i32>(unsafe.add(a, 24)) === unsafe.load<i32>(unsafe.add(b, 24))
    )
}

/**
 * Counts the lines of a trace from `first`, a run of the same frame being
 * one, and writes those from `from` to before `to` (none when `from` is -1).
 */
function traceLines(first: ptr, from: int, to: int): int {
    let line = 0
    let f = first
    while (!isNil(f)) {
        let run = 1
        let next = unsafe.load<ptr>(f)
        while (!isNil(next) && sameFrame(f, next)) {
            run++
            next = unsafe.load<ptr>(next)
        }
        if (from >= 0 && line >= from && line < to) {
            writeRaw(2, "  ")
            writeCString(unsafe.load<ptr>(unsafe.add(f, 8)))
            writeRaw(2, " at ")
            writeCString(unsafe.load<ptr>(unsafe.add(f, 16)))
            writeRaw(2, ":")
            writeNumber(2, i64(unsafe.load<i32>(unsafe.add(f, 24))), false, faultScratch)
            if (run > 1) {
                writeRaw(2, " (")
                writeNumber(2, run, false, faultScratch)
                writeRaw(2, " times)")
            }
            writeRaw(2, "\n")
        }
        line++
        f = next
    }
    return line
}

/** Takes back the stack record of an ended task. */
function giveStack(w: ptr, r: ptr): void {
    // No longer scanned, before any other worker can take it.
    setStackField(r, 0, nil())
    setStackField(r, stackTask, nil())
    const size = unsafe.load<i64>(unsafe.add(r, stackUsable))
    if (size === taskStackSize) {
        const own = unsafe.load<i64>(unsafe.add(w, 16))
        if (own < workerStacks) {
            setStackField(r, stackFreeNext, unsafe.load<ptr>(unsafe.add(w, 8)))
            unsafe.store<ptr>(unsafe.add(w, 8), r)
            unsafe.store<i64>(unsafe.add(w, 16), own + 1)
            return
        }
        lock(stackLock)
        if (freeStackCount < sharedStacks) {
            setStackField(r, stackFreeNext, freeStacks)
            freeStacks = r
            freeStackCount++
            unlock(stackLock)
            return
        }
        unlock(stackLock)
    }
    unmap(stackField(r, stackMap), size + pageSize())
    setStackField(r, stackMap, nil())
    lock(stackLock)
    setStackField(r, stackFreeNext, bareStacks)
    bareStacks = r
    unlock(stackLock)
}

/**
 * Gives a task that has not run yet its stack, with an initial frame that the
 * context switch "returns" through into the trampoline.
 */
function startStack(w: ptr, t: Task): void {
    const r = takeStack(w, t.stackSize)
    const top = unsafe.fromInt(unsafe.toInt(stackField(r, stackHi)) & ~u64(15))
    const self = unsafe.addressOf(t)
    let frame = nil()
    if (target.arch === "arm64") {
        frame = unsafe.add(top, -160)
        unsafe.fill(frame, 0, 160)
        unsafe.store<ptr>(frame, self)
        unsafe.store<ptr>(unsafe.add(frame, 8), unsafe.functionAddress(taskMain))
        unsafe.store<ptr>(unsafe.add(frame, 88), unsafe.functionAddress(trampoline))
    } else {
        // Six saved registers and the return address into the trampoline; after
        // `ret`, rsp is 16-byte aligned, as the ABI requires before the
        // trampoline's call.
        frame = unsafe.add(top, -72)
        unsafe.fill(frame, 0, 72)
        unsafe.store<ptr>(unsafe.add(frame, 24), unsafe.functionAddress(taskMain))
        unsafe.store<ptr>(unsafe.add(frame, 32), self)
        unsafe.store<ptr>(unsafe.add(frame, 48), unsafe.functionAddress(trampoline))
    }
    setStackField(r, stackTask, self)
    // Scanned from here on, as a parked task's stack.
    setStackField(r, 0, frame)
    t.stack = r
}

// ---------------------------------------------------------------------------
// Tasks

// Run queues
//
// As in Go's runtime, each worker has a queue of its own: a ring that only
// its worker puts tasks in, from the tail, and that its worker and thieves
// take from at the head with a compare-and-swap, so neither takes a lock. The
// task the running one woke last waits in a slot before the queue, so that
// two tasks that wake each other (over a channel, say) run in turn on one
// worker. A full ring moves half of itself to the global queue, under the
// scheduler's lock, which also holds what threads that are no workers make
// runnable (the network poller, the timers). A worker with nothing queued
// takes from the global queue, then steals half of another worker's queue,
// and only then waits on the scheduler's condition; every 61st task it runs
// comes from the global queue when that has any, so that none waits there
// forever.
//
// A worker that is about to wait counts itself idle, then looks at every queue
// once more; one that queued a task wakes an idle worker unless one is already
// looking for tasks (spinning), and a spinning worker that finds one wakes
// another. All of these are sequentially consistent atomics, so a task is never
// queued while every other worker sleeps without one of them seeing it.

/** How many tasks in a row a worker runs from its next slot before it takes one from its queue. */
const nextInRow = 32

function taskAt(address: u64): Task {
    return unsafe.fromAddress<Task>(unsafe.fromInt(address))
}

function ringSlot(w: ptr, i: int): ptr {
    return unsafe.add(w, workerRing + (i & (ringSize - 1)) * 8)
}

/** Appends a chain of `n` tasks linked by `next` to the global queue; the caller holds the scheduler's lock. */
function putGlobalLocked(first: Task, last: Task, n: int): void {
    const s = scheduler()
    last.next = null
    const tail = s.runTail
    if (tail !== null) tail.next = first
    else s.runHead = first
    s.runTail = last
    unsafe.atomicStore<i64>(s.runCount, unsafe.load<i64>(s.runCount) + n)
    // Idle workers count themselves with the lock held, before they wait.
    let idle = unsafe.atomicLoad<i64>(s.idle)
    for (let i = 0; i < n && idle > 0; i++) {
        pthread_cond_signal(s.cond)
        idle--
    }
}

/** Makes a task runnable in the global queue; the caller holds the scheduler's lock. */
export function enqueueLocked(t: Task): void {
    t.state = runnable
    putGlobalLocked(t, t, 1)
}

/**
 * Makes a task runnable: at the tail of this worker's queue, or of the global
 * one on a thread that is no worker.
 */
export function enqueue(t: Task): void {
    ready(t, false)
}

/** Makes a task runnable as the next one this worker runs: for a task that the running one wakes. */
export function enqueueNext(t: Task): void {
    ready(t, true)
}

function ready(t: Task, next: bool): void {
    const w = workerBlock()
    if (isNil(w)) {
        const s = scheduler()
        lock(s.lock)
        enqueueLocked(t)
        unlock(s.lock)
        return
    }
    t.state = runnable
    putLocal(w, unsafe.toInt(unsafe.addressOf(t)), next)
    wakeWorker()
}

/** Puts a task in this worker's next slot or at the tail of its queue, moving half the queue to the global one when it is full. */
function putLocal(w: ptr, task: u64, next: bool): void {
    let address = task
    if (next) {
        address = unsafe.atomicExchange<u64>(unsafe.add(w, workerNext), address)
        // The task it replaces goes to the queue.
        if (address === 0) return
    }
    while (true) {
        const head = unsafe.atomicLoad<i64>(unsafe.add(w, workerHead))
        const tail = unsafe.load<i64>(unsafe.add(w, workerTail))
        if (tail - head < ringSize) {
            unsafe.store<u64>(ringSlot(w, tail), address)
            unsafe.atomicStore<i64>(unsafe.add(w, workerTail), tail + 1)
            return
        }
        if (overflow(w, address, head, tail)) return
        // Thieves took some meanwhile: there is room now.
    }
}

/** Moves the first half of this worker's full queue and one more task to the global queue; false if thieves took some first. */
function overflow(w: ptr, address: u64, head: int, tail: int): bool {
    const n = (tail - head) / 2
    if (!unsafe.atomicCompareExchange<i64>(unsafe.add(w, workerHead), head, head + n)) return false
    // Only this worker writes the slots, so they stay as they are now that it took them.
    const first = taskAt(unsafe.load<u64>(ringSlot(w, head)))
    let last = first
    for (let i = 1; i < n; i++) {
        const t = taskAt(unsafe.load<u64>(ringSlot(w, head + i)))
        last.next = t
        last = t
    }
    const extra = taskAt(address)
    last.next = extra
    for (let i = 0; i < n; i++) unsafe.store<u64>(ringSlot(w, head + i), 0)
    const s = scheduler()
    lock(s.lock)
    putGlobalLocked(first, extra, n + 1)
    unlock(s.lock)
    return true
}

/** The next task of this worker's own queue, or null. */
function takeLocal(w: ptr): Task | null {
    const nextCell = unsafe.add(w, workerNext)
    const inRow = unsafe.load<i64>(unsafe.add(w, workerInRow))
    if (inRow < nextInRow) {
        const next = unsafe.atomicLoad<u64>(nextCell)
        if (next !== 0 && unsafe.atomicCompareExchange<u64>(nextCell, next, 0)) {
            unsafe.store<i64>(unsafe.add(w, workerInRow), inRow + 1)
            return taskAt(next)
        }
    }
    unsafe.store<i64>(unsafe.add(w, workerInRow), 0)
    while (true) {
        const head = unsafe.atomicLoad<i64>(unsafe.add(w, workerHead))
        const tail = unsafe.load<i64>(unsafe.add(w, workerTail))
        if (tail === head) break
        const address = unsafe.load<u64>(ringSlot(w, head))
        if (unsafe.atomicCompareExchange<i64>(unsafe.add(w, workerHead), head, head + 1)) {
            // Forgotten, so that the queue does not keep the task alive; only this worker writes there.
            unsafe.store<u64>(ringSlot(w, head), 0)
            return taskAt(address)
        }
    }
    // The queue is empty: the next slot, even after a run of them.
    const next = unsafe.atomicLoad<u64>(nextCell)
    if (next !== 0 && unsafe.atomicCompareExchange<u64>(nextCell, next, 0)) return taskAt(next)
    return null
}

/**
 * Steals half the queue of worker `victim` into this worker's empty one, and
 * returns one of the tasks to run now; with `takeNext`, its next slot when its
 * queue is empty. Null when there is nothing to steal.
 */
function stealFrom(w: ptr, victim: ptr, takeNext: bool): Task | null {
    const own = unsafe.load<i64>(unsafe.add(w, workerTail))
    while (true) {
        const head = unsafe.atomicLoad<i64>(unsafe.add(victim, workerHead))
        const tail = unsafe.atomicLoad<i64>(unsafe.add(victim, workerTail))
        let n = tail - head
        n = n - n / 2
        if (n <= 0) {
            if (!takeNext) return null
            const nextCell = unsafe.add(victim, workerNext)
            if (unsafe.atomicLoad<u64>(nextCell) === 0) return null
            // Its worker is likely about to run it; give it a moment to.
            parkedSleep(unsafe.add(w, workerNap))
            const next = unsafe.atomicLoad<u64>(nextCell)
            if (next === 0) return null
            if (unsafe.atomicCompareExchange<u64>(nextCell, next, 0)) return taskAt(next)
            continue
        }
        // Read while other thieves took from it: try again.
        if (n > ringSize / 2) continue
        for (let i = 0; i < n; i++)
            unsafe.store<u64>(ringSlot(w, own + i), unsafe.load<u64>(ringSlot(victim, head + i)))
        if (unsafe.atomicCompareExchange<i64>(unsafe.add(victim, workerHead), head, head + n)) {
            // The last one runs now; the others are this worker's to run or to be stolen.
            const last = ringSlot(w, own + n - 1)
            const address = unsafe.load<u64>(last)
            unsafe.store<u64>(last, 0)
            if (n > 1) unsafe.atomicStore<i64>(unsafe.add(w, workerTail), own + n - 1)
            return taskAt(address)
        }
    }
}

/** Steals from the other workers, starting at a random one; their next slots only on the last pass. */
function steal(w: ptr): Task | null {
    const s = scheduler()
    const count = unsafe.atomicLoad<i64>(s.workerListCount)
    if (count < 2) return null
    const seed = unsafe.add(w, workerSeed)
    for (let pass = 0; pass < 4; pass++) {
        // xorshift64
        let x = unsafe.load<u64>(seed)
        x ^= x << 13
        x ^= x >> 7
        x ^= x << 17
        unsafe.store<u64>(seed, x)
        const start = i64(x % u64(count))
        for (let k = 0; k < count; k++) {
            const victim = unsafe.load<ptr>(unsafe.add(s.workerList, ((start + k) % count) * 8))
            if (victim === w) continue
            const t = stealFrom(w, victim, pass === 3)
            if (t !== null) return t
        }
    }
    return null
}

/** Whether any worker has a task queued. */
function anyQueued(): bool {
    const s = scheduler()
    const count = unsafe.atomicLoad<i64>(s.workerListCount)
    for (let i = 0; i < count; i++) {
        const v = unsafe.load<ptr>(unsafe.add(s.workerList, i * 8))
        if (unsafe.atomicLoad<i64>(unsafe.add(v, workerTail)) !== unsafe.atomicLoad<i64>(unsafe.add(v, workerHead)))
            return true
        if (unsafe.atomicLoad<u64>(unsafe.add(v, workerNext)) !== 0) return true
    }
    return false
}

/** Wakes an idle worker to look for the task just queued, unless one is looking already. */
function wakeWorker(): void {
    const s = scheduler()
    if (unsafe.atomicLoad<i64>(s.idle) === 0 || unsafe.atomicLoad<i64>(s.spinning) !== 0) return
    // Under the lock: an idle worker holds it from counting itself until it waits.
    lock(s.lock)
    pthread_cond_signal(s.cond)
    unlock(s.lock)
}

/** A spinning worker found a task: if it was the last one looking, another looks for what may remain. */
function stopSpinning(): void {
    if (unsafe.atomicAdd<i64>(scheduler().spinning, -1) === 1) wakeWorker()
}

/**
 * Takes tasks from the global queue: one, or with `batch` a share of them, the
 * others put in this worker's empty queue. The caller holds the scheduler's lock.
 */
function takeGlobalLocked(w: ptr, batch: bool): Task | null {
    const s = scheduler()
    const count = unsafe.load<i64>(s.runCount)
    if (count === 0) return null
    let n = 1
    if (batch) {
        n = count / unsafe.atomicLoad<i64>(s.workerListCount) + 1
        if (n > count) n = count
        if (n > ringSize / 2) n = ringSize / 2
    }
    const first = s.runHead!
    let t = first.next
    for (let i = 1; i < n; i++) {
        const queued = t!
        t = queued.next
        queued.next = null
        const tail = unsafe.load<i64>(unsafe.add(w, workerTail))
        unsafe.store<u64>(ringSlot(w, tail), unsafe.toInt(unsafe.addressOf(queued)))
        unsafe.atomicStore<i64>(unsafe.add(w, workerTail), tail + 1)
    }
    s.runHead = t
    if (t === null) s.runTail = null
    first.next = null
    unsafe.atomicStore<i64>(s.runCount, count - n)
    return first
}

function newTask(body: () => void, stackSize: int): Task {
    const t = new Task(body)
    t.stackSize = stackSize
    return t
}

/**
 * Suspends the current task. Once it has left its stack, its worker runs
 * `then`: typically releasing the lock that a waker of the task needs.
 * Never inlined, so callers keep no thread-local addresses from before it.
 */
//ore:noinline
export function park(then: () => void): void {
    const cell = unsafe.alloc(16)
    unsafe.store<() => void>(cell, then)
    parkWith(cell, nil())
}

/** Suspends the current task with nothing to do after it left its stack. */
//ore:noinline
export function parkOnly(): void {
    parkWith(nil(), nil())
}

/** Suspends the current task, and unlocks `mutex` once it has left its stack: the common case, without a closure. */
//ore:noinline
export function parkUnlocking(mutex: ptr): void {
    parkWith(nil(), mutex)
}

//ore:noinline
function parkWith(cell: ptr, mutex: ptr): void {
    const s = scheduler()
    const w = workerBlock()
    const t = current()
    t.top = getTop()
    unsafe.store<ptr>(unsafe.add(w, 24), cell)
    unsafe.store<ptr>(unsafe.add(w, 56), mutex)
    enterSwitch()
    setStackBase(ownStackBase())
    unsafe.store<i64>(unsafe.add(t.stack, stackRunning), 0)
    switchContext(t.stack, unsafe.load<ptr>(w))
    // Resumed, maybe by another worker, which took the switch lock to get here.
    // `w` is the old worker's block; nothing reads it from here on.
    exitSwitch()
    setTop(t.top)
}

/** The body of every task, entered from the trampoline on the task's stack. */
function taskMain(self: ptr): void {
    const s = scheduler()
    exitSwitch()
    const t = unsafe.fromAddress<Task>(self)
    t.body()
    if (t.spawned) {
        unsafe.atomicAdd<i64>(s.live, -1)
        const ended = taskEnded
        if (ended !== null) ended()
    }
    // The program ends with its top-level code, after what "ore:test" runs then.
    if (t === s.mainTask) {
        const end = mainEnd
        mainEnd = null
        if (end !== null) end()
        exitProgram(0)
    }
    endTask()
}

/** Ends the current task; it never runs again, and its stack is freed. */
export function endTask(): void {
    current().state = done
    parkOnly()
}

//ore:runtime ore_rt_spawn
function spawn(body: () => void): void {
    const t = newTask(body, taskStackSize)
    t.spawned = true
    unsafe.atomicAdd<i64>(scheduler().live, 1)
    enqueueNext(t)
}

/** What runs when a task the program spawned ends: set by the event loop, which may wait for one. */
let taskEnded: (() => void) | null = null

export function setTaskEnded(body: () => void): void {
    taskEnded = body
}

/** The lock that guards making the event loop (loop.ore), which may happen on any task. */
export function loopLock(): ptr {
    return scheduler().loopLock
}

/** How many tasks the program spawned are still running or waiting. */
export function liveTasks(): int {
    return unsafe.atomicLoad<i64>(scheduler().live)
}

// ---------------------------------------------------------------------------
// Fibers
//
// The event loop (loop.ore) runs each call of an async function as a fiber:
// a task that is never queued on its own, but runs only when the task holding
// the loop hands the loop to it, and hands it back when it awaits or ends.
// Only one of them runs at a time, so async code is single-threaded, though
// the fibers may run on any worker.

/** A fiber that runs `body`; it must end with `endFiber`. */
export function newFiber(body: () => void): Task {
    const t = newTask(body, taskStackSize)
    t.fiber = true
    return t
}

/** Runs the fiber `t` until it hands back: the current task waits meanwhile. */
//ore:noinline
export function handTo(t: Task): void {
    const self = current()
    t.resumer = self
    self.state = blocked
    park(() => enqueueNext(t))
}

/** Hands the loop back to the task that ran this fiber, until it is run again. */
//ore:noinline
export function handBack(): void {
    const self = current()
    const resumer = self.resumer!
    self.resumer = null
    self.state = blocked
    park(() => enqueueNext(resumer))
}

/** Ends the current fiber, handing the loop back. */
//ore:noinline
export function endFiber(): void {
    const self = current()
    const resumer = self.resumer!
    self.resumer = null
    self.state = done
    park(() => enqueueNext(resumer))
}

/** Whether the current task holds the event loop: the program's top-level code or a fiber. */
export function onLoop(): bool {
    const w = workerBlock()
    if (isNil(w)) return false
    const t = unsafe.load<ptr>(unsafe.add(w, 32))
    if (isNil(t)) return false
    const task = unsafe.fromAddress<Task>(t)
    return task.fiber || task === scheduler().mainTask
}

/** The task that runs the program's top-level code. */
export function mainTask(): Task {
    return scheduler().mainTask!
}

/** The scheduler's clock, in milliseconds: what `wakeAt` counts in. */
export function nowMilliseconds(): int {
    return now()
}

/** What runs when the program's top-level code ends: the tests that "ore:test" collected. */
let mainEnd: (() => void) | null = null

export function setMainEnd(body: () => void): void {
    mainEnd = body
}

/** Whether the current task runs the program's top-level code. */
export function isMainTask(): bool {
    return current() === scheduler().mainTask
}

/**
 * Starts a task running a test, with its record. A test gets the stack of the
 * program's main task, as its body is often code that ran there.
 */
export function spawnTest(body: () => void, test: ptr): void {
    const t = newTask(body, mainStackSize)
    t.test = test
    enqueue(t)
}

//ore:runtime ore_rt_yield
function yieldTask(): void {
    const t = current()
    park(() => enqueue(t))
}

/** Inserts a task into the timers by wake time; the caller holds the scheduler's lock. */
export function addTimerLocked(t: Task): void {
    const s = scheduler()
    let previous: Task | null = null
    let next = s.timers
    while (next !== null && next.wakeAt <= t.wakeAt) {
        previous = next
        next = next.next
    }
    t.next = next
    if (previous !== null) previous.next = t
    else s.timers = t
    timersChangedLocked()
    pthread_cond_signal(s.cond)
}

/** Publishes the wake time of the first timer; the caller holds the scheduler's lock. */
function timersChangedLocked(): void {
    const s = scheduler()
    const first = s.timers
    unsafe.atomicStore<i64>(s.timerAt, first === null ? -1 : first.wakeAt)
}

/** Whether the first timer is due, read without the lock. */
function timersDue(): bool {
    const at = unsafe.atomicLoad<i64>(scheduler().timerAt)
    return at >= 0 && now() >= at
}

export function removeTimerLocked(t: Task): void {
    const s = scheduler()
    let previous: Task | null = null
    let next = s.timers
    while (next !== null) {
        if (next === t) {
            if (previous !== null) previous.next = t.next
            else s.timers = t.next
            timersChangedLocked()
            return
        }
        previous = next
        next = next.next
    }
}

/** Sets a task to wake `ms` from now. */
export function wakeIn(t: Task, ms: int): void {
    t.wakeAt = now() + (ms > 0 ? ms : 0)
}

/** Milliseconds for a duration in nanoseconds, rounded up: the timers count whole milliseconds. */
export function nanosToMillis(ns: int): int {
    return ns > 0 ? (ns + 999_999) / 1_000_000 : 0
}

/** `task.sleep` and `time.sleep`: suspends the current task for `ns` nanoseconds, rounded up to a millisecond. */
//ore:runtime ore_rt_sleep
export function sleepNanos(ns: int): void {
    sleepMs(nanosToMillis(ns))
}

function sleepMs(ms: int): void {
    const s = scheduler()
    const t = current()
    wakeIn(t, ms)
    t.state = blocked
    lock(s.lock)
    addTimerLocked(t)
    parkUnlocking(s.lock)
}

/** The running task, or null on a thread that runs none. */
//ore:export ore_rt_task_current
export function taskCurrent(): ptr {
    const w = workerBlock()
    return isNil(w) ? nil() : unsafe.load<ptr>(unsafe.add(w, 32))
}

/** Starts another worker thread; the caller holds the scheduler's lock. */
function addWorkerLocked(): void {
    if (startThread(unsafe.functionAddress(workerMain), nil())) scheduler().workers++
}

/**
 * Brackets a call that may block its OS thread, such as file I/O, so that
 * another worker runs the other tasks meanwhile.
 */
//ore:export ore_rt_blocking_enter
export function blockingEnter(): void {
    const s = scheduler()
    const w = workerBlock()
    lock(s.lock)
    s.blockingWorkers++
    // Tasks queued here are stolen meanwhile: by an idle worker, or by a new one.
    const queued =
        unsafe.load<i64>(s.runCount) > 0 ||
        (!isNil(w) &&
            (unsafe.load<i64>(unsafe.add(w, workerTail)) !== unsafe.atomicLoad<i64>(unsafe.add(w, workerHead)) ||
                unsafe.atomicLoad<u64>(unsafe.add(w, workerNext)) !== 0))
    if (queued) {
        if (unsafe.atomicLoad<i64>(s.idle) > 0) pthread_cond_signal(s.cond)
        else if (s.workers < s.maxWorkers) addWorkerLocked()
    }
    unlock(s.lock)
}

//ore:export ore_rt_blocking_exit
export function blockingExit(): void {
    const s = scheduler()
    lock(s.lock)
    s.blockingWorkers--
    unlock(s.lock)
}

/** Moves tasks whose time has come from the timers to the run queue; the caller holds the scheduler's lock. */
function wakeTimersLocked(): void {
    const s = scheduler()
    if (s.timers === null) return
    const at = now()
    while (true) {
        const t = s.timers
        if (t === null || t.wakeAt > at) break
        s.timers = t.next
        // A task waiting in a select wakes for its timeout unless a channel case fired first.
        const select = t.select
        if (select !== null && !unsafe.atomicCompareExchange<i64>(select.fired, selectWaiting, selectTimeout)) continue
        enqueueLocked(t)
    }
    timersChangedLocked()
}

/** Counts a task that waits for a socket, so that waiting for it is no deadlock. */
export function addNetWaiterLocked(delta: int): void {
    scheduler().netWaiters += delta
}

/** The next task to run, waiting for one; panics when every task waits forever. */
function nextTask(w: ptr): Task {
    const s = scheduler()
    const ticks = unsafe.load<i64>(unsafe.add(w, workerTicks)) + 1
    unsafe.store<i64>(unsafe.add(w, workerTicks), ticks)
    if (timersDue()) {
        lock(s.lock)
        wakeTimersLocked()
        unlock(s.lock)
    }
    // Now and then the global queue first, so that no task waits there forever.
    if (ticks % 61 === 0 && unsafe.atomicLoad<i64>(s.runCount) > 0) {
        lock(s.lock)
        const t = takeGlobalLocked(w, false)
        unlock(s.lock)
        if (t !== null) return t
    }
    const t = takeLocal(w)
    if (t !== null) return t
    return findTask(w)
}

/** A task for a worker whose own queue is empty: from the global queue, stolen, or waited for. */
function findTask(w: ptr): Task {
    const s = scheduler()
    let spinning = false
    while (true) {
        if (unsafe.atomicLoad<i64>(s.runCount) > 0 || timersDue()) {
            lock(s.lock)
            wakeTimersLocked()
            const t = takeGlobalLocked(w, true)
            unlock(s.lock)
            if (t !== null) {
                if (spinning) stopSpinning()
                return t
            }
        }
        // At most half the busy workers look for tasks to steal; the others wait.
        if (spinning || 2 * unsafe.atomicLoad<i64>(s.spinning) < s.workers - unsafe.atomicLoad<i64>(s.idle)) {
            if (!spinning) {
                spinning = true
                unsafe.atomicAdd<i64>(s.spinning, 1)
            }
            const t = steal(w)
            if (t !== null) {
                stopSpinning()
                return t
            }
        }
        lock(s.lock)
        wakeTimersLocked()
        const t = takeGlobalLocked(w, true)
        if (t !== null) {
            unlock(s.lock)
            if (spinning) stopSpinning()
            return t
        }
        if (spinning) {
            spinning = false
            unsafe.atomicAdd<i64>(s.spinning, -1)
        }
        // Idle from here, then a last look: a worker that queued a task before
        // this saw no idle worker to wake, but its task is visible now.
        unsafe.atomicAdd<i64>(s.idle, 1)
        if (anyQueued()) {
            unsafe.atomicAdd<i64>(s.idle, -1)
            unlock(s.lock)
            spinning = true
            unsafe.atomicAdd<i64>(s.spinning, 1)
            continue
        }
        const timers = s.timers
        if (
            timers === null &&
            s.blockingWorkers === 0 &&
            s.netWaiters === 0 &&
            unsafe.atomicLoad<i64>(s.idle) === s.workers
        ) {
            unlock(s.lock)
            const main = s.mainTask
            if (main !== null) {
                setCurrent(w, unsafe.addressOf(main))
                setTop(main.top)
            }
            process.panic("all tasks are asleep - deadlock!")
        }
        if (timers !== null) {
            const wait = timers.wakeAt - now()
            deadlineIn(unsafe.add(w, 40), wait > 0 ? wait : 0)
            parkedWait(s.cond, s.lock, unsafe.add(w, 40))
        } else {
            parkedWait(s.cond, s.lock, nil())
        }
        // Woken to look for a task: spinning, so that others need not be woken too.
        spinning = true
        unsafe.atomicAdd<i64>(s.spinning, 1)
        unsafe.atomicAdd<i64>(s.idle, -1)
        unlock(s.lock)
    }
}

/** A worker: runs tasks until the program ends. It stays on its own OS thread, so `w` stays its block. */
function schedule(): void {
    const s = scheduler()
    const w = workerBlock()
    while (true) {
        const t = nextTask(w)
        unsafe.atomicAdd<i64>(s.switches, 1)
        setCurrent(w, unsafe.addressOf(t))
        setTop(t.top)
        if (isNil(t.stack)) startStack(w, t)
        enterSwitch()
        setStackBase(t.hi())
        unsafe.store<i64>(unsafe.add(t.stack, stackRunning), 1)
        switchContext(w, t.sp())
        // The task parked or ended, holding the switch lock.
        exitSwitch()
        setCurrent(w, nil())
        // Decided before `then` runs: once it makes the task runnable, another
        // worker may run it to its end and free it.
        const finished = t.state === done
        const cell = unsafe.load<ptr>(unsafe.add(w, 24))
        unsafe.store<ptr>(unsafe.add(w, 24), nil())
        const mutex = unsafe.load<ptr>(unsafe.add(w, 56))
        unsafe.store<ptr>(unsafe.add(w, 56), nil())
        if (!isNil(mutex)) unlock(mutex)
        if (!isNil(cell)) {
            const then = unsafe.load<() => void>(cell)
            then()
        }
        if (finished) giveStack(w, t.stack)
    }
}

function workerMain(argument: ptr): ptr {
    registerThread()
    setSignalStack()
    newWorker()
    schedule()
    return argument
}

/** The number of workers: ORE_THREADS, or one per CPU. */
function workerCount(): int {
    const configured = getenv("ORE_THREADS")
    if (isNil(configured)) return cpuCount()
    let n = 0
    let i = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(configured, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        i++
    }
    return n > 0 ? n : 1
}

/** Runs the program: its top-level code (`entry`, a C function) as the first task, on the workers. */
//ore:export ore_rt_run_main
export function runMain(entry: ptr): void {
    const s = new Scheduler()
    schedulerAddress = unsafe.addressOf(s)
    stackLock = permanentMutex()
    allStacks = permanent(8)
    setStackSizes()
    setSignalStack()
    installOverflowHandler()
    unsafe.store<i64>(s.timerAt, -1)
    const count = workerCount()
    s.maxWorkers = count + 64
    s.workerList = permanent(s.maxWorkers * 8)
    newWorker()
    setStackRootsHook(unsafe.functionAddress(pushTaskStacks))

    // The entry as a closure, called with an environment it ignores.
    const cell = permanent(16)
    unsafe.store<ptr>(cell, entry)
    s.mainTask = newTask(unsafe.load<() => void>(cell), mainStackSize)
    lock(s.lock)
    s.workers = 1
    enqueueLocked(s.mainTask)
    for (let i = 1; i < count; i++) addWorkerLocked()
    unlock(s.lock)
    startWatchdog()
    schedule()
}

// ---------------------------------------------------------------------------
// The watchdog

/** The seconds of ORE_WATCHDOG, or 0 when it is not set. */
let watchdogSeconds: int

/**
 * With ORE_WATCHDOG=<seconds>, a thread that reports a stuck program: one in
 * which no task started or resumed and nothing was allocated for that long,
 * such as threads waiting on each other's locks in the runtime. It prints the
 * scheduler's state, the stack of every parked task (in debug builds) and the
 * native stack of every thread, then ends the program with status 3. A
 * program that computes for that long without allocating is reported too, so
 * it is meant for tests, with a generous limit.
 */
function startWatchdog(): void {
    const configured = getenv("ORE_WATCHDOG")
    if (isNil(configured)) return
    let n = 0
    let i = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(configured, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        i++
    }
    if (n <= 0) return
    watchdogSeconds = n
    if (!startThread(unsafe.functionAddress(watchdogMain), nil())) process.panic("cannot start the watchdog")
}

/** The watchdog's thread. Unknown to the collector: it allocates nothing and takes no lock. */
function watchdogMain(argument: ptr): ptr {
    const s = scheduler()
    const second = permanent(16)
    unsafe.store<i64>(second, 1)
    let switches = unsafe.atomicLoad<i64>(s.switches)
    let allocated = allocatedTotal()
    let still = 0
    while (true) {
        nanosleep(second, nil())
        const nowSwitches = unsafe.atomicLoad<i64>(s.switches)
        const nowAllocated = allocatedTotal()
        if (nowSwitches !== switches || nowAllocated !== allocated) {
            switches = nowSwitches
            allocated = nowAllocated
            still = 0
            continue
        }
        still++
        if (still >= watchdogSeconds) break
    }
    flushOutputIfFree()
    reportStuck()
    exitStuck(3)
    return argument
}

declare function _exit(status: i32): void

/** Ends the process at once: other threads may hold the locks that a normal exit would take. */
function exitStuck(status: i32): void {
    _exit(status)
}

/** What the watchdog prints: read without locks, since the program may hold any of them. */
function reportStuck(): void {
    const s = scheduler()
    const scratch = permanent(32)
    writeRaw(2, "\nwatchdog: no task ran and nothing was allocated for ")
    writeNumber(2, watchdogSeconds, false, scratch)
    writeRaw(2, " s (ORE_WATCHDOG)\n")
    writeRaw(2, "  workers ")
    writeNumber(2, s.workers, false, scratch)
    writeRaw(2, ", idle ")
    writeNumber(2, unsafe.load<i64>(s.idle), false, scratch)
    writeRaw(2, ", in blocking calls ")
    writeNumber(2, s.blockingWorkers, false, scratch)
    writeRaw(2, ", waiting for sockets ")
    writeNumber(2, s.netWaiters, false, scratch)
    writeRaw(2, s.runHead !== null || anyQueued() ? ", runnable tasks queued" : ", no runnable task")
    writeRaw(2, s.timers !== null ? ", timers pending\n" : ", no timer\n")
    // Tasks that have a stack, with their debug frames: prev at 0, function at 8, file at 16, line at 24.
    let r = firstStack()
    let shown = 0
    while (!isNil(r) && shown < 64) {
        const task = stackField(r, stackTask)
        r = stackField(r, stackAllNext)
        if (isNil(task)) continue
        const t = unsafe.fromAddress<Task>(task)
        const running = unsafe.load<i64>(unsafe.add(t.stack, stackRunning)) !== 0
        writeRaw(2, running ? "task (running):\n" : "task (parked):\n")
        let frame = t.top
        let depth = 0
        while (!isNil(frame) && depth < 32) {
            writeRaw(2, "  ")
            writeCString(unsafe.load<ptr>(unsafe.add(frame, 8)))
            writeRaw(2, " at ")
            writeCString(unsafe.load<ptr>(unsafe.add(frame, 16)))
            writeRaw(2, ":")
            writeNumber(2, i64(unsafe.load<i32>(unsafe.add(frame, 24))), false, scratch)
            writeRaw(2, "\n")
            frame = unsafe.load<ptr>(frame)
            depth++
        }
        if (depth === 0) writeRaw(2, "  (no frames: a release build, or not started)\n")
        shown++
    }
    writeRaw(2, "native stacks:\n")
    dumpThreads()
}

declare function strlen(s: ptr): u64

/** Writes a NUL-terminated string without copying it. */
function writeCString(p: ptr): void {
    writeRaw(2, unsafe.makeString(p, i64(strlen(p))))
}
