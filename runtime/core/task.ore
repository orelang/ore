//ore:internal
// Green threads ("tasks") on several OS threads ("workers"), M:N like Go.
//
// Tasks run until they wait (on a channel, a timer or a select) or yield;
// any worker runs any runnable task. Every task that has started, including
// the one running the program's top-level code, has its own mapped stack with
// a guard page.
// The program ends when the top-level code ends.
//
// Garbage collection: each worker tells the collector the stack base of the
// task it runs (gc.setStackBase), and a hook scans the used part of every task
// that is not running, walking a list of stack records that spawning and
// ending a task do not lock (see "Stacks"). Switching stacks is not atomic,
// so a worker switches inside the read side of the collector's switch lock
// (gc.enterSwitch), which the collector takes for writing before it stops the
// world. No code allocates while it holds the read side, or a collection
// would wait for it forever.
//
// Waking before sleeping: a task that waits holds a lock (of a channel, or of
// the scheduler) that its wakers need, and releases it only after it has left
// its stack, in the worker's loop (`park` takes what to do then).
//
// Thread-local variables after a switch: a task may resume on another worker,
// and an address of a thread-local variable computed before the switch is the
// old thread's. Code reads them only through the noinline functions below,
// which compute the address again on the current thread.
//
// The scheduler's state starts at zero and is set by ore_rt_run_main before
// any top-level code runs, including the runtime's own: it lives in globals
// that are numbers or pointers, which a declaration without a value does not
// reset.

import { getTop, setTop } from "ore:runtime/frames"
import {
    addRoot,
    allocatedTotal,
    dumpThreads,
    enterSwitch,
    exitSwitch,
    ownStackBase,
    registerThread,
    scanRange,
    setStackBase,
    setStackRootsHook,
} from "ore:runtime/gc"
import { exitProgram, flushOutputIfFree } from "ore:runtime/io"
import {
    cpuCount,
    deadlineIn,
    epochMs,
    getenv,
    nanosleep,
    isNil,
    lock,
    mapGuarded,
    nil,
    nowMs,
    writeNumber,
    writeRaw,
    pageSize,
    permanent,
    permanentCond,
    permanentMutex,
    pthread_cond_signal,
    pthread_cond_timedwait,
    pthread_cond_wait,
    startThread,
    unlock,
    unmap,
} from "ore:runtime/os"

const mainStackSize = 8 << 20
const taskStackSize = 256 << 10

export const runnable = 0
export const blocked = 1
export const done = 2

/** A select in progress: which case fired, or none yet, in a cell claimed atomically by its first waker. */
export class SelectState {
    fired: ptr = unsafe.allocBytes(8)

    constructor() {
        unsafe.store<i64>(this.fired, selectWaiting)
    }
}

export const selectWaiting = -1
export const selectTimeout = -2

export class Task {
    /** The task's stack record (see "Stacks"), from when a worker first runs it; nil before. */
    stack: ptr = nil()
    /** The size of stack it gets. */
    stackSize = 0
    /** The shadow stack of debug frames while the task is parked. */
    top: ptr = nil()
    state = runnable
    /** The next task in the run queue or the timers. */
    next: Task | null = null
    /** When a sleeping task wakes, in milliseconds. */
    wakeAt = 0
    /** The select the task waits in, if any, so that a timer can time it out. */
    select: SelectState | null = null
    /** The waiter the task reuses for channel operations (an address in chan.ore), or null. */
    waiter: ptr = nil()
    /** For a task running a test of `ore test`: its record (an address in program.ore), or null. */
    test: ptr = nil()

    constructor(readonly body: () => void) {}

    /** The stack pointer saved while the task is parked. */
    sp(): ptr {
        return unsafe.load<ptr>(this.stack)
    }

    /** The top of the task's stack. */
    hi(): ptr {
        return unsafe.load<ptr>(unsafe.add(this.stack, stackHi))
    }
}

/** The run queue, the timers and the workers, under `lock`. */
class Scheduler {
    lock = permanentMutex()
    cond = permanentCond()
    runHead: Task | null = null
    runTail: Task | null = null
    /** Sleeping tasks by wake time. */
    timers: Task | null = null
    workers = 0
    idleWorkers = 0
    blockingWorkers = 0
    maxWorkers = 0
    /** Tasks parked until a socket is ready: not a deadlock while there are any. */
    netWaiters = 0
    mainTask: Task | null = null
    /** Whether the network poller was started: 0 not yet, 1 starting, 2 running. */
    pollState = permanent(8)
    /** How many times a worker has started or resumed a task: the watchdog's sign of progress. */
    switches = permanent(8)
}

/** The scheduler, set by ore_rt_run_main. */
let schedulerAddress: ptr

export function scheduler(): Scheduler {
    return unsafe.fromAddress<Scheduler>(schedulerAddress)
}

// ---------------------------------------------------------------------------
// Per worker: a block of memory that the thread-local `worker` points to.
//   0 the scheduler loop's stack pointer while a task runs
//   8 free stack records kept by this worker, linked by their stackFreeNext
//  16 how many
//  24 what to do after the current task has left its stack: a closure cell, or null
//  32 the current task, or null
//  40 a timespec, for clocks and deadlines (16 bytes)
//  56 a mutex to unlock after the current task has left its stack, or null
//  64 the state of Math.random's generator, zero until first used

//ore:threadlocal
let worker: ptr

const workerSize = 72

//ore:noinline
function workerBlock(): ptr {
    return worker
}

//ore:noinline
function setWorkerBlock(block: ptr): void {
    worker = block
}

/** The running task of this worker. */
//ore:noinline
export function current(): Task {
    return unsafe.fromAddress<Task>(unsafe.load<ptr>(unsafe.add(workerBlock(), 32)))
}

function setCurrent(w: ptr, t: ptr): void {
    unsafe.store<ptr>(unsafe.add(w, 32), t)
}

function now(): int {
    return nowMs(unsafe.add(workerBlock(), 40))
}

/** Milliseconds since the Unix epoch, read through this worker's timespec. */
export function wallClockMs(): int {
    return epochMs(unsafe.add(workerBlock(), 40))
}

/** The 8 bytes of this worker's random number generator. */
export function randomState(): ptr {
    return unsafe.add(workerBlock(), 64)
}

/** A new worker block for this thread; allocates no collected memory. */
function newWorker(): ptr {
    const w = permanent(workerSize)
    // The block may hold the only reference to the closure a parked task left
    // for its worker (at 24) and to the current task (at 32).
    addRoot(w, workerSize)
    setWorkerBlock(w)
    return w
}

// ---------------------------------------------------------------------------
// Context switching

/**
 * Saves the callee-saved registers on the current stack, stores the stack
 * pointer at `save`, and resumes the stack `load`.
 */
//ore:naked
function switchContext(save: ptr, load: ptr): void {
    if (target.arch === "arm64") {
        unsafe.asm(
            "sub sp, sp, #160\nstp x19, x20, [sp, #0]\nstp x21, x22, [sp, #16]\nstp x23, x24, [sp, #32]\nstp x25, x26, [sp, #48]\nstp x27, x28, [sp, #64]\nstp x29, x30, [sp, #80]\nstp d8, d9, [sp, #96]\nstp d10, d11, [sp, #112]\nstp d12, d13, [sp, #128]\nstp d14, d15, [sp, #144]\nmov x2, sp\nstr x2, [x0]\nmov sp, x1\nldp x19, x20, [sp, #0]\nldp x21, x22, [sp, #16]\nldp x23, x24, [sp, #32]\nldp x25, x26, [sp, #48]\nldp x27, x28, [sp, #64]\nldp x29, x30, [sp, #80]\nldp d8, d9, [sp, #96]\nldp d10, d11, [sp, #112]\nldp d12, d13, [sp, #128]\nldp d14, d15, [sp, #144]\nadd sp, sp, #160\nret",
            "~{memory}",
        )
    } else {
        unsafe.asm(
            "pushq %rbp\npushq %rbx\npushq %r12\npushq %r13\npushq %r14\npushq %r15\nmovq %rsp, (%rdi)\nmovq %rsi, %rsp\npopq %r15\npopq %r14\npopq %r13\npopq %r12\npopq %rbx\npopq %rbp\nretq",
            "~{memory}",
        )
    }
}

/** The first code of a new task: calls the function in a saved register with the task in another. */
//ore:naked
function trampoline(): void {
    if (target.arch === "arm64") unsafe.asm("mov x0, x19\nblr x20\nbrk #0", "~{memory}")
    else unsafe.asm("movq %rbx, %rdi\ncallq *%r12\nud2", "~{memory}")
}

// ---------------------------------------------------------------------------
// Garbage collection

// Stacks
//
// A stack record is permanent memory that describes one mapped stack, linked
// into a list that only grows (a new record is published with one atomic
// compare-and-swap), so that the collector's hook can walk it while the world
// is stopped at any instruction, and spawning or ending a task takes no lock
// of the collector. A task gets a stack when a worker first runs it and gives
// it back when it ends: each worker keeps a few free stacks, a shared cache
// keeps more, and only what overflows both is unmapped; its record then waits
// for reuse with no mapping.
//   0 the stack pointer while the task is parked, or nil when no task uses the stack
//   8 the top of the stack: the GC's stack base
//  16 the mapping, guard page first, or nil
//  24 the size of the stack, without the guard page
//  32 whether a worker runs the task: its stack is then scanned as the worker's
//  40 the next record of all of them
//  48 the next free record
//  56 the task using the stack, for the watchdog, or nil

const stackHi = 8
const stackMap = 16
const stackUsable = 24
const stackRunning = 32
const stackAllNext = 40
const stackFreeNext = 48
const stackTask = 56
const stackRecordSize = 64

/** Free stacks a worker keeps for itself before it gives them to the shared cache. */
const workerStacks = 16
/** Free stacks the shared cache keeps mapped before it unmaps them. */
const sharedStacks = 256

/** A cell holding the first of every stack record, linked by their stackAllNext; set by ore_rt_run_main. */
let allStacks: ptr
/** Under `stackLock`: free records with a task stack mapped, how many, and free records with none. */
let stackLock: ptr
let freeStacks: ptr
let freeStackCount: int
let bareStacks: ptr

function stackField(record: ptr, offset: int): ptr {
    return unsafe.load<ptr>(unsafe.add(record, offset))
}

function setStackField(record: ptr, offset: int, value: ptr): void {
    unsafe.store<ptr>(unsafe.add(record, offset), value)
}

/** The first stack record, or nil. */
function firstStack(): ptr {
    return unsafe.fromInt(unsafe.atomicLoad<u64>(allStacks))
}

/** Pushes the used part of the stack of every task that no worker is running. */
function pushTaskStacks(): void {
    let r = firstStack()
    while (!isNil(r)) {
        const sp = stackField(r, 0)
        if (unsafe.load<i64>(unsafe.add(r, stackRunning)) === 0 && !isNil(sp)) scanRange(sp, stackField(r, stackHi))
        r = stackField(r, stackAllNext)
    }
}

/** A new record, published in the list of all of them. */
function newStackRecord(): ptr {
    const r = permanent(stackRecordSize)
    while (true) {
        const head = unsafe.atomicLoad<u64>(allStacks)
        setStackField(r, stackAllNext, unsafe.fromInt(head))
        if (unsafe.atomicCompareExchange<u64>(allStacks, head, unsafe.toInt(r))) return r
    }
}

/** Maps a stack of `size` usable bytes, with a guard page below it, for a record that has none. */
function mapStack(r: ptr, size: int): void {
    const mapSize = size + pageSize()
    const map = mapGuarded(mapSize)
    if (isNil(map)) process.panic("cannot allocate a task stack")
    setStackField(r, stackMap, map)
    unsafe.store<i64>(unsafe.add(r, stackUsable), size)
    setStackField(r, stackHi, unsafe.add(map, mapSize))
}

/** A free stack record of `size` usable bytes: one this worker keeps, one of the shared cache, or a new one. */
function takeStack(w: ptr, size: int): ptr {
    if (size === taskStackSize) {
        const own = unsafe.load<ptr>(unsafe.add(w, 8))
        if (!isNil(own)) {
            unsafe.store<ptr>(unsafe.add(w, 8), stackField(own, stackFreeNext))
            unsafe.store<i64>(unsafe.add(w, 16), unsafe.load<i64>(unsafe.add(w, 16)) - 1)
            return own
        }
    }
    lock(stackLock)
    if (size === taskStackSize && !isNil(freeStacks)) {
        const r = freeStacks
        freeStacks = stackField(r, stackFreeNext)
        freeStackCount--
        unlock(stackLock)
        return r
    }
    let r = bareStacks
    if (!isNil(r)) bareStacks = stackField(r, stackFreeNext)
    unlock(stackLock)
    if (isNil(r)) r = newStackRecord()
    mapStack(r, size)
    return r
}

/** Takes back the stack record of an ended task. */
function giveStack(w: ptr, r: ptr): void {
    // No longer scanned, before any other worker can take it.
    setStackField(r, 0, nil())
    setStackField(r, stackTask, nil())
    const size = unsafe.load<i64>(unsafe.add(r, stackUsable))
    if (size === taskStackSize) {
        const own = unsafe.load<i64>(unsafe.add(w, 16))
        if (own < workerStacks) {
            setStackField(r, stackFreeNext, unsafe.load<ptr>(unsafe.add(w, 8)))
            unsafe.store<ptr>(unsafe.add(w, 8), r)
            unsafe.store<i64>(unsafe.add(w, 16), own + 1)
            return
        }
        lock(stackLock)
        if (freeStackCount < sharedStacks) {
            setStackField(r, stackFreeNext, freeStacks)
            freeStacks = r
            freeStackCount++
            unlock(stackLock)
            return
        }
        unlock(stackLock)
    }
    unmap(stackField(r, stackMap), size + pageSize())
    setStackField(r, stackMap, nil())
    lock(stackLock)
    setStackField(r, stackFreeNext, bareStacks)
    bareStacks = r
    unlock(stackLock)
}

/**
 * Gives a task that has not run yet its stack, with an initial frame that the
 * context switch "returns" through into the trampoline.
 */
function startStack(w: ptr, t: Task): void {
    const r = takeStack(w, t.stackSize)
    const top = unsafe.fromInt(unsafe.toInt(stackField(r, stackHi)) & ~u64(15))
    const self = unsafe.addressOf(t)
    let frame = nil()
    if (target.arch === "arm64") {
        frame = unsafe.add(top, -160)
        unsafe.fill(frame, 0, 160)
        unsafe.store<ptr>(frame, self)
        unsafe.store<ptr>(unsafe.add(frame, 8), unsafe.functionAddress(taskMain))
        unsafe.store<ptr>(unsafe.add(frame, 88), unsafe.functionAddress(trampoline))
    } else {
        // Six saved registers and the return address into the trampoline; after
        // `ret`, rsp is 16-byte aligned, as the ABI requires before the
        // trampoline's call.
        frame = unsafe.add(top, -72)
        unsafe.fill(frame, 0, 72)
        unsafe.store<ptr>(unsafe.add(frame, 24), unsafe.functionAddress(taskMain))
        unsafe.store<ptr>(unsafe.add(frame, 32), self)
        unsafe.store<ptr>(unsafe.add(frame, 48), unsafe.functionAddress(trampoline))
    }
    setStackField(r, stackTask, self)
    // Scanned from here on, as a parked task's stack.
    setStackField(r, 0, frame)
    t.stack = r
}

// ---------------------------------------------------------------------------
// Tasks

/** Makes a task runnable; the caller holds the scheduler's lock. */
export function enqueueLocked(t: Task): void {
    const s = scheduler()
    t.state = runnable
    t.next = null
    const tail = s.runTail
    if (tail !== null) tail.next = t
    else s.runHead = t
    s.runTail = t
    // Idle workers count themselves with the lock held, before they wait.
    if (s.idleWorkers > 0) pthread_cond_signal(s.cond)
}

export function enqueue(t: Task): void {
    const s = scheduler()
    lock(s.lock)
    enqueueLocked(t)
    unlock(s.lock)
}

function newTask(body: () => void, stackSize: int): Task {
    const t = new Task(body)
    t.stackSize = stackSize
    return t
}

/**
 * Suspends the current task. Once it has left its stack, its worker runs
 * `then`: typically releasing the lock that a waker of the task needs.
 * Never inlined, so callers keep no thread-local addresses from before it.
 */
//ore:noinline
export function park(then: () => void): void {
    const cell = unsafe.alloc(16)
    unsafe.store<() => void>(cell, then)
    parkWith(cell, nil())
}

/** Suspends the current task with nothing to do after it left its stack. */
//ore:noinline
export function parkOnly(): void {
    parkWith(nil(), nil())
}

/** Suspends the current task, and unlocks `mutex` once it has left its stack: the common case, without a closure. */
//ore:noinline
export function parkUnlocking(mutex: ptr): void {
    parkWith(nil(), mutex)
}

//ore:noinline
function parkWith(cell: ptr, mutex: ptr): void {
    const s = scheduler()
    const w = workerBlock()
    const t = current()
    t.top = getTop()
    unsafe.store<ptr>(unsafe.add(w, 24), cell)
    unsafe.store<ptr>(unsafe.add(w, 56), mutex)
    enterSwitch()
    setStackBase(ownStackBase())
    unsafe.store<i64>(unsafe.add(t.stack, stackRunning), 0)
    switchContext(t.stack, unsafe.load<ptr>(w))
    // Resumed, maybe by another worker, which took the switch lock to get here.
    // `w` is the old worker's block; nothing reads it from here on.
    exitSwitch()
    setTop(t.top)
}

/** The body of every task, entered from the trampoline on the task's stack. */
function taskMain(self: ptr): void {
    const s = scheduler()
    exitSwitch()
    const t = unsafe.fromAddress<Task>(self)
    t.body()
    // The program ends with its top-level code, after what "ore:test" runs then.
    if (t === s.mainTask) {
        const end = mainEnd
        mainEnd = null
        if (end !== null) end()
        exitProgram(0)
    }
    endTask()
}

/** Ends the current task; it never runs again, and its stack is freed. */
export function endTask(): void {
    current().state = done
    parkOnly()
}

//ore:runtime ore_rt_spawn
function spawn(body: () => void): void {
    enqueue(newTask(body, taskStackSize))
}

/** What runs when the program's top-level code ends: the tests that "ore:test" collected. */
let mainEnd: (() => void) | null = null

export function setMainEnd(body: () => void): void {
    mainEnd = body
}

/** Whether the current task runs the program's top-level code. */
export function isMainTask(): bool {
    return current() === scheduler().mainTask
}

/**
 * Starts a task running a test, with its record. A test gets the stack of the
 * program's main task, as its body is often code that ran there.
 */
export function spawnTest(body: () => void, test: ptr): void {
    const t = newTask(body, mainStackSize)
    t.test = test
    enqueue(t)
}

//ore:runtime ore_rt_yield
function yieldTask(): void {
    const t = current()
    park(() => enqueue(t))
}

/** Inserts a task into the timers by wake time; the caller holds the scheduler's lock. */
export function addTimerLocked(t: Task): void {
    const s = scheduler()
    let previous: Task | null = null
    let next = s.timers
    while (next !== null && next.wakeAt <= t.wakeAt) {
        previous = next
        next = next.next
    }
    t.next = next
    if (previous !== null) previous.next = t
    else s.timers = t
    pthread_cond_signal(s.cond)
}

export function removeTimerLocked(t: Task): void {
    const s = scheduler()
    let previous: Task | null = null
    let next = s.timers
    while (next !== null) {
        if (next === t) {
            if (previous !== null) previous.next = t.next
            else s.timers = t.next
            return
        }
        previous = next
        next = next.next
    }
}

/** Sets a task to wake `ms` from now. */
export function wakeIn(t: Task, ms: int): void {
    t.wakeAt = now() + (ms > 0 ? ms : 0)
}

//ore:runtime ore_rt_sleep
function sleep(ms: int): void {
    const s = scheduler()
    const t = current()
    wakeIn(t, ms)
    t.state = blocked
    lock(s.lock)
    addTimerLocked(t)
    parkUnlocking(s.lock)
}

/** The running task, or null on a thread that runs none. */
//ore:export ore_rt_task_current
export function taskCurrent(): ptr {
    const w = workerBlock()
    return isNil(w) ? nil() : unsafe.load<ptr>(unsafe.add(w, 32))
}

/** Starts another worker thread; the caller holds the scheduler's lock. */
function addWorkerLocked(): void {
    if (startThread(unsafe.functionAddress(workerMain), nil())) scheduler().workers++
}

/**
 * Brackets a call that may block its OS thread, such as file I/O, so that
 * another worker runs the other tasks meanwhile.
 */
//ore:export ore_rt_blocking_enter
export function blockingEnter(): void {
    const s = scheduler()
    lock(s.lock)
    s.blockingWorkers++
    if (s.runHead !== null && s.idleWorkers === 0 && s.workers < s.maxWorkers) addWorkerLocked()
    unlock(s.lock)
}

//ore:export ore_rt_blocking_exit
export function blockingExit(): void {
    const s = scheduler()
    lock(s.lock)
    s.blockingWorkers--
    unlock(s.lock)
}

/** Moves tasks whose time has come from the timers to the run queue; the caller holds the scheduler's lock. */
function wakeTimersLocked(): void {
    const s = scheduler()
    if (s.timers === null) return
    const at = now()
    while (true) {
        const t = s.timers
        if (t === null || t.wakeAt > at) return
        s.timers = t.next
        // A task waiting in a select wakes for its timeout unless a channel case fired first.
        const select = t.select
        if (select !== null && !unsafe.atomicCompareExchange<i64>(select.fired, selectWaiting, selectTimeout)) continue
        enqueueLocked(t)
    }
}

/** Counts a task that waits for a socket, so that waiting for it is no deadlock. */
export function addNetWaiterLocked(delta: int): void {
    scheduler().netWaiters += delta
}

/** The next task to run, waiting for one; panics when every task waits forever. */
function nextTask(w: ptr): Task {
    const s = scheduler()
    lock(s.lock)
    while (true) {
        wakeTimersLocked()
        const t = s.runHead
        if (t !== null) {
            s.runHead = t.next
            if (s.runHead === null) s.runTail = null
            unlock(s.lock)
            return t
        }
        const timers = s.timers
        if (timers === null && s.blockingWorkers === 0 && s.netWaiters === 0 && s.idleWorkers === s.workers - 1) {
            unlock(s.lock)
            const main = s.mainTask
            if (main !== null) {
                setCurrent(w, unsafe.addressOf(main))
                setTop(main.top)
            }
            process.panic("all tasks are asleep - deadlock!")
        }
        s.idleWorkers++
        if (timers !== null) {
            const wait = timers.wakeAt - now()
            deadlineIn(unsafe.add(w, 40), wait > 0 ? wait : 0)
            pthread_cond_timedwait(s.cond, s.lock, unsafe.add(w, 40))
        } else {
            pthread_cond_wait(s.cond, s.lock)
        }
        s.idleWorkers--
    }
}

/** A worker: runs tasks until the program ends. It stays on its own OS thread, so `w` stays its block. */
function schedule(): void {
    const s = scheduler()
    const w = workerBlock()
    while (true) {
        const t = nextTask(w)
        unsafe.atomicAdd<i64>(s.switches, 1)
        setCurrent(w, unsafe.addressOf(t))
        setTop(t.top)
        if (isNil(t.stack)) startStack(w, t)
        enterSwitch()
        setStackBase(t.hi())
        unsafe.store<i64>(unsafe.add(t.stack, stackRunning), 1)
        switchContext(w, t.sp())
        // The task parked or ended, holding the switch lock.
        exitSwitch()
        setCurrent(w, nil())
        // Decided before `then` runs: once it makes the task runnable, another
        // worker may run it to its end and free it.
        const finished = t.state === done
        const cell = unsafe.load<ptr>(unsafe.add(w, 24))
        unsafe.store<ptr>(unsafe.add(w, 24), nil())
        const mutex = unsafe.load<ptr>(unsafe.add(w, 56))
        unsafe.store<ptr>(unsafe.add(w, 56), nil())
        if (!isNil(mutex)) unlock(mutex)
        if (!isNil(cell)) {
            const then = unsafe.load<() => void>(cell)
            then()
        }
        if (finished) giveStack(w, t.stack)
    }
}

function workerMain(argument: ptr): ptr {
    registerThread()
    newWorker()
    schedule()
    return argument
}

/** The number of workers: ORE_THREADS, or one per CPU. */
function workerCount(): int {
    const configured = getenv("ORE_THREADS")
    if (isNil(configured)) return cpuCount()
    let n = 0
    let i = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(configured, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        i++
    }
    return n > 0 ? n : 1
}

/** Runs the program: its top-level code (`entry`, a C function) as the first task, on the workers. */
//ore:export ore_rt_run_main
export function runMain(entry: ptr): void {
    const s = new Scheduler()
    schedulerAddress = unsafe.addressOf(s)
    stackLock = permanentMutex()
    allStacks = permanent(8)
    newWorker()
    setStackRootsHook(unsafe.functionAddress(pushTaskStacks))

    const count = workerCount()
    s.maxWorkers = count + 64
    // The entry as a closure, called with an environment it ignores.
    const cell = permanent(16)
    unsafe.store<ptr>(cell, entry)
    s.mainTask = newTask(unsafe.load<() => void>(cell), mainStackSize)
    lock(s.lock)
    s.workers = 1
    enqueueLocked(s.mainTask)
    for (let i = 1; i < count; i++) addWorkerLocked()
    unlock(s.lock)
    startWatchdog()
    schedule()
}

// ---------------------------------------------------------------------------
// The watchdog

/** The seconds of ORE_WATCHDOG, or 0 when it is not set. */
let watchdogSeconds: int

/**
 * With ORE_WATCHDOG=<seconds>, a thread that reports a stuck program: one in
 * which no task started or resumed and nothing was allocated for that long,
 * such as threads waiting on each other's locks in the runtime. It prints the
 * scheduler's state, the stack of every parked task (in debug builds) and the
 * native stack of every thread, then ends the program with status 3. A
 * program that computes for that long without allocating is reported too, so
 * it is meant for tests, with a generous limit.
 */
function startWatchdog(): void {
    const configured = getenv("ORE_WATCHDOG")
    if (isNil(configured)) return
    let n = 0
    let i = 0
    while (true) {
        const c = unsafe.load<u8>(unsafe.add(configured, i))
        if (c < 0x30 || c > 0x39) break
        n = n * 10 + i64(c - 0x30)
        i++
    }
    if (n <= 0) return
    watchdogSeconds = n
    if (!startThread(unsafe.functionAddress(watchdogMain), nil())) process.panic("cannot start the watchdog")
}

/** The watchdog's thread. Unknown to the collector: it allocates nothing and takes no lock. */
function watchdogMain(argument: ptr): ptr {
    const s = scheduler()
    const second = permanent(16)
    unsafe.store<i64>(second, 1)
    let switches = unsafe.atomicLoad<i64>(s.switches)
    let allocated = allocatedTotal()
    let still = 0
    while (true) {
        nanosleep(second, nil())
        const nowSwitches = unsafe.atomicLoad<i64>(s.switches)
        const nowAllocated = allocatedTotal()
        if (nowSwitches !== switches || nowAllocated !== allocated) {
            switches = nowSwitches
            allocated = nowAllocated
            still = 0
            continue
        }
        still++
        if (still >= watchdogSeconds) break
    }
    flushOutputIfFree()
    reportStuck()
    exitStuck(3)
    return argument
}

declare function _exit(status: i32): void

/** Ends the process at once: other threads may hold the locks that a normal exit would take. */
function exitStuck(status: i32): void {
    _exit(status)
}

/** What the watchdog prints: read without locks, since the program may hold any of them. */
function reportStuck(): void {
    const s = scheduler()
    const scratch = permanent(32)
    writeRaw(2, "\nwatchdog: no task ran and nothing was allocated for ")
    writeNumber(2, watchdogSeconds, false, scratch)
    writeRaw(2, " s (ORE_WATCHDOG)\n")
    writeRaw(2, "  workers ")
    writeNumber(2, s.workers, false, scratch)
    writeRaw(2, ", idle ")
    writeNumber(2, s.idleWorkers, false, scratch)
    writeRaw(2, ", in blocking calls ")
    writeNumber(2, s.blockingWorkers, false, scratch)
    writeRaw(2, ", waiting for sockets ")
    writeNumber(2, s.netWaiters, false, scratch)
    writeRaw(2, s.runHead !== null ? ", runnable tasks queued" : ", no runnable task")
    writeRaw(2, s.timers !== null ? ", timers pending\n" : ", no timer\n")
    // Tasks that have a stack, with their debug frames: prev at 0, function at 8, file at 16, line at 24.
    let r = firstStack()
    let shown = 0
    while (!isNil(r) && shown < 64) {
        const task = stackField(r, stackTask)
        r = stackField(r, stackAllNext)
        if (isNil(task)) continue
        const t = unsafe.fromAddress<Task>(task)
        const running = unsafe.load<i64>(unsafe.add(t.stack, stackRunning)) !== 0
        writeRaw(2, running ? "task (running):\n" : "task (parked):\n")
        let frame = t.top
        let depth = 0
        while (!isNil(frame) && depth < 32) {
            writeRaw(2, "  ")
            writeCString(unsafe.load<ptr>(unsafe.add(frame, 8)))
            writeRaw(2, " at ")
            writeCString(unsafe.load<ptr>(unsafe.add(frame, 16)))
            writeRaw(2, ":")
            writeNumber(2, i64(unsafe.load<i32>(unsafe.add(frame, 24))), false, scratch)
            writeRaw(2, "\n")
            frame = unsafe.load<ptr>(frame)
            depth++
        }
        if (depth === 0) writeRaw(2, "  (no frames: a release build, or not started)\n")
        shown++
    }
    writeRaw(2, "native stacks:\n")
    dumpThreads()
}

declare function strlen(s: ptr): u64

/** Writes a NUL-terminated string without copying it. */
function writeCString(p: ptr): void {
    writeRaw(2, unsafe.makeString(p, i64(strlen(p))))
}
