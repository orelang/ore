// The "ore:sync" module: synchronization of tasks, which run in parallel.
//
//   import { Mutex, WaitGroup } from "ore:sync"

/** A mutual exclusion lock, held by one task at a time. */
export class Mutex {
    private slot = new Chan<bool>(1)

    /** Waits until the lock is free, then holds it. */
    lock(): void {
        this.slot.send(true)
    }

    /** Releases the lock; panics if it is not held. */
    unlock(): void {
        task.select([this.slot.onReceive(() => {})], () => process.panic("unlock of an unlocked mutex"))
    }

    /** Holds the lock until the returned guard is disposed: `using guard = mutex.acquire()`. */
    acquire(): MutexGuard {
        this.lock()
        return new MutexGuard(this)
    }
}

/** Releases a mutex when disposed, at the end of the block of its `using` declaration. */
export class MutexGuard {
    constructor(private mutex: Mutex) {}

    [Symbol.dispose](): void {
        this.mutex.unlock()
    }
}

/** Waits for a group of tasks to finish, like Go's sync.WaitGroup. */
export class WaitGroup {
    /** The count, changed atomically: adding takes the mutex only when it drops to zero. */
    private count: ptr = unsafe.allocBytes(8)
    private mutex = new Mutex()
    /** Closed when the count drops to zero, then replaced; under the mutex. */
    private zero = new Chan<bool>()

    constructor() {
        unsafe.store<i64>(this.count, 0)
    }

    /** Adds `n` (possibly negative) to the number of tasks to wait for. */
    add(n: int): void {
        const count = unsafe.atomicAdd<i64>(this.count, n) + n
        if (count < 0) process.panic("negative WaitGroup count")
        if (count === 0) {
            // The count may have risen and dropped again meanwhile: whoever
            // sees it zero under the mutex wakes the waiters, which took the
            // channel under the mutex while it was not zero.
            using guard = this.mutex.acquire()
            if (unsafe.atomicLoad<i64>(this.count) === 0) {
                this.zero.close()
                this.zero = new Chan<bool>()
            }
        }
    }

    /** Marks one task as finished. */
    done(): void {
        this.add(-1)
    }

    /** Waits until every task added has finished. */
    wait(): void {
        if (unsafe.atomicLoad<i64>(this.count) === 0) return
        this.mutex.lock()
        if (unsafe.atomicLoad<i64>(this.count) === 0) {
            this.mutex.unlock()
            return
        }
        const zero = this.zero
        this.mutex.unlock()
        zero.receive()
    }
}
