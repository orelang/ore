// Built-in declarations, implicitly visible in every Ore module.
//
// Types declared as `intrinsic` are primitive types implemented by the
// compiler. Each numeric type name, and each alias of one, is also a
// conversion function: `i64(x)`, `int(x)`.
//
// TypeScript keyword types are mapped by the compiler directly:
// `string`, `void`, `never`, `boolean` (= bool), `number` (= f64).

declare type i8 = intrinsic
declare type i16 = intrinsic
declare type i32 = intrinsic
declare type i64 = intrinsic
declare type u8 = intrinsic
declare type u16 = intrinsic
declare type u32 = intrinsic
declare type u64 = intrinsic
declare type f32 = intrinsic
declare type f64 = intrinsic
declare type bool = intrinsic
/** A case of `task.select`, from `ch.onReceive`, `ch.onSend` or `task.after`. */
declare type SelectCase = intrinsic
/** An opaque C pointer, for external C functions. */
declare type ptr = intrinsic

declare type int = i64
declare type uint = u64
declare type byte = u8

/** Any numeric primitive type. Valid only as a parameter of built-ins. */
declare type numeric = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | f32 | f64

declare function i8(x: numeric): i8
declare function i16(x: numeric): i16
declare function i32(x: numeric): i32
declare function i64(x: numeric): i64
declare function u8(x: numeric): u8
declare function u16(x: numeric): u16
declare function u32(x: numeric): u32
declare function u64(x: numeric): u64
declare function f32(x: numeric): f32
declare function f64(x: numeric): f64
declare function int(x: numeric): int
declare function uint(x: numeric): uint
declare function byte(x: numeric): byte

/**
 * Console output, as Node's console. Values of any type but channels and
 * pointers are printed as Node's util.inspect formats them: strings as they
 * are, and inside other values quoted; `[ 1, 2 ]`, `{ x: 1 }`,
 * `Point { x: 1 }`, `Map(1) { 'a' => 1 }`. A first string followed by more
 * values is a format, as util.format reads it: `%s` (a string; an object 1
 * level deep), `%d` (a number: a string converted as Number() does),
 * `%i` (parseInt), `%f` (parseFloat), `%j` (JSON), `%O` (util.inspect),
 * `%o` (4 levels deep), `%c` (a CSS style, ignored) and `%%` take the
 * values in order; the values left over follow, separated by spaces.
 * Inside `group`, every line printed is indented by two spaces a level.
 *
 * `count`, `countReset`, `time`, `timeEnd` and `groupEnd` are written in
 * Ore, in runtime/core/console.ore, whose exports are members of the
 * namespace: these declarations document them.
 */
declare namespace console {
    /** Writes values separated by spaces, followed by a newline, to stdout. */
    function log(...data: any[]): void
    /** `log`. */
    function info(...data: any[]): void
    /** `log`. */
    function debug(...data: any[]): void

    /** Writes values separated by spaces, followed by a newline, to stderr. */
    function error(...data: any[]): void
    /** `error`. */
    function warn(...data: any[]): void
    /** Writes "Trace: " and the values to stderr, followed by the stack of the call. */
    function trace(...data: any[]): void

    /** Writes values separated by spaces to stdout, without a newline. */
    function write(...data: any[]): void

    /** Unless `condition` holds, writes "Assertion failed", or "Assertion failed: " before a first string, and the values to stderr. */
    function assert(condition: bool, ...data: any[]): void

    /** Writes a value as util.inspect formats it, strings quoted. */
    function dir(item: any): void

    /**
     * Writes an array, a map, a set or an object as a table with a row for
     * each entry and a column for each property of the entries, as Node does;
     * only the `properties` columns when given. Other values are logged.
     */
    function table(tabularData: any, properties?: string[]): void

    /** Writes the label, if any, as `log` does, then indents what is printed after it by two more spaces. */
    function group(...label: any[]): void
    /** `group`. */
    function groupCollapsed(...label: any[]): void
    /** Ends a level of indentation of `group`. */
    function groupEnd(): void

    /** Writes how many times `count` was called with the label, as "label: 3". */
    function count(label?: string): void
    /** Resets the count of a label. */
    function countReset(label?: string): void

    /** Starts a timer with a label. */
    function time(label?: string): void
    /** Writes the time since `time` with the label, as "label: 1.234ms", and the values after it. */
    function timeLog(label?: string, ...data: any[]): void
    /** Writes the time since `time` with the label, as `timeLog`, and stops the timer. */
    function timeEnd(label?: string): void
}

/**
 * Mathematical constants and functions, as in JavaScript. `hypot`, `clz32`,
 * `imul`, `fround` and `f16round` are written in Ore, in runtime/core/math.ore,
 * whose exports are members of the namespace.
 */
declare namespace Math {
    const PI: f64
    const E: f64
    /** The natural logarithm of 10. */
    const LN10: f64
    /** The natural logarithm of 2. */
    const LN2: f64
    /** The base-10 logarithm of e. */
    const LOG10E: f64
    /** The base-2 logarithm of e. */
    const LOG2E: f64
    /** The square root of 1/2. */
    const SQRT1_2: f64
    /** The square root of 2. */
    const SQRT2: f64

    /** The absolute value, for any numeric type. */
    function abs<T extends numeric>(x: T): T
    /**
     * The smallest of values of the same numeric type; arrays and tuples can
     * be spread in. With none (no arguments or only empty arrays): Infinity,
     * or the largest value of the integer type expected. NaN if any value is
     * NaN.
     */
    function min<T extends numeric>(...values: T[]): T
    /**
     * The largest of values of the same numeric type; arrays and tuples can be
     * spread in. With none (no arguments or only empty arrays): -Infinity, or
     * the smallest value of the integer type expected. NaN if any value is
     * NaN.
     */
    function max<T extends numeric>(...values: T[]): T

    function sqrt(x: f64): f64
    function cbrt(x: f64): f64
    /** x to the power y, as `**`; NaN for a NaN y, and for ±1 to ±Infinity. */
    function pow(x: f64, y: f64): f64
    function exp(x: f64): f64
    /** e^x - 1, exact for x near 0. */
    function expm1(x: f64): f64
    function log(x: f64): f64
    /** The natural logarithm of 1 + x, exact for x near 0. */
    function log1p(x: f64): f64
    function log2(x: f64): f64
    function log10(x: f64): f64
    function sin(x: f64): f64
    function cos(x: f64): f64
    function tan(x: f64): f64
    function asin(x: f64): f64
    function acos(x: f64): f64
    function atan(x: f64): f64
    function atan2(y: f64, x: f64): f64
    function sinh(x: f64): f64
    function cosh(x: f64): f64
    function tanh(x: f64): f64
    function asinh(x: f64): f64
    function acosh(x: f64): f64
    function atanh(x: f64): f64
    function floor(x: f64): f64
    function ceil(x: f64): f64
    /** Rounds half up, toward +Infinity, as JavaScript does: -0 for the values from -0.5 to -0. */
    function round(x: f64): f64
    function trunc(x: f64): f64
    /** -1, 0 or 1, by the sign of x. */
    function sign(x: f64): f64
    /** A pseudo-random number in [0, 1). */
    function random(): f64
}

/**
 * The constants of numbers and parsing them. The predicates `isNaN`,
 * `isFinite`, `isInteger` and `isSafeInteger` are written in Ore, in
 * runtime/core/number.ore, whose exports are members of the namespace.
 */
declare namespace Number {
    /** Not a number: the result of `0 / 0` on floats; it equals nothing, itself included. */
    const NaN: f64
    const POSITIVE_INFINITY: f64
    const NEGATIVE_INFINITY: f64
    /** The largest finite `f64`. */
    const MAX_VALUE: f64
    /** The smallest positive `f64`, a subnormal. */
    const MIN_VALUE: f64
    /** The difference between 1 and the next `f64`. */
    const EPSILON: f64
    /** 2^53 - 1: the integers up to it are exact in an `f64`. */
    const MAX_SAFE_INTEGER: f64
    const MIN_SAFE_INTEGER: f64

    /**
     * Parses an integer like JavaScript: leading whitespace, a sign, then digits
     * in `radix` (default 10, or 16 after "0x") up to the first other character.
     * Null when there are no digits, and when the number is too large for an
     * `int`, which JavaScript would round to a float.
     */
    function parseInt(s: string, radix?: int): int | null
    /** Parses a decimal number at the start of `s`; null when there is none. */
    function parseFloat(s: string): f64 | null
}

/**
 * `bigint`, integers of any size. `BigInt(x)` converts an integer, an
 * integral float or a string to one; the members are written in Ore, in
 * runtime/core/bigint.ore, whose exports are members of the namespace.
 */
declare namespace BigInt {
    /**
     * Reads a bigint as `BigInt(s)` does (white space around, a "0x", "0o"
     * or "0b" prefix, or decimal digits with a sign), or with a radix from 2
     * to 36, a sign and digits in it. Null when `s` is not one.
     */
    function parse(s: string, radix?: int): bigint | null
    /** `value` modulo 2^bits, from -2^(bits - 1) to 2^(bits - 1) - 1. */
    function asIntN(bits: int, value: bigint): bigint
    /** `value` modulo 2^bits, from 0 to 2^bits - 1. */
    function asUintN(bits: int, value: bigint): bigint
}

/**
 * Strings from character codes, as in JavaScript. Written in Ore, in
 * runtime/core/string.ore, whose exports are members of the namespace.
 */
declare namespace String {
    /**
     * The string of UTF-16 code units, each taken modulo 2^16. A high
     * surrogate followed by a low one is one character; a lone surrogate,
     * which UTF-8 cannot encode, becomes U+FFFD.
     */
    function fromCharCode(...codes: int[]): string
    /**
     * The string of code points; one past U+10FFFF or negative panics.
     * Surrogates combine as in `fromCharCode`.
     */
    function fromCodePoint(...points: int[]): string
}

/**
 * The static methods of `Map`. Written in Ore, in runtime/core/collections.ore,
 * whose exports are members of the namespace: these declarations document them.
 */
declare namespace Map {
    /**
     * The elements of `items` grouped by the key that `keyFn` returns for
     * each, the keys in the order they first appear.
     */
    function groupBy<T, K>(items: T[], keyFn: (element: T, index: int) => K): Map<K, T[]>
}

/**
 * Files, read and written whole as UTF-8 text, open file descriptors such as
 * stdin, directories and file metadata. Calls block only their OS thread.
 * The members from `readDir` on are written in Ore, in runtime/core/fs.ore,
 * whose exports are members of the namespace: these declarations document them.
 */
declare namespace fs {
    function readFile(path: string): string | Error
    /** Writes a file, created or truncated. */
    function writeFile(path: string, data: string): Error | null
    function exists(path: string): bool
    /**
     * Reads up to `max` bytes from a file descriptor, such as 0 for standard
     * input, waiting until some are available; "" at the end of the input.
     * The bytes may end in the middle of a UTF-8 character.
     */
    function read(fd: int, max: int): string | Error
    /**
     * Writes all of `data` to a file descriptor at once, without buffering;
     * on 1 or 2, after what `console` has printed.
     */
    function write(fd: int, data: string): Error | null

    /** The names in a directory, without "." and "..", sorted. */
    function readDir(path: string): string[] | Error
    /** Creates a directory; with `recursive`, also its missing parents, and one that exists is no error. */
    function mkdir(path: string, recursive?: bool): Error | null
    /** Removes a file or an empty directory; with `recursive`, a directory and everything in it. Links are not followed. */
    function remove(path: string, recursive?: bool): Error | null
    /** Renames or moves a file or a directory. */
    function rename(from: string, to: string): Error | null
    /** The metadata of a file, following symbolic links. */
    function stat(path: string): FileInfo | Error
    /** The metadata of a file, or of a symbolic link itself. */
    function lstat(path: string): FileInfo | Error
    /** Whether `path` is a regular file (following links). */
    function isFile(path: string): bool
    /** Whether `path` is a directory (following links). */
    function isDir(path: string): bool
    /** The absolute path of a file, without links, "." or "..". */
    function realpath(path: string): string | Error
    /** The directory for temporary files: $TMPDIR, or /tmp. */
    function tempDir(): string
    /** Creates a directory with a unique name starting with `prefix` in `dir` (default: `tempDir()`); returns its path. */
    function mkdtemp(prefix?: string, dir?: string): string | Error

    /** What `stat` and `lstat` tell: `fs.FileInfo`. */
    class FileInfo {
        readonly isFile: bool
        readonly isDir: bool
        readonly isSymlink: bool
        /** In bytes. */
        readonly size: int
        /** The time of the last modification, in milliseconds since the Unix epoch. */
        readonly mtime: int
        /** The permission bits, such as 0o644. */
        readonly mode: int
    }
}

/** Time. */
declare namespace Date {
    /** Milliseconds since the Unix epoch. */
    function now(): int
}

/**
 * Clocks and durations, in nanoseconds as `int`, as in Go. Written in Ore,
 * in runtime/core/time.ore, whose exports are members of the namespace:
 * these declarations document them.
 */
declare namespace time {
    // The durations in nanoseconds, `int` constants of the module:
    // `nanosecond`, `microsecond`, `millisecond`, `second`, `minute`,
    // `hour` and `day`, as in `5 * time.second` or `elapsed / time.millisecond`.

    /** Nanoseconds on a monotonic clock, for durations as the difference of two readings; its zero is arbitrary. */
    function now(): int
    /** Nanoseconds since the Unix epoch on the wall clock, which may jump. */
    function unixNanos(): int

    /**
     * The nanoseconds of a duration written as the npm package `ms` reads it:
     * "2 days", "1d", "10h", "2.5 hrs", "-3 days", ".5ms", plus the units
     * "us"/"µs" and "ns". A number without a unit is milliseconds, as in `ms`.
     * Null for a text `ms` rejects, or beyond the range of `int`.
     */
    function parse(text: string): int | null
    /**
     * A duration in nanoseconds as `ms` writes it: "1d", "10h", "2m", "5s",
     * "500ms", and beyond `ms` "250µs" and "80ns"; with `long`, "2 minutes".
     */
    function format(ns: int, options?: FormatOptions): string

    /** How `format` writes a duration. */
    type FormatOptions = {
        /** Whole words, as "2 minutes", instead of "2m". */
        long?: bool
    }

    /** Runs `callback` once on the event loop, `ns` nanoseconds from now or later: `setTimeout`. */
    function timeout(callback: () => void, ns: int): Timer
    /** Runs `callback` on the event loop every `ns` nanoseconds, until cancelled: `setInterval`. */
    function interval(callback: () => void, ns: int): Timer
    /** Runs `callback` on the next turn of the event loop, before its timers: `setImmediate`. */
    function immediate(callback: () => void): Timer
    /** A promise fulfilled `ns` nanoseconds from now or later. */
    function delay(ns: int): Promise<void>
    /** Blocks the current task, or the event loop, for `ns` nanoseconds. */
    function sleep(ns: int): void
    /** A callback of `timeout`, `interval` or `immediate`; `cancel()` stops it, harmlessly after it ran. */
    type Timer = { cancel(): void }
}

/**
 * Green threads: tasks run concurrently on one OS thread and switch when one
 * waits, on a channel or in `sleep`, or calls `yield`.
 */
declare namespace task {
    /** Starts a task. The program ends when the top-level code ends, even if tasks still run. */
    function spawn(body: () => void): void
    /** Suspends the current task for `ms` milliseconds. */
    function sleep(ms: int): void
    /** Lets other tasks run before the current one continues. */
    function yield(): void
    /**
     * Waits until one of the cases can proceed, then runs its handler; when
     * several can, one is chosen at random. With `otherwise`, it runs that
     * instead of waiting if no case can proceed now.
     */
    function select(cases: SelectCase[], otherwise?: () => void): void
    /** A select case that proceeds after `ms` milliseconds. */
    function after(ms: int, handler: () => void): SelectCase
    /**
     * Queues `job` on the event loop after the current code and the microtasks
     * before it, ahead of any timer: `queueMicrotask`.
     */
    function microtask(job: () => void): void
}

/**
 * The platform the program is compiled for, known at compile time: an `if`
 * on a comparison of these with a string compiles only the branch taken, as
 * in `if (target.arch === "arm64") ... else ...`.
 */
declare namespace target {
    /** "darwin" (macOS) or "linux". */
    const os: string
    /** "arm64" or "x86_64". */
    const arch: string
}

/**
 * Unchecked access to memory and the machine, like Go's `unsafe`: for the
 * runtime and the standard library. Nothing here is bounds-, type- or
 * null-checked; a mistake corrupts memory.
 */
declare namespace unsafe {
    /** The size in bytes of a value of type `T` (a reference for classes, arrays and maps). */
    function sizeOf<T>(): int
    /** The alignment in bytes of a value of type `T`. */
    function alignOf<T>(): int

    /** The address `bytes` after `p`. */
    function add(p: ptr, bytes: int): ptr
    /** The distance in bytes from `b` to `a`. */
    function diff(a: ptr, b: ptr): int
    /** The address as an integer. */
    function toInt(p: ptr): uint
    /** The pointer at an address; `fromInt(0)` is the null pointer. */
    function fromInt(address: uint): ptr
    /** The bits of a number as another numeric type of the same size: `bitcast<u64>(1.5)`. */
    function bitcast<T>(value: numeric): T

    /** Reads a value of type `T` at `p`. */
    function load<T>(p: ptr): T
    /** Writes a value of type `T` at `p`. */
    function store<T>(p: ptr, value: T): void

    /** Allocates zeroed, garbage-collected memory, which may hold references. */
    function alloc(size: int): ptr
    /** Allocates zeroed, garbage-collected memory that the collector never scans: bytes and numbers only. */
    function allocBytes(size: int): ptr
    /** Copies `size` bytes from `src` to `dst`; the ranges may overlap. */
    function copy(dst: ptr, src: ptr, size: int): void
    /** Sets `size` bytes at `dst` to `value`. */
    function fill(dst: ptr, value: u8, size: int): void
    /** Compares `size` bytes: negative, zero or positive, like C's memcmp. */
    function compare(a: ptr, b: ptr, size: int): int

    /** The address of an object, an array or a map. */
    function addressOf<T>(value: T): ptr
    /** The object, array or map at an address. */
    function fromAddress<T>(p: ptr): T
    /** The machine address of a top-level function, for C callbacks and assembly. */
    function functionAddress<F>(f: F): ptr
    /** The address of the bytes of a string. */
    function stringData(s: string): ptr
    /** A string of the `length` bytes at `p`, without copying them. */
    function makeString(p: ptr, length: int): string

    // Atomic operations on integers and pointers, sequentially consistent.
    // `p` must be aligned to the size of `T`.
    function atomicLoad<T>(p: ptr): T
    function atomicStore<T>(p: ptr, value: T): void
    /** Adds `value` and returns the previous value; also atomicSub, atomicAnd, atomicOr, atomicXor. */
    function atomicAdd<T>(p: ptr, value: T): T
    function atomicSub<T>(p: ptr, value: T): T
    function atomicAnd<T>(p: ptr, value: T): T
    function atomicOr<T>(p: ptr, value: T): T
    function atomicXor<T>(p: ptr, value: T): T
    /** Stores `value` and returns the previous value. */
    function atomicExchange<T>(p: ptr, value: T): T
    /** Stores `desired` if the value is `expected`; returns whether it did. */
    function atomicCompareExchange<T>(p: ptr, expected: T, desired: T): bool
    /** A full memory barrier. */
    function fence(): void
    /**
     * Orders memory accesses against a signal handler on the same thread, as
     * C's atomic_signal_fence: a compiler barrier, with no instruction.
     */
    function signalFence(): void

    /**
     * Inline assembly, as LLVM writes it: a template with `$0`, `$1`, ...
     * for the operands, and constraints such as "=r,r,~{memory}". Both are
     * string literals; the operands are numbers or pointers.
     */
    function asm<T>(template: string, constraints: string, ...args: numeric[]): T
}

/** Functions only for the standard library modules ("ore:..."). */
declare namespace internal {
    // The tests of "ore:test".
    /** Runs a body in a task of its own; returns the message of the panic that ends it, or null. */
    function catchPanic(body: () => void): string | null
    /** Counts a test for the summary at the end of the program: 0 passed, 1 failed, 2 skipped, 3 todo. */
    function countTest(outcome: int): void
    /** Whether the current task runs the program's top-level code. */
    function inMainTask(): bool
    /** Calls `body` when the program's top-level code ends, before the program does. */
    function atMainEnd(body: () => void): void
    /** A value as console.log formats it inside an array, without colors; with `whole`, every level and entry. */
    function inspect<T>(value: T, whole: bool): string

    // TCP sockets by file descriptor, for "ore:net".
    function netListen(host: string, port: int): int | Error
    function netConnect(host: string, port: int): int | Error
    function netAccept(fd: int): int | Error
    function netRead(fd: int, max: int): string | Error
    function netWrite(fd: int, data: string): Error | null
    function netClose(fd: int): void
    function netPort(fd: int): int
}

/**
 * The running process, and other programs it runs. The members from `env`
 * on are written in Ore, in runtime/core/process.ore, whose exports are
 * members of the namespace: these declarations document them.
 */
declare namespace process {
    /** The command-line arguments after the program name. */
    const args: string[]

    /** The value of an environment variable, or null. */
    function getenv(name: string): string | null

    /** The working directory, as an absolute path. */
    function cwd(): string

    /** Aborts the program with a message and a stack trace. */
    function panic(message: string): never

    /** Exits the program with a status code. */
    function exit(code: i32): never

    /** The environment variables, by name. */
    function env(): Map<string, string>

    /** The number of CPUs the system has online. */
    function cpus(): int

    /** Whether a file descriptor (0 stdin, 1 stdout, 2 stderr) is a terminal, as isatty(3). */
    function isatty(fd: int): bool

    /** Runs a program (found in PATH) with this process's stdin, stdout and stderr, and waits; returns its exit status. */
    function run(program: string, args?: string[]): int | Error
    /** Runs a program and waits, collecting its stdout and stderr. */
    function output(program: string, args?: string[]): Output | Error
    /** Starts a program with this process's stdio, as `run`, without waiting: see `Child`. */
    function spawn(program: string, args?: string[]): Child | Error

    /**
     * `run`, `output` and `spawn` with options: the working directory, the
     * environment, the standard input. Written in Ore, in
     * runtime/core/process-command.ore, whose exports are its members.
     */
    namespace command {
        /** Runs with this process's stdio (stdin unless `options.stdin`) and waits; returns the exit status (128 + signal if killed). */
        function run(program: string, args?: string[], options?: CommandOptions): int | Error
        /** Runs and waits, collecting stdout and stderr; stdin is empty unless `options.stdin`; a failing status is no Error. */
        function output(program: string, args?: string[], options?: CommandOptions): Output | Error
        /** Starts as `run`, without waiting: see `Child`. */
        function spawn(program: string, args?: string[], options?: CommandOptions): Child | Error
    }

    /** How `command.run`, `command.output` and `command.spawn` start a program; each setting may be left out. */
    type CommandOptions = {
        /** The working directory; this process's when left out or "". */
        cwd?: string
        /** Variables set over the inherited environment. */
        env?: Map<string, string>
        /** Whether to start from an empty environment (then only `env`). */
        clearEnv?: bool
        /** Text for the standard input, then closed (when left out: empty for `output`, inherited for `run` and `spawn`). */
        stdin?: string
    }

    /** A program started by `spawn`, running alongside this one. */
    class Child {
        readonly pid: int
        /** Waits for it to end (once more: the same status); returns the exit status (128 + signal if killed). */
        wait(): int | Error
        /** Sends a signal: SIGTERM (15) by default, 9 for SIGKILL; nothing once `wait()` has collected it. */
        kill(signal?: int): Error | null
    }

    /** What `output()` returns. */
    class Output {
        /** The exit status, or 128 plus the number of the signal that killed it. */
        readonly code: int
        readonly stdout: string
        readonly stderr: string
        /** The signal that killed it, or 0. */
        readonly signal: int
        /** Whether it exited with status 0. */
        readonly ok: bool
    }
}

/**
 * Making arrays, as in JavaScript; the compiler checks the calls, and these
 * declarations document them.
 */
declare namespace Array {
    /**
     * A new array of the elements of an array (a copy), the characters of a
     * string, the values of a set or the `[key, value]` entries of a map,
     * each passed through `mapFn` when it is given. `Array.from({ length: n },
     * (_, i) => ...)` makes `n` elements by the function, given null and the
     * index.
     */
    function from<T>(items: T[], mapFn?: (value: T, index: int) => T): T[]
    /** A new array of the arguments. */
    function of<T>(...items: T[]): T[]
    /** Whether a value is an array: known from its type, or tested at run time for a union. */
    function isArray<T>(value: T): bool
}

/** Conversion between values and JSON text. */
declare namespace JSON {
    /**
     * The JSON text of a value: a number, boolean, string, null, array, `Map`
     * with string keys, object or class instance (all its fields). As in
     * JavaScript, the replacer must be null; with a `space`, nested values go
     * on their own lines, indented by that many spaces per level.
     */
    function stringify<T>(value: T, replacer?: null, space?: int): string

    /**
     * Reads a value of type `T` from JSON text, checking its shape:
     * `JSON.parse<Config>(text)`. A missing field is an error unless its type
     * includes `null`; unknown fields are ignored.
     */
    function parse<T>(text: string): T | Error
}

/**
 * A resource released at the end of the block that declares it with
 * `using`, which calls its `[Symbol.dispose]()` method.
 */
interface Disposable {
    [Symbol.dispose](): void
}

/**
 * An error value. Fallible functions return `T | Error`; any class with a
 * `message` field is an `Error`. `new Error(message)` creates a basic one.
 */
interface Error {
    readonly message: string
}
