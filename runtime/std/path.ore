// The "ore:path" module: file paths, with the POSIX semantics of Node's
// `node:path` (path.posix).
//
//   import { join, dirname } from "ore:path"
//
//   join("a/b", "../c")      // "a/c"
//   dirname("/usr/lib/x.so") // "/usr/lib"
//
// Paths are byte strings: "/" and "." are ASCII, so UTF-8 text never contains
// them inside a character and the results equal Node's.

const slash: u8 = 0x2f
const dot: u8 = 0x2e

/** The path segment separator. */
export const sep = "/"

/** The path delimiter of environment variables such as PATH. */
export const delimiter = ":"

/**
 * Resolves `.` and `..` segments and removes empty ones, without a leading
 * slash. `..` past the start is kept when `allowAboveRoot`, else dropped.
 */
function normalizeString(path: string, allowAboveRoot: bool): string {
    let res = ""
    let lastSegmentLength = 0
    let lastSlash = -1
    let dots = 0
    let code: u8 = 0
    for (let i = 0; i <= path.length; i++) {
        if (i < path.length) code = path[i]
        else if (code === slash) break
        else code = slash
        if (code === slash) {
            if (lastSlash === i - 1 || dots === 1) {
                // An empty segment or ".": nothing to add.
            } else if (dots === 2) {
                if (
                    res.length < 2 ||
                    lastSegmentLength !== 2 ||
                    res[res.length - 1] !== dot ||
                    res[res.length - 2] !== dot
                ) {
                    if (res.length > 2) {
                        const lastSlashIndex = res.lastIndexOf(sep)
                        if (lastSlashIndex === -1) {
                            res = ""
                            lastSegmentLength = 0
                        } else {
                            res = res.slice(0, lastSlashIndex)
                            lastSegmentLength = res.length - 1 - res.lastIndexOf(sep)
                        }
                        lastSlash = i
                        dots = 0
                        continue
                    } else if (res.length !== 0) {
                        res = ""
                        lastSegmentLength = 0
                        lastSlash = i
                        dots = 0
                        continue
                    }
                }
                if (allowAboveRoot) {
                    res += res.length > 0 ? "/.." : ".."
                    lastSegmentLength = 2
                }
            } else {
                if (res.length > 0) res += "/" + path.slice(lastSlash + 1, i)
                else res = path.slice(lastSlash + 1, i)
                lastSegmentLength = i - lastSlash - 1
            }
            lastSlash = i
            dots = 0
        } else if (code === dot && dots !== -1) {
            dots++
        } else {
            dots = -1
        }
    }
    return res
}

/** Whether a path starts at the root. */
export function isAbsolute(path: string): bool {
    return path.length > 0 && path[0] === slash
}

/**
 * Resolves `.` and `..` segments and collapses repeated slashes, keeping a
 * trailing slash: `normalize("a//b/../c/")` is `"a/c/"`. An empty path is `"."`.
 */
export function normalize(path: string): string {
    if (path.length === 0) return "."
    const absolute = path[0] === slash
    const trailingSeparator = path[path.length - 1] === slash
    let result = normalizeString(path, !absolute)
    if (result.length === 0) {
        if (absolute) return "/"
        return trailingSeparator ? "./" : "."
    }
    if (trailingSeparator) result += "/"
    return absolute ? "/" + result : result
}

/** Joins the non-empty paths with "/" and normalizes the result; `"."` if all are empty. */
export function join(...paths: string[]): string {
    let joined = ""
    for (const path of paths) {
        if (path.length === 0) continue
        joined = joined.length === 0 ? path : joined + "/" + path
    }
    if (joined.length === 0) return "."
    return normalize(joined)
}

/**
 * An absolute path: the paths from right to left are prepended until one is
 * absolute, then the working directory if none is. The result is normalized,
 * without a trailing slash except for the root.
 */
export function resolve(...paths: string[]): string {
    let resolvedPath = ""
    let resolvedAbsolute = false
    for (let i = paths.length - 1; i >= -1 && !resolvedAbsolute; i--) {
        const path = i >= 0 ? paths[i] : process.cwd()
        if (path.length === 0) continue
        resolvedPath = path + "/" + resolvedPath
        resolvedAbsolute = path[0] === slash
    }
    resolvedPath = normalizeString(resolvedPath, !resolvedAbsolute)
    if (resolvedAbsolute) return "/" + resolvedPath
    return resolvedPath.length > 0 ? resolvedPath : "."
}

/** The path from `from` to `to`, both resolved first; `""` when they are the same. */
export function relative(from: string, to: string): string {
    if (from === to) return ""
    from = resolve(from)
    to = resolve(to)
    if (from === to) return ""
    const fromStart = 1
    const fromEnd = from.length
    const fromLen = fromEnd - fromStart
    const toStart = 1
    const toLen = to.length - toStart
    const length = fromLen < toLen ? fromLen : toLen
    let lastCommonSep = -1
    let i = 0
    for (; i < length; i++) {
        const fromCode = from[fromStart + i]
        if (fromCode !== to[toStart + i]) break
        else if (fromCode === slash) lastCommonSep = i
    }
    if (i === length) {
        if (toLen > length) {
            // `from` is the root or a directory above `to`.
            if (to[toStart + i] === slash) return to.slice(toStart + i + 1)
            if (i === 0) return to.slice(toStart + i)
        } else if (fromLen > length) {
            // `to` is the root or a directory above `from`.
            if (from[fromStart + i] === slash) lastCommonSep = i
            else if (i === 0) lastCommonSep = 0
        }
    }
    let out = ""
    for (i = fromStart + lastCommonSep + 1; i <= fromEnd; i++) {
        if (i === fromEnd || from[i] === slash) out += out.length === 0 ? ".." : "/.."
    }
    return out + to.slice(toStart + lastCommonSep)
}

/** The directory of a path, without trailing slashes: `"."` for a bare name, `"/"` for the root. */
export function dirname(path: string): string {
    if (path.length === 0) return "."
    const hasRoot = path[0] === slash
    let end = -1
    let matchedSlash = true
    for (let i = path.length - 1; i >= 1; i--) {
        if (path[i] === slash) {
            if (!matchedSlash) {
                end = i
                break
            }
        } else {
            matchedSlash = false
        }
    }
    if (end === -1) return hasRoot ? "/" : "."
    if (hasRoot && end === 1) return "//"
    return path.slice(0, end)
}

/** The last segment of a path, ignoring trailing slashes, without `suffix` if it ends with it. */
export function basename(path: string, suffix?: string): string {
    let start = 0
    let end = -1
    let matchedSlash = true
    if (suffix !== null && suffix.length > 0 && suffix.length <= path.length) {
        if (suffix === path) return ""
        let extIdx = suffix.length - 1
        let firstNonSlashEnd = -1
        for (let i = path.length - 1; i >= 0; i--) {
            const code = path[i]
            if (code === slash) {
                if (!matchedSlash) {
                    start = i + 1
                    break
                }
            } else {
                if (firstNonSlashEnd === -1) {
                    matchedSlash = false
                    firstNonSlashEnd = i + 1
                }
                if (extIdx >= 0) {
                    if (code === suffix[extIdx]) {
                        extIdx--
                        if (extIdx === -1) end = i
                    } else {
                        extIdx = -1
                        end = firstNonSlashEnd
                    }
                }
            }
        }
        if (start === end) end = firstNonSlashEnd
        else if (end === -1) end = path.length
        return path.slice(start, end)
    }
    for (let i = path.length - 1; i >= 0; i--) {
        if (path[i] === slash) {
            if (!matchedSlash) {
                start = i + 1
                break
            }
        } else if (end === -1) {
            matchedSlash = false
            end = i + 1
        }
    }
    if (end === -1) return ""
    return path.slice(start, end)
}

/** The extension of the last segment, from its last `.`: `".ore"`; `""` for none or a leading dot. */
export function extname(path: string): string {
    let startDot = -1
    let startPart = 0
    let end = -1
    let matchedSlash = true
    // 0: no dot before the last one yet; 1: a dot; -1: a character other than a dot.
    let preDotState = 0
    for (let i = path.length - 1; i >= 0; i--) {
        const code = path[i]
        if (code === slash) {
            if (!matchedSlash) {
                startPart = i + 1
                break
            }
            continue
        }
        if (end === -1) {
            matchedSlash = false
            end = i + 1
        }
        if (code === dot) {
            if (startDot === -1) startDot = i
            else if (preDotState !== 1) preDotState = 1
        } else if (startDot !== -1) {
            preDotState = -1
        }
    }
    if (
        startDot === -1 ||
        end === -1 ||
        preDotState === 0 ||
        (preDotState === 1 && startDot === end - 1 && startDot === startPart + 1)
    ) {
        return ""
    }
    return path.slice(startDot, end)
}
