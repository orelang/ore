{
  "name": "ore",
  "displayName": "Ore",
  "description": "Ore language support: highlighting, diagnostics, hover, go to definition, completion, references and rename.",
  "version": "0.4.1",
  "publisher": "Ore",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/orelang/ore.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/orelang/ore/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/orelang/ore/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ore",
    "language server",
    "lsp"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "ore",
        "aliases": [
          "Ore"
        ],
        "extensions": [
          ".ore"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ore",
        "scopeName": "source.ore",
        "path": "./syntaxes/ore.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ore",
      "properties": {
        "ore.path": {
          "type": "string",
          "default": "ore",
          "description": "The ore binary that runs the language server ('ore lsp')."
        }
      }
    },
    "configurationDefaults": {
      "[ore]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.1"
  }
}
