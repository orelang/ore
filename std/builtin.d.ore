// Built-in declarations, implicitly visible in every Ore module.
//
// Types declared as `intrinsic` are primitive types implemented by the
// compiler. Each numeric type name is also a conversion function: `i64(x)`.
//
// TypeScript keyword types are mapped by the compiler directly:
// `string`, `void`, `never`, `boolean` (= bool), `number` (= f64).

declare type i8 = intrinsic
declare type i16 = intrinsic
declare type i32 = intrinsic
declare type i64 = intrinsic
declare type u8 = intrinsic
declare type u16 = intrinsic
declare type u32 = intrinsic
declare type u64 = intrinsic
declare type f32 = intrinsic
declare type f64 = intrinsic
declare type bool = intrinsic
/** An opaque C pointer, for external C functions. */
declare type ptr = intrinsic

declare type int = i64
declare type uint = u64
declare type byte = u8

/** Any numeric primitive type. Valid only as a parameter of built-ins. */
declare type numeric = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 | f32 | f64

declare function i8(x: numeric): i8
declare function i16(x: numeric): i16
declare function i32(x: numeric): i32
declare function i64(x: numeric): i64
declare function u8(x: numeric): u8
declare function u16(x: numeric): u16
declare function u32(x: numeric): u32
declare function u64(x: numeric): u64
declare function f32(x: numeric): f32
declare function f64(x: numeric): f64

/** Console output. Values are numbers, `bool`, strings and unions of them. */
declare namespace console {
    /** Writes values separated by spaces, followed by a newline, to stdout. */
    function log(...values: (numeric | bool | string)[]): void

    /** Writes values separated by spaces to stdout, without a newline. */
    function write(...values: (numeric | bool | string)[]): void

    /** Writes values separated by spaces, followed by a newline, to stderr. */
    function error(...values: (numeric | bool | string)[]): void
}

/** Mathematical constants and functions, as in JavaScript. */
declare namespace Math {
    const PI: f64
    const E: f64

    /** The absolute value, for any numeric type. */
    function abs<T extends numeric>(x: T): T
    /** The smaller of two values of the same numeric type. */
    function min<T extends numeric>(a: T, b: T): T
    /** The larger of two values of the same numeric type. */
    function max<T extends numeric>(a: T, b: T): T

    function sqrt(x: f64): f64
    function cbrt(x: f64): f64
    function pow(x: f64, y: f64): f64
    function exp(x: f64): f64
    function log(x: f64): f64
    function log2(x: f64): f64
    function log10(x: f64): f64
    function sin(x: f64): f64
    function cos(x: f64): f64
    function tan(x: f64): f64
    function asin(x: f64): f64
    function acos(x: f64): f64
    function atan(x: f64): f64
    function atan2(y: f64, x: f64): f64
    function hypot(x: f64, y: f64): f64
    function floor(x: f64): f64
    function ceil(x: f64): f64
    /** Rounds half up, toward +Infinity, as JavaScript does. */
    function round(x: f64): f64
    function trunc(x: f64): f64
    /** -1, 0 or 1, by the sign of x. */
    function sign(x: f64): f64
    /** A pseudo-random number in [0, 1). */
    function random(): f64
}

/** Parsing numbers. */
declare namespace Number {
    /**
     * Parses an integer like JavaScript: leading whitespace, a sign, then digits
     * in `radix` (default 10, or 16 after "0x") up to the first other character.
     * Null when there are no digits.
     */
    function parseInt(s: string, radix?: int): int | null
    /** Parses a decimal number at the start of `s`; null when there is none. */
    function parseFloat(s: string): f64 | null
}

/** Files, read and written whole as UTF-8 text. */
declare namespace fs {
    function readFile(path: string): string | Error
    function writeFile(path: string, data: string): Error | null
    function exists(path: string): bool
}

/** Time. */
declare namespace Date {
    /** Milliseconds since the Unix epoch. */
    function now(): int
}

/**
 * Green threads: tasks run concurrently on one OS thread and switch when one
 * waits, on a channel or in `sleep`, or calls `yield`.
 */
declare namespace task {
    /** Starts a task. The program ends when `main` returns, even if tasks still run. */
    function spawn(body: () => void): void
    /** Suspends the current task for `ms` milliseconds. */
    function sleep(ms: int): void
    /** Lets other tasks run before the current one continues. */
    function yield(): void
}

/** Functions only for the standard library modules ("ore:..."). */
declare namespace internal {
    /** Runs a test body, reporting whether it panics. */
    function runTest(name: string, body: () => void): void
}

/** The running process. */
declare namespace process {
    /** The command-line arguments after the program name. */
    const args: string[]

    /** The value of an environment variable, or null. */
    function getenv(name: string): string | null

    /** Aborts the program with a message and a stack trace. */
    function panic(message: string): never

    /** Exits the program with a status code. */
    function exit(code: i32): never
}

/**
 * A resource released at the end of the block that declares it with
 * `using`, which calls its `[Symbol.dispose]()` method.
 */
interface Disposable {
    [Symbol.dispose](): void
}

/**
 * An error value. Fallible functions return `T | Error`; any class with a
 * `message` field is an `Error`. `new Error(message)` creates a basic one.
 */
interface Error {
    readonly message: string
}
